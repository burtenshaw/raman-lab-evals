Sending keys: ['cat > /app/fit_peaks.py << \'EOF\'\n#!/usr/bin/env python3\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Load data (assume two columns: x (cm^-1) and intensity)\ndata = np.loadtxt(\'/app/graphene.dat\')\nif data.ndim != 2 or data.shape[1] < 2:\n    raise ValueError(\'Data file must contain at least two columns\')\n# Use first column as x, second as y (ignore extra columns if any)\nx = data[:, 0]\ny = data[:, 1]\n\n# Lorentzian function with offset\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a region\ndef fit_region(x, y, region, guess):\n    mask = (x >= region[0]) & (x <= region[1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=guess, maxfev=10000)\n    return popt  # x0, gamma, amplitude, offset\n\n# G peak region and initial guess\nregion_G = (1500, 1650)\n# Guess: x0 ~1580, gamma ~10, amplitude ~max(y) in region, offset ~min(y) in region\nmask_G = (x >= region_G[0]) & (x <= region_G[1])\namp_guess_G = y[mask_G].max() - y[mask_G].min()\noffset_guess_G = y[mask_G].min()\nguess_G = [1580, 10, amp_guess_G, offset_guess_G]\n\n# 2D peak region and initial guess\nregion_2D = (2600, 2800)\nmask_2D = (x >= region_2D[0]) & (x <= region_2D[1])\namp_guess_2D = y[mask_2D].max() - y[mask_2D].min()\noffset_guess_2D = y[mask_2D].min()\nguess_2D = [2700, 20, amp_guess_2D, offset_guess_2D]\n\n# Perform fits\npopt_G = fit_region(x, y, region_G, guess_G)\npopt_2D = fit_region(x, y, region_2D, guess_2D)\n\n# Prepare result dictionary\nresult = {\n    "G": {\n        "x0": float(popt_G[0]),\n        "gamma": float(popt_G[1]),\n        "amplitude": float(popt_G[2]),\n        "offset": float(popt_G[3])\n    },\n    "2D": {\n        "x0": float(popt_2D[0]),\n        "gamma": float(popt_2D[1]),\n        "amplitude": float(popt_2D[2]),\n        "offset": float(popt_2D[3])\n    }\n}\n\n# Write to JSON file\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(\'Fitting complete. Results written to /app/results.json\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
