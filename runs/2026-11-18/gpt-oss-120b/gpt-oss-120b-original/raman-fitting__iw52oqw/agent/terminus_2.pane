[?2004hroot@j-openenv-6afd8727884144d2f44fd3f1-bel7pudc-552d0-tvch2:/app# cat > /app/fit_peaks.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data (assume two columns: x (cm^-1) and intensity)
[?2004l[?2004h> data = np.loadtxt('/app/graphene.dat')
[?2004l[?2004h> if data.ndim != 2 or data.shape[1] < 2:
[?2004l[?2004h>     raise ValueError('Data file must contain at least two columns')
[?2004l[?2004h> # Use first column as x, second as y (ignore extra columns if any)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian function with offset
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a region
[?2004l[?2004h> def fit_region(x, y, region, guess):
[?2004l[?2004h>     mask = (x >= region[0]) & (x <= region[1])
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=guess, maxfev=10000)
[?2004l[?2004h>     return popt  # x0, gamma, amplitude, offset
[?2004l[?2004h> 
[?2004l[?2004h> # G peak region and initial guess
[?2004l[?2004h> region_G = (1500, 1650)
[?2004l[?2004h> # Guess: x0 ~1580, gamma ~10, amplitude ~max(y) in region, offset ~min(y) in region
[?2004l[?2004h> mask_G = (x >= region_G[0]) & (x <= region_G[1])
[?2004l[?2004h> amp_guess_G = y[mask_G].max() - y[mask_G].min()
[?2004l[?2004h> offset_guess_G = y[mask_G].min()
[?2004l[?2004h> guess_G = [1580, 10, amp_guess_G, offset_guess_G]
[?2004l[?2004h> 
[?2004l[?2004h> # 2D peak region and initial guess
[?2004l[?2004h> region_2D = (2600, 2800)
[?2004l[?2004h> mask_2D = (x >= region_2D[0]) & (x <= region_2D[1])
[?2004l[?2004h> amp_guess_2D = y[mask_2D].max() - y[mask_2D].min()
[?2004l[?2004h> offset_guess_2D = y[mask_2D].min()
[?2004l[?2004h> guess_2D = [2700, 20, amp_guess_2D, offset_guess_2D]
[?2004l[?2004h> 
[?2004l[?2004h> # Perform fits
[?2004l[?2004h> popt_G = fit_region(x, y, region_G, guess_G)
[?2004l[?2004h> popt_2D = fit_region(x, y, region_2D, guess_2D)
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare result dictionary
[?2004l[?2004h> result = {
[?2004l[?2004h>     "G": {
[?2004l[?2004h>         "x0": float(popt_G[0]),
[?2004l[?2004h>         "gamma": float(popt_G[1]),
[?2004l[?2004h>         "amplitude": float(popt_G[2]),
[?2004l[?2004h>         "offset": float(popt_G[3])
[?2004l[?2004h>     },
[?2004l[?2004h>     "2D": {
[?2004l[?2004h>         "x0": float(popt_2D[0]),
[?2004l[?2004h>         "gamma": float(popt_2D[1]),
[?2004l[?2004h>         "amplitude": float(popt_2D[2]),
[?2004l[?2004h>         "offset": float(popt_2D[3])
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Write to JSON file
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Fitting complete. Results written to /app/results.json')
[?2004l[?2004h> EOF
