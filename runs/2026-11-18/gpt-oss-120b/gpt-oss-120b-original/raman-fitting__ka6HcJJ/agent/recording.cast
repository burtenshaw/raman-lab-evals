[170.821404, "i", "python3 - << 'PY'\nimport os, json, numpy as np, scipy.optimize as opt, sys, re\nfiles = [f for f in os.listdir('/app') if re.search(r\"(\\.txt|\\.csv|\\.dat)$\", f, re.IGNORECASE)]\nif not files:\n    print('No data file found')\n    sys.exit(1)\ndata_file = files[0]\nprint('Using data file:', data_file)\n# Load data (auto-detect delimiter)\ntry:\n    data = np.loadtxt(data_file, delimiter=None)\nexcept Exception:\n    data = np.loadtxt(data_file, delimiter=',')\nif data.ndim != 2 or data.shape[1] < 2:\n    print('Data does not have two columns')\n    sys.exit(1)\nshift = data[:,0]\nintensity = data[:,1]\n\ndef lorentzian(x, amp, x0, gamma, offset):\n    return amp * (gamma**2 / ((x - x0)**2 + gamma**2)) + offset\n# Fit G peak (~1580 cm^-1)\nmask_g = (shift > 1500) & (shift < 1700)\nparams_g, _ = opt.curve_fit(lorentzian, shift[mask_g], intensity[mask_g], p0=[np.max(intensity[mask_g]), 1580, 20, np.min(intensity[mask_g])])\n# Fit 2D peak (~2700 cm^-1)\nmask_2d = (shift > 2500) & (shift < 2900)\nparams_2d, _ = opt.curve_fit(lorentzian, shi"]
[170.821686, "o", "python3 - << 'PY'\r\n\u001b[?2004l\r"]
[170.821833, "i", "ft[mask_2d], intensity[mask_2d], p0=[np.max(intensity[mask_2d]), 2700, 30, np.min(intensity[mask_2d])])\nresult = {\n    \"G\": {\n        \"x0\": float(params_g[1]),\n        \"gamma\": float(params_g[2]),\n        \"amplitude\": float(params_g[0]),\n        \"offset\": float(params_g[3])\n    },\n    \"2D\": {\n        \"x0\": float(params_2d[1]),\n        \"gamma\": float(params_2d[2]),\n        \"amplitude\": float(params_2d[0]),\n        \"offset\": float(params_2d[3])\n    }\n}\nout_path = '/app/results.json'\nwith open(out_path, 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Results written to', out_path)\nPY\n"]
[170.822207, "o", "\u001b[?2004h> import os, json, numpy as np, scipy.optimize as opt, sys, re\r\n\u001b[?2004l\rft[mask_2d], intensity[mask_2d], p0=[np.max(intensity[mask_2d]), 2700, 30, np.min(intensity[mask_2d])])\r\nresult = {\r\n    \"G\": {\r\n        \"x0\": float(params_g[1]),\r\n        \"gamma\": float(params_g[2]),\r\n        \"amplitude\": float(params_g[0]),\r\n        \"offset\": float(params_g[3])\r\n    },\r\n    \"2D\": {\r\n        \"x0\": float(params_2d[1]),\r\n        \"gamma\": float(params_2d[2]),\r\n        \"amplitude\": float(params_2d[0]),\r\n        \"offset\": float(params_2d[3])\r\n    }\r\n}\r\nout_path = '/app/results.json'\r\nwith open(out_path, 'w') as f:\r\n    json.dump(result, f, indent=2)\r\nprint('Results written to', out_path)\r\nPY\r\n\u001b[?2004h> "]
