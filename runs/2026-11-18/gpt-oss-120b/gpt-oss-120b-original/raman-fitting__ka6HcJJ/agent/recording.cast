[170.838698, "o", "\u001b[?2004l\r\u001b[?2004h> params_2d, _ = opt.curve_fit(lorentzian, shift[mask_2d], intensity[mask_2d], p0=[np.max(intensity[mask_2d]), 2700, 30, np.min(intensity[mask_2d])])\r\n\u001b[?2004l\r\u001b[?2004h> result = {\r\n\u001b[?2004l\r\u001b[?2004h>     \"G\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"x0\": float(params_g[1]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"gamma\": float(params_g[2]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"amplitude\": float(params_g[0]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"offset\": float(params_g[3])\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     \"2D\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"x0\": float(params_2d[1]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"gamma\": float(params_2d[2]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"amplitude\": float(params_2d[0]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"offset\": float(params_2d[3])\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> out_path = '/app/results.json'\r\n\u001b[?2004l\r\u001b[?2004h> with open(out_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(result, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
