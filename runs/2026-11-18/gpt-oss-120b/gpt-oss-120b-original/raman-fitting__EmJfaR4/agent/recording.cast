[116.551499, "i", "cat > fit_raman.py << 'EOF'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data (assume two columns: Raman shift and intensity)\ntry:\n    data = np.loadtxt('graphene.dat')\nexcept Exception as e:\n    sys.stderr.write(f'Error loading data: {e}\\n')\n    sys.exit(1)\n\nx = data[:, 0]\ny = data[:, 1]\n\n# Lorentzian with offset: A * ( (gamma/2)^2 ) / ((x - x0)^2 + (gamma/2)^2 ) + offset\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * ( (gamma/2)**2 ) / ((x - x0)**2 + (gamma/2)**2) + offset\n\n# Helper to fit a region\ndef fit_region(x, y, region, guess):\n    mask = (x >= region[0]) & (x <= region[1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=guess, maxfev=10000)\n    return popt\n\n# Fit G peak (~1580 cm^-1)\nregion_G = (1500, 1650)\n# Initial guess: x0, gamma, amplitude, offset\nguess_G = [1580, 20, y.max() - y.min(), y.min()]\nparams_G = fit_region(x, y, region_G, guess_G)\n\n# Fit 2D peak (~2700 cm^-1)\nregion_2D = (2600, 2800)\ng"]
[116.551661, "i", "uess_2D = [2700, 30, y.max() - y.min(), y.min()]\nparams_2D = fit_region(x, y, region_2D, guess_2D)\n\n# Prepare JSON output\nresult = {\n    \"G\": {\n        \"x0\": float(params_G[0]),\n        \"gamma\": float(params_G[1]),\n        \"amplitude\": float(params_G[2]),\n        \"offset\": float(params_G[3])\n    },\n    \"2D\": {\n        \"x0\": float(params_2D[0]),\n        \"gamma\": float(params_2D[1]),\n        \"amplitude\": float(params_2D[2]),\n        \"offset\": float(params_2D[3])\n    }\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint('Fitting complete. Results written to results.json')\nEOF\n"]
[116.55178, "o", "cat > fit_raman.py << 'EOF'\r\n\u001b[?2004l\ruess_2D = [2700, 30, y.max() - y.min(), y.min()]\r\nparams_2D = fit_region(x, y, region_2D, guess_2D)\r\n\r\n# Prepare JSON output\r\nresult = {\r\n    \"G\": {\r\n        \"x0\": float(params_G[0]),\r\n        \"gamma\": float(params_G[1]),\r\n        \"amplitude\": float(params_G[2]),\r\n        \"offset\": float(params_G[3])\r\n    },\r\n    \"2D\": {\r\n        \"x0\": float(params_2D[0]),\r\n        \"gamma\": float(params_2D[1]),\r\n        \"amplitude\": float(params_2D[2]),\r\n        \"offset\": float(params_2D[3])\r\n    }\r\n}\r\n\r\nwith open('results.json', 'w') as f:\r\n    json.dump(result, f, indent=2)\r\n\r\nprint('Fitting complete. Results written to res"]
[116.551836, "o", "ults.json')\r\nEOF\r\n\u001b[?2004h> "]
