[?2004h> import numpy as np, json, sys
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data (assume two columns: Raman shift and intensity)
[?2004l[?2004h> try:
[?2004l[?2004h>     data = np.loadtxt('graphene.dat')
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     sys.stderr.write(f'Error loading data: {e}\n')
[?2004l[?2004h>     sys.exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian with offset: A * ( (gamma/2)^2 ) / ((x - x0)^2 + (gamma/2)^2 ) + offset
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * ( (gamma/2)**2 ) / ((x - x0)**2 + (gamma/2)**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a region
[?2004l[?2004h> def fit_region(x, y, region, guess):
[?2004l[?2004h>     mask = (x >= region[0]) & (x <= region[1])
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=guess, maxfev=10000)
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> # Fit G peak (~1580 cm^-1)
[?2004l[?2004h> region_G = (1500, 1650)
[?2004l[?2004h> # Initial guess: x0, gamma, amplitude, offset
[?2004l[?2004h> guess_G = [1580, 20, y.max() - y.min(), y.min()]
[?2004l[?2004h> params_G = fit_region(x, y, region_G, guess_G)
[?2004l[?2004h> 
[?2004l[?2004h> # Fit 2D peak (~2700 cm^-1)
[?2004l[?2004h> region_2D = (2600, 2800)
[?2004l[?2004h> guess_2D = [2700, 30, y.max() - y.min(), y.min()]
[?2004l[?2004h> params_2D = fit_region(x, y, region_2D, guess_2D)
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare JSON output
[?2004l[?2004h> result = {
[?2004l[?2004h>     "G": {
[?2004l[?2004h>         "x0": float(params_G[0]),
[?2004l[?2004h>         "gamma": float(params_G[1]),
[?2004l[?2004h>         "amplitude": float(params_G[2]),
[?2004l[?2004h>         "offset": float(params_G[3])
[?2004l[?2004h>     },
[?2004l[?2004h>     "2D": {
[?2004l[?2004h>         "x0": float(params_2D[0]),
[?2004l[?2004h>         "gamma": float(params_2D[1]),
[?2004l[?2004h>         "amplitude": float(params_2D[2]),
