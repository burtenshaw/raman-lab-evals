[?2004lcat > fit_raman.py << 'PY'
#!/usr/bin/env python3
import json
import numpy as np
import pandas as pd
from scipy.optimize import curve_fit

# Load data
data = pd.read_csv('spectrum.csv')
# Ensure columns are correct
x = data['raman_shift_cm-1'].values
y = data['intensity'].values

# Lorentzian with offset
def lorentzian(x, amplitude, gamma, x0, offset):
    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset

# Helper to fit a peak within a window
def fit_peak(x_center, window=100):
    mask = (x >= x_center - window) & (x <= x_center + window)
    x_fit = x[mask]
    y_fit = y[mask]
    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ x_center, offset ~ min(y)
    amp_guess = y_fit.max() - y_fit.min()
    gamma_guess = 10.0
    offset_guess = y_fit.min()
    p0 = [amp_guess, gamma_guess, x_center, offset_guess]
    try:
        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
    except RuntimeError:
        # If fit fails, return NaNs
        popt = [np.nan, np.nan, np.nan, np.nan]
    return popt

# Fit D, G, 2D peaks
peaks = {}
for name, center in [('D', 1350), ('G', 1580), ('2D', 2690)]:
    amp, gamma, x0, offset = fit_peak(center, window=120)
    peaks[name] = {
        'x0': float(x0),
        'gamma': float(gamma),
        'amplitude': float(amp),
        'offset': float(offset)
    }

# Compute defect ratio I_D/I_G
ID_IG = peaks['D']['amplitude'] / peaks['G']['amplitude'] if peaks['G']['amplitude'] != 0 else None

result = {
    'D': peaks['D'],
    'G': peaks['G'],
    '2D': peaks['2D'],
    'ID_IG': float(ID_IG) if ID_IG is not None else None
}

# Write to JSON
with open('results.json', 'w') as f:
    json.dump(result, f, indent=2)
PY
