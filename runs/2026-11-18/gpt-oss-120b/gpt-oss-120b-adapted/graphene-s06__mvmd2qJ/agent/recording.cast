[94.656918, "o", "import pandas as pd, numpy as np, json, sys\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.656958, "o", "# Load data\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.656996, "o", "    df = pd.read_csv('spectrum.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.657032, "o", "except Exception as e:\r\n\u001b[?2004l\r"]
[94.657056, "o", "\u001b[?2004h> "]
[94.657136, "o", "    sys.stderr.write(f'Error reading CSV: {e}\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.657168, "o", "> "]
[94.657204, "o", "    sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.657237, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.65727, "o", "x = df['raman_shift_cm-1'].values\r\n\u001b[?2004l\r"]
[94.657299, "o", "\u001b[?2004h> "]
[94.657328, "o", "y = df['intensity'].values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[94.657357, "o", "\u001b[?2004h> "]
[94.657367, "o", "# Lorentzian with offset\r\n\u001b[?2004l\r"]
[94.657404, "o", "\u001b[?2004h> "]
[94.657445, "o", "def lorentzian(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[94.657475, "o", "\u001b[?2004h> "]
[94.657544, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.657594, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.657629, "o", "def fit_peak(center, window=100):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.657709, "o", "    mask = (x >= center - window) & (x <= center + window)\r\n\u001b[?2004l\r"]
[94.657745, "o", "\u001b[?2004h> "]
[94.657777, "o", "    x_fit = x[mask]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.657788, "o", "    y_fit = y[mask]\r\n\u001b[?2004l\r"]
[94.657821, "o", "\u001b[?2004h> "]
[94.657919, "o", "    # Initial guesses: amplitude ~ peak height - baseline, x0 ~ center, gamma ~ 10, offset ~ min\r\n\u001b[?2004l\r"]
[94.657958, "o", "\u001b[?2004h> "]
[94.65801, "o", "    amp_guess = y_fit.max() - y_fit.min()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.658045, "o", "    offset_guess = y_fit.min()\r\n\u001b[?2004l\r"]
[94.658078, "o", "\u001b[?2004h> "]
[94.658117, "o", "    p0 = [amp_guess, center, 10.0, offset_guess]\r\n\u001b[?2004l\r"]
[94.658142, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[94.658185, "o", "\u001b[?2004h> "]
[94.658237, "o", "        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\r\n\u001b[?2004l\r"]
[94.658271, "o", "\u001b[?2004h> "]
[94.658304, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[94.658333, "o", "\u001b[?2004h> "]
[94.658381, "o", "        sys.stderr.write(f'Fit failed for center {center}: {e}\\n')\r\n\u001b[?2004l\r"]
[94.658412, "o", "\u001b[?2004h> "]
[94.65847, "o", "        popt = [np.nan, np.nan, np.nan, np.nan]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.658513, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.658563, "o", "        'amplitude': float(popt[0]),\r\n\u001b[?2004l\r"]
[94.658594, "o", "\u001b[?2004h> "]
[94.658635, "o", "        'x0': float(popt[1]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.658685, "o", "        'gamma': float(popt[2]),\r\n\u001b[?2004l\r"]
[94.658722, "o", "\u001b[?2004h> "]
[94.658755, "o", "        'offset': float(popt[3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.658795, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.658816, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.658851, "o", "# Fit D, G, 2D peaks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.658872, "o", "results = {}\r\n\u001b[?2004l\r"]
[94.658908, "o", "\u001b[?2004h> "]
[94.658943, "o", "results['D'] = fit_peak(1350)\r\n\u001b[?2004l\r"]
[94.658974, "o", "\u001b[?2004h> "]
[94.659007, "o", "results['G'] = fit_peak(1580)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.659046, "o", "results['2D'] = fit_peak(2690)\r\n\u001b[?2004l\r"]
[94.659079, "o", "\u001b[?2004h> "]
[94.659116, "o", "# Defect ratio I_D/I_G (using amplitudes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.659224, "o", "if not np.isnan(results['D']['amplitude']) and not np.isnan(results['G']['amplitude']):\r\n\u001b[?2004l\r"]
[94.65924, "o", "\u001b[?2004h> "]
[94.659332, "o", "    results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.659376, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.659405, "o", "    results['ID_IG'] = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.659433, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.659466, "o", "> # Write JSON output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.659522, "o", "with open('results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[94.659551, "o", "\u001b[?2004h> "]
[94.659585, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[94.659619, "o", "\u001b[?2004h> "]
[94.659646, "o", "EOF\r\n\u001b[?2004l\r"]
