[142.819142, "o", "def lorentzian(x, amplitude, gamma, x0, offset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.819216, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[142.819249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.819275, "o", "> "]
[142.819304, "o", "def fit_peak_region(center, window=120):\r\n\u001b[?2004l\r"]
[142.819332, "o", "\u001b[?2004h> "]
[142.819394, "o", "    # Select data within window\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.819439, "o", ">     if np is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.819565, "o", "        mask = (x >= center - window) & (x <= center + window)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.819629, "o", "        x_fit = x[mask]\r\n\u001b[?2004l\r"]
[142.819685, "o", "\u001b[?2004h>         y_fit = y[mask]\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[142.819714, "o", "\u001b[?2004h> "]
[142.819812, "o", "        x_fit = [xi for xi in x if center - window <= xi <= center + window]\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.819894, "o", "> "]
[142.819973, "o", "        y_fit = [yi for xi, yi in zip(x, y) if center - window <= xi <= center + window]\r\n\u001b[?2004l\r"]
[142.820004, "o", "\u001b[?2004h> "]
[142.820041, "o", "    return x_fit, y_fit\r\n\u001b[?2004l\r"]
[142.820078, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.820107, "o", "> "]
[142.820141, "o", "results = {}\r\n\u001b[?2004l\r"]
[142.820206, "o", "\u001b[?2004h> "]
[142.820235, "o", "peaks_info = {'D': 1350, 'G': 1580, '2D': 2690}\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.820268, "o", "> \r\n\u001b[?2004l\r"]
[142.820319, "o", "\u001b[?2004h> "]
[142.820366, "o", "for name, ctr in peaks_info.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.820397, "o", "> "]
[142.820428, "o", "    x_fit, y_fit = fit_peak_region(ctr, window=120)\r\n\u001b[?2004l\r"]
[142.820456, "o", "\u001b[?2004h> "]
[142.820492, "o", "    # Initial guesses\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.820537, "o", "    if len(y_fit) == 0:\r\n\u001b[?2004l\r"]
[142.820561, "o", "\u001b[?2004h> "]
[142.820599, "o", "        # No data, skip\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.820717, "o", "        results[name] = {'x0': None, 'gamma': None, 'amplitude': None, 'offset': None}\r\n\u001b[?2004l\r"]
[142.820748, "o", "\u001b[?2004h> "]
[142.820791, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.82083, "o", "    y_min = min(y_fit)\r\n\u001b[?2004l\r"]
[142.820859, "o", "\u001b[?2004h> "]
[142.820901, "o", "    y_max = max(y_fit)"]
[142.820921, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.820965, "o", "    amp_guess = y_max - y_min\r\n\u001b[?2004l\r"]
[142.821003, "o", "\u001b[?2004h> "]
[142.82105, "o", "    gamma_guess = 10.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.821164, "o", "    x0_guess = x_fit[y_fit.index(y_max)] if isinstance(y_fit, list) else x_fit[np.argmax(y_fit)]\r\n\u001b[?2004l\r"]
[142.821203, "o", "\u001b[?2004h> "]
[142.821266, "o", "    offset_guess = y_min\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.821319, "o", "    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\r\n\u001b[?2004l\r"]
[142.821367, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.821392, "o", "\u001b[?2004h> "]
[142.821405, "o", "    if have_curve_fit:\r\n\u001b[?2004l\r"]
[142.82143, "o", "\u001b[?2004h> "]
[142.821466, "o", "        try:\r\n\u001b[?2004l\r"]
[142.82155, "o", "\u001b[?2004h> "]
[142.821633, "o", "            popt, _ = curve_fit(lorentzian, np.array(x_fit), np.array(y_fit), p0=p0)\r\n\u001b[?2004l\r"]
[142.821669, "o", "\u001b[?2004h> "]
[142.821734, "o", "            amplitude, gamma, x0, offset = popt\r\n\u001b[?2004l\r"]
[142.821761, "o", "\u001b[?2004h> "]
[142.821805, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[142.821839, "o", "\u001b[?2004h> "]
[142.821936, "o", "            # Fallback to heuristic if fitting fails\r\n\u001b[?2004l\r"]
[142.821972, "o", "\u001b[?2004h> "]
[142.822017, "o", "            have_curve_fit = False\r\n\u001b[?2004l\r"]
[142.822044, "o", "\u001b[?2004h> "]
[142.822091, "o", "    if not have_curve_fit:\r\n"]
[142.822121, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[142.822181, "o", "        # Simple heuristic estimation\r\n\u001b[?2004l\r"]
[142.822222, "o", "\u001b[?2004h> "]
[142.822269, "o", "        amplitude = amp_guess\r\n\u001b[?2004l\r"]
[142.822309, "o", "\u001b[?2004h> "]
[142.822356, "o", "        offset = offset_guess\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.82239, "o", "        x0 = x0_guess\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.822448, "o", "        # Estimate gamma as half-width at half-maximum (approximate)\r\n\u001b[?2004l\r"]
[142.822477, "o", "\u001b[?2004h> "]
[142.822517, "o", "        half_max = offset + amplitude / 2.0\r\n\u001b[?2004l\r"]
[142.822555, "o", "\u001b[?2004h> "]
[142.822624, "o", "        # Find points on each side of the peak where y crosses half_max\r\n\u001b[?2004l\r"]
[142.822655, "o", "\u001b[?2004h> "]
[142.822694, "o", "        left_gamma = None\r\n\u001b[?2004l\r"]
[142.822732, "o", "\u001b[?2004h> "]
[142.82277, "o", "        right_gamma = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.8228, "o", "        # Ensure data is sorted by x\r\n\u001b[?2004l\r"]
[142.822843, "o", "\u001b[?2004h> "]
[142.82287, "o", "        if np is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.822916, "o", "            sorted_idx = np.argsort(x_fit)\r\n\u001b[?2004l\r"]
[142.822942, "o", "\u001b[?2004h> "]
[142.822984, "o", "            x_sorted = x_fit[sorted_idx]\r\n\u001b[?2004l\r"]
[142.823015, "o", "\u001b[?2004h> "]
[142.823053, "o", "            y_sorted = y_fit[sorted_idx]\r\n\u001b[?2004l\r"]
[142.823104, "o", "\u001b[?2004h> "]
[142.82313, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.823171, "o", "            combined = sorted(zip(x_fit, y_fit))\r\n\u001b[?2004l\r"]
[142.823201, "o", "\u001b[?2004h> "]
[142.823307, "o", "            x_sorted, y_sorted = zip(*combined) if combined else ([], [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.823412, "o", "        # Scan for crossing points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.823472, "o", "        for i in range(1, len(x_sorted)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.823505, "o", "> "]
[142.823617, "o", "            if (y_sorted[i-1] - half_max) * (y_sorted[i] - half_max) <= 0:\r\n\u001b[?2004l\r"]
[142.82365, "o", "\u001b[?2004h"]
[142.823695, "o", "> "]
[142.823769, "o", "                # Linear interpolation for crossing point\r\n\u001b[?2004l\r"]
[142.823796, "o", "\u001b[?2004h> "]
[142.823859, "o", "                x1, y1 = x_sorted[i-1], y_sorted[i-1]\r\n\u001b[?2004l\r"]
[142.823898, "o", "\u001b[?2004h> "]
[142.823934, "o", "                x2, y2 = x_sorted[i], y_sorted[i]\r\n\u001b[?2004l\r"]
[142.823975, "o", "\u001b[?2004h> "]
[142.823984, "o", "                if y2 != y1:\r\n\u001b[?2004l\r"]
[142.824025, "o", "\u001b[?2004h> "]
[142.824094, "o", "                    x_cross = x1 + (half_max - y1) * (x2 - x1) / (y2 - y1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.824132, "o", "> "]
[142.824163, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.824226, "o", "> "]
[142.824292, "o", "                    x_cross = x1\r\n\u001b[?2004l\r\u001b[?2004h>                 if x_cross < x0 and left_gamma is None:\r\n\u001b[?2004l\r"]
[142.824318, "o", "\u001b[?2004h> "]
[142.82437, "o", "                    left_gamma = abs(x0 - x_cross)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.824391, "o", "> "]
[142.824457, "o", "                elif x_cross > x0 and right_gamma is None:\r\n\u001b[?2004l\r"]
[142.824482, "o", "\u001b[?2004h> "]
[142.824535, "o", "                    right_gamma = abs(x_cross - x0)\r\n\u001b[?2004l\r"]
[142.824559, "o", "\u001b[?2004h> "]
[142.824628, "o", "        if left_gamma is not None and right_gamma is not None:\r\n\u001b[?2004l\r"]
[142.824652, "o", "\u001b[?2004h> "]
[142.824703, "o", "            gamma = (left_gamma + right_gamma) / 2.0\r\n\u001b[?2004l\r"]
[142.824728, "o", "\u001b[?2004h> "]
[142.824764, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.824798, "o", "            gamma = gamma_guess\r\n\u001b[?2004l\r"]
[142.824825, "o", "\u001b[?2004h> "]
[142.824857, "o", "    results[name] = {\r\n\u001b[?2004l\r"]
[142.824897, "o", "\u001b[?2004h> "]
[142.824924, "o", "        'x0': float(x0),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.824974, "o", "        'gamma': float(gamma),\r\n\u001b[?2004l\r"]
[142.825017, "o", "\u001b[?2004h> "]
[142.825087, "o", "        'amplitude': float(amplitude),\r\n\u001b[?2004l\r"]
[142.825129, "o", "\u001b[?2004h> "]
[142.825187, "o", "        'offset': float(offset)\r\n\u001b[?2004l\r"]
[142.825231, "o", "\u001b[?2004h> "]
[142.825256, "o", "    }\r\n\u001b[?2004l\r"]
[142.825286, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.825322, "o", "\u001b[?2004h> "]
[142.825405, "o", "# Compute defect ratio I_D/I_G using amplitudes (avoid division by zero)\r\n\u001b[?2004l\r"]
[142.825449, "o", "\u001b[?2004h> "]
[142.825501, "o", "amp_D = results['D']['amplitude']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.825533, "o", "amp_G = results['G']['amplitude']\r\n\u001b[?2004l\r"]
[142.82556, "o", "\u001b[?2004h> "]
[142.82562, "o", "ID_IG = amp_D / amp_G if amp_G not in (0, None) else None\r\n\u001b[?2004l\r"]
[142.825644, "o", "\u001b[?2004h> "]
[142.825714, "o", "results['ID_IG'] = float(ID_IG) if ID_IG is not None else None\r\n\u001b[?2004l\r"]
[142.825738, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.825769, "o", "\u001b[?2004h> "]
[142.825795, "o", "# Write to JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.825826, "o", "with open('results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[142.825851, "o", "\u001b[?2004h> "]
[142.825889, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[142.825898, "o", "\u001b[?2004h> "]
[142.825932, "o", "EOF"]
[143.316471, "i", "python3 fit_peaks_simple.py\n"]
[143.316612, "o", "python3 fit_peaks_simple.py\r\n\u001b[?2004l\r"]
[143.316667, "o", "\u001b[?2004h> "]
[146.273923, "i", "cat results.json\n"]
[146.274235, "o", "cat results.json\r\n\u001b[?2004l\r\u001b[?2004h> "]
