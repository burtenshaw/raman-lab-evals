[45.50525, "i", "cat > fit_peaks.py << 'EOF'\nimport pandas as pd, numpy as np, json\nfrom scipy.optimize import curve_fit\n\n# Load data\ndf = pd.read_csv('spectrum.csv')\n# Ensure columns are correct\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak within a window\ndef fit_peak(x_center, window=100):\n    mask = (x >= x_center - window) & (x <= x_center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    x0_guess = x_center\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    return popt  # amplitude, gamma, x0, offset\n\npeaks = {}\nfor name, center in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    amp, gamma, x0, offset = fit_peak(center, window=120)\n    peaks[name] = {\n        'x0': float(x0),\n     "]
[45.50537, "i", "   'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\n# Compute defect ratio I_D/I_G (using amplitudes)\nID_IG = peaks['D']['amplitude'] / peaks['G']['amplitude'] if peaks['G']['amplitude'] != 0 else None\n\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': float(ID_IG) if ID_IG is not None else None\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nEOF\n"]
