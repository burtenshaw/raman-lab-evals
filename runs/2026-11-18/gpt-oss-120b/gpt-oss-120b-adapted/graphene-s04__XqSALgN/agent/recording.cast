[75.508946, "o", "\u001b[?2004hroot@j-openenv-6afd8a1b29e8b7ccfbbb8197-st5wfxtv-f82a3-6k5hj:/app# "]
[75.557098, "i", "python3 - << 'PY'\nimport pandas as pd, numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\ntry:\n    data = pd.read_csv('spectrum.csv')\nexcept Exception as e:\n    print('Error loading CSV:', e)\n    sys.exit(1)\n\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\n# Lorentzian with offset\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak given an approximate center and window\ndef fit_peak(center, window=100):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ center, offset ~ min(y)\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, center, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        print(f'Fit failed for center {center}:',"]
[75.557269, "i", " e)\n        popt = [np.nan]*4\n    return popt\n\npeaks = {}\nfor name, cen in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    amp, gamma, x0, off = fit_peak(cen)\n    peaks[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(off)\n    }\n\n# Compute defect ratio\nID_IG = peaks['D']['amplitude'] / peaks['G']['amplitude'] if peaks['G']['amplitude'] != 0 else np.nan\n\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': float(ID_IG)\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Fitting complete, results written to results.json')\nPY\n"]
