[?2004lpython3 - << 'PY'
import numpy as np, json, sys
from scipy.optimize import curve_fit

# Load data
x, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)

def lorentzian(x, amplitude, gamma, x0, offset):
    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset

# Define peak regions and initial guesses
peaks = {
    'D':  {'center': 1350, 'window': 100, 'guess': [max(y), 10, 1350, min(y)]},
    'G':  {'center': 1580, 'window': 100, 'guess': [max(y), 10, 1580, min(y)]},
    '2D': {'center': 2690, 'window': 150, 'guess': [max(y), 10, 2690, min(y)]},
}

results = {}
for name, info in peaks.items():
    mask = (x >= info['center'] - info['window']) & (x <= info['center'] + info['window'])
    x_fit, y_fit = x[mask], y[mask]
    p0 = info['guess']
    try:
        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
    except Exception as e:
        print(f'Fit failed for {name}:', e, file=sys.stderr)
        popt = [np.nan]*4
    results[name] = {
        'x0': float(popt[2]),
        'gamma': float(popt[1]),
        'amplitude': float(popt[0]),
        'offset': float(popt[3])
    }

# Compute defect ratio
ID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else np.nan
results['ID_IG'] = float(ID_IG)

# Write JSON
with open('results.json', 'w') as f:
    json.dump(results, f, indent=2)
PY
cat results.json
