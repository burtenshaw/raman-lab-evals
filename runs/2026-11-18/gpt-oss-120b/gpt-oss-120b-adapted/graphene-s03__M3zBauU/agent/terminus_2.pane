[?2004l[?2004h> import numpy as np, json, sys
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> try:
[?2004l[?2004h>     data = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     sys.stderr.write(f'Error loading CSV: {e}\n')
[?2004l[?2004h>     sys.exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> x = data[:,0]
[?2004l[?2004h>  y = data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian plus offset model
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a region
[?2004l[?2004h> def fit_region(x, y, center, window):
[?2004l[?2004h>     mask = (x >= center - window) & (x <= center + window)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     # Initial guesses: amplitude ~ max(y)-min(y), x0 ~ center, gamma ~ window/2, offset ~ min(y)
[?2004l[?2004h>     amp_guess = y_fit.max() - y_fit.min()
[?2004l[?2004h>     offset_guess = y_fit.min()
[?2004l[?2004h>     p0 = [amp_guess, center, window/2, offset_guess]
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         sys.stderr.write(f'Fit failed for center {center}: {e}\n')
[?2004l[?2004h>         popt = [np.nan]*4
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> # Fit D, G, 2D peaks
[?2004l[?2004h> params_D = fit_region(x, y, 1350, 100)  # +/-100 cm-1 window
[?2004l[?2004h> params_G = fit_region(x, y, 1580, 100)
[?2004l[?2004h> params_2D = fit_region(x, y, 2690, 150)
[?2004l[?2004h> 
[?2004l[?2004h> result = {
[?2004l[?2004h>     'D': {'x0': float(params_D[1]), 'gamma': float(params_D[2]), 'amplitude': float(params_D[0]), 'offset': float(params_D[3])},
[?2004l[?2004h>     'G': {'x0': float(params_G[1]), 'gamma': float(params_G[2]), 'amplitude': float(params_G[0]), 'offset': float(params_G[3])},
[?2004l[?2004h>     '2D': {'x0': float(params_2D[1]), 'gamma': float(params_2D[2]), 'amplitude': float(params_2D[0]), 'offset': float(params_2D[3])},
[?2004l[?2004h>     'ID_IG': float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('results.json', 'w') as f:
