[?2004hroot@j-openenv-6afd893be5cad0e4dc3e698e-drjwk9v2-8df94-hrbl6:/app# python3 - << 'PY'
[?2004l[?2004h> import numpy as np, json, sys
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> x, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian with offset
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a peak given initial guess
[?2004l[?2004h> def fit_peak(x, y, guess):
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x, y, p0=guess, maxfev=10000)
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> # Initial guesses: [amplitude, gamma, x0, offset]
[?2004l[?2004h> # Roughly estimate offset as min intensity near region
[?2004l[?2004h> # Use broad windows around each peak
[?2004l[?2004h> peaks = {}
[?2004l[?2004h> # D peak around 1350
[?2004l[?2004h> mask_D = (x > 1200) & (x < 1500)
[?2004l[?2004h> guess_D = [np.max(y[mask_D]) - np.min(y[mask_D]), 10, 1350, np.min(y[mask_D])]
[?2004l[?2004h> peaks['D'] = fit_peak(x[mask_D], y[mask_D], guess_D)
[?2004l[?2004h> # G peak around 1580
[?2004l[?2004h> mask_G = (x > 1450) & (x < 1750)
[?2004l[?2004h> guess_G = [np.max(y[mask_G]) - np.min(y[mask_G]), 10, 1580, np.min(y[mask_G])]
[?2004l[?2004h> peaks['G'] = fit_peak(x[mask_G], y[mask_G], guess_G)
[?2004l[?2004h> # 2D peak around 2690
[?2004l[?2004h> mask_2D = (x > 2500) & (x < 2850)
[?2004l[?2004h> guess_2D = [np.max(y[mask_2D]) - np.min(y[mask_2D]), 10, 2690, np.min(y[mask_2D])]
[?2004l[?2004h> peaks['2D'] = fit_peak(x[mask_2D], y[mask_2D], guess_2D)
[?2004l[?2004h> 
[?2004l[?2004h> # Build result dict
[?2004l[?2004h> result = {}
[?2004l[?2004h> for name, params in peaks.items():
[?2004l[?2004h>     result[name] = {
[?2004l[?2004h>         'x0': float(params[2]),
[?2004l[?2004h>         'gamma': float(params[1]),
[?2004l[?2004h>         'amplitude': float(params[0]),
[?2004l[?2004h>         'offset': float(params[3])
[?2004l[?2004h>     }
[?2004l[?2004h> # Defect ratio I_D/I_G
[?2004l[?2004h> result['ID_IG'] = float(result['D']['amplitude'] / result['G']['amplitude'])
[?2004l[?2004h> 
[?2004l[?2004h> # Write JSON
[?2004l[?2004h> with open('results.json', 'w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
[?2004l[?2004h> print('Done')
