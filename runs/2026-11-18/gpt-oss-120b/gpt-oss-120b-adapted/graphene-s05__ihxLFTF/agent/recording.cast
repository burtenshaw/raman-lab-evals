[156.743277, "i", "python3 - << 'PY'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\n# Load data\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, guess):\n    popt, _ = curve_fit(lorentzian, x, y, p0=guess, maxfev=10000)\n    return popt\n\npeaks = {}\n# D peak\nmask_D = (x > 1200) & (x < 1500)\nguess_D = [np.max(y[mask_D]) - np.min(y[mask_D]), 10, 1350, np.min(y[mask_D])]\npeaks['D'] = fit_peak(x[mask_D], y[mask_D], guess_D)\n# G peak\nmask_G = (x > 1450) & (x < 1750)\nguess_G = [np.max(y[mask_G]) - np.min(y[mask_G]), 10, 1580, np.min(y[mask_G])]\npeaks['G'] = fit_peak(x[mask_G], y[mask_G], guess_G)\n# 2D peak\nmask_2D = (x > 2500) & (x < 2850)\nguess_2D = [np.max(y[mask_2D]) - np.min(y[mask_2D]), 10, 2690, np.min(y[mask_2D])]\npeaks['2D'] = fit_peak(x[mask_2D], y[mask_2D], guess_2D)\n\nresult = {}\nfor name, params in peaks.items():\n    result[name] = {\n        'x0': fl"]
[156.743325, "i", "oat(params[2]),\n        'gamma': float(params[1]),\n        'amplitude': float(params[0]),\n        'offset': float(params[3])\n    }\nresult['ID_IG'] = float(result['D']['amplitude'] / result['G']['amplitude'])\n\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Fitting complete, results written to results.json')\nPY\n"]
