Sending keys: ['python3 - <<\'PY\'\nimport pandas as pd, numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\ntry:\n    data = pd.read_csv(\'/app/spectrum.csv\')\nexcept Exception as e:\n    print(\'Error reading CSV:\', e)\n    sys.exit(1)\n\nx = data[\'raman_shift_cm-1\'].values\ny = data[\'intensity\'].values\n\n# Lorentzian model\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a region\ndef fit_region(x_center, window):\n    mask = (x >= x_center - window) & (x <= x_center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses\n    amp_guess = max(y_fit) - min(y_fit)\n    gamma_guess = 10.0\n    offset_guess = min(y_fit)\n    p0 = [amp_guess, gamma_guess, x_center, offset_guess]\n    bounds = ([0, 0, x_center - window, -np.inf], [np.inf, np.inf, x_center + window, np.inf])\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=bounds)\n    except Exception as e:\n        print(f\'Fit failed for center {x_center}:\', e)\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return popt\n\n# Fit each peak\nparams_D = fit_region(1350, 150)   # D peak window ±150 cm⁻¹\nparams_G = fit_region(1580, 150)   # G peak window ±150 cm⁻¹\nparams_2D = fit_region(2690, 200)  # 2D peak window ±200 cm⁻¹\n\n# Build result dict\nresult = {\n    "D": {\n        "x0": float(params_D[2]),\n        "gamma": float(params_D[1]),\n        "amplitude": float(params_D[0]),\n        "offset": float(params_D[3])\n    },\n    "G": {\n        "x0": float(params_G[2]),\n        "gamma": float(params_G[1]),\n        "amplitude": float(params_G[0]),\n        "offset": float(params_G[3])\n    },\n    "2D": {\n        "x0": float(params_2D[2]),\n        "gamma": float(params_2D[1]),\n        "amplitude": float(params_2D[0]),\n        "offset": float(params_2D[3])\n    },\n    "ID_IG": float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)\n}\n\n# Write JSON\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\nprint(\'Fitting complete, results written to /app/results.json\')\nPY\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
