Sending keys: ["cat > fit_peaks.py << 'EOF'\nimport pandas as pd, json, numpy as np, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\ntry:\n    data = pd.read_csv('spectrum.csv')\nexcept Exception as e:\n    sys.stderr.write(f'Error reading CSV: {e}\\n')\n    sys.exit(1)\n\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\n# Lorentzian with offset\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak within a window\ndef fit_peak(center, window=100):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ center, offset ~ min(y)\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, center, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        sys.stderr.write(f'Fit failed for center {center}: {e}\\n')\n        popt = [np.nan]*4\n    return popt\n\npeaks = {}\nfor name, cen in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    amp, gamma, x0, offset = fit_peak(cen)\n    peaks[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\n# Compute defect ratio I_D/I_G\nID_IG = peaks['D']['amplitude'] / peaks['G']['amplitude'] if peaks['G']['amplitude'] != 0 else None\n\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': float(ID_IG) if ID_IG is not None else None\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint('Fitting complete. Results written to results.json')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
