Sending keys: ['cat > fit_raman.py << \'EOF\'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data, skip header row\ntry:\n    data = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', names=True)\nexcept Exception as e:\n    sys.stderr.write(f\'Error loading CSV: {e}\\n\')\n    sys.exit(1)\n\nx = data[\'raman_shift_cm_1\'] if \'raman_shift_cm_1\' in data.dtype.names else data[\'raman_shift_cm-1\']\n# Handle possible column name variations\nif isinstance(x, np.ndarray) and x.dtype.char == \'U\':\n    # If loaded as strings, convert to float\n    x = x.astype(float)\nintensity = data[\'intensity\']\n\n# Lorentzian model with offset\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak within a window\ndef fit_peak(center, window=100):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = intensity[mask]\n    # Initial guesses\n    amp_guess = np.max(y_fit) - np.min(y_fit)\n    gamma_guess = 10.0\n    x0_guess = center\n    offset_guess = np.min(y_fit)\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\n    # Bounds to keep parameters physical\n    lower = [0, 0.1, center - window, 0]\n    upper = [np.inf, window, center + window, np.max(y_fit)]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=(lower, upper))\n    except Exception as e:\n        sys.stderr.write(f\'Fit failed for peak at {center} cm⁻¹: {e}\\n\')\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return popt\n\n# Fit D, G, 2D peaks\nparams_D = fit_peak(1350, window=150)\nparams_G = fit_peak(1580, window=150)\nparams_2D = fit_peak(2690, window=200)\n\n# Compute defect ratio I_D/I_G using amplitudes\nID_IG = params_D[0] / params_G[0] if params_G[0] != 0 else np.nan\n\n# Prepare result dictionary\nresult = {\n    "D": {\n        "x0": float(params_D[2]),\n        "gamma": float(params_D[1]),\n        "amplitude": float(params_D[0]),\n        "offset": float(params_D[3])\n    },\n    "G": {\n        "x0": float(params_G[2]),\n        "gamma": float(params_G[1]),\n        "amplitude": float(params_G[0]),\n        "offset": float(params_G[3])\n    },\n    "2D": {\n        "x0": float(params_2D[2]),\n        "gamma": float(params_2D[1]),\n        "amplitude": float(params_2D[0]),\n        "offset": float(params_2D[3])\n    },\n    "ID_IG": float(ID_IG)\n}\n\n# Write to JSON file\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(\'Fitting complete. Results written to /app/results.json\')\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
