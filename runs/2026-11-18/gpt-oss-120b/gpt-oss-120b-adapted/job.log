Sending keys: ["cat > fit_peaks_simple.py << 'EOF'\nimport csv, json, math, sys\n\n# Try to import numpy and scipy\ntry:\n    import numpy as np\nexcept ImportError:\n    np = None\n\ntry:\n    from scipy.optimize import curve_fit\n    have_curve_fit = True\nexcept ImportError:\n    have_curve_fit = False\n\n# Load data from CSV using csv module\nx_vals = []\ny_vals = []\nwith open('spectrum.csv', newline='') as csvfile:\n    reader = csv.DictReader(csvfile)\n    for row in reader:\n        try:\n            x_vals.append(float(row['raman_shift_cm-1']))\n            y_vals.append(float(row['intensity']))\n        except (KeyError, ValueError):\n            # Skip malformed rows\n            continue\n\nif np is not None:\n    x = np.array(x_vals)\n    y = np.array(y_vals)\nelse:\n    x = x_vals\n    y = y_vals\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak_region(center, window=120):\n    # Select data within window\n    if np is not None:\n        mask = (x >= center - window) & (x <= center + window)\n        x_fit = x[mask]\n        y_fit = y[mask]\n    else:\n        x_fit = [xi for xi in x if center - window <= xi <= center + window]\n        y_fit = [yi for xi, yi in zip(x, y) if center - window <= xi <= center + window]\n    return x_fit, y_fit\n\nresults = {}\npeaks_info = {'D': 1350, 'G': 1580, '2D': 2690}\n\nfor name, ctr in peaks_info.items():\n    x_fit, y_fit = fit_peak_region(ctr, window=120)\n    # Initial guesses\n    if len(y_fit) == 0:\n        # No data, skip\n        results[name] = {'x0': None, 'gamma': None, 'amplitude': None, 'offset': None}\n        continue\n    y_min = min(y_fit)\n    y_max = max(y_fit)\n    amp_guess = y_max - y_min\n    gamma_guess = 10.0\n    x0_guess = x_fit[y_fit.index(y_max)] if isinstance(y_fit, list) else x_fit[np.argmax(y_fit)]\n    offset_guess = y_min\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\n\n    if have_curve_fit:\n        try:\n            popt, _ = curve_fit(lorentzian, np.array(x_fit), np.array(y_fit), p0=p0)\n            amplitude, gamma, x0, offset = popt\n        except Exception as e:\n            # Fallback to heuristic if fitting fails\n            have_curve_fit = False\n    if not have_curve_fit:\n        # Simple heuristic estimation\n        amplitude = amp_guess\n        offset = offset_guess\n        x0 = x0_guess\n        # Estimate gamma as half-width at half-maximum (approximate)\n        half_max = offset + amplitude / 2.0\n        # Find points on each side of the peak where y crosses half_max\n        left_gamma = None\n        right_gamma = None\n        # Ensure data is sorted by x\n        if np is not None:\n            sorted_idx = np.argsort(x_fit)\n            x_sorted = x_fit[sorted_idx]\n            y_sorted = y_fit[sorted_idx]\n        else:\n            combined = sorted(zip(x_fit, y_fit))\n            x_sorted, y_sorted = zip(*combined) if combined else ([], [])\n        # Scan for crossing points\n        for i in range(1, len(x_sorted)):\n            if (y_sorted[i-1] - half_max) * (y_sorted[i] - half_max) <= 0:\n                # Linear interpolation for crossing point\n                x1, y1 = x_sorted[i-1], y_sorted[i-1]\n                x2, y2 = x_sorted[i], y_sorted[i]\n                if y2 != y1:\n                    x_cross = x1 + (half_max - y1) * (x2 - x1) / (y2 - y1)\n                else:\n                    x_cross = x1\n                if x_cross < x0 and left_gamma is None:\n                    left_gamma = abs(x0 - x_cross)\n                elif x_cross > x0 and right_gamma is None:\n                    right_gamma = abs(x_cross - x0)\n        if left_gamma is not None and right_gamma is not None:\n            gamma = (left_gamma + right_gamma) / 2.0\n        else:\n            gamma = gamma_guess\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amplitude),\n        'offset': float(offset)\n    }\n\n# Compute defect ratio I_D/I_G using amplitudes (avoid division by zero)\namp_D = results['D']['amplitude']\namp_G = results['G']['amplitude']\nID_IG = amp_D / amp_G if amp_G not in (0, None) else None\nresults['ID_IG'] = float(ID_IG) if ID_IG is not None else None\n\n# Write to JSON\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
