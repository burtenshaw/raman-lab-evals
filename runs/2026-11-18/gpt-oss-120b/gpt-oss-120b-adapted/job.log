Sending keys: ['cat > fit_raman.py << \'EOF\'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data with header names\ntry:\n    data = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', names=True, dtype=None, encoding=\'utf-8\')\nexcept Exception as e:\n    sys.stderr.write(f\'Error loading CSV: {e}\\n\')\n    sys.exit(1)\n\n# Determine column names\ncols = data.dtype.names\nif len(cols) < 2:\n    sys.stderr.write(\'CSV does not have at least two columns.\\n\')\n    sys.exit(1)\n# Assume first column is Raman shift, second is intensity\nx = data[cols[0]]\nintensity = data[cols[1]]\n\n# Ensure numeric types\nx = np.array(x, dtype=float)\nintensity = np.array(intensity, dtype=float)\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=100):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = intensity[mask]\n    if x_fit.size == 0:\n        return [np.nan, np.nan, np.nan, np.nan]\n    amp_guess = np.max(y_fit) - np.min(y_fit)\n    gamma_guess = 10.0\n    x0_guess = center\n    offset_guess = np.min(y_fit)\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\n    lower = [0, 0.1, center - window, 0]\n    upper = [np.inf, window, center + window, np.max(y_fit)]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=(lower, upper))\n    except Exception as e:\n        sys.stderr.write(f\'Fit failed for peak at {center} cm⁻¹: {e}\\n\')\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return popt\n\nparams_D = fit_peak(1350, window=150)\nparams_G = fit_peak(1580, window=150)\nparams_2D = fit_peak(2690, window=200)\n\nID_IG = params_D[0] / params_G[0] if params_G[0] != 0 else np.nan\n\nresult = {\n    "D": {"x0": float(params_D[2]), "gamma": float(params_D[1]), "amplitude": float(params_D[0]), "offset": float(params_D[3])},\n    "G": {"x0": float(params_G[2]), "gamma": float(params_G[1]), "amplitude": float(params_G[0]), "offset": float(params_G[3])},\n    "2D": {"x0": float(params_2D[2]), "gamma": float(params_2D[1]), "amplitude": float(params_2D[0]), "offset": float(params_2D[3])},\n    "ID_IG": float(ID_IG)\n}\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(\'Fitting complete. Results written to /app/results.json\')\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
