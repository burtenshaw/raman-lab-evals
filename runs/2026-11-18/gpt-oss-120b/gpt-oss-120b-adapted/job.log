Sending keys: ["cat > fit_peaks.py <<'EOF'\nimport pandas as pd, numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\ntry:\n    df = pd.read_csv('spectrum.csv')\nexcept Exception as e:\n    sys.stderr.write(f'Error reading CSV: {e}\\n')\n    sys.exit(1)\n\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\n# Lorentzian with offset\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=100):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ peak height - baseline, x0 ~ center, gamma ~ 10, offset ~ min\n    amp_guess = y_fit.max() - y_fit.min()\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, center, 10.0, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        sys.stderr.write(f'Fit failed for center {center}: {e}\\n')\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return {\n        'amplitude': float(popt[0]),\n        'x0': float(popt[1]),\n        'gamma': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Fit D, G, 2D peaks\nresults = {}\nresults['D'] = fit_peak(1350)\nresults['G'] = fit_peak(1580)\nresults['2D'] = fit_peak(2690)\n# Defect ratio I_D/I_G (using amplitudes)\nif not np.isnan(results['D']['amplitude']) and not np.isnan(results['G']['amplitude']):\n    results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nelse:\n    results['ID_IG'] = None\n\n# Write JSON output\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
