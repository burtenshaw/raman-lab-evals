Sending keys: ["python3 - << 'PY'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\n# Lorentzian model with offset\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Fit function for a given window and initial guess\ndef fit_peak(x, y, window, guess):\n    mask = (x >= window[0]) & (x <= window[1])\n    popt, _ = curve_fit(lorentzian, x[mask], y[mask], p0=guess, maxfev=10000)\n    return popt\n\n# Define windows and initial guesses\nwindows = {\n    'D': (1300, 1400),\n    'G': (1500, 1650),\n    '2D': (2600, 2800)\n}\ninitial_guesses = {}\nfor name, (lo, hi) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    y_window = y[mask]\n    x_window = x[mask]\n    amp_guess = y_window.max() - y_window.min()\n    x0_guess = x_window[np.argmax(y_window)]\n    gamma_guess = 10.0\n    offset_guess = y_window.min()\n    initial_guesses[name] = [amp_guess, x0_guess, gamma_guess, offset_guess]\n\n# Perform fits\nresults = {}\nfor name in ['D', 'G', '2D']:\n    popt = fit_peak(x, y, windows[name], initial_guesses[name])\n    results[name] = {\n        'amplitude': float(popt[0]),\n        'x0': float(popt[1]),\n        'gamma': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Compute defect ratio I_D/I_G (using amplitudes)\nID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\nresults['ID_IG'] = float(ID_IG) if ID_IG is not None else None\n\n# Write to JSON\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results written to results.json')\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
Sending keys: ['cat > fit_raman_simple.py << \'EOF\'\nimport csv\nimport json\nimport numpy as np\n\n# Load data from CSV\nx = []\ny = []\nwith open(\'spectrum.csv\', newline=\'\') as csvfile:\n    reader = csv.DictReader(csvfile)\n    for row in reader:\n        x.append(float(row[\'raman_shift_cm-1\']))\n        y.append(float(row[\'intensity\']))\n\nx = np.array(x)\ny = np.array(y)\n\ndef estimate_lorentzian(x_center, window=50):\n    # Select data within the window\n    mask = (x >= x_center - window) & (x <= x_center + window)\n    x_win = x[mask]\n    y_win = y[mask]\n    if len(x_win) == 0:\n        return np.nan, np.nan, np.nan, np.nan\n    # Offset as minimum intensity in window\n    offset = float(y_win.min())\n    # Amplitude as max - offset\n    amplitude = float(y_win.max() - offset)\n    # Peak position (x0) as x at maximum intensity\n    idx_max = y_win.argmax()\n    x0 = float(x_win[idx_max])\n    # Half‑maximum level\n    half_max = offset + amplitude / 2.0\n    # Find left crossing point\n    left_idx = np.where(y_win[:idx_max] <= half_max)[0]\n    if left_idx.size == 0:\n        left_x = x0\n    else:\n        i = left_idx[-1]\n        # Linear interpolation between points i and i+1\n        x1, y1 = x_win[i], y_win[i]\n        x2, y2 = x_win[i+1], y_win[i+1]\n        if y2 != y1:\n            left_x = x1 + (half_max - y1) * (x2 - x1) / (y2 - y1)\n        else:\n            left_x = x1\n    # Find right crossing point\n    right_idx = np.where(y_win[idx_max:] <= half_max)[0]\n    if right_idx.size == 0:\n        right_x = x0\n    else:\n        i = right_idx[0] + idx_max\n        x1, y1 = x_win[i-1], y_win[i-1]\n        x2, y2 = x_win[i], y_win[i]\n        if y2 != y1:\n            right_x = x1 + (half_max - y1) * (x2 - x1) / (y2 - y1)\n        else:\n            right_x = x2\n    # Gamma = half of the full width at half maximum\n    gamma = float((right_x - left_x) / 2.0)\n    return x0, gamma, amplitude, offset\n\n# Estimate parameters for each peak\nx0_D, gamma_D, amp_D, off_D = estimate_lorentzian(1350)\nx0_G, gamma_G, amp_G, off_G = estimate_lorentzian(1580)\nx0_2D, gamma_2D, amp_2D, off_2D = estimate_lorentzian(2690)\n\n# Defect ratio I_D/I_G\nID_IG = float(amp_D / amp_G) if amp_G != 0 else float(\'nan\')\n\nresult = {\n    "D": {"x0": x0_D, "gamma": gamma_D, "amplitude": amp_D, "offset": off_D},\n    "G": {"x0": x0_G, "gamma": gamma_G, "amplitude": amp_G, "offset": off_G},\n    "2D": {"x0": x0_2D, "gamma": gamma_2D, "amplitude": amp_2D, "offset": off_2D},\n    "ID_IG": ID_IG\n}\n\nwith open(\'results.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(\'Fitting complete. Results written to results.json\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
