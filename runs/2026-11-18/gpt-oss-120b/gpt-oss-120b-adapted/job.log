Sending keys: ["cat > fit_raman.py << 'EOF'\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Lorentzian with offset\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data (skip header)\n# Assuming the CSV has two columns: raman_shift_cm-1, intensity\nxs, ys = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\nresults = {}\n\n# Peak definitions: center (approx), window half-width, initial gamma guess\npeaks = {\n    'D':  {'center': 1350, 'half_width': 100, 'gamma_guess': 30},\n    'G':  {'center': 1580, 'half_width': 100, 'gamma_guess': 30},\n    '2D': {'center': 2690, 'half_width': 150, 'gamma_guess': 50},\n}\n\nfor name, info in peaks.items():\n    mask = (xs >= info['center'] - info['half_width']) & (xs <= info['center'] + info['half_width'])\n    x_fit = xs[mask]\n    y_fit = ys[mask]\n    # Initial guesses: amplitude (peak height above baseline), gamma, x0, offset (baseline)\n    amp_guess = np.max(y_fit) - np.min(y_fit)\n    offset_guess = np.min(y_fit)\n    p0 = [amp_guess, info['gamma_guess'], info['center'], offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    results[name] = {\n        'x0': float(popt[2]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[0]),\n        'offset': float(popt[3])\n    }\n\n# Compute defect ratio I_D/I_G\namp_D = results['D']['amplitude']\namp_G = results['G']['amplitude']\nif amp_G != 0 and not np.isnan(amp_D) and not np.isnan(amp_G):\n    ID_IG = amp_D / amp_G\nelse:\n    ID_IG = None\nresults['ID_IG'] = ID_IG\n\n# Write results to JSON\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
