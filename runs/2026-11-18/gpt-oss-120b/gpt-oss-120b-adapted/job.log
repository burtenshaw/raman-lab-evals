Sending keys: ['cat > fit_raman.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\n# Load data\ndata = pd.read_csv(\'spectrum.csv\')\nx = data[\'raman_shift_cm-1\'].values\ny = data[\'intensity\'].values\n\n# Lorentzian + offset model\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak within a window\ndef fit_peak(x_center, window=50):\n    mask = (x >= x_center - window) & (x <= x_center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ x_center, offset ~ min(y)\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    x0_guess = x_center\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except RuntimeError:\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return popt\n\n# Fit D, G, 2D peaks\nparams_D = fit_peak(1350)\nparams_G = fit_peak(1580)\nparams_2D = fit_peak(2690)\n\n# Build result dictionary\nresult = {\n    "D": {\n        "x0": float(params_D[2]),\n        "gamma": float(params_D[1]),\n        "amplitude": float(params_D[0]),\n        "offset": float(params_D[3])\n    },\n    "G": {\n        "x0": float(params_G[2]),\n        "gamma": float(params_G[1]),\n        "amplitude": float(params_G[0]),\n        "offset": float(params_G[3])\n    },\n    "2D": {\n        "x0": float(params_2D[2]),\n        "gamma": float(params_2D[1]),\n        "amplitude": float(params_2D[0]),\n        "offset": float(params_2D[3])\n    },\n    "ID_IG": float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)\n}\n\n# Write to JSON file\nwith open(\'results.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(\'Fitting complete. Results written to results.json\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_se