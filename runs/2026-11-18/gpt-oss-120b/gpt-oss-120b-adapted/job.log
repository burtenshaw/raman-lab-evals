Sending keys: ["python3 - <<'PY'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\ntry:\n    data = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nexcept Exception as e:\n    sys.stderr.write(f'Error loading CSV: {e}\\n')\n    sys.exit(1)\n\nx = data[:,0]\ny = data[:,1]\n\n# Lorentzian plus offset model\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a region\ndef fit_region(x, y, center, window):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    amp_guess = y_fit.max() - y_fit.min()\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, center, window/2, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        sys.stderr.write(f'Fit failed for center {center}: {e}\\n')\n        popt = [np.nan]*4\n    return popt\n\n# Fit peaks\nparams_D = fit_region(x, y, 1350, 100)\nparams_G = fit_region(x, y, 1580, 100)\nparams_2D = fit_region(x, y, 2690, 150)\n\nresult = {\n    'D': {'x0': float(params_D[1]), 'gamma': float(params_D[2]), 'amplitude': float(params_D[0]), 'offset': float(params_D[3])},\n    'G': {'x0': float(params_G[1]), 'gamma': float(params_G[2]), 'amplitude': float(params_G[0]), 'offset': float(params_G[3])},\n    '2D': {'x0': float(params_2D[1]), 'gamma': float(params_2D[2]), 'amplitude': float(params_2D[0]), 'offset': float(params_2D[3])},\n    'ID_IG': float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint('Fitting complete, results written to results.json')\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
