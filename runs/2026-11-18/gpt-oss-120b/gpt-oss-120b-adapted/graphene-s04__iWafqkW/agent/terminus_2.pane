[?2004lcat > fit_raman.py << 'PY'
import pandas as pd, numpy as np, json
from scipy.optimize import curve_fit

# Load data
data = pd.read_csv('spectrum.csv')
# Ensure columns are correct
x = data['raman_shift_cm-1'].values
y = data['intensity'].values

# Lorentzian + offset model
def lorentzian(x, amplitude, x0, gamma, offset):
    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset

# Helper to fit a peak within a window
def fit_peak(center, window=100):
    mask = (x >= center - window) & (x <= center + window)
    x_fit = x[mask]
    y_fit = y[mask]
    # Initial guesses: amplitude ~ max(y)-min(y), x0 ~ center, gamma ~ 10, offset ~ min(y)
    amp_guess = y_fit.max() - y_fit.min()
    offset_guess = y_fit.min()
    p0 = [amp_guess, center, 10.0, offset_guess]
    try:
        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
    except RuntimeError:
        popt = [np.nan, np.nan, np.nan, np.nan]
    return {
        'amplitude': float(popt[0]),
        'x0': float(popt[1]),
        'gamma': float(popt[2]),
        'offset': float(popt[3])
    }

# Fit each peak
D_params = fit_peak(1350)
G_params = fit_peak(1580)
TwoD_params = fit_peak(2690)

# Compute defect ratio
ID_IG = D_params['amplitude'] / G_params['amplitude'] if G_params['amplitude'] != 0 else None

# Prepare result dict
result = {
    'D': D_params,
    'G': G_params,
    '2D': TwoD_params,
    'ID_IG': ID_IG
}

# Write to JSON
with open('results.json', 'w') as f:
    json.dump(result, f, indent=2)
print('Fitting complete, results written to results.json')
PY
