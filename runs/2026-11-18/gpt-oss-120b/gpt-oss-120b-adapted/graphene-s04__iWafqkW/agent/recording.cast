[136.147044, "o", "import pandas as pd, numpy as np, json, sys, traceback\r\n\u001b[?2004l\r"]
[136.14706, "o", "\u001b[?2004h> "]
[136.147192, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.147244, "o", "data = pd.read_csv('spectrum.csv')\r\n\u001b[?2004l\r"]
[136.147271, "o", "\u001b[?2004h> "]
[136.147335, "o", "print('Columns:', data.columns.tolist())\r\n\u001b[?2004l\r"]
[136.147355, "o", "\u001b[?2004h> "]
[136.147414, "o", "print('Data shape:', data.shape)\r\n\u001b[?2004l\r"]
[136.147441, "o", "\u001b[?2004h> "]
[136.147523, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.147566, "o", "> x = data['raman_shift_cm-1'].values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.147599, "o", "y = data['intensity'].values\r\n\u001b[?2004l\r"]
[136.147625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.147654, "o", "\u001b[?2004h> "]
[136.147727, "o", "def lorentzian(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[136.147741, "o", "\u001b[?2004h> "]
[136.147861, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[136.147885, "o", "\u001b[?2004h> "]
[136.147915, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.14798, "o", "def fit_peak(center, window=100):\r\n\u001b[?2004l\r"]
[136.148012, "o", "\u001b[?2004h> "]
[136.148099, "o", "    mask = (x >= center - window) & (x <= center + window)\r\n\u001b[?2004l\r"]
[136.148113, "o", "\u001b[?2004h> "]
[136.148156, "o", "    x_fit = x[mask]\r\n\u001b[?2004l\r"]
[136.148182, "o", "\u001b[?2004h> "]
[136.148214, "o", "    y_fit = y[mask]\r\n\u001b[?2004l\r"]
[136.148227, "o", "\u001b[?2004h> "]
[136.14834, "o", "    print(f'Fitting peak near {center}: {len(x_fit)} points')\r\n\u001b[?2004l\r"]
[136.148376, "o", "\u001b[?2004h> "]
[136.148434, "o", "    amp_guess = y_fit.max() - y_fit.min()\r\n\u001b[?2004l\r"]
[136.148448, "o", "\u001b[?2004h> "]
[136.148508, "o", "    offset_guess = y_fit.min()\r\n\u001b[?2004l\r"]
[136.148523, "o", "\u001b[?2004h> "]
[136.148612, "o", "    p0 = [amp_guess, center, 10.0, offset_guess]\r\n\u001b[?2004l\r"]
[136.148628, "o", "\u001b[?2004h> "]
[136.148654, "o", "    try:\r\n\u001b[?2004l\r"]
[136.148682, "o", "\u001b[?2004h> "]
[136.148777, "o", "        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\r\n\u001b[?2004l\r"]
[136.148814, "o", "\u001b[?2004h> "]
[136.148861, "o", "        print('Fit success:', popt)\r\n\u001b[?2004l\r"]
[136.148891, "o", "\u001b[?2004h> "]
[136.148929, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[136.148952, "o", "\u001b[?2004h> "]
[136.149003, "o", "        print('Fit error:', e)\r\n\u001b[?2004l\r"]
[136.149017, "o", "\u001b[?2004h> "]
[136.149078, "o", "        traceback.print_exc()\r\n\u001b[?2004l\r"]
[136.149106, "o", "\u001b[?2004h> "]
[136.149179, "o", "        popt = [np.nan, np.nan, np.nan, np.nan]\r\n\u001b[?2004l\r"]
[136.149194, "o", "\u001b[?2004h> "]
[136.149387, "o", "    return {'amplitude': float(popt[0]), 'x0': float(popt[1]), 'gamma': float(popt[2]), 'offset': float(popt[3])}\r\n\u001b[?2004l\r"]
[136.149419, "o", "\u001b[?2004h"]
[136.14945, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.149482, "o", "> "]
[136.149512, "o", "D_params = fit_peak(1350)\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.149535, "o", "> "]
[136.149574, "o", "G_params = fit_peak(1580)\r\n\u001b[?2004l\r"]
[136.149596, "o", "\u001b[?2004h> "]
[136.149651, "o", "TwoD_params = fit_peak(2690)\r\n\u001b[?2004l\r"]
[136.149683, "o", "\u001b[?2004h"]
[136.149716, "o", "> "]
[136.14982, "o", "ID_IG = D_params['amplitude'] / G_params['amplitude'] if G_params['amplitude'] != 0 else None\r\n\u001b[?2004l\r"]
[136.149836, "o", "\u001b[?2004h> "]
[136.149968, "o", "result = {'D': D_params, 'G': G_params, '2D': TwoD_params, 'ID_IG': ID_IG}\r\n\u001b[?2004l\r"]
[136.149984, "o", "\u001b[?2004h> "]
[136.150054, "o", "with open('results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[136.150086, "o", "\u001b[?2004h> "]
[136.150137, "o", "    json.dump(result, f, indent=2)\r\n\u001b[?2004l\r"]
[136.150151, "o", "\u001b[?2004h> "]
[136.150204, "o", "print('Result written')\r\n\u001b[?2004l\r"]
[136.150239, "o", "\u001b[?2004h> "]
[136.150269, "o", "PY\r\n\u001b[?2004l\r"]
[136.873508, "o", "Columns: ['raman_shift_cm-1', 'intensity']\r\nData shape: (3800, 2)\r\n"]
[136.873737, "o", "Fitting peak near 1350: 400 points\r\n"]
[136.874465, "o", "Fit success: "]
[136.874663, "o", "[12082.21043215  1345.988093      14.73020997  1269.00113367]\r\n"]
[136.8747, "o", "Fitting peak near 1580: 400 points\r\n"]
[136.875183, "o", "Fit success: "]
[136.875319, "o", "[8607.20886674 1585.09087066   13.92400891 1274.73909748]\r\n"]
[136.87536, "o", "Fitting peak near 2690: 400 points\r\n"]
[136.875927, "o", "Fit success: "]
[136.876039, "o", "[10773.03059356  2678.03844791    20.01204509  1065.35946764]\r\n"]
[136.876286, "o", "Result written\r\n"]
[136.966486, "o", "\u001b[?2004hroot@j-openenv-6afd87ee884144d2f44fd462-q9obnvey-15c2b-frnq8:/app# "]
[141.147146, "i", "cat results.json\n"]
[141.147302, "o", "cat results.json\r\n\u001b[?2004l\r"]
[141.148368, "o", "{\r\n  \"D\": {\r\n    \"amplitude\": 12082.210432154434,\r\n    \"x0\": 1345.9880930024617,\r\n    \"gamma\": 14.730209970483267,\r\n    \"offset\": 1269.0011336725813\r\n  },\r\n  \"G\": {\r\n    \"amplitude\": 8607.208866744111,\r\n    \"x0\": 1585.0908706633872,\r\n    \"gamma\": 13.924008912187297,\r\n    \"offset\": 1274.7390974779985\r\n  },\r\n  \"2D\": {\r\n    \"amplitude\": 10773.030593560203,\r\n    \"x0\": 2678.0384479093455,\r\n    \"gamma\": 20.01204508915373,\r\n    \"offset\": 1065.359467644357\r\n  },\r\n  \"ID_IG\": 1.4037315254236218\r\n}"]
[141.148541, "o", "\u001b[?2004hroot@j-openenv-6afd87ee884144d2f44fd462-q9obnvey-15c2b-frnq8:/app# "]
