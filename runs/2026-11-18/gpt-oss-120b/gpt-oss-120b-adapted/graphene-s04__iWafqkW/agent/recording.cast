[46.840453, "i", "cat > fit_raman.py << 'PY'\nimport pandas as pd, numpy as np, json\nfrom scipy.optimize import curve_fit\n\n# Load data\ndata = pd.read_csv('spectrum.csv')\n# Ensure columns are correct\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\n# Lorentzian + offset model\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak within a window\ndef fit_peak(center, window=100):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max(y)-min(y), x0 ~ center, gamma ~ 10, offset ~ min(y)\n    amp_guess = y_fit.max() - y_fit.min()\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, center, 10.0, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except RuntimeError:\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return {\n        'amplitude': float(popt[0]),\n        'x0': float(popt[1]),\n        'gamma': float(p"]
[46.840632, "o", "cat > fit_raman.py << 'PY'\r\nimport pandas as pd, numpy as np, json\r\nfrom scipy.optimize import curve_fit\r\n\r\n# Load data\r\ndata = pd.read_csv('spectrum.csv')\r\n# Ensure columns are correct\r\nx = data['raman_shift_cm-1'].values\r\ny = data['intensity'].values\r\n\r\n# Lorentzian + offset model\r\ndef lorentzian(x, amplitude, x0, gamma, offset):\r\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\r\n# Helper to fit a peak within a window\r\ndef fit_peak(center, window=100):\r\n    mask = (x >= center - window) & (x <= center + window)\r\n    x_fit = x[mask]\r\n    y_fit = y[mask]\r\n    # Initial guesses: amplitude ~ max(y)-min(y), x0 ~ center, gamma ~ 10, offset ~ min(y)\r\n    amp_guess = y_fit.max() - y_fit.min()\r\n    offset_guess = y_fit.min()\r\n    p0 = [amp_guess, center, 10.0, offset_guess]\r\n    try:\r\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\r\n    except RuntimeError:\r\n        popt = [np.nan, np.nan, np.nan, np.nan]\r\n    return {\r\n        'amplitude': float(popt[0]),\r\n        'x0': float(popt["]
[46.841092, "i", "opt[2]),\n        'offset': float(popt[3])\n    }\n\n# Fit each peak\nD_params = fit_peak(1350)\nG_params = fit_peak(1580)\nTwoD_params = fit_peak(2690)\n\n# Compute defect ratio\nID_IG = D_params['amplitude'] / G_params['amplitude'] if G_params['amplitude'] != 0 else None\n\n# Prepare result dict\nresult = {\n    'D': D_params,\n    'G': G_params,\n    '2D': TwoD_params,\n    'ID_IG': ID_IG\n}\n\n# Write to JSON\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Fitting complete, results written to results.json')\nPY\n"]
[46.841123, "o", "1]),\r\n        'gamma': float(popt[2]),\r\n        'offset': float(popt[3])\r\n    }\r\n\r\n# Fit each peak\r\nD_params = fit_peak(1350)\r\nG_params = fit_peak(1580)\r\nTwoD_params = fit_peak(2690)\r\n\r\n# Compute defect ratio\r\nID_IG = D_params['amplitude'] / G_params['amplitude'] if G_params['amplitude'] != 0 else None\r\n\r\n# Prepare result dict\r\nresult = {\r\n    'D': D_params,\r\n    'G': G_params,\r\n    '2D': TwoD_params,\r\n    'ID_IG': ID_IG\r\n}\r\n\r\n# Write to JSON\r\nwith open('results.json', 'w') as f:\r\n    json.dump(result, f, indent=2)\r\nprint('Fitting complete, results written to results.json')\r\nPY\r\n"]
