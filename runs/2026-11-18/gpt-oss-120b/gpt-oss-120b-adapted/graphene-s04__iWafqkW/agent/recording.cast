[136.146764, "i", "python3 - << 'PY'\nimport pandas as pd, numpy as np, json, sys, traceback\nfrom scipy.optimize import curve_fit\n\ndata = pd.read_csv('spectrum.csv')\nprint('Columns:', data.columns.tolist())\nprint('Data shape:', data.shape)\n\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=100):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    print(f'Fitting peak near {center}: {len(x_fit)} points')\n    amp_guess = y_fit.max() - y_fit.min()\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, center, 10.0, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        print('Fit success:', popt)\n    except Exception as e:\n        print('Fit error:', e)\n        traceback.print_exc()\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return {'amplitude': float(popt[0]), 'x0': float(popt[1]"]
[136.1468, "i", "), 'gamma': float(popt[2]), 'offset': float(popt[3])}\n\nD_params = fit_peak(1350)\nG_params = fit_peak(1580)\nTwoD_params = fit_peak(2690)\nID_IG = D_params['amplitude'] / G_params['amplitude'] if G_params['amplitude'] != 0 else None\nresult = {'D': D_params, 'G': G_params, '2D': TwoD_params, 'ID_IG': ID_IG}\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Result written')\nPY\n"]
