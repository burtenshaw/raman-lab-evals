    x_fit = x[mask]
    y_fit = y[mask]
    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ center, offset ~ min(y)
    amp_guess = y_fit.max() - y_fit.min()
    gamma_guess = 10.0
    x0_guess = center
    offset_guess = y_fit.min()
    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]
    # Bounds to keep parameters physical
    bounds = ([0, 0, center - 5, 0], [np.inf, np.inf, center + 5, np.inf])
    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=bounds)
    return {
        'x0': float(popt[2]),
        'gamma': float(popt[1]),
        'amplitude': float(popt[0]),
        'offset': float(popt[3])
    }

# Fit each peak
results = {}
results['D'] = fit_peak(1350)
results['G'] = fit_peak(1580)
results['2D'] = fit_peak(2690)
# Defect ratio I_D/I_G (amplitude ratio)
results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None

# Write to JSON
with open('results.json', 'w') as f:
    json.dump(results, f, indent=2)

print('Fitting complete. Results written to results.json')
