[44.40877, "i", "cat > fit_raman.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Load data\ndf = pd.read_csv('spectrum.csv')\n# Ensure columns are correctly named (case‑insensitive handling)\nif 'raman_shift_cm-1' in df.columns:\n    x = df['raman_shift_cm-1'].values\nelif 'raman_shift_cm-1' in df.columns.str.lower():\n    x = df[df.columns[df.columns.str.lower() == 'raman_shift_cm-1'][0]].values\nelse:\n    raise KeyError('Raman shift column not found')\n\nif 'intensity' in df.columns:\n    y = df['intensity'].values\nelif 'intensity' in df.columns.str.lower():\n    y = df[df.columns[df.columns.str.lower() == 'intensity'][0]].values\nelse:\n    raise KeyError('Intensity column not found')\n\n# Lorentzian with offset\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak given an approximate center and window width\ndef fit_peak(center, width=50):\n    mask = (x >= center - width) & (x <= center + width)"]
[44.408955, "i", "\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ center, offset ~ min(y)\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    x0_guess = center\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\n    # Bounds to keep parameters physical\n    bounds = ([0, 0, center - 5, 0], [np.inf, np.inf, center + 5, np.inf])\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=bounds)\n    return {\n        'x0': float(popt[2]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[0]),\n        'offset': float(popt[3])\n    }\n\n# Fit each peak\nresults = {}\nresults['D'] = fit_peak(1350)\nresults['G'] = fit_peak(1580)\nresults['2D'] = fit_peak(2690)\n# Defect ratio I_D/I_G (amplitude ratio)\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\n\n# Write to JSON\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint("]
[44.409167, "o", "cat > fit_raman.py << 'EOF'\r\n\u001b[?2004l\r\r\n    x_fit = x[mask]\r\n    y_fit = y[mask]\r\n    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ center, offset ~ min(y)\r\n    amp_guess = y_fit.max() - y_fit.min()\r\n    gamma_guess = 10.0\r\n    x0_guess = center\r\n    offset_guess = y_fit.min()\r\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\r\n    # Bo"]
[44.409183, "i", "'Fitting complete. Results written to results.json')\nEOF\n"]
[44.409198, "o", "unds to keep parameters physical\r\n    bounds = ([0, 0, center - 5, 0], [np.inf, np.inf, center + 5, np.inf])\r\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=bounds)\r\n    return {\r\n        'x0': float(popt[2]),\r\n        'gamma': float(popt[1]),\r\n        'amplitude': float(popt[0]),\r\n        'offset': float(popt[3])\r\n    }\r\n\r\n# Fit each peak\r\nresults = {}\r\nresults['D'] = fit_peak(1350)\r\nresults['G'] = fit_peak(1580)\r\nresults['2D'] = fit_peak(2690)\r\n# Defect ratio I_D/I_G (amplitude ratio)\r\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\r\n\r\n# Write to JSON\r\nwith open('results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\n\r\nprint("]
