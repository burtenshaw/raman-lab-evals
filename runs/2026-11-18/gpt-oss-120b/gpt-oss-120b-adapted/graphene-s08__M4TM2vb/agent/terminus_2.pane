[?2004l[?2004h>         'offset': float(offset)
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute defect ratio
[?2004l[?2004h> ID_IG = peaks['D']['amplitude'] / peaks['G']['amplitude'] if peaks['G']['amplitude'] != 0 else np.nan
