[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'Fit failed for center {center}:', e)
[?2004l[?2004h>         popt = [np.nan]*4
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {}
[?2004l[?2004h> for name, cen in [('D', 1350), ('G', 1580), ('2D', 2690)]:
