[45.753354, "i", "python3 - << 'PY'\nimport pandas as pd, numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\npath = '/app/spectrum.csv'\ntry:\n    data = pd.read_csv(path)\nexcept Exception as e:\n    print('Error reading CSV:', e)\n    sys.exit(1)\n\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\n# Lorentzian model\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak\ndef fit_peak(center, window=50):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, center, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        print(f'Fit failed for center {center}:', e)\n        popt = [np.nan]*4\n    return popt\n\npeaks = {}\nfor name, cen in [('D', 1350), ('G', 158"]
[45.75349, "i", "0), ('2D', 2690)]:\n    amp, gamma, x0, offset = fit_peak(cen, window=80)\n    peaks[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\n# Compute defect ratio\nID_IG = peaks['D']['amplitude'] / peaks['G']['amplitude'] if peaks['G']['amplitude'] != 0 else np.nan\n\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': float(ID_IG)\n}\n\n# Write JSON\nout_path = '/app/results.json'\nwith open(out_path, 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Results written to', out_path)\nPY\n"]
