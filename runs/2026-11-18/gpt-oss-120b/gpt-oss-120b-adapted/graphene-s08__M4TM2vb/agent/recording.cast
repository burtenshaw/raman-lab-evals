[129.63999, "i", "python3 - << 'PY'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data without pandas\npath = '/app/spectrum.csv'\ntry:\n    data = np.genfromtxt(path, delimiter=',', names=True)\n    x = data['raman_shift_cm_1'] if 'raman_shift_cm_1' in data.dtype.names else data['raman_shift_cm-1']\n    y = data['intensity']\nexcept Exception as e:\n    print('Error loading CSV:', e)\n    sys.exit(1)\n\n# Lorentzian model\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=80):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    if x_fit.size == 0:\n        return [np.nan]*4\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, center, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        print(f'Fit failed for center {center}:"]
[129.640133, "i", "', e)\n        popt = [np.nan]*4\n    return popt\n\npeaks = {}\nfor name, cen in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    amp, gamma, x0, offset = fit_peak(cen)\n    peaks[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\nID_IG = peaks['D']['amplitude'] / peaks['G']['amplitude'] if peaks['G']['amplitude'] != 0 else np.nan\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': float(ID_IG)\n}\n\nout_path = '/app/results.json'\nwith open(out_path, 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Results written to', out_path)\nPY\n"]
