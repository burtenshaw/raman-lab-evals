[91.364176, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data\ntry:\n    data = pd.read_csv('/app/spectrum.csv')\nexcept Exception as e:\n    print('Error loading CSV:', e)\n    sys.exit(1)\n\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\n# Lorentzian + offset model\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak\ndef fit_peak(center, window=50):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max - min, x0 ~ center, gamma ~ 10, offset ~ min\n    amp_guess = y_fit.max() - y_fit.min()\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, center, 10.0, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        print(f'Fit failed for center {center}:', e)\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return popt\n\np"]
[91.364371, "i", "eaks = {}\nfor name, cen in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    amp, x0, gamma, offset = fit_peak(cen, window=80)\n    peaks[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\n# Compute defect ratio I_D/I_G\nID_IG = None\nif peaks['D']['amplitude'] is not None and peaks['G']['amplitude'] is not None:\n    try:\n        ID_IG = float(peaks['D']['amplitude'] / peaks['G']['amplitude'])\n    except Exception:\n        ID_IG = None\n\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': ID_IG\n}\n\n# Write to JSON\nwith open('/app/results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Results written to /app/results.json')\nPY\n"]
