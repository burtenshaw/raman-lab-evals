[143.156333, "i", "python3 - <<'PY'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load CSV (header with column names)\ntry:\n    data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True, dtype=None, encoding='utf-8')\nexcept Exception as e:\n    print('Failed to load CSV:', e)\n    sys.exit(1)\n\nx = data['raman_shift_cm-1']\ny = data['intensity']\n\n# Lorentzian + offset model\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=80):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    if x_fit.size == 0:\n        return [np.nan, np.nan, np.nan, np.nan]\n    amp_guess = y_fit.max() - y_fit.min()\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, center, 10.0, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        print(f'Fit error near {center}:', e)\n        popt = [np.nan, np.nan, np.nan, np.nan]\n  "]
[143.156387, "i", "  return popt\n\npeaks = {}\nfor name, cen in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    amp, x0, gamma, offset = fit_peak(cen)\n    peaks[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\n# Defect ratio I_D/I_G\nID_IG = None\ntry:\n    ID_IG = float(peaks['D']['amplitude'] / peaks['G']['amplitude'])\nexcept Exception:\n    ID_IG = None\n\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': ID_IG\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Results written to /app/results.json')\nPY\n"]
