[?2004l[?2004h> import numpy as np, json, sys
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data, skip header
[?2004l[?2004h> x, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a region
[?2004l[?2004h> def fit_region(center, window):
[?2004l[?2004h>     mask = (x >= center - window) & (x <= center + window)
[?2004l[?2004h>     x_fit, y_fit = x[mask], y[mask]
[?2004l[?2004h>     # Initial guesses: amplitude ~ (max-min), gamma ~ 10, x0 ~ center, offset ~ min
[?2004l[?2004h>     amp0 = y_fit.max() - y_fit.min()
[?2004l[?2004h>     gamma0 = 10.0
[?2004l[?2004h>     x0_0 = center
[?2004l[?2004h>     offset0 = y_fit.min()
[?2004l[?2004h>     p0 = [amp0, gamma0, x0_0, offset0]
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         sys.stderr.write(f'Fit failed for center {center}: {e}\n')
[?2004l[?2004h>         popt = [np.nan]*4
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> # Fit D, G, 2D peaks
[?2004l[?2004h> params_D = fit_region(1350, 150)
[?2004l[?2004h> params_G = fit_region(1580, 150)
[?2004l[?2004h> params_2D = fit_region(2690, 200)
[?2004l[?2004h> 
[?2004l[?2004h> # Build result dict
[?2004l[?2004h> result = {
[?2004l[?2004h>     "D": {"x0": float(params_D[2]), "gamma": float(params_D[1]), "amplitude": float(params_D[0]), "offset": float(params_D[3])},
[?2004l[?2004h>     "G": {"x0": float(params_G[2]), "gamma": float(params_G[1]), "amplitude": float(params_G[0]), "offset": float(params_G[3])},
[?2004l[?2004h>     "2D": {"x0": float(params_2D[2]), "gamma": float(params_2D[1]), "amplitude": float(params_2D[0]), "offset": float(params_2D[3])},
[?2004l[?2004h>     "ID_IG": float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
[?2004l[?2004h> print('Done')
