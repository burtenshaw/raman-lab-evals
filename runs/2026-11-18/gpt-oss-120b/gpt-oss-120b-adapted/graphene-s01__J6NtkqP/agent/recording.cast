[93.707838, "o", "    \"D\": {\"x0\": float(params_D[2]), \"gamma\": float(params_D[1]), \"amplitude\": float(params_D[0]), \"offset\": float(params_D[3])},\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.707875, "o", "> "]
