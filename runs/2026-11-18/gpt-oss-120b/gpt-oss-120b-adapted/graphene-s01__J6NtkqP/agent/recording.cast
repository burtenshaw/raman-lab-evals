[180.731686, "i", "python3 - <<'PY'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data, skip header\nx, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a region\ndef fit_region(center, window):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit, y_fit = x[mask], y[mask]\n    amp0 = y_fit.max() - y_fit.min()\n    gamma0 = 10.0\n    x0_0 = center\n    offset0 = y_fit.min()\n    p0 = [amp0, gamma0, x0_0, offset0]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        sys.stderr.write(f'Fit failed for center {center}: {e}\\n')\n        popt = [np.nan]*4\n    return popt\n\nparams_D = fit_region(1350, 150)\nparams_G = fit_region(1580, 150)\nparams_2D = fit_region(2690, 200)\n\nresult = {\n    \"D\": {\"x0\": float(params_D[2]), \"gamma\": float(params_D[1]), \"amplitude\": float(params_D[0]), \"offset\":"]
[180.731839, "i", " float(params_D[3])},\n    \"G\": {\"x0\": float(params_G[2]), \"gamma\": float(params_G[1]), \"amplitude\": float(params_G[0]), \"offset\": float(params_G[3])},\n    \"2D\": {\"x0\": float(params_2D[2]), \"gamma\": float(params_2D[1]), \"amplitude\": float(params_2D[0]), \"offset\": float(params_2D[3])},\n    \"ID_IG\": float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Done')\nPY\n"]
