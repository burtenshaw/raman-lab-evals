[?2004h> import numpy as np, pandas as pd, json, sys
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = pd.read_csv('spectrum.csv')
[?2004l[?2004h> x = data['raman_shift_cm-1'].values
[?2004l[?2004h> y = data['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Define fitting windows for each peak
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D': (1200, 1500),
[?2004l[?2004h>     'G': (1500, 1700),
[?2004l[?2004h>     '2D': (2500, 2850)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (xmin, xmax) in windows.items():
[?2004l[?2004h>     mask = (x >= xmin) & (x <= xmax)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ position of max, offset ~ min(y)
[?2004l[?2004h>     amp_guess = y_fit.max() - y_fit.min()
[?2004l[?2004h>     gamma_guess = 10.0
[?2004l[?2004h>     x0_guess = x_fit[np.argmax(y_fit)]
[?2004l[?2004h>     offset_guess = y_fit.min()
[?2004l[?2004h>     p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         sys.stderr.write(f'Fit failed for {name}: {e}\n')
[?2004l[?2004h>         popt = [np.nan]*4
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'amplitude': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'x0': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute defect ratio I_D/I_G using amplitudes
[?2004l[?2004h> ID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else np.nan
[?2004l[?2004h> results['ID_IG'] = float(ID_IG)
[?2004l[?2004h> 
[?2004l[?2004h> # Write JSON
[?2004l[?2004h> with open('results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
