[46.94483, "i", "cat > fit_peaks.py << 'EOF'\nimport numpy as np, pandas as pd, json, sys\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndata = pd.read_csv('spectrum.csv')\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\n# Define fitting windows for each peak\nwindows = {\n    'D': (1200, 1500),\n    'G': (1500, 1700),\n    '2D': (2500, 2850)\n}\n\nresults = {}\nfor name, (xmin, xmax) in windows.items():\n    mask = (x >= xmin) & (x <= xmax)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ position of max, offset ~ min(y)\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    x0_guess = x_fit[np.argmax(y_fit)]\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        sys.stderr.write(f'Fit failed"]
[46.944978, "i", " for {name}: {e}\\n')\n        popt = [np.nan]*4\n    results[name] = {\n        'amplitude': float(popt[0]),\n        'gamma': float(popt[1]),\n        'x0': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Compute defect ratio I_D/I_G using amplitudes\nID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else np.nan\nresults['ID_IG'] = float(ID_IG)\n\n# Write JSON\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nEOF\n"]
[46.945209, "o", "cat > fit_peaks.py << 'EOF'\r\n\u001b[?2004l\r for {name}: {e}\\n')\r\n        popt = [np.nan]*4\r\n    results[name] = {\r\n        'amplitude': float(popt[0]),\r\n        'gamma': float(popt[1]),\r\n        'x0': float(popt[2"]
[46.945323, "o", "]),\r\n        'offset': float(popt[3])\r\n    }\r\n\r\n# Compute defect ratio I_D/I_G using amplitudes\r\nID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else np.nan\r\nresults['ID_IG'] = float(ID_IG)\r\n\r\n# Write JSON\r\nwith open('results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\n\r\nEOF\r\n\u001b[?2004h> import numpy as np, pandas as pd, json, sys\r\n\u001b[?2004l\r"]
