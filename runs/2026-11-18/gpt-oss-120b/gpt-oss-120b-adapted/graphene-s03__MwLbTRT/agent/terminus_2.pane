[?2004l[?2004h> import pandas as pd, numpy as np, json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian with offset
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = pd.read_csv('spectrum.csv')
[?2004l[?2004h> xs = data['raman_shift_cm-1'].values
[?2004l[?2004h> ys = data['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Define peak regions and initial guesses
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D':  {'center': 1350, 'window': 200, 'guess': [max(ys), 30, 1350, min(ys)]},
[?2004l[?2004h>     'G':  {'center': 1580, 'window': 200, 'guess': [max(ys), 30, 1580, min(ys)]},
[?2004l[?2004h>     '2D': {'center': 2690, 'window': 300, 'guess': [max(ys), 50, 2690, min(ys)]},
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> for name, info in peaks.items():
[?2004l[?2004h>     mask = (xs > info['center'] - info['window']/2) & (xs < info['center'] + info['window']/2)
[?2004l[?2004h>     x_fit = xs[mask]
[?2004l[?2004h>     y_fit = ys[mask]
[?2004l[?2004h>     # Initial guess: amplitude, gamma, x0, offset
[?2004l[?2004h>     p0 = [np.max(y_fit) - np.min(y_fit), 30.0, info['center'], np.min(y_fit)]
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         popt = [np.nan]*4
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(popt[2]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'amplitude': float(popt[0]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute defect ratio I_D/I_G
[?2004l[?2004h> if results['D']['amplitude'] is not None and results['G']['amplitude'] is not None:
[?2004l[?2004h>     ID_IG = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> else:
[?2004l[?2004h>     ID_IG = None
[?2004l[?2004h> results['ID_IG'] = ID_IG
[?2004l[?2004h> 
[?2004l[?2004h> # Write to JSON
[?2004l[?2004h> with open('results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
