[86.554512, "i", "cat > fit_raman.py << 'EOF'\nimport pandas as pd, numpy as np, json\nfrom scipy.optimize import curve_fit\n\n# Lorentzian with offset\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndata = pd.read_csv('spectrum.csv')\nxs = data['raman_shift_cm-1'].values\nys = data['intensity'].values\n\nresults = {}\n\n# Define peak regions and initial guesses\npeaks = {\n    'D':  {'center': 1350, 'window': 200, 'guess': [max(ys), 30, 1350, min(ys)]},\n    'G':  {'center': 1580, 'window': 200, 'guess': [max(ys), 30, 1580, min(ys)]},\n    '2D': {'center': 2690, 'window': 300, 'guess': [max(ys), 50, 2690, min(ys)]},\n}\n\nfor name, info in peaks.items():\n    mask = (xs > info['center'] - info['window']/2) & (xs < info['center'] + info['window']/2)\n    x_fit = xs[mask]\n    y_fit = ys[mask]\n    # Initial guess: amplitude, gamma, x0, offset\n    p0 = [np.max(y_fit) - np.min(y_fit), 30.0, info['center'], np.min(y_fit)]\n    try:\n        popt, _ = curve_fit(lorentzian,"]
[86.554697, "i", " x_fit, y_fit, p0=p0)\n    except Exception as e:\n        popt = [np.nan]*4\n    results[name] = {\n        'x0': float(popt[2]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[0]),\n        'offset': float(popt[3])\n    }\n\n# Compute defect ratio I_D/I_G\nif results['D']['amplitude'] is not None and results['G']['amplitude'] is not None:\n    ID_IG = results['D']['amplitude'] / results['G']['amplitude']\nelse:\n    ID_IG = None\nresults['ID_IG'] = ID_IG\n\n# Write to JSON\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nEOF\n"]
