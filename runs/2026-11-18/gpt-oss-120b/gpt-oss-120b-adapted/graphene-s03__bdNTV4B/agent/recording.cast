[136.612569, "i", "python3 - << 'PY'\nimport json, sys\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# Load CSV without pandas\n# Assuming the CSV has a header row with column names\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\n# Extract columns (field names may contain spaces or hyphens; use the exact header names)\n# Find the column names programmatically\ncols = data.dtype.names\n# Identify columns by matching substrings\nraman_col = None\nintensity_col = None\nfor c in cols:\n    if 'raman' in c.lower():\n        raman_col = c\n    if 'intensity' in c.lower():\n        intensity_col = c\nif raman_col is None or intensity_col is None:\n    sys.stderr.write('Could not find required columns in CSV\\n')\n    sys.exit(1)\n\nx = data[raman_col]\ny = data[intensity_col]\n\n# Lorentzian model\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=80):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n"]
[136.612736, "i", "    y_fit = y[mask]\n    if x_fit.size == 0:\n        return [np.nan]*4\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, center, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        sys.stderr.write(f'Fit failed for center {center}: {e}\\n')\n        popt = [np.nan]*4\n    return popt\n\npeaks = {}\nfor name, cen in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    amp, gamma, x0, offset = fit_peak(cen)\n    peaks[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\nID_IG = (peaks['D']['amplitude'] / peaks['G']['amplitude']) if peaks['G']['amplitude'] != 0 else np.nan\n\nresult = {\n    'D': peaks['D'],\n    'G': peaks['G'],\n    '2D': peaks['2D'],\n    'ID_IG': float(ID_IG)\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Fitting complete')\nPY\n"]
