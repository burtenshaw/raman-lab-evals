[?2004l[?2004h> x = data['raman_shift_cm_1'] if 'raman_shift_cm_1' in data.dtype.names else data['raman_shift_cm-1']
[?2004l[?2004h> # Some CSV headers may have hyphen; handle both
[?2004l[?2004h> if isinstance(x, np.ndarray) is False:
[?2004l[?2004h>     # fallback: use column index
[?2004l[?2004h>     x = data['raman_shift_cm-1']
[?2004l[?2004h> intensity = data['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian model
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a region
[?2004l[?2004h> def fit_region(center, window=50):
[?2004l[?2004h>     mask = (x >= center - window) & (x <= center + window)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = intensity[mask]
