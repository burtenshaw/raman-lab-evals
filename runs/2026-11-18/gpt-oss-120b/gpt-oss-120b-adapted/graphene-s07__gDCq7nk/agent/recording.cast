[52.503079, "i", "python3 - << 'PY'\nimport sys, json, numpy as np, os\ntry:\n    import scipy.optimize as opt\nexcept Exception as e:\n    print('scipy not available', e)\n    sys.exit(1)\n\n# Load data\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\n# Ensure columns exist\nx = data['raman_shift_cm_1'] if 'raman_shift_cm_1' in data.dtype.names else data['raman_shift_cm-1']\n# Some CSV headers may have hyphen; handle both\nif isinstance(x, np.ndarray) is False:\n    # fallback: use column index\n    x = data['raman_shift_cm-1']\nintensity = data['intensity']\n\n# Lorentzian model\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a region\ndef fit_region(center, window=50):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = intensity[mask]\n    # Initial guesses\n    amp_guess = y_fit.max() - y_fit.min()\n    x0_guess = center\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, x0_g"]
[52.503291, "o", "python3 - << 'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.503412, "i", "uess, gamma_guess, offset_guess]\n    try:\n        popt, _ = opt.curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        print('Fit failed for center', center, e)\n        popt = [np.nan]*4\n    return popt\n\n# Fit each peak\nparams_D = fit_region(1350)\nparams_G = fit_region(1580)\nparams_2D = fit_region(2690)\n\nresult = {\n    'D': {'amplitude': float(params_D[0]), 'x0': float(params_D[1]), 'gamma': float(params_D[2]), 'offset': float(params_D[3])},\n    'G': {'amplitude': float(params_G[0]), 'x0': float(params_G[1]), 'gamma': float(params_G[2]), 'offset': float(params_G[3])},\n    '2D': {'amplitude': float(params_2D[0]), 'x0': float(params_2D[1]), 'gamma': float(params_2D[2]), 'offset': float(params_2D[3])},\n    'ID_IG': float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)\n}\n\n# Write JSON\nwith open('/app/results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Done')\nPY\n"]
