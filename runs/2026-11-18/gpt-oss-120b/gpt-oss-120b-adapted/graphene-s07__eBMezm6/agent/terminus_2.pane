[?2004hroot@j-openenv-6afd88844643bac7ac634e5b-61144y74-2bf5b-8k57c:/app# python3 - << 'PY'
[?2004l[?2004h> import numpy as np, json, sys
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> x, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian model with offset
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Fit function for a given window and initial guess
[?2004l[?2004h> def fit_peak(x, y, window, guess):
[?2004l[?2004h>     mask = (x >= window[0]) & (x <= window[1])
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x[mask], y[mask], p0=guess, maxfev=10000)
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> # Define windows and initial guesses
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D': (1300, 1400),
[?2004l[?2004h>     'G': (1500, 1650),
[?2004l[?2004h>     '2D': (2600, 2800)
[?2004l[?2004h> }
[?2004l[?2004h> initial_guesses = {}
[?2004l[?2004h> for name, (lo, hi) in windows.items():
[?2004l[?2004h>     mask = (x >= lo) & (x <= hi)
[?2004l[?2004h>     y_window = y[mask]
[?2004l[?2004h>     x_window = x[mask]
[?2004l[?2004h>     amp_guess = y_window.max() - y_window.min()
[?2004l[?2004h>     x0_guess = x_window[np.argmax(y_window)]
[?2004l[?2004h>     gamma_guess = 10.0
[?2004l[?2004h>     offset_guess = y_window.min()
[?2004l[?2004h>     initial_guesses[name] = [amp_guess, x0_guess, gamma_guess, offset_guess]
[?2004l[?2004h> 
[?2004l[?2004h> # Perform fits
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name in ['D', 'G', '2D']:
[?2004l[?2004h>     popt = fit_peak(x, y, windows[name], initial_guesses[name])
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'amplitude': float(popt[0]),
[?2004l[?2004h>         'x0': float(popt[1]),
[?2004l[?2004h>         'gamma': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute defect ratio I_D/I_G (using amplitudes)
[?2004l[?2004h> ID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None
[?2004l[?2004h> results['ID_IG'] = float(ID_IG) if ID_IG is not None else None
[?2004l[?2004h> 
[?2004l[?2004h> # Write to JSON
[?2004l[?2004h> with open('results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
