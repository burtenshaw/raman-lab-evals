[184.765085, "i", "python3 - << 'PY'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\n# Load data\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\n# Lorentzian model with offset\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Fit function for a given window and initial guess\ndef fit_peak(x, y, window, guess):\n    mask = (x >= window[0]) & (x <= window[1])\n    popt, _ = curve_fit(lorentzian, x[mask], y[mask], p0=guess, maxfev=10000)\n    return popt\n\n# Define windows and initial guesses\nwindows = {\n    'D': (1300, 1400),\n    'G': (1500, 1650),\n    '2D': (2600, 2800)\n}\ninitial_guesses = {}\nfor name, (lo, hi) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    y_window = y[mask]\n    x_window = x[mask]\n    amp_guess = y_window.max() - y_window.min()\n    x0_guess = x_window[np.argmax(y_window)]\n    gamma_guess = 10.0\n    offset_guess = y_window.min()\n    initial_guesses[name] = [amp_guess, x0_guess, gamma_guess, offset"]
[184.765235, "i", "_guess]\n\n# Perform fits\nresults = {}\nfor name in ['D', 'G', '2D']:\n    popt = fit_peak(x, y, windows[name], initial_guesses[name])\n    results[name] = {\n        'amplitude': float(popt[0]),\n        'x0': float(popt[1]),\n        'gamma': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Compute defect ratio I_D/I_G (using amplitudes)\nID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\nresults['ID_IG'] = float(ID_IG) if ID_IG is not None else None\n\n# Write to JSON\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results written to results.json')\nPY\n"]
