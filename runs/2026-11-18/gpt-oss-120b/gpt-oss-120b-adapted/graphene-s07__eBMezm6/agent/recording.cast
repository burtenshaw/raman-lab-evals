[184.768438, "o", "\u001b[?2004h> "]
[184.768475, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[184.768517, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.768579, "o", "# Compute defect ratio I_D/I_G (using amplitudes)\r\n\u001b[?2004l\r"]
[184.768608, "o", "\u001b[?2004h> "]
[184.768738, "o", "ID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\r\n\u001b[?2004l\r"]
[184.768772, "o", "\u001b[?2004h> "]
[184.768854, "o", "results['ID_IG'] = float(ID_IG) if ID_IG is not None else None\r\n\u001b[?2004l\r"]
[184.768896, "o", "\u001b[?2004h> \r\n"]
[184.768937, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.768965, "o", "# Write to JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.769021, "o", "with open('results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[184.769053, "o", "\u001b[?2004h> "]
[184.769107, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[184.769134, "o", "\u001b[?2004h> \r\n"]
[184.769161, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.76924, "o", "print('Fitting complete. Results written to results.json')\r\n\u001b[?2004l\r"]
[184.769275, "o", "\u001b[?2004h> "]
[184.769307, "o", "PY\r\n\u001b[?2004l\r"]
[185.498119, "o", "Fitting complete. Results written to results.json\r\n"]
[185.573848, "o", "\u001b[?2004hroot@j-openenv-6afd88844643bac7ac634e5b-61144y74-2bf5b-8k57c:/app# "]
[189.766255, "i", "cat results.json\n"]
[189.766455, "o", "cat results.json\r\n\u001b[?2004l\r"]
[189.767583, "o", "{\r\n  \"D\": {\r\n    \"amplitude\": 8228.709379972175,\r\n    \"x0\": 1348.242826630291,\r\n    \"gamma\": 16.82477352488591,\r\n    \"offset\": 1236.9089780088166\r\n  },\r\n  \"G\": {\r\n    \"amplitude\": 7520.185980933295,\r\n    \"x0\": 1580.3858060309103,\r\n    \"gamma\": 12.988350243679777,\r\n    \"offset\": 1296.3320957762708\r\n  },\r\n  \"2D\": {\r\n    \"amplitude\": 10376.11353937476,\r\n    \"x0\": 2692.4093465021065,\r\n    \"gamma\": 20.897154695290975,\r\n    \"offset\": 1414.5648695519615\r\n  },\r\n  \"ID_IG\": 1.094216206997443\r\n}"]
