[116.053142, "o", "            left_x = x1 + (half_max - y1) * (x2 - x1) / (y2 - y1)\r\n\u001b[?2004l\r"]
[116.053172, "o", "\u001b[?2004h> "]
[116.053181, "o", "        else:\r\n\u001b[?2004l\r"]
[116.053232, "o", "\u001b[?2004h> "]
[116.053246, "o", "            left_x = x1\r\n\u001b[?2004l\r"]
[116.053256, "o", "\u001b[?2004h"]
[116.053264, "o", "> "]
[116.053339, "o", "    # Find right crossing point\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.053421, "o", "    right_idx = np.where(y_win[idx_max:] <= half_max)[0]\r\n\u001b[?2004l\r"]
[116.053457, "o", "\u001b[?2004h> "]
[116.053493, "o", "    if right_idx.size == 0:\r\n"]
[116.053501, "o", "\u001b[?2004l\r"]
[116.053545, "o", "\u001b[?2004h> "]
[116.053565, "o", "        right_x = x0\r\n"]
[116.053577, "o", "\u001b[?2004l\r"]
[116.053629, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[116.053686, "o", "\u001b[?2004h> "]
[116.053701, "o", "        i = right_idx[0] + idx_max\r\n"]
[116.053743, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[116.053805, "o", "        x1, y1 = x_win[i-1], y_win[i-1]\r\n\u001b[?2004l\r"]
[116.053818, "o", "\u001b[?2004h"]
[116.053857, "o", "> "]
[116.053937, "o", "        x2, y2 = x_win[i], y_win[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.053992, "o", "        if y2 != y1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.054086, "o", "            right_x = x1 + (half_max - y1) * (x2 - x1) / (y2 - y1)\r\n\u001b[?2004l\r"]
[116.054121, "o", "\u001b[?2004h> "]
[116.054148, "o", "        else:\r\n\u001b[?2004l\r"]
[116.054188, "o", "\u001b[?2004h> "]
[116.054238, "o", "            right_x = x2"]
[116.054297, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.054358, "o", "> "]
[116.054457, "o", "    # Gamma = half of the full width at half maximum\r\n\u001b[?2004l\r"]
[116.054495, "o", "\u001b[?2004h> "]
[116.05456, "o", "    gamma = float((right_x - left_x) / 2.0)\r\n\u001b[?2004l\r"]
[116.05459, "o", "\u001b[?2004h> "]
[116.054646, "o", "    return x0, gamma, amplitude, offset\r\n\u001b[?2004l\r"]
[116.054659, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[116.054708, "o", "\u001b[?2004h> "]
[116.05475, "o", "# Estimate parameters for each peak\r\n\u001b[?2004l\r"]
[116.054764, "o", "\u001b[?2004h> "]
[116.054856, "o", "x0_D, gamma_D, amp_D, off_D = estimate_lorentzian(1350)\r\n\u001b[?2004l\r"]
[116.054865, "o", "\u001b[?2004h> "]
[116.054957, "o", "x0_G, gamma_G, amp_G, off_G = estimate_lorentzian(1580)\r\n\u001b[?2004l\r"]
[116.054966, "o", "\u001b[?2004h> "]
[116.055063, "o", "x0_2D, gamma_2D, amp_2D, off_2D = estimate_lorentzian(2690)\r\n\u001b[?2004l\r"]
[116.055072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[116.055111, "o", "\u001b[?2004h> "]
[116.055148, "o", "# Defect ratio I_D/I_G\r\n\u001b[?2004l\r"]
[116.055192, "o", "\u001b[?2004h> "]
[116.055271, "o", "ID_IG = float(amp_D / amp_G) if amp_G != 0 else float('nan')\r\n\u001b[?2004l\r"]
[116.055279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[116.055316, "o", "\u001b[?2004h> "]
[116.055345, "o", "result = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.055359, "o", "> "]
[116.055468, "o", "    \"D\": {\"x0\": x0_D, \"gamma\": gamma_D, \"amplitude\": amp_D, \"offset\": off_D},\r\n\u001b[?2004l\r"]
[116.055479, "o", "\u001b[?2004h> "]
[116.055598, "o", "    \"G\": {\"x0\": x0_G, \"gamma\": gamma_G, \"amplitude\": amp_G, \"offset\": off_G},\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.055659, "o", "> "]
[116.055737, "o", "    \"2D\": {\"x0\": x0_2D, \"gamma\": gamma_2D, \"amplitude\": amp_2D, \"offset\": off_2D},\r\n\u001b[?2004l\r"]
[116.055774, "o", "\u001b[?2004h> "]
[116.055789, "o", "    \"ID_IG\": ID_IG\r\n\u001b[?2004l\r"]
[116.055835, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[116.05585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[116.055907, "o", "\u001b[?2004h> "]
[116.055944, "o", "with open('results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[116.055959, "o", "\u001b[?2004h> "]
[116.056027, "o", "    json.dump(result, f, indent=2)\r\n\u001b[?2004l\r"]
[116.056067, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.056159, "o", "print('Fitting complete. Results written to results.json')\r\n\u001b[?2004l\r"]
[116.056198, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[116.057313, "o", "\u001b[?2004hroot@j-openenv-6afd886a4643bac7ac634e50-ynsld8dn-4991f-qq9l9:/app# "]
[116.503711, "i", "python3 fit_raman_simple.py\n"]
[116.503843, "o", "python3 fit_raman_simple.py\r\n\u001b[?2004l\r"]
[116.549603, "o", "Traceback (most recent call last):\r\n"]
[116.551065, "o", "  File \u001b[35m\"/app/fit_raman_simple.py\"\u001b[0m, line \u001b[35m3\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n    import numpy as np\r\n"]
[116.55108, "o", "\u001b[1;35mModuleNotFoundError\u001b[0m: \u001b[35mNo module named 'numpy'\u001b[0m\r\n"]
[116.555681, "o", "\u001b[?2004hroot@j-openenv-6afd886a4643bac7ac634e50-ynsld8dn-4991f-qq9l9:/app# "]
[118.503446, "i", "cat results.json\n"]
[118.503714, "o", "cat results.json\r\n\u001b[?2004l\r"]
[118.50543, "o", "cat: results.json: No such file or directory\r\n"]
[118.505868, "o", "\u001b[?2004hroot@j-openenv-6afd886a4643bac7ac634e50-ynsld8dn-4991f-qq9l9:/app# "]
