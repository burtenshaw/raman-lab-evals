[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = pd.read_csv('spectrum.csv')
[?2004l[?2004h> x = data['raman_shift_cm-1'].values
[?2004l[?2004h> y = data['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian + offset model
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a peak within a window
[?2004l[?2004h> def fit_peak(x_center, window=50):
[?2004l[?2004h>     mask = (x >= x_center - window) & (x <= x_center + window)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ x_center, offset ~ min(y)
[?2004l[?2004h>     amp_guess = y_fit.max() - y_fit.min()
[?2004l[?2004h>     gamma_guess = 10.0
[?2004l[?2004h>     x0_guess = x_center
[?2004l[?2004h>     offset_guess = y_fit.min()
[?2004l[?2004h>     p0 = [amp_guess, gamma_guess, x0_guess, offset_guess]
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     except RuntimeError:
[?2004l[?2004h>         popt = [np.nan, np.nan, np.nan, np.nan]
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> # Fit D, G, 2D peaks
[?2004l[?2004h> params_D = fit_peak(1350)
[?2004l[?2004h> params_G = fit_peak(1580)
[?2004l[?2004h> params_2D = fit_peak(2690)
[?2004l[?2004h> 
[?2004l[?2004h> # Build result dictionary
[?2004l[?2004h> result = {
[?2004l[?2004h>     "D": {
[?2004l[?2004h>         "x0": float(params_D[2]),
[?2004l[?2004h>         "gamma": float(params_D[1]),
[?2004l[?2004h>         "amplitude": float(params_D[0]),
[?2004l[?2004h>         "offset": float(params_D[3])
[?2004l[?2004h>     },
[?2004l[?2004h>     "G": {
[?2004l[?2004h>         "x0": float(params_G[2]),
[?2004l[?2004h>         "gamma": float(params_G[1]),
[?2004l[?2004h>         "amplitude": float(params_G[0]),
[?2004l[?2004h>         "offset": float(params_G[3])
[?2004l[?2004h>     },
[?2004l[?2004h>     "2D": {
[?2004l[?2004h>         "x0": float(params_2D[2]),
[?2004l[?2004h>         "gamma": float(params_2D[1]),
[?2004l[?2004h>         "amplitude": float(params_2D[0]),
[?2004l[?2004h>         "offset": float(params_2D[3])
[?2004l[?2004h>     },
[?2004l[?2004h>     "ID_IG": float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Write to JSON file
[?2004l[?2004h> with open('results.json', 'w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Fitting complete. Results written to results.json')
