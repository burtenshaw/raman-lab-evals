[167.264882, "i", "python3 - <<'PY'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load data (skip header)\ntry:\n    data = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nexcept Exception as e:\n    sys.stderr.write(f'Error loading CSV: {e}\\n')\n    sys.exit(1)\n\nx = data[:, 0]\ny = data[:, 1]\n\n# Lorentzian model\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Fit a region around a given center\ndef fit_region(x, y, center, window):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    if x_fit.size == 0:\n        return [np.nan, np.nan, np.nan, np.nan]\n    amp_guess = y_fit.max() - y_fit.min()\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, center, 10.0, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=10000)\n    except Exception as e:\n        sys.stderr.write(f'Fit failed for center {center}: {e}\\n')\n        popt = [np.nan, np.nan, np.nan,"]
[167.265359, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np, json, sys\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data (skip header)\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.265378, "i", " np.nan]\n    return popt\n\n# Perform fits\nparams_D = fit_region(x, y, center=1350, window=150)   # D peak approx 1200-1500\nparams_G = fit_region(x, y, center=1580, window=100)   # G peak approx 1480-1680\nparams_2D = fit_region(x, y, center=2690, window=200) # 2D peak approx 2490-2890\n\n# Build result dictionary\nresult = {\n    \"D\": {\n        \"x0\": float(params_D[1]),\n        \"gamma\": float(params_D[2]),\n        \"amplitude\": float(params_D[0]),\n        \"offset\": float(params_D[3])\n    },\n    \"G\": {\n        \"x0\": float(params_G[1]),\n        \"gamma\": float(params_G[2]),\n        \"amplitude\": float(params_G[0]),\n        \"offset\": float(params_G[3])\n    },\n    \"2D\": {\n        \"x0\": float(params_2D[1]),\n        \"gamma\": float(params_2D[2]),\n        \"amplitude\": float(params_2D[0]),\n        \"offset\": float(params_2D[3])\n    },\n    \"ID_IG\": float(params_D[0] / params_G[0] if params_G[0] != 0 else np.nan)\n}\n\n# Write to JSON file\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Fitting complet"]
[167.265394, "o", "> try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.26541, "i", "e. Results written to results.json')\nPY\n"]
