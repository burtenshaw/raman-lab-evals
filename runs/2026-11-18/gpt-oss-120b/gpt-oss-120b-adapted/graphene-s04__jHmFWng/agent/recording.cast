[206.268421, "i", "python3 - <<'PY'\nimport numpy as np, json, sys\nfrom scipy.optimize import curve_fit\n\n# Load CSV without pandas (skip header)\ntry:\n    data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nexcept Exception as e:\n    print('Error loading CSV:', e)\n    sys.exit(1)\n\nx = data[:, 0]\ny = data[:, 1]\n\n# Lorentzian model\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Fit helper\ndef fit_region(center, window):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    if x_fit.size == 0:\n        return [np.nan, np.nan, np.nan, np.nan]\n    amp_guess = np.max(y_fit) - np.min(y_fit)\n    gamma_guess = 10.0\n    offset_guess = np.min(y_fit)\n    p0 = [amp_guess, gamma_guess, center, offset_guess]\n    lower = [0, 0, center - window, -np.inf]\n    upper = [np.inf, np.inf, center + window, np.inf]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=(lower, upper))\n    except Exce"]
[206.268584, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np, json, sys\r\n\u001b[?2004l\r"]
[206.268607, "i", "ption as e:\n        print(f'Fit failed for {center}:', e)\n        popt = [np.nan, np.nan, np.nan, np.nan]\n    return popt\n\n# Perform fits\nparams_D = fit_region(1350, 150)\nparams_G = fit_region(1580, 150)\nparams_2D = fit_region(2690, 200)\n\n# Compute defect ratio\nID_IG = float(params_D[0] / params_G[0]) if params_G[0] != 0 else float('nan')\n\nresult = {\n    \"D\": {\"x0\": float(params_D[2]), \"gamma\": float(params_D[1]), \"amplitude\": float(params_D[0]), \"offset\": float(params_D[3])},\n    \"G\": {\"x0\": float(params_G[2]), \"gamma\": float(params_G[1]), \"amplitude\": float(params_G[0]), \"offset\": float(params_G[3])},\n    \"2D\": {\"x0\": float(params_2D[2]), \"gamma\": float(params_2D[1]), \"amplitude\": float(params_2D[0]), \"offset\": float(params_2D[3])},\n    \"ID_IG\": ID_IG\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('Fitting complete, results written to /app/results.json')\nPY\n"]
