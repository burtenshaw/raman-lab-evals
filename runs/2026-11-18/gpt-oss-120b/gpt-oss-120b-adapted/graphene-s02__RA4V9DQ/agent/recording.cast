[52.19649, "i", "python3 - <<'PY'\nimport sys, json, subprocess, pkgutil\nmissing = []\nfor pkg in ['numpy', 'pandas', 'scipy']:\n    if not pkgutil.find_loader(pkg):\n        missing.append(pkg)\nif missing:\n    print('Missing packages:', missing)\n    sys.exit(1)\nprint('All required packages are available')\nPY\n"]
