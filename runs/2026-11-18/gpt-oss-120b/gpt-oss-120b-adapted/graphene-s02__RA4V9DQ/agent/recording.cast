[52.690495, "i", "cat > fit_peaks.py <<'PY'\n#!/usr/bin/env python3\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\n\n# Load data\ndata = pd.read_csv('/app/spectrum.csv')\n# Ensure columns are correct\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\n# Lorentzian + offset model\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak within a window\ndef fit_peak(x, y, window, guess_x0):\n    mask = (x >= window[0]) & (x <= window[1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ guess_x0, offset ~ min(y)\n    amp_guess = y_fit.max() - y_fit.min()\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, gamma_guess, guess_x0, offset_guess]\n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    except Exception as e:\n        # If fit fails, return NaNs\n        popt = [np.nan, np.nan, np.nan, np.nan]\n "]
[52.690672, "i", "   return popt\n\n# Define windows and initial x0 guesses for each peak\npeaks = {\n    'D':  {'window': (1200, 1500), 'guess_x0': 1350},\n    'G':  {'window': (1500, 1700), 'guess_x0': 1580},\n    '2D': {'window': (2500, 2850), 'guess_x0': 2690},\n}\n\nresults = {}\nfor name, cfg in peaks.items():\n    amp, gamma, x0, offset = fit_peak(x, y, cfg['window'], cfg['guess_x0'])\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n\n# Compute defect ratio I_D/I_G using amplitudes\nID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\nresults['ID_IG'] = float(ID_IG) if ID_IG is not None else None\n\n# Write to JSON\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results written to /app/results.json')\nPY\n"]
