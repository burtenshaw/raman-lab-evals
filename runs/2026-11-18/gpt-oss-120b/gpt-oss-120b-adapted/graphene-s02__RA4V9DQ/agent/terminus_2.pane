[?2004hroot@j-openenv-6afd87ee4643bac7ac634e24-z29r57ku-344b0-hpmlz:/app# cat > fit_peaks.py <<'PY'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> # Ensure columns are correct
[?2004l[?2004h> x = data['raman_shift_cm-1'].values
[?2004l[?2004h> y = data['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian + offset model
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a peak within a window
[?2004l[?2004h> def fit_peak(x, y, window, guess_x0):
[?2004l[?2004h>     mask = (x >= window[0]) & (x <= window[1])
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     # Initial guesses: amplitude ~ max(y)-min(y), gamma ~ 10, x0 ~ guess_x0, offset ~ min(y)
[?2004l[?2004h>     amp_guess = y_fit.max() - y_fit.min()
[?2004l[?2004h>     gamma_guess = 10.0
[?2004l[?2004h>     offset_guess = y_fit.min()
[?2004l[?2004h>     p0 = [amp_guess, gamma_guess, guess_x0, offset_guess]
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         # If fit fails, return NaNs
[?2004l[?2004h>         popt = [np.nan, np.nan, np.nan, np.nan]
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> # Define windows and initial x0 guesses for each peak
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D':  {'window': (1200, 1500), 'guess_x0': 1350},
[?2004l[?2004h>     'G':  {'window': (1500, 1700), 'guess_x0': 1580},
[?2004l[?2004h>     '2D': {'window': (2500, 2850), 'guess_x0': 2690},
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, cfg in peaks.items():
[?2004l[?2004h>     amp, gamma, x0, offset = fit_peak(x, y, cfg['window'], cfg['guess_x0'])
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amp),
[?2004l[?2004h>         'offset': float(offset)
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute defect ratio I_D/I_G using amplitudes
[?2004l[?2004h> ID_IG = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None
[?2004l[?2004h> results['ID_IG'] = float(ID_IG) if ID_IG is not None else None
[?2004l[?2004h> 
[?2004l[?2004h> # Write to JSON
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Fitting complete. Results written to /app/results.json')
[?2004l[?2004h> PY
