[68.341448, "i", "cat <<'EOF' > fit_peaks.py\nimport pandas as pd\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Load data\ndf = pd.read_csv('spectrum.csv')\n# Ensure columns are correct\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\n# Lorentzian with offset\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Helper to fit a peak within a window\ndef fit_peak(x, y, center, window=50):\n    mask = (x >= center - window) & (x <= center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    # Initial guesses\n    amp_guess = y_fit.max() - y_fit.min()\n    x0_guess = x_fit[np.argmax(y_fit)]\n    gamma_guess = 10.0\n    offset_guess = y_fit.min()\n    p0 = [amp_guess, x0_guess, gamma_guess, offset_guess]\n    # Bounds: amplitude>0, gamma>0\n    bounds = ([0, center - window, 0, -np.inf], [np.inf, center + window, np.inf, np.inf])\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=bounds)\n    return {\n        'amplitude': float"]
[68.341632, "i", "(popt[0]),\n        'x0': float(popt[1]),\n        'gamma': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Fit D, G, 2D peaks\nresults = {}\nresults['D'] = fit_peak(x, y, center=1350, window=100)\nresults['G'] = fit_peak(x, y, center=1580, window=100)\nresults['2D'] = fit_peak(x, y, center=2690, window=150)\n\n# Compute defect ratio I_D/I_G (using amplitudes)\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\n\n# Write to JSON file\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results written to results.json')\nEOF\n"]
[68.341763, "o", "cat <<'EOF' > fit_peaks.py\r\n\u001b[?2004l\r(popt[0]),\r\n        'x0': float(popt[1]),\r\n        'gamma': float(popt[2]),\r\n        'offset': float(popt[3])\r\n    }\r\n\r\n# Fit D, G, 2D peaks\r\nresults = {}\r\nresults['D'] = fit_peak(x, y, center=1350, window=100)\r\nresults['G'] = fit_peak(x, y, center=1580, window=100)\r\nresults['2D'] = fit_peak(x, y, center=2690, window=150)\r\n\r\n# Compute defect ratio I_D/I_G (using amplitudes)\r\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None\r\n\r\n# Write to JSON file\r\nwith open('results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\n\r\nprint('Fitting complete. Results written to results.json')\r\nEOF\r\n\u001b[?2004h"]
