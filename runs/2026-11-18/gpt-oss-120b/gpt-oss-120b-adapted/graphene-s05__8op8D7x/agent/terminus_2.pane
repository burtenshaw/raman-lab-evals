[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('spectrum.csv')
[?2004l[?2004h> # Ensure columns are correct
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian with offset
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to fit a peak within a window
[?2004l[?2004h> def fit_peak(x, y, center, window=50):
[?2004l[?2004h>     mask = (x >= center - window) & (x <= center + window)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     # Initial guesses
[?2004l[?2004h>     amp_guess = y_fit.max() - y_fit.min()
[?2004l[?2004h>     x0_guess = x_fit[np.argmax(y_fit)]
[?2004l[?2004h>     gamma_guess = 10.0
[?2004l[?2004h>     offset_guess = y_fit.min()
[?2004l[?2004h>     p0 = [amp_guess, x0_guess, gamma_guess, offset_guess]
[?2004l[?2004h>     # Bounds: amplitude>0, gamma>0
[?2004l[?2004h>     bounds = ([0, center - window, 0, -np.inf], [np.inf, center + window, np.inf, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=bounds)
[?2004l[?2004h>     return {
[?2004l[?2004h>         'amplitude': float(popt[0]),
[?2004l[?2004h>         'x0': float(popt[1]),
[?2004l[?2004h>         'gamma': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Fit D, G, 2D peaks
[?2004l[?2004h> results = {}
[?2004l[?2004h> results['D'] = fit_peak(x, y, center=1350, window=100)
[?2004l[?2004h> results['G'] = fit_peak(x, y, center=1580, window=100)
[?2004l[?2004h> results['2D'] = fit_peak(x, y, center=2690, window=150)
[?2004l[?2004h> 
[?2004l[?2004h> # Compute defect ratio I_D/I_G (using amplitudes)
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude'] if results['G']['amplitude'] != 0 else None
[?2004l[?2004h> 
[?2004l[?2004h> # Write to JSON file
[?2004l[?2004h> with open('results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Fitting complete. Results written to results.json')
