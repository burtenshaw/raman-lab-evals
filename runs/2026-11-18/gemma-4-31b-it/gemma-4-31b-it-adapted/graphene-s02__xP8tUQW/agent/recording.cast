[0.928434, "o", "\u001b[?2004hroot@j-openenv-6afd88dae5cad0e4dc3e6934-9pxw1mwt-1b84d-qzmqv:/app# "]
[26.823758, "i", "head -n 5 /app/spectrum.csv\n"]
[26.82389, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[26.825885, "o", "raman_shift_cm-1,intensity\r\n1100.0000,1018.716\r\n1100.5001,1054.576\r\n1101.0003,963.467\r\n1101.5004,965.532\r\n"]
[26.826065, "o", "\u001b[?2004h"]
[26.82611, "o", "root@j-openenv-6afd88dae5cad0e4dc3e6934-9pxw1mwt-1b84d-qzmqv:/app# "]
[26.923471, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = pd.read_csv('/app/spectrum.csv')\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\npeaks = {\n    'D': 1350,\n    'G': 1580,\n    '2D': 2690\n}\n\nresults = {}\n\nfor name, center in peaks.items():\n    # Define a window around the peak to fit\n    mask = (x > center - 100) & (x < center + 100)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guess: amplitude=max(y)-min(y), gamma=10, x0=center, offset=min(y)\n    p0 = [np.max(y_fit) - np.min(y_fit), 10, center, np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[name] = {\n        'amplitude': float(popt[0]),\n        'gamma': float(popt[1]),\n        'x0': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['a"]
[26.923629, "i", "mplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
