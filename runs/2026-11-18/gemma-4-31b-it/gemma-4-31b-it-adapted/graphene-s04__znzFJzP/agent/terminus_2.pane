[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Use bounds to force positive amplitude and gamma
[?2004l[?2004h>     # bounds = ([low_amp, low_gamma, low_x0, low_off], [high_amp, high_gamma, high_x0, high_off])
[?2004l[?2004h>     lower_bounds = [0, 0, config['range'][0], -np.inf]
[?2004l[?2004h>     upper_bounds = [np.inf, 100, config['range'][1], np.inf]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=config['guess'], bounds=(lower_bounds, upper_bounds))
[?2004l[?2004h>     amplitude, gamma, x0, offset = popt
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amplitude), 'offset': float(offset)}
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
