[?2004l[?2004h>     'G': {'range': (1550, 1620), 'guess': [1000, 20, 1580, 1000]},
[?2004l[?2004h>     '2D': {'range': (2650, 2750), 'guess': [1000, 30, 2690, 1000]}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, config in peaks.items():
