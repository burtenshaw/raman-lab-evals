[?2004hroot@j-openenv-6afd87814643bac7ac634db9-xx2p8knm-94d13-xdzsr:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': {'range': (1300, 1400), 'guess': [1000, 20, 1350, 100]},
[?2004l[?2004h>     'G': {'range': (1500, 1650), 'guess': [1000, 20, 1580, 100]},
[?2004l[?2004h>     '2D': {'range': (2600, 2800), 'guess': [1000, 30, 2690, 100]}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, config in peaks.items():
[?2004l[?2004h>     mask = (x >= config['range'][0]) & (x <= config['range'][1])
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=config['guess'])
[?2004l[?2004h>     amplitude, gamma, x0, offset = popt
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amplitude), 'offset': float(offset)}
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> EOF
