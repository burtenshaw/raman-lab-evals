[5.327724, "o", "\r\n\u001b[?2004l\r"]
[5.341325, "o", "raman_shift_cm-1,intensity\r\n1100.0000,1365.563\r\n1100.5001,1398.616\r\n1101.0003,1325.446\r\n1101.5004,1350.712\r\n"]
[5.342041, "o", "\u001b[?2004h"]
[5.342216, "o", "root@j-openenv-6afd87814643bac7ac634db9-xx2p8knm-94d13-xdzsr:/app# "]
[26.448903, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'range': (1300, 1400), 'guess': [1000, 20, 1350, 100]},\n    'G': {'range': (1500, 1650), 'guess': [1000, 20, 1580, 100]},\n    '2D': {'range': (2600, 2800), 'guess': [1000, 30, 2690, 100]}\n}\n\nresults = {}\nfor name, config in peaks.items():\n    mask = (x >= config['range'][0]) & (x <= config['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=config['guess'])\n    amplitude, gamma, x0, offset = popt\n    results[name] = {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amplitude), 'offset': float(offset)}\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith o"]
[26.448968, "i", "pen('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
