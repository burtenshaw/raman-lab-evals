[96.821676, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'range': (1300, 1400), 'guess': [500, 20, 1350, 1000]},\n    'G': {'range': (1550, 1620), 'guess': [1000, 20, 1580, 1000]},\n    '2D': {'range': (2650, 2750), 'guess': [1000, 30, 2690, 1000]}\n}\n\nresults = {}\nfor name, config in peaks.items():\n    mask = (x >= config['range'][0]) & (x <= config['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Use bounds to force positive amplitude and gamma\n    # bounds = ([low_amp, low_gamma, low_x0, low_off], [high_amp, high_gamma, high_x0, high_off])\n    lower_bounds = [0, 0, config['range'][0], -np.inf]\n    upper_bounds = [np.inf, 100, config['range'][1], np.inf]\n    \n    popt, _ = curve_fit(lorentzi"]
[96.821728, "i", "an, x_fit, y_fit, p0=config['guess'], bounds=(lower_bounds, upper_bounds))\n    amplitude, gamma, x0, offset = popt\n    results[name] = {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amplitude), 'offset': float(offset)}\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
