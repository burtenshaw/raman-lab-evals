[0.933227, "o", "clear\r\n\u001b[?2004l\r"]
[0.935001, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.935246, "o", "\u001b[?2004hroot@j-openenv-6afd888e4643bac7ac634e6e-fqpb71po-02397-nb7bb:/app# "]
[19.679494, "i", "cat /app/spectrum.csv | head -n 5\n"]
[19.679688, "o", "cat /app/spectrum.csv | head -n 5\r\n\u001b[?2004l\r"]
[19.682305, "o", "raman_shift_cm-1,intensity\r\n1100.0000,1188.408\r\n1100.5001,1068.023\r\n1101.0003,1192.268\r\n1101.5004,1162.308\r\n"]
[19.682472, "o", "\u001b[?2004hroot@j-openenv-6afd888e4643bac7ac634e6e-fqpb71po-02397-nb7bb:/app# "]
[19.7808, "i", "cat << 'EOF' > fit_raman.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = pd.read_csv('/app/spectrum.csv')\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\npeaks = {\n    'D': (1350, 1250, 1450),   # target x0, window start, window end\n    'G': (1580, 1480, 1680), \n    '2D': (2690, 2590, 2790)\n}\n\nresults = {}\nfor name, (x0_guess, start, end) in peaks.items():\n    mask = (x >= start) & (x <= end)\n    xm = x[mask]\n    ym = y[mask]\n    \n    # Initial guess: [x0, gamma, amplitude, offset]\n    # gamma guess ~ 20, amplitude guess ~ max(ym)-min(ym), offset ~ min(ym)\n    p0 = [x0_guess, 20, np.max(ym) - np.min(ym), np.min(ym)]\n    \n    popt, _ = curve_fit(lorentzian, xm, ym, p0=p0)\n    results[name] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n  "]
[19.780962, "i", "  }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Fitting complete.\")\nEOF\n"]
