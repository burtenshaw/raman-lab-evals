[?2004lraman_shift_cm-1,intensity
1100.0000,1188.408
1100.5001,1068.023
1101.0003,1192.268
1101.5004,1162.308
[?2004hroot@j-openenv-6afd888e4643bac7ac634e6e-fqpb71po-02397-nb7bb:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = data['raman_shift_cm-1'].values
[?2004l[?2004h> y = data['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': (1350, 1250, 1450),   # target x0, window start, window end
[?2004l[?2004h>     'G': (1580, 1480, 1680), 
[?2004l[?2004h>     '2D': (2690, 2590, 2790)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (x0_guess, start, end) in peaks.items():
[?2004l[?2004h>     mask = (x >= start) & (x <= end)
[?2004l[?2004h>     xm = x[mask]
[?2004l[?2004h>     ym = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guess: [x0, gamma, amplitude, offset]
[?2004l[?2004h>     # gamma guess ~ 20, amplitude guess ~ max(ym)-min(ym), offset ~ min(ym)
[?2004l[?2004h>     p0 = [x0_guess, 20, np.max(ym) - np.min(ym), np.min(ym)]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, xm, ym, p0=p0)
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'amplitude': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Fitting complete.")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@j-openenv-6afd888e4643bac7ac634e6e-fqpb71po-02397-nb7bb:/app# python3 fit_raman.py
