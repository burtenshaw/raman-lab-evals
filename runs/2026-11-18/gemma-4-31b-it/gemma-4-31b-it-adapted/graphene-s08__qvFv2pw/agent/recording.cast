[17.543336, "o", "4l\r\u001b[?2004h>     # Offset estimated from min(y_fit)\r\n\u001b[?2004l\r\u001b[?2004h>     # amplitude estimated from max(y_fit) - min(y_fit)\r\n\u001b[?2004l\r\u001b[?2004h>     # gamma guessed as 20\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [params['center'], 20, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\r\n\u001b[?2004l\r\u001b[?2004h>     x0, gamma, amplitude, offset = popt\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     results[peak] = {\r\n\u001b[?2004l\r\u001b[?2004h>         'x0': float(x0),\r\n\u001b[?2004l\r\u001b[?2004h>         'gamma': float(gamma),\r\n\u001b[?2004l\r\u001b[?2004h>         'amplitude': float(amplitude),\r\n\u001b[?2004l\r\u001b[?2004h>         'offset': float(offset)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate ID/IG ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
