[17.425926, "o", "\u001b[?2004l\r"]
[17.430757, "o", "raman_shift_cm-1,intensity\r\n"]
[17.432815, "o", "1100.0000,902.977\r\n1100.5001,976.662\r\n1101.0003,906.945\r\n1101.5004,1014.009\r\n1102.0005,968.463\r\n1102.5007,979.727\r\n1103.0008,1016.669\r\n1103.5009,899.835\r\n1104.0011,961.901\r\n"]
[17.432881, "o", "\u001b[?2004hroot@j-openenv-6afd8800884144d2f44fd470-nfit0iz7-f5d08-k2zqn:/app# "]
[17.537885, "i", "cat << 'EOF' > /app/fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'center': 1350, 'window': 50},\n    'G': {'center': 1580, 'window': 50},\n    '2D': {'center': 2690, 'window': 100}\n}\n\nresults = {}\n\nfor peak, params in peaks.items():\n    # Filter data around the peak\n    mask = (x > params['center'] - params['window']) & (x < params['center'] + params['window'])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: x0, gamma, amplitude, offset\n    # Offset estimated from min(y_fit)\n    # amplitude estimated from max(y_fit) - min(y_fit)\n    # gamma guessed as 20\n    p0 = [params['center'], 20, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0"]
[17.538137, "i", ")\n    x0, gamma, amplitude, offset = popt\n    \n    results[peak] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amplitude),\n        'offset': float(offset)\n    }\n\n# Calculate ID/IG ratio\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results saved to /app/results.json')\nEOF\n"]
[17.538177, "o", "cat << 'EOF' > /app/fit_raman.py"]
