[?2004hroot@j-openenv-6afd8800884144d2f44fd470-nfit0iz7-f5d08-k2zqn:/app# cat << 'EOF' > /app/fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': {'center': 1350, 'window': 50},
[?2004l[?2004h>     'G': {'center': 1580, 'window': 50},
[?2004l[?2004h>     '2D': {'center': 2690, 'window': 100}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for peak, params in peaks.items():
[?2004l[?2004h>     # Filter data around the peak
[?2004l[?2004h>     mask = (x > params['center'] - params['window']) & (x < params['center'] + params['window'])
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: x0, gamma, amplitude, offset
[?2004l[?2004h>     # Offset estimated from min(y_fit)
[?2004l[?2004h>     # amplitude estimated from max(y_fit) - min(y_fit)
[?2004l[?2004h>     # gamma guessed as 20
[?2004l[?2004h>     p0 = [params['center'], 20, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     x0, gamma, amplitude, offset = popt
[?2004l[?2004h>     
[?2004l[?2004h>     results[peak] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amplitude),
[?2004l[?2004h>         'offset': float(offset)
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate ID/IG ratio
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Fitting complete. Results saved to /app/results.json')
[?2004l[?2004h> EOF
