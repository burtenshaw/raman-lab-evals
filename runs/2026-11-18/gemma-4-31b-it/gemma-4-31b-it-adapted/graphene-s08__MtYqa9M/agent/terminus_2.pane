[?2004hroot@j-openenv-6afd8933e5cad0e4dc3e6988-zkq30k9y-5da4a-6gz5b:/app# asciinema rec --stdin /logs/agent/recording.cast
[?2004l[0;32masciinema: recording asciicast to /logs/agent/recording.cast[0m
[0;32masciinema: press <ctrl-d> or type "exit" when you're done[0m
[?2004hroot@j-openenv-6afd8933e5cad0e4dc3e6988-zkq30k9y-5da4a-6gz5b:/app# clear
[?2004l[H[J[3J[?2004hroot@j-openenv-6afd8933e5cad0e4dc3e6988-zkq30k9y-5da4a-6gz5b:/app# head -n 5 /app/spectrum.csv
[?2004lraman_shift_cm-1,intensity
1100.0000,902.977
1100.5001,976.662
1101.0003,906.945
1101.5004,1014.009
[?2004hroot@j-openenv-6afd8933e5cad0e4dc3e6988-zkq30k9y-5da4a-6gz5b:/app# cat << 'EOF' > /app/fit_spectrum.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Peak regions
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': (1300, 1400),
[?2004l[?2004h>     'G': (1500, 1650),
[?2004l[?2004h>     '2D': (2600, 2800)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for peak_name, (low, high) in peaks.items():
[?2004l[?2004h>     # Filter data for the specific peak region
[?2004l[?2004h>     mask = (x >= low) & (x <= high)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: x0=center of range, gamma=10, amplitude=max(y)-min(y), offset=min(y)
[?2004l[?2004h>     p0 = [ (low + high) / 2, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit) ]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     results[peak_name] = {
[?2004l[?2004h>         'x0': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'amplitude': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate ID/IG ratio
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> # Write to results.json
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Fitting complete. Results saved to /app/results.json")
[?2004l[?2004h> EOF
