[14.452286, "i", "cat << 'EOF' > /app/fit_spectrum.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\n# Peak regions\npeaks = {\n    'D': (1300, 1400),\n    'G': (1500, 1650),\n    '2D': (2600, 2800)\n}\n\nresults = {}\n\nfor peak_name, (low, high) in peaks.items():\n    # Filter data for the specific peak region\n    mask = (x >= low) & (x <= high)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: x0=center of range, gamma=10, amplitude=max(y)-min(y), offset=min(y)\n    p0 = [ (low + high) / 2, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit) ]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[peak_name] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float("]
[14.452421, "i", "popt[3])\n    }\n\n# Calculate ID/IG ratio\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\n# Write to results.json\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Fitting complete. Results saved to /app/results.json\")\nEOF\n"]
[14.452441, "o", "cat << 'EOF' > /app/fit_spectrum.py\r\n\u001b[?2004l\r"]
[14.452657, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[14.452697, "o", "from scipy.optimize import curve_fit"]
[14.452738, "o", "\r\n\u001b[?2004l\r"]
[14.452749, "o", "\u001b[?2004h"]
[14.454989, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r\u001b[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> df = pd.read_csv('/app/spectrum.csv')\r\n\u001b[?2004l\r\u001b[?2004h> x = df['raman_shift_cm-1'].values\r\n\u001b[?2004l\r\u001b[?2004h> y = df['intensity'].values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Peak regions\r\n\u001b[?2004l\r\u001b[?2004h> peaks = {\r\n\u001b[?2004l\r\u001b[?2004h>     'D': (1300, 1400),\r\n\u001b[?2004l\r\u001b[?2004h>     'G': (1500, 1650),\r\n\u001b[?2004l\r\u001b[?2004h>     '2D': (2600, 2800)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for peak_name, (low, high) in peaks.items():\r\n\u001b[?2004l\r\u001b[?2004h>     # Filter data for the specific peak region\r\n\u001b[?2004l\r\u001b[?2004h>     mask = (x >= low) & (x <= high)\r\n\u001b[?2004l\r\u001b[?2004h>     x_fit = x[mask]\r\n\u001b[?2004l\r\u001b[?2004h>     y_fit = y[mask]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?20"]
[14.455077, "o", "04h>     # Initial guesses: x0=center of range, gamma=10, amplitude=max(y)-min(y), offset=min(y)\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [ (low + high) / 2, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit) ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\r\n\u001b[?2004l\r\u001b[?2004h>     results[peak_name] = {\r\n\u001b[?2004l\r\u001b[?2004h>         'x0': float(popt[0]),\r\n\u001b[?2004l\r\u001b[?2004h>         'gamma': float(popt[1]),\r\n\u001b[?2004l\r\u001b[?2004h>         'amplitude': float(popt[2]),\r\n\u001b[?2004l\r\u001b[?2004h>         'offset': float(popt[3])\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate ID/IG ratio\r\n\u001b[?2004l\r\u001b[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Write to results.json\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Fitting complete. Results saved to /app/results.js"]
