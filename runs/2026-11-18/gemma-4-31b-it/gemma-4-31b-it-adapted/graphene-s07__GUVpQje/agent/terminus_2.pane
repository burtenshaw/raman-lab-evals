[?2004hroot@j-openenv-6afd893029e8b7ccfbbb7fea-qr9ngihv-f4817-x9tvd:/app# asciinema rec --stdin /logs/agent/recording.cast
[?2004l[0;32masciinema: recording asciicast to /logs/agent/recording.cast[0m
[0;32masciinema: press <ctrl-d> or type "exit" when you're done[0m
[?2004hroot@j-openenv-6afd893029e8b7ccfbbb7fea-qr9ngihv-f4817-x9tvd:/app# clear
[?2004l[H[J[3J[?2004hroot@j-openenv-6afd893029e8b7ccfbbb7fea-qr9ngihv-f4817-x9tvd:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = data['raman_shift_cm-1'].values
[?2004l[?2004h> y = data['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': {'center': 1350, 'width': 100},
[?2004l[?2004h>     'G': {'center': 1580, 'width': 100},
[?2004l[?2004h>     '2D': {'center': 2690, 'width': 100}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for peak, params in peaks.items():
[?2004l[?2004h>     # Mask data for the specific peak region
[?2004l[?2004h>     mask = (x > params['center'] - params['width']) & (x < params['center'] + params['width'])
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: [amplitude, gamma, x0, offset]
[?2004l[?2004h>     # amplitude is peak height minus offset roughly
[?2004l[?2004h>     initial_offset = np.min(y_fit)
[?2004l[?2004h>     initial_amp = np.max(y_fit) - initial_offset
[?2004l[?2004h>     p0 = [initial_amp, 20, params['center'], initial_offset]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     results[peak] = {
[?2004l[?2004h>         'amplitude': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'x0': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> EOF
