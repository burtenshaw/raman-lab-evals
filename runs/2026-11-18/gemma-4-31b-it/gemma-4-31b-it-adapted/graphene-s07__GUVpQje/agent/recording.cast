[0.938534, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.938725, "o", "\u001b[?2004h"]
[0.93877, "o", "root@j-openenv-6afd893029e8b7ccfbbb7fea-qr9ngihv-f4817-x9tvd:/app# "]
[14.172688, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = pd.read_csv('/app/spectrum.csv')\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\npeaks = {\n    'D': {'center': 1350, 'width': 100},\n    'G': {'center': 1580, 'width': 100},\n    '2D': {'center': 2690, 'width': 100}\n}\n\nresults = {}\n\nfor peak, params in peaks.items():\n    # Mask data for the specific peak region\n    mask = (x > params['center'] - params['width']) & (x < params['center'] + params['width'])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: [amplitude, gamma, x0, offset]\n    # amplitude is peak height minus offset roughly\n    initial_offset = np.min(y_fit)\n    initial_amp = np.max(y_fit) - initial_offset\n    p0 = [initial_amp, 20, params['center'], initial_offset]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n"]
[14.172872, "i", "    results[peak] = {\n        'amplitude': float(popt[0]),\n        'gamma': float(popt[1]),\n        'x0': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
[14.173169, "o", "cat << 'EOF' > fit_raman.py\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
