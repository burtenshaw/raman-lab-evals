Sending keys: ["cat << 'EOF' > fit_spectrum.py\nimport csv\nimport json\nimport math\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset\n\ndef calculate_sse(x_data, y_data, params):\n    x0, gamma, amplitude, offset = params\n    sse = 0\n    for x, y in zip(x_data, y_data):\n        sse += (y - lorentzian(x, x0, gamma, amplitude, offset))**2\n    return sse\n\ndef fit_peak(x_data, y_data, start_x0):\n    # Simple coordinate descent / grid search hybrid for initial guess\n    # Params: x0, gamma, amplitude, offset\n    best_params = [start_x0, 10.0, 100.0, min(y_data)]\n    best_sse = calculate_sse(x_data, y_data, best_params)\n    \n    # Heuristic to improve amplitude guess\n    best_params[2] = max(y_data) - min(y_data)\n    best_sse = calculate_sse(x_data, y_data, best_params)\n\n    # Simple iterative refinement (Coordinate Descent)\n    step_sizes = [0.1, 0.1, 1.0, 0.1]\n    for _ in range(100):\n        improved = False\n        for i in range(4):\n            for direction in [-1, 1]:\n                test_params = list(best_params)\n                test_params[i] += direction * step_sizes[i]\n                sse = calculate_sse(x_data, y_data, test_params)\n                if sse < best_sse:\n                    best_sse = sse\n                    best_params = test_params\n                    improved = True\n        if not improved:\n            # Reduce step sizes and try again\n            step_sizes = [s * 0.5 for s in step_sizes]\n            if step_sizes[0] < 1e-4:\n                break\n    \n    return best_params\n\n# Load data\nx_all = []\ny_all = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)\n    for row in reader:\n        x_all.append(float(row[0]))\n        y_all.append(float(row[1]))\n\npeaks_centers = {'D': 1350, 'G': 1580, '2D': 2690}\nresults = {}\n\nfor name, center in peaks_centers.items():\n    # Isolate window\n    window = [(x, y) for x, y in zip(x_all, y_all) if center - 50 <= x <= center + 50]\n    x_fit = [p[0] for p in window]\n    y_fit = [p[1] for p in window]\n    \n    popt = fit_peak(x_fit, y_fit, center)\n    results[name] = {\n        'x0': popt[0],\n        'gamma': popt[1],\n        'amplitude': popt[2],\n        'offset': popt[3]\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
