Sending keys: ['cat << \'EOF\' > /app/fit_spectrum.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv(\'/app/spectrum.csv\')\nx = df[\'raman_shift_cm-1\'].values\ny = df[\'intensity\'].values\n\n# Peak regions\npeaks = {\n    \'D\': (1300, 1400),\n    \'G\': (1500, 1650),\n    \'2D\': (2600, 2800)\n}\n\nresults = {}\n\nfor peak_name, (low, high) in peaks.items():\n    # Filter data for the specific peak region\n    mask = (x >= low) & (x <= high)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: x0=center of range, gamma=10, amplitude=max(y)-min(y), offset=min(y)\n    p0 = [ (low + high) / 2, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit) ]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[peak_name] = {\n        \'x0\': float(popt[0]),\n        \'gamma\': float(popt[1]),\n        \'amplitude\': float(popt[2]),\n        \'offset\': float(popt[3])\n    }\n\n# Calculate ID/IG ratio\nresults[\'ID_IG\'] = results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\']\n\n# Write to results.json\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("Fitting complete. Results saved to /app/results.json")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
