Sending keys: ["cat << 'EOF' > fit_peaks.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks_config = {\n    'D': {'center': 1350, 'window': 100},\n    'G': {'center': 1580, 'window': 100},\n    '2D': {'center': 2690, 'window': 100}\n}\n\nresults = {}\n\nfor peak_name, config in peaks_config.items():\n    mask = (x >= config['center'] - config['window']) & (x <= config['center'] + config['window'])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Estimate initial parameters\n    # amplitude: peak height - baseline\n    # gamma: typical half-width at half-max\n    # x0: peak center\n    # offset: baseline\n    p0 = [np.max(y_fit) - np.min(y_fit), 20.0, config['center'], np.min(y_fit)]\n    \n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        amplitude, gamma, x0, offset = popt\n        results[peak_name] = {\n            'x0': float(x0),\n            'gamma': float(gamma),\n            'amplitude': float(amplitude),\n            'offset': float(offset)\n        }\n    except Exception as e:\n        print(f'Error fitting {peak_name}: {e}')\n\nif 'D' in results and 'G' in results:\n    results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results written to /app/results.json')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
