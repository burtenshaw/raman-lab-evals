Sending keys: ['cat << \'EOF\' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv(\'/app/spectrum.csv\')\nx = df[\'raman_shift_cm-1\'].values\ny = df[\'intensity\'].values\n\npeaks = {\n    \'D\': 1350,\n    \'G\': 1580,\n    \'2D\': 2690\n}\n\nresults = {}\n\nfor name, center in peaks.items():\n    # Define a window around the peak to fit\n    mask = (x > center - 50) & (x < center + 50)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: [amplitude, gamma, x0, offset]\n    # Amplitude estimate: peak height - baseline\n    # gamma estimate: typical graphene peak width ~10-30\n    # x0 estimate: center\n    # offset estimate: min of the region\n    p0 = [np.max(y_fit) - np.min(y_fit), 20, center, np.min(y_fit)]\n    \n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        amplitude, gamma, x0, offset = popt\n        results[name] = {"x0": float(x0), "gamma": float(gamma), "amplitude": float(amplitude), "offset": float(offset)}\n    except Exception as e:\n        print(f"Error fitting {name}: {e}")\n        results[name] = None\n\n# Calculate ID/IG\nif results[\'D\'] and results[\'G\']:\n    id_ig = results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\']\n    results[\'ID_IG\'] = float(id_ig)\nelse:\n    results[\'ID_IG\'] = None\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("Fitting complete. Results saved to /app/results.json")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
