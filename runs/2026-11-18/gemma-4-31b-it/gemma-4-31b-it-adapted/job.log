Sending keys: ['cat << \'EOF\' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv(\'/app/spectrum.csv\')\nx = df[\'raman_shift_cm-1\'].values\ny = df[\'intensity\'].values\n\npeaks_config = {\n    \'D\': {\'range\': (1300, 1400), \'x0_guess\': 1350},\n    \'G\': {\'range\': (1550, 1620), \'x0_guess\': 1580},\n    \'2D\': {\'range\': (2650, 2750), \'x0_guess\': 2690}\n}\n\nresults = {}\nfor name, config in peaks_config.items():\n    mask = (x >= config[\'range\'][0]) & (x <= config[\'range\'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    if len(x_fit) == 0:\n        continue\n        \n    # Better initial guesses\n    y_min = np.min(y_fit)\n    y_max = np.max(y_fit)\n    amp_guess = y_max - y_min\n    off_guess = y_min\n    gamma_guess = 20\n    x0_guess = config[\'x0_guess\']\n    \n    p0 = [amp_guess, gamma_guess, x0_guess, off_guess]\n    lower_bounds = [0, 0, config[\'range\'][0], -np.inf]\n    upper_bounds = [np.inf, 100, config[\'range\'][1], np.inf]\n    \n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0, bounds=(lower_bounds, upper_bounds), maxfev=10000)\n        amplitude, gamma, x0, offset = popt\n        results[name] = {\'x0\': float(x0), \'gamma\': float(gamma), \'amplitude\': float(amplitude), \'offset\': float(offset)}\n    except Exception as e:\n        print(f"Error fitting {name}: {e}")\n\nif \'D\' in results and \'G\' in results:\n    results[\'ID_IG\'] = results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\']\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
