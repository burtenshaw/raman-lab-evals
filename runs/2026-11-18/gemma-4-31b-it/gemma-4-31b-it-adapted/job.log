Sending keys: ['cat << \'EOF\' > fit_raman.py\nimport csv\nimport json\nimport math\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef calculate_sse(x_data, y_data, params):\n    sse = 0\n    for x, y in zip(x_data, y_data):\n        sse += (y - lorentzian(x, *params))**2\n    return sse\n\ndef fit_peak(x_data, y_data, x0_guess, gamma_guess, amplitude_guess, offset_guess):\n    params = [amplitude_guess, gamma_guess, x0_guess, offset_guess]\n    best_params = list(params)\n    best_sse = calculate_sse(x_data, y_data, params)\n    \n    # Simple coordinate descent for optimization\n    learning_rates = [10.0, 0.1, 0.1, 10.0] # amp, gamma, x0, offset\n    for iteration in range(2000):\n        for i in range(4):\n            # Try moving parameter in both directions\n            for direction in [-1, 1]:\n                test_params = list(best_params)\n                test_params[i] += direction * learning_rates[i]\n                sse = calculate_sse(x_data, y_data, test_params)\n                if sse < best_sse:\n                    best_sse = sse\n                    best_params = test_params\n            # Gradually reduce learning rate\n            learning_rates[i] *= 0.999\n            \n    return best_params\n\nx_all = []\ny_all = []\nwith open(\'/app/spectrum.csv\', \'r\') as f:\n    reader = csv.reader(f)\n    next(reader)\n    for row in reader:\n        x_all.append(float(row[0]))\n        y_all.append(float(row[1]))\n\npeaks_config = {\n    \'D\': (1300, 1400, 1350),\n    \'G\': (1530, 1630, 1580),\n    \'2D\': (2630, 2750, 2690)\n}\n\nfinal_results = {}\nfor peak, (start, end, x0_center) in peaks_config.items():\n    x_fit = []\n    y_fit = []\n    for x, y in zip(x_all, y_all):\n        if start <= x <= end:\n            x_fit.append(x)\n            y_fit.append(y)\n    \n    if not x_fit:\n        continue\n\n    max_y = max(y_fit)\n    min_y = min(y_fit)\n    \n    # Initial Guesses\n    amp_guess = max_y - min_y\n    gamma_guess = 30.0\n    x0_guess = x0_center\n    offset_guess = min_y\n    \n    popt = fit_peak(x_fit, y_fit, x0_guess, gamma_guess, amp_guess, offset_guess)\n    \n    final_results[peak] = {\n        "amplitude": popt[0],\n        "gamma": popt[1],\n        "x0": popt[2],\n        "offset": popt[3]\n    }\n\nfinal_results[\'ID_IG\'] = final_results[\'D\'][\'amplitude\'] / final_results[\'G\'][\'amplitude\']\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(final_results, f, indent=2)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
