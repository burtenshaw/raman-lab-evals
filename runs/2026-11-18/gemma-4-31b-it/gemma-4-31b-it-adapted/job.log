Sending keys: ['cat << \'EOF\' > fit_spectrum.py\nimport csv\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data using csv module\nx = []\ny = []\nwith open(\'/app/spectrum.csv\', \'r\') as f:\n    reader = csv.reader(f)\n    next(reader) # skip header\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\nx = np.array(x)\ny = np.array(y)\n\npeaks = {\n    \'D\': 1350,\n    \'G\': 1580,\n    \'2D\': 2690\n}\n\nresults = {}\n\nfor name, center in peaks.items():\n    # Define a window around the peak to isolate it\n    mask = (x >= center - 50) & (x <= center + 50)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    if len(x_fit) == 0:\n        continue\n\n    # Initial guesses: x0=center, gamma=10, amplitude=max(y)-min(y), offset=min(y)\n    p0 = [center, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\n    \n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        results[name] = {\n            \'x0\': float(popt[0]),\n            \'gamma\': float(popt[1]),\n            \'amplitude\': float(popt[2]),\n            \'offset\': float(popt[3])\n        }\n    except Exception as e:\n        print(f"Error fitting {name}: {e}")\n\nif \'D\' in results and \'G\' in results:\n    results[\'ID_IG\'] = results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\']\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
