Sending keys: ['cat << \'EOF\' > fit_raman.py\nimport csv\nimport json\nimport random\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset\n\ndef objective(params, x_data, y_data):\n    x0, gamma, amplitude, offset = params\n    res = 0\n    for x, y in zip(x_data, y_data):\n        res += (y - lorentzian(x, x0, gamma, amplitude, offset))**2\n    return res\n\ndef fit_peak(x_data, y_data, guess):\n    # Nelder-Mead Simplex Algorithm implementation\n    def get_simplex(p0):\n        simplex = [p0]\n        for i in range(len(p0)):\n            p = list(p0)\n            p[i] += 1.0 if p[i] == 0 else p[i] * 0.05\n            simplex.append(p)\n        return simplex\n\n    simplex = get_simplex(guess)\n    scores = [objective(p, x_data, y_data) for p in simplex]\n\n    for _ in range(500):\n        # Sort simplex by scores\n        combined = sorted(zip(scores, simplex), key=lambda x: x[0])\n        scores = [c[0] for c in combined]\n        simplex = [c[1] for c in combined]\n\n        # Centroid\n        centroid = [sum(p[i] for p in simplex[:-1]) / (len(simplex)-1) for i in range(len(guess))]\n        \n        # Reflection\n        worst = simplex[-1]\n        reflected = [centroid[i] + 1.0 * (centroid[i] - worst[i]) for i in range(len(guess))]\n        r_score = objective(reflected, x_data, y_data)\n\n        if scores[0] <= r_score < scores[-2]:\n            simplex[-1] = reflected\n            scores[-1] = r_score\n        elif r_score < scores[0]:\n            # Expansion\n            expanded = [centroid[i] + 2.0 * (reflected[i] - centroid[i]) for i in range(len(guess))]\n            e_score = objective(expanded, x_data, y_data)\n            if e_score < r_score:\n                simplex[-1] = expanded\n                scores[-1] = e_score\n            else:\n                simplex[-1] = reflected\n                scores[-1] = r_score\n        else:\n            # Contraction\n            contracted = [centroid[i] + 0.5 * (worst[i] - centroid[i]) for i in range(len(guess))]\n            c_score = objective(contracted, x_data, y_data)\n            if c_score < scores[-1]:\n                simplex[-1] = contracted\n                scores[-1] = c_score\n            else:\n                # Shrink\n                for i in range(1, len(simplex)):\n                    simplex[i] = [simplex[0][j] + 0.5 * (simplex[i][j] - simplex[0][j]) for j in range(len(guess))]\n                    scores[i] = objective(simplex[i], x_data, y_data)\n\n    return simplex[0]\n\n# Load data\nx = []\ny = []\nwith open(\'/app/spectrum.csv\', \'r\') as f:\n    reader = csv.reader(f)\n    next(reader)\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\npeaks_config = {\n    \'D\': {\'range\': (1300, 1400), \'guess\': [1350.0, 20.0, 1000.0, 900.0]},\n    \'G\': {\'range\': (1530, 1630), \'guess\': [1580.0, 20.0, 1000.0, 900.0]},\n    \'2D\': {\'range\': (2630, 2750), \'guess\': [2690.0, 30.0, 1000.0, 900.0]}\n}\n\nresults = {}\nfor peak, config in peaks_config.items():\n    x_fit = [xi for xi in x if config[\'range\'][0] <= xi <= config[\'range\'][1]]\n    y_fit = [yi for xi, yi in zip(x, y) if config[\'range\'][0] <= xi <= config[\'range\'][1]]\n    \n    best_params = fit_peak(x_fit, y_fit, config[\'guess\'])\n    \n    results[peak] = {\n        \'x0\': best_params[0],\n        \'gamma\': best_params[1],\n        \'amplitude\': best_params[2],\n        \'offset\': best_params[3]\n    }\n\nresults[\'ID_IG\'] = results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\']\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("Fitting complete")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
