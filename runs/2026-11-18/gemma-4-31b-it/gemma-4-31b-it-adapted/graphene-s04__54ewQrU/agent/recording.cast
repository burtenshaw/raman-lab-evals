[0.935835, "o", "clear\r\n\u001b[?2004l\r"]
[0.937806, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.938, "o", "\u001b[?2004hroot@j-openenv-6afd88ece5cad0e4dc3e6945-rpatinpj-adca6-5dd88:/app# "]
[16.499831, "i", "head -n 5 /app/spectrum.csv\n"]
[16.499992, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[16.50247, "o", "raman_shift_cm-1,intensity\r\n1100.0000,1365.563\r\n1100.5001,1398.616\r\n1101.0003,1325.446\r\n1101.5004,1350.712\r\n"]
[16.502686, "o", "\u001b[?2004h"]
[16.502773, "o", "root@j-openenv-6afd88ece5cad0e4dc3e6945-rpatinpj-adca6-5dd88:/app# "]
[16.600508, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': 1350,\n    'G': 1580,\n    '2D': 2690\n}\n\nresults = {}\n\nfor name, center in peaks.items():\n    # Define a window around the peak\n    mask = (x > center - 50) & (x < center + 50)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: [x0, gamma, amplitude, offset]\n    # gamma is HWHM. For graphene, gamma is typically 20-50 cm-1\n    p0 = [center, 30, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\n    \n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        results[name] = {\n            'x0': float(popt[0]),\n            'gamma': float(popt[1]),\n            'amplitude': float(popt[2]),\n            'offset': float(popt[3])"]
[16.600643, "i", "\n        }\n    except Exception as e:\n        print(f'Error fitting {name}: {e}')\n\n# Calculate ID/IG ratio\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results saved to /app/results.json')\nEOF\n"]
