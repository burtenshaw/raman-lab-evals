[?2004hroot@j-openenv-6afd88ece5cad0e4dc3e6945-rpatinpj-adca6-5dd88:/app# asciinema rec --stdin /logs/agent/recording.cast
[?2004l[0;32masciinema: recording asciicast to /logs/agent/recording.cast[0m
[0;32masciinema: press <ctrl-d> or type "exit" when you're done[0m
[?2004hroot@j-openenv-6afd88ece5cad0e4dc3e6945-rpatinpj-adca6-5dd88:/app# clear
[?2004l[H[J[3J[?2004hroot@j-openenv-6afd88ece5cad0e4dc3e6945-rpatinpj-adca6-5dd88:/app# head -n 5 /app/spectrum.csv
[?2004lraman_shift_cm-1,intensity
1100.0000,1365.563
1100.5001,1398.616
1101.0003,1325.446
1101.5004,1350.712
[?2004hroot@j-openenv-6afd88ece5cad0e4dc3e6945-rpatinpj-adca6-5dd88:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': 1350,
[?2004l[?2004h>     'G': 1580,
[?2004l[?2004h>     '2D': 2690
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     # Define a window around the peak
[?2004l[?2004h>     mask = (x > center - 50) & (x < center + 50)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: [x0, gamma, amplitude, offset]
[?2004l[?2004h>     # gamma is HWHM. For graphene, gamma is typically 20-50 cm-1
[?2004l[?2004h>     p0 = [center, 30, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>         results[name] = {
[?2004l[?2004h>             'x0': float(popt[0]),
[?2004l[?2004h>             'gamma': float(popt[1]),
[?2004l[?2004h>             'amplitude': float(popt[2]),
[?2004l[?2004h>             'offset': float(popt[3])
[?2004l[?2004h>         }
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'Error fitting {name}: {e}')
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate ID/IG ratio
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Fitting complete. Results saved to /app/results.json')
[?2004l[?2004h> EOF
