[0.934667, "o", "clear\r\n\u001b[?2004l\r"]
[0.936676, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.936804, "o", "\u001b[?2004hroot@j-openenv-6afd88bee5cad0e4dc3e6908-2jxqyxc6-394c9-wzqph:/app# "]
[19.349645, "i", "head -n 5 /app/spectrum.csv\n"]
[19.349852, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[19.351563, "o", "raman_shift_cm-1,intensity\r\n1100.0000,1338.925\r\n1100.5001,1328.540\r\n1101.0003,1244.349\r\n1101.5004,1282.687\r\n"]
[19.351716, "o", "\u001b[?2004hroot@j-openenv-6afd88bee5cad0e4dc3e6908-2jxqyxc6-394c9-wzqph:/app# "]
[19.449978, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': 1350,\n    'G': 1580,\n    '2D': 2690\n}\n\nresults = {}\n\nfor name, center in peaks.items():\n    # Define window around the peak\n    mask = (x > center - 50) & (x < center + 50)\n    x_slice = x[mask]\n    y_slice = y[mask]\n    \n    # Initial guesses: x0=center, gamma=10, amplitude=max(y)-min(y), offset=min(y)\n    p0 = [center, 10, np.max(y_slice) - np.min(y_slice), np.min(y_slice)]\n    \n    popt, _ = curve_fit(lorentzian, x_slice, y_slice, p0=p0)\n    results[name] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['am"]
[19.450103, "i", "plitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Fitting complete. Results written to /app/results.json\")\nEOF\n"]
