[?2004l[0;32masciinema: recording asciicast to /logs/agent/recording.cast[0m
[0;32masciinema: press <ctrl-d> or type "exit" when you're done[0m
[?2004hroot@j-openenv-6afd88bee5cad0e4dc3e6908-2jxqyxc6-394c9-wzqph:/app# clear
[?2004l[H[J[3J[?2004hroot@j-openenv-6afd88bee5cad0e4dc3e6908-2jxqyxc6-394c9-wzqph:/app# head -n 5 /app/spectrum.csv
[?2004lraman_shift_cm-1,intensity
1100.0000,1338.925
1100.5001,1328.540
1101.0003,1244.349
1101.5004,1282.687
[?2004hroot@j-openenv-6afd88bee5cad0e4dc3e6908-2jxqyxc6-394c9-wzqph:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': 1350,
[?2004l[?2004h>     'G': 1580,
[?2004l[?2004h>     '2D': 2690
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     # Define window around the peak
[?2004l[?2004h>     mask = (x > center - 50) & (x < center + 50)
[?2004l[?2004h>     x_slice = x[mask]
[?2004l[?2004h>     y_slice = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: x0=center, gamma=10, amplitude=max(y)-min(y), offset=min(y)
[?2004l[?2004h>     p0 = [center, 10, np.max(y_slice) - np.min(y_slice), np.min(y_slice)]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_slice, y_slice, p0=p0)
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'amplitude': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Fitting complete. Results written to /app/results.json")
[?2004l[?2004h> EOF
