[28.122986, "i", "cat << 'EOF' > fit_raman.py\nimport csv\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nx = []\ny = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader) # skip header\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\nx = np.array(x)\ny = np.array(y)\n\npeaks = {\n    'D': (1300, 1400),\n    'G': (1530, 1630),\n    '2D': (2630, 2750)\n}\n\nresults = {}\n\nfor peak, (start, end) in peaks.items():\n    mask = (x >= start) & (x <= end)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    if len(x_fit) == 0:\n        continue\n\n    p0 = [np.max(y_fit) - np.min(y_fit), 30, (start + end) / 2, np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[peak] = {\n        \"x0\": float(popt[2]),\n        \"gamma\": float(popt[1]),\n        \"amplitude\": float(popt[0]),\n        \"offset\": float(popt[3])\n    }\n"]
[28.123334, "i", "\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
[28.123362, "o", "cat << 'EOF' > fit_raman.py\r\n\u001b[?2004l\r\r\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\r\n\r\nwith open('/app/results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\nEOF\r\n\u001b[?2004h"]
