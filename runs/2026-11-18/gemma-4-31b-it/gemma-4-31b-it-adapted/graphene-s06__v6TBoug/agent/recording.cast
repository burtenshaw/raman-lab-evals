[13.846597, "i", "cat << 'EOF' > fit_raman.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': (1300, 1400),\n    'G': (1530, 1630),\n    '2D': (2630, 2750)\n}\n\nresults = {}\n\nfor peak, (start, end) in peaks.items():\n    mask = (x >= start) & (x <= end)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: [amplitude, gamma, x0, offset]\n    # Amplitude: max(y) - min(y)\n    # Gamma: width estimate (roughly 20-50 cm-1)\n    # x0: peak center\n    # offset: min(y)\n    p0 = [np.max(y_fit) - np.min(y_fit), 30, (start + end) / 2, np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[peak] = {\n        \"x0\": float(popt[2]),\n        \"gamma\": float(popt[1]),\n        \"amplitude\": float(popt[0]),\n        \"offset\": float(popt"]
[13.84674, "i", "[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
