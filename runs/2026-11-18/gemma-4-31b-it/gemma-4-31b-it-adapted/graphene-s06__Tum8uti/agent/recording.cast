[70.568495, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[70.570448, "o", "raman_shift_cm-1,intensity\r\n1100.0000,814.711\r\n"]
[70.570549, "o", "1100.5001,823.937\r\n1101.0003,835.751\r\n1101.5004,907.570\r\n"]
[70.570737, "o", "\u001b[?2004h"]
[70.570782, "o", "root@j-openenv-6afd87df884144d2f44fd45b-qjmch8lj-6df6a-k9ffl:/app# "]
[70.619813, "i", "cat << 'EOF' > /app/fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = pd.read_csv('/app/spectrum.csv')\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\npeaks = {\n    'D': 1350,\n    'G': 1580,\n    '2D': 2690\n}\n\nresults = {}\n\nfor name, center in peaks.items():\n    # Define window around peak to avoid interference from other peaks\n    half_width = 100\n    mask = (x > center - half_width) & (x < center + half_width)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: [amplitude, gamma, x0, offset]\n    # Amplitude guess: peak height minus min height\n    # Gamma guess: ~20 (typical for graphene)\n    # x0 guess: the peak center\n    # offset guess: min intensity in window\n    p0 = [np.max(y_fit) - np.min(y_fit), 20, center, np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results"]
[70.619932, "i", "[name] = {\n        \"amplitude\": float(popt[0]),\n        \"gamma\": float(popt[1]),\n        \"x0\": float(popt[2]),\n        \"offset\": float(popt[3])\n    }\n\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nresults['ID_IG'] = float(id_ig)\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
[70.619993, "o", "cat << 'EOF' > /app/fit_raman.py\r\n\u001b[?2004l\r"]
