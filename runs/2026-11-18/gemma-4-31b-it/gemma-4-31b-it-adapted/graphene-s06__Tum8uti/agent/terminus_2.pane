[?2004lraman_shift_cm-1,intensity
1100.0000,814.711
1100.5001,823.937
1101.0003,835.751
1101.5004,907.570
[?2004hroot@j-openenv-6afd87df884144d2f44fd45b-qjmch8lj-6df6a-k9ffl:/app# cat << 'EOF' > /app/fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = data['raman_shift_cm-1'].values
[?2004l[?2004h> y = data['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': 1350,
[?2004l[?2004h>     'G': 1580,
[?2004l[?2004h>     '2D': 2690
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     # Define window around peak to avoid interference from other peaks
[?2004l[?2004h>     half_width = 100
[?2004l[?2004h>     mask = (x > center - half_width) & (x < center + half_width)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: [amplitude, gamma, x0, offset]
[?2004l[?2004h>     # Amplitude guess: peak height minus min height
[?2004l[?2004h>     # Gamma guess: ~20 (typical for graphene)
[?2004l[?2004h>     # x0 guess: the peak center
[?2004l[?2004h>     # offset guess: min intensity in window
[?2004l[?2004h>     p0 = [np.max(y_fit) - np.min(y_fit), 20, center, np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         "amplitude": float(popt[0]),
[?2004l[?2004h>         "gamma": float(popt[1]),
[?2004l[?2004h>         "x0": float(popt[2]),
[?2004l[?2004h>         "offset": float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> results['ID_IG'] = float(id_ig)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> EOF
