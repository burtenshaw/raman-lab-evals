[36.755179, "i", "cat << 'EOF' > fit_raman.py\nimport csv\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data using csv module\nx = []\ny = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)  # Skip header\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\nx = np.array(x)\ny = np.array(y)\n\npeaks = {\n    'D': 1350,\n    'G': 1580,\n    '2D': 2690\n}\n\nresults = {}\n\nfor name, center in peaks.items():\n    # Define a window around the peak to isolate it\n    window = 50\n    mask = (x > center - window) & (x < center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses: x0=center, gamma=10, amplitude=max(y)-min(y), offset=min(y)\n    p0 = [center, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\n    \n    # Fit the Lorentzian\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    \n    results[n"]
[36.755327, "i", "ame] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Calculate I_D / I_G\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nresults['ID_IG'] = float(id_ig)\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Fitting complete. Results saved to /app/results.json\")\nEOF\n"]
