[?2004hroot@j-openenv-6afd890929e8b7ccfbbb7fb7-ipmu4voh-54f17-7rnpj:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': 1350,
[?2004l[?2004h>     'G': 1580,
[?2004l[?2004h>     '2D': 2690
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     # Define a window around the peak to isolate it
[?2004l[?2004h>     window = 50
[?2004l[?2004h>     mask = (x > center - window) & (x < center + window)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: x0=center, gamma=10, amplitude=max(y)-min(y), offset=min(y)
[?2004l[?2004h>     p0 = [center, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     # Fit the Lorentzian
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'amplitude': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate I_D / I_G
[?2004l[?2004h> id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> results['ID_IG'] = float(id_ig)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Fitting complete. Results saved to /app/results.json")
[?2004l[?2004h> EOF
