[?2004lraman_shift_cm-1,intensity
1100.0000,1188.408
1100.5001,1068.023
1101.0003,1192.268
1101.5004,1162.308
[?2004hroot@j-openenv-6afd87e24643bac7ac634e1f-kukviuxw-346c9-28tm9:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': 1350,
[?2004l[?2004h>     'G': 1580,
[?2004l[?2004h>     '2D': 2690
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     # Define a window around the peak to fit
[?2004l[?2004h>     mask = (x > center - 50) & (x < center + 50)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses: [amplitude, gamma, x0, offset]
[?2004l[?2004h>     # Amplitude estimate: peak height - baseline
[?2004l[?2004h>     # gamma estimate: typical graphene peak width ~10-30
[?2004l[?2004h>     # x0 estimate: center
[?2004l[?2004h>     # offset estimate: min of the region
[?2004l[?2004h>     p0 = [np.max(y_fit) - np.min(y_fit), 20, center, np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>         amplitude, gamma, x0, offset = popt
[?2004l[?2004h>         results[name] = {"x0": float(x0), "gamma": float(gamma), "amplitude": float(amplitude), "offset": float(offset)}
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error fitting {name}: {e}")
[?2004l[?2004h>         results[name] = None
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate ID/IG
[?2004l[?2004h> if results['D'] and results['G']:
[?2004l[?2004h>     id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h>     results['ID_IG'] = float(id_ig)
[?2004l[?2004h> else:
[?2004l[?2004h>     results['ID_IG'] = None
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Fitting complete. Results saved to /app/results.json")
[?2004l[?2004h> EOF
