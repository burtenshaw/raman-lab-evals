[67.679304, "o", "ults, f, indent=2)\r\nEOF\r\n"]
[67.679339, "o", "\u001b[?2004h> "]
[67.679362, "o", "import csv\r\n"]
[67.679395, "o", "\u001b[?2004l\r"]
[67.679426, "o", "\u001b[?2004h> import math\r\n"]
[67.679441, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.679476, "o", "import json\r\n\u001b[?2004l\r"]
[67.679498, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.679527, "o", "\u001b[?2004h> "]
[67.679595, "o", "def lorentzian(x, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r"]
[67.679642, "o", "\u001b[?2004h> "]
[67.679703, "o", "    return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[67.679738, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.679801, "o", "def get_sse(x_data, y_data, params):\r\n\u001b[?2004l\r"]
[67.679827, "o", "\u001b[?2004h> "]
[67.679852, "o", "    sse = 0\r\n\u001b[?2004l\r"]
[67.679873, "o", "\u001b[?2004h> "]
[67.679917, "o", "    for xi, yi in zip(x_data, y_data):\r\n\u001b[?2004l\r"]
[67.679939, "o", "\u001b[?2004h> "]
[67.679994, "o", "        sse += (yi - lorentzian(xi, *params))**2\r\n\u001b[?2004l\r"]
[67.680016, "o", "\u001b[?2004h> "]
[67.680043, "o", "    return sse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.680066, "o", "\r\n\u001b[?2004l\r"]
[67.680088, "o", "\u001b[?2004h> "]
[67.680146, "o", "def fit_peak(x_data, y_data, center_guess):\r\n\u001b[?2004l\r"]
[67.680171, "o", "\u001b[?2004h> "]
[67.680207, "o", "    # Initial Guess\r\n\u001b[?2004l\r"]
[67.680241, "o", "\u001b[?2004h> "]
[67.680265, "o", "    y_min = min(y_data)\r\n\u001b[?2004l\r"]
[67.680287, "o", "\u001b[?2004h> "]
[67.680314, "o", "    y_max = max(y_data)\r\n\u001b[?2004l\r"]
[67.680343, "o", "\u001b[?2004h> "]
[67.680387, "o", "    # params: [x0, gamma, amplitude, offset]\r\n\u001b[?2004l\r"]
[67.680417, "o", "\u001b[?2004h> "]
[67.680479, "o", "    best_params = [center_guess, 10.0, y_max - y_min, y_min]\r\n\u001b[?2004l\r"]
[67.680501, "o", "\u001b[?2004h> "]
[67.68056, "o", "    best_sse = get_sse(x_data, y_data, best_params)\r\n\u001b[?2004l\r"]
[67.680582, "o", "\u001b[?2004h> "]
[67.680604, "o", "    \r\n\u001b[?2004l\r"]
[67.680626, "o", "\u001b[?2004h> "]
[67.680674, "o", "    # Simple Coordinate Descent Optimizer\r\n\u001b[?2004l\r"]
[67.680707, "o", "\u001b[?2004h> "]
[67.680747, "o", "    step_sizes = [0.5, 1.0, 10.0, 1.0]\r\n\u001b[?2004l\r"]
[67.680768, "o", "\u001b[?2004h> "]
[67.680808, "o", "    for iteration in range(100):\r\n\u001b[?2004l\r"]
[67.680837, "o", "\u001b[?2004h> "]
[67.680859, "o", "        improved = False\r\n\u001b[?2004l\r"]
[67.680889, "o", "\u001b[?2004h> "]
[67.680919, "o", "        for i in range(4):\r\n\u001b[?2004l\r"]
[67.680944, "o", "\u001b[?2004h> "]
[67.680988, "o", "            for direction in [-1, 1]:\r\n\u001b[?2004l\r"]
[67.681016, "o", "\u001b[?2004h> "]
[67.681062, "o", "                new_params = list(best_params)\r\n\u001b[?2004l\r"]
[67.681071, "o", "\u001b[?2004h> "]
[67.681154, "o", "                new_params[i] += direction * step_sizes[i]\r\n\u001b[?2004l\r"]
[67.681188, "o", "\u001b[?2004h> "]
[67.68125, "o", "                new_sse = get_sse(x_data, y_data, new_params)\r\n\u001b[?2004l\r"]
[67.681272, "o", "\u001b[?2004h> "]
[67.681315, "o", "                if new_sse < best_sse:\r\n\u001b[?2004l\r"]
[67.681337, "o", "\u001b[?2004h> "]
[67.681383, "o", "                    best_sse = new_sse\r\n\u001b[?2004l\r"]
[67.681408, "o", "\u001b[?2004h> "]
[67.68146, "o", "                    best_params = new_params\r\n\u001b[?2004l\r"]
[67.681482, "o", "\u001b[?2004h"]
[67.681505, "o", "> "]
[67.681542, "o", "                    improved = True\r\n\u001b[?2004l\r"]
[67.681566, "o", "\u001b[?2004h> "]
[67.681615, "o", "        if not improved:\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.681657, "o", "> "]
[67.681687, "o", "            # Reduce step sizes\r\n\u001b[?2004l\r"]
[67.681717, "o", "\u001b[?2004h> "]
[67.681792, "o", "            step_sizes = [s * 0.5 for s in step_sizes]\r\n\u001b[?2004l\r"]
[67.68181, "o", "\u001b[?2004h> "]
[67.681871, "o", "            if step_sizes[0] < 1e-4:\r\n\u001b[?2004l\r"]
[67.681901, "o", "\u001b[?2004h> "]
[67.681945, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.681971, "o", "> "]
[67.682006, "o", "    return best_params\r\n\u001b[?2004l\r"]
[67.682042, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[67.682081, "o", "> "]
[67.682119, "o", "# Load Data\r\n\u001b[?2004l\r"]
[67.682146, "o", "\u001b[?2004h> "]
[67.682173, "o", "raman_shift = []\r\n\u001b[?2004l\r"]
[67.682205, "o", "\u001b[?2004h> "]
[67.682236, "o", "intensity = []\r\n\u001b[?2004l\r"]
[67.682265, "o", "\u001b[?2004h> "]
[67.682321, "o", "with open('/app/spectrum.csv', 'r') as f:\r\n\u001b[?2004l\r"]
[67.68235, "o", "\u001b[?2004h> "]
[67.682392, "o", "    reader = csv.reader(f)\r\n\u001b[?2004l\r"]
[67.682421, "o", "\u001b[?2004h> "]
[67.682448, "o", "    next(reader)\r\n\u001b[?2004l\r"]
[67.682488, "o", "\u001b[?2004h> "]
[67.682521, "o", "    for row in reader:\r\n\u001b[?2004l\r"]
[67.68255, "o", "\u001b[?2004h> "]
[67.682608, "o", "        raman_shift.append(float(row[0]))\r\n\u001b[?2004l\r"]
[67.682637, "o", "\u001b[?2004h> "]
[67.682694, "o", "        intensity.append(float(row[1]))\r\n\u001b[?2004l\r"]
[67.68275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.682769, "o", "\u001b[?2004h> peaks_info = {\r\n\u001b[?2004l\r"]
[67.682823, "o", "\u001b[?2004h> "]
[67.682861, "o", "    'D': (1350, 1300, 1400),\r\n\u001b[?2004l\r"]
[67.682903, "o", "\u001b[?2004h> "]
[67.682936, "o", "    'G': (1580, 1530, 1630),\r\n\u001b[?2004l\r"]
[67.682965, "o", "\u001b[?2004h> "]
[67.68301, "o", "    '2D': (2690, 2640, 2740)\r\n\u001b[?2004l\r"]
[67.683049, "o", "\u001b[?2004h> }\r\n"]
[67.683068, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.683098, "o", "\u001b[?2004h> "]
[67.683131, "o", "final_results = {}\r\n\u001b[?2004l\r"]
[67.683159, "o", "\u001b[?2004h> "]
[67.683231, "o", "for peak, (center, low, high) in peaks_info.items():\r\n\u001b[?2004l\r"]
[67.68326, "o", "\u001b[?2004h> "]
[67.683334, "o", "    x_fit = [x for x in raman_shift if low <= x <= high]\r\n\u001b[?2004l\r"]
[67.683374, "o", "\u001b[?2004h> "]
[67.683415, "o", "    # Match indices of intensity\r\n\u001b[?2004l\r"]
[67.683448, "o", "\u001b[?2004h> "]
[67.683525, "o", "    # This is a bit inefficient but works for standard library\r\n\u001b[?2004l\r"]
[67.683561, "o", "\u001b[?2004h> "]
[67.683588, "o", "    y_fit = []\r\n\u001b[?2004l\r"]
[67.683616, "o", "\u001b[?2004h> "]
[67.683672, "o", "    for i in range(len(raman_shift)):\r\n\u001b[?2004l\r"]
[67.68371, "o", "\u001b[?2004h> "]
[67.683764, "o", "        if low <= raman_shift[i] <= high:\r\n\u001b[?2004l\r"]
[67.683794, "o", "\u001b[?2004h> "]
[67.68385, "o", "            y_fit.append(intensity[i])\r\n\u001b[?2004l\r"]
[67.683878, "o", "\u001b[?2004h> "]
[67.683909, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.683976, "o", "    popt = fit_peak(x_fit, y_fit, center)\r\n\u001b[?2004l\r"]
[67.684007, "o", "\u001b[?2004h> "]
[67.684049, "o", "    final_results[peak] = {\r\n\u001b[?2004l\r"]
[67.684078, "o", "\u001b[?2004h> "]
[67.684115, "o", "        'x0': popt[0],\r\n\u001b[?2004l\r"]
[67.684144, "o", "\u001b[?2004h> "]
[67.684185, "o", "        'gamma': popt[1],\r\n\u001b[?2004l\r"]
[67.684214, "o", "\u001b[?2004h> "]
[67.684318, "o", "        'amplitude': popt[2],\r\n\u001b[?2004l\r"]
[67.684366, "o", "\u001b[?2004h> "]
[67.684405, "o", "        'offset': popt[3]\r\n\u001b[?2004l\r"]
[67.684449, "o", "\u001b[?2004h> "]
[67.684497, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.684535, "o", "\u001b[?2004h> "]
[67.684628, "o", "final_results['ID_IG'] = final_results['D']['amplitude'] / final_results['G']['amplitude']\r\n\u001b[?2004l\r"]
[67.684658, "o", "\u001b[?2004h> "]
[67.684696, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.684752, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[67.684792, "o", "\u001b[?2004h> "]
[67.684845, "o", "    json.dump(final_results, f, indent=2)\r\n\u001b[?2004l\r"]
[67.684886, "o", "\u001b[?2004h> "]
[67.684916, "o", "EOF\r\n\u001b[?2004l\r"]
