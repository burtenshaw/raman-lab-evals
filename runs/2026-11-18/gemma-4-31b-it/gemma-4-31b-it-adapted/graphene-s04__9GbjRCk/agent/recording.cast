[67.678563, "i", "cat << 'EOF' > /app/fit_raman.py\nimport csv\nimport math\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset\n\ndef get_sse(x_data, y_data, params):\n    sse = 0\n    for xi, yi in zip(x_data, y_data):\n        sse += (yi - lorentzian(xi, *params))**2\n    return sse\n\ndef fit_peak(x_data, y_data, center_guess):\n    # Initial Guess\n    y_min = min(y_data)\n    y_max = max(y_data)\n    # params: [x0, gamma, amplitude, offset]\n    best_params = [center_guess, 10.0, y_max - y_min, y_min]\n    best_sse = get_sse(x_data, y_data, best_params)\n    \n    # Simple Coordinate Descent Optimizer\n    step_sizes = [0.5, 1.0, 10.0, 1.0]\n    for iteration in range(100):\n        improved = False\n        for i in range(4):\n            for direction in [-1, 1]:\n                new_params = list(best_params)\n                new_params[i] += direction * step_sizes[i]\n                new_sse = get_sse(x_data, y_data, new_params)\n                if new_sse < best_s"]
[67.678701, "i", "se:\n                    best_sse = new_sse\n                    best_params = new_params\n                    improved = True\n        if not improved:\n            # Reduce step sizes\n            step_sizes = [s * 0.5 for s in step_sizes]\n            if step_sizes[0] < 1e-4:\n                break\n    return best_params\n\n# Load Data\nraman_shift = []\nintensity = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)\n    for row in reader:\n        raman_shift.append(float(row[0]))\n        intensity.append(float(row[1]))\n\npeaks_info = {\n    'D': (1350, 1300, 1400),\n    'G': (1580, 1530, 1630),\n    '2D': (2690, 2640, 2740)\n}\n\nfinal_results = {}\nfor peak, (center, low, high) in peaks_info.items():\n    x_fit = [x for x in raman_shift if low <= x <= high]\n    # Match indices of intensity\n    # This is a bit inefficient but works for standard library\n    y_fit = []\n    for i in range(len(raman_shift)):\n        if low <= raman_shift[i] <= high:\n            y_fit.append(intensity[i])\n    \n"]
[67.678769, "o", "cat << 'EOF' > /app/fit_raman.py\r\n\u001b[?2004l\rse:\r\n                    best_sse = new_sse\r\n                    bes"]
[67.678823, "i", "    popt = fit_peak(x_fit, y_fit, center)\n    final_results[peak] = {\n        'x0': popt[0],\n        'gamma': popt[1],\n        'amplitude': popt[2],\n        'offset': popt[3]\n    }\n\nfinal_results['ID_IG'] = final_results['D']['amplitude'] / final_results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(final_results, f, indent=2)\nEOF\n"]
[67.678882, "o", "t_params = new_params\r\n                    improved = True\r\n        if not improved:\r\n            # Reduce step sizes\r\n            step_sizes = [s * 0.5 for s in step_sizes]\r\n            if step_sizes[0] < 1e-4:\r\n                break\r\n    return best_params\r\n\r\n# Load Data\r\nraman_shift = []\r\nintensity = []\r\nwith open('/app/spectrum.csv', 'r') as f:\r\n   "]
[67.678914, "o", " reader = csv.reader(f)\r\n    next(reader)\r\n    for row in reader:\r\n    "]
[67.678943, "o", "    raman_shift.append(float(row[0]))\r\n        intensity.append(float(row[1]))\r\n\r\npeaks_info = {\r\n    'D': (1350, 1300, 1400),\r\n    'G': (1580, 1530, 1630),\r\n    "]
[67.678975, "o", "'2D': (2690, 2640, 2740)\r\n}\r\n\r\nfinal_results = {}\r\nfor peak, (center, low, high) in p"]
