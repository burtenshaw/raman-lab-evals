[67.67903, "o", "ntensity\r\n    # This is a bit ineff"]
[67.679056, "o", "icient but works for standard library\r\n    y_fit = []\r\n    for i in range(len(raman_shift)"]
[67.679085, "o", "):\r\n        if low <= raman_shift[i] <= high:\r\n            y_fit.appe"]
[67.679108, "o", "nd(intensity[i])\r\n    \r\n"]
[67.679132, "o", "    popt = fit_peak(x_fit, y_fit, center)\r\n    final_results[peak] = {"]
