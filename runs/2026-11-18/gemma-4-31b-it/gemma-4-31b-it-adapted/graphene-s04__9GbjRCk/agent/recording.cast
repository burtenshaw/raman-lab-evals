[17.11853, "i", "cat << 'EOF' > /app/fit_raman.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': (1350, 1300, 1400), # Center, Low, High\n    'G': (1580, 1530, 1630),\n    '2D': (2690, 2640, 2740)\n}\n\nresults = {}\n\nfor peak, (center, low, high) in peaks.items():\n    mask = (x >= low) & (x <= high)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guess: x0=center, gamma=10, amplitude=max(y)-min(y), offset=min(y)\n    p0 = [center, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[peak] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / r"]
[17.118571, "i", "esults['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
