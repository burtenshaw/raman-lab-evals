[?2004l[?2004h>         
[?2004l[?2004h>         # Reflection
[?2004l[?2004h>         worst = simplex[-1]
[?2004l[?2004h>         reflected = [centroid[i] + 1.0 * (centroid[i] - worst[i]) for i in range(len(guess))]
[?2004l[?2004h>         r_score = objective(reflected, x_data, y_data)
[?2004l[?2004h> 
[?2004l[?2004h>         if scores[0] <= r_score < scores[-2]:
[?2004l[?2004h>             simplex[-1] = reflected
[?2004l[?2004h>             scores[-1] = r_score
[?2004l[?2004h>         elif r_score < scores[0]:
