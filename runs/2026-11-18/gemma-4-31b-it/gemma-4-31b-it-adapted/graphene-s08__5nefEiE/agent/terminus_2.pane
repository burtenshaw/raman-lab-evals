[?2004l[?2004h>         return simplex
[?2004l[?2004h> 
[?2004l[?2004h>     simplex = get_simplex(guess)
[?2004l[?2004h>     scores = [objective(p, x_data, y_data) for p in simplex]
[?2004l[?2004h> 
[?2004l[?2004h>     for _ in range(500):
[?2004l[?2004h>         # Sort simplex by scores
[?2004l[?2004h>         combined = sorted(zip(scores, simplex), key=lambda x: x[0])
[?2004l[?2004h>         scores = [c[0] for c in combined]
[?2004l[?2004h>         simplex = [c[1] for c in combined]
[?2004l[?2004h> 
[?2004l[?2004h>         # Centroid
