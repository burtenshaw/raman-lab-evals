[52.700347, "i", "cat << 'EOF' > fit_raman.py\nimport csv\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data using csv module\nx = []\ny = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)  # skip header\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\nx = np.array(x)\ny = np.array(y)\n\npeaks = {\n    'D': {'range': (1300, 1400), 'guess': [1350, 20, 1000, 900]},\n    'G': {'range': (1530, 1630), 'guess': [1580, 20, 1000, 900]},\n    '2D': {'range': (2630, 2750), 'guess': [2690, 30, 1000, 900]}\n}\n\nresults = {}\n\nfor peak, params in peaks.items():\n    mask = (x >= params['range'][0]) & (x <= params['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=params['guess'])\n    \n    results[peak] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n   "]
[52.700472, "i", "     'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Calculate ID_IG ratio (amplitude of D / amplitude of G)\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Fitting complete and results saved to /app/results.json\")\nEOF\n"]
