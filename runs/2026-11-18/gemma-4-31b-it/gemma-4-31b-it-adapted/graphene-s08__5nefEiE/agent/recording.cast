[110.959003, "o", "\u001b[?2004h"]
[110.959086, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.959141, "o", "> "]
[110.959195, "o", "    simplex = get_simplex(guess)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.959308, "o", "    scores = [objective(p, x_data, y_data) for p in simplex]\r\n\u001b[?2004l\r"]
[110.959365, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.959403, "o", "> "]
[110.959444, "o", "    for _ in range(500):\r\n\u001b[?2004l\r"]
[110.959553, "o", "\u001b[?2004h"]
[110.959625, "o", "> "]
[110.959639, "o", "        # Sort simplex by scores\r\n\u001b[?2004l\r"]
[110.959728, "o", "\u001b[?2004h"]
[110.959747, "o", "> "]
[110.959901, "o", "        combined = sorted(zip(scores, simplex), key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[110.959949, "o", "\u001b[?2004h"]
[110.959988, "o", "> "]
[110.960081, "o", "        scores = [c[0] for c in combined]\r\n\u001b[?2004l\r"]
[110.960125, "o", "\u001b[?2004h> "]
[110.960217, "o", "        simplex = [c[1] for c in combined]\r\n\u001b[?2004l\r"]
[110.960273, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.960365, "o", "\u001b[?2004h> "]
[110.960427, "o", "        # Centroid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.960524, "o", "        centroid = [sum(p[i] for p in simplex[:-1]) / (len(simplex)-1) for i in range(len(guess))]\r\n\u001b[?2004l\r"]
[110.960576, "o", "\u001b[?2004h> "]
[110.960624, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.960689, "o", "        # Reflection\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.960752, "o", "        worst = simplex[-1]"]
[110.960841, "o", "\r\n\u001b[?2004l\r"]
[110.960857, "o", "\u001b[?2004h"]
[110.960932, "o", "> "]
[110.961128, "o", "        reflected = [centroid[i] + 1.0 * (centroid[i] - worst[i]) for i in range(len(guess))]\r\n\u001b[?2004l\r"]
[110.961161, "o", "\u001b[?2004h> "]
[110.961296, "o", "        r_score = objective(reflected, x_data, y_data)\r\n\u001b[?2004l\r"]
[110.961427, "o", "\u001b[?2004h> "]
[110.961596, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         if scores[0] <= r_score < scores[-2]:"]
[110.961649, "o", "\r\n"]
[110.961702, "o", "\u001b[?2004l\r"]
[110.961746, "o", "\u001b[?2004h"]
[110.961913, "o", ">             simplex[-1] = reflected"]
[110.961943, "o", "\r\n"]
[110.961992, "o", "\u001b[?2004l\r"]
[110.962117, "o", "\u001b[?2004h> "]
[110.962211, "o", "            scores[-1] = r_score\r\n\u001b[?2004l\r"]
[110.962267, "o", "\u001b[?2004h> "]
[110.962378, "o", "        elif r_score < scores[0]:\r\n"]
[110.962389, "o", "\u001b[?2004l\r"]
[110.963655, "o", "\u001b[?2004h>             # Expansion\r\n\u001b[?2004l\r\u001b[?2004h>             expanded = [centroid[i] + 2.0 * (reflected[i] - centroid[i]) for i in range(len(guess))]\r\n\u001b[?2004l\r\u001b[?2004h>             e_score = objective(expanded, x_data, y_data)\r\n\u001b[?2004l\r\u001b[?2004h>             if e_score < r_score:\r\n\u001b[?2004l\r\u001b[?2004h>                 simplex[-1] = expanded\r\n\u001b[?2004l\r\u001b[?2004h>                 scores[-1] = e_score\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 simplex[-1] = reflected\r\n\u001b[?2004l\r\u001b[?2004h>                 scores[-1] = r_score\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             # Contraction\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.963676, "o", "            contracted = [centroid[i] + 0.5 * (worst[i] - centroid[i]) for i in range(len(guess))]\r\n"]
[110.963945, "o", "\u001b[?2004l\r"]
[110.964006, "o", "\u001b[?2004h"]
[110.964037, "o", "> "]
[110.964173, "o", "            c_score = objective(contracted, x_data, y_data)"]
[110.964262, "o", "\r\n"]
[110.964582, "o", "\u001b[?2004l\r"]
[110.964685, "o", "\u001b[?2004h"]
[110.964829, "o", "> "]
[110.964958, "o", "            if c_score < scores[-1]:\r\n\u001b[?2004l\r"]
[110.96498, "o", "\u001b[?2004h>                 simplex[-1] = contracted\r\n\u001b[?2004l\r"]
[110.965054, "o", "\u001b[?2004h> "]
[110.965109, "o", "                scores[-1] = c_score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.965153, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.965221, "o", "                # Shrink\r\n\u001b[?2004l\r"]
[110.965255, "o", "\u001b[?2004h> "]
[110.965347, "o", "                for i in range(1, len(simplex)):\r\n\u001b[?2004l\r"]
[110.965388, "o", "\u001b[?2004h> "]
[110.965586, "o", "                    simplex[i] = [simplex[0][j] + 0.5 * (simplex[i][j] - simplex[0][j]) for j in range(len(guess))]\r\n\u001b[?2004l\r"]
[110.965641, "o", "\u001b[?2004h> "]
[110.965743, "o", "                    scores[i] = objective(simplex[i], x_data, y_data)\r\n\u001b[?2004l\r"]
[110.965797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.965849, "o", "\u001b[?2004h> "]
[110.965897, "o", "    return simplex[0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.965943, "o", "\u001b[?2004h> # Load data\r\n\u001b[?2004l\r"]
[110.965992, "o", "\u001b[?2004h> x = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.966008, "o", "y = []\r\n\u001b[?2004l\r"]
[110.966112, "o", "\u001b[?2004h> "]
[110.969018, "o", "with open('/app/spectrum.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.reader(f)\r\n\u001b[?2004l\r\u001b[?2004h>     next(reader)\r\n\u001b[?2004l\r\u001b[?2004h>     for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h>         x.append(float(row[0]))\r\n\u001b[?2004l\r\u001b[?2004h>         y.append(float(row[1]))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> peaks_config = {\r\n\u001b[?2004l\r\u001b[?2004h>     'D': {'range': (1300, 1400), 'guess': [1350.0, 20.0, 1000.0, 900.0]},\r\n\u001b[?2004l\r\u001b[?2004h>     'G': {'range': (1530, 1630), 'guess': [1580.0, 20.0, 1000.0, 900.0]},\r\n\u001b[?2004l\r\u001b[?2004h>     '2D': {'range': (2630, 2750), 'guess': [2690.0, 30.0, 1000.0, 900.0]}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = {}\r\n\u001b[?2004l\r\u001b[?2004h> for peak, config in peaks_config.items():\r\n\u001b[?2004l\r\u001b[?2004h>     x_fit = [xi for xi in x if config['range'][0] <= xi <= config['range'][1]]\r\n\u001b[?2004l\r\u001b[?2004h>     y_fit = [yi for xi, yi in zip(x, y) if config['range'][0] <= xi <= config['range'][1]]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     best_params = "]
[110.96914, "o", "fit_peak(x_fit, y_fit, config['guess'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     results[peak] = {\r\n\u001b[?2004l\r\u001b[?2004h>         'x0': best_params[0],\r\n\u001b[?2004l\r\u001b[?2004h>         'gamma': best_params[1],\r\n\u001b[?2004l\r\u001b[?2004h>         'amplitude': best_params[2],\r\n\u001b[?2004l\r\u001b[?2004h>         'offset': best_params[3]\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Fitting complete\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
