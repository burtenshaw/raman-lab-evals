[?2004hroot@j-openenv-6afd8781884144d2f44fd419-1l50answ-14495-kp7hk:/app# cat << 'EOF' > /app/fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {'D': 1350, 'G': 1580, '2D': 2690}
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for peak_name, center in peaks.items():
[?2004l[?2004h>     # Filter data for the specific peak region (+/- 50 cm-1)
[?2004l[?2004h>     mask = (x > center - 50) & (x < center + 50)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guess: x0=center, gamma=10, amp=max(y)-min(y), offset=min(y)
[?2004l[?2004h>     p0 = [center, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     x0, gamma, amplitude, offset = popt
[?2004l[?2004h>     
[?2004l[?2004h>     results[peak_name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amplitude),
[?2004l[?2004h>         'offset': float(offset)
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> EOF
