[21.058208, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[21.060097, "o", "raman_shift_cm-1,intensity\r\n1100.0000,1018.716\r\n1100.5001,1054.576\r\n1101.0003,963.467\r\n1101.5004,965.532\r\n"]
[21.060198, "o", "\u001b[?2004h"]
[21.060266, "o", "root@j-openenv-6afd8781884144d2f44fd419-1l50answ-14495-kp7hk:/app# "]
[37.871569, "i", "cat << 'EOF' > /app/fit_raman.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\npeaks = {'D': 1350, 'G': 1580, '2D': 2690}\nresults = {}\n\nfor peak_name, center in peaks.items():\n    # Filter data for the specific peak region (+/- 50 cm-1)\n    mask = (x > center - 50) & (x < center + 50)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guess: x0=center, gamma=10, amp=max(y)-min(y), offset=min(y)\n    p0 = [center, 10, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    x0, gamma, amplitude, offset = popt\n    \n    results[peak_name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amplitude),\n        'offset': float(offset)\n    }\n\nresults['ID_IG'] = results"]
[37.871708, "i", "['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nEOF\n"]
