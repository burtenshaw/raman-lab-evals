[8.469463, "i", "head -n 5 /app/spectrum.csv\n"]
[8.469636, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[8.471366, "o", "raman_shift_cm-1,intensity\r\n1100.0000,954.992\r\n1100.5001,989.534\r\n1101.0003,1110.132\r\n1101.5004,1024.330\r\n"]
[8.471512, "o", "\u001b[?2004hroot@j-openenv-6afd88e2e5cad0e4dc3e6939-m4sgin4f-94625-7x4pg:/app# "]
[23.881454, "i", "cat << 'EOF' > fit_raman.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\n# Peak regions (center, width)\npeaks = {\n    'D': (1350, 100),\n    'G': (1580, 100),\n    '2D': (2690, 200)\n}\n\nresults = {}\n\nfor name, (center, width) in peaks.items():\n    # Mask data to only include the region around the peak\n    mask = (x > center - width) & (x < center + width)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses\n    # amplitude: max intensity - min intensity in range\n    # gamma: typical Raman width ~10-30\n    # x0: center\n    # offset: min intensity in range\n    p0 = [np.max(y_fit) - np.min(y_fit), 20, center, np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    amplitude, gamma, x0, offset = popt\n    \n   "]
[23.881613, "i", " results[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amplitude),\n        'offset': float(offset)\n    }\n\n# Calculate ID/IG ratio\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Fitting complete. Results saved to /app/results.json\")\nEOF\n"]
