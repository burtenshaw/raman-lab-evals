[?2004l[H[J[3J[?2004hroot@j-openenv-6afd88e2e5cad0e4dc3e6939-m4sgin4f-94625-7x4pg:/app# head -n 5 /app/spectrum.csv
[?2004lraman_shift_cm-1,intensity
1100.0000,954.992
1100.5001,989.534
1101.0003,1110.132
1101.5004,1024.330
[?2004hroot@j-openenv-6afd88e2e5cad0e4dc3e6939-m4sgin4f-94625-7x4pg:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Peak regions (center, width)
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': (1350, 100),
[?2004l[?2004h>     'G': (1580, 100),
[?2004l[?2004h>     '2D': (2690, 200)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, (center, width) in peaks.items():
[?2004l[?2004h>     # Mask data to only include the region around the peak
[?2004l[?2004h>     mask = (x > center - width) & (x < center + width)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses
[?2004l[?2004h>     # amplitude: max intensity - min intensity in range
[?2004l[?2004h>     # gamma: typical Raman width ~10-30
[?2004l[?2004h>     # x0: center
[?2004l[?2004h>     # offset: min intensity in range
[?2004l[?2004h>     p0 = [np.max(y_fit) - np.min(y_fit), 20, center, np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>     amplitude, gamma, x0, offset = popt
[?2004l[?2004h>     
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amplitude),
[?2004l[?2004h>         'offset': float(offset)
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate ID/IG ratio
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Fitting complete. Results saved to /app/results.json")
[?2004l[?2004h> EOF
