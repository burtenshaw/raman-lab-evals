[4.947893, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[4.949585, "o", "raman_shift_cm-1,intensity\r\n1100.0000,768.701\r\n1100.5001,941.867\r\n1101.0003,726.939\r\n1101.5004,816.841\r\n"]
[4.949734, "o", "\u001b[?2004hroot@j-openenv-6afd8781884144d2f44fd41f-svvq9y0p-887dc-btnzb:/app# "]
[53.993495, "i", "cat << 'EOF' > fit_spectrum.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'center': 1350, 'window': 100},\n    'G': {'center': 1580, 'window': 100},\n    '2D': {'center': 2690, 'window': 100}\n}\n\nresults = {}\nfor peak, params in peaks.items():\n    mask = (x > params['center'] - params['window']) & (x < params['center'] + params['window'])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    p0 = [params['center'], 20, np.max(y_fit) - np.min(y_fit), np.min(y_fit)]\n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[peak] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['ampl"]
[53.993618, "i", "itude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
