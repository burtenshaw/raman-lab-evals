[?2004h> import json
[?2004l[?2004h> import math
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * (gamma**2) / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_sse(x_data, y_data, params):
[?2004l[?2004h>     x0, gamma, amplitude, offset = params
[?2004l[?2004h>     sse = 0
[?2004l[?2004h>     for x, y in zip(x_data, y_data):
[?2004l[?2004h>         sse += (y - lorentzian(x, x0, gamma, amplitude, offset))**2
[?2004l[?2004h>     return sse
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x_data, y_data, start_x0):
[?2004l[?2004h>     # Simple coordinate descent / grid search hybrid for initial guess
[?2004l[?2004h>     # Params: x0, gamma, amplitude, offset
[?2004l[?2004h>     best_params = [start_x0, 10.0, 100.0, min(y_data)]
[?2004l[?2004h>     best_sse = calculate_sse(x_data, y_data, best_params)
[?2004l[?2004h>     
[?2004l[?2004h>     # Heuristic to improve amplitude guess
[?2004l[?2004h>     best_params[2] = max(y_data) - min(y_data)
[?2004l[?2004h>     best_sse = calculate_sse(x_data, y_data, best_params)
[?2004l[?2004h> 
[?2004l[?2004h>     # Simple iterative refinement (Coordinate Descent)
[?2004l[?2004h>     step_sizes = [0.1, 0.1, 1.0, 0.1]
[?2004l[?2004h>     for _ in range(100):
[?2004l[?2004h>         improved = False
[?2004l[?2004h>         for i in range(4):
[?2004l[?2004h>             for direction in [-1, 1]:
[?2004l[?2004h>                 test_params = list(best_params)
[?2004l[?2004h>                 test_params[i] += direction * step_sizes[i]
[?2004l[?2004h>                 sse = calculate_sse(x_data, y_data, test_params)
[?2004l[?2004h>                 if sse < best_sse:
[?2004l[?2004h>                     best_sse = sse
[?2004l[?2004h>                     best_params = test_params
[?2004l[?2004h>                     improved = True
[?2004l[?2004h>         if not improved:
[?2004l[?2004h>             # Reduce step sizes and try again
[?2004l[?2004h>             step_sizes = [s * 0.5 for s in step_sizes]
[?2004l[?2004h>             if step_sizes[0] < 1e-4:
[?2004l[?2004h>                 break
[?2004l[?2004h>     
[?2004l[?2004h>     return best_params
[?2004l[?2004h> 
