[78.795636, "i", "cat << 'EOF' > fit_raman.py\nimport csv\nimport math\nimport json\n\ndef lorentzian(x, x0, gamma, amp, offset):\n    return amp * (gamma**2) / ((x - x0)**2 + gamma**2) + offset\n\ndef get_residuals(x_data, y_data, params):\n    x0, gamma, amp, offset = params\n    return [y_data[i] - lorentzian(x_data[i], x0, gamma, amp, offset) for i in range(len(x_data))]\n\ndef get_jacobian(x_data, y_data, params):\n    x0, gamma, amp, offset = params\n    jac = []\n    for x in x_data:\n        diff = x - x0\n        denom = diff**2 + gamma**2\n        # dI/dx0\n        dfdx0 = amp * gamma**2 * (2 * diff) / (denom**2)\n        # dI/dgamma\n        dfdgamma = amp * (2 * gamma * denom - 2 * gamma * gamma**2) / (denom**2)\n        # dI/damp\n        dfdamp = gamma**2 / denom\n        # dI/doffset\n        dfdoffset = 1.0\n        jac.append([dfdx0, dfdgamma, dfdamp, dfdoffset])\n    return jac\n\ndef solve_linear(A, b):\n    # Solves Ax = b for 4x4 using Gaussian elimination\n    n = len(b)\n    for i in range(n):\n        max_row = i\n        for k in range"]
[78.795757, "i", "(i+1, n):\n            if abs(A[k][i]) > abs(A[max_row][i]):\n                max_row = k\n        A[i], A[max_row] = A[max_row], A[i]\n        b[i], b[max_row] = b[max_row], b[i]\n\n        for k in range(i+1, n):\n            c = -A[k][i] / A[i][i]\n            for j in range(i, n):\n                if i == j:\n                    A[k][j] = 0\n                else:\n                    A[k][j] += c * A[i][j]\n            b[k] += c * b[i]\n\n    x = [0 for _ in range(n)]\n    for i in range(n-1, -1, -1):\n        x[i] = (b[i] - sum(A[i][j] * x[j] for j in range(i+1, n))) / A[i][i]\n    return x\n\ndef fit_peak(x_data, y_data, x0_init, gamma_init):\n    # Initial guess: x0, gamma, amplitude, offset\n    amp_init = max(y_data) - min(y_data)\n    offset_init = min(y_data)\n    params = [x0_init, gamma_init, amp_init, offset_init]\n\n    for iteration in range(50):\n        res = get_residuals(x_data, y_data, params)\n        jac = get_jacobian(x_data, y_data, params)\n        \n        # Construct Normal Equations: (J^T J) delta = J^T res\n "]
[78.795804, "o", "cat << 'EOF' > fit_raman.py\r\n\u001b[?2004l\r"]
[78.795849, "i", "       JTJ = [[0.0]*4 for _ in range(4)]\n        JTr = [0.0]*4\n        for i in range(len(x_data)):\n            for r in range(4):\n                for c in range(4):\n                    JTJ[r][c] += jac[i][r] * jac[i][c]\n                JTr[r] += jac[i][r] * res[i]\n        \n        try:\n            delta = solve_linear(JTJ, JTr)\n        except ZeroDivisionError:\n            break\n            \n        params = [params[i] + delta[i] for i in range(4)]\n        if sum(abs(d) for d in delta) < 1e-6:\n            break\n    return params\n\n# Load data\nx_all = []\ny_all = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)\n    for row in reader:\n        x_all.append(float(row[0]))\n        y_all.append(float(row[1]))\n\npeaks_config = {\n    'D': {'x0': 1350, 'gamma': 20, 'range': (1200, 1450)},\n    'G': {'x0': 1580, 'gamma': 20, 'range': (1500, 1650)},\n    '2D': {'x0': 2690, 'gamma': 40, 'range': (2600, 2800)}\n}\n\nresults = {}\nfor name, conf in peaks_config.items():\n    x_fit = [x for x "]
[78.795892, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r       JTJ = [[0.0]*4 for _ in range(4)]\r\n        JTr = [0.0]*4\r\n        for "]
[78.795933, "i", "in x_all if conf['range'][0] <= x <= conf['range'][1]]\n    y_fit = [y for x, y in zip(x_all, y_all) if conf['range'][0] <= x <= conf['range'][1]]\n    \n    popt = fit_peak(x_fit, y_fit, conf['x0'], conf['gamma'])\n    results[name] = {\n        'x0': popt[0],\n        'gamma': popt[1],\n        'amplitude': popt[2],\n        'offset': popt[3]\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
