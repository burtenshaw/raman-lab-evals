[20.34352, "i", "cat << 'EOF' > fit_raman.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'x0': 1350, 'gamma': 20, 'amplitude': np.max(y), 'offset': np.min(y), 'range': (1200, 1450)},\n    'G': {'x0': 1580, 'gamma': 20, 'amplitude': np.max(y), 'offset': np.min(y), 'range': (1500, 1650)},\n    '2D': {'x0': 2690, 'gamma': 40, 'amplitude': np.max(y), 'offset': np.min(y), 'range': (2600, 2800)}\n}\n\nresults = {}\nfor name, params in peaks.items():\n    mask = (x >= params['range'][0]) & (x <= params['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Improve initial guess for amplitude and offset based on local window\n    local_max = np.max(y_fit)\n    local_min = np.min(y_fit)\n    p0 = [params['x0'], params['gamma'], local_max - local_"]
[20.343663, "i", "min, local_min]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    results[name] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results saved to /app/results.json')\nEOF\n"]
