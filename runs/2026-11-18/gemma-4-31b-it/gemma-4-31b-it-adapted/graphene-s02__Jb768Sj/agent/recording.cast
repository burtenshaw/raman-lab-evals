[40.131794, "i", "cat << 'EOF' > fit_raman.py\nimport csv\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data using csv module\nx = []\ny = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)  # skip header\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\nx = np.array(x)\ny = np.array(y)\n\npeaks = {\n    'D': {'x0': 1350, 'gamma': 20, 'range': (1200, 1450)},\n    'G': {'x0': 1580, 'gamma': 20, 'range': (1500, 1650)},\n    '2D': {'x0': 2690, 'gamma': 40, 'range': (2600, 2800)}\n}\n\nresults = {}\nfor name, params in peaks.items():\n    mask = (x >= params['range'][0]) & (x <= params['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    local_max = np.max(y_fit)\n    local_min = np.min(y_fit)\n    p0 = [params['x0'], params['gamma'], local_max - local_min, local_min]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_"]
[40.13197, "i", "fit, p0=p0)\n    results[name] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Fitting complete. Results saved to /app/results.json')\nEOF\n"]
