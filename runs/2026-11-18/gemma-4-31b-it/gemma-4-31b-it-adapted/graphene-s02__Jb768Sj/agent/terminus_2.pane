[?2004h> import math
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amp, offset):
[?2004l[?2004h>     return amp * (gamma**2) / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def get_residuals(x_data, y_data, params):
[?2004l[?2004h>     x0, gamma, amp, offset = params
[?2004l[?2004h>     return [y_data[i] - lorentzian(x_data[i], x0, gamma, amp, offset) for i in range(len(x_data))]
[?2004l[?2004h> 
[?2004l[?2004h> def get_jacobian(x_data, y_data, params):
[?2004l[?2004h>     x0, gamma, amp, offset = params
[?2004l[?2004h>     jac = []
[?2004l[?2004h>     for x in x_data:
[?2004l[?2004h>         diff = x - x0
[?2004l[?2004h>         denom = diff**2 + gamma**2
[?2004l[?2004h>         # dI/dx0
[?2004l[?2004h>         dfdx0 = amp * gamma**2 * (2 * diff) / (denom**2)
[?2004l[?2004h>         # dI/dgamma
[?2004l[?2004h>         dfdgamma = amp * (2 * gamma * denom - 2 * gamma * gamma**2) / (denom**2)
[?2004l[?2004h>         # dI/damp
[?2004l[?2004h>         dfdamp = gamma**2 / denom
[?2004l[?2004h>         # dI/doffset
[?2004l[?2004h>         dfdoffset = 1.0
[?2004l[?2004h>         jac.append([dfdx0, dfdgamma, dfdamp, dfdoffset])
[?2004l[?2004h>     return jac
[?2004l[?2004h> 
[?2004l[?2004h> def solve_linear(A, b):
[?2004l[?2004h>     # Solves Ax = b for 4x4 using Gaussian elimination
[?2004l[?2004h>     n = len(b)
[?2004l[?2004h>     for i in range(n):
[?2004l[?2004h>         max_row = i
[?2004l[?2004h>         for k in range(i+1, n):
[?2004l[?2004h>             if abs(A[k][i]) > abs(A[max_row][i]):
[?2004l[?2004h>                 max_row = k
[?2004l[?2004h>         A[i], A[max_row] = A[max_row], A[i]
[?2004l[?2004h>         b[i], b[max_row] = b[max_row], b[i]
[?2004l[?2004h> 
[?2004l[?2004h>         for k in range(i+1, n):
[?2004l[?2004h>             c = -A[k][i] / A[i][i]
[?2004l[?2004h>             for j in range(i, n):
[?2004l[?2004h>                 if i == j:
[?2004l[?2004h>                     A[k][j] = 0
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     A[k][j] += c * A[i][j]
[?2004l[?2004h>             b[k] += c * b[i]
[?2004l[?2004h> 
[?2004l[?2004h>     x = [0 for _ in range(n)]
[?2004l[?2004h>     for i in range(n-1, -1, -1):
[?2004l[?2004h>         x[i] = (b[i] - sum(A[i][j] * x[j] for j in range(i+1, n))) / A[i][i]
[?2004l[?2004h>     return x
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x_data, y_data, x0_init, gamma_init):
[?2004l[?2004h>     # Initial guess: x0, gamma, amplitude, offset
[?2004l[?2004h>     amp_init = max(y_data) - min(y_data)
[?2004l[?2004h>     offset_init = min(y_data)
[?2004l[?2004h>     params = [x0_init, gamma_init, amp_init, offset_init]
[?2004l[?2004h> 
[?2004l[?2004h>     for iteration in range(50):
[?2004l[?2004h>         res = get_residuals(x_data, y_data, params)
[?2004l[?2004h>         jac = get_jacobian(x_data, y_data, params)
[?2004l[?2004h>         
[?2004l[?2004h>         # Construct Normal Equations: (J^T J) delta = J^T res
[?2004l[?2004h>         JTJ = [[0.0]*4 for _ in range(4)]
[?2004l[?2004h>         JTr = [0.0]*4
[?2004l[?2004h>         for i in range(len(x_data)):
[?2004l[?2004h>             for r in range(4):
[?2004l[?2004h>                 for c in range(4):
[?2004l[?2004h>                     JTJ[r][c] += jac[i][r] * jac[i][c]
[?2004l[?2004h>                 JTr[r] += jac[i][r] * res[i]
[?2004l[?2004h>         
[?2004l[?2004h>         try:
[?2004l[?2004h>             delta = solve_linear(JTJ, JTr)
[?2004l[?2004h>         except ZeroDivisionError:
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>         params = [params[i] + delta[i] for i in range(4)]
[?2004l[?2004h>         if sum(abs(d) for d in delta) < 1e-6:
[?2004l[?2004h>             break
[?2004l[?2004h>     return params
[?2004l[?2004h> 
