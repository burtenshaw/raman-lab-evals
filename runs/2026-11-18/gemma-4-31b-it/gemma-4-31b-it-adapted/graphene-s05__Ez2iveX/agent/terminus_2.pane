[?2004hroot@j-openenv-6afd886c4643bac7ac634e53-lm2nzsgr-f2caa-49r6q:/app# cat << 'EOF' > fit_peaks.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks_config = {
[?2004l[?2004h>     'D': {'center': 1350, 'window': 100},
[?2004l[?2004h>     'G': {'center': 1580, 'window': 100},
[?2004l[?2004h>     '2D': {'center': 2690, 'window': 100}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for peak_name, config in peaks_config.items():
[?2004l[?2004h>     mask = (x >= config['center'] - config['window']) & (x <= config['center'] + config['window'])
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Estimate initial parameters
[?2004l[?2004h>     # amplitude: peak height - baseline
[?2004l[?2004h>     # gamma: typical half-width at half-max
[?2004l[?2004h>     # x0: peak center
[?2004l[?2004h>     # offset: baseline
[?2004l[?2004h>     p0 = [np.max(y_fit) - np.min(y_fit), 20.0, config['center'], np.min(y_fit)]
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>         amplitude, gamma, x0, offset = popt
[?2004l[?2004h>         results[peak_name] = {
[?2004l[?2004h>             'x0': float(x0),
[?2004l[?2004h>             'gamma': float(gamma),
[?2004l[?2004h>             'amplitude': float(amplitude),
[?2004l[?2004h>             'offset': float(offset)
[?2004l[?2004h>         }
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'Error fitting {peak_name}: {e}')
[?2004l[?2004h> 
[?2004l[?2004h> if 'D' in results and 'G' in results:
[?2004l[?2004h>     results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Fitting complete. Results written to /app/results.json')
[?2004l[?2004h> EOF
