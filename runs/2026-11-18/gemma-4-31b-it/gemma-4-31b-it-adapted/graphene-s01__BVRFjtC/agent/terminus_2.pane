[?2004hroot@j-openenv-6afd87814643bac7ac634db8-t1p1k2s8-aa13c-dvvl4:/app# cat << 'EOF' > /app/fit_spectrum.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/app/spectrum.csv')
[?2004l[?2004h> x = df['raman_shift_cm-1'].values
[?2004l[?2004h> y = df['intensity'].values
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': {'center': 1350, 'window': 100},
[?2004l[?2004h>     'G': {'center': 1580, 'window': 100},
[?2004l[?2004h>     '2D': {'center': 2690, 'window': 150}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, params in peaks.items():
[?2004l[?2004h>     # Define window for the peak
[?2004l[?2004h>     mask = (x > params['center'] - params['window']) & (x < params['center'] + params['window'])
[?2004l[?2004h>     x_win = x[mask]
[?2004l[?2004h>     y_win = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses
[?2004l[?2004h>     # amplitude = max(y_win) - min(y_win), gamma = 10, x0 = params['center'], offset = min(y_win)
[?2004l[?2004h>     p0 = [params['center'], 10, np.max(y_win) - np.min(y_win), np.min(y_win)]
[?2004l[?2004h>     
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, x_win, y_win, p0=p0)
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'amplitude': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3])
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Defect ratio ID/IG
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> EOF
