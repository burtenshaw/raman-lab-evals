[51.019587, "i", "cat << 'EOF' > /app/fit_spectrum.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'center': 1350, 'window': 100},\n    'G': {'center': 1580, 'window': 100},\n    '2D': {'center': 2690, 'window': 150}\n}\n\nresults = {}\n\nfor name, params in peaks.items():\n    # Define window for the peak\n    mask = (x > params['center'] - params['window']) & (x < params['center'] + params['window'])\n    x_win = x[mask]\n    y_win = y[mask]\n    \n    # Initial guesses\n    # amplitude = max(y_win) - min(y_win), gamma = 10, x0 = params['center'], offset = min(y_win)\n    p0 = [params['center'], 10, np.max(y_win) - np.min(y_win), np.min(y_win)]\n    \n    popt, _ = curve_fit(lorentzian, x_win, y_win, p0=p0)\n    results[name] = {\n        'x0': float(popt"]
[51.020198, "o", "cat << 'EOF' > /app/fit_spectrum.py"]
[51.020239, "i", "[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\n# Defect ratio ID/IG\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
