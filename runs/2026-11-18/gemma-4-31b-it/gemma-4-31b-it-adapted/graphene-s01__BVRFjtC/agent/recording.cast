[74.850776, "i", "cat << 'EOF' > /app/fit_spectrum.py\nimport csv\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data using csv module\nx = []\ny = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)  # Skip header\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\nx = np.array(x)\ny = np.array(y)\n\npeaks = {\n    'D': {'center': 1350, 'window': 100},\n    'G': {'center': 1580, 'window': 100},\n    '2D': {'center': 2690, 'window': 150}\n}\n\nresults = {}\n\nfor name, params in peaks.items():\n    mask = (x > params['center'] - params['window']) & (x < params['center'] + params['window'])\n    x_win = x[mask]\n    y_win = y[mask]\n    \n    p0 = [params['center'], 10, np.max(y_win) - np.min(y_win), np.min(y_win)]\n    \n    popt, _ = curve_fit(lorentzian, x_win, y_win, p0=p0)\n    results[name] = {\n        'x0': float(popt[0]),\n   "]
[74.851023, "o", "cat << 'EOF' > /app/fit_spectrum.py"]
[74.851168, "i", "     'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
