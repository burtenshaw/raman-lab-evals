[36.271053, "o", "head -n 5 /app/spectrum.csv\r\n\u001b[?2004l\r"]
[36.272812, "o", "raman_shift_cm-1,intensity\r\n1100.0000,814.711\r\n1100.5001,823.937\r\n1101.0003,835.751\r\n1101.5004,907.570\r\n"]
[36.27299, "o", "\u001b[?2004hroot@j-openenv-6afd8875884144d2f44fd4a4-zcl3jts0-508d9-56264:/app# "]
[36.36697, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = pd.read_csv('/app/spectrum.csv')\nx = data['raman_shift_cm-1'].values\ny = data['intensity'].values\n\npeaks = {\n    'D':  {'center': 1350, 'width': 100},\n    'G':  {'center': 1580, 'width': 100},\n    '2D': {'center': 2690, 'width': 150}\n}\n\nresults = {}\n\nfor peak_name, params in peaks.items():\n    center = params['center']\n    width = params['width']\n    \n    # Mask data for the peak region\n    mask = (x > center - width) & (x < center + width)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guess: [amplitude, gamma, x0, offset]\n    # amplitude ~ peak height - min(y)\n    # gamma ~ estimated HWHM\n    # x0 ~ center\n    # offset ~ min(y)\n    initial_guess = [np.max(y_fit) - np.min(y_fit), 20, center, np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit"]
[36.367125, "i", ", p0=initial_guess)\n    \n    results[peak_name] = {\n        'amplitude': float(popt[0]),\n        'gamma': float(popt[1]),\n        'x0': float(popt[2]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Fitting complete. Results saved to /app/results.json\")\nEOF\n"]
[36.367238, "o", "cat << 'EOF' > fit_raman.py\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
