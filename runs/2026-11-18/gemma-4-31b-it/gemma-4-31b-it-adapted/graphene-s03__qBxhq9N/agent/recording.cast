[0.926812, "o", "\u001b[?2004h"]
[0.926858, "o", "root@j-openenv-6afd8781884144d2f44fd41a-ug7kii7m-2ab26-rb5qs:/app# "]
[19.436693, "i", "cat << 'EOF' > /app/fit_raman.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'center': 1350, 'range': (1200, 1500)},\n    'G': {'center': 1580, 'range': (1450, 1700)},\n    '2D': {'center': 2690, 'range': (2500, 2800)}\n}\n\nresults = {}\n\nfor peak_name, params in peaks.items():\n    # Mask data to the peak region\n    mask = (x >= params['range'][0]) & (x <= params['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guess: amplitude=max(y)-min(y), gamma=10, x0=center, offset=min(y)\n    p0 = [np.max(y_fit) - np.min(y_fit), 10, params['center'], np.min(y_fit)]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n    amplitude, gamma, x0, offset = popt\n    results[peak_name] = {\"x0\": x0, \"gamma\": gamm"]
[19.43686, "i", "a, \"amplitude\": amplitude, \"offset\": offset}\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
