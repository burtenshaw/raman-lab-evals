[33.96112, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\nimport csv\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nx = []\ny = []\nwith open('/app/spectrum.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader) # skip header\n    for row in reader:\n        x.append(float(row[0]))\n        y.append(float(row[1]))\n\nx = np.array(x)\ny = np.array(y)\n\npeaks = {\n    'D': {'range': (1300, 1400), 'guess': [500, 10, 1350, 1300]},\n    'G': {'range': (1550, 1620), 'guess': [500, 10, 1580, 1300]},\n    '2D': {'range': (2650, 2750), 'guess': [500, 10, 2690, 1300]}\n}\n\nresults = {}\nfor peak, params in peaks.items():\n    mask = (x >= params['range'][0]) & (x <= params['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=params['guess'])\n    results[peak] = {\n        'x0': float(popt[2]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[0]),\n  "]
[33.961289, "i", "      'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
