[18.783244, "i", "cat << 'EOF' > fit_raman.py\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].values\ny = df['intensity'].values\n\npeaks = {\n    'D': {'range': (1300, 1400), 'guess': [100, 10, 1350, 0]},\n    'G': {'range': (1550, 1620), 'guess': [100, 10, 1580, 0]},\n    '2D': {'range': (2650, 2750), 'guess': [100, 10, 2690, 0]}\n}\n\nresults = {}\nfor peak, params in peaks.items():\n    mask = (x >= params['range'][0]) & (x <= params['range'][1])\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=params['guess'])\n    results[peak] = {\n        'x0': float(popt[2]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[0]),\n        'offset': float(popt[3])\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results"]
[18.783294, "i", ".json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
