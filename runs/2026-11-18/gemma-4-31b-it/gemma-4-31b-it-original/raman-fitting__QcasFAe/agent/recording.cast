[77.522742, "i", "cat << 'EOF' > /app/fit_raman.py\nimport math\nimport json\n\ndef solve():\n    with open('/app/graphene.dat', 'r') as f:\n        lines = f.readlines()\n        data = [l.split() for l in lines if l.strip()]\n        x = [float(row[0].replace(',', '.')) for row in data]\n        y = [float(row[1].replace(',', '.')) for row in data]\n\n    peaks = []\n    for i in range(1, len(y)-1):\n        if y[i] > y[i-1] and y[i] > y[i+1]:\n            peaks.append((x[i], y[i], i))\n    peaks.sort(key=lambda p: p[1], reverse=True)\n\n    top_peaks = sorted(peaks[:2], key=lambda p: p[0])\n    results = {}\n    labels = ['G', '2D']\n    offset = min(y)\n\n    for label, p in zip(labels, top_peaks):\n        x0 = p[0]\n        y_max = p[1]\n        half_max = (y_max + offset) / 2\n        \n        width = 0\n        for i in range(p[2], 0, -1):\n            if y[i] < half_max:\n                width += abs(x[i] - x0)\n                break\n        for i in range(p[2], len(y)-1):\n            if y[i] < half_max:\n                width += abs(x[i] - x0)\n   "]
[77.522885, "i", "             break\n        \n        gamma = width / 2 if width > 0 else 1.0\n        amplitude = (y_max - offset) * math.pi * gamma\n        \n        results[label] = {\n            'x0': x0,\n            'gamma': gamma,\n            'amplitude': amplitude,\n            'offset': offset\n        }\n\n    with open('/app/results.json', 'w') as f:\n        json.dump(results, f, indent=2)\n\nsolve()\nEOF\n"]
[77.522952, "o", "cat << 'EOF' > /app/fit_raman.py\r\n\u001b[?2004l\r"]
[77.523028, "o", "             break\r\n        \r\n        gamma = width / 2 if width > 0 else 1.0\r\n        amplitude = (y_max - offset) * math.pi * gamma\r\n        \r\n        results[label] = {\r\n            'x0': x0,\r\n            'gamma': gamma,\r\n            'amplitude': amplitude,\r\n            'offset': offset\r\n        }\r\n\r\n    with open('/app/results.json', 'w') as f:\r\n        json.dump(results, f, indent=2)\r\n\r\nsolve()\r\nEOF\r\n"]
