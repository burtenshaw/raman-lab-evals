[40.733526, "i", "python3 -c \"import numpy as np\nlines = open('/app/graphene.dat').readlines()\ndata = [l.split() for l in lines if l.strip()]\nx = np.array([float(row[0].replace(',', '.')) for row in data])\ny = np.array([float(row[1].replace(',', '.')) for row in data])\n# Find peaks by looking for local maxima\npeak_indices = []\nfor i in range(1, len(y)-1):\n    if y[i] > y[i-1] and y[i] > y[i+1]:\n        peak_indices.append(i)\n# Sort peaks by height and print top 5\npeak_indices.sort(key=lambda i: y[i], reverse=True)\nprint('Top peaks x, y:')\nfor i in peak_indices[:5]:\n    print(f'x: {x[i]}, y: {y[i]}')\n\"\n"]
