Sending keys: ['cat << \'EOF\' > fit_raman.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Load data\ndata = np.loadtxt(\'graphene.dat\', delimiter=None)\n# The data seems to have commas as decimals. Let\'s handle it manually if loadtxt fails\n# Re-reading and replacing commas with dots\nwith open(\'graphene.dat\', \'r\') as f:\n    lines = f.readlines()\n    vals = []\n    for line in lines:\n        parts = line.split()\n        if len(parts) >= 2:\n            x = float(parts[0].replace(\',\', \'.\'))\n            y = float(parts[1].replace(\',\', \'.\'))\n            vals.append([x, y])\n    data = np.array(vals)\n\nx = data[:, 0]\ny = data[:, 1]\n\n# Lorentzian function: L(x) = offset + amplitude * gamma^2 / ((x - x0)^2 + gamma^2)\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\n# To find G and 2D peaks, we look for local maxima\n# G peak is usually the first major peak, 2D the second (at higher x)\n# Let\'s find the peaks by sorting y\nidx_sorted = np.argsort(y)[::-1]\n\n# Find the two most prominent peaks that are sufficiently separated\npeaks = []\nfor idx in idx_sorted:\n    px = x[idx]\n    # Ensure the peak is far enough from existing peaks\n    if all(abs(px - p[0]) > 100 for p in peaks):\n        peaks.append([px, y[idx]])\n    if len(peaks) == 2:\n        break\n\n# Sort peaks by x value: G (lower x) and 2D (higher x)\npeaks = sorted(peaks, key=lambda p: p[0])\n\nresults = {}\npeak_names = [\'G\', \'2D\']\n\nfor name, peak in zip(peak_names, peaks):\n    x0_guess = peak[0]\n    y0_guess = np.min(y)\n    amp_guess = peak[1] - y0_guess\n    gamma_guess = 10.0\n    \n    # Define a window around the peak to fit\n    mask = (x > x0_guess - 100) & (x < x0_guess + 100)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=[x0_guess, gamma_guess, amp_guess, y0_guess])\n        results[name] = {\n            "x0": float(popt[0]),\n            "gamma": float(popt[1]),\n            "amplitude": float(popt[2]),\n            "offset": float(popt[3])\n        }\n    except Exception as e:\n        print(f"Error fitting {name}: {e}")\n        results[name] = {"x0": 0, "gamma": 0, "amplitude": 0, "offset": 0}\n\nwith open(\'results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nEOF\npython3 fit_raman.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
