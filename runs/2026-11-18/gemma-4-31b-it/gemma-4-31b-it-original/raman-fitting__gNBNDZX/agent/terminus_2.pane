[?2004hroot@j-openenv-6afd86ec884144d2f44fd3cd-w9nkx3qt-4bac4-6hvs2:/app# cat << 'EOF' > fit_raman.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = np.loadtxt('graphene.dat', delimiter=None)
[?2004l[?2004h> # The data seems to have commas as decimals. Let's handle it manually if loadtxt fails
[?2004l[?2004h> # Re-reading and replacing commas with dots
[?2004l[?2004h> with open('graphene.dat', 'r') as f:
[?2004l[?2004h>     lines = f.readlines()
[?2004l[?2004h>     vals = []
[?2004l[?2004h>     for line in lines:
[?2004l[?2004h>         parts = line.split()
[?2004l[?2004h>         if len(parts) >= 2:
[?2004l[?2004h>             x = float(parts[0].replace(',', '.'))
[?2004l[?2004h>             y = float(parts[1].replace(',', '.'))
[?2004l[?2004h>             vals.append([x, y])
[?2004l[?2004h>     data = np.array(vals)
[?2004l[?2004h> 
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Lorentzian function: L(x) = offset + amplitude * gamma^2 / ((x - x0)^2 + gamma^2)
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)
[?2004l[?2004h> 
[?2004l[?2004h> # To find G and 2D peaks, we look for local maxima
[?2004l[?2004h> # G peak is usually the first major peak, 2D the second (at higher x)
[?2004l[?2004h> # Let's find the peaks by sorting y
[?2004l[?2004h> idx_sorted = np.argsort(y)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> # Find the two most prominent peaks that are sufficiently separated
[?2004l[?2004h> peaks = []
[?2004l[?2004h> for idx in idx_sorted:
[?2004l[?2004h>     px = x[idx]
[?2004l[?2004h>     # Ensure the peak is far enough from existing peaks
[?2004l[?2004h>     if all(abs(px - p[0]) > 100 for p in peaks):
[?2004l[?2004h>         peaks.append([px, y[idx]])
[?2004l[?2004h>     if len(peaks) == 2:
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> # Sort peaks by x value: G (lower x) and 2D (higher x)
[?2004l[?2004h> peaks = sorted(peaks, key=lambda p: p[0])
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> peak_names = ['G', '2D']
[?2004l[?2004h> 
[?2004l[?2004h> for name, peak in zip(peak_names, peaks):
[?2004l[?2004h>     x0_guess = peak[0]
[?2004l[?2004h>     y0_guess = np.min(y)
[?2004l[?2004h>     amp_guess = peak[1] - y0_guess
[?2004l[?2004h>     gamma_guess = 10.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Define a window around the peak to fit
[?2004l[?2004h>     mask = (x > x0_guess - 100) & (x < x0_guess + 100)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=[x0_guess, gamma_guess, amp_guess, y0_guess])
[?2004l[?2004h>         results[name] = {
[?2004l[?2004h>             "x0": float(popt[0]),
[?2004l[?2004h>             "gamma": float(popt[1]),
[?2004l[?2004h>             "amplitude": float(popt[2]),
[?2004l[?2004h>             "offset": float(popt[3])
[?2004l[?2004h>         }
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error fitting {name}: {e}")
[?2004l[?2004h>         results[name] = {"x0": 0, "gamma": 0, "amplitude": 0, "offset": 0}
[?2004l[?2004h> 
[?2004l[?2004h> with open('results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
