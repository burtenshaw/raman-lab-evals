[92.640048, "i", "cat << 'EOF' > fit_raman.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Load data manually to handle commas as decimals\nvals = []\nwith open('graphene.dat', 'r') as f:\n    lines = f.readlines()\n    for line in lines:\n        parts = line.split()\n        if len(parts) >= 2:\n            try:\n                x = float(parts[0].replace(',', '.'))\n                y = float(parts[1].replace(',', '.'))\n                vals.append([x, y])\n            except ValueError:\n                continue\n    data = np.array(vals)\n\nx = data[:, 0]\ny = data[:, 1]\n\n# Lorentzian function\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\n# Find G and 2D peaks\nidx_sorted = np.argsort(y)[::-1]\npeaks = []\nfor idx in idx_sorted:\n    px = x[idx]\n    if all(abs(px - p[0]) > 100 for p in peaks):\n        peaks.append([px, y[idx]])\n    if len(peaks) == 2:\n        break\n\npeaks = sorted(peaks, key=lambda p: p[0])\nresults = {}\npeak_names = ['G', '2D']\n\n"]
[92.640197, "i", "for name, peak in zip(peak_names, peaks):\n    x0_guess = peak[0]\n    y0_guess = np.min(y)\n    amp_guess = peak[1] - y0_guess\n    gamma_guess = 10.0\n    \n    mask = (x > x0_guess - 200) & (x < x0_guess + 200)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    try:\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=[x0_guess, gamma_guess, amp_guess, y0_guess])\n        results[name] = {\n            \"x0\": float(popt[0]),\n            \"gamma\": float(popt[1]),\n            \"amplitude\": float(popt[2]),\n            \"offset\": float(popt[3])\n        }\n    except Exception as e:\n        print(f\"Error fitting {name}: {e}\")\n        results[name] = {\"x0\": float(x0_guess), \"gamma\": 0, \"amplitude\": 0, \"offset\": 0}\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 fit_raman.py\nmv results.json /app/results.json\n"]
