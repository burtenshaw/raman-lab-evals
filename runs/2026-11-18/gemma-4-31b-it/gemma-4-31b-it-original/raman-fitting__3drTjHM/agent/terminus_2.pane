[?2004l[?2004h>     if len(parts) == 2:
[?2004l[?2004h>         x = float(parts[0].replace(',', '.'))
[?2004l[?2004h>         y = float(parts[1].replace(',', '.'))
[?2004l[?2004h>         data.append([x, y])
[?2004l[?2004h> 
