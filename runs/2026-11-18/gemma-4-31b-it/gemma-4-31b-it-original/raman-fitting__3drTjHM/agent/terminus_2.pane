[?2004lcat << 'EOF' > fit_peaks.py
import numpy as np
import json
from scipy.optimize import curve_fit

def lorentzian(x, x0, gamma, amp, offset):
    return amp * (gamma/2)**2 / ((x - x0)**2 + (gamma/2)**2) + offset

# Load data
lines = open('graphene.dat').readlines()
data = []
for line in lines:
    parts = line.split()
    if len(parts) == 2:
        try:
            x = float(parts[0].replace(',', '.'))
            y = float(parts[1].replace(',', '.'))
            data.append([x, y])
        except ValueError:
            continue

data = np.array(data)
idx = np.argsort(data[:, 0])
x = data[idx, 0]
y = data[idx, 1]

# Find all local maxima
peaks = []
for i in range(1, len(y) - 1):
    if y[i] > y[i-1] and y[i] > y[i+1]:
        peaks.append((x[i], y[i]))

# Sort peaks by amplitude to find the most prominent ones
peaks = sorted(peaks, key=lambda p: p[1], reverse=True)

top_peaks = []
if len(peaks) > 0:
    top_peaks.append(peaks[0])
    for p in peaks[1:]:
        # Use a smaller fraction of the range to find the second peak
        if abs(p[0] - top_peaks[0][0]) > (np.max(x) - np.min(x)) * 0.05:
            top_peaks.append(p)
            break

top_peaks = sorted(top_peaks, key=lambda p: p[0])

results = {}
peak_names = ['G', '2D']
# Increased window size significantly to ensure enough points are captured
window = 5000 

for i in range(min(2, len(top_peaks))):
    p_x, p_y = top_peaks[i]
    mask = (x > p_x - window) & (x < p_x + window)
    x_fit = x[mask]
    y_fit = y[mask]
    
    if len(x_fit) < 5:
        print(f'Not enough points for {peak_names[i]}')
        continue

    try:
        # Guess gamma based on the X range if the default 200 is too small
        p0 = [p_x, 500, p_y - np.min(y_fit), np.min(y_fit)]
        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
        results[peak_names[i]] = {
            'x0': float(popt[0]),
            'gamma': float(popt[1]),
            'amplitude': float(popt[2]),
            'offset': float(popt[3])
        }
    except Exception as e:
        print(f'Fit failed for {peak_names[i]}: {e}')

with open('/app/results.json', 'w') as f:
    json.dump(results, f, indent=2)
EOF
