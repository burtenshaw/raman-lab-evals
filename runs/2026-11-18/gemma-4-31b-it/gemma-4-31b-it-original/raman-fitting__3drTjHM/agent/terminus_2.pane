[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amp, offset):
[?2004l[?2004h>     return amp * (gamma/2)**2 / ((x - x0)**2 + (gamma/2)**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> lines = open('graphene.dat').readlines()
[?2004l[?2004h> data = []
[?2004l[?2004h> for line in lines:
[?2004l[?2004h>     parts = line.split()
[?2004l[?2004h>     if len(parts) == 2:
[?2004l[?2004h>         try:
[?2004l[?2004h>             x = float(parts[0].replace(',', '.'))
[?2004l[?2004h>             y = float(parts[1].replace(',', '.'))
[?2004l[?2004h>             data.append([x, y])
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h> data = np.array(data)
[?2004l[?2004h> # Sort by x to be sure
[?2004l[?2004h> idx = np.argsort(data[:, 0])
[?2004l[?2004h> x = data[idx, 0]
[?2004l[?2004h> y = data[idx, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Find peaks by searching for local maxima
[?2004l[?2004h> peaks = []
[?2004l[?2004h> for i in range(1, len(y) - 1):
[?2004l[?2004h>     if y[i] > y[i-1] and y[i] > y[i+1]:
[?2004l[?2004h>         peaks.append((x[i], y[i]))
[?2004l[?2004h> 
[?2004l[?2004h> peaks = sorted(peaks, key=lambda p: p[1], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> top_peaks = []
[?2004l[?2004h> if len(peaks) > 0:
[?2004l[?2004h>     top_peaks.append(peaks[0])
[?2004l[?2004h>     for p in peaks[1:]:
[?2004l[?2004h>         # Use a larger separation for the 2D peak search
[?2004l[?2004h>         if abs(p[0] - top_peaks[0][0]) > (np.max(x) - np.min(x)) * 0.1:
[?2004l[?2004h>             top_peaks.append(p)
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h> top_peaks = sorted(top_peaks, key=lambda p: p[0])
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> peak_names = ['G', '2D']
[?2004l[?2004h> # Use a wider window for fitting, e.g., 1000 units given the X range
[?2004l[?2004h> window = 1000 
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(min(2, len(top_peaks))):
[?2004l[?2004h>     p_x, p_y = top_peaks[i]
[?2004l[?2004h>     mask = (x > p_x - window) & (x < p_x + window)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(x_fit) < 10:
[?2004l[?2004h>         print(f'Not enough points for {peak_names[i]}')
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Guess gamma as something reasonable for the scale
[?2004l[?2004h>         p0 = [p_x, 200, p_y - np.min(y_fit), np.min(y_fit)]
[?2004l[?2004h>         popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)
[?2004l[?2004h>         results[peak_names[i]] = {
[?2004l[?2004h>             'x0': float(popt[0]),
[?2004l[?2004h>             'gamma': float(popt[1]),
[?2004l[?2004h>             'amplitude': float(popt[2]),
[?2004l[?2004h>             'offset': float(popt[3])
[?2004l[?2004h>         }
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'Fit failed for {peak_names[i]}: {e}')
[?2004l[?2004h> 
