[93.514757, "i", "cat << 'EOF' > fit_peaks.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, x0, gamma, amp, offset):\n    return amp * (gamma/2)**2 / ((x - x0)**2 + (gamma/2)**2) + offset\n\n# Load data\nlines = open('graphene.dat').readlines()\ndata = []\nfor line in lines:\n    parts = line.split()\n    if len(parts) == 2:\n        try:\n            x = float(parts[0].replace(',', '.'))\n            y = float(parts[1].replace(',', '.'))\n            data.append([x, y])\n        except ValueError:\n            continue\n\ndata = np.array(data)\n# Sort by x to be sure\nidx = np.argsort(data[:, 0])\nx = data[idx, 0]\ny = data[idx, 1]\n\n# Find peaks by searching for local maxima\npeaks = []\nfor i in range(1, len(y) - 1):\n    if y[i] > y[i-1] and y[i] > y[i+1]:\n        peaks.append((x[i], y[i]))\n\npeaks = sorted(peaks, key=lambda p: p[1], reverse=True)\n\ntop_peaks = []\nif len(peaks) > 0:\n    top_peaks.append(peaks[0])\n    for p in peaks[1:]:\n        # Use a larger separation for the 2D peak search\n        if abs("]
[93.514883, "i", "p[0] - top_peaks[0][0]) > (np.max(x) - np.min(x)) * 0.1:\n            top_peaks.append(p)\n            break\n\ntop_peaks = sorted(top_peaks, key=lambda p: p[0])\n\nresults = {}\npeak_names = ['G', '2D']\n# Use a wider window for fitting, e.g., 1000 units given the X range\nwindow = 1000 \n\nfor i in range(min(2, len(top_peaks))):\n    p_x, p_y = top_peaks[i]\n    mask = (x > p_x - window) & (x < p_x + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    if len(x_fit) < 10:\n        print(f'Not enough points for {peak_names[i]}')\n        continue\n\n    try:\n        # Guess gamma as something reasonable for the scale\n        p0 = [p_x, 200, p_y - np.min(y_fit), np.min(y_fit)]\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        results[peak_names[i]] = {\n            'x0': float(popt[0]),\n            'gamma': float(popt[1]),\n            'amplitude': float(popt[2]),\n            'offset': float(popt[3])\n        }\n    except Exception as e:\n        print(f'Fit failed for {peak_names[i]}: {e}')\n\nwith open('/ap"]
