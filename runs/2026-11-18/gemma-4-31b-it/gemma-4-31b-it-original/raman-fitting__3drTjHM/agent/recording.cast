[46.325618, "i", "cat << 'EOF' > fit_peaks.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, x0, gamma, amp, offset):\n    return amp * (gamma/2)**2 / ((x - x0)**2 + (gamma/2)**2) + offset\n\n# Load data\nlines = open('graphene.dat').readlines()\ndata = []\nfor line in lines:\n    parts = line.split()\n    if len(parts) == 2:\n        x = float(parts[0].replace(',', '.'))\n        y = float(parts[1].replace(',', '.'))\n        data.append([x, y])\n\ndata = np.array(data)\nx = data[:, 0]\ny = data[:, 1]\n\n# Find peaks by searching for local maxima\n# We look for the two most prominent peaks\n# First, subtract baseline or just look for peaks\n# We'll search for the G and 2D peaks\n# Let's sort peaks by amplitude\npeaks = []\nfor i in range(1, len(y) - 1):\n    if y[i] > y[i-1] and y[i] > y[i+1]:\n        peaks.append((x[i], y[i]))\n\npeaks = sorted(peaks, key=lambda p: p[1], reverse=True)\n\n# We assume the two highest peaks are G and 2D\n# G is usually lower shift than 2D\npeak_candidates = sorted(peaks[:5], key=lambd"]
[46.325803, "i", "a p: p[0])\n\n# More robust: separate regions for G and 2D\n# G is ~1580, 2D is ~2670. Let's find the global maxima in two separated regions\n# Since we don't know the units, let's just pick the two highest peaks that are far apart\ntop_peaks = []\nif len(peaks) > 0:\n    top_peaks.append(peaks[0])\n    for p in peaks[1:]:\n        if abs(p[0] - top_peaks[0][0]) > (np.max(x) - np.min(x)) * 0.1:\n            top_peaks.append(p)\n            break\n\n# Sort by x coordinate: G first, then 2D\ntop_peaks = sorted(top_peaks, key=lambda p: p[0])\n\nresults = {}\npeak_names = ['G', '2D']\nfor i in range(min(2, len(top_peaks))):\n    p_x, p_y = top_peaks[i]\n    # Define a fit range around the peak\n    mask = (x > p_x - 50) & (x < p_x + 50)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    try:\n        # Initial guess: x0=p_x, gamma=10, amp=p_y-offset, offset=min(y_fit)\n        p0 = [p_x, 10, p_y - np.min(y_fit), np.min(y_fit)]\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        results[peak_names[i]] = {\n            'x0'"]
[46.325883, "o", "cat << 'EOF' > fit_peaks.py\r\n\u001b[?2004l\ra p: p[0])\r\n\r\n# More robust: separate regions for G and 2D\r\n# G is ~1580, 2D is ~2670. Let's find the global maxima in two separated regions\r\n# Since we don't know the units, let's just pick the two highest peaks that are far apart\r\ntop_peaks = []\r\nif len(peaks) > 0:\r\n    top_peaks.append(peaks[0])\r\n    for p in peaks[1:]:\r\n        if abs(p[0] - top_peaks[0][0]) > (np.max(x) - np.min(x)) * 0.1:\r\n            top_peaks.append(p)"]
[46.325925, "i", ": float(popt[0]),\n            'gamma': float(popt[1]),\n            'amplitude': float(popt[2]),\n            'offset': float(popt[3])\n        }\n    except Exception as e:\n        print(f'Fit failed for {peak_names[i]}: {e}')\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
