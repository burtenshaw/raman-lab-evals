[119.961227, "i", "python3 -c \"import numpy as np; data = np.array([line.replace(',', '.').split() for line in open('graphene.dat')], dtype=float); print('Min X:', np.min(data[:,0])); print('Max X:', np.max(data[:,0])); print('Y max:', np.max(data[:,1]))\"\n"]
[119.962037, "o", "python3 -c \"import numpy as np; data = np.array([line.replace(',', '.').split() for line in open('graphene.dat')], dtype=float); print('Min X:', np.min(data[:,0])); print('Max X:', np.max(data[:,0])); print('Y max:', np.max(data[:,1]))\"\r\n\u001b[?2004l\r"]
[120.079063, "i", "cat << 'EOF' > fit_peaks.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, x0, gamma, amp, offset):\n    return amp * (gamma/2)**2 / ((x - x0)**2 + (gamma/2)**2) + offset\n\n# Load data\nlines = open('graphene.dat').readlines()\ndata = []\nfor line in lines:\n    parts = line.split()\n    if len(parts) == 2:\n        try:\n            x = float(parts[0].replace(',', '.'))\n            y = float(parts[1].replace(',', '.'))\n            data.append([x, y])\n        except ValueError:\n            continue\n\ndata = np.array(data)\nidx = np.argsort(data[:, 0])\nx = data[idx, 0]\ny = data[idx, 1]\n\n# Find all local maxima\npeaks = []\nfor i in range(1, len(y) - 1):\n    if y[i] > y[i-1] and y[i] > y[i+1]:\n        peaks.append((x[i], y[i]))\n\n# Sort peaks by amplitude to find the most prominent ones\npeaks = sorted(peaks, key=lambda p: p[1], reverse=True)\n\ntop_peaks = []\nif len(peaks) > 0:\n    top_peaks.append(peaks[0])\n    for p in peaks[1:]:\n        # Use a smaller fraction of the range to find th"]
[120.079118, "o", "cat << 'EOF' > fit_peaks.py\r\nimport numpy as np\r\nimport json\r\nfrom scipy.optimize import curve_fit\r\n\r\ndef lorentzian(x, x0, gamma, amp"]
[120.079231, "i", "e second peak\n        if abs(p[0] - top_peaks[0][0]) > (np.max(x) - np.min(x)) * 0.05:\n            top_peaks.append(p)\n            break\n\ntop_peaks = sorted(top_peaks, key=lambda p: p[0])\n\nresults = {}\npeak_names = ['G', '2D']\n# Increased window size significantly to ensure enough points are captured\nwindow = 5000 \n\nfor i in range(min(2, len(top_peaks))):\n    p_x, p_y = top_peaks[i]\n    mask = (x > p_x - window) & (x < p_x + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    if len(x_fit) < 5:\n        print(f'Not enough points for {peak_names[i]}')\n        continue\n\n    try:\n        # Guess gamma based on the X range if the default 200 is too small\n        p0 = [p_x, 500, p_y - np.min(y_fit), np.min(y_fit)]\n        popt, _ = curve_fit(lorentzian, x_fit, y_fit, p0=p0)\n        results[peak_names[i]] = {\n            'x0': float(popt[0]),\n            'gamma': float(popt[1]),\n            'amplitude': float(popt[2]),\n            'offset': float(popt[3])\n        }\n    except Exception as e:\n        print(f'Fit"]
