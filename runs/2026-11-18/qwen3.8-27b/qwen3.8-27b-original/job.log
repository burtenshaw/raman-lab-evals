Sending keys: ['cat << \'EOF\' > /app/fit_raman.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\nfrom scipy.signal import find_peaks\n\n# Read data manually, handling comma decimals\nrows = []\nwith open(\'/app/graphene.dat\') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.split()\n        x_val = float(parts[0].replace(\',\', \'.\'))\n        y_val = float(parts[1].replace(\',\', \'.\'))\n        rows.append((x_val, y_val))\n\nx = np.array([r[0] for r in rows])\ny = np.array([r[1] for r in rows])\n\n# Sort by x\nsort_idx = np.argsort(x)\nx = x[sort_idx]\ny = y[sort_idx]\n\nprint(f"x range: {x.min():.2f} to {x.max():.2f}")\nprint(f"y range: {y.min():.2f} to {y.max():.2f}")\nprint(f"num points: {len(x)}")\n\n# Check what x values look like - maybe x is wavelength or frequency\n# Let\'s look at a sample of x values\nprint("\\nFirst 10 x values:", x[:10])\nprint("Last 10 x values:", x[-10:])\nprint("x step (approx):", x[1]-x[0])\n\n# Check for G (~1580) and 2D (~2700) peaks\n# The x range goes from ~1648 to ~47183\n# Could be in different units. Let\'s find peaks in the data\ny_smooth = np.convolve(y, np.ones(10)/10, mode=\'same\')\npeaks, props = find_peaks(y_smooth, height=np.percentile(y, 90), distance=20)\nprint(f"\\nFound {len(peaks)} peaks (height>90th percentile):")\nfor i, p in enumerate(peaks):\n    print(f"  Peak {i}: x={x[p]:.2f}, y_smooth={y_smooth[p]:.2f}, y={y[p]:.2f}")\n\n# Also check for valleys or the baseline\nprint(f"\\ny mean: {np.mean(y):.2f}, median: {np.median(y):.2f}")\nprint(f"y at x=1648: {y[np.argmin(abs(x-1648))]:.2f}")\nprint(f"y at x=2700: {y[np.argmin(abs(x-2700))]:.2f}")\nprint(f"y at x=1580: {y[np.argmin(abs(x-1580))]:.2f}")\nEOF\npython3 /app/fit_raman.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
