[150.400769, "i", "python3 - <<'PY'\nimport sys, numpy, scipy\nprint('python ok', numpy.__version__, scipy.__version__)\ndata = np.genfromtxt('/app/graphene.dat', delimiter=' ', converters={0: lambda s: float(s.decode().replace(',', '.')), 1: lambda s: float(s.decode().replace(',', '.'))}, encoding='utf-8')\nprint('shape', data.shape)\nx, y = data[:,0], data[:,1]\nprint('x min/max', x.min(), x.max(), 'monotonic decreasing', np.all(np.diff(x) < 0), 'increasing', np.all(np.diff(x) > 0))\nprint('y min/max', y.min(), y.max())\nidx_max = np.argsort(y)[-10:][::-1]\nprint('top 10 by y:')\nfor i in idx_max:\n    print(i, x[i], y[i])\n# simple local peaks\nfrom scipy.signal import find_peaks\n# if x decreasing, work in order; use y as is\npeaks, props = find_peaks(y, prominence=(y.max()-y.min())*0.05, distance=10)\nprint('num peaks', len(peaks))\nfor p in peaks:\n    print('peak index', p, 'x', x[p], 'y', y[p])\nPY\n"]
