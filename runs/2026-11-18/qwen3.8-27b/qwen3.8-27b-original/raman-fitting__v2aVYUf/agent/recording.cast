[584.211546, "o", "with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r"]
[584.211592, "o", "\u001b[?2004h> "]
[584.211635, "o", "    for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[584.21172, "o", "        line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[584.211787, "o", ">         if not line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[584.213533, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         a,b=line.split()\r\n\u001b[?2004l\r\u001b[?2004h>         xs.append(float(a.replace(',', '.')))\r\n\u001b[?2004l\r\u001b[?2004h>         ys.append(float(b.replace(',', '.')))\r\n\u001b[?2004l\r\u001b[?2004h> n=len(xs)\r\n\u001b[?2004l\r\u001b[?2004h> print('n', n)\r\n\u001b[?2004l\r\u001b[?2004h> print('x min/max', min(xs), max(xs))\r\n\u001b[?2004l\r\u001b[?2004h> print('y min/max', min(ys), max(ys))\r\n\u001b[?2004l\r\u001b[?2004h> order=sorted(range(n), key=lambda i: xs[i])\r\n\u001b[?2004l\r\u001b[?2004h> xs_sorted=[xs[i] for i in order]\r\n\u001b[?2004l\r\u001b[?2004h> ys_sorted=[ys[i] for i in order]\r\n\u001b[?2004l\r\u001b[?2004h> idx=sorted(range(n), key=lambda i: ys[i], reverse=True)[:20]\r\n\u001b[?2004l\r\u001b[?2004h> print('top 20 raw:')\r\n\u001b[?2004l\r\u001b[?2004h> for i in idx:\r\n\u001b[?2004l\r\u001b[?2004h>     print(i, xs[i], ys[i])\r\n\u001b[?2004l\r\u001b[?2004h> def smooth(y, w=51):\r\n\u001b[?2004l\r\u001b[?2004h>     half=w//2\r\n\u001b[?2004l\r\u001b[?2004h>     res=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(len(y)):\r\n\u001b[?2004l\r\u001b[?2004h>         l=max(0, i-half)\r\n\u001b[?2004l\r\u001b[?2004h>         r=min(len(y), i+half+1)\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[584.213618, "o", "    res.append(sum(y[l:r])/(r-l))\r\n\u001b[?2004l\r\u001b[?2004h>     return res\r\n\u001b[?2004l\r\u001b[?2004h> ysm=smooth(ys_sorted, 51)\r\n\u001b[?2004l\r\u001b[?2004h> range_y=max(ys_sorted)-min(ys_sorted)\r\n\u001b[?2004l\r\u001b[?2004h> prom_th=0.05*range_y\r\n\u001b[?2004l\r\u001b[?2004h> peaks=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[584.213639, "o", "for i in range(1, len(xs_sorted)-1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[584.213651, "o", "> "]
[584.213741, "o", "    if ysm[i] > ysm[i-1] and ysm[i] >= ysm[i+1]:\r\n\u001b[?2004l\r"]
[584.213789, "o", "\u001b[?2004h> "]
[584.213856, "o", "        l=max(0, i-500)\r\n\u001b[?2004l\r"]
[584.2139, "o", "\u001b[?2004h> "]
[584.213945, "o", "        r=min(len(ysm), i+501)\r\n\u001b[?2004l\r"]
[584.21398, "o", "\u001b[?2004h> "]
[584.214025, "o", "        base=min(ysm[l:r])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[584.214066, "o", "        prom=ysm[i]-base\r\n"]
[584.214113, "o", "\u001b[?2004l\r\u001b[?2004h"]
[584.214161, "o", "> "]
[584.214206, "o", "        if prom > prom_th:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[584.214284, "o", "            peaks.append((xs_sorted[i], ysm[i], ys_sorted[i], i, prom))\r\n\u001b[?2004l\r"]
[584.214323, "o", "\u001b[?2004h> "]
[584.214373, "o", "peaks.sort(key=lambda t: t[1], reverse=True)\r\n\u001b[?2004l\r"]
[584.2144, "o", "\u001b[?2004h> "]
[584.214454, "o", "print('candidate peaks smoothed:')\r\n\u001b[?2004l\r"]
[584.214481, "o", "\u001b[?2004h> "]
[584.214526, "o", "for p in peaks[:20]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[584.214566, "o", "> "]
[584.214612, "o", "    print(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[584.214689, "o", "for a,b in [(1500,1700),(2600,2800),(15000,17000),(26000,28000)]:\r\n\u001b[?2004l\r"]
[584.214728, "o", "\u001b[?2004h> "]
[584.214823, "o", "    sub=[(xs_sorted[i], ys_sorted[i], ysm[i]) for i in range(n) if a <= xs_sorted[i] <= b]\r\n\u001b[?2004l\r"]
[584.214861, "o", "\u001b[?2004h"]
[584.214884, "o", ">     if sub:\r\n\u001b[?2004l\r\u001b[?2004h"]
[584.214932, "o", "> "]
[584.214963, "o", "        maxraw=max(sub, key=lambda t: t[1])\r\n\u001b[?2004l\r"]
[584.21501, "o", "\u001b[?2004h> "]
[584.215056, "o", "        maxsm=max(sub, key=lambda t: t[2])\r\n\u001b[?2004l\r"]
[584.215104, "o", "\u001b[?2004h> "]
