[584.211221, "i", "python3 - <<'PY'\nimport math\nxs=[]; ys=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line:\n            continue\n        a,b=line.split()\n        xs.append(float(a.replace(',', '.')))\n        ys.append(float(b.replace(',', '.')))\nn=len(xs)\nprint('n', n)\nprint('x min/max', min(xs), max(xs))\nprint('y min/max', min(ys), max(ys))\norder=sorted(range(n), key=lambda i: xs[i])\nxs_sorted=[xs[i] for i in order]\nys_sorted=[ys[i] for i in order]\nidx=sorted(range(n), key=lambda i: ys[i], reverse=True)[:20]\nprint('top 20 raw:')\nfor i in idx:\n    print(i, xs[i], ys[i])\ndef smooth(y, w=51):\n    half=w//2\n    res=[]\n    for i in range(len(y)):\n        l=max(0, i-half)\n        r=min(len(y), i+half+1)\n        res.append(sum(y[l:r])/(r-l))\n    return res\nysm=smooth(ys_sorted, 51)\nrange_y=max(ys_sorted)-min(ys_sorted)\nprom_th=0.05*range_y\npeaks=[]\nfor i in range(1, len(xs_sorted)-1):\n    if ysm[i] > ysm[i-1] and ysm[i] >= ysm[i+1]:\n        l=max(0, i-500)\n        r=min(len(ysm)"]
[584.211328, "i", ", i+501)\n        base=min(ysm[l:r])\n        prom=ysm[i]-base\n        if prom > prom_th:\n            peaks.append((xs_sorted[i], ysm[i], ys_sorted[i], i, prom))\npeaks.sort(key=lambda t: t[1], reverse=True)\nprint('candidate peaks smoothed:')\nfor p in peaks[:20]:\n    print(p)\nfor a,b in [(1500,1700),(2600,2800),(15000,17000),(26000,28000)]:\n    sub=[(xs_sorted[i], ys_sorted[i], ysm[i]) for i in range(n) if a <= xs_sorted[i] <= b]\n    if sub:\n        maxraw=max(sub, key=lambda t: t[1])\n        maxsm=max(sub, key=lambda t: t[2])\n        print(f'region {a}-{b}: len {len(sub)}, max raw {maxraw}, max sm {maxsm}')\nPY\n"]
