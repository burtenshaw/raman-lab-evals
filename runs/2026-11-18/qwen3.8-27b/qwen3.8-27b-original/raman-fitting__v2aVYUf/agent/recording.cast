[249.128201, "i", "python3 - <<'PY'\nimport math\nxs=[]; ys=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        xs.append(float(a.replace(',', '.')))\n        ys.append(float(b.replace(',', '.')))n\nn=len(xs)\nprint('n',n)\nprint('x min/max', min(xs), max(xs))\nprint('y min/max', min(ys), max(ys))\n# top 20 by intensity\nidx=sorted(range(n), key=lambda i: ys[i], reverse=True)[:20]\nprint('top 20:')\nfor i in idx:\n    print(i, xs[i], ys[i])\n# moving average smooth\ndef smooth(y, w=31):\n    res=[]\n    half=w//2\n    for i in range(len(y)):\n        l=max(0,i-half); r=min(len(y),i+half+1)\n        res.append(sum(y[l:r])/(r-l))\n    return res\nysm=smooth(ys,31)\n# local maxima in expected regions\ndef peaks_in_region(x0,x1,sm,raw, dist=50):\n    out=[]\n    for i in range(1,len(xs)-1):\n        if x0 <= xs[i] <= x1 and sm[i] >= sm[i-1] and sm[i] >= sm[i+1]:\n            out.append((xs[i], sm[i], raw[i], i))\n    # non-maximum suppression by simple: choose max "]
[249.128351, "i", "in 200 cm-1\n    out.sort(key=lambda t: t[1], reverse=True)\n    sup=[]\n    for p in out:\n        if all(abs(p[0]-q[0])>200 for q in sup):\n            sup.append(p)\n    return sup\nprint('G region peaks:', peaks_in_region(1400,1800,ysm,ys))\nprint('2D region peaks:', peaks_in_region(2500,2900,ysm,ys))\n# print some stats around expected\nfor a,b in [(1500,1700),(2600,2800)]:\n    sub=[(xs[i],ys[i]) for i in range(n) if a<=xs[i]<=b]\n    if sub:\n        maxy=max(sub,key=lambda p:p[1])\n        print(f'region {a}-{b}: max {maxy}, miny {min(p[1] for p in sub)}, len {len(sub)}')\nPY\n"]
