[874.313578, "i", "cat << 'EOF' > /app/diag.py\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nrows=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nx=np.array([a for a,b in rows]); y=np.array([b for a,b in rows])\nidx=np.argsort(x); x=x[idx]; y=y[idx]\nn=len(x); i=np.arange(n)\n\nprint(\"== Linearity of f(x) vs row index i (R^2) ==\")\ncands = {\n 'x': x, 'x^0.5': np.sqrt(x), 'x^1.5': x**1.5, 'x^2': x**2,\n 'x^-0.5': x**-0.5, 'x^-1': 1.0/x, 'x^-2': 1.0/x**2,\n 'ln x': np.log(x), 'x^0.7': x**0.7, 'x^0.3': x**0.3,\n}\nfor k,f in cands.items():\n    c=np.corrcoef(i,f)\n    print(f\"  {k:8s}: R^2={c[0,1]**2:.6f}\")\n\n# fine step check: is 1/x linear in i?\nf=1.0/x\na,b=np.polyfit(i,f,1)\nres=f-(a*i+b)\nprint(f\"\\n1/x model: 1/x = {a:.3e}*i + {b:.3e}, residual std={res.std():.3e}, rel={res.std()/f.std():.4f}\")\n# range of Raman-shift-like quantity\nW = -1.0/x  # proportional to wavenumber difference from a ref\ng"]
[874.313698, "i", "print = \"\\n1/x range: %.6f to %.6f\" % (1.0/x.max(), 1.0/x.min())\nprint(gprint)\n\nprint(\"\\n== Precise peaks (prominence > 10%) ==\")\nys=np.convolve(y, np.ones(5)/5, mode='same')\nprom=0.10*(ys.max()-np.median(y))\npeaks,_=find_peaks(ys, prominence=prom)\npeaks=peaks[np.argsort(x[peaks])]\nfor p in peaks:\n    # parabola interp on smoothed\n    if 0<p<n-1:\n        y0,y1,y2=ys[p-1],ys[p],ys[p+1]\n        denom=(y0-2*y1+y2)\n        off= 0.5*(y0-y2)/denom if denom!=0 else 0\n    else:\n        off=0\n    xp = x[p] + off*(x[p+1]-x[p]) if p<n-1 else x[p]\n    print(f\"  x0~{xp:10.2f}  y={y[p]:10.2f}  ys={ys[p]:10.2f}  prom={ys[p]-np.median(y):10.2f}\")\nEOF\npython3 /app/diag.py\n"]
