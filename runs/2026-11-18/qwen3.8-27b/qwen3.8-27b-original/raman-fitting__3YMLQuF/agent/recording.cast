[146.120905, "o", "\u001b[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c9-g2p2jem3-60793-kvfqp:/app# "]
[424.141363, "i", "cat << 'EOF' > /app/explore.py\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nrows = []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        parts = line.split()\n        rows.append((float(parts[0].replace(',', '.')), float(parts[1].replace(',', '.'))))\n\nx = np.array([r[0] for r in rows])\ny = np.array([r[1] for r in rows])\nidx = np.argsort(x); x = x[idx]; y = y[idx]\n\n# Step analysis\ndx = np.diff(x)\nprint(f\"x step: min={dx.min():.5f} max={dx.max():.5f} mean={dx.mean():.3f} std={dx.std():.3f}\")\n# local exponent: log(dx) vs log(x)\nxm = x[:-1]\nB, A = np.polyfit(np.log(xm), np.log(dx), 1)\nprint(f\"local exponent B (dx ~ x^B): {B:.3f}\")\n\n# Coarse profile: print every 70th point\nprint(\"\\nCoarse profile (every 70th point):\")\nfor i in range(0, len(x), 70):\n    print(f\"  i={i:4d} x={x[i]:9.2f} y={y[i]:10.2f}\")\n\n# All peaks, lower threshold\nfrom scipy.signal import find_peaks\nys = np.convolve(y, np.ones(15)/15, mode='same')\nbase = np.median(y)\n"]
[424.141531, "i", "peaks, props = find_peaks(ys, height=base + 0.5*(ys.max()-base), distance=10)\npeaks = peaks[np.argsort(x[peaks])]\nprint(f\"\\nAll peaks ({len(peaks)}), baseline(median)={base:.1f}, ymax={ys.max():.1f}:\")\nfor p in peaks:\n    print(f\"  x={x[p]:9.2f}  y_peak={y[p]:10.2f}  y_smooth={ys[p]:10.2f}  rel_height={(ys[p]-base)/(ys.max()-base):.2f}\")\nEOF\npython3 /app/explore.py\n"]
[424.141575, "o", "cat << 'EOF' > /app/explore.py\r\n\u001b[?2004l\rpeaks, props = find_peaks(ys, height=base + 0.5*(ys.max()-base), distance=10)\r\npeaks = peaks[np.argsort(x[peaks])]\r\nprint(f\"\\nAll peaks ({len(peaks)}), baseline(median)={base:.1f}, ymax={ys.max():.1f}:\")\r\nfor p in peaks:\r\n    print(f\"  x={x[p]:"]
[424.141592, "o", "9.2f}  y_peak={y[p]:10.2f}  y_smooth={ys[p]:10.2f}  rel_height={(ys[p]-base)/(ys.max()-base):.2f}\")\r\nEOF\r\npython3 /app/explore.py\r\n"]
[424.14163, "o", "\u001b[?2004h> "]
[424.141679, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[424.141815, "o", "\u001b[?2004h> from scipy.signal import find_peaks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.141903, "o", "rows = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.141946, "o", "> with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r"]
[424.141985, "o", "\u001b[?2004h> "]
[424.142015, "o", "    for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.142067, "o", "        line = line.strip()\r\n\u001b[?2004l\r"]
[424.142098, "o", "\u001b[?2004h> "]
[424.142132, "o", "        if not line: continue\r\n\u001b[?2004l\r"]
[424.142171, "o", "\u001b[?2004h> "]
[424.142207, "o", "        parts = line.split()\r\n\u001b[?2004l\r"]
[424.142247, "o", "\u001b[?2004h> "]
[424.142358, "o", "        rows.append((float(parts[0].replace(',', '.')), float(parts[1].replace(',', '.'))))\r\n\u001b[?2004l\r"]
[424.1424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.142438, "o", "\u001b[?2004h> "]
[424.142484, "o", "x = np.array([r[0] for r in rows])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.142545, "o", "y = np.array([r[1] for r in rows])\r\n\u001b[?2004l\r"]
[424.142587, "o", "\u001b[?2004h> "]
[424.142639, "o", "idx = np.argsort(x); x = x[idx]; y = y[idx]\r\n\u001b[?2004l\r"]
[424.142678, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.142707, "o", "\u001b[?2004h> "]
[424.142752, "o", "# Step analysis\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.142791, "o", "> "]
[424.142829, "o", "dx = np.diff(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.142932, "o", "print(f\"x step: min={dx.min():.5f} max={dx.max():.5f} mean={dx.mean():.3f} std={dx.std():.3f}\")\r\n\u001b[?2004l\r"]
[424.142984, "o", "\u001b[?2004h> "]
[424.143032, "o", "# local exponent: log(dx) vs log(x)\r\n\u001b[?2004l\r"]
[424.14307, "o", "\u001b[?2004h> "]
[424.143109, "o", "xm = x[:-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.143174, "o", "B, A = np.polyfit(np.log(xm), np.log(dx), 1)\r\n\u001b[?2004l\r"]
[424.143213, "o", "\u001b[?2004h> "]
[424.143267, "o", "print(f\"local exponent B (dx ~ x^B): {B:.3f}\")\r\n\u001b[?2004l\r"]
[424.143296, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.143325, "o", "\u001b[?2004h> "]
[424.143379, "o", "# Coarse profile: print every 70th point\r\n\u001b[?2004l\r"]
[424.14342, "o", "\u001b[?2004h> "]
[424.143478, "o", "print(\"\\nCoarse profile (every 70th point):\")\r\n\u001b[?2004l\r"]
[424.143517, "o", "\u001b[?2004h> "]
[424.143556, "o", "for i in range(0, len(x), 70):\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.143594, "o", "> "]
[424.143663, "o", "    print(f\"  i={i:4d} x={x[i]:9.2f} y={y[i]:10.2f}\")\r\n\u001b[?2004l\r"]
[424.143702, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.143739, "o", "\u001b[?2004h> "]
[424.143778, "o", "# All peaks, lower threshold\r\n\u001b[?2004l\r"]
[424.143815, "o", "\u001b[?2004h> "]
[424.143852, "o", "from scipy.signal import find_peaks\r\n\u001b[?2004l\r"]
[424.143891, "o", "\u001b[?2004h> "]
[424.143946, "o", "ys = np.convolve(y, np.ones(15)/15, mode='same')\r\n\u001b[?2004l\r"]
[424.143991, "o", "\u001b[?2004h> "]
[424.14403, "o", "base = np.median(y)\r\n\u001b[?2004l\r"]
[424.144068, "o", "\u001b[?2004h> "]
[424.144149, "o", "peaks, props = find_peaks(ys, height=base + 0.5*(ys.max()-base), distance=10)\r\n\u001b[?2004l\r"]
[424.144189, "o", "\u001b[?2004h> "]
[424.144228, "o", "peaks = peaks[np.argsort(x[peaks])]\r\n\u001b[?2004l\r"]
[424.144257, "o", "\u001b[?2004h> "]
[424.144386, "o", "print(f\"\\nAll peaks ({len(peaks)}), baseline(median)={base:.1f}, ymax={ys.max():.1f}:\")\r\n\u001b[?2004l\r"]
[424.144427, "o", "\u001b[?2004h> "]
[424.144466, "o", "for p in peaks:\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.144496, "o", "> "]
[424.144629, "o", "    print(f\"  x={x[p]:9.2f}  y_peak={y[p]:10.2f}  y_smooth={ys[p]:10.2f}  rel_height={(ys[p]-base)/(ys.max()-base):.2f}\")\r\n\u001b[?2004l\r"]
[424.144655, "o", "\u001b[?2004h> "]
[424.144691, "o", "EOF\r\n\u001b[?2004l\r"]
[424.145717, "o", "\u001b[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c9-g2p2jem3-60793-kvfqp:/app# "]
[424.145788, "o", "python3 /app/explore.py\r\n\u001b[?2004l\r"]
