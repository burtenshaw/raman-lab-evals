[116.987966, "i", "cat << 'EOF' > /app/fit_raman.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Read data with comma decimal separator\ndata = np.loadtxt('/app/graphene.dat', converters={0: lambda s: float(s.decode().replace(',', '.')),\n                                                   1: lambda s: float(s.decode().replace(',', '.'))})\nx = data[:, 0]\ny = data[:, 1]\n\n# Sort by x\nsort_idx = np.argsort(x)\nx = x[sort_idx]\ny = y[sort_idx]\n\nprint(f\"x range: {x.min():.2f} to {x.max():.2f}\")\nprint(f\"y range: {y.min():.2f} to {y.max():.2f}\")\nprint(f\"num points: {len(x)}\")\n\n# Look at data around expected peak regions\n# G peak ~ 1580 cm^-1, 2D peak ~ 2700 cm^-1\nfor center, name in [(1580, 'G'), (2700, '2D')]:\n    mask = (x > center - 200) & (x < center + 200)\n    if mask.sum() > 0:\n        print(f\"\\n{name} peak region (center={center}):\")\n        print(f\"  points: {mask.sum()}\")\n        print(f\"  x range: {x[mask].min():.2f} to {x[mask].max():.2f}\")\n        print(f\"  y max: {y[mask].max():.2f} at x={x[mask][np.a"]
[116.988114, "i", "rgmax(y[mask])]:.2f}\")\n    else:\n        print(f\"\\n{name} peak region: NO DATA in [{center-200}, {center+200}]\")\n\n# Find global maxima to locate peaks\n# Smooth y a bit\nfrom scipy.signal import find_peaks\ny_smooth = np.convolve(y, np.ones(5)/5, mode='same')\npeaks, props = find_peaks(y_smooth, height=np.mean(y) + 2*np.std(y), distance=100)\nprint(f\"\\nFound {len(peaks)} peaks:\")\nfor i, p in enumerate(peaks):\n    print(f\"  Peak {i}: x={x[p]:.2f}, y={y[p]:.2f}\")\nEOF\npython3 /app/fit_raman.py\n"]
