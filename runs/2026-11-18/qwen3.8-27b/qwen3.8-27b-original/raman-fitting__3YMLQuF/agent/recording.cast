[144.838472, "o", "x = np.array([r[0] for r in rows])\r\n\u001b[?2004l\r"]
[144.838511, "o", "\u001b[?2004h> "]
[144.838557, "o", "y = np.array([r[1] for r in rows])\r\n\u001b[?2004l\r"]
[144.838598, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.838638, "o", "# Sort by x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.838676, "o", "sort_idx = np.argsort(x)\r\n\u001b[?2004l\r"]
[144.838715, "o", "\u001b[?2004h> x = x[sort_idx]\r\n\u001b[?2004l\r"]
[144.838755, "o", "\u001b[?2004h> "]
[144.838795, "o", "y = y[sort_idx]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[144.838836, "o", "\u001b[?2004h> "]
[144.838876, "o", "print(f\"x range: {x.min():.2f} to {x.max():.2f}\")\r\n\u001b[?2004l\r"]
[144.838917, "o", "\u001b[?2004h> "]
[144.838958, "o", "print(f\"y range: {y.min():.2f} to {y.max():.2f}\")\r\n\u001b[?2004l\r"]
[144.838997, "o", "\u001b[?2004h> "]
[144.839036, "o", "print(f\"num points: {len(x)}\")\r\n\u001b[?2004l\r"]
[144.839071, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[144.839111, "o", "> "]
[144.839152, "o", "# Check what x values look like - maybe x is wavelength or frequency\r\n\u001b[?2004l\r"]
[144.839191, "o", "\u001b[?2004h> "]
[144.839226, "o", "# Let's look at a sample of x values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.839263, "o", "print(\"\\nFirst 10 x values:\", x[:10])\r\n\u001b[?2004l\r"]
[144.839303, "o", "\u001b[?2004h> "]
[144.839346, "o", "print(\"Last 10 x values:\", x[-10:])\r\n\u001b[?2004l\r"]
[144.839389, "o", "\u001b[?2004h> "]
[144.839434, "o", "print(\"x step (approx):\", x[1]-x[0])\r\n\u001b[?2004l\r"]
[144.839479, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.839517, "o", "# Check for G (~1580) and 2D (~2700) peaks\r\n\u001b[?2004l\r"]
[144.839556, "o", "\u001b[?2004h> "]
[144.83959, "o", "# The x range goes from ~1648 to ~47183\r\n\u001b[?2004l\r"]
[144.83963, "o", "\u001b[?2004h> "]
[144.839689, "o", "# Could be in different units. Let's find peaks in the data\r\n\u001b[?2004l\r"]
[144.83973, "o", "\u001b[?2004h> "]
[144.839786, "o", "y_smooth = np.convolve(y, np.ones(10)/10, mode='same')\r\n\u001b[?2004l\r"]
[144.839825, "o", "\u001b[?2004h> "]
[144.839906, "o", "peaks, props = find_peaks(y_smooth, height=np.percentile(y, 90), distance=20)\r\n\u001b[?2004l\r"]
[144.839947, "o", "\u001b[?2004h> "]
[144.840009, "o", "print(f\"\\nFound {len(peaks)} peaks (height>90th percentile):\")\r\n\u001b[?2004l\r"]
[144.840048, "o", "\u001b[?2004h> "]
[144.840092, "o", "for i, p in enumerate(peaks):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.840194, "o", "    print(f\"  Peak {i}: x={x[p]:.2f}, y_smooth={y_smooth[p]:.2f}, y={y[p]:.2f}\")\r\n\u001b[?2004l\r"]
[144.840224, "o", "\u001b[?2004h"]
[144.840255, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.8403, "o", "# Also check for valleys or the baseline\r\n\u001b[?2004l\r"]
[144.840329, "o", "\u001b[?2004h> "]
[144.840394, "o", "print(f\"\\ny mean: {np.mean(y):.2f}, median: {np.median(y):.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[144.840429, "o", "> "]
[144.840481, "o", "print(f\"y at x=1648: {y[np.argmin(abs(x-1648))]:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.840565, "o", "print(f\"y at x=2700: {y[np.argmin(abs(x-2700))]:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.840641, "o", "print(f\"y at x=1580: {y[np.argmin(abs(x-1580))]:.2f}\")\r\n\u001b[?2004l\r"]
[144.840685, "o", "\u001b[?2004h> "]
[144.840724, "o", "EOF\r\n\u001b[?2004l\r"]
[144.841823, "o", "\u001b[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c9-g2p2jem3-60793-kvfqp:/app# "]
[144.841885, "o", "python3 /app/fit_raman.py\r\n\u001b[?2004l\r"]
[146.031119, "o", "x range: 1648.72 to 47183.55\r\ny range: 40.09 to 79400.10\r\nnum points: 3565\r\n\r\nFirst 10 x values: "]
[146.031338, "o", "[1648.724404 1648.985151 1649.246046 1649.507095 1649.768294 1650.029641\r\n 1650.291141 1650.55279  1650.814593 1651.076544]\r\nLast 10 x values: "]
[146.031477, "o", "[42323.866373 42813.13829  43314.029137 43826.959593 44352.368927\r\n 44890.718036 45442.488736 46008.191298 46588.360019 47183.554644]\r\nx step (approx):"]
[146.031485, "o", " "]
[146.031493, "o", "0.2607470000000376\r\n"]
[146.032104, "o", "\r\nFound 10 peaks (height>90th percentile):\r\n  Peak 0: x=3747.73, y_smooth=12359.47, y=12904.65\r\n  Peak 1: x=6338.40, y_smooth=11598.64, y=13107.21\r\n  Peak 2: x=10394.82, y_smooth=18647.20, y=18633.11\r\n  Peak 3: x=11485.06, y_smooth=11872.00, y=11760.18\r\n  Peak 4: x=12409.36, y_smooth=12529.65, y=12660.20\r\n  Peak 5: x=13235.05, y_smooth=12748.81, y=12584.43\r\n  Peak 6: x=16245.58, y_smooth=17351.07, y=18159.87\r\n  Peak 7: x=19235.33, y_smooth=67540.49, y=78815.24\r\n  Peak 8: x=33847.73, y_smooth=20466.16, y=20523.24\r\n  Peak 9: x=41845.81, y_smooth=19628.07, y=19360.10\r\n"]
[146.032142, "o", "\r\ny mean: 4136.30, median: 2579.68\r\n"]
[146.032198, "o", "y at x=1648: 5950.92\r\n"]
[146.032221, "o", "y at x=2700: 274.20\r\n"]
