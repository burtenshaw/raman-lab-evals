[388.615549, "i", "cat << 'EOF' > /app/fit3.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef parse_data(filename):\n    x_list, y_list = [], []\n    with open(filename, 'r') as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.split()\n            if len(parts) >= 2:\n                x = float(parts[0].replace(',', '.'))\n                y = float(parts[1].replace(',', '.'))\n                x_list.append(x)\n                y_list.append(y)\n    return np.array(x_list), np.array(y_list)\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\nx, y = parse_data('/app/graphene.dat')\nidx = np.argsort(x)\nx = x[idx]\ny = y[idx]\n\n# === G peak fit (already good) ===\nprint(\"=== G peak ===\")\ng_mask = (x >= 16500) & (x <= 23000)\ngx, gy = x[g_mask], y[g_mask]\ng_popt, _ = curve_fit(lorentzian, gx, gy, p0=[19139, 500, 67000, 12000], maxfev=50000)\ny_pred = lorentzian(gx, *g_popt)\n"]
[388.616124, "i", "ss_res = np.sum((gy - y_pred)**2)\nss_tot = np.sum((gy - gy.mean())**2)\nprint(f\"  x0={g_popt[0]:.2f}, gamma={abs(g_popt[1]):.2f}, amp={g_popt[2]:.2f}, offset={g_popt[3]:.2f}\")\nprint(f\"  R²={1-ss_res/ss_tot:.4f}\")\n\n# === 2D peak fit ===\n# Let me examine the 2D peak data more carefully\nprint(\"\\n=== 2D peak data ===\")\nd_mask = (x >= 31000) & (x <= 36000)\ndx, dy = x[d_mask], y[d_mask]\nfor xi, yi in zip(dx, dy):\n    print(f\"  x={xi:.1f}, y={yi:.1f}\")\n\n# The 2D peak is very subtle: peak at 33245 (y=21253) on background ~19000-20000\n# Let's try fitting with bounds\nd_popt, d_pcov = curve_fit(\n    lorentzian, dx, dy,\n    p0=[33245, 1000, 2000, 19500],\n    bounds=([\n        32000, 100, 500, 15000\n    ], [\n        34500, 3000, 10000, 25000\n    ]),\n    maxfev=100000\n)\nd_perr = np.sqrt(np.diag(d_pcov))\ny_pred_d = lorentzian(dx, *d_popt)\nss_res_d = np.sum((dy - y_pred_d)**2)\nss_tot_d = np.sum((dy - dy.mean())**2)\nr2_d = 1 - ss_res_d/ss_tot_d\n\nprint(f\"\\n  x0={d_popt[0]:.2f} +- {d_perr[0]:.2f}\")\nprint(f\"  gamma={abs(d_popt[1"]
[388.616234, "i", "]):.2f} +- {d_perr[1]:.2f}\")\nprint(f\"  amplitude={d_popt[2]:.2f} +- {d_perr[2]:.2f}\")\nprint(f\"  offset={d_popt[3]:.2f} +- {d_perr[3]:.2f}\")\nprint(f\"  R²={r2_d:.4f}\")\n\n# Also try a wider window\nprint(\"\\n=== 2D peak with wider window (30000-38000) ===\")\ndw_mask = (x >= 30000) & (x <= 38000)\ndxw, dyw = x[dw_mask], y[dw_mask]\ndw_popt, dw_pcov = curve_fit(\n    lorentzian, dxw, dyw,\n    p0=[33245, 1500, 2500, 19000],\n    bounds=([\n        31000, 200, 100, 12000\n    ], [\n        35000, 5000, 20000, 25000\n    ]),\n    maxfev=100000\n)\ndw_perr = np.sqrt(np.diag(dw_pcov))\ny_pred_dw = lorentzian(dxw, *dw_popt)\nss_res_dw = np.sum((dyw - y_pred_dw)**2)\nss_tot_dw = np.sum((dyw - dyw.mean())**2)\nr2_dw = 1 - ss_res_dw/ss_tot_dw\n\nprint(f\"  x0={dw_popt[0]:.2f} +- {dw_perr[0]:.2f}\")\nprint(f\"  gamma={abs(dw_popt[1]):.2f} +- {dw_perr[1]:.2f}\")\nprint(f\"  amplitude={dw_popt[2]:.2f} +- {dw_perr[2]:.2f}\")\nprint(f\"  offset={dw_popt[3]:.2f} +- {dw_perr[3]:.2f}\")\nprint(f\"  R²={r2_dw:.4f}\")\n\n# Use the wider window fit if it's better\nif r"]
[388.616269, "o", "cat << 'EOF' > /app/fit3.py\r\n\u001b[?2004l\r"]
[388.616341, "i", "2_dw > r2_d:\n    print(\"\\nUsing wider window fit for 2D\")\n    best_2d = dw_popt\nelse:\n    print(\"\\nUsing narrower window fit for 2D\")\n    best_2d = d_popt\n\n# Write results\nresults = {\n    'G': {\n        'x0': float(g_popt[0]),\n        'gamma': float(abs(g_popt[1])),\n        'amplitude': float(g_popt[2]),\n        'offset': float(g_popt[3])\n    },\n    '2D': {\n        'x0': float(best_2d[0]),\n        'gamma': float(abs(best_2d[1])),\n        'amplitude': float(best_2d[2]),\n        'offset': float(best_2d[3])\n    }\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"\\nResults:\")\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit3.py\n"]
[388.616409, "o", "\u001b[?2004h> "]
[388.616968, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_data(filename):\r\n\u001b[?2004l\r\u001b[?2004h>     x_list, y_list = [], []\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filename, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         for line in f:\r\n\u001b[?2004l\r"]
[388.617071, "o", "\u001b[?2004h>             line = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.617112, "o", ">             if not line:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.617145, "o", "            parts = line.split()\r\n\u001b[?2004l\r"]
[388.617175, "o", "\u001b[?2004h> "]
[388.617209, "o", "            if len(parts) >= 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.617273, "o", "                x = float(parts[0].replace(',', '.'))\r\n\u001b[?2004l\r"]
[388.617298, "o", "\u001b[?2004h> "]
[388.617356, "o", "                y = float(parts[1].replace(',', '.'))\r\n\u001b[?2004l\r"]
[388.617378, "o", "\u001b[?2004h> "]
[388.617415, "o", "                x_list.append(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.617444, "o", "> "]
[388.617471, "o", "                y_list.append(y)\r\n\u001b[?2004l\r"]
[388.617503, "o", "\u001b[?2004h> "]
[388.617547, "o", "    return np.array(x_list), np.array(y_list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.61757, "o", "\r\n\u001b[?2004l\r"]
[388.617601, "o", "\u001b[?2004h> "]
[388.617636, "o", "def lorentzian(x, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.617659, "o", "> "]
[388.617731, "o", "    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\r\n\u001b[?2004l\r"]
[388.617754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[388.617784, "o", "\u001b[?2004h> "]
[388.61782, "o", "x, y = parse_data('/app/graphene.dat')\r\n\u001b[?2004l\r"]
[388.617864, "o", "\u001b[?2004h> "]
[388.617911, "o", "idx = np.argsort(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.61795, "o", "x = x[idx]\r\n\u001b[?2004l\r\u001b[?2004h> y = y[idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.618013, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.618063, "o", "# === G peak fit (already good) ===\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=== G peak ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.618107, "o", "> "]
[388.618153, "o", "g_mask = (x >= 16500) & (x <= 23000)\r\n\u001b[?2004l\r"]
[388.618197, "o", "\u001b[?2004h> gx, gy = x[g_mask], y[g_mask]\r\n\u001b[?2004l\r"]
[388.618251, "o", "\u001b[?2004h> "]
[388.618301, "o", "g_popt, _ = curve_fit(lorentzian, gx, gy, p0=[19139, 500, 67000, 12000], maxfev=50000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.61834, "o", "> "]
[388.618386, "o", "y_pred = lorentzian(gx, *g_popt)\r\n\u001b[?2004l\r"]
[388.618426, "o", "\u001b[?2004h> "]
[388.618471, "o", "ss_res = np.sum((gy - y_pred)**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.618511, "o", "ss_tot = np.sum((gy - gy.mean())**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.618613, "o", "print(f\"  x0={g_popt[0]:.2f}, gamma={abs(g_popt[1]):.2f}, amp={g_popt[2]:.2f}, offset={g_popt[3]:.2f}\")\r\n\u001b[?2004l\r"]
[388.618629, "o", "\u001b[?2004h> "]
[388.618707, "o", "print(f\"  R²={1-ss_res/ss_tot:.4f}\")\r\n\u001b[?2004l\r"]
[388.618757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.618803, "o", "# === 2D peak fit ===\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.618845, "o", "# Let me examine the 2D peak data more carefully\r\n\u001b[?2004l\r"]
[388.618882, "o", "\u001b[?2004h> "]
[388.618912, "o", "print(\"\\n=== 2D peak data ===\")\r\n\u001b[?2004l\r"]
[388.618946, "o", "\u001b[?2004h> "]
[388.618989, "o", "d_mask = (x >= 31000) & (x <= 36000)\r\n\u001b[?2004l\r"]
[388.619026, "o", "\u001b[?2004h> "]
[388.619058, "o", "dx, dy = x[d_mask], y[d_mask]\r\n\u001b[?2004l\r"]
[388.619099, "o", "\u001b[?2004h> "]
[388.619143, "o", "for xi, yi in zip(dx, dy):\r\n\u001b[?2004l\r"]
[388.619186, "o", "\u001b[?2004h> "]
[388.619227, "o", "    print(f\"  x={xi:.1f}, y={yi:.1f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[388.619271, "o", "\u001b[?2004h"]
[388.619311, "o", "> "]
[388.619356, "o", "# The 2D peak is very subtle: peak at 33245 (y=21253) on background ~19000-20000\r\n\u001b[?2004l\r"]
[388.619395, "o", "\u001b[?2004h> "]
[388.619436, "o", "# Let's try fitting with bounds\r\n\u001b[?2004l\r"]
[388.619475, "o", "\u001b[?2004h> "]
[388.619522, "o", "d_popt, d_pcov = curve_fit(\r\n\u001b[?2004l\r"]
[388.61957, "o", "\u001b[?2004h>     lorentzian, dx, dy,\r\n"]
[388.619607, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[388.619651, "o", "    p0=[33245, 1000, 2000, 19500],\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.619689, "o", "> "]
[388.619739, "o", "    bounds=([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.619756, "o", "        32000, 100, 500, 15000\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.619798, "o", "> "]
[388.619837, "o", "    ], [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.619881, "o", "        34500, 3000, 10000, 25000\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.61992, "o", ">     ]),\r\n"]
[388.619966, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[388.620006, "o", "    maxfev=100000\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.620038, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.620088, "o", "d_perr = np.sqrt(np.diag(d_pcov))\r\n\u001b[?2004l\r"]
[388.620129, "o", "\u001b[?2004h> "]
[388.620173, "o", "y_pred_d = lorentzian(dx, *d_popt)\r\n\u001b[?2004l\r"]
[388.620212, "o", "\u001b[?2004h> "]
[388.620257, "o", "ss_res_d = np.sum((dy - y_pred_d)**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.620283, "o", "ss_tot_d = np.sum((dy - dy.mean())**2)\r\n\u001b[?2004l\r"]
[388.620319, "o", "\u001b[?2004h> "]
[388.620364, "o", "r2_d = 1 - ss_res_d/ss_tot_d\r\n"]
[388.620402, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.620455, "o", "print(f\"\\n  x0={d_popt[0]:.2f} +- {d_perr[0]:.2f}\")\r\n\u001b[?2004l\r"]
[388.620499, "o", "\u001b[?2004h> "]
[388.62055, "o", "print(f\"  gamma={abs(d_popt[1]):.2f} +- {d_perr[1]:.2f}\")\r\n\u001b[?2004l\r"]
[388.620576, "o", "\u001b[?2004h> "]
[388.62064, "o", "print(f\"  amplitude={d_popt[2]:.2f} +- {d_perr[2]:.2f}\")\r\n\u001b[?2004l\r"]
[388.620677, "o", "\u001b[?2004h> "]
[388.620724, "o", "print(f\"  offset={d_popt[3]:.2f} +- {d_perr[3]:.2f}\")\r\n\u001b[?2004l\r"]
[388.62076, "o", "\u001b[?2004h> "]
[388.620803, "o", "print(f\"  R²={r2_d:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[388.620842, "o", "\u001b[?2004h> "]
[388.620877, "o", "# Also try a wider window\r\n\u001b[?2004l\r"]
[388.620921, "o", "\u001b[?2004h> "]
[388.620967, "o", "print(\"\\n=== 2D peak with wider window (30000-38000) ===\")\r\n\u001b[?2004l\r"]
[388.621003, "o", "\u001b[?2004h> "]
[388.621043, "o", "dw_mask = (x >= 30000) & (x <= 38000)\r\n\u001b[?2004l\r"]
[388.621083, "o", "\u001b[?2004h> "]
[388.621115, "o", "dxw, dyw = x[dw_mask], y[dw_mask]\r\n\u001b[?2004l\r"]
[388.621153, "o", "\u001b[?2004h> "]
[388.621183, "o", "dw_popt, dw_pcov = curve_fit(\r\n\u001b[?2004l\r"]
[388.621231, "o", "\u001b[?2004h> "]
[388.621269, "o", "    lorentzian, dxw, dyw,\r\n\u001b[?2004l\r"]
[388.62131, "o", "\u001b[?2004h> "]
[388.621354, "o", "    p0=[33245, 1500, 2500, 19000],\r\n\u001b[?2004l\r"]
[388.621397, "o", "\u001b[?2004h>     bounds=([\r\n"]
[388.621436, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[388.621478, "o", "        31000, 200, 100, 12000\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.621519, "o", "    ], [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.62156, "o", "        35000, 5000, 20000, 25000\r\n\u001b[?2004l\r"]
[388.6216, "o", "\u001b[?2004h>     ]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.621644, "o", "    maxfev=100000\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n"]
[388.621683, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[388.621735, "o", "dw_perr = np.sqrt(np.diag(dw_pcov))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.621774, "o", "y_pred_dw = lorentzian(dxw, *dw_popt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.621825, "o", "ss_res_dw = np.sum((dyw - y_pred_dw)**2)\r\n\u001b[?2004l\r"]
[388.621862, "o", "\u001b[?2004h> "]
[388.621898, "o", "ss_tot_dw = np.sum((dyw - dyw.mean())**2)\r\n\u001b[?2004l\r"]
[388.621938, "o", "\u001b[?2004h> "]
[388.621982, "o", "r2_dw = 1 - ss_res_dw/ss_tot_dw\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.62202, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.622052, "o", "print(f\"  x0={dw_popt[0]:.2f} +- {dw_perr[0]:.2f}\")\r\n\u001b[?2004l\r"]
[388.622097, "o", "\u001b[?2004h> "]
[388.62214, "o", "print(f\"  gamma={abs(dw_popt[1]):.2f} +- {dw_perr[1]:.2f}\")\r\n\u001b[?2004l\r"]
[388.622185, "o", "\u001b[?2004h> "]
[388.622228, "o", "print(f\"  amplitude={dw_popt[2]:.2f} +- {dw_perr[2]:.2f}\")\r\n\u001b[?2004l\r"]
[388.622275, "o", "\u001b[?2004h> "]
[388.622323, "o", "print(f\"  offset={dw_popt[3]:.2f} +- {dw_perr[3]:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.622359, "o", "> "]
[388.6224, "o", "print(f\"  R²={r2_dw:.4f}\")\r\n\u001b[?2004l\r"]
[388.622444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.622487, "o", "# Use the wider window fit if it's better\r\n\u001b[?2004l\r"]
[388.622533, "o", "\u001b[?2004h> if r2_dw > r2_d:\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.622571, "o", "> "]
[388.622615, "o", "    print(\"\\nUsing wider window fit for 2D\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.622655, "o", "    best_2d = dw_popt\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.622698, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.622731, "o", "    print(\"\\nUsing narrower window fit for 2D\")\r\n\u001b[?2004l\r"]
[388.622772, "o", "\u001b[?2004h> "]
[388.622814, "o", "    best_2d = d_popt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[388.622859, "o", "\u001b[?2004h> # Write results\r\n\u001b[?2004l\r"]
[388.622904, "o", "\u001b[?2004h> results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.622946, "o", "    'G': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.622985, "o", "        'x0': float(g_popt[0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.623021, "o", "        'gamma': float(abs(g_popt[1])),\r\n\u001b[?2004l\r\u001b[?2004h"]
[388.623065, "o", "> "]
[388.623111, "o", "        'amplitude': float(g_popt[2]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.623143, "o", "        'offset': float(g_popt[3])\r\n\u001b[?2004l\r"]
[388.62319, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.623235, "o", "    '2D': {\r\n\u001b[?2004l\r"]
[388.623267, "o", "\u001b[?2004h> "]
[388.623306, "o", "        'x0': float(best_2d[0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.623336, "o", "        'gamma': float(abs(best_2d[1])),\r\n\u001b[?2004l\r"]
[388.623376, "o", "\u001b[?2004h> "]
[388.623421, "o", "        'amplitude': float(best_2d[2]),\r\n\u001b[?2004l\r"]
[388.623461, "o", "\u001b[?2004h> "]
[388.623506, "o", "        'offset': float(best_2d[3])\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[388.623547, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[388.623588, "o", "\u001b[?2004h> "]
[388.623633, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.623673, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[388.623714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.623758, "o", "print(\"\\nResults:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[388.623803, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r"]
[388.623842, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[388.625082, "o", "\u001b[?2004hroot@j-openenv-6afd86eb884144d2f44fd3ca-pbrk5ybj-7309a-55z4k:/app# "]
[388.625165, "o", "python3 /app/fit3.py\r\n\u001b[?2004l\r"]
[389.20064, "o", "=== G peak ===\r\n"]
[389.20148, "o", "  x0=19196.97, gamma=401.11, amp=73511.25, offset=12252.62\r\n  R²=0.9521\r\n\r\n=== 2D peak data ==="]
[389.201571, "o", "\r\n  x=31037.9, y=18572.9\r\n  x=31297.3, y=18787.4\r\n  x=31561.2, y=19007.3\r\n  x=31829.6, y=19630.2\r\n  x=32102.8, y=19883.1\r\n  x=32380.8, y=20339.9\r\n  x=32663.7, y=20547.1\r\n  x=32951.7, y=21063.5\r\n"]
[389.201611, "o", "  x=33245.0, y=21252.7\r\n  x=33543.6, y=21041.2\r\n"]
[389.201661, "o", "  x=33847.7, y=20523.2\r\n  x=34157.5, y=20285.4\r\n  x=34473.2, y=19931.5\r\n  x=34794.8, y=19781.2\r\n  x=35122.7, y=19895.8\r\n"]
