[117.530507, "i", "cat << 'EOF' > /app/fit.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef parse_data(filename):\n    x_list = []\n    y_list = []\n    with open(filename, 'r') as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.split()\n            if len(parts) >= 2:\n                x = float(parts[0].replace(',', '.'))\n                y = float(parts[1].replace(',', '.'))\n                x_list.append(x)\n                y_list.append(y)\n    return np.array(x_list), np.array(y_list)\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\nx, y = parse_data('/app/graphene.dat')\n\n# Sort by wavenumber ascending\nsort_idx = np.argsort(x)\nx = x[sort_idx]\ny = y[sort_idx]\n\nprint(f\"Wavenumber range: {x.min():.2f} to {x.max():.2f}\")\nprint(f\"Intensity range: {y.min():.2f} to {y.max():.2f}\")\nprint(f\"Total points: {len(x)}\")\n\n# Find G peak (~1580 cm-1)\ng_mask = (x > 1450)"]
[117.530558, "i", " & (x < 1700)\ng_x = x[g_mask]\ng_y = y[g_mask]\nprint(f\"\\nG peak region ({g_x.min():.1f} - {g_x.max():.1f}): {len(g_x)} points\")\nprint(f\"  Max intensity: {g_y.max():.2f} at x={g_x[np.argmax(g_y)]:.2f}\")\n\n# Find 2D peak (~2700 cm-1)\ntwo_d_mask = (x > 2500) & (x < 3000)\n_2d_x = x[two_d_mask]\n_2d_y = y[two_d_mask]\nprint(f\"\\n2D peak region ({_2d_x.min():.1f} - {_2d_x.max():.1f}): {len(_2d_x)} points\")\nprint(f\"  Max intensity: {_2d_y.max():.2f} at x={_2d_x[np.argmax(_2d_y)]:.2f}\")\n\ndef fit_peak(x, y, x_guess, x_min, x_max):\n    mask = (x > x_min) & (x < x_max)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    offset_guess = np.median(y_fit[:10] + y_fit[-10:])\n    amp_guess = y_fit.max() - offset_guess\n    x0_guess = x_fit[np.argmax(y_fit)]\n    gamma_guess = 15.0  # initial guess in cm-1\n    \n    p0 = [x0_guess, gamma_guess, amp_guess, offset_guess]\n    \n    try:\n        popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=10000)\n        perr = np.sqrt(np.diag(pcov))\n        return popt, perr\n    except Exce"]
[117.53065, "i", "ption as e:\n        print(f\"  Fit error: {e}\")\n        return None, None\n\n# Fit G peak\nprint(\"\\n--- Fitting G peak ---\")\ng_popt, g_perr = fit_peak(x, y, 1580, 1450, 1700)\nif g_popt is not None:\n    print(f\"  x0={g_popt[0]:.4f} +- {g_perr[0]:.4f}\")\n    print(f\"  gamma={g_popt[1]:.4f} +- {g_perr[1]:.4f}\")\n    print(f\"  amplitude={g_popt[2]:.4f} +- {g_perr[2]:.4f}\")\n    print(f\"  offset={g_popt[3]:.4f} +- {g_perr[3]:.4f}\")\n\n# Fit 2D peak\nprint(\"\\n--- Fitting 2D peak ---\")\n_2d_popt, _2d_perr = fit_peak(x, y, 2700, 2500, 3000)\nif _2d_popt is not None:\n    print(f\"  x0={_2d_popt[0]:.4f} +- {_2d_perr[0]:.4f}\")\n    print(f\"  gamma={_2d_popt[1]:.4f} +- {_2d_perr[1]:.4f}\")\n    print(f\"  amplitude={_2d_popt[2]:.4f} +- {_2d_perr[2]:.4f}\")\n    print(f\"  offset={_2d_popt[3]:.4f} +- {_2d_perr[3]:.4f}\")\n\n# Write results\nresults = {}\nif g_popt is not None:\n    results['G'] = {\n        'x0': float(g_popt[0]),\n        'gamma': float(abs(g_popt[1])),\n        'amplitude': float(g_popt[2]),\n        'offset': float(g_popt[3])\n    }"]
[117.530709, "o", "cat << 'EOF' > /app/fit.py\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
[117.530741, "i", "\nif _2d_popt is not None:\n    results['2D'] = {\n        'x0': float(_2d_popt[0]),\n        'gamma': float(abs(_2d_popt[1])),\n        'amplitude': float(_2d_popt[2]),\n        'offset': float(_2d_popt[3])\n    }\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"\\nResults written to /app/results.json\")\nprint(json.dumps(results, indent=2))\nEOF\n"]
