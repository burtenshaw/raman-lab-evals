[389.219179, "o", "  R²=0.6606\r\n\r\nUsing narrower window fit for 2D\r\n"]
[389.219361, "o", "\r\nResults:\r\n"]
[389.219397, "o", "{\r\n  \"G\": {\r\n    \"x0\": 19196.969939656203,\r\n    \"gamma\": 401.114738273876,\r\n    \"amplitude\": 73511.25275518208,\r\n    \"offset\": 12252.619148475194\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 33416.236152159014,\r\n    \"gamma\": 1442.682829886083,\r\n    \"amplitude\": 2748.8935882079127,\r\n    \"offset\": 18340.417930283696\r\n  }\r\n}\r\n"]
[389.277518, "o", "\u001b[?2004hroot@j-openenv-6afd86eb884144d2f44fd3ca-pbrk5ybj-7309a-55z4k:/app# "]
[456.736221, "i", "cat << 'EOF' > /app/fit_final.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef parse_data(filename):\n    x_list, y_list = [], []\n    with open(filename, 'r') as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.split()\n            if len(parts) >= 2:\n                x = float(parts[0].replace(',', '.'))\n                y = float(parts[1].replace(',', '.'))\n                x_list.append(x)\n                y_list.append(y)\n    return np.array(x_list), np.array(y_list)\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\ndef lorentzian_linear(x, x0, gamma, amplitude, slope, intercept):\n    return intercept + slope*x + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\nx, y = parse_data('/app/graphene.dat')\nidx = np.argsort(x)\nx = x[idx]\ny = y[idx]\n\n# === G peak fit ===\ng_mask = (x >= 16500) & (x <= 23000)\ngx, gy = x[g_mask], y[g_mask]\ng_popt"]
[456.73636, "i", ", g_pcov = curve_fit(lorentzian, gx, gy, p0=[19139, 500, 67000, 12000], maxfev=50000)\n\n# Also try with linear background for G\ntry:\n    g_lin_popt, _ = curve_fit(lorentzian_linear, gx, gy, p0=[19139, 500, 67000, 0, 12000], maxfev=50000)\n    # At the center of the fit range, the linear background value is:\n    x_center = (gx[0] + gx[-1]) / 2\n    g_lin_offset = g_lin_popt[3] + g_lin_popt[4] * x_center\n    print(f\"G Lorentzian: x0={g_popt[0]:.2f}, gamma={abs(g_popt[1]):.2f}, amp={g_popt[2]:.2f}, offset={g_popt[3]:.2f}\")\n    print(f\"G Lorentzian+linear: x0={g_lin_popt[0]:.2f}, gamma={abs(g_lin_popt[1]):.2f}, amp={g_lin_popt[2]:.2f}, offset_at_center={g_lin_offset:.2f}\")\nexcept Exception as e:\n    print(f\"G linear fit failed: {e}\")\n\n# === 2D peak fit ===\nd_mask = (x >= 31000) & (x <= 36000)\ndx, dy = x[d_mask], y[d_mask]\nd_popt, d_pcov = curve_fit(\n    lorentzian, dx, dy,\n    p0=[33245, 1000, 2000, 19500],\n    bounds=([32000, 100, 500, 15000], [34500, 3000, 10000, 25000]),\n    maxfev=100000\n)\n\n# Try with linear bac"]
[456.736375, "o", "cat << 'EOF' > /app/fit_final.py\r\n\u001b[?2004l\r"]
[456.736383, "i", "kground for 2D\ntry:\n    d_lin_popt, d_lin_pcov = curve_fit(\n        lorentzian_linear, dx, dy,\n        p0=[33245, 1000, 2000, 0.5, 17000],\n        maxfev=100000\n    )\n    d_lin_perr = np.sqrt(np.diag(d_lin_pcov))\n    y_pred_lin = lorentzian_linear(dx, *d_lin_popt)\n    ss_res_lin = np.sum((dy - y_pred_lin)**2)\n    ss_tot = np.sum((dy - dy.mean())**2)\n    r2_lin = 1 - ss_res_lin/ss_tot\n    x_center = (dx[0] + dx[-1]) / 2\n    d_lin_offset = d_lin_popt[3] + d_lin_popt[4] * x_center\n    print(f\"\\n2D Lorentzian: x0={d_popt[0]:.2f}, gamma={abs(d_popt[1]):.2f}, amp={d_popt[2]:.2f}, offset={d_popt[3]:.2f}\")\n    print(f\"2D Lorentzian+linear: x0={d_lin_popt[0]:.2f}, gamma={abs(d_lin_popt[1]):.2f}, amp={d_lin_popt[2]:.2f}, offset_at_center={d_lin_offset:.2f}\")\n    print(f\"  R²(linear)={r2_lin:.4f}\")\nexcept Exception as e:\n    print(f\"2D linear fit failed: {e}\")\n    d_lin_popt = None\n\n# Write results - use the standard 4-parameter Lorentzian fit\nresults = {\n    'G': {\n        'x0': float(g_popt[0]),\n        'gamma': floa"]
[456.736391, "i", "t(abs(g_popt[1])),\n        'amplitude': float(g_popt[2]),\n        'offset': float(g_popt[3])\n    },\n    '2D': {\n        'x0': float(d_popt[0]),\n        'gamma': float(abs(d_popt[1])),\n        'amplitude': float(d_popt[2]),\n        'offset': float(d_popt[3])\n    }\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"\\nFinal results:\")\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit_final.py\n"]
