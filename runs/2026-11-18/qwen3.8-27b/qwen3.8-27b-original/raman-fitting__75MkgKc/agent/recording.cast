[560.95353, "i", "cat << 'EOF' > /app/fit_robust.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef parse_data(filename):\n    x_list, y_list = [], []\n    with open(filename, 'r') as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.split()\n            if len(parts) >= 2:\n                x = float(parts[0].replace(',', '.'))\n                y = float(parts[1].replace(',', '.'))\n                x_list.append(x); y_list.append(y)\n    return np.array(x_list), np.array(y_list)\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\nx, y = parse_data('/app/graphene.dat')\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\n\ndef robust_fit(xc, label):\n    best = None\n    for half in [2000, 2500, 3000, 3500, 4000]:\n        m = (x >= xc-half) & (x <= xc+half)\n        xf, yf = x[m], y[m]\n        if len(xf) < 8:\n            continue\n        for g0 in [200, 400, 700, 1000, 1500, 25"]
[560.953667, "i", "00]:\n            off0 = np.percentile(yf, 15)\n            amp0 = yf.max() - off0\n            p0 = [xf[np.argmax(yf)], g0, amp0, off0]\n            try:\n                popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=100000)\n            except Exception:\n                continue\n            yp = lorentzian(xf, *popt)\n            ssres = np.sum((yf-yp)**2)\n            sstot = np.sum((yf-yf.mean())**2)\n            r2 = 1 - ssres/sstot\n            gamma = abs(popt[1])\n            # prefer physically reasonable (positive amp, gamma within window)\n            if popt[2] <= 0 or gamma > half:\n                continue\n            score = r2\n            if best is None or score > best[0]:\n                best = (score, popt.copy(), half, g0, r2)\n    return best\n\n# G\nprint(\"=== G robust ===\")\nfor i in range(3):\n    gb = robust_fit(19139, \"G\")\n    print(f\"  run{i}: R2={gb[0]:.4f} x0={gb[1][0]:.2f} gamma={abs(gb[1][1]):.2f} amp={gb[1][2]:.2f} off={gb[1][3]:.2f} (half={gb[2]},g0={gb[3]})\")\n\n# 2D\nprint(\"=== 2D robu"]
[560.95371, "o", "cat << 'EOF' > /app/fit_robust.py\r\n\u001b[?2004l\r"]
[560.953738, "i", "st ===\")\nfor i in range(3):\n    db = robust_fit(33245, \"2D\")\n    print(f\"  run{i}: R2={db[0]:.4f} x0={db[1][0]:.2f} gamma={abs(db[1][1]):.2f} amp={db[1][2]:.2f} off={db[1][3]:.2f} (half={db[2]},g0={db[3]})\")\n\ngb = robust_fit(19139, \"G\")\ndb = robust_fit(33245, \"2D\")\n\nresults = {\n  'G': {'x0': float(gb[1][0]), 'gamma': float(abs(gb[1][1])), 'amplitude': float(gb[1][2]), 'offset': float(gb[1][3])},\n  '2D': {'x0': float(db[1][0]), 'gamma': float(abs(db[1][1])), 'amplitude': float(db[1][2]), 'offset': float(db[1][3])}\n}\nwith open('/app/results.json','w') as f:\n    json.dump(results, f, indent=2)\nprint(\"\\nFinal:\")\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit_robust.py\n"]
