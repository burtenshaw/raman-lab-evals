[312.416727, "i", "cat << 'EOF' > /app/fit2.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef parse_data(filename):\n    x_list, y_list = [], []\n    with open(filename, 'r') as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.split()\n            if len(parts) >= 2:\n                x = float(parts[0].replace(',', '.'))\n                y = float(parts[1].replace(',', '.'))\n                x_list.append(x)\n                y_list.append(y)\n    return np.array(x_list), np.array(y_list)\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)\n\nx, y = parse_data('/app/graphene.dat')\nidx = np.argsort(x)\nx = x[idx]\ny = y[idx]\n\ndef fit_peak(x, y, x_min, x_max, gamma_guess):\n    mask = (x >= x_min) & (x <= x_max)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    x0_guess = x_fit[np.argmax(y_fit)]\n    offset_guess = np.percentile(y_fit, 10)  # use 10th percentile as baselin"]
[312.416775, "i", "e\n    amp_guess = y_fit.max() - offset_guess\n    \n    p0 = [x0_guess, gamma_guess, amp_guess, offset_guess]\n    \n    # Try fitting\n    popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=50000)\n    perr = np.sqrt(np.diag(pcov))\n    \n    # Calculate R-squared\n    y_pred = lorentzian(x_fit, *popt)\n    ss_res = np.sum((y_fit - y_pred)**2)\n    ss_tot = np.sum((y_fit - np.mean(y_fit))**2)\n    r_squared = 1 - ss_res/ss_tot\n    \n    print(f\"  x0={popt[0]:.2f} +- {perr[0]:.2f}\")\n    print(f\"  gamma={abs(popt[1]):.2f} +- {perr[1]:.2f}\")\n    print(f\"  amplitude={popt[2]:.2f} +- {perr[2]:.2f}\")\n    print(f\"  offset={popt[3]:.2f} +- {perr[3]:.2f}\")\n    print(f\"  R²={r_squared:.4f}\")\n    \n    return popt, r_squared\n\n# Fit G peak - centered around 19139, broad peak\nprint(\"=== Fitting G peak ===\")\ng_popt, g_r2 = fit_peak(x, y, 16500, 23000, gamma_guess=500)\n\n# Fit 2D peak - centered around 33245, very broad\nprint(\"\\n=== Fitting 2D peak ===\")\nd_popt, d_r2 = fit_peak(x, y, 29000, 38000, gamma_guess=1500)\n\n# Write "]
[312.416945, "i", "results\nresults = {\n    'G': {\n        'x0': float(g_popt[0]),\n        'gamma': float(abs(g_popt[1])),\n        'amplitude': float(g_popt[2]),\n        'offset': float(g_popt[3])\n    },\n    '2D': {\n        'x0': float(d_popt[0]),\n        'gamma': float(abs(d_popt[1])),\n        'amplitude': float(d_popt[2]),\n        'offset': float(d_popt[3])\n    }\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"\\nResults written to /app/results.json\")\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit2.py\n"]
