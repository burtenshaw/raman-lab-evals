[258.413963, "i", "cat << 'EOF' > /app/analyze2.py\nimport numpy as np\n\nx_list = []\ny_list = []\nwith open('/app/graphene.dat', 'r') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.split()\n        if len(parts) >= 2:\n            x = float(parts[0].replace(',', '.'))\n            y = float(parts[1].replace(',', '.'))\n            x_list.append(x)\n            y_list.append(y)\n\nx = np.array(x_list)\ny = np.array(y_list)\nidx = np.argsort(x)\nx = x[idx]\ny = y[idx]\n\n# Look at data around G peak (~19139)\nprint(\"=== Data around G peak (x=19139) ===\")\ng_mask = (x > 17000) & (x < 21000)\ng_x = x[g_mask]\ng_y = y[g_mask]\nprint(f\"Points: {len(g_x)}, x range: {g_x.min():.1f} to {g_x.max():.1f}\")\nprint(f\"y range: {g_y.min():.1f} to {g_y.max():.1f}\")\n# Print data points\nfor i in range(0, len(g_x), max(1, len(g_x)//30)):\n    print(f\"  x={g_x[i]:.1f}, y={g_y[i]:.1f}\")\n\n# Look at data around 2D peak (~33245)\nprint(\"\\n=== Data around 2D peak (x=33245) ===\")\nd_mask = (x > 31000) & (x < 36"]
[258.413998, "i", "000)\nd_x = x[d_mask]\nd_y = y[d_mask]\nprint(f\"Points: {len(d_x)}, x range: {d_x.min():.1f} to {d_x.max():.1f}\")\nprint(f\"y range: {d_y.min():.1f} to {d_y.max():.1f}\")\nfor i in range(0, len(d_x), max(1, len(d_x)//30)):\n    print(f\"  x={d_x[i]:.1f}, y={d_y[i]:.1f}\")\n\n# Check if there are two separate peaks near 19139 and 19332\nprint(\"\\n=== Detailed data around 19000-19500 ===\")\ndet_mask = (x > 18800) & (x < 19600)\ndet_x = x[det_mask]\ndet_y = y[det_mask]\nfor i in range(len(det_x)):\n    print(f\"  x={det_x[i]:.2f}, y={det_y[i]:.2f}\")\nEOF\npython3 /app/analyze2.py\n"]
