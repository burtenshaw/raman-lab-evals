[192.92357, "i", "cat << 'EOF' > /app/analyze.py\nimport numpy as np\n\nx_list = []\ny_list = []\nwith open('/app/graphene.dat', 'r') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.split()\n        if len(parts) >= 2:\n            x = float(parts[0].replace(',', '.'))\n            y = float(parts[1].replace(',', '.'))\n            x_list.append(x)\n            y_list.append(y)\n\nx = np.array(x_list)\ny = np.array(y_list)\n\n# Sort by x ascending\nidx = np.argsort(x)\nx = x[idx]\ny = y[idx]\n\nprint(f\"x range: {x.min():.2f} to {x.max():.2f}\")\nprint(f\"y range: {y.min():.2f} to {y.max():.2f}\")\n\n# Find where max intensity is\nprint(f\"\\nMax intensity {y.max():.2f} at x={x[np.argmax(y)]:.2f}\")\n\n# Find all local maxima (simple: y[i] > y[i-1] and y[i] > y[i+1])\nlocal_max = []\nfor i in range(1, len(y)-1):\n    if y[i] > y[i-1] and y[i] > y[i+1]:\n        local_max.append((x[i], y[i]))\n\n# Filter significant peaks (intensity > 1000)\nsig_peaks = [(xi, yi) for xi, yi in local_max if yi > 1000]"]
[192.923702, "i", "\nsig_peaks.sort(key=lambda p: -p[1])  # sort by intensity descending\n\nprint(f\"\\nTop 20 peaks by intensity:\")\nfor xi, yi in sig_peaks[:20]:\n    print(f\"  x={xi:.2f}, intensity={yi:.2f}\")\n\n# Also show peaks in range 1500-3500\nprint(f\"\\nAll peaks in x range 1500-3500:\")\npeaks_in_range = [(xi, yi) for xi, yi in local_max if 1500 < xi < 3500]\npeaks_in_range.sort(key=lambda p: -p[1])\nfor xi, yi in peaks_in_range[:20]:\n    print(f\"  x={xi:.2f}, intensity={yi:.2f}\")\n\n# Show data around the max\nimax = np.argmax(y)\nprint(f\"\\nData around max (x={x[imax]:.2f}):\")\nfor i in range(max(0, imax-5), min(len(x), imax+5)):\n    print(f\"  x={x[i]:.2f}, y={y[i]:.2f}\")\n\n# Check if x-axis might be in different units\n# If x is in some unit, what would G (1580 cm-1) and 2D (2700 cm-1) correspond to?\n# Let's look at the ratio: 2700/1580 = 1.709\n# If G is at position a and 2D is at position b, b/a should be ~1.709\nprint(f\"\\nChecking peak ratios:\")\nfor i, (x1, y1) in enumerate(sig_peaks[:10]):\n    for j, (x2, y2) in enumerate(sig_peaks[:1"]
[192.92376, "o", "cat << 'EOF' > /app/analyze.py\r\n\u001b[?2004l\r\r\nsig_peaks.sort(key=lambda p: -p[1])  # sort by intensity descending\r\n\r\nprint(f\"\\nTop 20 peaks by intensity:\")\r\nfor xi, yi in sig_peaks[:20]:\r\n    print(f\"  x={xi:.2f}, intensity={yi:.2f}\")\r\n\r\n# Also show peaks in range 1500-3500\r\nprint("]
