[35.748644, "o", "  File \u001b[35m\"<string>\"\u001b[0m, line \u001b[35m1\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n    \u001b[1;31mimport numpy, scipy\u001b[0m; print(numpy.__version__, scipy.__version__)\r\n    \u001b[1;31m^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n\u001b[1;35mModuleNotFoundError\u001b[0m: \u001b[35mNo module named 'numpy'\u001b[0m\r\n"]
