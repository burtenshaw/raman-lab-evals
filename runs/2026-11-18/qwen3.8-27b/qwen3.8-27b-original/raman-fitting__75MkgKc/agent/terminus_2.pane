[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def parse_data(filename):
[?2004l[?2004h>     x_list, y_list = [], []
[?2004l[?2004h>     with open(filename, 'r') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line = line.strip()
[?2004l[?2004h>             if not line:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             parts = line.split()
[?2004l[?2004h>             if len(parts) >= 2:
[?2004l[?2004h>                 x = float(parts[0].replace(',', '.'))
[?2004l[?2004h>                 y = float(parts[1].replace(',', '.'))
[?2004l[?2004h>                 x_list.append(x); y_list.append(y)
[?2004l[?2004h>     return np.array(x_list), np.array(y_list)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)
[?2004l[?2004h> 
[?2004l[?2004h> x, y = parse_data('/app/graphene.dat')
[?2004l[?2004h> idx = np.argsort(x)
[?2004l[?2004h> x, y = x[idx], y[idx]
[?2004l[?2004h> 
[?2004l[?2004h> def robust_fit(xc, label):
[?2004l[?2004h>     best = None
[?2004l[?2004h>     for half in [2000, 2500, 3000, 3500, 4000]:
[?2004l[?2004h>         m = (x >= xc-half) & (x <= xc+half)
[?2004l[?2004h>         xf, yf = x[m], y[m]
[?2004l[?2004h>         if len(xf) < 8:
[?2004l[?2004h>             continue
[?2004l[?2004h>         for g0 in [200, 400, 700, 1000, 1500, 2500]:
[?2004l[?2004h>             off0 = np.percentile(yf, 15)
[?2004l[?2004h>             amp0 = yf.max() - off0
[?2004l[?2004h>             p0 = [xf[np.argmax(yf)], g0, amp0, off0]
[?2004l[?2004h>             try:
[?2004l[?2004h>                 popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=100000)
[?2004l[?2004h>             except Exception:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             yp = lorentzian(xf, *popt)
[?2004l[?2004h>             ssres = np.sum((yf-yp)**2)
[?2004l[?2004h>             sstot = np.sum((yf-yf.mean())**2)
[?2004l[?2004h>             r2 = 1 - ssres/sstot
[?2004l[?2004h>             gamma = abs(popt[1])
[?2004l[?2004h>             # prefer physically reasonable (positive amp, gamma within window)
[?2004l[?2004h>             if popt[2] <= 0 or gamma > half:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             score = r2
[?2004l[?2004h>             if best is None or score > best[0]:
[?2004l[?2004h>                 best = (score, popt.copy(), half, g0, r2)
[?2004l[?2004h>     return best
[?2004l[?2004h> 
[?2004l[?2004h> # G
[?2004l[?2004h> print("=== G robust ===")
[?2004l[?2004h> for i in range(3):
[?2004l[?2004h>     gb = robust_fit(19139, "G")
[?2004l[?2004h>     print(f"  run{i}: R2={gb[0]:.4f} x0={gb[1][0]:.2f} gamma={abs(gb[1][1]):.2f} amp={gb[1][2]:.2f} off={gb[1][3]:.2f} (half={gb[2]},g0={gb[3]})")
[?2004l[?2004h> 
[?2004l[?2004h> # 2D
[?2004l[?2004h> print("=== 2D robust ===")
[?2004l[?2004h> for i in range(3):
[?2004l[?2004h>     db = robust_fit(33245, "2D")
[?2004l[?2004h>     print(f"  run{i}: R2={db[0]:.4f} x0={db[1][0]:.2f} gamma={abs(db[1][1]):.2f} amp={db[1][2]:.2f} off={db[1][3]:.2f} (half={db[2]},g0={db[3]})")
[?2004l[?2004h> 
[?2004l[?2004h> gb = robust_fit(19139, "G")
[?2004l[?2004h> db = robust_fit(33245, "2D")
