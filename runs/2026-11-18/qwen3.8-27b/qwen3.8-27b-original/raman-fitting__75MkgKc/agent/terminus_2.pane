sig_peaks.sort(key=lambda p: -p[1])  # sort by intensity descending

print(f"\nTop 20 peaks by intensity:")
for xi, yi in sig_peaks[:20]:
    print(f"  x={xi:.2f}, intensity={yi:.2f}")

# Also show peaks in range 1500-3500
print(f"\nAll peaks in x range 1500-3500:")
peaks_in_range = [(xi, yi) for xi, yi in local_max if 1500 < xi < 3500]
peaks_in_range.sort(key=lambda p: -p[1])
for xi, yi in peaks_in_range[:20]:
    print(f"  x={xi:.2f}, intensity={yi:.2f}")

# Show data around the max
imax = np.argmax(y)
print(f"\nData around max (x={x[imax]:.2f}):")
for i in range(max(0, imax-5), min(len(x), imax+5)):
    print(f"  x={x[i]:.2f}, y={y[i]:.2f}")

# Check if x-axis might be in different units
# If x is in some unit, what would G (1580 cm-1) and 2D (2700 cm-1) correspond to?
# Let's look at the ratio: 2700/1580 = 1.709
# If G is at position a and 2D is at position b, b/a should be ~1.709
print(f"\nChecking peak ratios:")
for i, (x1, y1) in enumerate(sig_peaks[:10]):
    for j, (x2, y2) in enumerate(sig_peaks[:10]):
        if i != j and x2 > x1:
            ratio = x2/x1
            if 1.6 < ratio < 1.8:
                print(f"  x={x1:.2f} (int={y1:.0f}) and x={x2:.2f} (int={y2:.0f}), ratio={ratio:.3f}")
