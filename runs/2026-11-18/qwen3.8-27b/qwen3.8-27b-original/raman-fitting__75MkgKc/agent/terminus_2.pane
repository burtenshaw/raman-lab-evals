[?2004l[?2004h>         'gamma': float(abs(g_popt[1])),
[?2004l[?2004h>         'amplitude': float(g_popt[2]),
[?2004l[?2004h>         'offset': float(g_popt[3])
[?2004l[?2004h>     },
[?2004l[?2004h>     '2D': {
