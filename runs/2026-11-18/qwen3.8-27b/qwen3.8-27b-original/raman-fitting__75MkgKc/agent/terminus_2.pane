[?2004l[?2004h>         maxfev=100000
[?2004l[?2004h>     )
[?2004l[?2004h>     d_lin_perr = np.sqrt(np.diag(d_lin_pcov))
[?2004l[?2004h>     y_pred_lin = lorentzian_linear(dx, *d_lin_popt)
