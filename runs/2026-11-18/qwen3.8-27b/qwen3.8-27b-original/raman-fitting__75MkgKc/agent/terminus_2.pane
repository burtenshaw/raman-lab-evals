[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def parse_data(filename):
[?2004l[?2004h>     x_list = []
[?2004l[?2004h>     y_list = []
[?2004l[?2004h>     with open(filename, 'r') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line = line.strip()
[?2004l[?2004h>             if not line:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             parts = line.split()
[?2004l[?2004h>             if len(parts) >= 2:
[?2004l[?2004h>                 x = float(parts[0].replace(',', '.'))
[?2004l[?2004h>                 y = float(parts[1].replace(',', '.'))
[?2004l[?2004h>                 x_list.append(x)
[?2004l[?2004h>                 y_list.append(y)
[?2004l[?2004h>     return np.array(x_list), np.array(y_list)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)
[?2004l[?2004h> 
[?2004l[?2004h> x, y = parse_data('/app/graphene.dat')
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by wavenumber ascending
[?2004l[?2004h> sort_idx = np.argsort(x)
[?2004l[?2004h> x = x[sort_idx]
[?2004l[?2004h> y = y[sort_idx]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Wavenumber range: {x.min():.2f} to {x.max():.2f}")
[?2004l[?2004h> print(f"Intensity range: {y.min():.2f} to {y.max():.2f}")
[?2004l[?2004h> print(f"Total points: {len(x)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Find G peak (~1580 cm-1)
[?2004l[?2004h> g_mask = (x > 1450) & (x < 1700)
[?2004l[?2004h> g_x = x[g_mask]
[?2004l[?2004h> g_y = y[g_mask]
[?2004l[?2004h> print(f"\nG peak region ({g_x.min():.1f} - {g_x.max():.1f}): {len(g_x)} points")
[?2004l[?2004h> print(f"  Max intensity: {g_y.max():.2f} at x={g_x[np.argmax(g_y)]:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Find 2D peak (~2700 cm-1)
[?2004l[?2004h> two_d_mask = (x > 2500) & (x < 3000)
[?2004l[?2004h> _2d_x = x[two_d_mask]
[?2004l[?2004h> _2d_y = y[two_d_mask]
[?2004l[?2004h> print(f"\n2D peak region ({_2d_x.min():.1f} - {_2d_x.max():.1f}): {len(_2d_x)} points")
[?2004l[?2004h> print(f"  Max intensity: {_2d_y.max():.2f} at x={_2d_x[np.argmax(_2d_y)]:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, x_guess, x_min, x_max):
[?2004l[?2004h>     mask = (x > x_min) & (x < x_max)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     offset_guess = np.median(y_fit[:10] + y_fit[-10:])
[?2004l[?2004h>     amp_guess = y_fit.max() - offset_guess
[?2004l[?2004h>     x0_guess = x_fit[np.argmax(y_fit)]
[?2004l[?2004h>     gamma_guess = 15.0  # initial guess in cm-1
[?2004l[?2004h>     
[?2004l[?2004h>     p0 = [x0_guess, gamma_guess, amp_guess, offset_guess]
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=10000)
[?2004l[?2004h>         perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>         return popt, perr
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"  Fit error: {e}")
[?2004l[?2004h>         return None, None
[?2004l[?2004h> 
[?2004l[?2004h> # Fit G peak
[?2004l[?2004h> print("\n--- Fitting G peak ---")
[?2004l[?2004h> g_popt, g_perr = fit_peak(x, y, 1580, 1450, 1700)
[?2004l[?2004h> if g_popt is not None:
[?2004l[?2004h>     print(f"  x0={g_popt[0]:.4f} +- {g_perr[0]:.4f}")
[?2004l[?2004h>     print(f"  gamma={g_popt[1]:.4f} +- {g_perr[1]:.4f}")
[?2004l[?2004h>     print(f"  amplitude={g_popt[2]:.4f} +- {g_perr[2]:.4f}")
[?2004l[?2004h>     print(f"  offset={g_popt[3]:.4f} +- {g_perr[3]:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Fit 2D peak
[?2004l[?2004h> print("\n--- Fitting 2D peak ---")
[?2004l[?2004h> _2d_popt, _2d_perr = fit_peak(x, y, 2700, 2500, 3000)
[?2004l[?2004h> if _2d_popt is not None:
[?2004l[?2004h>     print(f"  x0={_2d_popt[0]:.4f} +- {_2d_perr[0]:.4f}")
[?2004l[?2004h>     print(f"  gamma={_2d_popt[1]:.4f} +- {_2d_perr[1]:.4f}")
[?2004l[?2004h>     print(f"  amplitude={_2d_popt[2]:.4f} +- {_2d_perr[2]:.4f}")
[?2004l[?2004h>     print(f"  offset={_2d_popt[3]:.4f} +- {_2d_perr[3]:.4f}")
[?2004l[?2004h> 
