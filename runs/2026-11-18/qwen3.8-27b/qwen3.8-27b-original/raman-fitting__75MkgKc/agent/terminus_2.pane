[?2004l[?2004h>     print(f"2D Lorentzian+linear: x0={d_lin_popt[0]:.2f}, gamma={abs(d_lin_popt[1]):.2f}, amp={d_lin_popt[2]:.2f}, offset_at_center={d_lin_offset:.2f}")
