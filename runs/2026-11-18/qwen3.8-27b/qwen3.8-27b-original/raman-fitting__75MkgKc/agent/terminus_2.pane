[?2004l[?2004h> y = y[idx]
[?2004l[?2004h> 
[?2004l[?2004h> # === G peak fit ===
[?2004l[?2004h> g_mask = (x >= 16500) & (x <= 23000)
[?2004l[?2004h> gx, gy = x[g_mask], y[g_mask]
[?2004l[?2004h> g_popt, g_pcov = curve_fit(lorentzian, gx, gy, p0=[19139, 500, 67000, 12000], maxfev=50000)
[?2004l[?2004h> 
[?2004l[?2004h> # Also try with linear background for G
[?2004l[?2004h> try:
[?2004l[?2004h>     g_lin_popt, _ = curve_fit(lorentzian_linear, gx, gy, p0=[19139, 500, 67000, 0, 12000], maxfev=50000)
[?2004l[?2004h>     # At the center of the fit range, the linear background value is:
[?2004l[?2004h>     x_center = (gx[0] + gx[-1]) / 2
[?2004l[?2004h>     g_lin_offset = g_lin_popt[3] + g_lin_popt[4] * x_center
[?2004l[?2004h>     print(f"G Lorentzian: x0={g_popt[0]:.2f}, gamma={abs(g_popt[1]):.2f}, amp={g_popt[2]:.2f}, offset={g_popt[3]:.2f}")
[?2004l[?2004h>     print(f"G Lorentzian+linear: x0={g_lin_popt[0]:.2f}, gamma={abs(g_lin_popt[1]):.2f}, amp={g_lin_popt[2]:.2f}, offset_at_center={g_lin_offset:.2f}")
[?2004l[?2004h> except Exception as e:
