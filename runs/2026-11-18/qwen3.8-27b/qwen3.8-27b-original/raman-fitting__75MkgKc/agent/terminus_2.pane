[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def parse_data(filename):
[?2004l[?2004h>     x_list, y_list = [], []
[?2004l[?2004h>     with open(filename, 'r') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line = line.strip()
[?2004l[?2004h>             if not line:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             parts = line.split()
[?2004l[?2004h>             if len(parts) >= 2:
[?2004l[?2004h>                 x = float(parts[0].replace(',', '.'))
[?2004l[?2004h>                 y = float(parts[1].replace(',', '.'))
[?2004l[?2004h>                 x_list.append(x)
[?2004l[?2004h>                 y_list.append(y)
[?2004l[?2004h>     return np.array(x_list), np.array(y_list)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return offset + amplitude * gamma**2 / ((x - x0)**2 + gamma**2)
[?2004l[?2004h> 
[?2004l[?2004h> x, y = parse_data('/app/graphene.dat')
[?2004l[?2004h> idx = np.argsort(x)
[?2004l[?2004h> x = x[idx]
[?2004l[?2004h> y = y[idx]
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, x_min, x_max, gamma_guess):
[?2004l[?2004h>     mask = (x >= x_min) & (x <= x_max)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     x0_guess = x_fit[np.argmax(y_fit)]
[?2004l[?2004h>     offset_guess = np.percentile(y_fit, 10)  # use 10th percentile as baseline
[?2004l[?2004h>     amp_guess = y_fit.max() - offset_guess
[?2004l[?2004h>     
[?2004l[?2004h>     p0 = [x0_guess, gamma_guess, amp_guess, offset_guess]
[?2004l[?2004h>     
[?2004l[?2004h>     # Try fitting
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=50000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate R-squared
[?2004l[?2004h>     y_pred = lorentzian(x_fit, *popt)
[?2004l[?2004h>     ss_res = np.sum((y_fit - y_pred)**2)
[?2004l[?2004h>     ss_tot = np.sum((y_fit - np.mean(y_fit))**2)
[?2004l[?2004h>     r_squared = 1 - ss_res/ss_tot
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"  x0={popt[0]:.2f} +- {perr[0]:.2f}")
[?2004l[?2004h>     print(f"  gamma={abs(popt[1]):.2f} +- {perr[1]:.2f}")
[?2004l[?2004h>     print(f"  amplitude={popt[2]:.2f} +- {perr[2]:.2f}")
[?2004l[?2004h>     print(f"  offset={popt[3]:.2f} +- {perr[3]:.2f}")
[?2004l[?2004h>     print(f"  R²={r_squared:.4f}")
[?2004l[?2004h>     
[?2004l[?2004h>     return popt, r_squared
[?2004l[?2004h> 
[?2004l[?2004h> # Fit G peak - centered around 19139, broad peak
[?2004l[?2004h> print("=== Fitting G peak ===")
[?2004l[?2004h> g_popt, g_r2 = fit_peak(x, y, 16500, 23000, gamma_guess=500)
[?2004l[?2004h> 
[?2004l[?2004h> # Fit 2D peak - centered around 33245, very broad
[?2004l[?2004h> print("\n=== Fitting 2D peak ===")
[?2004l[?2004h> d_popt, d_r2 = fit_peak(x, y, 29000, 38000, gamma_guess=1500)
[?2004l[?2004h> 
