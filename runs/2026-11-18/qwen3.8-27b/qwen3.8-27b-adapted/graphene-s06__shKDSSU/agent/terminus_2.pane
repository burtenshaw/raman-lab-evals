[?2004l[?2004h>     }
[?2004l[?2004h>     print(f"{name}: x0={x0:.3f}, gamma={gamma:.3f}, amp={amp:.3f}, offset={offset:.3f}")
[?2004l[?2004h> 
[?2004l[?2004h> id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> results['ID_IG'] = float(id_ig)
