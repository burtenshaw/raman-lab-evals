[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, amplitude, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x, y = data[:,0], data[:,1]
[?2004l[?2004h> peaks = {'D':(1250,1480),'G':(1480,1700),'2D':(2550,2850)}
[?2004l[?2004h> params = {'D':[1346.7176,4849.509,14.985,883.702],
[?2004l[?2004h>           'G':[1579.566,8863.445,9.954,902.494],
[?2004l[?2004h>           '2D':[2693.422,18461.691,29.035,1004.294]}
[?2004l[?2004h> for name,(lo,hi) in peaks.items():
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     p=params[name]
[?2004l[?2004h>     yfit=lorentzian(x[m],*p)
[?2004l[?2004h>     ss_res=np.sum((y[m]-yfit)**2)
[?2004l[?2004h>     ss_tot=np.sum((y[m]-y[m].mean())**2)
[?2004l[?2004h>     r2=1-ss_res/ss_tot
[?2004l[?2004h>     rmse=np.sqrt(ss_res/len(x[m]))
[?2004l[?2004h>     print(f"{name}: R2={r2:.5f}, RMSE={rmse:.2f}, npts={m.sum()}")
[?2004l[?2004h> EOF
