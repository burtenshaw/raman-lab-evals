[?2004l[?2004h>     # initial guesses
[?2004l[?2004h>     offset0 = np.percentile(yw, 10)
[?2004l[?2004h>     amp0 = yw.max() - offset0
[?2004l[?2004h>     x0_0 = xw[np.argmax(yw)]
[?2004l[?2004h>     gamma0 = 25.0
[?2004l[?2004h>     p0 = [x0_0, amp0, gamma0, offset0]
[?2004l[?2004h>     bounds = ([lo, 0, 1, 0], [hi, amp0*10, 200, max(yw)*3])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xw, yw, p0=p0, bounds=bounds, maxfev=100000)
[?2004l[?2004h>     x0, amp, gamma, offset = popt
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amp),
