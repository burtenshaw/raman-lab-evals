[124.132598, "i", "cat << 'EOF' > /app/verify.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, x0, amplitude, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:,0], data[:,1]\npeaks = {'D':(1250,1480),'G':(1480,1700),'2D':(2550,2850)}\nparams = {'D':[1346.7176,4849.509,14.985,883.702],\n          'G':[1579.566,8863.445,9.954,902.494],\n          '2D':[2693.422,18461.691,29.035,1004.294]}\nfor name,(lo,hi) in peaks.items():\n    m=(x>=lo)&(x<=hi)\n    p=params[name]\n    yfit=lorentzian(x[m],*p)\n    ss_res=np.sum((y[m]-yfit)**2)\n    ss_tot=np.sum((y[m]-y[m].mean())**2)\n    r2=1-ss_res/ss_tot\n    rmse=np.sqrt(ss_res/len(x[m]))\n    print(f\"{name}: R2={r2:.5f}, RMSE={rmse:.2f}, npts={m.sum()}\")\nEOF\npython3 /app/verify.py\n"]
