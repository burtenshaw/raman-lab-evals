[77.860532, "i", "cat << 'EOF' > /app/fit_peaks.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, x0, amplitude, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = data[:, 0]\ny = data[:, 1]\n\npeaks = {\n    'D':  (1350, 1250, 1480),   # center, window_lo, window_hi\n    'G':  (1580, 1480, 1700),\n    '2D': (2690, 2550, 2850),\n}\n\nresults = {}\nfor name, (center, lo, hi) in peaks.items():\n    mask = (x >= lo) & (x <= hi)\n    xw, yw = x[mask], y[mask]\n    # initial guesses\n    offset0 = np.percentile(yw, 10)\n    amp0 = yw.max() - offset0\n    x0_0 = xw[np.argmax(yw)]\n    gamma0 = 25.0\n    p0 = [x0_0, amp0, gamma0, offset0]\n    bounds = ([lo, 0, 1, 0], [hi, amp0*10, 200, max(yw)*3])\n    popt, pcov = curve_fit(lorentzian, xw, yw, p0=p0, bounds=bounds, maxfev=100000)\n    x0, amp, gamma, offset = popt\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude':"]
[77.860679, "i", " float(amp),\n        'offset': float(offset)\n    }\n    print(f\"{name}: x0={x0:.3f}, gamma={gamma:.3f}, amp={amp:.3f}, offset={offset:.3f}\")\n\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nresults['ID_IG'] = float(id_ig)\nprint(f\"ID/IG = {id_ig:.4f}\")\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(\"Written to /app/results.json\")\nEOF\n"]
