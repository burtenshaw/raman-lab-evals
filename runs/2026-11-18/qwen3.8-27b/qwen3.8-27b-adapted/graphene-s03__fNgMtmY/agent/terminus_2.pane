[?2004l[?2004h> import csv, json, math
[?2004l[?2004h> 
[?2004l[?2004h> xs=[]; ys=[]
[?2004l[?2004h> with open('/app/spectrum.csv') as f:
[?2004l[?2004h>     r=csv.DictReader(f)
[?2004l[?2004h>     for row in r:
[?2004l[?2004h>         xs.append(float(row['raman_shift_cm-1']))
[?2004l[?2004h>         ys.append(float(row['intensity']))
[?2004l[?2004h> 
[?2004l[?2004h> def model(x, A, x0, g, C):
[?2004l[?2004h>     d=(x-x0)**2 + g*g
[?2004l[?2004h>     return A*g*g/d + C
[?2004l[?2004h> 
[?2004l[?2004h> def solve4(A, b):
[?2004l[?2004h>     # A: 4x4, b: len4 ; gaussian elimination with partial pivoting
[?2004l[?2004h>     M=[list(A[i])+[b[i]] for i in range(4)]
[?2004l[?2004h>     for col in range(4):
[?2004l[?2004h>         piv=max(range(col,4), key=lambda i: abs(M[i][col]))
[?2004l[?2004h>         M[col],M[piv]=M[piv],M[col]
[?2004l[?2004h>         pv=M[col][col]
[?2004l[?2004h>         for r2 in range(col+1,4):
[?2004l[?2004h>             f=M[r2][col]/pv
[?2004l[?2004h>             for c2 in range(col,5):
[?2004l[?2004h>                 M[r2][c2]-=f*M[col][c2]
[?2004l[?2004h>     x=[0.0]*4
[?2004l[?2004h>     for i in range(3,-1,-1):
[?2004l[?2004h>         s=M[i][4]
[?2004l[?2004h>         for c2 in range(i+1,4):
[?2004l[?2004h>             s-=M[i][c2]*x[c2]
[?2004l[?2004h>         x[i]=s/M[i][i]
[?2004l[?2004h>     return x
[?2004l[?2004h> 
[?2004l[?2004h> def fit(win_lo, win_hi):
[?2004l[?2004h>     idx=[i for i,x in enumerate(xs) if win_lo<=x<=win_hi]
[?2004l[?2004h>     X=[xs[i] for i in idx]; Y=[ys[i] for i in idx]
[?2004l[?2004h>     n=len(X)
[?2004l[?2004h>     # initial guesses
[?2004l[?2004h>     imax=X.index(max(X))
[?2004l[?2004h>     imaxy=Y.index(max(Y))
[?2004l[?2004h>     x0_0=X[imaxy]
[?2004l[?2004h>     edges=Y[:max(3,n//8)]+Y[-max(3,n//8):]
[?2004l[?2004h>     edges_sorted=sorted(edges)
[?2004l[?2004h>     C0=edges_sorted[len(edges_sorted)//2]
[?2004l[?2004h>     A0=max(Y)-C0
[?2004l[?2004h>     # FWHM estimate
[?2004l[?2004h>     half=C0+(max(Y)-C0)/2
[?2004l[?2004h>     li=None; ri=None
[?2004l[?2004h>     for i in range(imaxy,-1,-1):
[?2004l[?2004h>         if Y[i]<=half: li=X[i]; break
[?2004l[?2004h>     for i in range(imaxy,n):
[?2004l[?2004h>         if Y[i]<=half: ri=X[i]; break
[?2004l[?2004h>     if li is None: li=x0_0-20
[?2004l[?2004h>     if ri is None: ri=x0_0+20
[?2004l[?2004h>     g0=max(2.0,(ri-li)/2.0)
[?2004l[?2004h>     p=[A0, x0_0, g0, C0]
[?2004l[?2004h>     # Gauss-Newton
[?2004l[?2004h>     for it in range(200):
[?2004l[?2004h>         # residuals and Jacobian
[?2004l[?2004h>         rres=[]; J=[[0.0]*4 for _ in range(n)]
[?2004l[?2004h>         for i in range(n):
[?2004l[?2004h>             x=X[i]
[?2004l[?2004h>             f=model(x,*p)
[?2004l[?2004h>             rres.append(Y[i]-f)
[?2004l[?2004h>             A,x0,g,C=p
[?2004l[?2004h>             den=(x-x0)**2 + g*g
[?2004l[?2004h>             L=1.0/den            # 1/den
[?2004l[?2004h>             dAdx = g*g*den         # d/dA
[?2004l[?2004h>             # d f / dA = g^2/den
[?2004l[?2004h>             J[i][0]=g*g*den        # placeholder
[?2004l[?2004h>             # correct:
[?2004l[?2004h>             J[i][0]=g*g/den
[?2004l[?2004h>             # d f / dx0 = A*g^2 * d(1/den)/dx0 ; d(1/den)/dx0 = - (1/den^2)* d(den)/dx0 ; d(den)/dx0 = -2(x-x0)
[?2004l[?2004h>             J[i][1]=A*g*g*(-1.0)/(den*den)*(-2*(x-x0))
[?2004l[?2004h>             # d f / dg = A * d(g^2/den)/dg = A*(2g*den - g^2*2g)/(den^2) = A*(2g*den - 2g^3)/den^2 = 2A g (den - g^2)/den^2
[?2004l[?2004h>             J[i][2]=A*(2.0*g*den - 2.0*g*g*g)/(den*den)
[?2004l[?2004h>             J[i][3]=1.0
[?2004l[?2004h>         # build JtJ (4x4) and Jtr
[?2004l[?2004h>         JtJ=[[0.0]*4 for _ in range(4)]
[?2004l[?2004h>         Jtr=[0.0]*4
[?2004l[?2004h>         for i in range(n):
[?2004l[?2004h>             ri=rres[i]
[?2004l[?2004h>             for a in range(4):
[?2004l[?2004h>                 Jtr[a]+=J[i][a]*ri
[?2004l[?2004h>                 for b in range(4):
[?2004l[?2004h>                     JtJ[a][b]+=J[i][a]*J[i][b]
[?2004l[?2004h>         # add small regularization
[?2004l[?2004h>         lam=1e-6
[?2004l[?2004h>         for a in range(4): JtJ[a][a]+=lam
[?2004l[?2004h>         dp=solve4(JtJ,Jtr)
[?2004l[?2004h>         # step, ensure gamma positive
[?2004l[?2004h>         newg=p[2]+dp[2]
[?2004l[?2004h>         scale=1.0
[?2004l[?2004h>         if newg<=0.1:
[?2004l[?2004h>             scale=0.5
[?2004l[?2004h>             while p[2]+scale*dp[2]<=0.1 and scale>1e-4:
[?2004l[?2004h>                 scale*=0.5
[?2004l[?2004h>         # accept
[?2004l[?2004h>         p=[p[k]+scale*dp[k] for k in range(4)]
[?2004l[?2004h>         if max(abs(scale*dp[k]) for k in range(4))<1e-9:
[?2004l[?2004h>             break
[?2004l[?2004h>     # final fit quality
[?2004l[?2004h>     ssr=sum((Y[i]-model(X[i],*p))**2 for i in range(n))
[?2004l[?2004h>     return p,ssr
[?2004l[?2004h> 
[?2004l[?2004h> windows={'D':(1250,1450),'G':(1480,1690),'2D':(2540,2820)}
[?2004l[?2004h> res={}
[?2004l[?2004h> for name,(lo,hi) in windows.items():
[?2004l[?2004h>     p,ssr=fit(lo,hi)
[?2004l[?2004h>     A,x0,g,C=p
[?2004l[?2004h>     res[name]={'x0':float(x0),'gamma':float(g),'amplitude':float(A),'offset':float(C)}
[?2004l[?2004h>     print(f'{name}: x0={x0:.4f} gamma={g:.4f} A={A:.4f} C={C:.4f} ssr={ssr:.4f}')
[?2004l[?2004h> 
[?2004l[?2004h> res['ID_IG']=res['D']['amplitude']/res['G']['amplitude']
[?2004l[?2004h> print('ID_IG',res['ID_IG'])
[?2004l[?2004h> with open('/app/results.json','w') as f:
