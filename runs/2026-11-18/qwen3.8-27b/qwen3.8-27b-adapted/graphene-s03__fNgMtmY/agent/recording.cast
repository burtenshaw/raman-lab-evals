[357.806156, "o", "2D: x0=2676.5341 gamma=28.5189 A=9969.5784 C=792.3959 R2=0.99917\r\nID_IG 0.8014880326200352\r\n"]
[357.807055, "o", "written\r\n"]
[357.874957, "o", "\u001b[?2004hroot@j-openenv-6afd8e9329e8b7ccfbbb8447-2c4hzlyc-bc90a-l7rvm:/app# "]
