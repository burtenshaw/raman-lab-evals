[179.975183, "o", "Successfully installed numpy-2.5.5 scipy-1.18.1\r\nWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\r\n\r\n[notice] A new release of pip is available: 26.2.2 -> 26.3\r\n[notice] To update, run: pip install --upgrade pip\r\n"]
[279.406225, "i", "cat > /app/fit.py << 'EOF'\nimport csv, json, math\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\n\ndef model(x, A, x0, g, C):\n    d=(x-x0)**2 + g*g\n    return A*g*g/d + C\n\ndef solve4(A, b):\n    # A: 4x4, b: len4 ; gaussian elimination with partial pivoting\n    M=[list(A[i])+[b[i]] for i in range(4)]\n    for col in range(4):\n        piv=max(range(col,4), key=lambda i: abs(M[i][col]))\n        M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for r2 in range(col+1,4):\n            f=M[r2][col]/pv\n            for c2 in range(col,5):\n                M[r2][c2]-=f*M[col][c2]\n    x=[0.0]*4\n    for i in range(3,-1,-1):\n        s=M[i][4]\n        for c2 in range(i+1,4):\n            s-=M[i][c2]*x[c2]\n        x[i]=s/M[i][i]\n    return x\n\ndef fit(win_lo, win_hi):\n    idx=[i for i,x in enumerate(xs) if win_lo<=x<=win_hi]\n    X=[xs[i] for i in idx]; Y=[ys[i] for i in idx]\n    n=len"]
[279.406374, "i", "(X)\n    # initial guesses\n    imax=X.index(max(X))\n    imaxy=Y.index(max(Y))\n    x0_0=X[imaxy]\n    edges=Y[:max(3,n//8)]+Y[-max(3,n//8):]\n    edges_sorted=sorted(edges)\n    C0=edges_sorted[len(edges_sorted)//2]\n    A0=max(Y)-C0\n    # FWHM estimate\n    half=C0+(max(Y)-C0)/2\n    li=None; ri=None\n    for i in range(imaxy,-1,-1):\n        if Y[i]<=half: li=X[i]; break\n    for i in range(imaxy,n):\n        if Y[i]<=half: ri=X[i]; break\n    if li is None: li=x0_0-20\n    if ri is None: ri=x0_0+20\n    g0=max(2.0,(ri-li)/2.0)\n    p=[A0, x0_0, g0, C0]\n    # Gauss-Newton\n    for it in range(200):\n        # residuals and Jacobian\n        rres=[]; J=[[0.0]*4 for _ in range(n)]\n        for i in range(n):\n            x=X[i]\n            f=model(x,*p)\n            rres.append(Y[i]-f)\n            A,x0,g,C=p\n            den=(x-x0)**2 + g*g\n            L=1.0/den            # 1/den\n            dAdx = g*g*den         # d/dA\n            # d f / dA = g^2/den\n            J[i][0]=g*g*den        # placeholder\n            # correct:\n      "]
[279.406438, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.40646, "i", "      J[i][0]=g*g/den\n            # d f / dx0 = A*g^2 * d(1/den)/dx0 ; d(1/den)/dx0 = - (1/den^2)* d(den)/dx0 ; d(den)/dx0 = -2(x-x0)\n            J[i][1]=A*g*g*(-1.0)/(den*den)*(-2*(x-x0))\n            # d f / dg = A * d(g^2/den)/dg = A*(2g*den - g^2*2g)/(den^2) = A*(2g*den - 2g^3)/den^2 = 2A g (den - g^2)/den^2\n            J[i][2]=A*(2.0*g*den - 2.0*g*g*g)/(den*den)\n            J[i][3]=1.0\n        # build JtJ (4x4) and Jtr\n        JtJ=[[0.0]*4 for _ in range(4)]\n        Jtr=[0.0]*4\n        for i in range(n):\n            ri=rres[i]\n            for a in range(4):\n                Jtr[a]+=J[i][a]*ri\n                for b in range(4):\n                    JtJ[a][b]+=J[i][a]*J[i][b]\n        # add small regularization\n        lam=1e-6\n        for a in range(4): JtJ[a][a]+=lam\n        dp=solve4(JtJ,Jtr)\n        # step, ensure gamma positive\n        newg=p[2]+dp[2]\n        scale=1.0\n        if newg<=0.1:\n            scale=0.5\n            while p[2]+scale*dp[2]<=0.1 and scale>1e-4:\n                scale*=0.5\n        # a"]
[279.406521, "o", "> import csv, json, math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.406568, "i", "ccept\n        p=[p[k]+scale*dp[k] for k in range(4)]\n        if max(abs(scale*dp[k]) for k in range(4))<1e-9:\n            break\n    # final fit quality\n    ssr=sum((Y[i]-model(X[i],*p))**2 for i in range(n))\n    return p,ssr\n\nwindows={'D':(1250,1450),'G':(1480,1690),'2D':(2540,2820)}\nres={}\nfor name,(lo,hi) in windows.items():\n    p,ssr=fit(lo,hi)\n    A,x0,g,C=p\n    res[name]={'x0':float(x0),'gamma':float(g),'amplitude':float(A),'offset':float(C)}\n    print(f'{name}: x0={x0:.4f} gamma={g:.4f} A={A:.4f} C={C:.4f} ssr={ssr:.4f}')\n\nres['ID_IG']=res['D']['amplitude']/res['G']['amplitude']\nprint('ID_IG',res['ID_IG'])\nwith open('/app/results.json','w') as f:\n    json.dump(res,f,indent=2)\nprint('written')\nEOF\npython3 /app/fit.py\n"]
[279.406608, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> xs=[]; ys=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.406665, "o", "with open('/app/spectrum.csv') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.40674, "o", "    r=csv.DictReader(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.406801, "o", ">     for row in r:\r\n\u001b[?2004l\r"]
[279.406838, "o", "\u001b[?2004h> "]
[279.406886, "o", "        xs.append(float(row['raman_shift_cm-1']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.406918, "o", "        ys.append(float(row['intensity']))\r\n\u001b[?2004l\r"]
[279.406964, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.406995, "o", "\u001b[?2004h> "]
[279.407037, "o", "def model(x, A, x0, g, C):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.407084, "o", "    d=(x-x0)**2 + g*g\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.407126, "o", "    return A*g*g/d + C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.407177, "o", "\u001b[?2004h> def solve4(A, b):\r\n\u001b[?2004l\r"]
[279.40722, "o", "\u001b[?2004h> "]
[279.407305, "o", "    # A: 4x4, b: len4 ; gaussian elimination with partial pivoting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.407345, "o", "    M=[list(A[i])+[b[i]] for i in range(4)]\r\n\u001b[?2004l\r"]
[279.407391, "o", "\u001b[?2004h> "]
[279.407433, "o", "    for col in range(4):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.407486, "o", "        piv=max(range(col,4), key=lambda i: abs(M[i][col]))\r\n\u001b[?2004l\r"]
[279.407526, "o", "\u001b[?2004h> "]
[279.407573, "o", "        M[col],M[piv]=M[piv],M[col]\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.407604, "o", "> "]
[279.407647, "o", "        pv=M[col][col]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.407701, "o", "        for r2 in range(col+1,4):\r\n\u001b[?2004l\r"]
[279.407754, "o", "\u001b[?2004h>             f=M[r2][col]/pv\r\n\u001b[?2004l\r"]
[279.407786, "o", "\u001b[?2004h> "]
[279.407828, "o", "            for c2 in range(col,5):\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.407876, "o", "> "]
[279.407907, "o", "                M[r2][c2]-=f*M[col][c2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.407949, "o", "    x=[0.0]*4\r\n\u001b[?2004l\r"]
[279.407995, "o", "\u001b[?2004h> "]
[279.408039, "o", "    for i in range(3,-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.408071, "o", "        s=M[i][4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.40811, "o", "        for c2 in range(i+1,4):\r\n\u001b[?2004l\r"]
[279.408163, "o", "\u001b[?2004h> "]
[279.408194, "o", "            s-=M[i][c2]*x[c2]\r\n\u001b[?2004l\r"]
[279.40823, "o", "\u001b[?2004h> "]
[279.408253, "o", "        x[i]=s/M[i][i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.408287, "o", "    return x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.408328, "o", "\r\n\u001b[?2004l\r"]
[279.408367, "o", "\u001b[?2004h> def fit(win_lo, win_hi):\r\n"]
[279.408411, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[279.408464, "o", "    idx=[i for i,x in enumerate(xs) if win_lo<=x<=win_hi]\r\n\u001b[?2004l\r"]
[279.408506, "o", "\u001b[?2004h> "]
[279.408555, "o", "    X=[xs[i] for i in idx]; Y=[ys[i] for i in idx]\r\n\u001b[?2004l\r"]
[279.408598, "o", "\u001b[?2004h> "]
[279.408643, "o", "    n=len(X)\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.408686, "o", ">     # initial guesses\r\n\u001b[?2004l\r"]
[279.408728, "o", "\u001b[?2004h> "]
[279.408775, "o", "    imax=X.index(max(X))\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.408823, "o", ">     imaxy=Y.index(max(Y))\r\n\u001b[?2004l\r"]
[279.40886, "o", "\u001b[?2004h> "]
[279.408905, "o", "    x0_0=X[imaxy]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.408948, "o", "    edges=Y[:max(3,n//8)]+Y[-max(3,n//8):]\r\n\u001b[?2004l\r"]
[279.40899, "o", "\u001b[?2004h> "]
[279.409021, "o", "    edges_sorted=sorted(edges)\r\n\u001b[?2004l\r"]
[279.409065, "o", "\u001b[?2004h> "]
[279.409146, "o", "    C0=edges_sorted[len(edges_sorted)//2]\r\n\u001b[?2004l\r"]
[279.409186, "o", "\u001b[?2004h> "]
[279.40922, "o", "    A0=max(Y)-C0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409262, "o", "    # FWHM estimate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409304, "o", "    half=C0+(max(Y)-C0)/2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409347, "o", "    li=None; ri=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409402, "o", "    for i in range(imaxy,-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409479, "o", "        if Y[i]<=half: li=X[i]; break\r\n\u001b[?2004l\r"]
[279.40956, "o", "\u001b[?2004h> "]
[279.409606, "o", "    for i in range(imaxy,n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409692, "o", "        if Y[i]<=half: ri=X[i]; break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409741, "o", "    if li is None: li=x0_0-20\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.409798, "o", "    if ri is None: ri=x0_0+20\r\n\u001b[?2004l\r"]
[279.409832, "o", "\u001b[?2004h> "]
[279.409865, "o", "    g0=max(2.0,(ri-li)/2.0)\r\n\u001b[?2004l\r"]
[279.409881, "o", "\u001b[?2004h> "]
[279.409935, "o", "    p=[A0, x0_0, g0, C0]\r\n\u001b[?2004l\r"]
[279.409968, "o", "\u001b[?2004h> "]
[279.410002, "o", "    # Gauss-Newton\r\n\u001b[?2004l\r"]
[279.410033, "o", "\u001b[?2004h> "]
[279.410076, "o", "    for it in range(200):\r\n\u001b[?2004l\r"]
[279.410114, "o", "\u001b[?2004h"]
[279.410146, "o", "> "]
[279.410182, "o", "        # residuals and Jacobian\r\n\u001b[?2004l\r"]
[279.410213, "o", "\u001b[?2004h> "]
[279.410283, "o", "        rres=[]; J=[[0.0]*4 for _ in range(n)]\r\n\u001b[?2004l\r"]
[279.410314, "o", "\u001b[?2004h> "]
[279.410345, "o", "        for i in range(n):\r\n\u001b[?2004l\r"]
[279.410376, "o", "\u001b[?2004h> "]
[279.410418, "o", "            x=X[i]\r\n\u001b[?2004l\r"]
[279.410448, "o", "\u001b[?2004h> "]
[279.410481, "o", "            f=model(x,*p)\r\n\u001b[?2004l\r"]
[279.410515, "o", "\u001b[?2004h> "]
[279.410562, "o", "            rres.append(Y[i]-f)\r\n\u001b[?2004l\r"]
[279.41059, "o", "\u001b[?2004h> "]
[279.410625, "o", "            A,x0,g,C=p\r\n\u001b[?2004l\r"]
[279.410666, "o", "\u001b[?2004h> "]
[279.410704, "o", "            den=(x-x0)**2 + g*g\r\n\u001b[?2004l\r"]
[279.410731, "o", "\u001b[?2004h> "]
[279.410803, "o", "            L=1.0/den            # 1/den\r\n\u001b[?2004l\r"]
[279.410837, "o", "\u001b[?2004h> "]
[279.410883, "o", "            dAdx = g*g*den         # d/dA\r\n\u001b[?2004l\r"]
[279.410941, "o", "\u001b[?2004h> "]
[279.410969, "o", "            # d f / dA = g^2/den\r\n\u001b[?2004l\r"]
[279.410986, "o", "\u001b[?2004h> "]
[279.411073, "o", "            J[i][0]=g*g*den        # placeholder\r\n\u001b[?2004l\r"]
[279.411108, "o", "\u001b[?2004h> "]
[279.411142, "o", "            # correct:\r\n\u001b[?2004l\r"]
[279.41119, "o", "\u001b[?2004h> "]
[279.411231, "o", "            J[i][0]=g*g/den\r\n\u001b[?2004l\r"]
[279.41127, "o", "\u001b[?2004h> "]
[279.411386, "o", "            # d f / dx0 = A*g^2 * d(1/den)/dx0 ; d(1/den)/dx0 = - (1/den^2)* d(den)/dx0 ; d(den)/dx0 = -2(x-x0)\r\n\u001b[?2004l\r"]
[279.411424, "o", "\u001b[?2004h> "]
[279.41148, "o", "            J[i][1]=A*g*g*(-1.0)/(den*den)*(-2*(x-x0))\r\n\u001b[?2004l\r"]
[279.411511, "o", "\u001b[?2004h> "]
[279.411656, "o", "            # d f / dg = A * d(g^2/den)/dg = A*(2g*den - g^2*2g)/(den^2) = A*(2g*den - 2g^3)/den^2 = 2A g (den - g^2)/den^2\r\n\u001b[?2004l\r"]
[279.411696, "o", "\u001b[?2004h> "]
[279.411763, "o", "            J[i][2]=A*(2.0*g*den - 2.0*g*g*g)/(den*den)\r\n\u001b[?2004l\r"]
[279.411789, "o", "\u001b[?2004h> "]
[279.41183, "o", "            J[i][3]=1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.41186, "o", "> "]
[279.411904, "o", "        # build JtJ (4x4) and Jtr\r\n\u001b[?2004l\r"]
[279.411937, "o", "\u001b[?2004h> "]
[279.411989, "o", "        JtJ=[[0.0]*4 for _ in range(4)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.412021, "o", "> "]
[279.412061, "o", "        Jtr=[0.0]*4\r\n\u001b[?2004l\r"]
[279.4121, "o", "\u001b[?2004h> "]
[279.412139, "o", "        for i in range(n):\r\n\u001b[?2004l\r"]
[279.412177, "o", "\u001b[?2004h> "]
[279.412205, "o", "            ri=rres[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.412257, "o", "            for a in range(4):\r\n\u001b[?2004l\r"]
[279.412289, "o", "\u001b[?2004h> "]
[279.412337, "o", "                Jtr[a]+=J[i][a]*ri\r\n\u001b[?2004l\r"]
[279.412367, "o", "\u001b[?2004h> "]
[279.412415, "o", "                for b in range(4):\r\n\u001b[?2004l\r"]
[279.412447, "o", "\u001b[?2004h> "]
[279.412505, "o", "                    JtJ[a][b]+=J[i][a]*J[i][b]\r\n\u001b[?2004l\r"]
[279.412537, "o", "\u001b[?2004h> "]
[279.412585, "o", "        # add small regularization\r\n\u001b[?2004l\r"]
[279.412615, "o", "\u001b[?2004h> "]
[279.412653, "o", "        lam=1e-6\r\n\u001b[?2004l\r"]
[279.412671, "o", "\u001b[?2004h> "]
[279.412733, "o", "        for a in range(4): JtJ[a][a]+=lam\r\n\u001b[?2004l\r"]
[279.412765, "o", "\u001b[?2004h> "]
[279.412802, "o", "        dp=solve4(JtJ,Jtr)\r\n\u001b[?2004l\r"]
[279.412837, "o", "\u001b[?2004h> "]
[279.412885, "o", "        # step, ensure gamma positive\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.412897, "o", "> "]
[279.412948, "o", "        newg=p[2]+dp[2]\r\n\u001b[?2004l\r"]
[279.412987, "o", "\u001b[?2004h> "]
[279.413028, "o", "        scale=1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.413063, "o", "        if newg<=0.1:\r\n\u001b[?2004l\r"]
[279.413096, "o", "\u001b[?2004h> "]
[279.413131, "o", "            scale=0.5\r\n\u001b[?2004l\r"]
[279.413169, "o", "\u001b[?2004h> "]
[279.413236, "o", "            while p[2]+scale*dp[2]<=0.1 and scale>1e-4:\r\n\u001b[?2004l\r"]
[279.413269, "o", "\u001b[?2004h> "]
[279.413308, "o", "                scale*=0.5\r\n\u001b[?2004l\r"]
[279.413339, "o", "\u001b[?2004h> "]
[279.413379, "o", "        # accept\r\n\u001b[?2004l\r"]
[279.413416, "o", "\u001b[?2004h> "]
[279.413455, "o", "        p=[p[k]+scale*dp[k] for k in range(4)]\r\n\u001b[?2004l\r"]
[279.413492, "o", "\u001b[?2004h> "]
[279.413575, "o", "        if max(abs(scale*dp[k]) for k in range(4))<1e-9:\r\n\u001b[?2004l\r"]
[279.413608, "o", "\u001b[?2004h> "]
[279.41365, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.413695, "o", "    # final fit quality\r\n\u001b[?2004l\r"]
[279.413729, "o", "\u001b[?2004h> "]
[279.413795, "o", "    ssr=sum((Y[i]-model(X[i],*p))**2 for i in range(n))\r\n\u001b[?2004l\r"]
[279.41383, "o", "\u001b[?2004h> "]
[279.413867, "o", "    return p,ssr\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.4139, "o", "\u001b[?2004h> "]
[279.413975, "o", "windows={'D':(1250,1450),'G':(1480,1690),'2D':(2540,2820)}\r\n\u001b[?2004l\r"]
[279.414007, "o", "\u001b[?2004h> "]
[279.414047, "o", "res={}\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.414089, "o", "> "]
[279.414111, "o", "for name,(lo,hi) in windows.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.414157, "o", "    p,ssr=fit(lo,hi)\r\n\u001b[?2004l\r"]
[279.414205, "o", "\u001b[?2004h> "]
[279.414253, "o", "    A,x0,g,C=p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.414354, "o", "    res[name]={'x0':float(x0),'gamma':float(g),'amplitude':float(A),'offset':float(C)}\r\n\u001b[?2004l\r"]
[279.414397, "o", "\u001b[?2004h> "]
[279.414489, "o", "    print(f'{name}: x0={x0:.4f} gamma={g:.4f} A={A:.4f} C={C:.4f} ssr={ssr:.4f}')\r\n\u001b[?2004l\r"]
[279.414531, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.41458, "o", "\u001b[?2004h> "]
[279.414615, "o", "res['ID_IG']=res['D']['amplitude']/res['G']['amplitude']\r\n\u001b[?2004l\r"]
[279.414661, "o", "\u001b[?2004h> "]
[279.41471, "o", "print('ID_IG',res['ID_IG'])"]
