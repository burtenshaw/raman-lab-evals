[170.210473, "i", "cat > /app/peak.py << 'EOF'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nfor c in [1353.5,1582.6,2676.9]:\n    print('=== around',c,'===')\n    for i,x in enumerate(xs):\n        if abs(x-c)<40 and i%2==0:\n            print(f'{x:.2f} {ys[i]:.1f}')\nEOF\npython3 /app/peak.py\n"]
