[78.603052, "i", "cat > /app/inspect.py << '\n'\nimport csv, statistics\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nprint('n',len(xs),'xmin',xs[0],'xmax',xs[-1])\nprint('ymin',min(ys),'ymax',max(ys))\n\ndef stats(a,b):\n    idx=[i for i,x in enumerate(xs) if a<=x<=b]\n    if not idx: return\n    subx=[xs[i] for i in idx]; suby=[ys[i] for i in idx]\n    imax=idx[suby.index(max(suby))]\n    imin=idx[suby.index(min(suby))]\n    # baseline from outer 10% of window\n    n=len(idx)\n    edge=idx[:max(1,n//10)]+idx[-max(1,n//10):]\n    base=statistics.median([ys[i] for i in edge])\n    half=max(suby[imax.index? if False else 0],0) # placeholder not run\n    print(f'window {a}-{b}: max={max(suby):.3f}@{xs[imax]:.2f}, min={min(suby):.3f}@{xs[imin]:.2f}, base={base:.3f}')\n\nfor a,b in [(1200,1500),(1400,1750),(2400,2900),(1250,1450),(1480,1680),(2550,2850)]:\n    stats(a,b)\n\n# rough half max around each\nfor c in [1"]
[78.603321, "i", "350,1580,2690]:\n    idx=[i for i,x in enumerate(xs) if abs(x-c)<200]\n    subx=[xs[i] for i in idx]; suby=[ys[i] for i in idx]\n    base=statistics.median([ys[i] for i in idx[:20]+idx[-20:]])\n    imax=idx[suby.index(max(suby))]\n    peak=ys[imax]\n    half=base+(peak-base)/2\n    left=None; right=None\n    for i in range(idx.index(imax), -1, -1):\n        if ys[i] <= half:\n            left=xs[i]; break\n    for i in range(idx.index(imax), len(idx)):\n        if ys[i] <= half:\n            right=xs[i]; break\n    print(f'peak {c}: peak={peak:.3f}@{xs[imax]:.2f}, base={base:.3f}, half={half:.3f}, FWHM approx={right-left if left and right else None:.3f}')\n'\npython3 /app/inspect.py\n"]
