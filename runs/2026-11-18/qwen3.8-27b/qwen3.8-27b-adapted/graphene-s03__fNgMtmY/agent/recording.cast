[112.589356, "o", "    base=statistics.median([ys[i] for i in idx[:20]+idx[-20:]])\r\n\u001b[?2004l\r"]
[112.589386, "o", "\u001b[?2004h> "]
[112.589452, "o", "    imax=idx[suby.index(max(suby))]\r\n\u001b[?2004l\r"]
[112.589488, "o", "\u001b[?2004h> "]
[112.58953, "o", "    peak=ys[imax]\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.589566, "o", "> "]
[112.589596, "o", "    half=base+(peak-base)/2\r\n\u001b[?2004l\r"]
[112.58963, "o", "\u001b[?2004h> "]
[112.589674, "o", "    left=None; right=None\r\n\u001b[?2004l\r"]
[112.589705, "o", "\u001b[?2004h> "]
[112.589779, "o", "    for i in range(idx.index(imax), -1, -1):\r\n\u001b[?2004l\r"]
[112.589813, "o", "\u001b[?2004h> "]
[112.589873, "o", "        if ys[i] <= half:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.589936, "o", "            left=xs[i]; break\r\n\u001b[?2004l\r"]
[112.589968, "o", "\u001b[?2004h"]
[112.590001, "o", "> "]
[112.590041, "o", "    for i in range(idx.index(imax), len(idx)):\r\n\u001b[?2004l\r"]
[112.590073, "o", "\u001b[?2004h> "]
[112.590111, "o", "        if ys[i] <= half:\r\n\u001b[?2004l\r"]
[112.590119, "o", "\u001b[?2004h> "]
[112.590191, "o", "            right=xs[i]; break\r\n\u001b[?2004l\r"]
[112.590221, "o", "\u001b[?2004h> "]
[112.590483, "o", "    print(f'peak {c}: peak={peak:.3f}@{xs[imax]:.2f}, base={base:.3f}, half={half:.3f}, FWHM approx={right-left if left and right else None:.3f}')\r\n\u001b[?2004l\r"]
[112.59051, "o", "\u001b[?2004h> "]
[112.590536, "o", "EOF\r\n\u001b[?2004l\r"]
