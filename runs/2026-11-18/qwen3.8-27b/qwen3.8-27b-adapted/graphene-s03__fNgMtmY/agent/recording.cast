[376.113619, "o", "python3 -c \"import json; d=json.load(open('/app/results.json')); print('valid'); print('keys', list(d.keys())); [print(k, {kk:(round(vv,4) if isinstance(vv,float) else vv) for kk,vv in d[k].items()}) for k in ['D','G','2D']]; print('ID_IG', d['ID_IG'])\" \r"]
