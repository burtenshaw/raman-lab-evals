[279.479947, "o", "\u001b[?2004hroot@j-openenv-6afd8e9329e8b7ccfbbb8447-2c4hzlyc-bc90a-l7rvm:/app# "]
[316.516902, "i", "cat > /app/fit_scipy.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\ndata=np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nxs=data['raman_shift_cm-1']; ys=data['intensity']\n\ndef lorentz(x, A, x0, g, C):\n    return A*g*g/((x-x0)**2 + g*g) + C\n\nwindows={'D':(1250,1450),'G':(1480,1690),'2D':(2540,2820)}\nres={}\nfor name,(lo,hi) in windows.items():\n    m=(xs>=lo)&(xs<=hi)\n    X=xs[m]; Y=ys[m]\n    i=np.argmax(Y)\n    x0_0=X[i]\n    C0=np.median(np.concatenate([Y[:10],Y[-10:]]))\n    A0=Y.max()-C0\n    half=C0+(Y.max()-C0)/2\n    li=ri=None\n    for j in range(i,-1,-1):\n        if Y[j]<=half: li=X[j]; break\n    for j in range(i,len(X)):\n        if Y[j]>=half and (ri is None):\n            pass\n    # find right crossing above half after peak descending\n    for j in range(i,len(X)):\n        if Y[j]<=half: ri=X[j]; break\n    g0=(ri-li)/2.0 if (li is not None and ri is not None) else 15.0\n    p0=[A0,x0_0,g0,C0]\n    bounds=([0,lo,-1,0],[np.inf,hi,200,1e6])\n    popt,pcov=curve_fit(lorentz,"]
[316.517041, "i", "X,Y,p0=p0,bounds=bounds,maxfev=100000)\n    A,x0,g,C=popt\n    Yp=lorentz(X,*popt)\n    ssr=((Y-Yp)**2).sum(); sst=((Y-Y.mean())**2).sum()\n    r2=1-ssr/sst\n    res[name]={'x0':float(x0),'gamma':float(abs(g)),'amplitude':float(A),'offset':float(C)}\n    print(f'{name}: x0={x0:.4f} gamma={g:.4f} A={A:.4f} C={C:.4f} R2={r2:.5f}')\n\nres['ID_IG']=res['D']['amplitude']/res['G']['amplitude']\nprint('ID_IG',res['ID_IG'])\nwith open('/app/results.json','w') as f:\n    json.dump(res,f,indent=2)\nprint('written')\nEOF\npython3 /app/fit_scipy.py\n"]
