[357.13725, "o", "    i=int(np.argmax(Y))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.137299, "o", "    x0_0=X[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.137387, "o", "    C0=float(np.median(np.concatenate([Y[:10],Y[-10:]])))\r\n\u001b[?2004l\r"]
[357.137421, "o", "\u001b[?2004h> "]
[357.137481, "o", "    A0=float(Y.max()-C0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.137541, "o", "    half=C0+(Y.max()-C0)/2.0\r\n\u001b[?2004l\r"]
[357.137595, "o", "\u001b[?2004h> "]
[357.137612, "o", "    li=ri=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.137649, "o", "    for j in range(i,-1,-1):\r\n\u001b[?2004l\r"]
[357.137693, "o", "\u001b[?2004h> "]
[357.137759, "o", "        if Y[j]<=half: li=X[j]; break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.137828, "o", "    for j in range(i,len(X)):\r\n\u001b[?2004l\r"]
[357.137855, "o", "\u001b[?2004h> "]
[357.137912, "o", "        if Y[j]<=half: ri=X[j]; break\r\n\u001b[?2004l\r"]
[357.137937, "o", "\u001b[?2004h> "]
[357.138043, "o", "    g0=(ri-li)/2.0 if (li is not None and ri is not None) else 15.0\r\n\u001b[?2004l\r"]
[357.138086, "o", "\u001b[?2004h> "]
[357.138132, "o", "    p0=[A0,x0_0,g0,C0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.13818, "o", "    bounds=([0,lo,0.5,0],[np.inf,hi,200,1e6])\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.138234, "o", "> "]
[357.138285, "o", "    popt,pcov=curve_fit(lorentz,X,Y,p0=p0,bounds=bounds,maxfev=100000)\r\n\u001b[?2004l\r"]
[357.138302, "o", "\u001b[?2004h> "]
[357.13839, "o", "    A,x0,g,C=popt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.138439, "o", "    Yp=lorentz(X,*popt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.138514, "o", "    ssr=float(((Y-Yp)**2).sum()); sst=float(((Y-Y.mean())**2).sum())\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.138525, "o", "> "]
[357.138569, "o", "    r2=1-ssr/sst\r\n\u001b[?2004l\r"]
[357.13859, "o", "\u001b[?2004h> "]
[357.138769, "o", "    res[name]={'x0':float(x0),'gamma':float(abs(g)),'amplitude':float(A),'offset':float(C)}\r\n\u001b[?2004l\r"]
[357.138824, "o", "\u001b[?2004h> "]
[357.138919, "o", "    print(f'{name}: x0={x0:.4f} gamma={g:.4f} A={A:.4f} C={C:.4f} R2={r2:.5f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.138985, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.139021, "o", "> "]
[357.139066, "o", "res['ID_IG']=res['D']['amplitude']/res['G']['amplitude']\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.139153, "o", "> "]
[357.139239, "o", "print('ID_IG',res['ID_IG'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.139297, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.139339, "o", "    json.dump(res,f,indent=2)\r\n\u001b[?2004l\r"]
[357.139375, "o", "\u001b[?2004h> "]
[357.139409, "o", "print('written')\r\n\u001b[?2004l\r"]
[357.139434, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[357.141371, "o", "\u001b[?2004hroot@j-openenv-6afd8e9329e8b7ccfbbb8447-2c4hzlyc-bc90a-l7rvm:/app# "]
