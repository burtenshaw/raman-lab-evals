[279.414799, "o", "with open('/app/results.json','w') as f:"]
[279.41482, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.414876, "o", "    json.dump(res,f,indent=2)\r\n\u001b[?2004l\r"]
