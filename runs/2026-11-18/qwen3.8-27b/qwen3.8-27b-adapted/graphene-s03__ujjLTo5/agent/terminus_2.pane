[?2004hroot@j-openenv-6afd8c6629e8b7ccfbbb8303-ie85058h-ebb17-4pwfr:/app# cat << 'EOF' > /app/fit.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Define peak regions
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D': (1350, (1200, 1500)),
[?2004l[?2004h>     'G': (1580, (1450, 1720)),
[?2004l[?2004h>     '2D': (2690, (2500, 2900)),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, (center, (lo, hi)) in peaks.items():
[?2004l[?2004h>     # Select data in the region
[?2004l[?2004h>     mask = (x >= lo) & (x <= hi)
[?2004l[?2004h>     x_fit = x[mask]
[?2004l[?2004h>     y_fit = y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses
[?2004l[?2004h>     offset0 = np.median(y_fit)
[?2004l[?2004h>     amp0 = np.max(y_fit) - offset0
[?2004l[?2004h>     x0_0 = center
[?2004l[?2004h>     gamma0 = 20  # typical width
[?2004l[?2004h>     
[?2004l[?2004h>     p0 = [x0_0, gamma0, amp0, offset0]
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0,
[?2004l[?2004h>                                 maxfev=10000)
[?2004l[?2004h>     except RuntimeError:
[?2004l[?2004h>         # Try with bounds
[?2004l[?2004h>         popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0,
[?2004l[?2004h>                                 maxfev=10000,
[?2004l[?2004h>                                 bounds=([lo-50, 0.1, 0, 0], [hi+50, 200, 1e6, 1e6]))
[?2004l[?2004h>     
[?2004l[?2004h>     x0, gamma, amplitude, offset = popt
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(abs(gamma)),
[?2004l[?2004h>         'amplitude': float(amplitude),
[?2004l[?2004h>         'offset': float(offset)
[?2004l[?2004h>     }
[?2004l[?2004h>     print(f"{name}: x0={x0:.2f}, gamma={gamma:.2f}, amplitude={amplitude:.2f}, offset={offset:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> results['ID_IG'] = float(id_ig)
[?2004l[?2004h> print(f"ID/IG = {id_ig:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Done. Results written to /app/results.json")
[?2004l[?2004h> EOF
