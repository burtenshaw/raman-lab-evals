[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> print('range:', x.min(), x.max(), 'npts:', len(x))
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, half=80.0):
[?2004l[?2004h>     mask = (x >= center - half) & (x <= center + half)
[?2004l[?2004h>     xs, ys = x[mask], y[mask]
[?2004l[?2004h>     offset0 = np.median(ys)
[?2004l[?2004h>     amp0 = ys.max() - offset0
[?2004l[?2004h>     x00 = xs[np.argmax(ys)]
[?2004l[?2004h>     # gamma estimate: half width at half max
[?2004l[?2004h>     yhalf = offset0 + amp0 / 2.0
[?2004l[?2004h>     above = xs[ys >= yhalf]
[?2004l[?2004h>     g0 = (above.max() - above.min()) / 2.0 if len(above) > 1 else 20.0
[?2004l[?2004h>     if g0 < 1: g0 = 20.0
[?2004l[?2004h>     p0 = [amp0, x00, g0, offset0]
[?2004l[?2004h>     bounds = ([0, center - half, 1, -np.inf],
[?2004l[?2004h>               [np.inf, center + half, half, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     return popt, perr
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, center in [('D', 1350.0), ('G', 1580.0), ('2D', 2690.0)]:
[?2004l[?2004h>     popt, perr = fit_peak(center)
[?2004l[?2004h>     amp, x0, gamma, offset = popt
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(abs(gamma)),
[?2004l[?2004h>                      'amplitude': float(amp), 'offset': float(offset)}
[?2004l[?2004h>     print(name, 'x0=%.3f+-%.3f gamma=%.3f+-%.3f amp=%.3f+-%.3f off=%.3f+-%.3f'
[?2004l[?2004h>           % (x0, perr[1], abs(gamma), perr[2], amp, perr[0], offset, perr[3]))
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print('ID_IG =', results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
