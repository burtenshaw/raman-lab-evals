def window(lo,hi):
    xp=[]; yp=[]
    for x,y in zip(xs,ys):
        if lo<=x<=hi: xp.append(x); yp.append(y)
    return xp,yp

def init_params(xp,yp, base):
    c0=max(xp,key=lambda x: max(y for xx,y in zip(xp,yp) if xx==x))
    # robust: find max y
    my=max(yp); c0=xp[yp.index(my)]
    # half-max width estimate
    half=base+(my-base)/2
    xs_=xp; ys_=yp
    idx=list(range(len(xs_)))
    imax=ys_.index(my)
    li=imax
    while li>0 and ys_[li]>=half: li-=1
    ri=imax
    while ri<len(ys_)-1 and ys_[ri]>=half: ri+=1
    if li>0:
        t=(half-ys_[li])/(ys_[li+1]-ys_[li]); xl=xs_[li]+t*(xs_[li+1]-xs_[li])
    else: xl=c0
    if ri<len(ys_)-1:
        t=(half-ys_[ri])/(ys_[ri-1]-ys_[ri]); xr=xs_[ri]+t*(xs_[ri-1]-xs_[ri])
    else: xr=c0
    gamma=max(1.0,(xr-xl)/2)
    return c0, gamma, max(1.0, my-base), base

def fit_peak(lo,hi, base):
    xp,yp=window(lo,hi)
    c0,g0,a0,b0=init_params(xp,yp,base)
    return fit_lor(xp,yp,c0,g0,a0,b0)

# local baselines from flat regions
base_D  = sum(y for x,y in zip(xs,ys) if 1130<=x<=1210)/sum(1 for x in xs if 1130<=x<=1210)
base_G  = sum(y for x,y in zip(xs,ys) if 1720<=x<=1800)/sum(1 for x in xs if 1720<=x<=1800)
base_2D = sum(y for x,y in zip(xs,ys) if 2820<=x<=2950)/sum(1 for x in xs if 2820<=x<=2950)

D  = fit_peak(1250,1450, base_D)
G  = fit_peak(1480,1680, base_G)
D2 = fit_peak(2578,2778, base_2D)

def clean(r):
    return {k: float(r[k]) for k in ['x0','gamma','amplitude','offset']}

out={
  'D': clean(D),
  'G': clean(G),
  '2D': clean(D2),
  'ID_IG': float(D['amplitude']/G['amplitude'])
}
with open('/app/results.json','w') as f:
    json.dump(out, f, indent=2)
print(json.dumps(out, indent=2))
print('rms D G 2D:', round(D['rms'],2), round(G['rms'],2), round(D2['rms'],2))
