[?2004l[?2004h>         A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g
[?2004l[?2004h>         for x,y in zip(xpts,ypts):
[?2004l[?2004h>             u=x-c; d2=u*u+g2; L=g2/d2
[?2004l[?2004h>             r=y-(A*L+b)
[?2004l[?2004h>             j=(A*L, A*2*u*g2/(d2*d2), A*2*g2*u*u/(d2*d2), 1.0)
[?2004l[?2004h>             for i in range(4):
[?2004l[?2004h>                 Ji=j[i]; rhs[i]+=Ji*r
[?2004l[?2004h>                 for k in range(4): N[i][k]+=Ji*j[k]
[?2004l[?2004h>         dp=None; ll=lam
[?2004l[?2004h>         for _ in range(40):
[?2004l[?2004h>             Nl=[row[:] for row in N]
[?2004l[?2004h>             for i in range(4): Nl[i][i]+=ll
[?2004l[?2004h>             dp=solve4(Nl,rhs)
[?2004l[?2004h>             if dp is not None: break
[?2004l[?2004h>             ll*=10.0
[?2004l[?2004h>         if dp is None: break
[?2004l[?2004h>         newp=[p[i]+dp[i] for i in range(4)]
[?2004l[?2004h>         newc=cost(newp)
[?2004l[?2004h>         if newc < cur:
[?2004l[?2004h>             mx=max(abs(v) for v in dp)
[?2004l[?2004h>             p=newp; cur=newc; lam=max(1e-13, ll*0.5)
[?2004l[?2004h>             if mx < 1e-10: break
[?2004l[?2004h>         else:
[?2004l[?2004h>             lam=max(lam*10.0, 1e-13)
[?2004l[?2004h>     A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]
[?2004l[?2004h>     rms=math.sqrt(cur/len(xpts))
[?2004l[?2004h>     return dict(x0=c, gamma=g, amplitude=A, offset=b, rms=rms)
[?2004l[?2004h> 
[?2004l[?2004h> def window(lo,hi):
[?2004l[?2004h>     xp=[]; yp=[]
[?2004l[?2004h>     for x,y in zip(xs,ys):
[?2004l[?2004h>         if lo<=x<=hi: xp.append(x); yp.append(y)
[?2004l[?2004h>     return xp,yp
[?2004l[?2004h> 
[?2004l[?2004h> def init_params(xp,yp, base):
[?2004l[?2004h>     c0=max(xp,key=lambda x: max(y for xx,y in zip(xp,yp) if xx==x))
[?2004l[?2004h>     # robust: find max y
[?2004l[?2004h>     my=max(yp); c0=xp[yp.index(my)]
[?2004l[?2004h>     # half-max width estimate
[?2004l[?2004h>     half=base+(my-base)/2
[?2004l[?2004h>     xs_=xp; ys_=yp
[?2004l[?2004h>     idx=list(range(len(xs_)))
[?2004l[?2004h>     imax=ys_.index(my)
[?2004l[?2004h>     li=imax
[?2004l[?2004h>     while li>0 and ys_[li]>=half: li-=1
[?2004l[?2004h>     ri=imax
[?2004l[?2004h>     while ri<len(ys_)-1 and ys_[ri]>=half: ri+=1
[?2004l[?2004h>     if li>0:
[?2004l[?2004h>         t=(half-ys_[li])/(ys_[li+1]-ys_[li]); xl=xs_[li]+t*(xs_[li+1]-xs_[li])
[?2004l[?2004h>     else: xl=c0
[?2004l[?2004h>     if ri<len(ys_)-1:
[?2004l[?2004h>         t=(half-ys_[ri])/(ys_[ri-1]-ys_[ri]); xr=xs_[ri]+t*(xs_[ri-1]-xs_[ri])
[?2004l[?2004h>     else: xr=c0
[?2004l[?2004h>     gamma=max(1.0,(xr-xl)/2)
[?2004l[?2004h>     return c0, gamma, max(1.0, my-base), base
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(lo,hi, base):
[?2004l[?2004h>     xp,yp=window(lo,hi)
[?2004l[?2004h>     c0,g0,a0,b0=init_params(xp,yp,base)
[?2004l[?2004h>     return fit_lor(xp,yp,c0,g0,a0,b0)
[?2004l[?2004h> 
[?2004l[?2004h> # local baselines from flat regions
[?2004l[?2004h> base_D  = sum(y for x,y in zip(xs,ys) if 1130<=x<=1210)/sum(1 for x in xs if 1130<=x<=1210)
[?2004l[?2004h> base_G  = sum(y for x,y in zip(xs,ys) if 1720<=x<=1800)/sum(1 for x in xs if 1720<=x<=1800)
[?2004l[?2004h> base_2D = sum(y for x,y in zip(xs,ys) if 2820<=x<=2950)/sum(1 for x in xs if 2820<=x<=2950)
[?2004l[?2004h> 
[?2004l[?2004h> D  = fit_peak(1250,1450, base_D)
[?2004l[?2004h> G  = fit_peak(1480,1680, base_G)
[?2004l[?2004h> D2 = fit_peak(2578,2778, base_2D)
[?2004l[?2004h> 
[?2004l[?2004h> def clean(r):
[?2004l[?2004h>     return {k: float(r[k]) for k in ['x0','gamma','amplitude','offset']}
[?2004l[?2004h> 
[?2004l[?2004h> out={
[?2004l[?2004h>   'D': clean(D),
[?2004l[?2004h>   'G': clean(G),
[?2004l[?2004h>   '2D': clean(D2),
[?2004l[?2004h>   'ID_IG': float(D['amplitude']/G['amplitude'])
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     json.dump(out, f, indent=2)
[?2004l[?2004h> print(json.dumps(out, indent=2))
