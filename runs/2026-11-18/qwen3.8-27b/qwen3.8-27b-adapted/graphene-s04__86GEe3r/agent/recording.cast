[551.941244, "i", "cat > /app/fit_test.py <<'PY'\nimport csv, math\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    next(f)\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split(',')\n        xs.append(float(a)); ys.append(float(b))\n\ndef max_in(xs,ys,lo,hi):\n    best=-1e300; bx=None\n    for x,y in zip(xs,ys):\n        if lo <= x <= hi and y > best:\n            best=y; bx=x\n    return bx, best\n\ndef estimate_gamma(xs,ys,c,base, max_range=200):\n    # find max near c\n    peak = max(y for x,y in zip(xs,ys) if abs(x-c) <= 50)\n    half = base + (peak-base)/2\n    li = None; ri = None\n    for i in range(len(xs)):\n        if xs[i] < c and abs(xs[i]-c) <= max_range and ys[i] < half:\n            li = i; break\n    for i in range(len(xs)-1, -1, -1):\n        if xs[i] > c and abs(xs[i]-c) <= max_range and ys[i] < half:\n            ri = i; break\n    if li is None or li+1 >= len(xs) or xs[li+1] < c: xl=c\n    else:\n        i=li\n        t=(half-ys[i])/(ys[i+1]-ys[i])\n        xl=xs[i]+t*(xs[i+1]-xs[i])"]
[551.941284, "i", "\n    if ri is None or ri-1 < 0 or xs[ri-1] > c: xr=c\n    else:\n        i=ri\n        t=(half-ys[i])/(ys[i-1]-ys[i])\n        xr=xs[i]+t*(xs[i-1]-xs[i])\n    return max(1.0,(xr-xl)/2), peak\n\ndef solve4(N, b):\n    n=4\n    M=[row[:] + [b[i]] for i,row in enumerate(N)]\n    for col in range(n):\n        piv=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[piv][col]) < 1e-14:\n            return None\n        M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for j in range(col,n+1): M[col][j]/=pv\n        for r in range(n):\n            if r==col: continue\n            factor=M[r][col]\n            for j in range(col,n+1): M[r][j]-=factor*M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef fit_window(xs,ys,lo,hi,base_init):\n    c0, peak = max_in(xs,ys,lo,hi)\n    gamma0, _ = estimate_gamma(xs,ys,c0,base_init)\n    a0 = max(1.0, peak-base_init)\n    g0 = max(1.0, gamma0)\n    pts=[(x,y) for x,y in zip(xs,ys) if lo <= x <= hi]\n    p=[math.log(a0), c0, math.log(g0), base_init]\n    def cost(p):\n        A=m"]
[551.941295, "i", "ath.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]\n        s=0.0\n        for x,y in pts:\n            u=x-c; d2=u*u+g*g\n            f=A*(g*g/d2)+b\n            r=y-f\n            s+=r*r\n        return s\n    cur=cost(p)\n    lam=1e-6\n    for it in range(300):\n        N=[[0.0]*4 for _ in range(4)]\n        rhs=[0.0]*4\n        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]\n        g2=g*g\n        for x,y in pts:\n            u=x-c; d2=u*u+g2\n            L=g2/d2\n            f=A*L+b\n            r=y-f\n            j0=A*L\n            j1=A*2*u*g2/(d2*d2)\n            j2=A*2*g2*u*u/(d2*d2)\n            j3=1.0\n            J=(j0,j1,j2,j3)\n            for i in range(4):\n                Ji=J[i]\n                rhs[i]+=Ji*r\n                for k in range(4):\n                    N[i][k]+=Ji*J[k]\n        dp=None\n        lam_local=lam\n        for _ in range(30):\n            Nl=[N[i][:] for i in range(4)]\n            for i in range(4): Nl[i][i] += lam_local\n            dp=solve4(Nl,rhs)\n            if dp is not None:\n                br"]
[551.941303, "i", "eak\n            lam_local *= 10.0\n        if dp is None:\n            break\n        newp=[p[i]+dp[i] for i in range(4)]\n        newc=cost(newp)\n        if newc < cur:\n            mx=max(abs(v) for v in dp)\n            p=newp; cur=newc; lam=max(1e-12, lam_local*0.5)\n            if mx < 1e-8:\n                break\n        else:\n            lam=max(lam*10.0, 1e-12)\n    A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]\n    rms=math.sqrt(cur/len(pts))\n    return {'x0':c, 'gamma':g, 'amplitude':A, 'offset':b, 'rms':rms, 'n':len(pts)}\n\nbase_idx=[i for i,x in enumerate(xs) if 1750 <= x <= 2350]\nbase=sum(ys[i] for i in base_idx)/len(base_idx)\nprint('base', base)\ntests={\n 'D': [(1250,1450),(1260,1440),(1270,1430),(1280,1420),(1290,1410),(1300,1400)],\n 'G': [(1480,1700),(1500,1680),(1510,1670),(1520,1660),(1530,1650),(1540,1640)],\n '2D': [(2550,2800),(2570,2790),(2580,2780),(2600,2760),(2610,2750),(2620,2740)]\n}\nfor name, wins in tests.items():\n    print('\\n', name)\n    for lo,hi in wins:\n        res=fit_window(xs,ys,lo"]
[551.941315, "i", ",hi,base)\n        print(f'{lo:6.1f}-{hi:6.1f} n={res[\"n\"]:4d} x0={res[\"x0\"]:.4f} g={res[\"gamma\"]:.4f} A={res[\"amplitude\"]:.3f} off={res[\"offset\"]:.3f} rms={res[\"rms\"]:.2f}')\nPY\npython3 /app/fit_test.py\n"]
