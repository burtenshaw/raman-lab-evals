[763.940233, "o", "\u001b[?2004h> "]
[763.940392, "o", "    peak = max(y for x,y in zip(xpts,ypts) if abs(x-c) <= 50)\r\n\u001b[?2004l\r"]
[763.940425, "o", "\u001b[?2004h> "]
