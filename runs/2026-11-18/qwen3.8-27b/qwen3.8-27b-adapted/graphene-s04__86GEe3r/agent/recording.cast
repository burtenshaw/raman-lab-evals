[763.946324, "o", "def fit_points(xpts, ypts, c0, gamma0, a0, b0):\r\n\u001b[?2004l\r"]
[763.946355, "o", "\u001b[?2004h> "]
[763.946663, "o", "    p=[math.log(max(1e-6,a0)), float(c0), math.log(max(1e-6,gamma0)), float(b0)]\r\n\u001b[?2004l\r"]
[763.946678, "o", "\u001b[?2004h> "]
[763.946745, "o", "    def cost(p):\r\n\u001b[?2004l\r"]
[763.946776, "o", "\u001b[?2004h> "]
[763.947119, "o", "        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\r\n\u001b[?2004l\r"]
[763.947128, "o", "\u001b[?2004h"]
[763.947161, "o", "> "]
[763.947179, "o", "        s=0.0\r\n\u001b[?2004l\r"]
[763.947211, "o", "\u001b[?2004h"]
[763.947234, "o", "> "]
[763.947289, "o", "        for x,y in zip(xpts,ypts):\r\n\u001b[?2004l\r"]
[763.947315, "o", "\u001b[?2004h> "]
[763.94746, "o", "            u=x-c; d2=u*u+g2\r\n\u001b[?2004l\r"]
[763.947476, "o", "\u001b[?2004h> "]
[763.947573, "o", "            f=A*(g2/d2)+b\r\n\u001b[?2004l\r"]
[763.947582, "o", "\u001b[?2004h> "]
[763.947625, "o", "            r=y-f\r\n\u001b[?2004l\r"]
[763.947635, "o", "\u001b[?2004h> "]
[763.94773, "o", "            s+=r*r\r\n\u001b[?2004l\r"]
[763.947761, "o", "\u001b[?2004h> "]
[763.947803, "o", "        return s\r\n\u001b[?2004l\r"]
[763.947826, "o", "\u001b[?2004h> "]
[763.947879, "o", "    cur=cost(p); lam=1e-6\r\n\u001b[?2004l\r"]
[763.947914, "o", "\u001b[?2004h> "]
[763.947956, "o", "    for it in range(300):\r\n\u001b[?2004l\r"]
[763.94798, "o", "\u001b[?2004h> "]
[763.948156, "o", "        N=[[0.0]*4 for _ in range(4)]; rhs=[0.0]*4\r\n\u001b[?2004l\r"]
[763.948183, "o", "\u001b[?2004h> "]
[763.948514, "o", "        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\r\n\u001b[?2004l\r"]
[763.948537, "o", "\u001b[?2004h> "]
[763.948585, "o", "        for x,y in zip(xpts,ypts):\r\n\u001b[?2004l\r"]
[763.948607, "o", "\u001b[?2004h> "]
[763.948656, "o", "            u=x-c; d2=u*u+g2; L=g2/d2\r\n\u001b[?2004l\r"]
[763.948692, "o", "\u001b[?2004h> "]
[763.948718, "o", "            f=A*L+b; r=y-f\r\n\u001b[?2004l\r"]
[763.94874, "o", "\u001b[?2004h> "]
[763.948806, "o", "            j=(A*L, A*2*u*g2/(d2*d2), A*2*g2*u*u/(d2*d2), 1.0)\r\n\u001b[?2004l\r"]
[763.948828, "o", "\u001b[?2004h> "]
[763.948867, "o", "            for i in range(4):\r\n\u001b[?2004l\r"]
[763.948898, "o", "\u001b[?2004h> "]
[763.948939, "o", "                Ji=j[i]; rhs[i]+=Ji*r\r\n\u001b[?2004l\r"]
[763.948975, "o", "\u001b[?2004h> "]
[763.949028, "o", "                for k in range(4): N[i][k]+=Ji*j[k]\r\n\u001b[?2004l\r"]
[763.949057, "o", "\u001b[?2004h> "]
[763.949112, "o", "        dp=None; ll=lam\r\n\u001b[?2004l\r\u001b[?2004h> "]
[763.94915, "o", "        for _ in range(30):\r\n\u001b[?2004l\r"]
[763.949175, "o", "\u001b[?2004h> "]
[763.949225, "o", "            Nl=[row[:] for row in N]\r\n\u001b[?2004l\r"]
[763.949249, "o", "\u001b[?2004h> "]
[763.949304, "o", "            for i in range(4): Nl[i][i]+=ll\r\n\u001b[?2004l\r"]
[763.949335, "o", "\u001b[?2004h> "]
[763.949365, "o", "            dp=solve4(Nl,rhs)\r\n\u001b[?2004l\r"]
[763.949398, "o", "\u001b[?2004h> "]
[763.94944, "o", "            if dp is not None: break\r\n\u001b[?2004l\r"]
[763.949474, "o", "\u001b[?2004h> "]
[763.949516, "o", "            ll*=10\r\n\u001b[?2004l\r\u001b[?2004h"]
[763.949525, "o", "> "]
[763.949563, "o", "        if dp is None: break\r\n\u001b[?2004l\r"]
[763.949593, "o", "\u001b[?2004h> "]
[763.949627, "o", "        newp=[p[i]+dp[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[763.949661, "o", "\u001b[?2004h> "]
[763.9497, "o", "        newc=cost(newp)"]
[763.949725, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[763.949764, "o", "        if newc < cur:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[763.949818, "o", "            mx=max(abs(v) for v in dp)\r\n\u001b[?2004l\r"]
[763.949851, "o", "\u001b[?2004h> "]
[763.94991, "o", "            p=newp; cur=newc; lam=max(1e-12,ll*0.5)\r\n\u001b[?2004l\r"]
[763.949953, "o", "\u001b[?2004h> "]
[763.949981, "o", "            if mx < 1e-9: break\r\n\u001b[?2004l\r"]
[763.950008, "o", "\u001b[?2004h> "]
[763.950018, "o", "        else:\r\n\u001b[?2004l\r"]
[763.950027, "o", "\u001b[?2004h> "]
[763.950081, "o", "            lam=max(lam*10,1e-12)\r\n\u001b[?2004l\r"]
[763.950112, "o", "\u001b[?2004h> "]
[763.950171, "o", "    A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]\r\n\u001b[?2004l\r"]
[763.950194, "o", "\u001b[?2004h> "]
[763.950237, "o", "    rms=math.sqrt(cur/len(xpts))\r\n\u001b[?2004l\r"]
[763.950268, "o", "\u001b[?2004h> "]
[763.950335, "o", "    return dict(x0=c, gamma=g, amplitude=A, offset=b, rms=rms)\r\n\u001b[?2004l\r"]
[763.950366, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[763.950375, "o", "\u001b[?2004h> "]
[763.950448, "o", "def window_fit(lo, hi, xbase, ybase, base_init):\r\n\u001b[?2004l\r"]
[763.950478, "o", "\u001b[?2004h> "]
[763.9506, "o", "    xpts=[x for x in xbase if lo<=x<=hi]; ypts=[y for y in ybase if lo<=x<=hi]  # careful filter ybase by xbase\r\n\u001b[?2004l\r"]
[763.950624, "o", "\u001b[?2004h> "]
[763.950683, "o", "    # fix: ybase list aligned; better use zip\r\n\u001b[?2004l\r"]
[763.950693, "o", "\u001b[?2004h> "]
[763.950738, "o", "    xpts=[]; ypts=[]\r\n\u001b[?2004l\r"]
[763.950747, "o", "\u001b[?2004h> "]
[763.950799, "o", "    for x,y in zip(xbase,ybase):\r\n\u001b[?2004l\r"]
[763.95083, "o", "\u001b[?2004h> "]
[763.950886, "o", "        if lo<=x<=hi: xpts.append(x); ypts.append(y)\r\n\u001b[?2004l\r"]
[763.950919, "o", "\u001b[?2004h> "]
[763.950956, "o", "    c0, peak = max_in(xpts,ypts)\r\n\u001b[?2004l\r"]
[763.95098, "o", "\u001b[?2004h> "]
[763.951088, "o", "    gamma0, peak2 = estimate_gamma(c0, base_init, xpts, ypts)\r\n\u001b[?2004l\r"]
[763.951097, "o", "\u001b[?2004h"]
[763.951128, "o", "> "]
[763.951163, "o", "    a0=max(1.0, peak2-base_init)\r\n\u001b[?2004l\r"]
[763.951193, "o", "\u001b[?2004h> "]
[763.951248, "o", "    return fit_points(xpts,ypts,c0,gamma0,a0,base_init)\r\n\u001b[?2004l\r"]
[763.951279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[763.951288, "o", "\u001b[?2004h> "]
[763.951339, "o", "def lor_no_offset(x, A,c,g):\r\n\u001b[?2004l\r"]
[763.951369, "o", "\u001b[?2004h> "]
[763.951394, "o", "    u=x-c; g2=g*g\r\n\u001b[?2004l\r"]
[763.951425, "o", "\u001b[?2004h> "]
[763.951452, "o", "    return A*g2/(u*u+g2)\r\n\u001b[?2004l\r"]
[763.951483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[763.951493, "o", "\u001b[?2004h> "]
[763.951576, "o", "base_idx=[i for i,x in enumerate(xs) if 1750 <= x <= 2350]\r\n\u001b[?2004l\r"]
[763.951607, "o", "\u001b[?2004h> "]
[763.951664, "o", "base_global=sum(ys[i] for i in base_idx)/len(base_idx)\r\n\u001b[?2004l\r"]
