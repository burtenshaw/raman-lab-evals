[763.942445, "o", "\u001b[?2004h> "]
[763.942535, "o", "    prev_below=None\r\n\u001b[?2004l\r"]
[763.942553, "o", "\u001b[?2004h> "]
[763.942742, "o", "    for x,y in reversed(list(zip(xpts,ypts))):\r\n\u001b[?2004l\r"]
[763.942767, "o", "\u001b[?2004h> "]
[763.942976, "o", "        if x > c and abs(x-c) <= max_range:\r\n\u001b[?2004l\r"]
[763.942984, "o", "\u001b[?2004h"]
[763.943021, "o", "> "]
[763.943052, "o", "            if y < half:\r\n\u001b[?2004l\r"]
[763.943069, "o", "\u001b[?2004h> "]
[763.943223, "o", "                if prev_below is not None:\r\n\u001b[?2004l\r"]
[763.943301, "o", "\u001b[?2004h> "]
[763.943405, "o", "                    x1,y1=prev_below\r\n\u001b[?2004l\r"]
[763.943431, "o", "\u001b[?2004h> "]
[763.943548, "o", "                    t=(half-y1)/(y-y1)\r\n\u001b[?2004l\r"]
[763.943575, "o", "\u001b[?2004h> "]
[763.943628, "o", "                    xr=x1+t*(x-x1)\r\n\u001b[?2004l\rG"]
[763.943662, "o", "\u001b[?2004h> "]
[763.943691, "o", "                else:\r\n\u001b[?2004l\ri\u001b[?2004h"]
[763.943715, "o", "> "]
