[863.360622, "i", "    else:\n            lam=max(lam*10.0, 1e-13)\n    A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]\n    rms=math.sqrt(cur/len(xpts))\n    return dict(x0=c, gamma=g, amplitude=A, offset=b, rms=rms)\n\ndef window(lo,hi):\n    xp=[]; yp=[]\n    for x,y in zip(xs,ys):\n        if lo<=x<=hi: xp.append(x); yp.append(y)\n    return xp,yp\n\ndef init_params(xp,yp, base):\n    c0=max(xp,key=lambda x: max(y for xx,y in zip(xp,yp) if xx==x))\n    # robust: find max y\n    my=max(yp); c0=xp[yp.index(my)]\n    # half-max width estimate\n    half=base+(my-base)/2\n    xs_=xp; ys_=yp\n    idx=list(range(len(xs_)))\n    imax=ys_.index(my)\n    li=imax\n    while li>0 and ys_[li]>=half: li-=1\n    ri=imax\n    while ri<len(ys_)-1 and ys_[ri]>=half: ri+=1\n    if li>0:\n        t=(half-ys_[li])/(ys_[li+1]-ys_[li]); xl=xs_[li]+t*(xs_[li+1]-xs_[li])\n    else: xl=c0\n    if ri<len(ys_)-1:\n        t=(half-ys_[ri])/(ys_[ri-1]-ys_[ri]); xr=xs_[ri]+t*(xs_[ri-1]-xs_[ri])\n    else: xr=c0\n    gamma=max(1.0,(xr-xl)/2)\n    return c0, gamma, max(1.0, my-base), "]
