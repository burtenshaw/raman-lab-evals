[863.361255, "o", "with open('/app/spectrum.csv') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.3613, "o", "> "]
[863.361328, "o", "    next(f)\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r"]
[863.361361, "o", "\u001b[?2004h> "]
[863.361397, "o", "        line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.361425, "o", "        if not line: continue\r\n\u001b[?2004l\r"]
[863.361436, "o", "\u001b[?2004h> "]
[863.361472, "o", "        a,b=line.split(',')\r\n\u001b[?2004l\r"]
[863.361504, "o", "\u001b[?2004h> "]
[863.361552, "o", "        xs.append(float(a)); ys.append(float(b))\r\n\u001b[?2004l\r"]
[863.361562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[863.361599, "o", "\u001b[?2004h> "]
[863.361639, "o", "def solve4(N,b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.36167, "o", "    n=4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.361705, "o", "    M=[row[:]+[b[i]] for i,row in enumerate(N)]\r\n\u001b[?2004l\r"]
[863.361737, "o", "\u001b[?2004h> "]
[863.361767, "o", "    for col in range(n):\r\n\u001b[?2004l\r"]
[863.3618, "o", "\u001b[?2004h> "]
[863.36184, "o", "        piv=max(range(col,n), key=lambda r: abs(M[r][col]))\r\n\u001b[?2004l\r"]
[863.361851, "o", "\u001b[?2004h> "]
[863.361917, "o", "        if abs(M[piv][col]) < 1e-15: return None\r\n\u001b[?2004l\r"]
[863.361928, "o", "\u001b[?2004h> "]
[863.361988, "o", "        M[col],M[piv]=M[piv],M[col]\r\n\u001b[?2004l\r"]
[863.36202, "o", "\u001b[?2004h> "]
[863.36203, "o", "        pv=M[col][col]\r\n\u001b[?2004l\r"]
[863.362075, "o", "\u001b[?2004h> "]
[863.362108, "o", "        for j in range(col,n+1): M[col][j]/=pv\r\n\u001b[?2004l\r"]
[863.362118, "o", "\u001b[?2004h> "]
[863.362159, "o", "        for r in range(n):\r\n\u001b[?2004l\r"]
[863.36217, "o", "\u001b[?2004h> "]
[863.362217, "o", "            if r==col: continue\r\n\u001b[?2004l\r"]
[863.362228, "o", "\u001b[?2004h> "]
[863.362273, "o", "            factor=M[r][col]\r\n\u001b[?2004l\r"]
[863.362283, "o", "\u001b[?2004h> "]
[863.362366, "o", "            for j in range(col,n+1): M[r][j]-=factor*M[col][j]\r\n\u001b[?2004l\r"]
[863.362377, "o", "\u001b[?2004h> "]
[863.362433, "o", "    return [M[i][n] for i in range(n)]\r\n\u001b[?2004l\r"]
[863.362443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[863.362485, "o", "\u001b[?2004h> "]
[863.36252, "o", "def fit_lor(xpts, ypts, c0, gamma0, a0, b0):\r\n\u001b[?2004l\r"]
[863.36253, "o", "\u001b[?2004h> "]
[863.362632, "o", "    p=[math.log(max(1e-6,a0)), float(c0), math.log(max(1e-6,gamma0)), float(b0)]\r\n\u001b[?2004l\r"]
[863.362664, "o", "\u001b[?2004h> "]
[863.362693, "o", "    def cost(p):\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.362726, "o", "> "]
[863.362767, "o", "        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\r\n\u001b[?2004l\r"]
[863.362798, "o", "\u001b[?2004h> "]
[863.362828, "o", "        s=0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.362858, "o", "> "]
[863.362896, "o", "        for x,y in zip(xpts,ypts):\r\n\u001b[?2004l\r"]
[863.362933, "o", "\u001b[?2004h> "]
[863.362963, "o", "            u=x-c; d2=u*u+g2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.362995, "o", "            r=y-(A*(g2/d2)+b)\r\n\u001b[?2004l\r"]
[863.363024, "o", "\u001b[?2004h> "]
[863.363067, "o", "            s+=r*r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.3631, "o", "        return s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.363131, "o", "    cur=cost(p); lam=1e-6\r\n\u001b[?2004l\r"]
[863.363169, "o", "\u001b[?2004h> "]
[863.363198, "o", "    for _ in range(500):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.36324, "o", "        N=[[0.0]*4 for _ in range(4)]; rhs=[0.0]*4\r\n\u001b[?2004l\r"]
[863.363251, "o", "\u001b[?2004h> "]
[863.363346, "o", "        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\r\n\u001b[?2004l\r"]
[863.363355, "o", "\u001b[?2004h"]
[863.363391, "o", "> "]
[863.363401, "o", "        for x,y in zip(xpts,ypts):\r\n\u001b[?2004l\r"]
[863.363445, "o", "\u001b[?2004h> "]
[863.363482, "o", "            u=x-c; d2=u*u+g2; L=g2/d2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.363518, "o", "            r=y-(A*L+b)\r\n\u001b[?2004l\r"]
[863.363553, "o", "\u001b[?2004h> "]
[863.36361, "o", "            j=(A*L, A*2*u*g2/(d2*d2), A*2*g2*u*u/(d2*d2), 1.0)\r\n\u001b[?2004l\r"]
[863.363621, "o", "\u001b[?2004h> "]
[863.363666, "o", "            for i in range(4):\r\n\u001b[?2004l\r"]
[863.363677, "o", "\u001b[?2004h> "]
[863.363731, "o", "                Ji=j[i]; rhs[i]+=Ji*r\r\n\u001b[?2004l\r"]
[863.363742, "o", "\u001b[?2004h> "]
[863.363811, "o", "                for k in range(4): N[i][k]+=Ji*j[k]\r\n\u001b[?2004l\r"]
[863.363843, "o", "\u001b[?2004h> "]
[863.363873, "o", "        dp=None; ll=lam\r\n\u001b[?2004l\r"]
[863.363906, "o", "\u001b[?2004h> "]
[863.363937, "o", "        for _ in range(40):\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.363975, "o", "> "]
[863.364004, "o", "            Nl=[row[:] for row in N]\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.364037, "o", "> "]
[863.364047, "o", "            for i in range(4): Nl[i][i]+=ll\r\n\u001b[?2004l\r"]
[863.364086, "o", "\u001b[?2004h> "]
[863.36411, "o", "            dp=solve4(Nl,rhs)\r\n\u001b[?2004l\r"]
[863.364142, "o", "\u001b[?2004h> "]
[863.364169, "o", "            if dp is not None: break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.364208, "o", "            ll*=10.0\r\n\u001b[?2004l\r"]
[863.364218, "o", "\u001b[?2004h> "]
[863.364263, "o", "        if dp is None: break\r\n\u001b[?2004l\r"]
[863.364271, "o", "\u001b[?2004h"]
[863.364309, "o", "> "]
[863.364348, "o", "        newp=[p[i]+dp[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[863.36438, "o", "\u001b[?2004h> "]
[863.364412, "o", "        newc=cost(newp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.364443, "o", "        if newc < cur:\r\n\u001b[?2004l\r"]
[863.364475, "o", "\u001b[?2004h> "]
[863.364513, "o", "            mx=max(abs(v) for v in dp)\r\n\u001b[?2004l\r"]
[863.364542, "o", "\u001b[?2004h> "]
[863.364571, "o", "            p=newp; cur=newc; lam=max(1e-13, ll*0.5)\r\n\u001b[?2004l\r"]
[863.364582, "o", "\u001b[?2004h> "]
[863.364631, "o", "            if mx < 1e-10: break\r\n\u001b[?2004l\r"]
[863.364641, "o", "\u001b[?2004h> "]
[863.364683, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.364731, "o", "            lam=max(lam*10.0, 1e-13)\r\n\u001b[?2004l\r"]
[863.364742, "o", "\u001b[?2004h> "]
[863.364814, "o", "    A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]\r\n\u001b[?2004l\r"]
[863.364847, "o", "\u001b[?2004h> "]
[863.364873, "o", "    rms=math.sqrt(cur/len(xpts))\r\n\u001b[?2004l\r"]
[863.364905, "o", "\u001b[?2004h> "]
[863.364965, "o", "    return dict(x0=c, gamma=g, amplitude=A, offset=b, rms=rms)\r\n\u001b[?2004l\r"]
[863.364976, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[863.365014, "o", "\u001b[?2004h> "]
[863.365024, "o", "def window(lo,hi):\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.365063, "o", "> "]
[863.365087, "o", "    xp=[]; yp=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.365127, "o", "    for x,y in zip(xs,ys):\r\n\u001b[?2004l\r"]
[863.365159, "o", "\u001b[?2004h> "]
[863.365191, "o", "        if lo<=x<=hi: xp.append(x); yp.append(y)\r\n\u001b[?2004l\r"]
[863.365224, "o", "\u001b[?2004h> "]
[863.365234, "o", "    return xp,yp\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.365273, "o", "> \r\n\u001b[?2004l\r"]
[863.365297, "o", "\u001b[?2004h> "]
[863.365328, "o", "def init_params(xp,yp, base):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.365397, "o", "    c0=max(xp,key=lambda x: max(y for xx,y in zip(xp,yp) if xx==x))\r\n\u001b[?2004l\r"]
[863.365407, "o", "\u001b[?2004h> "]
[863.365447, "o", "    # robust: find max y\r\n\u001b[?2004l\r"]
[863.365458, "o", "\u001b[?2004h> "]
[863.365509, "o", "    my=max(yp); c0=xp[yp.index(my)]\r\n\u001b[?2004l\r"]
[863.36552, "o", "\u001b[?2004h> "]
[863.365564, "o", "    # half-max width estimate\r\n\u001b[?2004l\r"]
[863.365575, "o", "\u001b[?2004h> "]
[863.365615, "o", "    half=base+(my-base)/2\r\n\u001b[?2004l\r"]
[863.365648, "o", "\u001b[?2004h> "]
[863.365679, "o", "    xs_=xp; ys_=yp\r\n\u001b[?2004l\r"]
[863.36571, "o", "\u001b[?2004h> "]
[863.365742, "o", "    idx=list(range(len(xs_)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.365773, "o", "    imax=ys_.index(my)\r\n\u001b[?2004l\r"]
[863.365813, "o", "\u001b[?2004h>     li=imax\r\n\u001b[?2004l\r"]
[863.365841, "o", "\u001b[?2004h> "]
[863.365875, "o", "    while li>0 and ys_[li]>=half: li-=1\r\n\u001b[?2004l\r"]
[863.365884, "o", "\u001b[?2004h>     ri=imax\r\n\u001b[?2004l\r"]
[863.365922, "o", "\u001b[?2004h> "]
[863.365969, "o", "    while ri<len(ys_)-1 and ys_[ri]>=half: ri+=1\r\n\u001b[?2004l\r"]
[863.365994, "o", "\u001b[?2004h"]
[863.366027, "o", ">     if li>0:\r\n\u001b[?2004l\r"]
[863.366058, "o", "\u001b[?2004h> "]
[863.366113, "o", "        t=(half-ys_[li])/(ys_[li+1]-ys_[li]); xl=xs_[li]+t*(xs_[li+1]-xs_[li])\r\n\u001b[?2004l\r"]
[863.366139, "o", "\u001b[?2004h> "]
[863.366168, "o", "    else: xl=c0\r\n\u001b[?2004l\r"]
[863.366191, "o", "\u001b[?2004h> "]
[863.366218, "o", "    if ri<len(ys_)-1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.366246, "o", "> "]
[863.366305, "o", "        t=(half-ys_[ri])/(ys_[ri-1]-ys_[ri]); xr=xs_[ri]+t*(xs_[ri-1]-xs_[ri])\r\n\u001b[?2004l\r"]
[863.366316, "o", "\u001b[?2004h> "]
[863.366366, "o", "    else: xr=c0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.366397, "o", "    gamma=max(1.0,(xr-xl)/2)\r\n\u001b[?2004l\r"]
[863.366408, "o", "\u001b[?2004h> "]
[863.366471, "o", "    return c0, gamma, max(1.0, my-base), base\r\n\u001b[?2004l\r"]
[863.366482, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[863.366506, "o", "\u001b[?2004h> "]
[863.366549, "o", "def fit_peak(lo,hi, base):\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.366585, "o", "> "]
[863.366609, "o", "    xp,yp=window(lo,hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.366652, "o", "    c0,g0,a0,b0=init_params(xp,yp,base)\r\n\u001b[?2004l\r"]
[863.366663, "o", "\u001b[?2004h> "]
[863.366716, "o", "    return fit_lor(xp,yp,c0,g0,a0,b0)\r\n\u001b[?2004l\r"]
[863.366726, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[863.366762, "o", "\u001b[?2004h> "]
[863.366803, "o", "# local baselines from flat regions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.366917, "o", "base_D  = sum(y for x,y in zip(xs,ys) if 1130<=x<=1210)/sum(1 for x in xs if 1130<=x<=1210)\r\n\u001b[?2004l\r"]
[863.366928, "o", "\u001b[?2004h> "]
[863.367041, "o", "base_G  = sum(y for x,y in zip(xs,ys) if 1720<=x<=1800)/sum(1 for x in xs if 1720<=x<=1800)\r\n\u001b[?2004l\r"]
[863.367055, "o", "\u001b[?2004h> "]
[863.367177, "o", "base_2D = sum(y for x,y in zip(xs,ys) if 2820<=x<=2950)/sum(1 for x in xs if 2820<=x<=2950)\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.367216, "o", "> \r\n\u001b[?2004l\r"]
[863.367245, "o", "\u001b[?2004h> "]
[863.367272, "o", "D  = fit_peak(1250,1450, base_D)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.367312, "o", "G  = fit_peak(1480,1680, base_G)\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.36734, "o", "> "]
[863.36737, "o", "D2 = fit_peak(2578,2778, base_2D)\r\n\u001b[?2004l\r"]
[863.367403, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.367441, "o", "def clean(r):\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.367474, "o", "> "]
[863.367523, "o", "    return {k: float(r[k]) for k in ['x0','gamma','amplitude','offset']}\r\n\u001b[?2004l\r"]
[863.367554, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[863.36758, "o", "> out={\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.367621, "o", "  'D': clean(D),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.367665, "o", "  'G': clean(G),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.367698, "o", "  '2D': clean(D2),\r\n\u001b[?2004l\r"]
[863.367723, "o", "\u001b[?2004h> "]
[863.367753, "o", "  'ID_IG': float(D['amplitude']/G['amplitude'])\r\n\u001b[?2004l\r"]
[863.367788, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[863.367812, "o", "\u001b[?2004h> "]
[863.367836, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r"]
[863.367863, "o", "\u001b[?2004h> "]
[863.367897, "o", "    json.dump(out, f, indent=2)\r\n\u001b[?2004l\r"]
[863.367925, "o", "\u001b[?2004h> "]
[863.367956, "o", "print(json.dumps(out, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.368059, "o", "print('rms D G 2D:', round(D['rms'],2), round(G['rms'],2), round(D2['rms'],2))\r\n\u001b[?2004l\r"]
[863.368086, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[863.369184, "o", "\u001b[?2004hroot@j-openenv-6afd8ee529e8b7ccfbbb8473-2otkzk72-53f9e-rw26d:/app# "]
[863.369224, "o", "python3 /app/fit_final.py\r\n\u001b[?2004l\r"]
[863.91695, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1345.9880929901158,\r\n    \"gamma\": 14.730209982320691,\r\n    \"amplitude\": 12082.210429804069,\r\n    \"offset\": 1269.0011322009914\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1585.0908705443392,\r\n    \"gamma\": 13.92400837614018,\r\n    \"amplitude\": 8607.208955141545,\r\n    \"offset\": 1274.739139491402\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2678.0382882443614,\r\n    \"gamma\": 19.978745888484024,\r\n    \"amplitude\": 10767.96056004451,\r\n    \"offset\": 1073.6938018334886\r\n  },\r\n  \"ID_IG\": 1.4037315107340016\r\n}\r\nrms D G 2D: 61.44 68.44 "]
[863.917001, "o", "60.97\r\n"]
[863.921116, "o", "\u001b[?2004h"]
[863.921178, "o", "root@j-openenv-6afd8ee529e8b7ccfbbb8473-2otkzk72-53f9e-rw26d:/app# "]
[871.711232, "i", "cat /app/results.json\n"]
[871.711403, "o", "cat /app/results.json\r\n\u001b[?2004l\r"]
[871.712348, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1345.9880929901158,\r\n    \"gamma\": 14.730209982320691,\r\n    \"amplitude\": 12082.210429804069,\r\n    \"offset\": 1269.0011322009914\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1585.0908705443392,\r\n    \"gamma\": 13.92400837614018,\r\n    \"amplitude\": 8607.208955141545,\r\n    \"offset\": 1274.739139491402\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2678.0382882443614,\r\n    \"gamma\": 19.978745888484024,\r\n    \"amplitude\": 10767.96056004451,\r\n    \"offset\": 1073.6938018334886\r\n  },\r\n  \"ID_IG\": 1.4037315107340016\r\n}"]
[871.712508, "o", "\u001b[?2004hroot@j-openenv-6afd8ee529e8b7ccfbbb8473-2otkzk72-53f9e-rw26d:/app# "]
