[361.51528, "i", "python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    next(f)\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split(',')\n        xs.append(float(a)); ys.append(float(b))\ndef find_max(lo,hi):\n    best_i=-1; best=-1e300\n    for i,(x,y) in enumerate(zip(xs,ys)):\n        if lo<=x<=hi and y>best:\n            best=y; best_i=i\n    return best_i\nbase_idx = [i for i,x in enumerate(xs) if 1750<=x<=2350]\nbaseline = sum(ys[i] for i in base_idx)/len(base_idx)\nprint('baseline', baseline)\nfor name, lo, hi in [('D',1200,1500), ('G',1480,1720), ('2D',2500,2850)]:\n    i = find_max(lo,hi)\n    c=xs[i]; peak=ys[i]; h=peak-baseline\n    half = baseline + h/2\n    li=i; ri=i\n    while li>0 and xs[li] > c-200 and ys[li] >= half: li -= 1\n    while ri<len(xs)-1 and xs[ri] < c+200 and ys[ri] >= half: ri += 1\n    # linear interpolation for crossing\n    if li>0 and ys[li] < half <= ys[li+1]:\n        t=(half-ys[li])/(ys[li+1]-ys[li]); xl=xs[li]+t*(xs[li+1]-xs[li])"]
[361.515337, "i", "\n    else: xl=xs[li]\n    if ri<len(xs)-1 and ys[ri] < half <= ys[ri-1]:\n        t=(half-ys[ri])/(ys[ri-1]-ys[ri]); xr=xs[ri]+t*(xs[ri-1]-xs[ri])\n    else: xr=xs[ri]\n    fwhm=xr-xl; gamma=fwhm/2\n    print(f'{name}: c={c:.2f} peak={peak:.1f} height={h:.1f} fwhm={fwhm:.2f} gamma={gamma:.2f}')\n    # tail at +/- 100,150,200\n    for off in [100,150,200]:\n        for sign in [-1,1]:\n            x=c+sign*off\n            j=round((x-xs[0])/(xs[1]-xs[0]))\n            if 0<=j<len(xs):\n                print(f'  x={x:.0f} y={ys[j]:.1f} excess={ys[j]-baseline:.1f}')\nPY\n"]
