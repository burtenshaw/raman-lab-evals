[166.435885, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    next(f)\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split(',')\n        xs.append(float(a)); ys.append(float(b))\nprint('n', len(xs), 'x0', xs[0], 'xend', xs[-1])\nprint('ymin', min(ys), 'ymax', max(ys))\ndef max_in(lo,hi):\n    bestx, besty = None, -1e300\n    for x,y in zip(xs,ys):\n        if lo <= x <= hi and y > besty:\n            bestx, besty = x, y\n    return bestx, besty\nprint('D', max_in(1200,1500))\nprint('G', max_in(1480,1720))\nprint('2D', max_in(2500,2850))\ndef avg(lo,hi):\n    vals=[y for x,y in zip(xs,ys) if lo<=x<=hi]\n    return (len(vals), sum(vals)/len(vals) if vals else None, min(vals) if vals else None, max(vals) if vals else None)\nfor lo,hi in [(1100,1200),(1700,2400),(2800,2990)]:\n    print('baseline', lo, hi, avg(lo,hi))\nPY\n"]
