[763.944229, "o", "def solve4(N,b):\r\n"]
[763.944258, "o", "\u001b[?2004l\r"]
[763.944281, "o", "\u001b[?2004h> "]
[763.94431, "o", "    n=4\r\n\u001b[?2004l\r"]
[763.944344, "o", "\u001b[?2004h> "]
[763.944535, "o", "    M=[row[:]+[b[i]] for i,row in enumerate(N)]\r\n\u001b[?2004l\r"]
[763.944566, "o", "\u001b[?2004h> "]
[763.944681, "o", "    for col in range(n):\r\n\u001b[?2004l\r"]
[763.944706, "o", "\u001b[?2004h> "]
[763.94501, "o", "        piv=max(range(col,n), key=lambda r: abs(M[r][col]))\r\n\u001b[?2004l\r"]
[763.945042, "o", "\u001b[?2004h> "]
[763.945136, "o", "        if abs(M[piv][col]) < 1e-14: return None\r\n\u001b[?2004l\r"]
[763.945165, "o", "\u001b[?2004h> "]
[763.945278, "o", "        M[col],M[piv]=M[piv],M[col]\r\n"]
[763.9453, "o", "\u001b[?2004l\r\u001b[?2004h"]
[763.945334, "o", "> "]
[763.945372, "o", "        pv=M[col][col]\r\n\u001b[?2004l\rd_"]
[763.945395, "o", "\u001b[?2004h> "]
[763.945561, "o", "        for j in range(col,n+1): M[col][j]/=pv\r\n\u001b[?2004l\r"]
[763.945585, "o", "\u001b[?2004h> "]
[763.945686, "o", "        for r in range(n):\r\n\u001b[?2004l\r"]
[763.945708, "o", "\u001b[?2004h> "]
[763.945776, "o", "            if r==col: continue\r\n\u001b[?2004l\rnt"]
[763.945806, "o", "\u001b[?2004h> "]
[763.945939, "o", "            factor=M[r][col]\r\n\u001b[?2004l\r"]
[763.945973, "o", "\u001b[?2004h> "]
[763.946082, "o", "            for j in range(col,n+1): M[r][j]-=factor*M[col][j]\r\n\u001b[?2004l\r"]
[763.946107, "o", "\u001b[?2004h> "]
[763.946179, "o", "    return [M[i][n] for i in range(n)]\r\n\u001b[?2004l\r"]
[763.946188, "o", "\u001b[?2004h> \r\n"]
[763.946224, "o", "\u001b[?2004l\r"]
