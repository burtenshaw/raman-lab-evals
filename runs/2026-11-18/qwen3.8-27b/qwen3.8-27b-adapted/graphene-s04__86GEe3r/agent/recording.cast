[763.937515, "i", "cat > /app/fit_test2.py <<'PY'\nimport csv, math\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    next(f)\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split(',')\n        xs.append(float(a)); ys.append(float(b))\n\ndef max_in(xpts, ypts):\n    best=-1e300; bx=None\n    for x,y in zip(xpts, ypts):\n        if y > best:\n            best=y; bx=x\n    return bx, best\n\ndef estimate_gamma(c, base, xpts, ypts, max_range=200):\n    peak = max(y for x,y in zip(xpts,ypts) if abs(x-c) <= 50)\n    half = base + (peak-base)/2\n    xl=xr=c\n    prev_below=None\n    for x,y in zip(xpts,ypts):\n        if x < c and abs(x-c) <= max_range:\n            if y < half:\n                # find crossing between previous above and current below\n                if prev_below is not None:\n                    x0,y0=prev_below\n                    t=(half-y0)/(y-y0)\n                    xl=x0+t*(x-x0)\n                else:\n                    xl=x\n                break\n            prev_below=(x,y)\n    p"]
[763.937666, "i", "rev_below=None\n    for x,y in reversed(list(zip(xpts,ypts))):\n        if x > c and abs(x-c) <= max_range:\n            if y < half:\n                if prev_below is not None:\n                    x1,y1=prev_below\n                    t=(half-y1)/(y-y1)\n                    xr=x1+t*(x-x1)\n                else:\n                    xr=x\n                break\n            prev_below=(x,y)\n    return max(1.0, (xr-xl)/2), peak\n\ndef solve4(N,b):\n    n=4\n    M=[row[:]+[b[i]] for i,row in enumerate(N)]\n    for col in range(n):\n        piv=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[piv][col]) < 1e-14: return None\n        M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for j in range(col,n+1): M[col][j]/=pv\n        for r in range(n):\n            if r==col: continue\n            factor=M[r][col]\n            for j in range(col,n+1): M[r][j]-=factor*M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef fit_points(xpts, ypts, c0, gamma0, a0, b0):\n    p=[math.log(max(1e-6,a0)), float(c0), math.log("]
[763.937736, "o", "cat > /app/fit_test2.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[763.93778, "i", "max(1e-6,gamma0)), float(b0)]\n    def cost(p):\n        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\n        s=0.0\n        for x,y in zip(xpts,ypts):\n            u=x-c; d2=u*u+g2\n            f=A*(g2/d2)+b\n            r=y-f\n            s+=r*r\n        return s\n    cur=cost(p); lam=1e-6\n    for it in range(300):\n        N=[[0.0]*4 for _ in range(4)]; rhs=[0.0]*4\n        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\n        for x,y in zip(xpts,ypts):\n            u=x-c; d2=u*u+g2; L=g2/d2\n            f=A*L+b; r=y-f\n            j=(A*L, A*2*u*g2/(d2*d2), A*2*g2*u*u/(d2*d2), 1.0)\n            for i in range(4):\n                Ji=j[i]; rhs[i]+=Ji*r\n                for k in range(4): N[i][k]+=Ji*j[k]\n        dp=None; ll=lam\n        for _ in range(30):\n            Nl=[row[:] for row in N]\n            for i in range(4): Nl[i][i]+=ll\n            dp=solve4(Nl,rhs)\n            if dp is not None: break\n            ll*=10\n        if dp is None: break\n        newp=[p[i]+dp[i] for i in range(4)]\n      "]
[763.937818, "o", "import csv, math\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> xs=[]; ys=[]\r\n\u001b[?2004l\r"]
[763.937855, "i", "  newc=cost(newp)\n        if newc < cur:\n            mx=max(abs(v) for v in dp)\n            p=newp; cur=newc; lam=max(1e-12,ll*0.5)\n            if mx < 1e-9: break\n        else:\n            lam=max(lam*10,1e-12)\n    A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]\n    rms=math.sqrt(cur/len(xpts))\n    return dict(x0=c, gamma=g, amplitude=A, offset=b, rms=rms)\n\ndef window_fit(lo, hi, xbase, ybase, base_init):\n    xpts=[x for x in xbase if lo<=x<=hi]; ypts=[y for y in ybase if lo<=x<=hi]  # careful filter ybase by xbase\n    # fix: ybase list aligned; better use zip\n    xpts=[]; ypts=[]\n    for x,y in zip(xbase,ybase):\n        if lo<=x<=hi: xpts.append(x); ypts.append(y)\n    c0, peak = max_in(xpts,ypts)\n    gamma0, peak2 = estimate_gamma(c0, base_init, xpts, ypts)\n    a0=max(1.0, peak2-base_init)\n    return fit_points(xpts,ypts,c0,gamma0,a0,base_init)\n\ndef lor_no_offset(x, A,c,g):\n    u=x-c; g2=g*g\n    return A*g2/(u*u+g2)\n\nbase_idx=[i for i,x in enumerate(xs) if 1750 <= x <= 2350]\nbase_global=sum(ys[i] for i i"]
