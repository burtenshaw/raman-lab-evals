[863.360337, "i", "cat > /app/fit_final.py <<'PY'\nimport csv, math, json\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    next(f)\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split(',')\n        xs.append(float(a)); ys.append(float(b))\n\ndef solve4(N,b):\n    n=4\n    M=[row[:]+[b[i]] for i,row in enumerate(N)]\n    for col in range(n):\n        piv=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[piv][col]) < 1e-15: return None\n        M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for j in range(col,n+1): M[col][j]/=pv\n        for r in range(n):\n            if r==col: continue\n            factor=M[r][col]\n            for j in range(col,n+1): M[r][j]-=factor*M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef fit_lor(xpts, ypts, c0, gamma0, a0, b0):\n    p=[math.log(max(1e-6,a0)), float(c0), math.log(max(1e-6,gamma0)), float(b0)]\n    def cost(p):\n        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\n        s=0.0\n        for x,y in zip(xpt"]
[863.360468, "i", "s,ypts):\n            u=x-c; d2=u*u+g2\n            r=y-(A*(g2/d2)+b)\n            s+=r*r\n        return s\n    cur=cost(p); lam=1e-6\n    for _ in range(500):\n        N=[[0.0]*4 for _ in range(4)]; rhs=[0.0]*4\n        A=math.exp(p[0]); c=p[1]; g=math.exp(p[2]); b=p[3]; g2=g*g\n        for x,y in zip(xpts,ypts):\n            u=x-c; d2=u*u+g2; L=g2/d2\n            r=y-(A*L+b)\n            j=(A*L, A*2*u*g2/(d2*d2), A*2*g2*u*u/(d2*d2), 1.0)\n            for i in range(4):\n                Ji=j[i]; rhs[i]+=Ji*r\n                for k in range(4): N[i][k]+=Ji*j[k]\n        dp=None; ll=lam\n        for _ in range(40):\n            Nl=[row[:] for row in N]\n            for i in range(4): Nl[i][i]+=ll\n            dp=solve4(Nl,rhs)\n            if dp is not None: break\n            ll*=10.0\n        if dp is None: break\n        newp=[p[i]+dp[i] for i in range(4)]\n        newc=cost(newp)\n        if newc < cur:\n            mx=max(abs(v) for v in dp)\n            p=newp; cur=newc; lam=max(1e-13, ll*0.5)\n            if mx < 1e-10: break\n    "]
