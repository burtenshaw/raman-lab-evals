[763.940548, "o", "\u001b[?2004h> "]
[763.940585, "o", "    xl=xr=c\r\n\u001b[?2004l\r"]
[763.940621, "o", "\u001b[?2004h> "]
[763.940658, "o", "    prev_below=None\r\n\u001b[?2004l\rb\u001b[?2004h> "]
[763.940775, "o", "    for x,y in zip(xpts,ypts):\r\n\u001b[?2004l\r"]
[763.940813, "o", "\u001b[?2004h> "]
[763.940964, "o", "        if x < c and abs(x-c) <= max_range:\r\n\u001b[?2004l\r"]
[763.940984, "o", "\u001b[?2004h> "]
[763.941123, "o", "            if y < half:\r\n\u001b[?2004l\r"]
[763.94115, "o", "\u001b[?2004h> "]
[763.94138, "o", "                # find crossing between previous above and current below\r\n\u001b[?2004l\r"]
[763.941405, "o", "\u001b[?2004h> "]
[763.941617, "o", "                if prev_below is not None:\r\n\u001b[?2004l\r"]
[763.941643, "o", "\u001b[?2004h> "]
[763.941754, "o", "                    x0,y0=prev_below\r\n\u001b[?2004l\r"]
[763.941789, "o", "\u001b[?2004h> "]
[763.941868, "o", "                    t=(half-y0)/(y-y0)\r\n\u001b[?2004l\r{"]
[763.94189, "o", "\u001b[?2004h> "]
[763.942023, "o", "                    xl=x0+t*(x-x0)\r\n\u001b[?2004l\r"]
[763.942048, "o", "\u001b[?2004h> "]
[763.942151, "o", "                else:\r\n\u001b[?2004l\r"]
[763.942176, "o", "\u001b[?2004h> "]
[763.942249, "o", "                    xl=x\r\n\u001b[?2004l\r"]
[763.942271, "o", "\u001b[?2004h> "]
[763.942344, "o", "                break\r\n\u001b[?2004l\r"]
[763.942382, "o", "\u001b[?2004h> "]
