[303.019822, "i", "python3 - <<'PY'\nimport csv\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude*gamma**2/((x-x0)**2+gamma**2)+offset\n\nxs=[];ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\nxs=np.array(xs);ys=np.array(ys)\n\ndef fit(lo,hi,amp0,x00,g0,o0):\n    m=(xs>=lo)&(xs<=hi)\n    x=xs[m];y=ys[m]\n    popt,_=curve_fit(lorentz,x,y,p0=[amp0,x00,g0,o0],maxfev=20000)\n    return popt\n\nprint('D peak robustness (center ~1346):')\nfor half in [40,60,80,100,120]:\n    p=fit(1346-half,1346+half,600,1346,25,1300)\n    print(f'  +/-{half}: amp={p[0]:8.1f} x0={p[1]:9.3f} gamma={p[2]:7.3f} off={p[3]:8.1f}')\nprint('G peak robustness (center ~1580.6):')\nfor half in [40,60,80,100]:\n    p=fit(1580.6-half,1580.6+half,7000,1580.6,25,1300)\n    print(f'  +/-{half}: amp={p[0]:8.1f} x0={p[1]:9.3f} gamma={p[2]:7.3f} off={p[3]:8.1f}')\nprint('2D peak robustness (center ~2693.9):')\nfor ha"]
[303.019995, "i", "lf in [60,80,100,120]:\n    p=fit(2693.9-half,2693.9+half,14000,2693.9,25,1300)\n    print(f'  +/-{half}: amp={p[0]:8.1f} x0={p[1]:9.3f} gamma={p[2]:7.3f} off={p[3]:8.1f}')\nPY\n"]
