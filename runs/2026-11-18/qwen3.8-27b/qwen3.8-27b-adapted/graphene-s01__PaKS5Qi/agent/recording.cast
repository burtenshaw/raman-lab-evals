[239.11021, "i", "python3 - <<'PY'\nimport csv\nxs=[];ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\nfor x,y in zip(xs,ys):\n    if 1340<=x<=1365:\n        print(f'{x:9.4f} {y:10.2f}')\nPY\n"]
