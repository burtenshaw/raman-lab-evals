[167.220705, "i", "cat > /app/fit.py <<'PY'\nimport csv, json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nxs=[];ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2:\n            xs.append(float(row[0])); ys.append(float(row[1]))\nxs=np.array(xs); ys=np.array(ys)\n\ndef fit_peak(lo,hi,x0_init,amp_init,gamma_init,offset_init):\n    m=(xs>=lo)&(xs<=hi)\n    x=xs[m]; y=ys[m]\n    p0=[amp_init,x0_init,gamma_init,offset_init]\n    popt,pcov=curve_fit(lorentz,x,y,p0=p0,maxfev=20000)\n    return popt\n\nresults={}\n# D\npD=fit_peak(1280,1420,1346.0,600,25,1300)\nresults['D']={'x0':float(pD[1]),'gamma':float(pD[2]),'amplitude':float(pD[0]),'offset':float(pD[3])}\n# G\npG=fit_peak(1500,1660,1580.6,7000,25,1300)\nresults['G']={'x0':float(pG[1]),'gamma':float(pG[2]),'amplitude':float(pG[0]),'offset':float(pG[3])}\n# 2D\np2D=fit_peak(2590,2800,2693.9,14000,25,1300)\nresults['"]
[167.220828, "i", "2D']={'x0':float(p2D[1]),'gamma':float(p2D[2]),'amplitude':float(p2D[0]),'offset':float(p2D[3])}\n\nresults['ID_IG']=float(pD[0]/pG[0])\n\nwith open('/app/results.json','w') as f:\n    json.dump(results,f,indent=2)\n\nprint(json.dumps(results,indent=2))\nprint('ID_IG =',results['ID_IG'])\nPY\n"]
