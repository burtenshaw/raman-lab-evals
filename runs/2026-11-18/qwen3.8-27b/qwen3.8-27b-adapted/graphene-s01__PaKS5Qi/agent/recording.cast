[237.148391, "i", "python3 - <<'PY'\nimport csv, json\nimport numpy as np\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude*gamma**2/((x-x0)**2+gamma**2)+offset\n\nres=json.load(open('/app/results.json'))\nprint('Keys:',list(res.keys()))\nfor name in ['D','G','2D']:\n    d=res[name]\n    keys=set(d.keys())\n    assert keys=={'x0','gamma','amplitude','offset'}, (name,keys)\n    print(name, d)\nassert 'ID_IG' in res\nprint('ID_IG', res['ID_IG'])\n\nxs=[];ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\nxs=np.array(xs);ys=np.array(ys)\n\nfor name,(lo,hi) in {'D':(1280,1420),'G':(1500,1660),'2D':(2590,2800)}.items():\n    m=(xs>=lo)&(xs<=hi)\n    x=xs[m];y=ys[m]\n    d=res[name]\n    yhat=lorentz(x,d['amplitude'],d['x0'],d['gamma'],d['offset'])\n    ss_res=np.sum((y-yhat)**2); ss_tot=np.sum((y-np.mean(y))**2)\n    print(name,'R2=',1-ss_res/ss_tot,'rmse=',np.sqrt(np.mean((y-yhat)**2)))\nprint('JSON valid and complete.')\nPY\n"]
[237.148559, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[237.148612, "o", "\u001b[?2004h> "]
[237.148654, "o", "import csv, json\r\n\u001b[?2004l\r"]
[237.148668, "o", "\u001b[?2004h> "]
[237.148704, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[237.148744, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.148786, "o", "\u001b[?2004h> "]
[237.148847, "o", "def lorentz(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[237.148878, "o", "\u001b[?2004h> "]
[237.148999, "o", "    return amplitude*gamma**2/((x-x0)**2+gamma**2)+offset\r\n\u001b[?2004l\r"]
[237.149031, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.149044, "o", "\u001b[?2004h> "]
[237.149132, "o", "res=json.load(open('/app/results.json'))\r\n\u001b[?2004l\r"]
[237.149168, "o", "\u001b[?2004h> "]
[237.149224, "o", "print('Keys:',list(res.keys()))\r\n\u001b[?2004l\r"]
[237.149256, "o", "\u001b[?2004h"]
[237.14929, "o", "> "]
[237.149325, "o", "for name in ['D','G','2D']:\r\n\u001b[?2004l\r"]
[237.149357, "o", "\u001b[?2004h> "]
[237.149392, "o", "    d=res[name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.149442, "o", "    keys=set(d.keys())\r\n\u001b[?2004l\r"]
[237.149492, "o", "\u001b[?2004h> "]
[237.149601, "o", "    assert keys=={'x0','gamma','amplitude','offset'}, (name,keys)\r\n\u001b[?2004l\r"]
[237.149633, "o", "\u001b[?2004h> "]
[237.149664, "o", "    print(name, d)\r\n\u001b[?2004l\r"]
[237.149673, "o", "\u001b[?2004h"]
[237.149685, "o", "> "]
[237.149737, "o", "assert 'ID_IG' in res\r\n\u001b[?2004l\r"]
[237.149755, "o", "\u001b[?2004h"]
[237.149788, "o", "> "]
[237.149821, "o", "print('ID_IG', res['ID_IG'])\r\n\u001b[?2004l\r"]
[237.149848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.149879, "o", "\u001b[?2004h> "]
[237.14991, "o", "xs=[];ys=[]\r\n\u001b[?2004l\r"]
[237.149936, "o", "\u001b[?2004h> "]
[237.150011, "o", "with open('/app/spectrum.csv') as f:\r\n\u001b[?2004l\r"]
[237.150019, "o", "\u001b[?2004h"]
[237.150049, "o", "> "]
[237.150097, "o", "    r=csv.reader(f); next(r)\r\n\u001b[?2004l\r"]
[237.150121, "o", "\u001b[?2004h"]
[237.15015, "o", "> "]
[237.150186, "o", "    for row in r:\r\n\u001b[?2004l\r"]
[237.15022, "o", "\u001b[?2004h> "]
[237.150312, "o", "        xs.append(float(row[0])); ys.append(float(row[1]))\r\n\u001b[?2004l\r"]
[237.150336, "o", "\u001b[?2004h> "]
[237.150404, "o", "xs=np.array(xs);ys=np.array(ys)\r\n\u001b[?2004l\r"]
[237.150419, "o", "\u001b[?2004h"]
[237.150436, "o", "> "]
[237.150474, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.15062, "o", "for name,(lo,hi) in {'D':(1280,1420),'G':(1500,1660),'2D':(2590,2800)}.items():\r\n\u001b[?2004l\r"]
[237.150663, "o", "\u001b[?2004h> "]
[237.150693, "o", "    m=(xs>=lo)&(xs<=hi)\r\n\u001b[?2004l\r"]
[237.150719, "o", "\u001b[?2004h> "]
[237.150762, "o", "    x=xs[m];y=ys[m]\r\n\u001b[?2004l\r"]
[237.150792, "o", "\u001b[?2004h> "]
[237.150827, "o", "    d=res[name]\r\n\u001b[?2004l\r"]
[237.150852, "o", "\u001b[?2004h> "]
[237.150982, "o", "    yhat=lorentz(x,d['amplitude'],d['x0'],d['gamma'],d['offset'])\r\n\u001b[?2004l\r"]
[237.151013, "o", "\u001b[?2004h> "]
[237.15114, "o", "    ss_res=np.sum((y-yhat)**2); ss_tot=np.sum((y-np.mean(y))**2)\r\n\u001b[?2004l\r"]
[237.151149, "o", "\u001b[?2004h"]
[237.151171, "o", "> "]
[237.151331, "o", "    print(name,'R2=',1-ss_res/ss_tot,'rmse=',np.sqrt(np.mean((y-yhat)**2)))\r\n\u001b[?2004l\r"]
[237.151363, "o", "\u001b[?2004h> "]
