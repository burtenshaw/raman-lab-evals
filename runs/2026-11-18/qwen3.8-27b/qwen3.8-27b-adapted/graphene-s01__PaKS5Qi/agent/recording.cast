[57.899581, "i", "python3 - <<'PY'\nimport csv\nxs=[];ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2:\n            xs.append(float(row[0])); ys.append(float(row[1]))\nprint('n=',len(xs))\nprint('x range', min(xs), max(xs))\nprint('y range', min(ys), max(ys))\ndef peak(lo,hi):\n    best=(-1e18,-1)\n    for x,y in zip(xs,ys):\n        if lo<=x<=hi:\n            if y>best[0]: best=(y,x)\n    return best\nprint('D region ',peak(1300,1400))\nprint('G region ',peak(1530,1630))\nprint('2D region',peak(2640,2740))\nPY\n"]
