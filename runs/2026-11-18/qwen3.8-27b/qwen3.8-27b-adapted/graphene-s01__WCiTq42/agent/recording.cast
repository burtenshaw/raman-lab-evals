[118.778555, "i", "cat << 'EOF' > /app/check.py\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\nres = json.load(open('/app/results.json'))\nfor name, center in [('D',1350.0),('G',1580.0),('2D',2690.0)]:\n    for hw in [100, 150, 200]:\n        m = (x >= center-hw) & (x <= center+hw)\n        xw, yw = x[m], y[m]\n        imax = np.argmax(yw)\n        p0 = [yw[imax]-yw.min(), xw[imax], 30.0, yw.min()]\n        popt,_ = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\n        popt[2] = abs(popt[2])\n        print(f\"{name} hw={hw}: amp={popt[0]:.2f} x0={popt[1]:.2f} g={popt[2]:.2f} off={popt[3]:.2f}\")\n    # R^2 with saved params in hw=100 window\n    m = (x >= center-100) & (x <= center+100)\n    xw, yw = x[m], y[m]\n    r = res[name]\n    yhat = lorentz(xw, r['amplitude'], r['x0'], r['gamma'], r['offset'])\n    ss_res "]
[118.778705, "i", "= np.sum((yw-yhat)**2); ss_tot = np.sum((yw-yw.mean())**2)\n    print(f\"{name} R^2={1-ss_res/ss_tot:.4f} resid_std={np.std(yw-yhat):.1f}\")\nprint(open('/app/results.json').read())\nEOF\npython3 /app/check.py\n"]
[118.778912, "o", "cat << 'EOF' > /app/check.py\r\n\u001b[?2004l\r= np.sum((yw-yhat)**2); ss_tot = np.sum((yw-yw.mean())**2)\r\n    print(f\"{name} R^2={1-ss_res/ss_tot:.4f} resid_std={np.std(yw-yhat):.1f}\")\r\nprint(open('/app/results.json').read())\r\nEOF\r\npython3 /app/check.py\r\n\u001b[?2004h"]
