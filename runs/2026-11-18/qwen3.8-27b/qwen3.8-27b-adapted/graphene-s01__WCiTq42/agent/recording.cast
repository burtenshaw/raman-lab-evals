[202.335512, "o", "\u001b[?2004h> "]
[202.335593, "o", "    assert all(isinstance(r[k][t], float) for t in ['x0','gamma','amplitude','offset'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.335628, "o", "> "]
