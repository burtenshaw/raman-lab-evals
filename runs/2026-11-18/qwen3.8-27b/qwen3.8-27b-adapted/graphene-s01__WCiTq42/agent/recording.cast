[165.177253, "i", "cat << 'EOF' > /app/dcheck.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\n\n# print coarse view of D region\nfor xi in range(1290, 1420, 10):\n    m = (x>=xi)&(x<xi+10)\n    print(f\"x~{xi}-{xi+10}: mean={y[m].mean():.1f}\")\nprint('---noise estimate (flat far region 1200-1280):', y[(x>=1200)&(x<1280)].std())\n\nfor hw in [60, 80, 100, 120, 150]:\n    m = (x >= 1350-hw) & (x <= 1350+hw)\n    xw, yw = x[m], y[m]\n    imax = np.argmax(yw)\n    p0 = [yw[imax]-yw.min(), xw[imax], 20.0, yw.min()]\n    popt,pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=50000)\n    amp,x0,g,off = popt\n    yhat = lorentz(xw,*popt)\n    print(f\"hw={hw}: amp={amp:.2f} x0={x0:.2f} g={g:.2f} off={off:.2f} resid_std={np.std(yw-yhat):.1f}\")\nEOF\npython3 /app/dcheck.py\n"]
[165.177397, "o", "cat << 'EOF' > /app/dcheck.py\r\n\u001b[?2004l\r"]
[165.177416, "o", "\u001b[?2004h> "]
