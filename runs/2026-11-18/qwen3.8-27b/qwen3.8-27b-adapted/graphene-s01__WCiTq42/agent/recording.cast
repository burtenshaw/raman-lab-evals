[58.066685, "i", "cat << 'EOF' > /app/explore.py\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\nprint('x range:', x.min(), x.max(), 'n=', len(x))\nprint('baseline-ish median:', np.median(y))\nfor name, lo, hi in [('D',1250,1450),('G',1480,1680),('2D',2590,2790)]:\n    m = (x>=lo)&(x<=hi)\n    imax = np.argmax(y[m])\n    print(name, 'peak at', x[m][imax], 'value', y[m][imax], 'window min', y[m].min())\nEOF\npython3 /app/explore.py\n"]
