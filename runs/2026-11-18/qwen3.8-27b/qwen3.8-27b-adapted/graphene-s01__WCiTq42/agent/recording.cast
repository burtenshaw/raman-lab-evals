[202.335054, "i", "python3 -c \"\nimport json\nr = json.load(open('/app/results.json'))\nfor k in ['D','G','2D']:\n    assert all(t in r[k] for t in ['x0','gamma','amplitude','offset']), k\n    assert all(isinstance(r[k][t], float) for t in ['x0','gamma','amplitude','offset'])\nassert isinstance(r['ID_IG'], float)\nassert abs(r['ID_IG'] - r['D']['amplitude']/r['G']['amplitude']) < 1e-9\nprint('VALID. ID_IG =', r['ID_IG'])\nprint(json.dumps(r, indent=2))\n\"\n"]
[202.335233, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
