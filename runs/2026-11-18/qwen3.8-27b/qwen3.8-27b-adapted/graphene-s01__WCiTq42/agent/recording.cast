[202.335341, "o", "r = json.load(open('/app/results.json'))\r\n\u001b[?2004l\r"]
[202.335382, "o", "\u001b[?2004h> for k in ['D','G','2D']:\r\n\u001b[?2004l\r"]
[202.335423, "o", "\u001b[?2004h> "]
