[?2004l[?2004h> import numpy as np, json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = data[:,0], data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, center in [('D',1350.0),('G',1580.0),('2D',2690.0)]:
[?2004l[?2004h>     m = (x >= center-100) & (x <= center+100)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     imax = np.argmax(yw)
[?2004l[?2004h>     amp0 = yw[imax] - yw.min()
[?2004l[?2004h>     x00 = xw[imax]
[?2004l[?2004h>     off0 = yw.min()
[?2004l[?2004h>     p0 = [amp0, x00, 30.0, off0]
[?2004l[?2004h>     bounds = ([0, center-50, 1, -np.inf], [np.inf, center+50, 200, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     amplitude, x0, gamma, offset = popt
[?2004l[?2004h>     results[name] = {"x0": float(x0), "gamma": float(abs(gamma)),
[?2004l[?2004h>                      "amplitude": float(amplitude), "offset": float(offset)}
[?2004l[?2004h>     print(name, results[name], 'perr:', np.sqrt(np.diag(pcov)))
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print('ID_IG =', results['ID_IG'])
[?2004l[?2004h> with open('/app/results.json','w') as f:
