Sending keys: ["cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\nprint('range:', x.min(), x.max(), 'npts:', len(x))\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, half=80.0):\n    mask = (x >= center - half) & (x <= center + half)\n    xs, ys = x[mask], y[mask]\n    offset0 = np.median(ys)\n    amp0 = ys.max() - offset0\n    x00 = xs[np.argmax(ys)]\n    # gamma estimate: half width at half max\n    yhalf = offset0 + amp0 / 2.0\n    above = xs[ys >= yhalf]\n    g0 = (above.max() - above.min()) / 2.0 if len(above) > 1 else 20.0\n    if g0 < 1: g0 = 20.0\n    p0 = [amp0, x00, g0, offset0]\n    bounds = ([0, center - half, 1, -np.inf],\n              [np.inf, center + half, half, np.inf])\n    popt, pcov = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    perr = np.sqrt(np.diag(pcov))\n    return popt, perr\n\nresults = {}\nfor name, center in [('D', 1350.0), ('G', 1580.0), ('2D', 2690.0)]:\n    popt, perr = fit_peak(center)\n    amp, x0, gamma, offset = popt\n    results[name] = {'x0': float(x0), 'gamma': float(abs(gamma)),\n                     'amplitude': float(amp), 'offset': float(offset)}\n    print(name, 'x0=%.3f+-%.3f gamma=%.3f+-%.3f amp=%.3f+-%.3f off=%.3f+-%.3f'\n          % (x0, perr[1], abs(gamma), perr[2], amp, perr[0], offset, perr[3]))\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\nprint('ID_IG =', results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('written /app/results.json')\nEOF\npython3 /app/fit.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
