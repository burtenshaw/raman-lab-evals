Sending keys: ["cat > /app/fit2.py <<'PY'\nimport csv, json, numpy as np\nfrom scipy.optimize import curve_fit\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\nx=np.array(xs); y=np.array(ys)\n\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x-x0)**2 + gamma**2) + offset\n\ndef fit(name, lo, hi):\n    m=(x>=lo)&(x<=hi)\n    xx=x[m]; yy=y[m]\n    imax=np.argmax(yy)\n    base=np.median(yy[:20])\n    amp0=max(1.0, yy[imax]-base)\n    half=base+amp0/2\n    left=None; right=None\n    for i in range(imax,-1,-1):\n        if yy[i]<=half: left=i; break\n    for i in range(imax,len(yy)):\n        if yy[i]<=half: right=i; break\n    g0=10.0\n    if left is not None and right is not None and right>left:\n        g0=max(1.0,(xx[right]-xx[left])/2.0)\n    p0=[amp0, xx[imax], g0, base]\n    popt,pcov=curve_fit(lorentz, xx, yy, p0=p0, maxfev=20000)\n    resid=yy-lorentz(xx,*popt)\n    rms=np.sqrt(np.mean(resid**2))\n    print(f'{name}: window {lo}-{hi} n={len(xx)} amp={popt[0]:.4f} x0={popt[1]:.4f} gamma={popt[2]:.4f} off={popt[3]:.4f} rms={rms:.4f}')\n    return {'x0':float(popt[1]),'gamma':float(popt[2]),'amplitude':float(popt[0]),'offset':float(popt[3])}\n\nD=fit('D',1250,1460)\nG=fit('G',1500,1660)\nTD=fit('2D',2560,2820)\nres={'D':D,'G':G,'2D':TD,'ID_IG':D['amplitude']/G['amplitude']}\nwith open('/app/results.json','w') as f: json.dump(res,f,indent=2)\nprint('ID_IG=',res['ID_IG'])\nprint(json.dumps(res,indent=2))\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
