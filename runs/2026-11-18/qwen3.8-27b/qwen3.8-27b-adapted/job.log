Sending keys: ['cat << \'EOF\' > /app/fit.py\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndata = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\n# Define peak regions\npeaks = {\n    \'D\': (1350, (1200, 1500)),\n    \'G\': (1580, (1450, 1720)),\n    \'2D\': (2690, (2500, 2900)),\n}\n\nresults = {}\n\nfor name, (center, (lo, hi)) in peaks.items():\n    # Select data in the region\n    mask = (x >= lo) & (x <= hi)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses\n    offset0 = np.median(y_fit)\n    amp0 = np.max(y_fit) - offset0\n    x0_0 = center\n    gamma0 = 20  # typical width\n    \n    p0 = [x0_0, gamma0, amp0, offset0]\n    \n    try:\n        popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0,\n                                maxfev=10000)\n    except RuntimeError:\n        # Try with bounds\n        popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0,\n                                maxfev=10000,\n                                bounds=([lo-50, 0.1, 0, 0], [hi+50, 200, 1e6, 1e6]))\n    \n    x0, gamma, amplitude, offset = popt\n    results[name] = {\n        \'x0\': float(x0),\n        \'gamma\': float(abs(gamma)),\n        \'amplitude\': float(amplitude),\n        \'offset\': float(offset)\n    }\n    print(f"{name}: x0={x0:.2f}, gamma={gamma:.2f}, amplitude={amplitude:.2f}, offset={offset:.2f}")\n\nid_ig = results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\']\nresults[\'ID_IG\'] = float(id_ig)\nprint(f"ID/IG = {id_ig:.4f}")\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("Done. Results written to /app/results.json")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /app/fit.py <<'PY'\nimport csv, json, math\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\n\ndef lorentz(x, A, x0, g, c):\n    return A * g*g / ((x - x0)**2 + g*g) + c\n\ndef fit_peak(name, cx, half_width, min_amp=None):\n    sel=[(x,y) for x,y in zip(xs,ys) if abs(x-cx) <= half_width]\n    sel.sort()\n    xdata=[x for x,y in sel]; ydata=[y for x,y in sel]\n    n=len(sel)\n    # initial guesses\n    imax=max(range(n), key=lambda i:ydata[i])\n    x0=xdata[imax]; A0=ydata[imax] - sum(ydata[:20])/20  # rough\n    # estimate gamma from half maximum above baseline\n    base=sum(ydata[:20])/20\n    A_est=max(1.0, ydata[imax] - base)\n    half=base + A_est/2\n    # left\n    li=None\n    for i in range(imax,-1,-1):\n        if ydata[i] <= half:\n            li=i; break\n    ri=None\n    for i in range(imax,n):\n        if ydata[i] <= half:\n            ri=i; break\n    if li is None or ri is None:\n        g0=10.0\n    else:\n        fwhm=xdata[ri]-xdata[li]\n        g0=max(1.0, fwhm/2.0)\n    c0=base\n    # ensure positive A\n    A=max(1.0, A0)\n    g=max(1.0, g0)\n    p=[A,x0,g,c0]\n    # Gauss-Newton\n    for it in range(1000):\n        # residuals and Jacobian\n        J=[]; rvec=[]\n        for x,y in zip(xdata,ydata):\n            dxx=x-p[1]\n            den=dxx*dxx + p[2]*p[2]\n            f=A_est? 0:0\n        # actually compute properly\n        rvec=[]; Jcols=[[0.0]*n for _ in range(4)]\n        for i,(x,y) in enumerate(zip(xdata,ydata)):\n            dxx=x-p[1]\n            den=dxx*dxx + p[2]*p[2]\n            f=p[0]*p[2]*p[2]/den + p[3]\n            rvec.append(f-y)\n            # derivatives: d f / dA = g^2/den\n            Jcols[0][i]=p[2]*p[2]/den\n            # d f / dx0 = A * 2 g^2 dxx / den^2\n            Jcols[1][i]=p[0]*2.0*p[2]*p[2]*dxx/(den*den)\n            # d f / dg = A * (2g*den - g^2*2g)/den^2 = 2 A g (den - g^2)/den^2 = 2 A g (dxx^2)/(den^2)\n            Jcols[2][i]=p[0]*2.0*p[2]*dxx*dxx/(den*den)\n            Jcols[3][i]=1.0\n        # normal equations 4x4\n        JtJ=[[0.0]*4 for _ in range(4)]\n        Jtr=[0.0]*4\n        for i in range(n):\n            ri=rvec[i]\n            for a in range(4):\n                Jtr[a]+=Jcols[a][i]*ri\n                for b in range(4):\n                    JtJ[a][b]+=Jcols[a][i]*Jcols[b][i]\n        # solve using Gauss-Jordan with regularization\n        reg=1e-9\n        for a in range(4):\n            JtJ[a][a]+=reg\n        # augment\n        M=[JtJ[a][:]+[Jtr[a]] for a in range(4)]\n        for col in range(4):\n            piv=col\n            for row in range(col,4):\n                if abs(M[row][col]) > abs(M[piv][col]): piv=row\n            M[col],M[piv]=M[piv],M[col]\n            pv=M[col][col]\n            if abs(pv)<1e-12:\n                M[col][col]=1e-12\n            for j in range(col,5):\n                M[col][j]/=M[col][col]\n            for row in range(4):\n                if row!=col:\n                    factor=M[row][col]\n                    for j in range(col,5):\n                        M[row][j]-=factor*M[col][j]\n        step=[M[i][4] for i in range(4)]\n        # line search\n        best=None\n        cur_sse=sum(r*r for r in rvec)\n        alpha=1.0\n        for _ in range(30):\n            newp=[p[i]+alpha*step[i] for i in range(4)]\n            sse=sum((lorentz(x,*newp)-y)**2 for x,y in zip(xdata,ydata))\n            if sse < cur_sse*(1-1e-12):\n                best=(sse,newp)\n                p=newp\n                break\n            alpha*=0.5\n        else:\n            break\n        # enforce positivity of amplitude/gamma maybe\n        if p[0] < 0: p[0]=abs(p[0])\n        if p[2] < 0: p[2]=abs(p[2])\n        if abs(step[0])<1e-6 and abs(step[1])<1e-8 and abs(step[2])<1e-8 and abs(step[3])<1e-6:\n            break\n    # final parameters\n    sse=sum((lorentz(x,*p)-y)**2 for x,y in zip(xdata,ydata))\n    rms=math.sqrt(sse/n)\n    print(f'{name}: n={n} x0={p[1]:.4f} g={p[2]:.4f} A={p[0]:.4f} c={p[3]:.4f} rms={rms:.4f}')\n    return {'x0':p[1],'gamma':p[2],'amplitude':p[0],'offset':p[3]}\n\nD=fit_peak('D',1350,80)\nG=fit_peak('G',1580,80)\nTD=fit_peak('2D',2690,100)\nresult={'D':D,'G':G,'2D':TD,'ID_IG':D['amplitude']/G['amplitude']}\nwith open('/app/results.json','w') as f:\n    json.dump(result,f,indent=2)\nprint(json.dumps(result,indent=2))\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
