Sending keys: ["cat > /app/fit_scipy.py <<'PY'\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm-1']\ny = data['intensity']\n\ndef fit_window(x, y, lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\n    return popt, pcov, m\n\ndef estimate_p0(x, y, lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    imax = np.argmax(yw)\n    x0 = xw[imax]\n    offset0 = np.median(yw)\n    A0 = yw[imax] - offset0\n    # estimate fwhm: half max\n    half = offset0 + 0.5*A0\n    above = yw >= half\n    idx = np.where(above)[0]\n    if len(idx) > 1:\n        fwhm = xw[idx[-1]] - xw[idx[0]]\n    else:\n        fwhm = 20.0\n    gamma0 = fwhm/2.0\n    return [A0, x0, gamma0, offset0]\n\n# Test stability of amplitude across windows for each peak\nfor name, center, wins in [('D',1350,[(1250,1450),(1280,1420),(1300,1400),(1270,1430)]),\n                            ('G',1580,[(1480,1700),(1500,1680),(1520,1660),(1490,1690)]),\n                            ('2D',2690,[(2580,2800),(2600,2780),(2560,2820),(2590,2790)])]:\n    print(name, 'center', center)\n    for lo,hi in wins:\n        p0 = estimate_p0(x,y,lo,hi)\n        popt, pcov, _ = fit_window(x,y,lo,hi,p0)\n        perr = np.sqrt(np.diag(pcov))\n        print(f'  {lo}-{hi}: A={popt[0]:8.3f}±{perr[0]:7.3f} x0={popt[1]:8.3f} g={popt[2]:7.3f} off={popt[3]:8.3f}')\nPY\npython3 /app/fit_scipy.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
