Sending keys: ['cd /app && python3 << \'EOF\'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt(\'spectrum.csv\', delimiter=\',\', skip_header=1)\nx = data[:,0]; y = data[:,1]\n\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit(lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xf, yf = x[m], y[m]\n    i = np.argmax(yf)\n    offset0 = np.median(np.concatenate([yf[:10], yf[-10:]]))\n    p0 = [yf[i]-offset0, xf[i], 20.0, offset0]\n    popt, _ = curve_fit(lorentz, xf, yf, p0=p0, maxfev=20000)\n    amp, x0, gamma, offset = popt\n    return {"x0": float(x0), "gamma": float(gamma), "amplitude": float(amp), "offset": float(offset)}\n\nD = fit(1180, 1470)\nG = fit(1470, 1760)\nD2 = fit(2500, 2880)\n\nresult = {\n    "D": D,\n    "G": G,\n    "2D": D2,\n    "ID_IG": float(D["amplitude"] / G["amplitude"])\n}\n\nwith open(\'results.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(json.dumps(result, indent=2))\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
