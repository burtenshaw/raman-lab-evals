Sending keys: ['cd /app && python3 << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt(\'spectrum.csv\', delimiter=\',\', skip_header=1)\nx = data[:,0]; y = data[:,1]\n\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit(center, lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xf, yf = x[m], y[m]\n    i = np.argmax(yf)\n    offset0 = np.median(np.concatenate([yf[:10], yf[-10:]]))\n    amp0 = yf[i] - offset0\n    p0 = [amp0, xf[i], 20.0, offset0]\n    popt, pcov = curve_fit(lorentz, xf, yf, p0=p0, maxfev=20000)\n    resid = yf - lorentz(xf, *popt)\n    ss_res = np.sum(resid**2)\n    ss_tot = np.sum((yf - yf.mean())**2)\n    r2 = 1 - ss_res/ss_tot\n    perr = np.sqrt(np.diag(pcov))\n    print(f"window [{lo},{hi}] amp={popt[0]:.1f} x0={popt[1]:.2f} gamma={popt[2]:.2f} off={popt[3]:.1f} R2={r2:.4f}")\n    print(f"   err: amp={perr[0]:.1f} x0={perr[1]:.2f} gamma={perr[2]:.2f} off={perr[3]:.1f}  resid_std={resid.std():.1f}")\n    return popt\n\npD = fit(1348, 1180, 1470)\nprint()\npG = fit(1580, 1470, 1760)\nprint()\np2D = fit(2690, 2500, 2880)\nprint()\nprint("ID/IG =", pD[0]/pG[0])\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
