Sending keys: ['cat > /app/verify.py << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', skip_header=1)\nx = data[:,0]; y = data[:,1]\n\nfor center, label, window in [(1350,\'D\',120),(1580,\'G\',120),(2690,\'2D\',120)]:\n    mask = (x > center-window) & (x < center+window)\n    xi, yi = x[mask], y[mask]\n    imax = np.argmax(yi)\n    x0_0 = xi[imax]\n    n_edge = 20\n    offset_0 = np.mean(np.concatenate([yi[:n_edge], yi[-n_edge:]]))\n    amp_0 = yi[imax] - offset_0\n    half = offset_0 + amp_0/2\n    above = xi[yi > half]\n    fwhm_0 = (above.max()-above.min()) if len(above)>1 else 20.0\n    p0 = [amp_0, x0_0, fwhm_0/2.0, offset_0]\n    popt, pcov = curve_fit(lorentzian, xi, yi, p0=p0, maxfev=100000)\n    pred = lorentzian(xi, *popt)\n    ss_res = np.sum((yi-pred)**2)\n    ss_tot = np.sum((yi-np.mean(yi))**2)\n    r2 = 1 - ss_res/ss_tot\n    # data value at fitted x0\n    idx = np.argmin(np.abs(xi-popt[1]))\n    print(f"{label}: R2={r2:.5f}  fit_height={popt[0]+popt[3]:.1f}  data@x0={yi[idx]:.1f} (x0={popt[1]:.2f})  data_max={yi[imax]:.1f}")\n    print(f"     params: amp={popt[0]:.3f} x0={popt[1]:.3f} gamma={abs(popt[2]):.3f} off={popt[3]:.3f}")\n\n# Sensitivity: recompute D/G ratio with different windows\nprint("\\nWindow sensitivity for D/G ratio:")\nfor w in [60, 90, 120, 150, 200]:\n    def fit_peak(center, w):\n        m = (x>center-w)&(x<center+w)\n        xi,yi = x[m],y[m]\n        imax=np.argmax(yi)\n        oe=20; off0=np.mean(np.concatenate([yi[:oe],yi[-oe:]]))\n        a0=yi[imax]-off0; hl=off0+a0/2; ab=xi[yi>hl]\n        fw=(ab.max()-ab.min()) if len(ab)>1 else 20.0\n        p,_=curve_fit(lorentzian,xi,yi,p0=[a0,xi[imax],fw/2.0,off0],maxfev=100000)\n        return p\n    d=fit_peak(1350,w); g=fit_peak(1580,w)\n    print(f"  w={w:3d}: Damp={d[0]:.2f} Gamp={g[0]:.2f} ID_IG={d[0]/g[0]:.6f}")\nEOF\npython3 /app/verify.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
