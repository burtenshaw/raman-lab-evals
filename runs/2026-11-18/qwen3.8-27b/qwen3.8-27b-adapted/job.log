Sending keys: ["cat > /app/fit_peaks.py <<'PY'\nimport csv, json, math\n\ndef load_data(path):\n    xs=[]; ys=[]\n    with open(path, newline='') as f:\n        r=csv.reader(f)\n        next(r)\n        for row in r:\n            if len(row) >= 2:\n                try:\n                    xs.append(float(row[0]))\n                    ys.append(float(row[1]))\n                except Exception:\n                    pass\n    return xs, ys\n\ndef solve4(N, c):\n    n=4\n    M=[list(N[i]) + [c[i]] for i in range(n)]\n    for col in range(n):\n        pivot=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col]) < 1e-14:\n            return None\n        if pivot != col:\n            M[col], M[pivot] = M[pivot], M[col]\n        pv = M[col][col]\n        for r in range(n):\n            if r == col:\n                continue\n            factor = M[r][col] / pv\n            if factor == 0.0:\n                continue\n            for j in range(col, n+1):\n                M[r][j] -= factor * M[col][j]\n    out=[]\n    for i in range(n):\n        if abs(M[i][i]) < 1e-14:\n            return None\n        out.append(M[i][n] / M[i][i])\n    return out\n\ndef fit_peak(xs, ys, lo, hi):\n    idx=[i for i,x in enumerate(xs) if lo <= x <= hi]\n    xw=[xs[i] for i in idx]\n    yw=[ys[i] for i in idx]\n    n=len(xw)\n    max_i=max(range(n), key=lambda i: yw[i])\n    x0=xw[max_i]\n    ymax=yw[max_i]\n    sorted_y=sorted(yw)\n    b0=sorted_y[max(0, n//4)]\n    if b0 <= 0:\n        b0 = max(1.0, min(yw))\n    A0=max(1.0, ymax - b0)\n    half = b0 + 0.5 * A0\n    l=max_i\n    while l > 0 and yw[l] >= half:\n        l -= 1\n    r=max_i\n    while r < n - 1 and yw[r] >= half:\n        r += 1\n    g0=max(1.0, (xw[r] - xw[l]) / 4.0)\n    p=[A0, x0, g0, b0]\n\ndef model(p, x):\n    A,x0,g,b=p\n    d=x-x0\n    den=d*d + g*g\n    return A * (g*g) / den + b\n\ndef sse(p, xw, yw):\n    A,x0,g,b=p\n    s=0.0\n    for x,y in zip(xw,yw):\n        d=x-x0\n        den=d*d + g*g\n        f=A * (g*g) / den + b\n        diff=y-f\n        s += diff*diff\n    return s\n\ndef fit_peak_full(xs, ys, lo, hi):\n    idx=[i for i,x in enumerate(xs) if lo <= x <= hi]\n    xw=[xs[i] for i in idx]\n    yw=[ys[i] for i in idx]\n    n=len(xw)\n    max_i=max(range(n), key=lambda i: yw[i])\n    x0=xw[max_i]\n    ymax=yw[max_i]\n    sorted_y=sorted(yw)\n    b0=sorted_y[max(0, n//4)]\n    A0=max(1.0, ymax - b0)\n    half = b0 + 0.5 * A0\n    l=max_i\n    while l > 0 and yw[l] >= half:\n        l -= 1\n    r=max_i\n    while r < n - 1 and yw[r] >= half:\n        r += 1\n    g0=max(1.0, (xw[r] - xw[l]) / 4.0)\n    p=[A0, x0, g0, b0]\n    cur=sse(p, xw, yw)\n    lam=1e-3\n    for it in range(200):\n        N=[[0.0]*4 for _ in range(4)]\n        c=[0.0]*4\n        A,x0,g,b=p\n        for x,y in zip(xw,yw):\n            d=x-x0\n            den=d*d + g*g\n            den2=den*den\n            lor=(g*g)/den\n            f=A*lor + b\n            r=y-f\n            dA=lor\n            dx0=2.0*d*(g*g)/den2\n            dg=2.0*g*(d*d)/den2\n            db=1.0\n            vals=(dA, dx0, dg, db)\n            for i in range(4):\n                c[i] += vals[i] * r\n                for j in range(4):\n                    N[i][j] += vals[i] * vals[j]\n        trace=sum(N[i][i] for i in range(4)) / 4.0\n        if trace <= 0:\n            break\n        success=False\n        for _ in range(30):\n            Nl=[row[:] for row in N]\n            for i in range(4):\n                Nl[i][i] += lam * trace\n            delta=solve4(Nl, c)\n            if delta is None:\n                lam *= 10.0\n                continue\n            p_new=[p[i] + delta[i] for i in range(4)]\n            if p_new[2] <= 1e-4:\n                lam *= 10.0\n                continue\n            new=sse(p_new, xw, yw)\n            if new < cur:\n                p=p_new\n                cur=new\n                lam=max(lam * 0.3, 1e-12)\n                rel=max(abs(delta[i]) / max(1.0, abs(p[i])) for i in range(4))\n                success=True\n                if rel < 1e-10:\n                    break\n                break\n            else:\n                lam *= 10.0\n                if lam > 1e14:\n                    break\n        if not success:\n            break\n    A,x0,g,b=p\n    return {'x0': float(x0), 'gamma': float(g), 'amplitude': float(A), 'offset': float(b)}, cur\n\ndef main():\n    xs,ys=load_data('/app/spectrum.csv')\n    windows = {\n        'D': (1180.0, 1460.0),\n        'G': (1480.0, 1720.0),\n        '2D': (2550.0, 2850.0),\n    }\n    res={}\n    for name,(lo,hi) in windows.items():\n        params, err = fit_peak_full(xs, ys, lo, hi)\n        res[name]=params\n        print(name, params, 'sse', err)\n    res['ID_IG']=float(res['D']['amplitude'] / res['G']['amplitude'])\n    with open('/app/results.json','w') as f:\n        json.dump(res, f, indent=2)\n    print('ID_IG', res['ID_IG'])\n\nif __name__ == '__main__':\n    main()\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
