Sending keys: ['cat > /app/validate.py << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt(\'/app/spectrum.csv\', delimiter=\',\', skiprows=1)\nx, y = data[:,0], data[:,1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nimport json\nres = json.load(open(\'/app/results.json\'))\nfor name in ["D","G","2D"]:\n    p = res[name]\n    c = p["x0"]\n    m = (x > c-80) & (x < c+80)\n    xs, ys = x[m], y[m]\n    pred = lorentz(xs, p["amplitude"], p["x0"], p["gamma"], p["offset"])\n    ss_res = np.sum((ys-pred)**2)\n    ss_tot = np.sum((ys-np.mean(ys))**2)\n    r2 = 1 - ss_res/ss_tot\n    print(f"{name}: R2={r2:.5f}  amp={p[\'amplitude\']:.1f} x0={p[\'x0\']:.2f} gamma={p[\'gamma\']:.2f}")\nprint("ID_IG =", res["ID_IG"])\n# stability check: refit with different window\nfor name, center, window in [("D",1350,100),("G",1580,100),("2D",2690,160)]:\n    m = (x>center-window)&(x<center+window)\n    xs, ys = x[m], y[m]\n    off0 = np.median(ys); amp0 = ys.max()-off0\n    w = (ys-off0).clip(min=0)\n    x00 = (xs*w).sum()/w.sum()\n    popt,_ = curve_fit(lorentz, xs, ys, p0=[amp0,x00,10.0,off0], maxfev=100000)\n    print(f"{name} (wide win): amp={popt[0]:.1f} x0={popt[1]:.2f}")\nEOF\npython3 /app/validate.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
