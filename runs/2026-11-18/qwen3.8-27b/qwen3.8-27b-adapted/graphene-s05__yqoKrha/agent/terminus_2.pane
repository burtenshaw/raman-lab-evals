[?2004l[?2004h>     half=base+amp0/2
[?2004l[?2004h>     left=None; right=None
[?2004l[?2004h>     for i in range(imax,-1,-1):
[?2004l[?2004h>         if yy[i]<=half: left=i; break
[?2004l[?2004h>     for i in range(imax,len(yy)):
[?2004l[?2004h>         if yy[i]<=half: right=i; break
[?2004l[?2004h>     g0=10.0
[?2004l[?2004h>     if left is not None and right is not None and right>left:
[?2004l[?2004h>         g0=max(1.0,(xx[right]-xx[left])/2.0)
[?2004l[?2004h>     p0=[amp0, xx[imax], g0, base]
[?2004l[?2004h>     popt,pcov=curve_fit(lorentz, xx, yy, p0=p0, maxfev=20000)
[?2004l[?2004h>     resid=yy-lorentz(xx,*popt)
[?2004l[?2004h>     rms=np.sqrt(np.mean(resid**2))
[?2004l[?2004h>     print(f'{name}: window {lo}-{hi} n={len(xx)} amp={popt[0]:.4f} x0={popt[1]:.4f} gamma={popt[2]:.4f} off={popt[3]:.4f} rms={rms:.4f}')
[?2004l[?2004h>     return {'x0':float(popt[1]),'gamma':float(popt[2]),'amplitude':float(popt[0]),'offset':float(popt[3])}
[?2004l[?2004h> 
[?2004l[?2004h> D=fit('D',1250,1460)
