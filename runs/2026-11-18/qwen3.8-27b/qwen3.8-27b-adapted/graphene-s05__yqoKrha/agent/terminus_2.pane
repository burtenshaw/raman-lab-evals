[?2004l[?2004h> import csv, json, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> xs=[]; ys=[]
[?2004l[?2004h> with open('/app/spectrum.csv') as f:
[?2004l[?2004h>     r=csv.reader(f); next(r)
[?2004l[?2004h>     for row in r:
[?2004l[?2004h>         if len(row)>=2 and row[0].strip():
[?2004l[?2004h>             xs.append(float(row[0])); ys.append(float(row[1]))
[?2004l[?2004h> x=np.array(xs); y=np.array(ys)
[?2004l[?2004h> def lorentz(x, amp, x0, gamma, offset):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2)+offset
[?2004l[?2004h> def fitname(name, lo, hi):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]
[?2004l[?2004h>     imax=np.argmax(yy); base=np.median(yy[:20])
[?2004l[?2004h>     amp0=max(1.0, yy[imax]-base); half=base+amp0/2
[?2004l[?2004h>     left=None; right=None
[?2004l[?2004h>     for i in range(imax,-1,-1):
[?2004l[?2004h>         if yy[i]<=half: left=i; break
[?2004l[?2004h>     for i in range(imax,len(yy)):
[?2004l[?2004h>         if yy[i]<=half: right=i; break
[?2004l[?2004h>     g0=10.0
[?2004l[?2004h>     if left is not None and right is not None and right>left:
[?2004l[?2004h>         g0=max(1.0,(xx[right]-xx[left])/2.0)
[?2004l[?2004h>     popt,_=curve_fit(lorentz, xx, yy, p0=[amp0, xx[imax], g0, base], maxfev=20000)
[?2004l[?2004h>     return popt
[?2004l[?2004h> print('D windows:')
[?2004l[?2004h> for lo,hi in [(1280,1440),(1300,1420),(1250,1460),(1220,1490),(1260,1450)]:
[?2004l[?2004h>     p=fitname('D',lo,hi)
[?2004l[?2004h>     print(f'  {lo}-{hi}: amp={p[0]:.1f} x0={p[1]:.2f} g={p[2]:.2f} off={p[3]:.1f}')
[?2004l[?2004h> print('G windows:')
[?2004l[?2004h> for lo,hi in [(1520,1640),(1540,1620),(1500,1660),(1480,1680),(1510,1650)]:
[?2004l[?2004h>     p=fitname('G',lo,hi)
[?2004l[?2004h>     print(f'  {lo}-{hi}: amp={p[0]:.1f} x0={p[1]:.2f} g={p[2]:.2f} off={p[3]:.1f}')
[?2004l[?2004h> print('2D windows:')
