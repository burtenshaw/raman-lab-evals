[671.27126, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\nfor a,b in [(1330,1385),(1560,1605),(2665,2715)]:\n    print('===',a,b)\n    for x,y in zip(xs,ys):\n        if a<=x<=b:\n            print(f'{x:.2f} {y:.1f}')\nPY\n"]
