[142.534252, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\nprint('n', len(xs), 'x', xs[0], xs[-1])\nprint('y min/max', min(ys), max(ys))\nfor c in [1350,1580,2690]:\n    sel=[(x,y) for x,y in zip(xs,ys) if c-200 <= x <= c+200]\n    if not sel: print(c, 'no data'); continue\n    mxy=max(sel, key=lambda p:p[1])\n    my=sorted(y for _,y in sel)\n    print('center',c,'n',len(sel),'max',mxy,'q1',my[len(my)//4],'med',my[len(my)//2],'q3',my[3*len(my)//4])\nPY\n"]
