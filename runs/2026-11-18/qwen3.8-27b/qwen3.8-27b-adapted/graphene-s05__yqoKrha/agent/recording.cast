[64.995602, "i", "python3 - <<'PY'\nimport csv\nimport numpy as np\nx=[]; y=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            x.append(float(row[0])); y.append(float(row[1]))\nx=np.array(x); y=np.array(y)\nprint('n', len(x), 'xmin', x.min(), 'xmax', x.max(), 'ymin', y.min(), 'ymax', y.max())\nfor c in [1350, 1580, 2690]:\n    m=(x>=c-250)&(x<=c+250)\n    if m.sum():\n        idx=np.argmax(y[m])\n        print(c, 'localmax', x[m][idx], y[m][idx], 'min', y[m].min(), 'mean', y[m].mean())\nPY\n"]
