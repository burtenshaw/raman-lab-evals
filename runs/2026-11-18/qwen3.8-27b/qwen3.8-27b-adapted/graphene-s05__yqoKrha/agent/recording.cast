[876.471242, "i", "python3 - <<'PY'\nimport json\nwith open('/app/results.json') as f:\n    d=json.load(f)\nfor k in ['D','G','2D']:\n    for p in ['x0','gamma','amplitude','offset']:\n        assert isinstance(d[k][p], float), (k,p)\nassert isinstance(d['ID_IG'], float)\nrat=d['D']['amplitude']/d['G']['amplitude']\nprint('ID_IG stored:', d['ID_IG'])\nprint('ID_IG recomputed:', rat)\nprint('match:', abs(d['ID_IG']-rat)<1e-12)\nprint('OK: all required keys present and float')\nprint(json.dumps(d, indent=2))\nPY\n"]
