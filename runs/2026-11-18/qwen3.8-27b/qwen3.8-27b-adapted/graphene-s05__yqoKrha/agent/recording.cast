[856.893197, "i", "cat > /app/sens.py <<'PY'\nimport csv, json, numpy as np\nfrom scipy.optimize import curve_fit\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\nx=np.array(xs); y=np.array(ys)\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+offset\ndef fitname(name, lo, hi):\n    m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]\n    imax=np.argmax(yy); base=np.median(yy[:20])\n    amp0=max(1.0, yy[imax]-base); half=base+amp0/2\n    left=None; right=None\n    for i in range(imax,-1,-1):\n        if yy[i]<=half: left=i; break\n    for i in range(imax,len(yy)):\n        if yy[i]<=half: right=i; break\n    g0=10.0\n    if left is not None and right is not None and right>left:\n        g0=max(1.0,(xx[right]-xx[left])/2.0)\n    popt,_=curve_fit(lorentz, xx, yy, p0=[amp0, xx[imax], g0, base], maxfev=20000)\n    return popt\nprint('D windows:')\nfor lo,hi in [(1280,1440),(1300,"]
[856.893315, "i", "1420),(1250,1460),(1220,1490),(1260,1450)]:\n    p=fitname('D',lo,hi)\n    print(f'  {lo}-{hi}: amp={p[0]:.1f} x0={p[1]:.2f} g={p[2]:.2f} off={p[3]:.1f}')\nprint('G windows:')\nfor lo,hi in [(1520,1640),(1540,1620),(1500,1660),(1480,1680),(1510,1650)]:\n    p=fitname('G',lo,hi)\n    print(f'  {lo}-{hi}: amp={p[0]:.1f} x0={p[1]:.2f} g={p[2]:.2f} off={p[3]:.1f}')\nprint('2D windows:')\nfor lo,hi in [(2600,2780),(2560,2820),(2580,2800),(2620,2760),(2540,2840)]:\n    p=fitname('2D',lo,hi)\n    print(f'  {lo}-{hi}: amp={p[0]:.1f} x0={p[1]:.2f} g={p[2]:.2f} off={p[3]:.1f}')\nPY\npython3 /app/sens.py\n"]
