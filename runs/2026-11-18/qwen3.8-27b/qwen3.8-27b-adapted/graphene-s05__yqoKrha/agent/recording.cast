[617.421698, "o", "\u001b[?2004h> "]
[617.421743, "o", "        if ydata[i] <= half: ri=i; break\r\n\u001b[?2004l\r"]
[617.421765, "o", "\u001b[?2004h> "]
[617.421799, "o", "    g0 = 20.0\r\n\u001b[?2004l\r"]
[617.421823, "o", "\u001b[?2004h> "]
[617.421906, "o", "    if li is not None and ri is not None and ri>li:\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.421975, "o", "> "]
[617.422016, "o", "        g0 = max(1.0, (xdata[ri]-xdata[li])/2.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.422058, "o", "    p=[A0, xdata[imax], g0, c0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.422097, "o", ">     def sse_of(pp):\r\n\u001b[?2004l\r"]
[617.422137, "o", "\u001b[?2004h>         s=0.0\r\n\u001b[?2004l\r"]
[617.422163, "o", "\u001b[?2004h> "]
[617.422202, "o", "        for x,y in zip(xdata,ydata):\r\n\u001b[?2004l\r"]
[617.422242, "o", "\u001b[?2004h> "]
[617.422277, "o", "            d=lorentz(x,*pp)-y\r\n\u001b[?2004l\r"]
[617.422298, "o", "\u001b[?2004h> "]
[617.422329, "o", "            s+=d*d\r\n\u001b[?2004l\r"]
[617.422365, "o", "\u001b[?2004h> "]
[617.422403, "o", "        return s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.422441, "o", "    cur=sse_of(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.422487, "o", "    for it in range(500):\r\n\u001b[?2004l\r"]
[617.422506, "o", "\u001b[?2004h> "]
[617.422569, "o", "        Jcols=[[0.0]*n for _ in range(4)]\r\n\u001b[?2004l\r"]
[617.422588, "o", "\u001b[?2004h> "]
[617.422616, "o", "        rvec=[0.0]*n\r\n\u001b[?2004l\r"]
[617.422655, "o", "\u001b[?2004h> "]
[617.42272, "o", "        for i,(x,y) in enumerate(zip(xdata,ydata)):\r\n\u001b[?2004l\r"]
[617.422787, "o", "\u001b[?2004h> "]
[617.422845, "o", "            dxx=x-p[1]\r\n\u001b[?2004l\r\u001b[?2004h>             den=dxx*dxx + p[2]*p[2]\r\n\u001b[?2004l\r"]
[617.422882, "o", "\u001b[?2004h> "]
[617.422913, "o", "            rvec[i]=p[0]*p[2]*p[2]/den + p[3] - y\r\n\u001b[?2004l\r"]
[617.422933, "o", "\u001b[?2004h> "]
[617.422992, "o", "            Jcols[0][i]=p[2]*p[2]/den\r\n\u001b[?2004l\r"]
[617.423022, "o", "\u001b[?2004h> "]
[617.423087, "o", "            Jcols[1][i]=p[0]*2.0*p[2]*p[2]*dxx/(den*den)\r\n\u001b[?2004l\r"]
[617.423109, "o", "\u001b[?2004h"]
[617.423131, "o", "> "]
[617.423185, "o", "            Jcols[2][i]=p[0]*2.0*p[2]*dxx*dxx/(den*den)\r\n\u001b[?2004l\r"]
[617.423207, "o", "\u001b[?2004h> "]
[617.423256, "o", "            Jcols[3][i]=1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.42332, "o", "        JtJ=[[0.0]*4 for _ in range(4)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.423352, "o", "> "]
[617.423382, "o", "        Jtr=[0.0]*4\r\n\u001b[?2004l\r"]
[617.423397, "o", "\u001b[?2004h> "]
[617.423429, "o", "        for i in range(n):\r\n\u001b[?2004l\r"]
[617.423458, "o", "\u001b[?2004h> "]
[617.423487, "o", "            ri=rvec[i]\r\n\u001b[?2004l\r"]
[617.423514, "o", "\u001b[?2004h> "]
[617.423561, "o", "            for a in range(4):\r\n\u001b[?2004l\r"]
[617.423589, "o", "\u001b[?2004h> "]
[617.423651, "o", "                Jtr[a]+=Jcols[a][i]*ri\r\n\u001b[?2004l\r"]
[617.42368, "o", "\u001b[?2004h> "]
[617.423707, "o", "                ja=Jcols[a][i]\r\n\u001b[?2004l\r"]
[617.423734, "o", "\u001b[?2004h> "]
[617.423792, "o", "                for b in range(4):\r\n\u001b[?2004l\r"]
[617.42382, "o", "\u001b[?2004h> "]
[617.423886, "o", "                    JtJ[a][b]+=ja*Jcols[b][i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.423908, "o", "> "]
[617.423939, "o", "        reg=1e-8\r\n\u001b[?2004l\r"]
[617.423971, "o", "\u001b[?2004h> "]
[617.424022, "o", "        for a in range(4): JtJ[a][a]+=reg\r\n\u001b[?2004l\r"]
[617.424053, "o", "\u001b[?2004h> "]
[617.424106, "o", "        M=[JtJ[a][:]+[Jtr[a]] for a in range(4)]\r\n\u001b[?2004l\r"]
[617.424128, "o", "\u001b[?2004h> "]
[617.424168, "o", "        for col in range(4):\r\n\u001b[?2004l\r"]
[617.424191, "o", "\u001b[?2004h> "]
[617.424214, "o", "            piv=col\r\n\u001b[?2004l\r"]
[617.424237, "o", "\u001b[?2004h> "]
[617.424297, "o", "            for row in range(col,4):\r\n\u001b[?2004l\r"]
[617.42432, "o", "\u001b[?2004h> "]
[617.424394, "o", "                if abs(M[row][col])>abs(M[piv][col]): piv=row\r\n\u001b[?2004l\r"]
[617.424417, "o", "\u001b[?2004h> "]
[617.424469, "o", "            M[col],M[piv]=M[piv],M[col]\r\n\u001b[?2004l\r"]
[617.424493, "o", "\u001b[?2004h> "]
[617.424531, "o", "            pv=M[col][col]\r\n\u001b[?2004l\r"]
[617.424553, "o", "\u001b[?2004h> "]
[617.424603, "o", "            if abs(pv)<1e-14: pv=1e-14\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.424639, "o", "> "]
[617.424689, "o", "            for j in range(col,5): M[col][j]/=pv\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.424722, "o", "> "]
[617.42475, "o", "            for row in range(4):\r\n\u001b[?2004l\r"]
[617.424789, "o", "\u001b[?2004h> "]
[617.424833, "o", "                if row!=col:\r\n\u001b[?2004l\r"]
[617.424868, "o", "\u001b[?2004h> "]
[617.424906, "o", "                    fac=M[row][col]\r\n\u001b[?2004l\r"]
[617.424942, "o", "\u001b[?2004h> "]
[617.424969, "o", "                    if fac!=0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.424994, "o", "> "]
[617.425081, "o", "                        for j in range(col,5): M[row][j]-=fac*M[col][j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.425112, "o", "> "]
[617.425157, "o", "        step=[M[i][4] for i in range(4)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.425174, "o", "> "]
[617.425212, "o", "        accepted=False\r\n\u001b[?2004l\r"]
[617.425238, "o", "\u001b[?2004h> "]
[617.425253, "o", "        alpha=1.0\r\n\u001b[?2004l\r"]
[617.425296, "o", "\u001b[?2004h> "]
[617.425323, "o", "        for _ in range(40):\r\n\u001b[?2004l\r"]
[617.425363, "o", "\u001b[?2004h> "]
[617.425439, "o", "            newp=[p[i]+alpha*step[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[617.42547, "o", "\u001b[?2004h> "]
[617.425506, "o", "            if newp[2] > 1e-3:\r\n\u001b[?2004l\r"]
[617.42555, "o", "\u001b[?2004h> "]
[617.42559, "o", "                ns=sse_of(newp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.425642, "o", "                if ns < cur - 1e-10:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.425722, "o", "                    p=newp; cur=ns; accepted=True\r\n\u001b[?2004l\r"]
[617.42576, "o", "\u001b[?2004h> "]
[617.425787, "o", "                    break\r\n\u001b[?2004l\r"]
[617.425816, "o", "\u001b[?2004h> "]
[617.425845, "o", "            alpha*=0.5\r\n\u001b[?2004l\r"]
[617.425874, "o", "\u001b[?2004h> "]
[617.425899, "o", "        if not accepted:\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.425929, "o", "> "]
[617.42596, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.426095, "o", "        if abs(step[0])<1e-5 and abs(step[1])<1e-7 and abs(step[2])<1e-7 and abs(step[3])<1e-5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.426123, "o", "> "]
[617.426147, "o", "            break\r\n\u001b[?2004l\r"]
[617.426179, "o", "\u001b[?2004h> "]
[617.426219, "o", "    p[0]=abs(p[0]); p[2]=abs(p[2])\r\n\u001b[?2004l\r"]
[617.426256, "o", "\u001b[?2004h> "]
[617.426283, "o", "    rms=math.sqrt(cur/n)\r\n\u001b[?2004l\r"]
[617.426313, "o", "\u001b[?2004h> "]
[617.426437, "o", "    print(f'{name}: n={n} x0={p[1]:.4f} gamma={p[2]:.4f} amp={p[0]:.4f} off={p[3]:.4f} rms={rms:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.42647, "o", "> "]
[617.426553, "o", "    return {'x0':p[1],'gamma':p[2],'amplitude':p[0],'offset':p[3]}\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.426589, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.426626, "o", "D=fit_peak('D',1350,80)\r\n\u001b[?2004l\r"]
[617.426656, "o", "\u001b[?2004h> "]
[617.426683, "o", "G=fit_peak('G',1580,80)\r\n\u001b[?2004l\r"]
[617.426713, "o", "\u001b[?2004h> "]
[617.426754, "o", "TD=fit_peak('2D',2690,100)\r\n\u001b[?2004l\r"]
[617.426781, "o", "\u001b[?2004h> "]
[617.426866, "o", "result={'D':D,'G':G,'2D':TD,'ID_IG':D['amplitude']/G['amplitude']}\r\n\u001b[?2004l\r\u001b[?2004h"]
[617.42691, "o", "> "]
[617.426955, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.427006, "o", "    json.dump(result,f,indent=2)\r\n\u001b[?2004l\r"]
[617.427041, "o", "\u001b[?2004h> "]
[617.42708, "o", "print('ID_IG =', result['ID_IG'])\r\n\u001b[?2004l\r"]
[617.427116, "o", "\u001b[?2004h> "]
[617.427162, "o", "print(json.dumps(result,indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.427202, "o", "PY\r\n\u001b[?2004l\r"]
