[143.491715, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\n# print sampled values around relevant regions\nfor a,b in [(1250,1450),(1480,1680),(2590,2790)]:\n    print('range', a,b)\n    for i in range(0, len(xs), 40):\n        x=xs[i]; y=ys[i]\n        if a <= x <= b: print(f'  {x:.1f} {y:.2f}')\nPY\n"]
