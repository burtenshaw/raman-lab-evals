[555.925776, "o", "\u001b[?2004h> "]
[555.925791, "o", "        for i in range(n):\r\n\u001b[?2004l\r"]
[555.925829, "o", "\u001b[?2004h> "]
[555.925863, "o", "            ri=rvec[i]\r\n\u001b[?2004l\r"]
[555.925894, "o", "\u001b[?2004h> "]
[555.925901, "o", "            for a in range(4):\r\n\u001b[?2004l\r"]
[555.925939, "o", "\u001b[?2004h> "]
[555.925988, "o", "                Jtr[a]+=Jcols[a][i]*ri\r\n\u001b[?2004l\r"]
[555.926015, "o", "\u001b[?2004h> "]
[555.926055, "o", "                for b in range(4):\r\n\u001b[?2004l\r"]
[555.926099, "o", "\u001b[?2004h> "]
[555.926147, "o", "                    JtJ[a][b]+=Jcols[a][i]*Jcols[b][i]\r\n\u001b[?2004l\r"]
[555.926184, "o", "\u001b[?2004h> "]
[555.926245, "o", "        # solve using Gauss-Jordan with regularization\r\n\u001b[?2004l\r"]
[555.92629, "o", "\u001b[?2004h> "]
[555.926334, "o", "        reg=1e-9\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.926361, "o", "        for a in range(4):\r\n\u001b[?2004l\r"]
[555.926396, "o", "\u001b[?2004h> "]
[555.926421, "o", "            JtJ[a][a]+=reg\r\n\u001b[?2004l\r"]
[555.926455, "o", "\u001b[?2004h> "]
[555.926465, "o", "        # augment\r\n\u001b[?2004l\r"]
[555.926493, "o", "\u001b[?2004h> "]
[555.926551, "o", "        M=[JtJ[a][:]+[Jtr[a]] for a in range(4)]\r\n\u001b[?2004l\r"]
[555.926585, "o", "\u001b[?2004h> "]
[555.926625, "o", "        for col in range(4):\r\n\u001b[?2004l\r"]
[555.926651, "o", "\u001b[?2004h> "]
[555.926687, "o", "            piv=col\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.926715, "o", "> "]
[555.926744, "o", "            for row in range(col,4):\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.926781, "o", "> "]
[555.926826, "o", "                if abs(M[row][col]) > abs(M[piv][col]): piv=row\r\n\u001b[?2004l\r"]
[555.926867, "o", "\u001b[?2004h> "]
[555.926906, "o", "            M[col],M[piv]=M[piv],M[col]\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.926923, "o", "> "]
[555.926965, "o", "            pv=M[col][col]\r\n\u001b[?2004l\r"]
[555.92701, "o", "\u001b[?2004h> "]
[555.927054, "o", "            if abs(pv)<1e-12:\r\n\u001b[?2004l\r"]
[555.927092, "o", "\u001b[?2004h> "]
[555.92712, "o", "                M[col][col]=1e-12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.927161, "o", "            for j in range(col,5):\r\n\u001b[?2004l\r"]
[555.927199, "o", "\u001b[?2004h> "]
[555.927237, "o", "                M[col][j]/=M[col][col]\r\n\u001b[?2004l\r"]
[555.927246, "o", "\u001b[?2004h"]
[555.927276, "o", "> "]
[555.92732, "o", "            for row in range(4):\r\n\u001b[?2004l\r"]
[555.927341, "o", "\u001b[?2004h> "]
[555.927396, "o", "                if row!=col:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.927439, "o", "                    factor=M[row][col]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.927496, "o", "                    for j in range(col,5):\r\n\u001b[?2004l\r"]
[555.927526, "o", "\u001b[?2004h> "]
[555.927583, "o", "                        M[row][j]-=factor*M[col][j]\r\n\u001b[?2004l\r"]
[555.927621, "o", "\u001b[?2004h> "]
[555.927659, "o", "        step=[M[i][4] for i in range(4)]\r\n\u001b[?2004l\r"]
[555.927687, "o", "\u001b[?2004h> "]
[555.927725, "o", "        # line search\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.927751, "o", "> "]
[555.927793, "o", "        best=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.927845, "o", "        cur_sse=sum(r*r for r in rvec)\r\n\u001b[?2004l\r"]
[555.927871, "o", "\u001b[?2004h> "]
[555.927904, "o", "        alpha=1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.927929, "o", "> "]
[555.927963, "o", "        for _ in range(30):\r\n\u001b[?2004l\r"]
[555.928007, "o", "\u001b[?2004h> "]
[555.928055, "o", "            newp=[p[i]+alpha*step[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[555.928082, "o", "\u001b[?2004h> "]
[555.928165, "o", "            sse=sum((lorentz(x,*newp)-y)**2 for x,y in zip(xdata,ydata))\r\n\u001b[?2004l\r"]
[555.928212, "o", "\u001b[?2004h> "]
[555.928255, "o", "            if sse < cur_sse*(1-1e-12):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.928309, "o", "                best=(sse,newp)\r\n\u001b[?2004l\r"]
[555.928358, "o", "\u001b[?2004h> "]
[555.928409, "o", "                p=newp\r\n\u001b[?2004l\r"]
[555.928455, "o", "\u001b[?2004h>                 break"]
[555.928501, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.928526, "o", "            alpha*=0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.928585, "o", "        else:\r\n\u001b[?2004l\r"]
[555.928614, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.928671, "o", "        # enforce positivity of amplitude/gamma maybe\r\n\u001b[?2004l\r"]
[555.928698, "o", "\u001b[?2004h> "]
[555.928741, "o", "        if p[0] < 0: p[0]=abs(p[0])\r\n\u001b[?2004l\r"]
[555.928777, "o", "\u001b[?2004h> "]
[555.928812, "o", "        if p[2] < 0: p[2]=abs(p[2])\r\n\u001b[?2004l\r"]
[555.928838, "o", "\u001b[?2004h"]
[555.928873, "o", "> "]
[555.928947, "o", "        if abs(step[0])<1e-6 and abs(step[1])<1e-8 and abs(step[2])<1e-8 and abs(step[3])<1e-6:\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.928988, "o", "> "]
[555.929022, "o", "            break\r\n\u001b[?2004l\r"]
[555.929032, "o", "\u001b[?2004h> "]
[555.929059, "o", "    # final parameters\r\n\u001b[?2004l\r"]
[555.929106, "o", "\u001b[?2004h> "]
[555.929154, "o", "    sse=sum((lorentz(x,*p)-y)**2 for x,y in zip(xdata,ydata))\r\n\u001b[?2004l\r"]
[555.929192, "o", "\u001b[?2004h> "]
[555.929237, "o", "    rms=math.sqrt(sse/n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.929341, "o", "    print(f'{name}: n={n} x0={p[1]:.4f} g={p[2]:.4f} A={p[0]:.4f} c={p[3]:.4f} rms={rms:.4f}')\r\n\u001b[?2004l\r"]
[555.92935, "o", "\u001b[?2004h"]
[555.929382, "o", "> "]
[555.929446, "o", "    return {'x0':p[1],'gamma':p[2],'amplitude':p[0],'offset':p[3]}\r\n\u001b[?2004l\r"]
[555.929492, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[555.929518, "o", "> "]
[555.929554, "o", "D=fit_peak('D',1350,80)\r\n\u001b[?2004l\r"]
[555.929581, "o", "\u001b[?2004h> "]
[555.929618, "o", "G=fit_peak('G',1580,80)\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.929643, "o", "> "]
[555.929677, "o", "TD=fit_peak('2D',2690,100)\r\n\u001b[?2004l\r"]
[555.929704, "o", "\u001b[?2004h> "]
[555.929779, "o", "result={'D':D,'G':G,'2D':TD,'ID_IG':D['amplitude']/G['amplitude']}\r\n\u001b[?2004l\r"]
[555.929824, "o", "\u001b[?2004h> "]
[555.929865, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.929916, "o", "    json.dump(result,f,indent=2)\r\n\u001b[?2004l\r"]
[555.929961, "o", "\u001b[?2004h> "]
[555.930008, "o", "print(json.dumps(result,indent=2))\r\n\u001b[?2004l\r"]
[555.930047, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[555.931381, "o", "\u001b[?2004hroot@j-openenv-6afd8a8a29e8b7ccfbbb81cf-9ez390n1-a2946-jwrtt:/app# "]
[556.019408, "i", "python3 /app/fit.py\n"]
[556.019564, "o", "python3 /app/fit.py\r\n\u001b[?2004l\r"]
[556.039282, "o", "  File \u001b[35m\"/app/fit.py\"\u001b[0m, line \u001b[35m52\u001b[0m\r\n    f=A_est\u001b[1;31m?\u001b[0m 0:0\r\n           \u001b[1;31m^\u001b[0m\r\n\u001b[1;35mSyntaxError\u001b[0m: \u001b[35minvalid syntax\u001b[0m\r\n"]
[556.042494, "o", "\u001b[?2004h"]
[556.04251, "o", "root@j-openenv-6afd8a8a29e8b7ccfbbb81cf-9ez390n1-a2946-jwrtt:/app# "]
[617.41939, "i", "cat > /app/fit.py <<'PY'\nimport csv, json, math, statistics\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\n\ndef lorentz(x, A, x0, g, c):\n    return A * g*g / ((x - x0)**2 + g*g) + c\n\ndef fit_peak(name, cx, half_width):\n    sel=sorted((x,y) for x,y in zip(xs,ys) if abs(x-cx) <= half_width)\n    xdata=[x for x,y in sel]; ydata=[y for x,y in sel]\n    n=len(sel)\n    imax=max(range(n), key=lambda i:ydata[i])\n    # baseline from edges\n    edge = ydata[:15] + ydata[-15:]\n    c0 = statistics.median(edge)\n    A0 = max(1.0, ydata[imax] - c0)\n    half = c0 + A0/2.0\n    li=ri=None\n    for i in range(imax,-1,-1):\n        if ydata[i] <= half: li=i; break\n    for i in range(imax,n):\n        if ydata[i] <= half: ri=i; break\n    g0 = 20.0\n    if li is not None and ri is not None and ri>li:\n        g0 = max(1.0, (xdata[ri]-xdata[li])/2.0)\n    p=[A0, xdata[imax], g0, c0]\n"]
[617.419521, "i", "    def sse_of(pp):\n        s=0.0\n        for x,y in zip(xdata,ydata):\n            d=lorentz(x,*pp)-y\n            s+=d*d\n        return s\n    cur=sse_of(p)\n    for it in range(500):\n        Jcols=[[0.0]*n for _ in range(4)]\n        rvec=[0.0]*n\n        for i,(x,y) in enumerate(zip(xdata,ydata)):\n            dxx=x-p[1]\n            den=dxx*dxx + p[2]*p[2]\n            rvec[i]=p[0]*p[2]*p[2]/den + p[3] - y\n            Jcols[0][i]=p[2]*p[2]/den\n            Jcols[1][i]=p[0]*2.0*p[2]*p[2]*dxx/(den*den)\n            Jcols[2][i]=p[0]*2.0*p[2]*dxx*dxx/(den*den)\n            Jcols[3][i]=1.0\n        JtJ=[[0.0]*4 for _ in range(4)]\n        Jtr=[0.0]*4\n        for i in range(n):\n            ri=rvec[i]\n            for a in range(4):\n                Jtr[a]+=Jcols[a][i]*ri\n                ja=Jcols[a][i]\n                for b in range(4):\n                    JtJ[a][b]+=ja*Jcols[b][i]\n        reg=1e-8\n        for a in range(4): JtJ[a][a]+=reg\n        M=[JtJ[a][:]+[Jtr[a]] for a in range(4)]\n        for col in range(4):\n          "]
[617.419631, "o", "cat > /app/fit.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[617.419705, "i", "  piv=col\n            for row in range(col,4):\n                if abs(M[row][col])>abs(M[piv][col]): piv=row\n            M[col],M[piv]=M[piv],M[col]\n            pv=M[col][col]\n            if abs(pv)<1e-14: pv=1e-14\n            for j in range(col,5): M[col][j]/=pv\n            for row in range(4):\n                if row!=col:\n                    fac=M[row][col]\n                    if fac!=0:\n                        for j in range(col,5): M[row][j]-=fac*M[col][j]\n        step=[M[i][4] for i in range(4)]\n        accepted=False\n        alpha=1.0\n        for _ in range(40):\n            newp=[p[i]+alpha*step[i] for i in range(4)]\n            if newp[2] > 1e-3:\n                ns=sse_of(newp)\n                if ns < cur - 1e-10:\n                    p=newp; cur=ns; accepted=True\n                    break\n            alpha*=0.5\n        if not accepted:\n            break\n        if abs(step[0])<1e-5 and abs(step[1])<1e-7 and abs(step[2])<1e-7 and abs(step[3])<1e-5:\n            break\n    p[0]=abs(p[0]); p[2]=abs(p[2])\n  "]
[617.41978, "o", "import csv, json, math, statistics\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> xs=[]; ys=[]\r\n\u001b[?2004l\r"]
[617.419795, "i", "  rms=math.sqrt(cur/n)\n    print(f'{name}: n={n} x0={p[1]:.4f} gamma={p[2]:.4f} amp={p[0]:.4f} off={p[3]:.4f} rms={rms:.4f}')\n    return {'x0':p[1],'gamma':p[2],'amplitude':p[0],'offset':p[3]}\n\nD=fit_peak('D',1350,80)\nG=fit_peak('G',1580,80)\nTD=fit_peak('2D',2690,100)\nresult={'D':D,'G':G,'2D':TD,'ID_IG':D['amplitude']/G['amplitude']}\nwith open('/app/results.json','w') as f:\n    json.dump(result,f,indent=2)\nprint('ID_IG =', result['ID_IG'])\nprint(json.dumps(result,indent=2))\nPY\n"]
[617.419874, "o", "  piv=col\r\n            for row in range(col,4):\r\n                if abs(M[row][col])>abs(M[piv][col]): piv=row\r\n            M[col],M[piv]=M[piv],M[col]\r\n            pv=M[col][col]\r\n            if abs(pv)<1e-14: pv=1e-14\r\n            for j in range(col,5): M[col][j]/=pv\r\n            for row in range(4):\r\n                if row!=col:\r\n                    fac=M[row][col]\r\n        "]
[617.419915, "o", "            if fac!=0:\r\n                        for j in range(col,5): M[row][j]-=fac*M[col][j]\r\n        step=[M[i][4] for i in range(4)]\r\n        accepted=False\r\n        alpha=1.0\r\n        for _ in range(40):\r\n            newp=[p[i]+alpha*step[i] for i in range(4)]\r\n            if newp[2] > 1e-3:\r\n                ns=sse_of(newp)\r\n                if ns < cur - 1e-1"]
[617.419994, "o", "0:\r\n                    p=newp; cur=ns; accepted=True\r\n                    break\r\n            alpha*=0.5\r\n        if not accepted:\r\n            break\r\n        if abs(step[0])<1e-5 and abs(step[1])<1e-7 and abs(step[2])<1e-7 and abs(step[3])<1e-5:\r\n            break\r\n    p[0]=abs(p[0]); p[2]=abs(p[2])\r\n    rms=math.sqrt(cur/n)\r\n    print(f'{name}: n={n} x0={p[1]:.4f} gamma={p[2]:.4f} amp={p[0]:.4f} off={p[3]:.4f} rms={rms:.4f}')\r\n    return {'x0':p[1],'gamma':p[2],'amplitude':p[0],'offset':p[3]"]
[617.420041, "o", "}\r\n\r\nD=fit_peak('D',1350,80)\r\nG=fit_peak('G',1580,80)\r\nTD=fit_peak('2D',2690,100)\r\nresult={'D':D,'G':G,'2D':TD,'ID_IG':D['amplitude']/G['amplitude']}\r\nwith"]
[617.42012, "o", " open('/app/results.json','w') as f:\r\n    json.dump(result,f,indent=2)\r\nprint('ID_IG =', result['ID_IG'])\r\nprint(json.dumps(result,indent=2))\r\nPY\r\n\u001b[?2004h"]
