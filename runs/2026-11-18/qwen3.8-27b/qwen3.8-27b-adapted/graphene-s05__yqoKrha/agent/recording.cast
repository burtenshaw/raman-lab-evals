[555.920349, "i", "cat > /app/fit.py <<'PY'\nimport csv, json, math\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\n\ndef lorentz(x, A, x0, g, c):\n    return A * g*g / ((x - x0)**2 + g*g) + c\n\ndef fit_peak(name, cx, half_width, min_amp=None):\n    sel=[(x,y) for x,y in zip(xs,ys) if abs(x-cx) <= half_width]\n    sel.sort()\n    xdata=[x for x,y in sel]; ydata=[y for x,y in sel]\n    n=len(sel)\n    # initial guesses\n    imax=max(range(n), key=lambda i:ydata[i])\n    x0=xdata[imax]; A0=ydata[imax] - sum(ydata[:20])/20  # rough\n    # estimate gamma from half maximum above baseline\n    base=sum(ydata[:20])/20\n    A_est=max(1.0, ydata[imax] - base)\n    half=base + A_est/2\n    # left\n    li=None\n    for i in range(imax,-1,-1):\n        if ydata[i] <= half:\n            li=i; break\n    ri=None\n    for i in range(imax,n):\n        if ydata[i] <= half:\n            ri=i; break\n    if li is N"]
[555.920486, "i", "one or ri is None:\n        g0=10.0\n    else:\n        fwhm=xdata[ri]-xdata[li]\n        g0=max(1.0, fwhm/2.0)\n    c0=base\n    # ensure positive A\n    A=max(1.0, A0)\n    g=max(1.0, g0)\n    p=[A,x0,g,c0]\n    # Gauss-Newton\n    for it in range(1000):\n        # residuals and Jacobian\n        J=[]; rvec=[]\n        for x,y in zip(xdata,ydata):\n            dxx=x-p[1]\n            den=dxx*dxx + p[2]*p[2]\n            f=A_est? 0:0\n        # actually compute properly\n        rvec=[]; Jcols=[[0.0]*n for _ in range(4)]\n        for i,(x,y) in enumerate(zip(xdata,ydata)):\n            dxx=x-p[1]\n            den=dxx*dxx + p[2]*p[2]\n            f=p[0]*p[2]*p[2]/den + p[3]\n            rvec.append(f-y)\n            # derivatives: d f / dA = g^2/den\n            Jcols[0][i]=p[2]*p[2]/den\n            # d f / dx0 = A * 2 g^2 dxx / den^2\n            Jcols[1][i]=p[0]*2.0*p[2]*p[2]*dxx/(den*den)\n            # d f / dg = A * (2g*den - g^2*2g)/den^2 = 2 A g (den - g^2)/den^2 = 2 A g (dxx^2)/(den^2)\n            Jcols[2][i]=p[0]*2.0*p[2]*dxx*d"]
