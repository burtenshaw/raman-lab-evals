[320.332586, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\ndef med(vals):\n    if not vals: return None\n    vals=sorted(vals); n=len(vals); return vals[n//2]\nfor a,b in [(1100,1250),(1250,1300),(1410,1480),(1480,1500),(1650,2500),(2500,2600),(2780,2900),(2900,3000)]:\n    vals=[y for x,y in zip(xs,ys) if a<=x<b]\n    if vals:\n        mx=max(vals); mn=min(vals); md=med(vals)\n        # x at max\n        xmx=max((x,y) for x,y in zip(xs,ys) if a<=x<b, key=lambda p:p[1])\n        print(f'{a}-{b}: n={len(vals)} min={mn:.1f} med={md:.1f} max={mx:.1f} at x={xmx[0]:.1f} val={xmx[1]:.1f}')\nPY\n"]
