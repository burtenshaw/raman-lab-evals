[511.906189, "i", "python3 - <<'PY'\nimport csv, statistics\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2 and row[0].strip():\n            xs.append(float(row[0])); ys.append(float(row[1]))\ndef summarize(a,b):\n    sel=[(x,y) for x,y in zip(xs,ys) if a <= x < b]\n    if not sel:\n        print(a,b,'none')\n        return\n    yvals=[y for _,y in sel]\n    xmx,ymx=max(sel, key=lambda p:p[1])\n    print(f'{a}-{b}: n={len(sel)} min={min(yvals):.1f} med={statistics.median(yvals):.1f} max={max(yvals):.1f} at x={xmx:.1f}')\nfor a,b in [(1100,1250),(1250,1300),(1410,1480),(1480,1500),(1650,2200),(2200,2400),(2400,2550),(2800,2900),(2900,3000)]:\n    summarize(a,b)\nPY\n"]
