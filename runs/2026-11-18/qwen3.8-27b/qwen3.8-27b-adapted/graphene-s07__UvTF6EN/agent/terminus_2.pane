[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x_all, y_all = data[:,0], data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {'D': 1350, 'G': 1580, '2D': 2690}
[?2004l[?2004h> win = 150
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     m = (x_all >= center-win) & (x_all <= center+win)
[?2004l[?2004h>     x = x_all[m]; y = y_all[m]
[?2004l[?2004h>     # initial guesses
[?2004l[?2004h>     off0 = np.percentile(y, 10)
[?2004l[?2004h>     idx = np.argmax(y)
[?2004l[?2004h>     amp0 = y[idx] - off0
[?2004l[?2004h>     x00 = x[idx]
[?2004l[?2004h>     gam0 = 20.0
[?2004l[?2004h>     p0 = [amp0, x00, gam0, off0]
[?2004l[?2004h>     popt, pcov = curve_fit(lor, x, y, p0=p0, maxfev=20000)
[?2004l[?2004h>     amp, x0, gam, off = popt
[?2004l[?2004h>     gam = abs(gam)
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h>     print(name, 'x0=%.3f gamma=%.3f amp=%.3f off=%.3f' % (x0, gam, amp, off))
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print('ID_IG =', results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
