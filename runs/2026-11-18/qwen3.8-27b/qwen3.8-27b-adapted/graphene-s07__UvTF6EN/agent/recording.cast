[53.053304, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lor(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx_all, y_all = data[:,0], data[:,1]\n\npeaks = {'D': 1350, 'G': 1580, '2D': 2690}\nwin = 150\n\nresults = {}\nfor name, center in peaks.items():\n    m = (x_all >= center-win) & (x_all <= center+win)\n    x = x_all[m]; y = y_all[m]\n    # initial guesses\n    off0 = np.percentile(y, 10)\n    idx = np.argmax(y)\n    amp0 = y[idx] - off0\n    x00 = x[idx]\n    gam0 = 20.0\n    p0 = [amp0, x00, gam0, off0]\n    popt, pcov = curve_fit(lor, x, y, p0=p0, maxfev=20000)\n    amp, x0, gam, off = popt\n    gam = abs(gam)\n    results[name] = {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(off)}\n    print(name, 'x0=%.3f gamma=%.3f amp=%.3f off=%.3f' % (x0, gam, amp, off))\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results["]
[53.053422, "i", "'G']['amplitude'])\nprint('ID_IG =', results['ID_IG'])\n\nwith open('/app/results.json','w') as f:\n    json.dump(results, f, indent=2)\nprint('written')\nEOF\npython3 /app/fit.py\n"]
[53.053485, "o", "cat > /app/fit.py << 'EOF'\r\n"]
