[24.284096, "i", "python3 << 'EOF'\nimport numpy as np\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm-1']\ny = data['intensity']\n\n# Check intensity around each peak region\nfor center in [1350, 1580, 2690]:\n    mask = (x > center - 200) & (x < center + 200)\n    print(f\"Region {center}: x=[{x[mask].min():.1f}, {x[mask].max():.1f}], y min={y[mask].min():.1f}, y max={y[mask].max():.1f}\")\n\n# Check baseline\nmask = (x > 1100) & (x < 1200)\nprint(f\"Baseline 1100-1200: mean={y[mask].mean():.1f}\")\nmask = (x > 2000) & (x < 2100)\nprint(f\"Baseline 2000-2100: mean={y[mask].mean():.1f}\")\nEOF\n"]
