[127.467624, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1346.399211547531,\r\n    \"gamma\": 16.755108769895962,\r\n    \"amplitude\": 2343.799338951984,\r\n    \"offset\": 1027.297993848808\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1582.192675121207,\r\n    \"gamma\": 8.950557535650944,\r\n    \"amplitude\": 7867.324785222077,\r\n    \"offset\": 1042.5438383329304\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2692.702288257506,\r\n    \"gamma\": 24.156581832948664,\r\n    \"amplitude\": 16035.116121000474,\r\n    \"offset\": 1068.9759346940584\r\n  },\r\n  \"ID_IG\": 0.2979156705662589\r\n}"]
[127.467832, "o", "\u001b[?2004h"]
[127.467875, "o", "root@j-openenv-6afd8a8ae5cad0e4dc3e6b89-q1vcehbg-6e470-9mn8b:/app# "]
[128.008368, "i", "python3 -c \"\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lor(x, a, x0, g, o):\n    return a*g**2/((x-x0)**2+g**2)+o\n\nraw = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = raw[:,0], raw[:,1]\n\nimport json\nres = json.load(open('/app/results.json'))\n\nfor name in ['D','G','2D']:\n    r = res[name]\n    a, x0, g, o = r['amplitude'], r['x0'], r['gamma'], r['offset']\n    if name=='D': lo, hi = 1200, 1500\n    elif name=='G': lo, hi = 1430, 1730\n    else: lo, hi = 2540, 2840\n    m = (x>=lo)&(x<=hi)\n    ypred = lor(x[m], a, x0, g, o)\n    rmse = np.sqrt(np.mean((y[m]-ypred)**2))\n    snr = r['amplitude']/np.std(y[m]-np.median(y[m]))\n    print(f'{name}: RMSE={rmse:.1f}, residual_std~{rmse:.1f}')\n\"\n"]
[128.008517, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h"]
