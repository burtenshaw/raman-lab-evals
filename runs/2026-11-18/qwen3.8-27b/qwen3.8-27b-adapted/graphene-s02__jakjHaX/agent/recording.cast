[36.89319, "o", "Successfully installed numpy-2.5.5 scipy-1.18.1\r\nWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\r\n\r\n[notice] A new release of pip is available: 26.2.2 -> 26.3\r\n[notice] To update, run: pip install --upgrade pip\r\n"]
[36.893407, "o", "\u001b[?2004hroot@j-openenv-6afd8a8ae5cad0e4dc3e6b89-q1vcehbg-6e470-9mn8b:/app# "]
[80.330356, "i", "cat << 'PYEOF' > /app/fit_peaks.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm-1']\ny = data['intensity']\n\n# Define peak regions: (name, center, half_width)\npeaks = {\n    'D':  (1350, 150),\n    'G':  (1580, 150),\n    '2D': (2690, 150),\n}\n\nresults = {}\n\nfor name, (center, hw) in peaks.items():\n    mask = (x >= center - hw) & (x <= center + hw)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses\n    x0_0 = center\n    amp_0 = y_fit.max() - np.median(y_fit)\n    gamma_0 = 30  # typical half-width\n    offset_0 = np.median(y_fit)\n    \n    p0 = [amp_0, x0_0, gamma_0, offset_0]\n    \n    try:\n        popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=100000)\n        amp, x0, gamma, offset = popt\n        print(f\"{name}: amp={amp:.4f}, x0={x0:.4f}, ga"]
[80.330488, "i", "mma={gamma:.4f}, offset={offset:.4f}\")\n    except Exception as e:\n        print(f\"Fitting {name} failed: {e}\")\n        raise\n    \n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(abs(gamma)),  # gamma is a width, should be positive\n        'amplitude': float(amp),\n        'offset': float(offset),\n    }\n\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nresults['ID_IG'] = float(id_ig)\nprint(f\"ID/IG = {id_ig:.6f}\")\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Results written to /app/results.json\")\nPYEOF\n"]
