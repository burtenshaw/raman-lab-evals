[106.711436, "i", "cat << 'PYEOF' > /app/fit_peaks.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# Load data (skip header)\nraw = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = raw[:, 0]\ny = raw[:, 1]\n\nprint(f\"Data range: x=[{x.min():.1f}, {x.max():.1f}], N={len(x)}\")\n\n# Define peak regions: (name, center, half_width)\npeaks = {\n    'D':  (1350, 150),\n    'G':  (1580, 150),\n    '2D': (2690, 150),\n}\n\nresults = {}\n\nfor name, (center, hw) in peaks.items():\n    mask = (x >= center - hw) & (x <= center + hw)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses\n    x0_0 = center\n    amp_0 = y_fit.max() - np.median(y_fit)\n    gamma_0 = 30\n    offset_0 = np.median(y_fit)\n    \n    p0 = [amp_0, x0_0, gamma_0, offset_0]\n    \n    popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=100000)\n    amp, x0, gamma, offset = popt\n    gamma = abs(gamma)\n    print"]
[106.711571, "i", "(f\"{name}: amp={amp:.4f}, x0={x0:.4f}, gamma={gamma:.4f}, offset={offset:.4f}\")\n    \n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset),\n    }\n\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nresults['ID_IG'] = float(id_ig)\nprint(f\"\\nID/IG = {id_ig:.6f}\")\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"Results written to /app/results.json\")\nPYEOF\n"]
[106.711624, "o", "cat << 'PYEOF' > /app/fit_peaks.py\r\n\u001b[?2004l\r(f\"{name}: amp={amp:.4f}, x0={x0:.4f}, gamma={gamma:.4f}, offset={offset:.4f}\")\r\n    \r\n    results[name] = {\r\n        'x0': float(x0),\r\n        'gamma': float(gamma),\r\n        'amplitude': float(amp),\r\n        'offset': float(offset),\r\n    }\r\n\r\nid"]
