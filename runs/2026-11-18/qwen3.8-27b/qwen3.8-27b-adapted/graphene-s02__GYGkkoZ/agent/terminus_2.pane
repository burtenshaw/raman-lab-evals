[?2004hroot@j-openenv-6afd8e56e5cad0e4dc3e6e59-cb6xh67y-c2df9-w48q9:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amp, x0, gamma, offset):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D':  (1280, 1420, 1346, 15, 2300, 1100),
[?2004l[?2004h>     'G':  (1500, 1660, 1582, 12, 7900, 1077),
[?2004l[?2004h>     '2D': (2580, 2800, 2693, 18, 15900, 1200),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi, x0g, gg, ag, og) in peaks.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     p0 = [ag, x0g, gg, og]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xs, ys, p0=p0,
[?2004l[?2004h>                            bounds=([0, lo, 0.1, -np.inf],
[?2004l[?2004h>                                    [np.inf, hi, 200, np.inf]),
[?2004l[?2004h>                            maxfev=100000)
[?2004l[?2004h>     amp, x0, gamma, offset = popt
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(gamma),
[?2004l[?2004h>                      'amplitude': float(amp), 'offset': float(offset)}
[?2004l[?2004h>     print(f'{name}: x0={x0:.3f} gamma={gamma:.3f} amp={amp:.3f} offset={offset:.3f}')
[?2004l[?2004h> 
[?2004l[?2004h> id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> print('ID/IG =', id_ig)
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(id_ig)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print('written to /app/results.json')
[?2004l[?2004h> EOF
