[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = data[:,0], data[:,1]
[?2004l[?2004h> r = json.load(open('/app/results.json'))
[?2004l[?2004h> def lor(x,a,x0,g,o): return a*g**2/((x-x0)**2+g**2)+o
[?2004l[?2004h> for name,lo,hi in [('D',1280,1420),('G',1500,1660),('2D',2580,2800)]:
