[64.115744, "i", "python3 -c \"\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm-1']\ny = data['intensity']\nprint('x range:', x.min(), x.max(), 'n points:', len(x))\nfor label, center in [('D',1350),('G',1580),('2D',2690)]:\n    mask = (x > center-60) & (x < center+60)\n    if mask.any():\n        print(label, 'peak region max y:', y[mask].max(), 'at x=', x[mask][np.argmax(y[mask])], 'min y:', y[mask].min())\n# baseline estimate\nmask_base = (x > 1800) & (x < 2400)\nprint('baseline region (1800-2400) mean y:', y[mask_base].mean())\n\"\n"]
