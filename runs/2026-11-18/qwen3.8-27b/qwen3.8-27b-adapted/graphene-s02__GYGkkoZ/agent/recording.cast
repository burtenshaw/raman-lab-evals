[260.26814, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\npeaks = {\n    'D':  (1280, 1420, 1346, 15, 2300, 1100),\n    'G':  (1500, 1660, 1582, 12, 7900, 1077),\n    '2D': (2580, 2800, 2693, 18, 15900, 1200),\n}\n\nresults = {}\nfor name, (lo, hi, x0g, gg, ag, og) in peaks.items():\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    p0 = [ag, x0g, gg, og]\n    popt, pcov = curve_fit(lorentz, xs, ys, p0=p0,\n                           bounds=([0, lo, 0.1, -np.inf],\n                                   [np.inf, hi, 200, np.inf]),\n                           maxfev=100000)\n    amp, x0, gamma, offset = popt\n    results[name] = {'x0': float(x0), 'gamma': float(gamma),\n                     'amplitude': float(amp), 'offset': float(offset)}\n    print(f'{name}: x0={x0:.3f} gamma={gam"]
[260.268258, "i", "ma:.3f} amp={amp:.3f} offset={offset:.3f}')\n\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID/IG =', id_ig)\n\nresults['ID_IG'] = float(id_ig)\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('written to /app/results.json')\nEOF\npython3 /app/fit.py\n"]
