[157.131936, "i", "python3 -c \"\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]\ny = data[:,1]\n# wider view around 2D\nfor c in [2450,2550,2600,2650,2675,2690,2700,2725,2750,2800,2900,2940,3000]:\n    i = np.argmin(np.abs(x-c))\n    print(round(x[i],1), round(y[i],1))\n\"\n"]
