[88.531922, "i", "python3 -c \"\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]\ny = data[:,1]\nprint('x range:', x.min(), x.max(), 'n points:', len(x))\nfor label, center in [('D',1350),('G',1580),('2D',2690)]:\n    mask = (x > center-60) & (x < center+60)\n    if mask.any():\n        imax = np.argmax(y[mask])\n        print(label, 'max y:', round(y[mask][imax],1), 'at x=', round(x[mask][imax],1), 'min y:', round(y[mask].min(),1))\nmask_base = (x > 1800) & (x < 2400)\nprint('baseline region (1800-2400) mean y:', round(y[mask_base].mean(),1))\nmask_base2 = (x > 2900) & (x < 3300)\nprint('baseline region (2900-3300) mean y:', round(y[mask_base2].mean(),1))\n\"\n"]
