[294.730881, "o", "cat /app/results.json\r\n\u001b[?2004l\r"]
[294.731784, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1346.3855386160699,\r\n    \"gamma\": 16.994868184550036,\r\n    \"amplitude\": 2349.4810046443577,\r\n    \"offset\": 1014.728995865465\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1582.1929689804044,\r\n    \"gamma\": 8.990076085967754,\r\n    \"amplitude\": 7870.895793490421,\r\n    \"offset\": 1031.1961811285698\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2692.70134043114,\r\n    \"gamma\": 24.155216345430027,\r\n    \"amplitude\": 16034.92313293407,\r\n    \"offset\": 1069.3479744157444\r\n  },\r\n  \"ID_IG\": 0.2985023644433817\r\n}"]
[294.73195, "o", "\u001b[?2004hroot@j-openenv-6afd8e56e5cad0e4dc3e6e59-cb6xh67y-c2df9-w48q9:/app# "]
[294.827927, "i", "python3 -c \"\nimport numpy as np, json\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\nr = json.load(open('/app/results.json'))\ndef lor(x,a,x0,g,o): return a*g**2/((x-x0)**2+g**2)+o\nfor name,lo,hi in [('D',1280,1420),('G',1500,1660),('2D',2580,2800)]:\n    p = r[name]\n    m = (x>=lo)&(x<=hi)\n    res = y[m]-lor(x[m],p['amplitude'],p['x0'],p['gamma'],p['offset'])\n    print(name,'RMS resid=',round(np.sqrt(np.mean(res**2)),2),'rel std=',round(np.std(res)/y[m].std(),3))\n\"\n"]
[294.828042, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
[294.828057, "o", "\u001b[?2004h> "]
[294.828141, "o", "import numpy as np, json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.828265, "o", "data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\r\n\u001b[?2004l\r"]
[294.828304, "o", "\u001b[?2004h> "]
[294.82833, "o", "x, y = data[:,0], data[:,1]\r\n\u001b[?2004l\r"]
[294.828373, "o", "\u001b[?2004h> "]
[294.828392, "o", "r = json.load(open('/app/results.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.828467, "o", "def lor(x,a,x0,g,o): return a*g**2/((x-x0)**2+g**2)+o\r\n\u001b[?2004l\r"]
[294.828478, "o", "\u001b[?2004h> "]
[294.828562, "o", "for name,lo,hi in [('D',1280,1420),('G',1500,1660),('2D',2580,2800)]:\r\n\u001b[?2004l\r"]
[294.828572, "o", "\u001b[?2004h> "]
[294.828606, "o", "    p = r[name]\r\n\u001b[?2004l\r"]
[294.82864, "o", "\u001b[?2004h> "]
[294.828664, "o", "    m = (x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[294.828699, "o", "\u001b[?2004h> "]
[294.828751, "o", "    res = y[m]-lor(x[m],p['amplitude'],p['x0'],p['gamma'],p['offset'])\r\n\u001b[?2004l\r"]
[294.828781, "o", "\u001b[?2004h> "]
[294.828895, "o", "    print(name,'RMS resid=',round(np.sqrt(np.mean(res**2)),2),'rel std=',round(np.std(res)/y[m].std(),3))\r\n\u001b[?2004l\r"]
[294.828904, "o", "\u001b[?2004h"]
[294.828939, "o", "> \"\r\n\u001b[?2004l\r"]
[295.066938, "o", "D RMS resid= 59.13 rel std= 0.086\r\n"]
[295.06707, "o", "G RMS resid= 65.81 rel std= 0.034\r\n"]
[295.067117, "o", "2D RMS resid= 58.34 "]
[295.067166, "o", "rel std= 0.013\r\n"]
[295.078657, "o", "\u001b[?2004hroot@j-openenv-6afd8e56e5cad0e4dc3e6e59-cb6xh67y-c2df9-w48q9:/app# "]
