[69.896462, "i", "python3 - <<'PY'\nimport numpy as np\ndata = np.genfromtxt('spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nfor name, c in [('D',1350),('G',1580),('2D',2690)]:\n    mask = (x > c-120) & (x < c+120)\n    if mask.any():\n        xm = x[mask][np.argmax(y[mask])]\n        print(name, 'local max at', xm, y.max() if mask.any() else None, 'window max', y[mask].max())\n# print rough edges baseline\nfor a,b in [(1100,1200),(1430,1470),(1700,1800),(2500,2560),(2820,2900)]:\n    m=(x>=a)&(x<b)\n    print(a,b, y[m].mean(), y[m].std())\nPY\n"]
