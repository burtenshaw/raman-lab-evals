[109.128174, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata = np.genfromtxt('spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\ndef model(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\nfor name, c in [('D',1350),('G',1580),('2D',2690)]:\n    print('\\n', name)\n    for w in [60,80,100,120,150]:\n        m = (x >= c-w) & (x <= c+w)\n        if m.sum()<10: continue\n        xm=x[m], ym=y[m]\n        offset0=np.percentile(ym,10)\n        amp0=ym.max()-offset0\n        x00=xm[np.argmax(ym)]\n        # gamma estimate half max\n        half=offset0+amp0/2\n        above=xm[ym>half]\n        gamma0=max(5.0, (above.max()-above.min())/2 if len(above)>1 else 20.0)\n        try:\n            popt, pcov = curve_fit(model, xm, ym, p0=[amp0, x00, gamma0, offset0],\n                                   bounds=([0, xm.min(), 1, -np.inf],[np.inf, xm.max(), 200, np.inf]), maxfev=20000)\n            amp,x0,gamma,off=popt\n            rms=np.sqrt(np.mean((model(xm,*p"]
[109.128309, "i", "opt)-ym)**2))\n            print(f'w={w}: amp={amp:.3f} x0={x0:.3f} gamma={gamma:.3f} off={off:.3f} rms={rms:.2f}')\n        except Exception as e:\n            print(f'w={w}: fail {e}')\nPY\n"]
