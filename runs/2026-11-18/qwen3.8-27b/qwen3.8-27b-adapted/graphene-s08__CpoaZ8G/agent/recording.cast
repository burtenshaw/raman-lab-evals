[157.69067, "i", "python3 - <<'PY'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\ndata = np.genfromtxt('spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\ndef model(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\nresults = {}\nfor name, c in [('D',1350),('G',1580),('2D',2690)]:\n    m = (x >= c-100) & (x <= c+100)\n    xm, ym = x[m], y[m]\n    offset0 = np.percentile(ym, 10)\n    amp0 = ym.max() - offset0\n    x00 = xm[np.argmax(ym)]\n    half = offset0 + amp0/2\n    above = xm[ym > half]\n    gamma0 = max(5.0, (above.max()-above.min())/2 if len(above) > 1 else 20.0)\n    popt, pcov = curve_fit(model, xm, ym, p0=[amp0, x00, gamma0, offset0],\n                           bounds=([0, xm.min(), 1, -np.inf], [np.inf, xm.max(), 200, np.inf]), maxfev=20000)\n    amp, x0, gamma, off = popt\n    results[name] = {\"x0\": float(x0), \"gamma\": float(abs(gamma)), \"amplitude\": float(amp), \"offset\": float(off)}\nresults[\"ID_IG\"] = float(results[\"D\"][\"amplitude\"] / results[\"G\"][\"am"]
[157.690816, "i", "plitude\"])\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nPY\n"]
[157.690879, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.690913, "o", "import numpy as np, json\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.690947, "o", "> "]
[157.69105, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.691123, "o", "data = np.genfromtxt('spectrum.csv', delimiter=',', skip_header=1)\r\n\u001b[?2004l\r"]
[157.691159, "o", "\u001b[?2004h> "]
[157.691197, "o", "x, y = data[:,0], data[:,1]\r\n\u001b[?2004l\r"]
[157.691236, "o", "\u001b[?2004h> "]
[157.691285, "o", "def model(x, amp, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[157.691325, "o", "\u001b[?2004h> "]
[157.69144, "o", "    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.691472, "o", "> "]
[157.69151, "o", "results = {}\r\n\u001b[?2004l\r"]
[157.691551, "o", "\u001b[?2004h> "]
[157.691601, "o", "for name, c in [('D',1350),('G',1580),('2D',2690)]:\r\n\u001b[?2004l\r"]
[157.691625, "o", "\u001b[?2004h> "]
[157.69168, "o", "    m = (x >= c-100) & (x <= c+100)\r\n\u001b[?2004l\r"]
[157.691699, "o", "\u001b[?2004h> "]
[157.691741, "o", "    xm, ym = x[m], y[m]\r\n\u001b[?2004l\r"]
[157.691775, "o", "\u001b[?2004h> "]
[157.691823, "o", "    offset0 = np.percentile(ym, 10)\r\n\u001b[?2004l\r"]
[157.691846, "o", "\u001b[?2004h> "]
[157.691894, "o", "    amp0 = ym.max() - offset0\r\n\u001b[?2004l\r"]
[157.69193, "o", "\u001b[?2004h> "]
[157.691966, "o", "    x00 = xm[np.argmax(ym)]\r\n\u001b[?2004l\r"]
[157.691999, "o", "\u001b[?2004h> "]
[157.692047, "o", "    half = offset0 + amp0/2\r\n\u001b[?2004l\r"]
[157.692081, "o", "\u001b[?2004h> "]
[157.692116, "o", "    above = xm[ym > half]\r\n\u001b[?2004l\r"]
[157.692163, "o", "\u001b[?2004h> "]
[157.692245, "o", "    gamma0 = max(5.0, (above.max()-above.min())/2 if len(above) > 1 else 20.0)\r\n\u001b[?2004l\r"]
[157.692279, "o", "\u001b[?2004h> "]
[157.69237, "o", "    popt, pcov = curve_fit(model, xm, ym, p0=[amp0, x00, gamma0, offset0],\r\n\u001b[?2004l\r"]
[157.692406, "o", "\u001b[?2004h> "]
[157.692536, "o", "                           bounds=([0, xm.min(), 1, -np.inf], [np.inf, xm.max(), 200, np.inf]), maxfev=20000)\r\n\u001b[?2004l\r"]
[157.692573, "o", "\u001b[?2004h> "]
[157.692655, "o", "    amp, x0, gamma, off = popt\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.692698, "o", "> "]
[157.692826, "o", "    results[name] = {\"x0\": float(x0), \"gamma\": float(abs(gamma)), \"amplitude\": float(amp), \"offset\": float(off)}\r\n\u001b[?2004l\r"]
[157.692872, "o", "\u001b[?2004h> "]
[157.692969, "o", "results[\"ID_IG\"] = float(results[\"D\"][\"amplitude\"] / results[\"G\"][\"amplitude\"])\r\n\u001b[?2004l\r"]
[157.693, "o", "\u001b[?2004h> "]
[157.693053, "o", "with open('results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[157.693076, "o", "\u001b[?2004h> "]
[157.693138, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[157.693173, "o", "\u001b[?2004h> "]
[157.693222, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r"]
[157.693258, "o", "\u001b[?2004h> "]
[157.693303, "o", "PY\r\n\u001b[?2004l\r"]
