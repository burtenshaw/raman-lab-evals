[?2004l[?2004h>                            bounds=([0, xm.min(), 1, -np.inf], [np.inf, xm.max(), 200, np.inf]), maxfev=20000)
[?2004l[?2004h>     amp, x0, gamma, off = popt
[?2004l[?2004h>     results[name] = {"x0": float(x0), "gamma": float(abs(gamma)), "amplitude": float(amp), "offset": float(off)}
[?2004l[?2004h> results["ID_IG"] = float(results["D"]["amplitude"] / results["G"]["amplitude"])
