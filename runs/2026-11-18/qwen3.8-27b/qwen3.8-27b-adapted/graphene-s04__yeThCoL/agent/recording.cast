[245.170585, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\n\ndef local_stats(name, lo, hi, baseline_lo=None, baseline_hi=None):\n    if baseline_lo is None:\n        baseline_lo=lo-20; baseline_hi=lo\n    if baseline_hi is None:\n        baseline_hi=hi; baseline_lo=hi\n    # actually use separate edge regions outside peak window maybe\n    pass\n\nfor name, center, half in [('D',1346,120),('G',1585,120),('2D',2678,120)]:\n    lo,hi=center-half, center+half\n    idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\n    if not idx: continue\n    i0=idx[0]; imax=max(idx, key=lambda i: ys[i])\n    # baseline from 20 points at each edge of window\n    edge = idx[:20] + idx[-20:]\n    base = sum(ys[i] for i in edge)/len(edge)\n    amp = ys[imax]-base\n    halfmax = base + amp/2\n    # find left and right crossings\n    left=None; right=None\n    for i in range(imax, i0, -1):\n        if ys[i]"]
[245.170731, "i", " < halfmax:\n            # linear interpolate between i and i+1\n            x1,x2=xs[i],xs[i+1]; y1,y2=ys[i],ys[i+1]\n            left = x1 + (halfmax-y1)*(x2-x1)/(y2-y1) if y2!=y1 else x1\n            break\n    for i in range(imax, idx[-1], 1):\n        if ys[i] < halfmax:\n            x1,x2=xs[i-1],xs[i]; y1,y2=ys[i-1],ys[i]\n            right = x1 + (halfmax-y1)*(x2-x1)/(y2-y1) if y2!=y1 else x1\n            break\n    fwhm = right-left if left and right else None\n    print(f'{name}: center window {lo}-{hi}, xmax={xs[imax]:.2f}, ymax={ys[imax]:.1f}, base={base:.1f}, amp={amp:.1f}, left={left and round(left,2)}, right={right and round(right,2)}, fwhm={fwhm and round(fwhm,2)}, gamma_est={fwhm/2 if fwhm else None}')\n    # print values every 10 points around max\n    # for i in range(max(i0,imax-60), min(idx[-1]+1,imax+60), 10):\n    #     print('   ', xs[i], ys[i])\nPY\n"]
