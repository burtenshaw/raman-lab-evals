[425.932463, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1'])); ys.append(float(row['intensity']))\n\ndef lorentzian(x,A,G,X,O):\n    d=x-X; return A*G*G/(d*d+G*G)+O\n\ndef fit_lm(x_data,y_data,p0,window):\n    X0=p0[2]; idx=[i for i,x in enumerate(x_data) if abs(x-X0)<=window]\n    xd=[x_data[i] for i in idx]; yd=[y_data[i] for i in idx]; n=len(xd)\n    p=list(p0); lam=1e-3\n    for it in range(300):\n        model=[lorentzian(x,p[0],p[1],p[2],p[3]) for x in xd]\n        res=[yd[i]-model[i] for i in range(n)]; sse=sum(r*r for r in res)\n        J=[]\n        for x in xd:\n            d=x-p[2]; A,G=p[0],p[1]; den=d*d+G*G; den2=den*den\n            J.append([G*G/den, A*2.0*G*d*d/den2, A*2.0*G*G*d/den2, 1.0])\n        JtJ=[[0.0]*4 for _ in range(4)]; Jtr=[0.0]*4\n        for i in range(n):\n            for a in range(4):\n                Jtr[a]+=J[i][a]*res[i]\n                for b in range(4): JtJ[a][b]+=J[i][a]*J[i][b]\n   "]
[425.932592, "i", "     A_mat=[[JtJ[a][b]+(lam*JtJ[a][a] if a==b else 0.0) for b in range(4)] for a in range(4)]\n        aug=[A_mat[a]+[Jtr[a]] for a in range(4)]\n        singular=False\n        for col in range(4):\n            mr=col\n            for row in range(col+1,4):\n                if abs(aug[row][col])>abs(aug[mr][col]): mr=row\n            aug[col],aug[mr]=aug[mr],aug[col]\n            if abs(aug[col][col])<1e-15: singular=True; break\n            for row in range(col+1,4):\n                f=aug[row][col]/aug[col][col]\n                for j in range(col,5): aug[row][j]-=f*aug[col][j]\n        if singular: break\n        dp=[0.0]*4\n        for i in range(3,-1,-1):\n            s=aug[i][4]\n            for j in range(i+1,4): s-=aug[i][j]*dp[j]\n            dp[i]=s/aug[i][i]\n        pn=[p[i]+dp[i] for i in range(4)]\n        if pn[1]<=0: pn[1]=abs(pn[1])*0.5+1e-3\n        mn=[lorentzian(x,pn[0],pn[1],pn[2],pn[3]) for x in xd]\n        rn=[yd[i]-mn[i] for i in range(n)]; sn=sum(r*r for r in rn)\n        if sn<sss if (sss:=sse) else sn<"]
[425.932609, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[425.932653, "i", " sse:\n            pass\n        if sn< sse:\n            rc=abs(sse-sn)/max(sse,1e-10); p=pn; lam=max(lam*0.1,1e-15)\n            if rc<1e-14: break\n        else:\n            lam*=10.0\n            if lam>1e15: break\n    return p\n\ninits={'D':(11958.0,14.5,1346.06,1490.0),'G':(8449.0,13.6,1585.13,1434.0),'2D':(10534.0,19.5,2678.42,1410.0)}\nfor name in ['D','G','2D']:\n    for w in [80,100,150]:\n        p=fit_lm(xs,ys,inits[name],w)\n        print(name,'win',w,'A=%.2f G=%.3f X=%.3f O=%.2f'%(p[0],p[1],p[2],p[3]))\n    print()\nPY\n"]
