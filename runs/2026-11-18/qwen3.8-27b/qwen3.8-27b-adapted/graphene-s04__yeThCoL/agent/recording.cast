[371.408005, "i", "cat > /app/fit.py << 'PYEOF'\nimport csv, math, json\n\n# Load data\nxs = []\nys = []\nwith open('/app/spectrum.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\n\ndef lorentzian(x, A, G, X, O):\n    d = x - X\n    return A * G * G / (d * d + G * G) + O\n\ndef fit_lm(x_data, y_data, p0, window=100.0):\n    A0, G0, X0, O0 = p0\n    indices = [i for i, x in enumerate(x_data) if abs(x - X0) <= window]\n    xd = [x_data[i] for i in indices]\n    yd = [y_data[i] for i in indices]\n    n = len(xd)\n    p = list(p0)\n    lam = 1e-3\n    for it in range(300):\n        # Compute model and residuals\n        model = [lorentzian(x, p[0], p[1], p[2], p[3]) for x in xd]\n        res = [yd[i] - model[i] for i in range(n)]\n        sse = sum(r*r for r in res)\n        \n        # Compute Jacobian (n x 4)\n        J = []\n        for i, x in enumerate(xd):\n            d = x - p[2]\n            A, G = p[0], p[1]\n            denom = d*d + G*G\n            de"]
[371.408124, "i", "nom2 = denom * denom\n            dA = G*G / denom\n            dG = A * 2.0*G*d*d / denom2\n            dX = A * 2.0*G*G*d / denom2\n            dO = 1.0\n            J.append([dA, dG, dX, dO])\n        \n        # Compute J^T J (4x4) and J^T r (4x1)\n        JtJ = [[0.0]*4 for _ in range(4)]\n        Jtr = [0.0]*4\n        for i in range(n):\n            for a in range(4):\n                Jtr[a] += J[i][a] * res[i]\n                for b in range(4):\n                    JtJ[a][b] += J[i][a] * J[i][b]\n        \n        # Solve (JtJ + lam * diag(JtJ)) dp = Jtr\n        A_mat = [[JtJ[a][b] + (lam * JtJ[a][a] if a == b else 0.0) for b in range(4)] for a in range(4)]\n        aug = [A_mat[a] + [Jtr[a]] for a in range(4)]\n        \n        # Gaussian elimination with partial pivoting\n        singular = False\n        for col in range(4):\n            max_row = col\n            for row in range(col+1, 4):\n                if abs(aug[row][col]) > abs(aug[max_row][col]):\n                    max_row = row\n            aug[col], aug[max_r"]
[371.408181, "o", "cat > /app/fit.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[371.408216, "i", "ow] = aug[max_row], aug[col]\n            if abs(aug[col][col]) < 1e-15:\n                singular = True\n                break\n            for row in range(col+1, 4):\n                factor = aug[row][col] / aug[col][col]\n                for j in range(col, 5):\n                    aug[row][j] -= factor * aug[col][j]\n        \n        if singular:\n            break\n        \n        dp = [0.0]*4\n        for i in range(3, -1, -1):\n            s = aug[i][4]\n            for j in range(i+1, 4):\n                s -= aug[i][j] * dp[j]\n            dp[i] = s / aug[i][i]\n        \n        p_new = [p[i] + dp[i] for i in range(4)]\n        if p_new[1] <= 0:\n            p_new[1] = abs(p_new[1]) * 0.5 + 1e-3\n        \n        model_new = [lorentzian(x, p_new[0], p_new[1], p_new[2], p_new[3]) for x in xd]\n        res_new = [yd[i] - model_new[i] for i in range(n)]\n        sse_new = sum(r*r for r in res_new)\n        \n        if sse_new < sse:\n            rel_change = abs(sse - sse_new) / max(sse, 1e-10)\n            p = p_new\n      "]
[371.408234, "o", "\u001b[?2004h> "]
[371.408278, "i", "      lam *= 0.1\n            if lam < 1e-15:\n                lam = 1e-15\n            if rel_change < 1e-14:\n                break\n        else:\n            lam *= 10.0\n            if lam > 1e15:\n                break\n    \n    return p, sse\n\n# Initial estimates\ninitials = {\n    'D':  (11958.0, 14.5, 1346.06, 1490.0),\n    'G':  (8449.0, 13.6, 1585.13, 1434.0),\n    '2D': (10534.0, 19.5, 2678.42, 1410.0),\n}\n\nresults = {}\nfor name in ['D', 'G', '2D']:\n    p0 = initials[name]\n    p, sse = fit_lm(xs, ys, p0, window=100.0)\n    A, G, X, O = p\n    results[name] = {\n        'x0': X,\n        'gamma': G,\n        'amplitude': A,\n        'offset': O\n    }\n    print(f\"{name}: x0={X:.4f}, gamma={G:.4f}, amplitude={A:.2f}, offset={O:.2f}, sse={sse:.2f}, iters_done\")\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint(f\"ID/IG = {results['ID_IG']:.6f}\")\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(\"Written to /app/results.json\")\nPYEOF\n"]
