[451.402863, "i", "python3 -c \"\nimport json\nwith open('/app/results.json') as f:\n    r = json.load(f)\nassert 'D' in r and 'G' in r and '2D' in r\nfor k in ['D','G','2D']:\n    for field in ['x0','gamma','amplitude','offset']:\n        assert field in r[k], f'Missing {field} in {k}'\n        assert isinstance(r[k][field], float), f'{field} in {k} is not float'\nassert 'ID_IG' in r\nassert isinstance(r['ID_IG'], float)\nprint('All checks passed.')\nprint(json.dumps(r, indent=2))\n\"\n"]
