[141.068447, "i", "python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nprint('n', len(xs), 'x0', xs[0], 'xN', xs[-1])\nimax=max(range(len(ys)), key=lambda i: ys[i])\nprint('overall max', xs[imax], ys[imax])\nfor name,lo,hi in [('D',1250,1450),('G',1480,1680),('2D',2590,2790)]:\n    best=-1; bi=0\n    for i,x in enumerate(xs):\n        if lo<=x<=hi and ys[i]>best:\n            best=ys[i]; bi=i\n    print(name, 'max', xs[bi], best)\nfor lo,hi in [(1100,1200),(2000,2100),(2500,2550),(2900,3000)]:\n    vals=[ys[i] for i,x in enumerate(xs) if lo<=x<=hi]\n    if vals:\n        print('baseline', lo, hi, 'mean', sum(vals)/len(vals), 'min', min(vals), 'max', max(vals))\nPY\n"]
