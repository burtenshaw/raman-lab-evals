[425.935514, "o", "\u001b[?2004h> "]
[425.935539, "o", "            s=aug[i][4]\r\n\u001b[?2004l\r"]
[425.93556, "o", "\u001b[?2004h> "]
[425.935622, "o", "            for j in range(i+1,4): s-=aug[i][j]*dp[j]\r\n\u001b[?2004l\r"]
[425.935644, "o", "\u001b[?2004h> "]
[425.935677, "o", "            dp[i]=s/aug[i][i]\r\n\u001b[?2004l\r"]
[425.935698, "o", "\u001b[?2004h> "]
[425.935745, "o", "        pn=[p[i]+dp[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[425.935777, "o", "\u001b[?2004h> "]
[425.935838, "o", "        if pn[1]<=0: pn[1]=abs(pn[1])*0.5+1e-3\r\n\u001b[?2004l\r\u001b[?2004h"]
[425.935854, "o", "> "]
[425.935933, "o", "        mn=[lorentzian(x,pn[0],pn[1],pn[2],pn[3]) for x in xd]\r\n\u001b[?2004l\r"]
[425.935968, "o", "\u001b[?2004h> "]
[425.936025, "o", "        rn=[yd[i]-mn[i] for i in range(n)]; sn=sum(r*r for r in rn)\r\n\u001b[?2004l\r"]
[425.93605, "o", "\u001b[?2004h> "]
[425.936097, "o", "        if sn<sss if (sss:=sse) else sn< sse:\r\n\u001b[?2004l\r"]
[425.936126, "o", "\u001b[?2004h> "]
[425.936156, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[425.936188, "o", "        if sn< sse:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[425.936272, "o", "            rc=abs(sse-sn)/max(sse,1e-10); p=pn; lam=max(lam*0.1,1e-15)\r\n\u001b[?2004l\r"]
[425.936295, "o", "\u001b[?2004h> "]
[425.936326, "o", "            if rc<1e-14: break\r\n\u001b[?2004l\r"]
[425.936358, "o", "\u001b[?2004h> "]
[425.936385, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[425.936416, "o", "            lam*=10.0\r\n\u001b[?2004l\r"]
[425.936442, "o", "\u001b[?2004h> "]
[425.936458, "o", "            if lam>1e15: break\r\n\u001b[?2004l\r\u001b[?2004h"]
[425.936492, "o", "> "]
[425.936515, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[425.936531, "o", "\u001b[?2004h> "]
[425.936653, "o", "inits={'D':(11958.0,14.5,1346.06,1490.0),'G':(8449.0,13.6,1585.13,1434.0),'2D':(10534.0,19.5,2678.42,1410.0)}\r\n\u001b[?2004l\r"]
[425.936678, "o", "\u001b[?2004h> "]
[425.936706, "o", "for name in ['D','G','2D']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[425.936752, "o", "    for w in [80,100,150]:\r\n\u001b[?2004l\r"]
[425.936775, "o", "\u001b[?2004h> "]
[425.936818, "o", "        p=fit_lm(xs,ys,inits[name],w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[425.936921, "o", "        print(name,'win',w,'A=%.2f G=%.3f X=%.3f O=%.2f'%(p[0],p[1],p[2],p[3]))\r\n\u001b[?2004l\r"]
[425.936954, "o", "\u001b[?2004h> "]
[425.936976, "o", "    print()\r\n\u001b[?2004l\r\u001b[?2004h"]
