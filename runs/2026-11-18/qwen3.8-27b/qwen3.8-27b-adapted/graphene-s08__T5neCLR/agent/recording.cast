[219.55581, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1349.234189246512,\r\n    \"gamma\": 13.609195137868854,\r\n    \"amplitude\": 1315.0270654799288,\r\n    \"offset\": 968.7091267724139\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1581.1299787334435,\r\n    \"gamma\": 8.434907826270852,\r\n    \"amplitude\": 6596.175070452966,\r\n    \"offset\": 942.5233519382001\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2684.7308972254527,\r\n    \"gamma\": 17.006461017306332,\r\n    \"amplitude\": 13066.625704824335,\r\n    \"offset\": 807.5687162686047\r\n  },\r\n  \"ID_IG\": 0.1993620623216152\r\n}"]
