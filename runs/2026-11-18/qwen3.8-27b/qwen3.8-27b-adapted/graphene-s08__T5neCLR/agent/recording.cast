[129.231087, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm-1']\ny = data['intensity']\nprint(\"range:\", x.min(), x.max())\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nresults = {}\nfor name, center, window in [(\"D\", 1350, 80), (\"G\", 1580, 80), (\"2D\", 2690, 120)]:\n    m = (x > center - window) & (x < center + window)\n    xs, ys = x[m], y[m]\n    # initial guesses\n    offset0 = np.median(ys)\n    amp0 = ys.max() - offset0\n    # center-of-mass estimate\n    xc = (xs * (ys - offset0).clip(min=0)).sum() / (ys - offset0).clip(min=0).sum()\n    x00 = float(xc) if np.isfinite(xc) else center\n    # HWHM estimate from half-max crossing\n    hmax = offset0 + amp0/2\n    above = xs[ys > hmax]\n    g0 = (above.max() - above.min())/2 if len(above) > 1 else 10.0\n    p0 = [amp0, x00, g0, offset0]\n    popt, pcov = curve_fit(lorentz, xs, y"]
[129.231234, "i", "s, p0=p0, maxfev=100000)\n    amp, x0, gamma, off = popt\n    # gamma can come out negative; model uses gamma^2 so take abs\n    gamma = abs(gamma)\n    results[name] = {\"x0\": float(x0), \"gamma\": float(gamma), \"amplitude\": float(amp), \"offset\": float(off)}\n    print(name, \"amp=%.3f x0=%.3f gamma=%.3f offset=%.3f\" % (amp, x0, gamma, off))\n\nresults[\"ID_IG\"] = float(results[\"D\"][\"amplitude\"] / results[\"G\"][\"amplitude\"])\nprint(\"ID_IG =\", results[\"ID_IG\"])\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
[129.231261, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
[129.231302, "o", "s, p0=p0, maxfev=100000)\r\n    amp, x0, gamma, off = popt\r\n    # gamma can come out negative; model uses gamma^2 so take abs\r\n    gamma = abs(gamma)\r\n    results[name] = {\"x0\": float(x0), \"gamma\": float(gamma), \"amplitude\": float(amp), \"offset\": float(off)}\r\n    print(name, \"amp=%.3f x0=%.3f gamma=%.3f offset=%.3f\" % (amp, x0, gamma, off))\r\n\r\nresults["]
[129.231316, "o", "\"ID_IG\"] = float"]
[129.231332, "o", "(results[\"D\"][\"amplitude\"] / results[\"G\"][\"amplitude\"])\r\nprint(\"ID_IG =\", results[\"ID_IG\"])\r\nwith open('/app/results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\n"]
[129.231345, "o", "EOF\r\n"]
