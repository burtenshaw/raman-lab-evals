[174.203438, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = data[:, 0]\ny = data[:, 1]\nprint(\"range:\", x.min(), x.max(), \"n=\", len(x))\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nresults = {}\nfor name, center, window in [(\"D\", 1350, 80), (\"G\", 1580, 80), (\"2D\", 2690, 120)]:\n    m = (x > center - window) & (x < center + window)\n    xs, ys = x[m], y[m]\n    offset0 = np.median(ys)\n    amp0 = ys.max() - offset0\n    w = (ys - offset0).clip(min=0)\n    xc = (xs * w).sum() / w.sum() if w.sum() > 0 else center\n    x00 = float(xc)\n    hmax = offset0 + amp0/2\n    above = xs[ys > hmax]\n    g0 = (above.max() - above.min())/2 if len(above) > 1 else 10.0\n    p0 = [amp0, x00, g0, offset0]\n    popt, pcov = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)\n    amp, x0, gamma, off = popt\n    gamma = abs(gamma)\n    results[name] = {\"x0\": float(x0), \"gam"]
