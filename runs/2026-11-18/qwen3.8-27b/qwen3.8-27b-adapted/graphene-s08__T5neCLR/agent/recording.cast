[293.655022, "i", "cat > /app/validate.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:,0], data[:,1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nimport json\nres = json.load(open('/app/results.json'))\nfor name in [\"D\",\"G\",\"2D\"]:\n    p = res[name]\n    c = p[\"x0\"]\n    m = (x > c-80) & (x < c+80)\n    xs, ys = x[m], y[m]\n    pred = lorentz(xs, p[\"amplitude\"], p[\"x0\"], p[\"gamma\"], p[\"offset\"])\n    ss_res = np.sum((ys-pred)**2)\n    ss_tot = np.sum((ys-np.mean(ys))**2)\n    r2 = 1 - ss_res/ss_tot\n    print(f\"{name}: R2={r2:.5f}  amp={p['amplitude']:.1f} x0={p['x0']:.2f} gamma={p['gamma']:.2f}\")\nprint(\"ID_IG =\", res[\"ID_IG\"])\n# stability check: refit with different window\nfor name, center, window in [(\"D\",1350,100),(\"G\",1580,100),(\"2D\",2690,160)]:\n    m = (x>center-window)&(x<center+window)\n    xs, ys = x[m], y[m]\n    off0 = np.median(ys); amp0 = ys.max()-off0\n    w ="]
[293.655086, "i", " (ys-off0).clip(min=0)\n    x00 = (xs*w).sum()/w.sum()\n    popt,_ = curve_fit(lorentz, xs, ys, p0=[amp0,x00,10.0,off0], maxfev=100000)\n    print(f\"{name} (wide win): amp={popt[0]:.1f} x0={popt[1]:.2f}\")\nEOF\npython3 /app/validate.py\n"]
[293.655185, "o", "cat > /app/validate.py << 'EOF'\r\n\u001b[?2004l\r"]
[293.655245, "o", "\u001b[?2004h"]
[293.655257, "o", "> "]
[293.655348, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.655611, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h> x, y = data[:,0], data[:,1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.655633, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.655735, "o", "def lorentz(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.655846, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[293.655925, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[293.655936, "o", "\u001b[?2004h> "]
[293.655946, "o", "import json\r\n\u001b[?2004l\r"]
[293.656026, "o", "\u001b[?2004h> "]
[293.656559, "o", "res = json.load(open('/app/results.json'))\r\n\u001b[?2004l\r\u001b[?2004h> for name in [\"D\",\"G\",\"2D\"]:\r\n\u001b[?2004l\r\u001b[?2004h>     p = res[name]\r\n\u001b[?2004l\r\u001b[?2004h>     c = p[\"x0\"]\r\n\u001b[?2004l\r\u001b[?2004h>     m = (x > c-80) & (x < c+80)\r\n\u001b[?2004l\r\u001b[?2004h>     xs, ys = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     pred = lorentz(xs, p[\"amplitude\"], p[\"x0\"], p[\"gamma\"], p[\"offset\"])\r\n\u001b[?2004l\r\u001b[?2004h>     ss_res = np.sum((ys-pred)**2)\r\n\u001b[?2004l\r\u001b[?2004h>     ss_tot = np.sum((ys-np.mean(ys))**2)\r\n\u001b[?2004l\r\u001b[?2004h>     r2 = 1 - ss_res/ss_tot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.656624, "o", "    print(f\"{name}: R2={r2:.5f}  amp={p['amplitude']:.1f} x0={p['x0']:.2f} gamma={p['gamma']:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.65664, "o", "> "]
[293.656728, "o", "print(\"ID_IG =\", res[\"ID_IG\"])\r\n\u001b[?2004l\r"]
[293.656763, "o", "\u001b[?2004h> "]
[293.656815, "o", "# stability check: refit with different window\r\n\u001b[?2004l\r"]
[293.656834, "o", "\u001b[?2004h> "]
[293.656958, "o", "for name, center, window in [(\"D\",1350,100),(\"G\",1580,100),(\"2D\",2690,160)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.656997, "o", "> "]
[293.657017, "o", "    m = (x>center-window)&(x<center+window)\r\n\u001b[?2004l\r"]
[293.657036, "o", "\u001b[?2004h> "]
[293.657126, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.657179, "o", "    off0 = np.median(ys); amp0 = ys.max()-off0\r\n\u001b[?2004l\r"]
[293.657216, "o", "\u001b[?2004h> "]
[293.657307, "o", "    w = (ys-off0).clip(min=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.65733, "o", "    x00 = (xs*w).sum()/w.sum()\r\n\u001b[?2004l\r"]
[293.657393, "o", "\u001b[?2004h> "]
[293.657458, "o", "    popt,_ = curve_fit(lorentz, xs, ys, p0=[amp0,x00,10.0,off0], maxfev=100000)\r\n\u001b[?2004l\r"]
[293.657534, "o", "\u001b[?2004h> "]
[293.657571, "o", "    print(f\"{name} (wide win): amp={popt[0]:.1f} x0={popt[1]:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.657617, "o", "EOF\r\n\u001b[?2004l\r"]
