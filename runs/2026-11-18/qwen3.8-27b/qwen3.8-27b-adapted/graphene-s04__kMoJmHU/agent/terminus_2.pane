[?2004hroot@j-openenv-6afd8ceae5cad0e4dc3e6d8b-7p7u2l9t-05fec-9qqwn:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:,0]; y = data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, width):
[?2004l[?2004h>     mask = (x > center - width) & (x < center + width)
[?2004l[?2004h>     xs = x[mask]; ys = y[mask]
[?2004l[?2004h>     # initial guesses
[?2004l[?2004h>     off0 = np.percentile(ys, 5)  # baseline estimate
[?2004l[?2004h>     i = np.argmax(ys)
[?2004l[?2004h>     x0_0 = xs[i]
[?2004l[?2004h>     amp0 = ys[i] - off0
[?2004l[?2004h>     gamma0 = 20.0
[?2004l[?2004h>     p0 = [x0_0, gamma0, amp0, off0]
[?2004l[?2004h>     bounds = ([xs.min(), 1.0, 0.0, -np.inf],
[?2004l[?2004h>               [xs.max(), width, np.inf, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     x0, gamma, amp, off = popt
[?2004l[?2004h>     return dict(x0=float(x0), gamma=float(gamma), amplitude=float(amp), offset=float(off))
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> results['D'] = fit_peak(1350, 90)
[?2004l[?2004h> results['G'] = fit_peak(1580, 90)
[?2004l[?2004h> results['2D'] = fit_peak(2690, 120)
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
