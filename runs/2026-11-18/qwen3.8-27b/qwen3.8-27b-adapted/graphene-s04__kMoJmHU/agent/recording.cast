[108.044708, "i", "python3 -c \"\nimport numpy as np, json\ndef lor(x,x0,g,a,o): return a*g**2/((x-x0)**2+g**2)+o\ndata=np.genfromtxt('/app/spectrum.csv',delimiter=',',skip_header=1); x,y=data[:,0],data[:,1]\nr=json.load(open('/app/results.json'))\nfor name,c,w in [('D',1350,90),('G',1580,90),('2D',2690,120)]:\n    m=(x>c-w)&(x<c+w); p=r[name]\n    res=y[m]-lor(x[m],p['x0'],p['gamma'],p['amplitude'],p['offset'])\n    print(f'{name}: resid rms={np.sqrt(np.mean(res**2)):.2f}, max|resid|={np.abs(res).max():.1f}')\nprint('ID_IG:', r['ID_IG'])\nprint('keys:', list(r.keys()))\n\"\n"]
