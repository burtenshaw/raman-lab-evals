[48.094857, "i", "python3 -c \"\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]; y = data[:,1]\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\nprint('num points:', len(x))\n# Rough look at regions around expected peaks\nfor center, width in [(1350,100),(1580,100),(2690,150)]:\n    mask = (x > center-width) & (x < center+width)\n    if mask.sum()>0:\n        i = np.argmax(y[mask])\n        print(f'Peak near {center}: max at x={x[mask][i]:.1f}, y={y[mask][i]:.1f}')\n\"\n"]
