[84.00606, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]; y = data[:,1]\n\ndef fit_peak(center, width):\n    mask = (x > center - width) & (x < center + width)\n    xs = x[mask]; ys = y[mask]\n    # initial guesses\n    off0 = np.percentile(ys, 5)  # baseline estimate\n    i = np.argmax(ys)\n    x0_0 = xs[i]\n    amp0 = ys[i] - off0\n    gamma0 = 20.0\n    p0 = [x0_0, gamma0, amp0, off0]\n    bounds = ([xs.min(), 1.0, 0.0, -np.inf],\n              [xs.max(), width, np.inf, np.inf])\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    x0, gamma, amp, off = popt\n    return dict(x0=float(x0), gamma=float(gamma), amplitude=float(amp), offset=float(off))\n\nresults = {}\nresults['D'] = fit_peak(1350, 90)\nresults['G'] = fit_peak(1580, 90)\nresults['2D'] = fit_"]
[84.006219, "i", "peak(2690, 120)\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit.py\n"]
