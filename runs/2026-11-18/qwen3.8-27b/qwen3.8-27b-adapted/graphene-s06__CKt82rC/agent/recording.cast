[55.732082, "o", "Data range: 1100.0 to 3000.0, 3800 points\r\n"]
[55.732137, "o", "Baseline (avg of edges): 1010.004925\r\n"]
[55.73227, "o", "Max intensity: 19517.521 at x=2694.4196\r\n"]
[55.740898, "o", "\r\nD ~1350: max=5795.6 at 1347.07, min=979.0, local baseline~1068.6\r\n"]
[55.741021, "o", "  FWHM-ish span: 28.0 (gamma~14.0)\r\n"]
[55.741124, "o", "\r\nG ~1580: max=9870.7 at 1579.13, min=935.9, local baseline~1060.0\r\n"]
[55.741178, "o", "  FWHM-ish span: 19.0 (gamma~9.5)\r\n"]
