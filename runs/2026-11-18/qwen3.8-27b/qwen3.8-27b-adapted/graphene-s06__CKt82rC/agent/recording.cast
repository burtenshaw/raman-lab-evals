[88.041176, "o", "cat /app/results.json\r\n\u001b[?2004l\r"]
[88.042223, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1346.714365050565,\r\n    \"gamma\": 15.136957384644857,\r\n    \"amplitude\": 4858.06335777096,\r\n    \"offset\": 865.0318949163056\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1579.5664969950385,\r\n    \"gamma\": 9.968644404888991,\r\n    \"amplitude\": 8865.422442332942,\r\n    \"offset\": 897.6402515385932\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2693.420126041682,\r\n    \"gamma\": 29.038069242397363,\r\n    \"amplitude\": 18462.43314937782,\r\n    \"offset\": 1003.2890591727069\r\n  },\r\n  \"ID_IG\": 0.5479787781542599\r\n}"]
[88.042392, "o", "\u001b[?2004h"]
[88.042426, "o", "root@j-openenv-6afd8d9029e8b7ccfbbb83b4-xkyrrlyk-d0316-mrkxx:/app# "]
[88.14109, "i", "cat > /app/check.py << 'EOF'\nimport numpy as np, json\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude*gamma**2/((x-x0)**2+gamma**2)+offset\nres = json.load(open('/app/results.json'))\nfor name, center in [('D',1350),('G',1580),('2D',2690)]:\n    m = (x>center-80)&(x<center+80)\n    xi,yi = x[m],y[m]\n    p = res[name]\n    fit = lorentz(xi, p['amplitude'], p['x0'], p['gamma'], p['offset'])\n    resid = yi-fit\n    ss_res = np.sum(resid**2); ss_tot = np.sum((yi-np.mean(yi))**2)\n    print(f\"{name}: R^2={1-ss_res/ss_tot:.5f}, RMSE={np.sqrt(np.mean(resid**2)):.2f}, residual range [{resid.min():.1f},{resid.max():.1f}]\")\nEOF\npython3 /app/check.py\n"]
[88.141216, "o", "cat > /app/check.py << 'EOF'\r\n"]
[88.141254, "o", "\u001b[?2004l\r"]
[88.14134, "o", "\u001b[?2004h> "]
[88.141382, "o", "import numpy as np, json\r\n\u001b[?2004l\r\u001b[?2004h> "]
