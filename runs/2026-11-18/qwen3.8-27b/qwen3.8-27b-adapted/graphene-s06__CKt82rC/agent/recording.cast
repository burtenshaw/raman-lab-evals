[88.144018, "o", "python3 /app/check.py\r\n\u001b[?2004l\r"]
[88.326379, "o", "D: R^2=0.99855, RMSE=52.31, residual range [-186.3,142.2]\r\n"]
[88.326415, "o", "G: R^2=0.99960, RMSE=45.06, residual range [-136.5,124.9]\r\n"]
