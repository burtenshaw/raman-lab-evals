[117.442201, "i", "python3 -c \"\nimport json\nr = json.load(open('/app/results.json'))\nassert set(r.keys()) == {'D','G','2D','ID_IG'}, r.keys()\nfor k in ['D','G','2D']:\n    assert set(r[k].keys()) == {'x0','gamma','amplitude','offset'}, (k, r[k].keys())\n    for v in r[k].values():\n        assert isinstance(v, float), (k, v)\nassert isinstance(r['ID_IG'], float)\nprint('Valid. ID_IG =', r['ID_IG'])\nprint('D amp =', r['D']['amplitude'], ' G amp =', r['G']['amplitude'])\nprint('ratio check:', r['D']['amplitude']/r['G']['amplitude'])\n\"\n"]
