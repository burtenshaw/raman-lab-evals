[55.487346, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\nprint(f\"Data range: {x.min()} to {x.max()}, {len(x)} points\")\nprint(f\"Baseline (avg of edges): {np.mean([y[:20], y[-20:]])}\")\nprint(f\"Max intensity: {y.max()} at x={x[np.argmax(y)]}\")\n\nfor name, center in [('D', 1350), ('G', 1580), ('2D', 2690)]:\n    mask = (x > center - 80) & (x < center + 80)\n    xi = x[mask]\n    yi = y[mask]\n    # local max\n    idx = np.argmax(yi)\n    print(f\"\\n{name} ~{center}: max={yi[idx]:.1f} at {xi[idx]:.2f}, min={yi.min():.1f}, local baseline~{np.percentile(yi,10):.1f}\")\n    # rough width estimate\n    half = (yi.max() + np.percentile(yi,10))/2\n    above = xi[yi > half]\n    if len(above) > 1:\n        print(f\"  FWHM-ish span: {above.max()-above.min():.1f} (gamma~{(above.max()-above.min())/2:.1f})\")\nEOF\npython3 /app/explore.py\n"]
