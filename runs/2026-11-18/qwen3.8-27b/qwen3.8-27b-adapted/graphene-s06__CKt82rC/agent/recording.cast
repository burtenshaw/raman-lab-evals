[55.75655, "o", "\u001b[?2004hroot@j-openenv-6afd8d9029e8b7ccfbbb83b4-xkyrrlyk-d0316-mrkxx:/app# "]
[75.122376, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, half_win=80):\n    mask = (x > center - half_win) & (x < center + half_win)\n    xi, yi = x[mask], y[mask]\n    idx = np.argmax(yi)\n    x0_0 = xi[idx]\n    baseline = np.percentile(yi, 10)\n    amp_0 = yi[idx] - baseline\n    # FWHM estimate\n    half = (yi.max() + baseline) / 2\n    above = xi[yi > half]\n    gamma_0 = max(5.0, (above.max() - above.min()) / 2) if len(above) > 1 else 10.0\n    p0 = [amp_0, x0_0, gamma_0, baseline]\n    bounds = ([0, x0_0 - 60, 1, 0], [np.inf, x0_0 + 60, 200, np.inf])\n    popt, pcov = curve_fit(lorentz, xi, yi, p0=p0, bounds=bounds, maxfev=100000)\n    perr = np.sqrt(np.diag(pcov))\n    return popt, perr\n\nresults = {}\nfor name, center in [('D', 1350), ('G', 158"]
[75.122517, "i", "0), ('2D', 2690)]:\n    popt, perr = fit_peak(center)\n    amplitude, x0, gamma, offset = popt\n    results[name] = {\n        \"x0\": float(x0),\n        \"gamma\": float(gamma),\n        \"amplitude\": float(amplitude),\n        \"offset\": float(offset),\n    }\n    print(f\"{name}: x0={x0:.3f}+/-{perr[1]:.3f}, gamma={gamma:.3f}+/-{perr[2]:.3f}, \"\n          f\"amplitude={amplitude:.3f}+/-{perr[0]:.3f}, offset={offset:.3f}+/-{perr[3]:.3f}\")\n\nresults[\"ID_IG\"] = float(results['D']['amplitude'] / results['G']['amplitude'])\nprint(f\"\\nID_IG = {results['ID_IG']:.6f}\")\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(\"Wrote /app/results.json\")\nEOF\npython3 /app/fit.py\n"]
