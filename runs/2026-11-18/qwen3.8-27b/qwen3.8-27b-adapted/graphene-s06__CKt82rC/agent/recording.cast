[88.141494, "o", "\u001b[?2004h> "]
[88.14153, "o", "x, y = data[:,0], data[:,1]\r\n\u001b[?2004l\r"]
[88.141566, "o", "\u001b[?2004h> "]
[88.141619, "o", "def lorentz(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[88.141654, "o", "\u001b[?2004h> "]
[88.141718, "o", "    return amplitude*gamma**2/((x-x0)**2+gamma**2)+offset\r\n\u001b[?2004l\r"]
[88.141754, "o", "\u001b[?2004h> "]
[88.141822, "o", "res = json.load(open('/app/results.json'))\r\n\u001b[?2004l\r"]
[88.141879, "o", "\u001b[?2004h> "]
[88.141916, "o", "for name, center in [('D',1350),('G',1580),('2D',2690)]:\r\n\u001b[?2004l\r"]
[88.141944, "o", "\u001b[?2004h> "]
[88.141987, "o", "    m = (x>center-80)&(x<center+80)\r\n\u001b[?2004l\r"]
[88.142021, "o", "\u001b[?2004h> "]
[88.142063, "o", "    xi,yi = x[m],y[m]\r\n\u001b[?2004l\r"]
[88.142105, "o", "\u001b[?2004h> "]
[88.14215, "o", "    p = res[name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.14221, "o", "    fit = lorentz(xi, p['amplitude'], p['x0'], p['gamma'], p['offset'])\r\n\u001b[?2004l\r"]
[88.142237, "o", "\u001b[?2004h> "]
[88.142266, "o", "    resid = yi-fit\r\n\u001b[?2004l\r"]
[88.142289, "o", "\u001b[?2004h> "]
[88.142373, "o", "    ss_res = np.sum(resid**2); ss_tot = np.sum((yi-np.mean(yi))**2)\r\n\u001b[?2004l\r"]
[88.142405, "o", "\u001b[?2004h"]
[88.142434, "o", "> "]
[88.142568, "o", "    print(f\"{name}: R^2={1-ss_res/ss_tot:.5f}, RMSE={np.sqrt(np.mean(resid**2)):.2f}, residual range [{resid.min():.1f},{resid.max():.1f}]\")\r\n\u001b[?2004l\r"]
[88.142601, "o", "\u001b[?2004h> "]
[88.142623, "o", "EOF\r\n\u001b[?2004l\r"]
