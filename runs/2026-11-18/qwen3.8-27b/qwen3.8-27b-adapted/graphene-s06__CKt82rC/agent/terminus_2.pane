[?2004hroot@j-openenv-6afd8d9029e8b7ccfbbb83b4-xkyrrlyk-d0316-mrkxx:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, half_win=80):
[?2004l[?2004h>     mask = (x > center - half_win) & (x < center + half_win)
[?2004l[?2004h>     xi, yi = x[mask], y[mask]
[?2004l[?2004h>     idx = np.argmax(yi)
[?2004l[?2004h>     x0_0 = xi[idx]
[?2004l[?2004h>     baseline = np.percentile(yi, 10)
[?2004l[?2004h>     amp_0 = yi[idx] - baseline
[?2004l[?2004h>     # FWHM estimate
[?2004l[?2004h>     half = (yi.max() + baseline) / 2
[?2004l[?2004h>     above = xi[yi > half]
[?2004l[?2004h>     gamma_0 = max(5.0, (above.max() - above.min()) / 2) if len(above) > 1 else 10.0
[?2004l[?2004h>     p0 = [amp_0, x0_0, gamma_0, baseline]
[?2004l[?2004h>     bounds = ([0, x0_0 - 60, 1, 0], [np.inf, x0_0 + 60, 200, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xi, yi, p0=p0, bounds=bounds, maxfev=100000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     return popt, perr
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, center in [('D', 1350), ('G', 1580), ('2D', 2690)]:
[?2004l[?2004h>     popt, perr = fit_peak(center)
[?2004l[?2004h>     amplitude, x0, gamma, offset = popt
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         "x0": float(x0),
[?2004l[?2004h>         "gamma": float(gamma),
[?2004l[?2004h>         "amplitude": float(amplitude),
[?2004l[?2004h>         "offset": float(offset),
[?2004l[?2004h>     }
[?2004l[?2004h>     print(f"{name}: x0={x0:.3f}+/-{perr[1]:.3f}, gamma={gamma:.3f}+/-{perr[2]:.3f}, "
[?2004l[?2004h>           f"amplitude={amplitude:.3f}+/-{perr[0]:.3f}, offset={offset:.3f}+/-{perr[3]:.3f}")
[?2004l[?2004h> 
[?2004l[?2004h> results["ID_IG"] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print(f"\nID_IG = {results['ID_IG']:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print("Wrote /app/results.json")
[?2004l[?2004h> EOF
