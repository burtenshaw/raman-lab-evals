[79.979486, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]\ny = data[:,1]\n\nresults = {}\nfor center, label, window in [(1350,'D',120),(1580,'G',120),(2690,'2D',120)]:\n    mask = (x > center-window) & (x < center+window)\n    xi, yi = x[mask], y[mask]\n    \n    # Initial guesses\n    imax = np.argmax(yi)\n    x0_0 = xi[imax]\n    # offset from edges (average of first/last 20 points)\n    n_edge = 20\n    offset_0 = np.mean(np.concatenate([yi[:n_edge], yi[-n_edge:]]))\n    amp_0 = yi[imax] - offset_0\n    # FWHM estimate: find half max\n    half = offset_0 + amp_0/2\n    above = xi[yi > half]\n    if len(above) > 1:\n        fwhm_0 = above.max() - above.min()\n    else:\n        fwhm_0 = 20.0\n    gamma_0 = fwhm_0 / 2.0\n    \n    p0 = [amp_0, x0_0, gamma_0, offset_0]\n    try:\n        popt, pco"]
[79.979545, "i", "v = curve_fit(lorentzian, xi, yi, p0=p0, maxfev=100000)\n        amp_f, x0_f, gamma_f, off_f = popt\n        # Make gamma positive\n        if gamma_f < 0:\n            gamma_f = abs(gamma_f)\n        print(f\"{label}: x0={x0_f:.4f}, gamma={gamma_f:.4f}, amp={amp_f:.4f}, offset={off_f:.4f}\")\n        results[label] = {\"x0\": float(x0_f), \"gamma\": float(gamma_f), \"amplitude\": float(amp_f), \"offset\": float(off_f)}\n    except Exception as e:\n        print(f\"{label}: FIT FAILED: {e}\")\n        results[label] = {\"x0\": x0_0, \"gamma\": gamma_0, \"amplitude\": amp_0, \"offset\": offset_0}\n\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nresults['ID_IG'] = float(id_ig)\nprint(f\"ID_IG = {id_ig:.6f}\")\n\nwith open('/app/results.json','w') as f:\n    json.dump(results, f, indent=2)\nprint(\"Written to /app/results.json\")\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit.py\n"]
[79.979879, "o", "cat > /app/fit.py << 'EOF'\r\n"]
