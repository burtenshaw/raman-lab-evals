[179.392967, "i", "cat > /app/checkD.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]; y = data[:,1]\n\n# Look at D region\nmask = (x > 1290) & (x < 1420)\nxi, yi = x[mask], y[mask]\nprint(\"D region (x, y) near peak:\")\nfor i in range(0, len(xi), 2):\n    bar = '#'*int((yi[i]-600)/40)\n    print(f\"  {xi[i]:7.1f}  {yi[i]:7.1f}  {bar}\")\n\n# Check baseline slope on each side (exclude peak core 1320-1390)\nleft = (x>1250)&(x<1320)\nright = (x>1400)&(x<1470)\npL = np.polyfit(x[left], y[left], 1)\npR = np.polyfit(x[right], y[right], 1)\nprint(f\"\\nLeft baseline slope={pL[0]:.3f}/cm-1, val@1354={np.polyval(pL,1354):.1f}\")\nprint(f\"Right baseline slope={pR[0]:.3f}/cm-1, val@1354={np.polyval(pR,1354):.1f}\")\n\n# Fit with linear baseline: L + a + b*x\ndef lorentzian_lin(x, amplitude, x0, gamma, a, b):\n    return amplitude*gamma**2/((x-x"]
[179.393285, "i", "0)**2+gamma**2) + a + b*x\nmask2=(x>1230)&(x<1480)\nxi2,yi2=x[mask2],y[mask2]\np0=[635,1354,12.7, 840, 0.0]\npopt,_=curve_fit(lorentzian_lin, xi2, yi2, p0=p0, maxfev=200000)\nprint(f\"\\nLinear-baseline D fit: amp={popt[0]:.3f} x0={popt[1]:.3f} gamma={popt[2]:.3f} a={popt[3]:.3f} b={popt[4]:.4f}\")\nprint(f\"  -> baseline@1354 = {popt[3]+popt[4]*1354:.1f}\")\nEOF\npython3 /app/checkD.py\n"]
