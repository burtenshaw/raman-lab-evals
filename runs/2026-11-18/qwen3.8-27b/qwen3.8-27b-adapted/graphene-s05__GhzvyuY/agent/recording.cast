[52.632668, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]\ny = data[:,1]\nprint(\"x range:\", x.min(), x.max())\nprint(\"y min/max:\", y.min(), y.max())\n# Look at regions around each peak\nfor center, label in [(1350,'D'),(1580,'G'),(2690,'2D')]:\n    mask = (x > center-150) & (x < center+150)\n    xi, yi = x[mask], y[mask]\n    imax = np.argmax(yi)\n    print(f\"{label}: peak at x={xi[imax]:.1f}, max y={yi[imax]:.1f}, region y mean={yi.mean():.1f}\")\nEOF\npython3 /app/explore.py\n"]
