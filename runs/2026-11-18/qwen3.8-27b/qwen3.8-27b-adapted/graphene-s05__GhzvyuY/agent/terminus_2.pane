[?2004hroot@j-openenv-6afd8ef7e5cad0e4dc3e6ef2-gijrhveo-0c9e1-89prt:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:,0]
[?2004l[?2004h> y = data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for center, label, window in [(1350,'D',120),(1580,'G',120),(2690,'2D',120)]:
[?2004l[?2004h>     mask = (x > center-window) & (x < center+window)
[?2004l[?2004h>     xi, yi = x[mask], y[mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial guesses
[?2004l[?2004h>     imax = np.argmax(yi)
[?2004l[?2004h>     x0_0 = xi[imax]
[?2004l[?2004h>     # offset from edges (average of first/last 20 points)
[?2004l[?2004h>     n_edge = 20
[?2004l[?2004h>     offset_0 = np.mean(np.concatenate([yi[:n_edge], yi[-n_edge:]]))
[?2004l[?2004h>     amp_0 = yi[imax] - offset_0
[?2004l[?2004h>     # FWHM estimate: find half max
[?2004l[?2004h>     half = offset_0 + amp_0/2
[?2004l[?2004h>     above = xi[yi > half]
[?2004l[?2004h>     if len(above) > 1:
[?2004l[?2004h>         fwhm_0 = above.max() - above.min()
[?2004l[?2004h>     else:
[?2004l[?2004h>         fwhm_0 = 20.0
[?2004l[?2004h>     gamma_0 = fwhm_0 / 2.0
[?2004l[?2004h>     
[?2004l[?2004h>     p0 = [amp_0, x0_0, gamma_0, offset_0]
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, pcov = curve_fit(lorentzian, xi, yi, p0=p0, maxfev=100000)
[?2004l[?2004h>         amp_f, x0_f, gamma_f, off_f = popt
[?2004l[?2004h>         # Make gamma positive
[?2004l[?2004h>         if gamma_f < 0:
[?2004l[?2004h>             gamma_f = abs(gamma_f)
[?2004l[?2004h>         print(f"{label}: x0={x0_f:.4f}, gamma={gamma_f:.4f}, amp={amp_f:.4f}, offset={off_f:.4f}")
[?2004l[?2004h>         results[label] = {"x0": float(x0_f), "gamma": float(gamma_f), "amplitude": float(amp_f), "offset": float(off_f)}
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"{label}: FIT FAILED: {e}")
[?2004l[?2004h>         results[label] = {"x0": x0_0, "gamma": gamma_0, "amplitude": amp_0, "offset": offset_0}
[?2004l[?2004h> 
[?2004l[?2004h> id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> results['ID_IG'] = float(id_ig)
[?2004l[?2004h> print(f"ID_IG = {id_ig:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print("Written to /app/results.json")
[?2004l[?2004h> print(json.dumps(results, indent=2))
