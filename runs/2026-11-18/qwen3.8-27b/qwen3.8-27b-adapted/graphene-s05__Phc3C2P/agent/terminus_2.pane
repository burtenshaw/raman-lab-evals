[?2004hroot@j-openenv-6afd8cfae5cad0e4dc3e6d91-6i9en3mt-63a52-s8qzp:/app# cat <<'PY' > /app/fit_peaks.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = data[:,0], data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def model(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(name, lo, hi):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xi, yi = x[m], y[m]
[?2004l[?2004h>     imax = np.argmax(yi)
[?2004l[?2004h>     x0_guess = xi[imax]
[?2004l[?2004h>     amp_guess = yi[imax] - np.median(np.concatenate([yi[:10], yi[-10:]]))
[?2004l[?2004h>     thr = np.median(np.concatenate([yi[:10], yi[-10:]])) + 0.5*(yi[imax]-np.median(np.concatenate([yi[:10], yi[-10:]])))
[?2004l[?2004h>     above = xi[yi>thr]
[?2004l[?2004h>     fwhm_guess = above.max()-above.min() if len(above)>0 else 20.0
[?2004l[?2004h>     gamma_guess = fwhm_guess/2.0
[?2004l[?2004h>     offset_guess = np.median(np.concatenate([yi[:10], yi[-10:]]))
[?2004l[?2004h>     p0 = [amp_guess, x0_guess, gamma_guess, offset_guess]
[?2004l[?2004h>     # bounds: amplitude>0, gamma>0, x0 within window, offset>=0
[?2004l[?2004h>     bounds = ([0, lo, 1.0, 0], [np.inf, hi, (hi-lo), np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(model, xi, yi, p0=p0, bounds=bounds, maxfev=100000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     print(f'{name}: popt={popt}, perr={perr}')
[?2004l[?2004h>     return dict(zip(['amplitude','x0','gamma','offset'], popt))
[?2004l[?2004h> 
[?2004l[?2004h> D = fit_peak('D', 1280, 1440)
[?2004l[?2004h> G = fit_peak('G', 1500, 1660)
[?2004l[?2004h> D2 = fit_peak('2D', 2600, 2780)
[?2004l[?2004h> 
[?2004l[?2004h> result = {
[?2004l[?2004h>     'D': {'x0': D['x0'], 'gamma': D['gamma'], 'amplitude': D['amplitude'], 'offset': D['offset']},
[?2004l[?2004h>     'G': {'x0': G['x0'], 'gamma': G['gamma'], 'amplitude': G['amplitude'], 'offset': G['offset']},
[?2004l[?2004h>     '2D': {'x0': D2['x0'], 'gamma': D2['gamma'], 'amplitude': D2['amplitude'], 'offset': D2['offset']},
[?2004l[?2004h>     'ID_IG': D['amplitude'] / G['amplitude']
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
