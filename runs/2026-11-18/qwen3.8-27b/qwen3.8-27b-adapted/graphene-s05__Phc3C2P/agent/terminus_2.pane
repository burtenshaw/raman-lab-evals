[?2004hroot@j-openenv-6afd8cfae5cad0e4dc3e6d91-6i9en3mt-63a52-s8qzp:/app# cat <<'PY' > /app/diag.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = data[:,0], data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def model(x, a, x0, g, o):
[?2004l[?2004h>     return a*g*g/((x-x0)**2+g*g) + o
[?2004l[?2004h> 
[?2004l[?2004h> # Look for D' peak near 1620
[?2004l[?2004h> m=(x>=1590)&(x<=1660)
[?2004l[?2004h> print('Region 1590-1660 max:', x[m][np.argmax(y[m])], y[m].max())
[?2004l[?2004h> print('Region 1590-1660 sample:', list(zip(np.round(x[m][::10],1), np.round(y[m][::10],1))))
[?2004l[?2004h> 
[?2004l[?2004h> def fit(lo,hi,p0=None):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xi,yi=x[m],y[m]
[?2004l[?2004h>     imax=np.argmax(yi)
[?2004l[?2004h>     base=np.median(np.concatenate([yi[:10],yi[-10:]]))
[?2004l[?2004h>     if p0 is None:
[?2004l[?2004h>         p0=[yi[imax]-base, xi[imax], 10.0, base]
[?2004l[?2004h>     bounds=([0,lo,1.0,0],[np.inf,hi,hi-lo,np.inf])
[?2004l[?2004h>     popt,_=curve_fit(model,xi,yi,p0=p0,bounds=bounds,maxfev=100000)
[?2004l[?2004h>     res=yi-model(xi,*popt)
[?2004l[?2004h>     rms=np.sqrt(np.mean(res**2))
[?2004l[?2004h>     return popt,rms
[?2004l[?2004h> 
[?2004l[?2004h> for name,lo,hi in [('D',1280,1440),('G',1500,1660),('2D',2600,2780)]:
[?2004l[?2004h>     popt,rms=fit(lo,hi)
[?2004l[?2004h>     print(f'{name} [{lo},{hi}] amp={popt[0]:.2f} x0={popt[1]:.2f} gam={popt[2]:.2f} off={popt[3]:.2f} rms={rms:.1f}')
[?2004l[?2004h> 
[?2004l[?2004h> print('--- window sensitivity (amplitude) ---')
[?2004l[?2004h> for lo,hi in [(1300,1420),(1280,1440),(1260,1460)]:
[?2004l[?2004h>     p,_=fit(lo,hi); print(f'D [{lo},{hi}] amp={p[0]:.2f}')
[?2004l[?2004h> for lo,hi in [(1510,1650),(1500,1660),(1490,1670),(1520,1620)]:
[?2004l[?2004h>     p,_=fit(lo,hi); print(f'G [{lo},{hi}] amp={p[0]:.2f} x0={p[1]:.2f} gam={p[2]:.2f}')
[?2004l[?2004h> for lo,hi in [(2620,2760),(2600,2780),(2580,2800)]:
[?2004l[?2004h>     p,_=fit(lo,hi); print(f'2D [{lo},{hi}] amp={p[0]:.2f}')
