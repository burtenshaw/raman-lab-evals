[179.383555, "o", "\u001b[?2004hroot@j-openenv-6afd8cfae5cad0e4dc3e6d91-6i9en3mt-63a52-s8qzp:/app# "]
[230.771109, "i", "cat <<'PY' > /app/diag.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\n\ndef model(x, a, x0, g, o):\n    return a*g*g/((x-x0)**2+g*g) + o\n\n# Look for D' peak near 1620\nm=(x>=1590)&(x<=1660)\nprint('Region 1590-1660 max:', x[m][np.argmax(y[m])], y[m].max())\nprint('Region 1590-1660 sample:', list(zip(np.round(x[m][::10],1), np.round(y[m][::10],1))))\n\ndef fit(lo,hi,p0=None):\n    m=(x>=lo)&(x<=hi)\n    xi,yi=x[m],y[m]\n    imax=np.argmax(yi)\n    base=np.median(np.concatenate([yi[:10],yi[-10:]]))\n    if p0 is None:\n        p0=[yi[imax]-base, xi[imax], 10.0, base]\n    bounds=([0,lo,1.0,0],[np.inf,hi,hi-lo,np.inf])\n    popt,_=curve_fit(model,xi,yi,p0=p0,bounds=bounds,maxfev=100000)\n    res=yi-model(xi,*popt)\n    rms=np.sqrt(np.mean(res**2))\n    return popt,rms\n\nfor name,lo,hi in [('D',1280,1440),('G',1500,1660),('2D',2600,2780)]:\n    popt,rms=fit(lo,hi)\n    print(f'{name} [{lo},{hi}] amp={popt[0]:.2f} x0={popt["]
[230.771242, "i", "1]:.2f} gam={popt[2]:.2f} off={popt[3]:.2f} rms={rms:.1f}')\n\nprint('--- window sensitivity (amplitude) ---')\nfor lo,hi in [(1300,1420),(1280,1440),(1260,1460)]:\n    p,_=fit(lo,hi); print(f'D [{lo},{hi}] amp={p[0]:.2f}')\nfor lo,hi in [(1510,1650),(1500,1660),(1490,1670),(1520,1620)]:\n    p,_=fit(lo,hi); print(f'G [{lo},{hi}] amp={p[0]:.2f} x0={p[1]:.2f} gam={p[2]:.2f}')\nfor lo,hi in [(2620,2760),(2600,2780),(2580,2800)]:\n    p,_=fit(lo,hi); print(f'2D [{lo},{hi}] amp={p[0]:.2f}')\nPY\npython3 /app/diag.py\n"]
