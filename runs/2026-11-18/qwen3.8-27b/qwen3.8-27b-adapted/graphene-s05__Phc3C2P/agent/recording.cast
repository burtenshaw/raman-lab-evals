[144.687716, "o", "\u001b[?2004hroot@j-openenv-6afd8cfae5cad0e4dc3e6d91-6i9en3mt-63a52-s8qzp:/app# "]
[163.754916, "i", "cat <<'PY' > /app/fit_peaks.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\n\ndef model(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(name, lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xi, yi = x[m], y[m]\n    imax = np.argmax(yi)\n    x0_guess = xi[imax]\n    amp_guess = yi[imax] - np.median(np.concatenate([yi[:10], yi[-10:]]))\n    thr = np.median(np.concatenate([yi[:10], yi[-10:]])) + 0.5*(yi[imax]-np.median(np.concatenate([yi[:10], yi[-10:]])))\n    above = xi[yi>thr]\n    fwhm_guess = above.max()-above.min() if len(above)>0 else 20.0\n    gamma_guess = fwhm_guess/2.0\n    offset_guess = np.median(np.concatenate([yi[:10], yi[-10:]]))\n    p0 = [amp_guess, x0_guess, gamma_guess, offset_guess]\n    # bounds: amplitude>0, gamma>0, x0 within window, offset>=0\n    bounds = ([0, lo, 1.0, 0], [np.inf, hi, (hi-lo), np.inf])\n    popt, p"]
[163.755069, "i", "cov = curve_fit(model, xi, yi, p0=p0, bounds=bounds, maxfev=100000)\n    perr = np.sqrt(np.diag(pcov))\n    print(f'{name}: popt={popt}, perr={perr}')\n    return dict(zip(['amplitude','x0','gamma','offset'], popt))\n\nD = fit_peak('D', 1280, 1440)\nG = fit_peak('G', 1500, 1660)\nD2 = fit_peak('2D', 2600, 2780)\n\nresult = {\n    'D': {'x0': D['x0'], 'gamma': D['gamma'], 'amplitude': D['amplitude'], 'offset': D['offset']},\n    'G': {'x0': G['x0'], 'gamma': G['gamma'], 'amplitude': G['amplitude'], 'offset': G['offset']},\n    '2D': {'x0': D2['x0'], 'gamma': D2['gamma'], 'amplitude': D2['amplitude'], 'offset': D2['offset']},\n    'ID_IG': D['amplitude'] / G['amplitude']\n}\n\nwith open('/app/results.json','w') as f:\n    json.dump(result, f, indent=2)\nprint(json.dumps(result, indent=2))\nPY\npython3 /app/fit_peaks.py\n"]
