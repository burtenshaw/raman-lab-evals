[123.282489, "o", "\u001b[?2004hroot@j-openenv-6afd8cfae5cad0e4dc3e6d91-6i9en3mt-63a52-s8qzp:/app# "]
[144.41492, "i", "cat <<'PY' > /app/inspect_peaks.py\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\nfor name, lo, hi in [('D',1250,1450), ('G',1480,1680), ('2D',2590,2790)]:\n    m = (x>=lo)&(x<=hi)\n    xi, yi = x[m], y[m]\n    imax = np.argmax(yi)\n    # baseline: median of first and last 25 points of window\n    base = np.median(np.concatenate([yi[:25], yi[-25:]]))\n    print(name, 'center=', xi[imax], 'height=', yi[imax], 'base=', base, 'half width rough where >base+0.5*(height-base):')\n    thr = base + 0.5*(yi[imax]-base)\n    above = xi[yi>thr]\n    if len(above)>0:\n        print('   FWHM approx', above.max()-above.min())\n# also show max globally\nimax_global=np.argmax(y); print('global max', x[imax_global], y[imax_global])\nPY\npython3 /app/inspect_peaks.py\n"]
[144.415332, "o", "cat <<'PY' > /app/inspect_peaks.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
