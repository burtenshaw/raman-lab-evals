[34.02735, "o", "\u001b[?2004hroot@j-openenv-6afd8f9f29e8b7ccfbbb84a9-ny1qvlr0-6edb6-7zvnb:/app# "]
[78.489794, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\nprint('baseline-ish median:', np.median(y))\n\n# windows\nwindows = {'D': (1250, 1450), 'G': (1480, 1680), '2D': (2580, 2800)}\nresults = {}\nfor name, (lo, hi) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    xw, yw = x[mask], y[mask]\n    off0 = np.median(yw[:20])\n    amp0 = yw.max() - off0\n    x00 = xw[np.argmax(yw)]\n    gamma0 = 20.0\n    p0 = [amp0, x00, gamma0, off0]\n    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\n    amplitude, x0, gamma, offset = popt\n    results[name] = {'x0': float(x0), 'gamma': float(abs(gamma)), 'amplitude': float(amplitude), 'offset': float(offset)}\n    print(name, '->', results[name]"]
[78.489904, "i", ")\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\nprint('ID_IG:', results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('written')\nEOF\n"]
