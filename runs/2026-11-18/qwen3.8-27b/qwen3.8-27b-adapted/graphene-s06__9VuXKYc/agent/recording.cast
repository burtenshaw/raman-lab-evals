[95.036009, "i", "python3 -c \"\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\ndef lorentz(x, a, x0, g, o):\n    return a*g**2/((x-x0)**2+g**2)+o\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\nr = json.load(open('/app/results.json'))\nfor name,(lo,hi) in {'D':(1250,1450),'G':(1480,1680),'2D':(2580,2800)}.items():\n    m=(x>=lo)&(x<=hi)\n    p=r[name]\n    yfit=lorentz(x[m], p['amplitude'], p['x0'], p['gamma'], p['offset'])\n    res=y[m]-yfit\n    print(name, 'RMSE=%.2f'%np.sqrt(np.mean(res**2)), 'residual std=%.1f'%res.std(), 'peak height=%.0f'%y[m].max())\n\"\n"]
