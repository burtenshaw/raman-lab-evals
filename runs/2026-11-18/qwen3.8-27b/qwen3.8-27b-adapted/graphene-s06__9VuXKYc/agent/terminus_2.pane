[?2004l[?2004h> print('y range:', y.min(), y.max())
[?2004l[?2004h> print('baseline-ish median:', np.median(y))
[?2004l[?2004h> 
[?2004l[?2004h> # windows
[?2004l[?2004h> windows = {'D': (1250, 1450), 'G': (1480, 1680), '2D': (2580, 2800)}
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi) in windows.items():
[?2004l[?2004h>     mask = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[mask], y[mask]
[?2004l[?2004h>     off0 = np.median(yw[:20])
[?2004l[?2004h>     amp0 = yw.max() - off0
[?2004l[?2004h>     x00 = xw[np.argmax(yw)]
[?2004l[?2004h>     gamma0 = 20.0
[?2004l[?2004h>     p0 = [amp0, x00, gamma0, off0]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)
[?2004l[?2004h>     amplitude, x0, gamma, offset = popt
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(abs(gamma)), 'amplitude': float(amplitude), 'offset': float(offset)}
[?2004l[?2004h>     print(name, '->', results[name])
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print('ID_IG:', results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
