[?2004l[?2004h>         ys.append(float(row['intensity']))
[?2004l[?2004h> x = np.array(xs)
[?2004l[?2004h> y = np.array(ys)
[?2004l[?2004h> print('x range:', x.min(), x.max(), 'n:', len(x))
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amp, x0, gamma, offset):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> result = {}
[?2004l[?2004h> for name, center, half in [('D', 1350, 150), ('G', 1580, 150), ('2D', 2690, 200)]:
[?2004l[?2004h>     m = (x >= center - half) & (x <= center + half)
[?2004l[?2004h>     xi, yi = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.median(yi))
[?2004l[?2004h>     i_pk = int(np.argmax(yi))
[?2004l[?2004h>     x00 = float(xi[i_pk])
[?2004l[?2004h>     amp0 = float(yi[i_pk]) - off0
[?2004l[?2004h>     p0 = [amp0, x00, 30.0, off0]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xi, yi, p0=p0,
[?2004l[?2004h>                            bounds=([0, center-half, 1.0, -np.inf],
[?2004l[?2004h>                                    [np.inf, center+half, 500.0, np.inf]),
[?2004l[?2004h>                            maxfev=100000)
[?2004l[?2004h>     amp, x0, gam, off = popt
[?2004l[?2004h>     err = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     resid = yi - lorentz(xi, *popt)
[?2004l[?2004h>     print(f'{name}: max={yi.max():.1f} @ {x00:.1f} | amp={amp:.3f}+/-{err[0]:.2f} x0={x0:.3f}+/-{err[1]:.3f} gamma={gam:.3f}+/-{err[2]:.3f} offset={off:.3f}+/-{err[3]:.2f} RMS={np.sqrt(np.mean(resid**2)):.2f}')
[?2004l[?2004h>     result[name] = {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> result['ID_IG'] = float(result['D']['amplitude'] / result['G']['amplitude'])
[?2004l[?2004h> print('ID/IG =', result['ID_IG'])
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
