[438.868727, "o", "Successfully installed numpy-2.5.5 scipy-1.18.1\r\nWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\r\n\r\n[notice] A new release of pip is available: 26.2.2 -> 26.3\r\n[notice] To update, run: pip install --upgrade pip\r\n"]
[438.868974, "o", "\u001b[?2004hroot@j-openenv-6afd8c3529e8b7ccfbbb82ee-a9y9f6yr-6fb29-qmcp2:/app# "]
[479.350947, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json, csv\n\nxs, ys = [], []\nwith open('/app/spectrum.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nx = np.array(xs)\ny = np.array(ys)\nprint('x range:', x.min(), x.max(), 'n:', len(x))\n\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nresult = {}\nfor name, center, half in [('D', 1350, 150), ('G', 1580, 150), ('2D', 2690, 200)]:\n    m = (x >= center - half) & (x <= center + half)\n    xi, yi = x[m], y[m]\n    off0 = float(np.median(yi))\n    i_pk = int(np.argmax(yi))\n    x00 = float(xi[i_pk])\n    amp0 = float(yi[i_pk]) - off0\n    p0 = [amp0, x00, 30.0, off0]\n    popt, pcov = curve_fit(lorentz, xi, yi, p0=p0,\n                           bounds=([0, center-half, 1.0, -np.inf],\n                                   [np.inf, center+half, 500.0, np.inf]),\n                           "]
[479.351083, "i", "maxfev=100000)\n    amp, x0, gam, off = popt\n    err = np.sqrt(np.diag(pcov))\n    resid = yi - lorentz(xi, *popt)\n    print(f'{name}: max={yi.max():.1f} @ {x00:.1f} | amp={amp:.3f}+/-{err[0]:.2f} x0={x0:.3f}+/-{err[1]:.3f} gamma={gam:.3f}+/-{err[2]:.3f} offset={off:.3f}+/-{err[3]:.2f} RMS={np.sqrt(np.mean(resid**2)):.2f}')\n    result[name] = {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(off)}\n\nresult['ID_IG'] = float(result['D']['amplitude'] / result['G']['amplitude'])\nprint('ID/IG =', result['ID_IG'])\nwith open('/app/results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('written')\nEOF\n"]
