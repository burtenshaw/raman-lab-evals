[496.100214, "i", "python3 -c \"\nimport numpy as np, csv\nxs, ys = [], []\nwith open('/app/spectrum.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nx = np.array(xs); y = np.array(ys)\nfor lo, hi in [(1150,1200),(2000,2100),(2900,2980)]:\n    m = (x>=lo)&(x<=hi)\n    print(lo, hi, 'noise std:', np.std(y[m], ddof=1))\n\"\n"]
