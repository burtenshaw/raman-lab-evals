[?2004l[?2004h>     p0 = [amp0, xf[i], 20.0, offset0]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xf, yf, p0=p0, maxfev=20000)
[?2004l[?2004h>     resid = yf - lorentz(xf, *popt)
[?2004l[?2004h>     ss_res = np.sum(resid**2)
[?2004l[?2004h>     ss_tot = np.sum((yf - yf.mean())**2)
[?2004l[?2004h>     r2 = 1 - ss_res/ss_tot
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
