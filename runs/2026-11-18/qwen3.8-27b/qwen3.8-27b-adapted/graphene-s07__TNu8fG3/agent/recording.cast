[91.457148, "i", "cd /app && python3 << 'EOF'\nimport numpy as np\ndata = np.genfromtxt('spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm-1']\ny = data['intensity']\nprint(\"x range:\", x.min(), x.max(), \"n=\", len(x))\nfor name, center in [('D',1350),('G',1580),('2D',2690)]:\n    m = (x > center-150) & (x < center+150)\n    print(name, \"max in window:\", y[m].max(), \"at x=\", x[m][np.argmax(y[m])])\nEOF\n"]
