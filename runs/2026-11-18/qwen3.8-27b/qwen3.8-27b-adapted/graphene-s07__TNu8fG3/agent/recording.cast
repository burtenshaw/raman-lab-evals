[163.982877, "o", "\u001b[?2004h> "]
[163.982949, "o", "for lo,hi in [(1150,1450),(1180,1470),(1200,1480),(1180,1450)]:\r\n\u001b[?2004l\r"]
[163.982974, "o", "\u001b[?2004h> "]
[163.98307, "o", "    p = fit(lo,hi); print(f\"  [{lo},{hi}] amp={p[0]:.1f} x0={p[1]:.2f} gam={p[2]:.2f}\")\r\n\u001b[?2004l\r"]
