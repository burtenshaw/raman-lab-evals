[163.981488, "i", "cd /app && python3 << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]; y = data[:,1]\n\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit(lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xf, yf = x[m], y[m]\n    i = np.argmax(yf)\n    offset0 = np.median(np.concatenate([yf[:10], yf[-10:]]))\n    p0 = [yf[i]-offset0, xf[i], 20.0, offset0]\n    popt, _ = curve_fit(lorentz, xf, yf, p0=p0, maxfev=20000)\n    return popt\n\nprint(\"D windows:\")\nfor lo,hi in [(1150,1450),(1180,1470),(1200,1480),(1180,1450)]:\n    p = fit(lo,hi); print(f\"  [{lo},{hi}] amp={p[0]:.1f} x0={p[1]:.2f} gam={p[2]:.2f}\")\nprint(\"G windows:\")\nfor lo,hi in [(1500,1700),(1470,1760),(1500,1730),(1480,1700)]:\n    p = fit(lo,hi); print(f\"  [{lo},{hi}] amp={p[0]:.1f} x0={p[1]:.2f} gam={p[2]:.2f}\")\nprint(\"2D windows:\")\nfor lo,hi in [(2500,2880),(2550,2850),(2520,2860)]:\n    p = fit(lo,hi); print(f\"  [{lo},{hi}] "]
[163.981535, "i", "amp={p[0]:.1f} x0={p[1]:.2f} gam={p[2]:.2f}\")\nEOF\n"]
