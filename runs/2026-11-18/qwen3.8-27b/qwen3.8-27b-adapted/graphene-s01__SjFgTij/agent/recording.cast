[344.217684, "i", "python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2:\n            xs.append(float(row[0])); ys.append(float(row[1]))\n# print D region 1300-1400 step ~2\nprint('x,y around D:')\nfor i,x in enumerate(xs):\n    if 1300 <= x <= 1400 and abs((x-1300)%2) < 1:\n        print(f'{x:.2f} {ys[i]:.2f}')\nPY\n"]
