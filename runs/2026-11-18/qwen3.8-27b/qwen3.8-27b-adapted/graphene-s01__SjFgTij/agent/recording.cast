[396.440936, "o", "def fit_window(xs,ys,lo,hi,init=None):\r\n\u001b[?2004l\r"]
[396.440953, "o", "\u001b[?2004h> "]
[396.441014, "o", "    idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\r\n\u001b[?2004l\r"]
[396.441031, "o", "\u001b[?2004h> "]
[396.441094, "o", "    xw=[xs[i] for i in idx]; yw=[ys[i] for i in idx]\r\n\u001b[?2004l\r"]
[396.441121, "o", "\u001b[?2004h> "]
[396.44117, "o", "    mi=max(range(len(xw)), key=lambda i: yw[i])\r\n\u001b[?2004l\r"]
[396.441194, "o", "\u001b[?2004h> "]
[396.441225, "o", "    if init is None:\r\n\u001b[?2004l\r"]
[396.441254, "o", "\u001b[?2004h> "]
[396.441283, "o", "        b0=sorted(yw)[len(yw)//4]\r\n\u001b[?2004l\r"]
[396.441308, "o", "\u001b[?2004h> "]
[396.441334, "o", "        A0=max(1.0, yw[mi]-b0)\r\n\u001b[?2004l\r"]
[396.44136, "o", "\u001b[?2004h> "]
[396.441376, "o", "        x0=xw[mi]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[396.441399, "o", "        g0=15.0\r\n\u001b[?2004l\r"]
[396.441429, "o", "\u001b[?2004h> "]
[396.441458, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[396.441483, "o", "        A0,x0,g0,b0=init\r\n\u001b[?2004l\r\u001b[?2004h> "]
[396.44152, "o", "    p0=[A0,x0,g0,b0]\r\n\u001b[?2004l\r"]
[396.441541, "o", "\u001b[?2004h> "]
[396.441572, "o", "    p,err=lm_fit(xw,yw,p0)\r\n\u001b[?2004l\r"]
[396.44159, "o", "\u001b[?2004h> "]
[396.441622, "o", "    return p, err, (lo,hi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[396.441651, "o", "> \r\n\u001b[?2004l\r"]
[396.441675, "o", "\u001b[?2004h> "]
[396.441701, "o", "xs,ys=load('/app/spectrum.csv')\r\n\u001b[?2004l\r"]
[396.441737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[396.441788, "o", "# Explore D with several windows and inits\r\n\u001b[?2004l\r"]
[396.441811, "o", "\u001b[?2004h> "]
[396.441879, "o", "windows = [(1250,1450), (1300,1400), (1320,1380), (1280,1420)]\r\n\u001b[?2004l\r"]
[396.441904, "o", "\u001b[?2004h> "]
[396.441927, "o", "print('D explorations:')\r\n\u001b[?2004l\r"]
[396.441951, "o", "\u001b[?2004h> "]
[396.441979, "o", "for lo,hi in windows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[396.442032, "o", "    for g0 in [10,15,20,25,30]:\r\n\u001b[?2004l\r"]
[396.442058, "o", "\u001b[?2004h> "]
[396.442111, "o", "        idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\r\n\u001b[?2004l\r"]
[396.442136, "o", "\u001b[?2004h> "]
[396.442199, "o", "        xw=[xs[i] for i in idx]; yw=[ys[i] for i in idx]\r\n\u001b[?2004l\r"]
[396.442224, "o", "\u001b[?2004h> "]
[396.442276, "o", "        mi=max(range(len(xw)), key=lambda i: yw[i])\r\n\u001b[?2004l\r"]
[396.442307, "o", "\u001b[?2004h> "]
[396.442342, "o", "        b0=sorted(yw)[len(yw)//4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[396.442388, "o", "        A0=max(1.0, yw[mi]-b0)\r\n\u001b[?2004l\r"]
[396.442406, "o", "\u001b[?2004h> "]
[396.442479, "o", "        p,err=fit_window(xs,ys,lo,hi,init=(A0,xw[mi],g0,b0))\r\n\u001b[?2004l\r"]
[396.442499, "o", "\u001b[?2004h> "]
[396.442622, "o", "        print(f'  {lo}-{hi} g0={g0}: A={p[0]:.3f} x0={p[1]:.3f} g={p[2]:.3f} b={p[3]:.3f} sse={err:.3f}')\r\n\u001b[?2004l\r"]
[396.442636, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
