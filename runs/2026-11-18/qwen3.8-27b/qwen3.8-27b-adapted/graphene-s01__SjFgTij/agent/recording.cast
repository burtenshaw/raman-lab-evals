[396.435433, "i", "cat > /app/fit_v2.py <<'PY'\nimport csv, math\n\ndef load(path):\n    xs=[]; ys=[]\n    with open(path) as f:\n        r=csv.reader(f); next(r)\n        for row in r:\n            if len(row)>=2:\n                xs.append(float(row[0])); ys.append(float(row[1]))\n    return xs, ys\n\ndef lorentz(p,x):\n    A,x0,g,b=p\n    d=x-x0; den=d*d+g*g\n    return A*(g*g)/den + b\n\ndef sse(p,xw,yw):\n    s=0.0\n    for x,y in zip(xw,yw):\n        d=y-lorentz(p,x); s+=d*d\n    return s\n\ndef jac(p,x):\n    A,x0,g,b=p\n    d=x-x0; den=d*d+g*g; den2=den*den\n    lor=(g*g)/den\n    dA=lor\n    dx0=2.0*d*(g*g)/den2\n    dg=2.0*g*(d*d)/den2\n    db=1.0\n    return (dA,dx0,dg,db)\n\ndef solve4(N,c):\n    n=4\n    M=[list(N[i])+[c[i]] for i in range(n)]\n    for col in range(n):\n        pivot=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col])<1e-15:\n            return None\n        if pivot!=col:\n            M[col],M[pivot]=M[pivot],M[col]\n        pv=M[col][col]\n        for r in range(n):\n            if r==col: continue\n            fa"]
[396.435567, "i", "ctor=M[r][col]/pv\n            if factor==0.0: continue\n            for j in range(col,n+1):\n                M[r][j]-=factor*M[col][j]\n    out=[]\n    for i in range(n):\n        if abs(M[i][i])<1e-15: return None\n        out.append(M[i][n]/M[i][i])\n    return out\n\ndef lm_fit(xw,yw,p0,max_iter=100):\n    p=list(p0)\n    cur=sse(p,xw,yw)\n    lam=1e-3\n    for it in range(max_iter):\n        N=[[0.0]*4 for _ in range(4)]\n        c=[0.0]*4\n        for x,y in zip(xw,yw):\n            r=y-lorentz(p,x)\n            J=jac(p,x)\n            for i in range(4):\n                c[i]+=J[i]*r\n                for j in range(4):\n                    N[i][j]+=J[i]*J[j]\n        trace=sum(N[i][i] for i in range(4))/4.0\n        if trace<=0: break\n        accepted=False\n        for _ in range(30):\n            Nl=[row[:] for row in N]\n            for i in range(4): Nl[i][i]+=lam*trace\n            delta=solve4(Nl,c)\n            if delta is None:\n                lam*=10; continue\n            pn=[p[i]+delta[i] for i in range(4)]\n            if"]
[396.435616, "o", "cat > /app/fit_v2.py <<'PY'\r\n\u001b[?2004l\r"]
[396.435646, "i", " pn[2]<=1e-4:\n                lam*=10; continue\n            new=sse(pn,xw,yw)\n            if new < cur:\n                p=pn; cur=new; lam=max(lam*0.3,1e-12); accepted=True\n                if max(abs(d)/max(1.0,abs(p[i])) for i,d in enumerate(delta))<1e-10:\n                    break\n                break\n            else:\n                lam*=10\n                if lam>1e14: break\n        if not accepted: break\n    return p, cur\n\ndef fit_window(xs,ys,lo,hi,init=None):\n    idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\n    xw=[xs[i] for i in idx]; yw=[ys[i] for i in idx]\n    mi=max(range(len(xw)), key=lambda i: yw[i])\n    if init is None:\n        b0=sorted(yw)[len(yw)//4]\n        A0=max(1.0, yw[mi]-b0)\n        x0=xw[mi]\n        g0=15.0\n    else:\n        A0,x0,g0,b0=init\n    p0=[A0,x0,g0,b0]\n    p,err=lm_fit(xw,yw,p0)\n    return p, err, (lo,hi)\n\nxs,ys=load('/app/spectrum.csv')\n\n# Explore D with several windows and inits\nwindows = [(1250,1450), (1300,1400), (1320,1380), (1280,1420)]\nprint('D explorations:')\nfor lo"]
[396.435678, "o", "\u001b[?2004h> "]
[396.435709, "i", ",hi in windows:\n    for g0 in [10,15,20,25,30]:\n        idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\n        xw=[xs[i] for i in idx]; yw=[ys[i] for i in idx]\n        mi=max(range(len(xw)), key=lambda i: yw[i])\n        b0=sorted(yw)[len(yw)//4]\n        A0=max(1.0, yw[mi]-b0)\n        p,err=fit_window(xs,ys,lo,hi,init=(A0,xw[mi],g0,b0))\n        print(f'  {lo}-{hi} g0={g0}: A={p[0]:.3f} x0={p[1]:.3f} g={p[2]:.3f} b={p[3]:.3f} sse={err:.3f}')\n\n# Also check whether using the full range but only fitting local window changes G/2D\nprint('G explorations:')\nfor lo,hi in [(1480,1720),(1520,1650),(1500,1680)]:\n    idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\n    xw=[xs[i] for i in idx]; yw=[ys[i] for i in idx]\n    mi=max(range(len(xw)), key=lambda i: yw[i])\n    b0=sorted(yw)[len(yw)//4]\n    A0=max(1.0, yw[mi]-b0)\n    p,err=fit_window(xs,ys,lo,hi,init=(A0,xw[mi],10.0,b0))\n    print(f'  {lo}-{hi}: A={p[0]:.3f} x0={p[1]:.3f} g={p[2]:.3f} b={p[3]:.3f} sse={err:.3f}')\n\nprint('2D explorations:')\nfor lo,hi in [(2550,2850),(260"]
