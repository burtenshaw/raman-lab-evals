[273.88167, "i", "4):\n                    N[i][j] += vals[i] * vals[j]\n        trace=sum(N[i][i] for i in range(4)) / 4.0\n        if trace <= 0:\n            break\n        success=False\n        for _ in range(30):\n            Nl=[row[:] for row in N]\n            for i in range(4):\n                Nl[i][i] += lam * trace\n            delta=solve4(Nl, c)\n            if delta is None:\n                lam *= 10.0\n                continue\n            p_new=[p[i] + delta[i] for i in range(4)]\n            if p_new[2] <= 1e-4:\n                lam *= 10.0\n                continue\n            new=sse(p_new, xw, yw)\n            if new < cur:\n                p=p_new\n                cur=new\n                lam=max(lam * 0.3, 1e-12)\n                rel=max(abs(delta[i]) / max(1.0, abs(p[i])) for i in range(4))\n                success=True\n                if rel < 1e-10:\n                    break\n                break\n            else:\n                lam *= 10.0\n                if lam > 1e14:\n                    break\n        if not success:\n"]
