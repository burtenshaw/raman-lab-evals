[559.077577, "i", "cat > /app/fit_scipy.py <<'PY'\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm-1']\ny = data['intensity']\n\ndef fit_window(x, y, lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\n    return popt, pcov, m\n\ndef estimate_p0(x, y, lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    imax = np.argmax(yw)\n    x0 = xw[imax]\n    offset0 = np.median(yw)\n    A0 = yw[imax] - offset0\n    # estimate fwhm: half max\n    half = offset0 + 0.5*A0\n    above = yw >= half\n    idx = np.where(above)[0]\n    if len(idx) > 1:\n        fwhm = xw[idx[-1]] - xw[idx[0]]\n    else:\n        fwhm = 20.0\n    gamma0 = fwhm/2.0\n    return [A0, x0, gamma0, offset0]\n\n# Test stability of amplitude across windows for each peak\nfor n"]
[559.07772, "i", "ame, center, wins in [('D',1350,[(1250,1450),(1280,1420),(1300,1400),(1270,1430)]),\n                            ('G',1580,[(1480,1700),(1500,1680),(1520,1660),(1490,1690)]),\n                            ('2D',2690,[(2580,2800),(2600,2780),(2560,2820),(2590,2790)])]:\n    print(name, 'center', center)\n    for lo,hi in wins:\n        p0 = estimate_p0(x,y,lo,hi)\n        popt, pcov, _ = fit_window(x,y,lo,hi,p0)\n        perr = np.sqrt(np.diag(pcov))\n        print(f'  {lo}-{hi}: A={popt[0]:8.3f}±{perr[0]:7.3f} x0={popt[1]:8.3f} g={popt[2]:7.3f} off={popt[3]:8.3f}')\nPY\npython3 /app/fit_scipy.py\n"]
[559.077743, "o", "cat > /app/fit_scipy.py <<'PY'\r\n\u001b[?2004l\r"]
[559.077849, "o", "ame, center, wins in [('D',1350,[(1250,1450),(1280,1420),(1300,1400),(1270,1430)]),\r\n                            ('G',1580,[(1480,1700),(1500,1680),(1520,1660),(1490,1690)]),\r\n                            ('2D',2690,[(2580,2800),(2600,2780),(2560,2820),(2590,2790)])]:\r\n    print(name, 'center', center)\r\n    for lo,hi in wins:\r\n        p0 = estimate_p0(x,y,lo,hi)\r\n        popt, pcov, _ = fit_window(x,y,lo,hi,p0)\r\n        perr = np.sqrt(np.diag(pcov))\r\n        print(f'  {lo}-{hi}: A={popt[0]:8.3f}±{perr[0]:7.3f} x0={popt[1]:8.3f} g={po"]
[559.077922, "o", "pt[2]:7.3f} off={popt[3]:8.3f}')\r\nPY\r\npython3 /app/fit_scipy.py\r\n\u001b[?2004h"]
[559.07796, "o", "> import numpy as np\r\n\u001b[?2004l\r"]
[559.077998, "o", "\u001b[?2004h"]
[559.078027, "o", "> import json\r\n\u001b[?2004l\r"]
[559.07806, "o", "\u001b[?2004h> "]
[559.078098, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[559.078122, "o", "\u001b[?2004h> "]
[559.078178, "o", "def lorentz(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[559.078213, "o", "\u001b[?2004h> "]
[559.078297, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h"]
[559.078327, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.07841, "o", "data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r"]
[559.078435, "o", "\u001b[?2004h> "]
[559.078466, "o", "x = data['raman_shift_cm-1']\r\n\u001b[?2004l\r"]
[559.078501, "o", "\u001b[?2004h> "]
[559.07852, "o", "y = data['intensity']\r\n\u001b[?2004l\r"]
[559.078543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[559.078559, "o", "\u001b[?2004h> "]
[559.078598, "o", "def fit_window(x, y, lo, hi, p0):\r\n\u001b[?2004l\r"]
[559.078623, "o", "\u001b[?2004h> "]
[559.078655, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[559.078684, "o", "\u001b[?2004h> "]
[559.07871, "o", "    xw, yw = x[m], y[m]\r\n\u001b[?2004l\r"]
[559.078739, "o", "\u001b[?2004h> "]
[559.078815, "o", "    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\r\n\u001b[?2004l\r"]
[559.07884, "o", "\u001b[?2004h> "]
[559.078874, "o", "    return popt, pcov, m\r\n\u001b[?2004l\r"]
[559.0789, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[559.078925, "o", "\u001b[?2004h> "]
[559.078956, "o", "def estimate_p0(x, y, lo, hi):\r\n\u001b[?2004l\r"]
[559.078981, "o", "\u001b[?2004h> "]
[559.079016, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[559.079041, "o", "\u001b[?2004h> "]
[559.079076, "o", "    xw, yw = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h"]
[559.079105, "o", "> "]
[559.079135, "o", "    imax = np.argmax(yw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[559.079151, "o", "> "]
[559.079177, "o", "    x0 = xw[imax]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.079232, "o", "    offset0 = np.median(yw)\r\n\u001b[?2004l\r"]
[559.079267, "o", "\u001b[?2004h> "]
[559.0793, "o", "    A0 = yw[imax] - offset0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.079341, "o", "    # estimate fwhm: half max\r\n\u001b[?2004l\r"]
[559.079369, "o", "\u001b[?2004h> "]
[559.079402, "o", "    half = offset0 + 0.5*A0\r\n\u001b[?2004l\r"]
[559.079437, "o", "\u001b[?2004h> "]
[559.079471, "o", "    above = yw >= half\r\n\u001b[?2004l\r"]
[559.079494, "o", "\u001b[?2004h> "]
[559.079525, "o", "    idx = np.where(above)[0]\r\n\u001b[?2004l\r"]
[559.079548, "o", "\u001b[?2004h> "]
[559.079565, "o", "    if len(idx) > 1:\r\n\u001b[?2004l\r"]
[559.079596, "o", "\u001b[?2004h> "]
[559.079634, "o", "        fwhm = xw[idx[-1]] - xw[idx[0]]\r\n\u001b[?2004l\r"]
[559.079663, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[559.079688, "o", "\u001b[?2004h> "]
[559.079713, "o", "        fwhm = 20.0\r\n\u001b[?2004l\r"]
[559.079738, "o", "\u001b[?2004h> "]
[559.079759, "o", "    gamma0 = fwhm/2.0\r\n\u001b[?2004l\r"]
[559.079789, "o", "\u001b[?2004h> "]
[559.079834, "o", "    return [A0, x0, gamma0, offset0]\r\n\u001b[?2004l\r"]
[559.079863, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[559.079887, "o", "\u001b[?2004h> "]
[559.079937, "o", "# Test stability of amplitude across windows for each peak\r\n\u001b[?2004l\r"]
[559.079964, "o", "\u001b[?2004h> "]
[559.080059, "o", "for name, center, wins in [('D',1350,[(1250,1450),(1280,1420),(1300,1400),(1270,1430)]),\r\n\u001b[?2004l\r"]
[559.080092, "o", "\u001b[?2004h> "]
[559.080193, "o", "                            ('G',1580,[(1480,1700),(1500,1680),(1520,1660),(1490,1690)]),\r\n\u001b[?2004l\r"]
[559.080219, "o", "\u001b[?2004h> "]
[559.080315, "o", "                            ('2D',2690,[(2580,2800),(2600,2780),(2560,2820),(2590,2790)])]:\r\n\u001b[?2004l\r"]
[559.080335, "o", "\u001b[?2004h> "]
[559.080375, "o", "    print(name, 'center', center)\r\n\u001b[?2004l\r"]
[559.080396, "o", "\u001b[?2004h> "]
[559.080428, "o", "    for lo,hi in wins:\r\n\u001b[?2004l\r"]
[559.080444, "o", "\u001b[?2004h> "]
[559.080477, "o", "        p0 = estimate_p0(x,y,lo,hi)\r\n\u001b[?2004l\r"]
[559.080502, "o", "\u001b[?2004h> "]
[559.080561, "o", "        popt, pcov, _ = fit_window(x,y,lo,hi,p0)\r\n\u001b[?2004l\r"]
[559.080587, "o", "\u001b[?2004h> "]
[559.080629, "o", "        perr = np.sqrt(np.diag(pcov))\r\n\u001b[?2004l\r"]
[559.080644, "o", "\u001b[?2004h> "]
[559.080783, "o", "        print(f'  {lo}-{hi}: A={popt[0]:8.3f}±{perr[0]:7.3f} x0={popt[1]:8.3f} g={popt[2]:7.3f} off={popt[3]:8.3f}')\r\n\u001b[?2004l\r"]
[559.080812, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[559.082087, "o", "\u001b[?2004hroot@j-openenv-6afd8bf329e8b7ccfbbb82d9-bss1wmgf-876dc-th6jb:/app# "]
