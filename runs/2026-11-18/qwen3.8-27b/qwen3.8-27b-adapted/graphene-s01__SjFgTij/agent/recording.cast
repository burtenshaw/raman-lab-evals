[273.888546, "o", "\u001b[?2004h> "]
[273.888585, "o", "    return A * (g*g) / den + b\r\n\u001b[?2004l\r"]
[273.88862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.888656, "o", "\u001b[?2004h> "]
[273.888694, "o", "def sse(p, xw, yw):\r\n\u001b[?2004l\r"]
[273.888733, "o", "\u001b[?2004h> "]
[273.888772, "o", "    A,x0,g,b=p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.888812, "o", "    s=0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.888866, "o", "    for x,y in zip(xw,yw):\r\n\u001b[?2004l\r"]
[273.888881, "o", "\u001b[?2004h> "]
[273.888942, "o", "        d=x-x0\r\n\u001b[?2004l\r"]
[273.888978, "o", "\u001b[?2004h> "]
[273.888998, "o", "        den=d*d + g*g\r\n\u001b[?2004l\r"]
[273.889031, "o", "\u001b[?2004h> "]
[273.889084, "o", "        f=A * (g*g) / den + b\r\n\u001b[?2004l\r"]
[273.889111, "o", "\u001b[?2004h> "]
[273.889147, "o", "        diff=y-f\r\n\u001b[?2004l\r"]
[273.889187, "o", "\u001b[?2004h> "]
[273.889223, "o", "        s += diff*diff\r\n\u001b[?2004l\r"]
[273.889252, "o", "\u001b[?2004h> "]
[273.889295, "o", "    return s\r\n\u001b[?2004l\r"]
[273.889317, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.889346, "o", "\u001b[?2004h> "]
[273.889408, "o", "def fit_peak_full(xs, ys, lo, hi):\r\n\u001b[?2004l\r"]
[273.889435, "o", "\u001b[?2004h> "]
[273.889539, "o", "    idx=[i for i,x in enumerate(xs) if lo <= x <= hi]\r\n\u001b[?2004l\r"]
[273.889565, "o", "\u001b[?2004h> "]
[273.889619, "o", "    xw=[xs[i] for i in idx]\r\n\u001b[?2004l\r"]
[273.889644, "o", "\u001b[?2004h> "]
[273.889702, "o", "    yw=[ys[i] for i in idx]\r\n\u001b[?2004l\r"]
[273.889727, "o", "\u001b[?2004h> "]
[273.88976, "o", "    n=len(xw)\r\n\u001b[?2004l\r"]
[273.889799, "o", "\u001b[?2004h> "]
[273.889874, "o", "    max_i=max(range(n), key=lambda i: yw[i])\r\n\u001b[?2004l\r"]
[273.889893, "o", "\u001b[?2004h> "]
[273.889934, "o", "    x0=xw[max_i]\r\n\u001b[?2004l\r"]
[273.889968, "o", "\u001b[?2004h> "]
[273.890002, "o", "    ymax=yw[max_i]\r\n\u001b[?2004l\r"]
[273.890043, "o", "\u001b[?2004h> "]
[273.890076, "o", "    sorted_y=sorted(yw)\r\n\u001b[?2004l\r"]
[273.890109, "o", "\u001b[?2004h> "]
[273.890162, "o", "    b0=sorted_y[max(0, n//4)]\r\n\u001b[?2004l\r"]
[273.890199, "o", "\u001b[?2004h> "]
[273.890242, "o", "    A0=max(1.0, ymax - b0)\r\n\u001b[?2004l\r"]
[273.890265, "o", "\u001b[?2004h> "]
[273.890318, "o", "    half = b0 + 0.5 * A0\r\n\u001b[?2004l\r"]
[273.890343, "o", "\u001b[?2004h> "]
[273.890371, "o", "    l=max_i\r\n\u001b[?2004l\r"]
[273.890414, "o", "\u001b[?2004h> "]
[273.890466, "o", "    while l > 0 and yw[l] >= half:\r\n\u001b[?2004l\r"]
[273.890508, "o", "\u001b[?2004h> "]
[273.890537, "o", "        l -= 1\r\n\u001b[?2004l\r"]
[273.890573, "o", "\u001b[?2004h> "]
[273.890615, "o", "    r=max_i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.890676, "o", "    while r < n - 1 and yw[r] >= half:\r\n\u001b[?2004l\r"]
[273.890714, "o", "\u001b[?2004h> "]
[273.890751, "o", "        r += 1\r\n\u001b[?2004l\r"]
[273.890783, "o", "\u001b[?2004h> "]
[273.890837, "o", "    g0=max(1.0, (xw[r] - xw[l]) / 4.0)\r\n\u001b[?2004l\r"]
[273.89086, "o", "\u001b[?2004h> "]
[273.890911, "o", "    p=[A0, x0, g0, b0]\r\n\u001b[?2004l\r"]
[273.890928, "o", "\u001b[?2004h"]
[273.890963, "o", "> "]
[273.890993, "o", "    cur=sse(p, xw, yw)\r\n\u001b[?2004l\r"]
[273.891029, "o", "\u001b[?2004h> "]
[273.891073, "o", "    lam=1e-3\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.891109, "o", "> "]
[273.891154, "o", "    for it in range(200):\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.891184, "o", "> "]
[273.89123, "o", "        N=[[0.0]*4 for _ in range(4)]\r\n\u001b[?2004l\r"]
[273.891254, "o", "\u001b[?2004h> "]
[273.891294, "o", "        c=[0.0]*4\r\n\u001b[?2004l\r"]
[273.891326, "o", "\u001b[?2004h> "]
[273.891361, "o", "        A,x0,g,b=p\r\n\u001b[?2004l\r"]
[273.891385, "o", "\u001b[?2004h> "]
[273.891447, "o", "        for x,y in zip(xw,yw):\r\n\u001b[?2004l\r"]
[273.891482, "o", "\u001b[?2004h> "]
[273.891515, "o", "            d=x-x0\r\n\u001b[?2004l\r"]
[273.891555, "o", "\u001b[?2004h> "]
[273.891593, "o", "            den=d*d + g*g\r\n\u001b[?2004l\r"]
[273.891619, "o", "\u001b[?2004h> "]
[273.891666, "o", "            den2=den*den\r\n\u001b[?2004l\r"]
[273.891772, "o", "\u001b[?2004h>             lor=(g*g)/den\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.891824, "o", "            f=A*lor + b\r\n\u001b[?2004l\r"]
[273.89185, "o", "\u001b[?2004h> "]
[273.891888, "o", "            r=y-f\r\n\u001b[?2004l\r"]
[273.891912, "o", "\u001b[?2004h> "]
[273.891952, "o", "            dA=lor\r\n\u001b[?2004l\r"]
[273.891967, "o", "\u001b[?2004h> "]
[273.892054, "o", "            dx0=2.0*d*(g*g)/den2\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.892095, "o", "> "]
[273.892135, "o", "            dg=2.0*g*(d*d)/den2\r\n\u001b[?2004l\r"]
[273.89218, "o", "\u001b[?2004h> "]
[273.892225, "o", "            db=1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.892252, "o", "> "]
[273.892298, "o", "            vals=(dA, dx0, dg, db)\r\n\u001b[?2004l\r"]
[273.892346, "o", "\u001b[?2004h> "]
[273.89241, "o", "            for i in range(4):\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.892451, "o", "> "]
[273.892487, "o", "                c[i] += vals[i] * r\r\n\u001b[?2004l\r"]
[273.89253, "o", "\u001b[?2004h> "]
[273.892585, "o", "                for j in range(4):\r\n\u001b[?2004l\r"]
[273.892624, "o", "\u001b[?2004h"]
[273.892659, "o", "> "]
[273.89272, "o", "                    N[i][j] += vals[i] * vals[j]\r\n\u001b[?2004l\r"]
[273.892761, "o", "\u001b[?2004h> "]
[273.892869, "o", "        trace=sum(N[i][i] for i in range(4)) / 4.0\r\n\u001b[?2004l\r"]
[273.892932, "o", "\u001b[?2004h> "]
[273.892976, "o", "        if trace <= 0:\r\n\u001b[?2004l\r"]
[273.89302, "o", "\u001b[?2004h> "]
[273.893062, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.893101, "o", "        success=False\r\n\u001b[?2004l\r"]
[273.893143, "o", "\u001b[?2004h> "]
[273.893192, "o", "        for _ in range(30):\r\n\u001b[?2004l\r"]
[273.893234, "o", "\u001b[?2004h> "]
[273.893271, "o", "            Nl=[row[:] for row in N]\r\n\u001b[?2004l\r"]
[273.89329, "o", "\u001b[?2004h> "]
[273.893361, "o", "            for i in range(4):\r\n\u001b[?2004l\r"]
[273.893395, "o", "\u001b[?2004h> "]
[273.893465, "o", "                Nl[i][i] += lam * trace\r\n\u001b[?2004l\r"]
[273.893494, "o", "\u001b[?2004h> "]
[273.893554, "o", "            delta=solve4(Nl, c)\r\n\u001b[?2004l\r"]
[273.893587, "o", "\u001b[?2004h> "]
[273.89364, "o", "            if delta is None:\r\n\u001b[?2004l\r"]
[273.893681, "o", "\u001b[?2004h> "]
[273.893732, "o", "                lam *= 10.0\r\n\u001b[?2004l\r"]
[273.893765, "o", "\u001b[?2004h> "]
[273.893837, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.893933, "o", "            p_new=[p[i] + delta[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[273.893945, "o", "\u001b[?2004h> "]
[273.894025, "o", "            if p_new[2] <= 1e-4:\r\n\u001b[?2004l\r"]
[273.894057, "o", "\u001b[?2004h> "]
[273.894108, "o", "                lam *= 10.0\r\n\u001b[?2004l\r"]
[273.894138, "o", "\u001b[?2004h> "]
[273.894183, "o", "                continue\r\n\u001b[?2004l\r"]
[273.894213, "o", "\u001b[?2004h> "]
[273.894278, "o", "            new=sse(p_new, xw, yw)\r\n\u001b[?2004l\r"]
[273.89431, "o", "\u001b[?2004h> "]
[273.89436, "o", "            if new < cur:\r\n\u001b[?2004l\r"]
[273.894394, "o", "\u001b[?2004h> "]
[273.894434, "o", "                p=p_new\r\n\u001b[?2004l\r"]
[273.894464, "o", "\u001b[?2004h> "]
[273.894507, "o", "                cur=new\r\n\u001b[?2004l\r"]
[273.894543, "o", "\u001b[?2004h> "]
[273.894616, "o", "                lam=max(lam * 0.3, 1e-12)\r\n\u001b[?2004l\r"]
[273.894648, "o", "\u001b[?2004h> "]
[273.894794, "o", "                rel=max(abs(delta[i]) / max(1.0, abs(p[i])) for i in range(4))\r\n\u001b[?2004l\r"]
[273.894826, "o", "\u001b[?2004h> "]
[273.894878, "o", "                success=True\r\n\u001b[?2004l\r"]
[273.894908, "o", "\u001b[?2004h> "]
[273.894966, "o", "                if rel < 1e-10:\r\n\u001b[?2004l\r"]
[273.894998, "o", "\u001b[?2004h> "]
[273.895051, "o", "                    break\r\n\u001b[?2004l\r"]
[273.895082, "o", "\u001b[?2004h> "]
[273.895113, "o", "                break"]
[273.895147, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.89518, "o", "            else:\r\n\u001b[?2004l\r"]
[273.895221, "o", "\u001b[?2004h> "]
[273.895257, "o", "                lam *= 10.0\r\n\u001b[?2004l\r"]
[273.895287, "o", "\u001b[?2004h> "]
[273.895342, "o", "                if lam > 1e14:\r\n\u001b[?2004l\r"]
[273.895375, "o", "\u001b[?2004h> "]
[273.895419, "o", "                    break\r\n\u001b[?2004l\r"]
[273.895449, "o", "\u001b[?2004h> "]
[273.895492, "o", "        if not success:\r\n\u001b[?2004l\r"]
[273.895524, "o", "\u001b[?2004h> "]
[273.895554, "o", "            break\r\n\u001b[?2004l\r"]
[273.895585, "o", "\u001b[?2004h> "]
[273.895617, "o", "    A,x0,g,b=p\r\n\u001b[?2004l\r"]
[273.89565, "o", "\u001b[?2004h> "]
[273.895828, "o", "    return {'x0': float(x0), 'gamma': float(g), 'amplitude': float(A), 'offset': float(b)}, cur\r\n\u001b[?2004l\r"]
[273.895859, "o", "\u001b[?2004h> "]
[273.895892, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.895925, "o", "def main():\r\n\u001b[?2004l\r"]
[273.895956, "o", "\u001b[?2004h> "]
[273.896029, "o", "    xs,ys=load_data('/app/spectrum.csv')\r\n\u001b[?2004l\r"]
[273.89606, "o", "\u001b[?2004h> "]
[273.896101, "o", "    windows = {\r\n\u001b[?2004l\r"]
[273.896132, "o", "\u001b[?2004h> "]
[273.896171, "o", "        'D': (1180.0, 1460.0),\r\n\u001b[?2004l\r"]
[273.896201, "o", "\u001b[?2004h> "]
[273.896257, "o", "        'G': (1480.0, 1720.0),\r\n\u001b[?2004l\r"]
[273.89629, "o", "\u001b[?2004h> "]
[273.896346, "o", "        '2D': (2550.0, 2850.0),\r\n\u001b[?2004l\r"]
[273.896376, "o", "\u001b[?2004h> "]
[273.896408, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.896441, "o", "    res={}\r\n\u001b[?2004l\r"]
[273.896471, "o", "\u001b[?2004h> "]
[273.896547, "o", "    for name,(lo,hi) in windows.items():\r\n\u001b[?2004l\r"]
[273.896577, "o", "\u001b[?2004h> "]
[273.896676, "o", "        params, err = fit_peak_full(xs, ys, lo, hi)\r\n\u001b[?2004l\r"]
[273.896707, "o", "\u001b[?2004h> "]
[273.896755, "o", "        res[name]=params\r\n\u001b[?2004l\r"]
[273.896788, "o", "\u001b[?2004h> "]
[273.896861, "o", "        print(name, params, 'sse', err)\r\n\u001b[?2004l\r"]
[273.896888, "o", "\u001b[?2004h> "]
[273.897024, "o", "    res['ID_IG']=float(res['D']['amplitude'] / res['G']['amplitude'])\r\n\u001b[?2004l\r"]
[273.897055, "o", "\u001b[?2004h> "]
[273.897139, "o", "    with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r"]
[273.89717, "o", "\u001b[?2004h> "]
[273.897238, "o", "        json.dump(res, f, indent=2)\r\n\u001b[?2004l\r"]
[273.897271, "o", "\u001b[?2004h> "]
[273.897334, "o", "    print('ID_IG', res['ID_IG'])\r\n\u001b[?2004l\r"]
[273.897367, "o", "\u001b[?2004h> "]
[273.897399, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.897447, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[273.897478, "o", "\u001b[?2004h> "]
[273.897507, "o", "    main()\r\n\u001b[?2004l\r"]
