[345.244017, "i", "python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2:\n            xs.append(float(row[0])); ys.append(float(row[1]))\ndef model(p, x):\n    A,x0,g,b=p\n    d=x-x0; den=d*d+g*g\n    return A*(g*g)/den + b\ndef sse(p, xw, yw):\n    s=0.0\n    for x,y in zip(xw,yw):\n        f=model(p,x); d=y-f; s+=d*d\n    return s\n# simple grid/scan for D around max\nmax_i=max(range(len(xs)), key=lambda i: ys[i]) if False else None\nfor lo,hi in [(1250,1450),(1300,1400),(1320,1380),(1330,1370),(1340,1360)]:\n    idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\n    xw=[xs[i] for i in idx]; yw=[ys[i] for i in idx]\n    mi=max(range(len(xw)), key=lambda i: yw[i])\n    # baseline estimate from quartile\n    sy=sorted(yw); b0=sy[len(sy)//4]\n    A0=max(1, yw[mi]-b0)\n    print('window',lo,hi,'n',len(xw),'max',xw[mi],yw[mi],'b0',b0)\n    # try a few x0 around max, g 5-30, A from 100-800, b 1000-1500\n    best=None\n    for x0 in [xw[mi]-5, xw[mi], xw[mi]+5"]
[345.244134, "i", "]:\n        for g in [5,10,15,20,25,30]:\n            for A in [200,300,400,500,600]:\n                for b in [1100,1200,1300,1400,1500]:\n                    p=[A,x0,g,b]; s=sse(p,xw,yw)\n                    if best is None or s<best[0]: best=(s,p)\n    print('  grid best', best[0], best[1])\nPY\n"]
