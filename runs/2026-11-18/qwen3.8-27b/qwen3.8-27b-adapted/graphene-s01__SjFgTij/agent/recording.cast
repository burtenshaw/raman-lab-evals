[97.509937, "i", "python3 - <<'PY'\nimport csv, statistics\nxs=[]; ys=[]\nwith open('spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        if len(row)>=2:\n            xs.append(float(row[0])); ys.append(float(row[1]))\nfor label, lo, hi in [('D',1200,1500),('G',1450,1750),('2D',2550,2850)]:\n    idx=[i for i,x in enumerate(xs) if lo<=x<=hi]\n    if idx:\n        mi=max(idx, key=lambda i: ys[i])\n        base=min(ys[i] for i in idx)\n        # maybe baseline at edges\n        edge_idx=idx[:20]+idx[-20:]\n        print(label, 'max_x', xs[mi], 'max_y', ys[mi], 'base_min', base, 'edge_mean', statistics.mean(ys[i] for i in edge_idx))\n        # approximate FWHM: half max above edge\n        base=statistics.mean(ys[i] for i in edge_idx)\n        half=base + (ys[mi]-base)/2\n        left=mi\n        while left>0 and xs[left]>=lo and ys[left]>=half: left-=1\n        right=mi\n        while right<len(xs)-1 and xs[right]<=hi and ys[right]>=half: right+=1\n        print('  approx_fwhm', xs[right]-xs[left])\nPY\n"]
