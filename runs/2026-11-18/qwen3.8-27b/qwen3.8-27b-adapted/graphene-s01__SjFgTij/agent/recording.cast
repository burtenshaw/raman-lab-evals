[670.909904, "i", "cat > /app/fit_final.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:,0]; y = data[:,1]\n\ndef fit_window(lo, hi):\n    m = (x>=lo)&(x<=hi)\n    xw,yw = x[m], y[m]\n    imax = int(np.argmax(yw))\n    offset0 = float(np.median(yw))\n    A0 = max(10.0, yw[imax]-offset0)\n    half = offset0 + 0.5*A0\n    above = np.where(yw>=half)[0]\n    fwhm = (xw[above[-1]]-xw[above[0]]) if len(above)>1 else 20.0\n    p0=[A0, xw[imax], max(1.0,fwhm/2.0), offset0]\n    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=50000)\n    res = yw - lorentz(xw, *popt)\n    return popt, np.sqrt(np.diag(pcov)), float(np.std(res))\n\nwindows = {'D':(1300,1400), 'G':(1530,1630), '2D':(2640,2740)}\nout={}\nfor name,(lo,hi) in windows.items():\n    popt, perr, rms = fit_window(lo,hi)\n    A,x0,g,b = popt\n    out[name] = {'x0':float(x0),'gamma':f"]
[670.910053, "i", "loat(g),'amplitude':float(A),'offset':float(b)}\n    print(f'{name}: A={A:.4f}±{perr[0]:.3f} x0={x0:.4f}±{perr[1]:.4f} g={g:.4f}±{perr[2]:.4f} off={b:.4f}±{perr[3]:.3f} rms_resid={rms:.2f}')\nout['ID_IG'] = out['D']['amplitude']/out['G']['amplitude']\nprint('ID_IG', out['ID_IG'])\nPY\npython3 /app/fit_final.py\n"]
