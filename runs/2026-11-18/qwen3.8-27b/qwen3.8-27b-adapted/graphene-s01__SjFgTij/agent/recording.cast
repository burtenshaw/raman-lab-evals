[273.881802, "i", "            break\n    A,x0,g,b=p\n    return {'x0': float(x0), 'gamma': float(g), 'amplitude': float(A), 'offset': float(b)}, cur\n\ndef main():\n    xs,ys=load_data('/app/spectrum.csv')\n    windows = {\n        'D': (1180.0, 1460.0),\n        'G': (1480.0, 1720.0),\n        '2D': (2550.0, 2850.0),\n    }\n    res={}\n    for name,(lo,hi) in windows.items():\n        params, err = fit_peak_full(xs, ys, lo, hi)\n        res[name]=params\n        print(name, params, 'sse', err)\n    res['ID_IG']=float(res['D']['amplitude'] / res['G']['amplitude'])\n    with open('/app/results.json','w') as f:\n        json.dump(res, f, indent=2)\n    print('ID_IG', res['ID_IG'])\n\nif __name__ == '__main__':\n    main()\nPY\n"]
