[273.886462, "o", "\u001b[?2004h> "]
[273.88657, "o", "    idx=[i for i,x in enumerate(xs) if lo <= x <= hi]\r\n\u001b[?2004l\r"]
[273.886608, "o", "\u001b[?2004h> "]
[273.886652, "o", "    xw=[xs[i] for i in idx]\r\n\u001b[?2004l\r"]
[273.88669, "o", "\u001b[?2004h> "]
[273.886734, "o", "    yw=[ys[i] for i in idx]\r\n\u001b[?2004l\r"]
[273.886772, "o", "\u001b[?2004h> "]
[273.886816, "o", "    n=len(xw)\r\n\u001b[?2004l\r"]
[273.88686, "o", "\u001b[?2004h> "]
[273.88691, "o", "    max_i=max(range(n), key=lambda i: yw[i])\r\n\u001b[?2004l\r"]
[273.886947, "o", "\u001b[?2004h> "]
[273.886988, "o", "    x0=xw[max_i]\r\n\u001b[?2004l\r"]
[273.887033, "o", "\u001b[?2004h> "]
[273.887078, "o", "    ymax=yw[max_i]\r\n\u001b[?2004l\r"]
[273.887106, "o", "\u001b[?2004h> "]
[273.887147, "o", "    sorted_y=sorted(yw)\r\n\u001b[?2004l\r"]
[273.887198, "o", "\u001b[?2004h> "]
[273.887236, "o", "    b0=sorted_y[max(0, n//4)]\r\n\u001b[?2004l\r"]
[273.887283, "o", "\u001b[?2004h> "]
[273.887325, "o", "    if b0 <= 0:\r\n\u001b[?2004l\r"]
[273.887367, "o", "\u001b[?2004h> "]
[273.887412, "o", "        b0 = max(1.0, min(yw))\r\n\u001b[?2004l\r"]
[273.887455, "o", "\u001b[?2004h> "]
[273.8875, "o", "    A0=max(1.0, ymax - b0)\r\n\u001b[?2004l\r"]
[273.88754, "o", "\u001b[?2004h> "]
[273.88756, "o", "    half = b0 + 0.5 * A0\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.887599, "o", ">     l=max_i\r\n\u001b[?2004l\r"]
[273.88764, "o", "\u001b[?2004h"]
[273.887691, "o", "> "]
[273.88772, "o", "    while l > 0 and yw[l] >= half:\r\n\u001b[?2004l\r"]
[273.887761, "o", "\u001b[?2004h> "]
[273.887804, "o", "        l -= 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.887849, "o", ">     r=max_i\r\n\u001b[?2004l\r"]
[273.88792, "o", "\u001b[?2004h> "]
[273.887968, "o", "    while r < n - 1 and yw[r] >= half:\r\n\u001b[?2004l\r"]
[273.887996, "o", "\u001b[?2004h> "]
[273.888031, "o", "        r += 1\r\n\u001b[?2004l\r"]
[273.888066, "o", "\u001b[?2004h> "]
[273.888135, "o", "    g0=max(1.0, (xw[r] - xw[l]) / 4.0)\r\n\u001b[?2004l\r"]
[273.888189, "o", "\u001b[?2004h> "]
[273.888226, "o", "    p=[A0, x0, g0, b0]\r\n\u001b[?2004l\r"]
