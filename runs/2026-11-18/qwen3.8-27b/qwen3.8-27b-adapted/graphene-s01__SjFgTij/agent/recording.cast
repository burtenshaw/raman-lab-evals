[273.883745, "o", "    n=4\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.883787, "o", "> "]
[273.883878, "o", "    M=[list(N[i]) + [c[i]] for i in range(n)]\r\n\u001b[?2004l\r"]
[273.883908, "o", "\u001b[?2004h> "]
[273.884003, "o", "    for col in range(n):\r\n\u001b[?2004l\r"]
[273.884043, "o", "\u001b[?2004h> "]
[273.884372, "o", "        pivot=max(range(col,n), key=lambda r: abs(M[r][col]))\r\n\u001b[?2004l\r"]
[273.884425, "o", "\u001b[?2004h> "]
[273.884616, "o", "        if abs(M[pivot][col]) < 1e-14:\r\n\u001b[?2004l\r"]
[273.884656, "o", "\u001b[?2004h"]
[273.884691, "o", "> "]
[273.88473, "o", "            return None\r\n\u001b[?2004l\r"]
[273.88477, "o", "\u001b[?2004h> "]
[273.884843, "o", "        if pivot != col:\r\n\u001b[?2004l\r"]
[273.884874, "o", "\u001b[?2004h> "]
[273.885067, "o", "            M[col], M[pivot] = M[pivot], M[col]\r\n\u001b[?2004l\r"]
[273.885082, "o", "\u001b[?2004h> "]
[273.885144, "o", "        pv = M[col][col]\r\n\u001b[?2004l\r"]
[273.88517, "o", "\u001b[?2004h> "]
