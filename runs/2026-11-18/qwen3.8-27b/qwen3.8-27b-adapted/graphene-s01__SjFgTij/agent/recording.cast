[273.881079, "i", "cat > /app/fit_peaks.py <<'PY'\nimport csv, json, math\n\ndef load_data(path):\n    xs=[]; ys=[]\n    with open(path, newline='') as f:\n        r=csv.reader(f)\n        next(r)\n        for row in r:\n            if len(row) >= 2:\n                try:\n                    xs.append(float(row[0]))\n                    ys.append(float(row[1]))\n                except Exception:\n                    pass\n    return xs, ys\n\ndef solve4(N, c):\n    n=4\n    M=[list(N[i]) + [c[i]] for i in range(n)]\n    for col in range(n):\n        pivot=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col]) < 1e-14:\n            return None\n        if pivot != col:\n            M[col], M[pivot] = M[pivot], M[col]\n        pv = M[col][col]\n        for r in range(n):\n            if r == col:\n                continue\n            factor = M[r][col] / pv\n            if factor == 0.0:\n                continue\n            for j in range(col, n+1):\n                M[r][j] -= factor * M[col][j]\n    out=[]\n    for i in range(n):\n      "]
[273.881247, "i", "  if abs(M[i][i]) < 1e-14:\n            return None\n        out.append(M[i][n] / M[i][i])\n    return out\n\ndef fit_peak(xs, ys, lo, hi):\n    idx=[i for i,x in enumerate(xs) if lo <= x <= hi]\n    xw=[xs[i] for i in idx]\n    yw=[ys[i] for i in idx]\n    n=len(xw)\n    max_i=max(range(n), key=lambda i: yw[i])\n    x0=xw[max_i]\n    ymax=yw[max_i]\n    sorted_y=sorted(yw)\n    b0=sorted_y[max(0, n//4)]\n    if b0 <= 0:\n        b0 = max(1.0, min(yw))\n    A0=max(1.0, ymax - b0)\n    half = b0 + 0.5 * A0\n    l=max_i\n    while l > 0 and yw[l] >= half:\n        l -= 1\n    r=max_i\n    while r < n - 1 and yw[r] >= half:\n        r += 1\n    g0=max(1.0, (xw[r] - xw[l]) / 4.0)\n    p=[A0, x0, g0, b0]\n\ndef model(p, x):\n    A,x0,g,b=p\n    d=x-x0\n    den=d*d + g*g\n    return A * (g*g) / den + b\n\ndef sse(p, xw, yw):\n    A,x0,g,b=p\n    s=0.0\n    for x,y in zip(xw,yw):\n        d=x-x0\n        den=d*d + g*g\n        f=A * (g*g) / den + b\n        diff=y-f\n        s += diff*diff\n    return s\n\ndef fit_peak_full(xs, ys, lo, hi):\n    idx=[i for i,x "]
