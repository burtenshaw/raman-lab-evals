[273.882423, "o", "\u001b[?2004h> "]
[273.882517, "o", "            if len(row) >= 2:\r\n\u001b[?2004l\r"]
[273.882548, "o", "\u001b[?2004h> "]
[273.882627, "o", "                try:\r\n\u001b[?2004l\r"]
[273.882657, "o", "\u001b[?2004h> "]
