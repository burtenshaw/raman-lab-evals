[273.885952, "o", "\u001b[?2004h> "]
[273.885988, "o", "    for i in range(n):\r\n\u001b[?2004l\r"]
[273.886033, "o", "\u001b[?2004h> "]
[273.88608, "o", "        if abs(M[i][i]) < 1e-14:\r\n\u001b[?2004l\r"]
[273.886117, "o", "\u001b[?2004h"]
[273.886156, "o", "> "]
[273.886202, "o", "            return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.886262, "o", "        out.append(M[i][n] / M[i][i])\r\n\u001b[?2004l\r"]
