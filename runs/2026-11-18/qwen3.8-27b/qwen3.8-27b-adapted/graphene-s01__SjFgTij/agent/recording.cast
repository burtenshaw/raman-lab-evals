[670.910926, "o", "\u001b[?2004h> "]
[670.910945, "o", "    offset0 = float(np.median(yw))\r\n\u001b[?2004l\r"]
[670.910969, "o", "\u001b[?2004h> "]
[670.911029, "o", "    A0 = max(10.0, yw[imax]-offset0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[670.911079, "o", "    half = offset0 + 0.5*A0\r\n\u001b[?2004l\r"]
[670.911175, "o", "\u001b[?2004h> "]
