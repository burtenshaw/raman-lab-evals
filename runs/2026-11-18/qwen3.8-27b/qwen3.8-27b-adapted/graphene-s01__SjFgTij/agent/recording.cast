[273.885353, "o", "> "]
[273.885384, "o", "                continue\r\n\u001b[?2004l\r"]
[273.885428, "o", "\u001b[?2004h> "]
[273.885481, "o", "            factor = M[r][col] / pv\r\n\u001b[?2004l\r"]
[273.885517, "o", "\u001b[?2004h> "]
[273.88557, "o", "            if factor == 0.0:\r\n\u001b[?2004l\r"]
[273.885611, "o", "\u001b[?2004h> "]
[273.885649, "o", "                continue\r\n\u001b[?2004l\r"]
[273.885693, "o", "\u001b[?2004h> "]
