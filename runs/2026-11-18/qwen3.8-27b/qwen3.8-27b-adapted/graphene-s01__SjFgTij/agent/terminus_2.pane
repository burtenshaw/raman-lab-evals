def fit_peak(xs, ys, lo, hi):
    idx=[i for i,x in enumerate(xs) if lo <= x <= hi]
    xw=[xs[i] for i in idx]
    yw=[ys[i] for i in idx]
    n=len(xw)
    max_i=max(range(n), key=lambda i: yw[i])
    x0=xw[max_i]
    ymax=yw[max_i]
    sorted_y=sorted(yw)
    b0=sorted_y[max(0, n//4)]
    if b0 <= 0:
        b0 = max(1.0, min(yw))
    A0=max(1.0, ymax - b0)
    half = b0 + 0.5 * A0
    l=max_i
    while l > 0 and yw[l] >= half:
        l -= 1
    r=max_i
    while r < n - 1 and yw[r] >= half:
        r += 1
    g0=max(1.0, (xw[r] - xw[l]) / 4.0)
    p=[A0, x0, g0, b0]

def model(p, x):
    A,x0,g,b=p
    d=x-x0
    den=d*d + g*g
    return A * (g*g) / den + b

def sse(p, xw, yw):
    A,x0,g,b=p
    s=0.0
    for x,y in zip(xw,yw):
        d=x-x0
        den=d*d + g*g
        f=A * (g*g) / den + b
        diff=y-f
        s += diff*diff
    return s

def fit_peak_full(xs, ys, lo, hi):
