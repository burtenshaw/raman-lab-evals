[?2004l[?2004h> def jac(p,x):
[?2004l[?2004h>     A,x0,g,b=p
[?2004l[?2004h>     d=x-x0; den=d*d+g*g; den2=den*den
[?2004l[?2004h>     lor=(g*g)/den
[?2004l[?2004h>     dA=lor
[?2004l[?2004h>     dx0=2.0*d*(g*g)/den2
[?2004l[?2004h>     dg=2.0*g*(d*d)/den2
[?2004l[?2004h>     db=1.0
[?2004l[?2004h>     return (dA,dx0,dg,db)
