[?2004l[?2004h> def solve4(N,c):
[?2004l[?2004h>     n=4
[?2004l[?2004h>     M=[list(N[i])+[c[i]] for i in range(n)]
[?2004l[?2004h>     for col in range(n):
[?2004l[?2004h>         pivot=max(range(col,n), key=lambda r: abs(M[r][col]))
[?2004l[?2004h>         if abs(M[pivot][col])<1e-15:
[?2004l[?2004h>             return None
[?2004l[?2004h>         if pivot!=col:
[?2004l[?2004h>             M[col],M[pivot]=M[pivot],M[col]
[?2004l[?2004h>         pv=M[col][col]
[?2004l[?2004h>         for r in range(n):
[?2004l[?2004h>             if r==col: continue
[?2004l[?2004h>             factor=M[r][col]/pv
[?2004l[?2004h>             if factor==0.0: continue
[?2004l[?2004h>             for j in range(col,n+1):
[?2004l[?2004h>                 M[r][j]-=factor*M[col][j]
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for i in range(n):
[?2004l[?2004h>         if abs(M[i][i])<1e-15: return None
[?2004l[?2004h>         out.append(M[i][n]/M[i][i])
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def lm_fit(xw,yw,p0,max_iter=100):
[?2004l[?2004h>     p=list(p0)
[?2004l[?2004h>     cur=sse(p,xw,yw)
[?2004l[?2004h>     lam=1e-3
[?2004l[?2004h>     for it in range(max_iter):
[?2004l[?2004h>         N=[[0.0]*4 for _ in range(4)]
[?2004l[?2004h>         c=[0.0]*4
[?2004l[?2004h>         for x,y in zip(xw,yw):
[?2004l[?2004h>             r=y-lorentz(p,x)
[?2004l[?2004h>             J=jac(p,x)
[?2004l[?2004h>             for i in range(4):
[?2004l[?2004h>                 c[i]+=J[i]*r
[?2004l[?2004h>                 for j in range(4):
[?2004l[?2004h>                     N[i][j]+=J[i]*J[j]
[?2004l[?2004h>         trace=sum(N[i][i] for i in range(4))/4.0
[?2004l[?2004h>         if trace<=0: break
[?2004l[?2004h>         accepted=False
[?2004l[?2004h>         for _ in range(30):
[?2004l[?2004h>             Nl=[row[:] for row in N]
[?2004l[?2004h>             for i in range(4): Nl[i][i]+=lam*trace
[?2004l[?2004h>             delta=solve4(Nl,c)
[?2004l[?2004h>             if delta is None:
[?2004l[?2004h>                 lam*=10; continue
[?2004l[?2004h>             pn=[p[i]+delta[i] for i in range(4)]
[?2004l[?2004h>             if pn[2]<=1e-4:
[?2004l[?2004h>                 lam*=10; continue
[?2004l[?2004h>             new=sse(pn,xw,yw)
[?2004l[?2004h>             if new < cur:
[?2004l[?2004h>                 p=pn; cur=new; lam=max(lam*0.3,1e-12); accepted=True
[?2004l[?2004h>                 if max(abs(d)/max(1.0,abs(p[i])) for i,d in enumerate(delta))<1e-10:
[?2004l[?2004h>                     break
[?2004l[?2004h>                 break
[?2004l[?2004h>             else:
[?2004l[?2004h>                 lam*=10
[?2004l[?2004h>                 if lam>1e14: break
[?2004l[?2004h>         if not accepted: break
[?2004l[?2004h>     return p, cur
[?2004l[?2004h> 
[?2004l[?2004h> def fit_window(xs,ys,lo,hi,init=None):
