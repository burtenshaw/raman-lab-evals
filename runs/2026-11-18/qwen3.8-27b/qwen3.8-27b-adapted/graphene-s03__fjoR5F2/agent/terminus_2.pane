[?2004hroot@j-openenv-6afd8a8ae5cad0e4dc3e6b86-fowvzwn0-4ad56-5hczf:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> x, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {'D': 1350, 'G': 1580, '2D': 2690}
[?2004l[?2004h> win = 100.0
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     m = (x >= center - win) & (x <= center + win)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     # initial guesses
[?2004l[?2004h>     offset0 = np.percentile(ys, 10)
[?2004l[?2004h>     i_max = np.argmax(ys)
[?2004l[?2004h>     x0_0 = xs[i_max]
[?2004l[?2004h>     amp0 = ys[i_max] - offset0
[?2004l[?2004h>     gamma0 = 20.0
[?2004l[?2004h>     p0 = [amp0, x0_0, gamma0, offset0]
[?2004l[?2004h>     bounds = ([0, center - 60, 1, -np.inf], [np.inf, center + 60, 100, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     amp, x0, gamma, offset = popt
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(gamma),
[?2004l[?2004h>                      'amplitude': float(amp), 'offset': float(offset)}
[?2004l[?2004h>     print(f"{name}: x0={x0:.3f}+/-{perr[1]:.2f} gamma={gamma:.3f}+/-{perr[2]:.3f} "
[?2004l[?2004h>           f"amp={amp:.2f}+/-{perr[0]:.2f} offset={offset:.2f}+/-{perr[3]:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> id_ig = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> print(f"ID/IG = {id_ig:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> out = {k: results[k] for k in ['D', 'G', '2D']}
[?2004l[?2004h> out['ID_IG'] = float(id_ig)
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(out, f, indent=2)
