[121.634604, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nx, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\npeaks = {'D': 1350, 'G': 1580, '2D': 2690}\nwin = 100.0\nresults = {}\n\nfor name, center in peaks.items():\n    m = (x >= center - win) & (x <= center + win)\n    xs, ys = x[m], y[m]\n    # initial guesses\n    offset0 = np.percentile(ys, 10)\n    i_max = np.argmax(ys)\n    x0_0 = xs[i_max]\n    amp0 = ys[i_max] - offset0\n    gamma0 = 20.0\n    p0 = [amp0, x0_0, gamma0, offset0]\n    bounds = ([0, center - 60, 1, -np.inf], [np.inf, center + 60, 100, np.inf])\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    amp, x0, gamma, offset = popt\n    perr = np.sqrt(np.diag(pcov))\n    results[name] = {'x0': float(x0), 'gamma': float(gamma),\n                     'amplitude': float(amp), 'offset': float(offse"]
[121.634737, "i", "t)}\n    print(f\"{name}: x0={x0:.3f}+/-{perr[1]:.2f} gamma={gamma:.3f}+/-{perr[2]:.3f} \"\n          f\"amp={amp:.2f}+/-{perr[0]:.2f} offset={offset:.2f}+/-{perr[3]:.2f}\")\n\nid_ig = results['D']['amplitude'] / results['G']['amplitude']\nprint(f\"ID/IG = {id_ig:.4f}\")\n\nout = {k: results[k] for k in ['D', 'G', '2D']}\nout['ID_IG'] = float(id_ig)\nwith open('/app/results.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint('written /app/results.json')\nEOF\n"]
