[122.845942, "o", "\u001b[?2004hroot@j-openenv-6afd8a8ae5cad0e4dc3e6b86-fowvzwn0-4ad56-5hczf:/app# "]
[156.935189, "i", "cat > /app/check.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentzian(x, a, x0, g, o):\n    return a * g**2 / ((x - x0)**2 + g**2) + o\n\nx, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\nfor name, center in {'D':1350,'G':1580,'2D':2690}.items():\n    m = (x >= center-250) & (x <= center+250)\n    print(name, 'argmax in wide region:', x[m][np.argmax(y[m])])\n    for win in (50, 100, 150):\n        m = (x >= center-win) & (x <= center+win)\n        xs, ys = x[m], y[m]\n        p0 = [ys.max()-np.percentile(ys,10), xs[np.argmax(ys)], 20.0, np.percentile(ys,10)]\n        popt, _ = curve_fit(lorentzian, xs, ys, p0=p0,\n                            bounds=([0, center-80, 1, -np.inf],[np.inf, center+80, 150, np.inf]), maxfev=20000)\n        r = ys - lorentzian(xs, *popt)\n        ss_res = (r**2).sum(); ss_tot = ((ys-ys.mean())**2).sum()\n        print(f'  win={win:3d} x0={popt[1]:.2f} g={popt[2]:.2f} a={popt[0]:.1f} o={popt[3]:.1f} R2={1-ss_res/ss_tot:.5f}')\nEOF\npython3 "]
[156.936187, "i", "/app/check.py\n"]
