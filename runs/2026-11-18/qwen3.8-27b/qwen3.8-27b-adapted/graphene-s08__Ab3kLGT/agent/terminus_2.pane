[?2004hroot@j-openenv-6afd8fe5e5cad0e4dc3e6f5f-0nmv937d-91b92-gkrlw:/app# cat > fit.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = data[:,0]
[?2004l[?2004h> y = data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {'D':1351.1, 'G':1581.1, '2D':2684.4}
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, cx in peaks.items():
[?2004l[?2004h>     m = (x>cx-100)&(x<cx+100)
[?2004l[?2004h>     xi, yi = x[m], y[m]
[?2004l[?2004h>     off0 = np.percentile(yi,5)
[?2004l[?2004h>     amp0 = yi.max()-off0
[?2004l[?2004h>     x00 = xi[np.argmax(yi)]
[?2004l[?2004h>     # estimate HWHM
[?2004l[?2004h>     half = off0 + amp0/2
[?2004l[?2004h>     above = xi[yi>half]
[?2004l[?2004h>     gam0 = (above.max()-above.min())/2 if len(above)>1 else 20.0
[?2004l[?2004h>     p0 = [amp0, x00, gam0, off0]
[?2004l[?2004h>     popt, _ = curve_fit(lor, xi, yi, p0=p0, maxfev=20000)
[?2004l[?2004h>     amp, x0, gamma, off = popt
[?2004l[?2004h>     gamma = abs(gamma)
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(gamma),
[?2004l[?2004h>                      'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h>     print(f"{name}: x0={x0:.3f} gamma={gamma:.3f} amp={amp:.2f} off={off:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude']/results['G']['amplitude'])
[?2004l[?2004h> print("ID/IG =", results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('results.json','w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print("written results.json")
[?2004l[?2004h> EOF
