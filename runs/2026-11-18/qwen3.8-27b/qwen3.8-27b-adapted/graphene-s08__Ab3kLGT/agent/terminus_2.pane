[?2004hroot@j-openenv-6afd8fe5e5cad0e4dc3e6f5f-0nmv937d-91b92-gkrlw:/app# python3 -c "
[?2004l[?2004h> import numpy as np, json
[?2004l[?2004h> data=np.loadtxt('spectrum.csv',delimiter=',',skiprows=1)
[?2004l[?2004h> x,y=data[:,0],data[:,1]
[?2004l[?2004h> def lor(x,a,c,g,o): return a*g*g/((x-c)**2+g*g)+o
[?2004l[?2004h> r=json.load(open('results.json'))
[?2004l[?2004h> for n,c in [('D',1350),('G',1580),('2D',2690)]:
[?2004l[?2004h>     m=(x>c-100)&(x<c+100)
[?2004l[?2004h>     p=r[n]
[?2004l[?2004h>     pred=lor(x[m],p['amplitude'],p['x0'],p['gamma'],p['offset'])
[?2004l[?2004h>     ssr=np.sum((y[m]-pred)**2); sst=np.sum((y[m]-y[m].mean())**2)
[?2004l[?2004h>     print(n,'R2=%.5f'%(1-ssr/sst))
[?2004l[?2004h> print(json.dumps(r,indent=2))
