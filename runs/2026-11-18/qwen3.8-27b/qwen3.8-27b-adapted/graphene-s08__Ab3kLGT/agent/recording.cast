[82.168225, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx = data[:,0]\ny = data[:,1]\n\ndef lor(x, amp, x0, gamma, off):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\n\npeaks = {'D':1351.1, 'G':1581.1, '2D':2684.4}\nresults = {}\nfor name, cx in peaks.items():\n    m = (x>cx-100)&(x<cx+100)\n    xi, yi = x[m], y[m]\n    off0 = np.percentile(yi,5)\n    amp0 = yi.max()-off0\n    x00 = xi[np.argmax(yi)]\n    # estimate HWHM\n    half = off0 + amp0/2\n    above = xi[yi>half]\n    gam0 = (above.max()-above.min())/2 if len(above)>1 else 20.0\n    p0 = [amp0, x00, gam0, off0]\n    popt, _ = curve_fit(lor, xi, yi, p0=p0, maxfev=20000)\n    amp, x0, gamma, off = popt\n    gamma = abs(gamma)\n    results[name] = {'x0': float(x0), 'gamma': float(gamma),\n                     'amplitude': float(amp), 'offset': float(off)}\n    print(f\"{name}: x0={x0:.3f} gamma={gamma:.3f} amp={amp:.2f} off={off:.2f}\")\n\nresults['ID_IG'] = float(results["]
[82.168352, "i", "'D']['amplitude']/results['G']['amplitude'])\nprint(\"ID/IG =\", results['ID_IG'])\n\nwith open('results.json','w') as f:\n    json.dump(results, f, indent=2)\nprint(\"written results.json\")\nEOF\npython3 fit.py\n"]
