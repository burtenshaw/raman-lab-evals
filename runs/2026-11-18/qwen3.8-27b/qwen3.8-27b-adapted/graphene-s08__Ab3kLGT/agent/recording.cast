[100.101486, "o", "\u001b[?2004h> "]
[100.101549, "o", "    pred=lor(x[m],p['amplitude'],p['x0'],p['gamma'],p['offset'])\r\n\u001b[?2004l\r"]
[100.101558, "o", "\u001b[?2004h> "]
[100.101651, "o", "    ssr=np.sum((y[m]-pred)**2); sst=np.sum((y[m]-y[m].mean())**2)\r\n\u001b[?2004l\r"]
[100.101676, "o", "\u001b[?2004h> "]
[100.101723, "o", "    print(n,'R2=%.5f'%(1-ssr/sst))\r\n\u001b[?2004l\r"]
