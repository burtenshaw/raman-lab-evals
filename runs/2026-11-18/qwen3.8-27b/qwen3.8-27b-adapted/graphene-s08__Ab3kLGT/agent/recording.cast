[61.185148, "i", "cat > explore.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx = data[:,0]\ny = data[:,1]\nprint(\"x range:\", x.min(), x.max(), \"n:\", len(x))\nprint(\"baseline (median):\", np.median(y))\nfor name, cx in [('D',1350),('G',1580),('2D',2690)]:\n    m = (x>cx-150)&(x<cx+150)\n    xi, yi = x[m], y[m]\n    imax = np.argmax(yi)\n    print(f\"{name}: peak at x={xi[imax]:.1f}, y={yi[imax]:.1f}, base~{np.percentile(yi,5):.1f}\")\nEOF\npython3 explore.py\n"]
