[100.100791, "i", "python3 -c \"\nimport numpy as np, json\ndata=np.loadtxt('spectrum.csv',delimiter=',',skiprows=1)\nx,y=data[:,0],data[:,1]\ndef lor(x,a,c,g,o): return a*g*g/((x-c)**2+g*g)+o\nr=json.load(open('results.json'))\nfor n,c in [('D',1350),('G',1580),('2D',2690)]:\n    m=(x>c-100)&(x<c+100)\n    p=r[n]\n    pred=lor(x[m],p['amplitude'],p['x0'],p['gamma'],p['offset'])\n    ssr=np.sum((y[m]-pred)**2); sst=np.sum((y[m]-y[m].mean())**2)\n    print(n,'R2=%.5f'%(1-ssr/sst))\nprint(json.dumps(r,indent=2))\n\"\n"]
[100.100929, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
