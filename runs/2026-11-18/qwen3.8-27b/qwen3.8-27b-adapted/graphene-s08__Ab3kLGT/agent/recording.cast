[100.101298, "o", "\u001b[?2004h> "]
[100.101354, "o", "for n,c in [('D',1350),('G',1580),('2D',2690)]:\r\n\u001b[?2004l\r"]
[100.101385, "o", "\u001b[?2004h> "]
