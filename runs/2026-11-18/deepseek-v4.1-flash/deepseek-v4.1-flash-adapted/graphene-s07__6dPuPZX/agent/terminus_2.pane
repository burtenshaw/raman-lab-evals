[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = data[data.dtype.names[0]].astype(float)
[?2004l[?2004h> y = data['intensity'].astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> windows = {'D': (1250, 1450), 'G': (1500, 1700), '2D': (2550, 2850)}
[?2004l[?2004h> for name, (lo, hi) in windows.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     imax = np.argmax(yw)
[?2004l[?2004h>     x0_guess = xw[imax]
[?2004l[?2004h>     baseline_guess = 0.5*(yw[0] + yw[-1])
[?2004l[?2004h>     amp_guess = yw[imax] - baseline_guess
[?2004l[?2004h>     # estimate HWHM from points above half maximum
[?2004l[?2004h>     half = baseline_guess + 0.5*amp_guess
[?2004l[?2004h>     idx = np.where(yw >= half)[0]
[?2004l[?2004h>     if len(idx) >= 2:
[?2004l[?2004h>         gamma_guess = 0.5*(xw[idx[-1]] - xw[idx[0]])
[?2004l[?2004h>     else:
[?2004l[?2004h>         gamma_guess = 15.0
[?2004l[?2004h>     p0 = [amp_guess, x0_guess, max(gamma_guess, 1.0), baseline_guess]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)
[?2004l[?2004h>     yfit = lorentz(xw, *popt)
[?2004l[?2004h>     rmse = np.sqrt(np.mean((yw-yfit)**2))
