[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi) in windows.items():
[?2004l[?2004h>     mask = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw = x[mask]
[?2004l[?2004h>     yw = y[mask]
[?2004l[?2004h>     imax = int(np.argmax(yw))
[?2004l[?2004h>     x0_guess = float(xw[imax])
[?2004l[?2004h>     off_guess = float(0.5 * (yw[0] + yw[-1]))
[?2004l[?2004h>     amp_guess = float(yw[imax] - off_guess)
[?2004l[?2004h>     half = off_guess + 0.5 * amp_guess
[?2004l[?2004h>     idx = np.where(yw >= half)[0]
[?2004l[?2004h>     gamma_guess = 0.5 * (xw[idx[-1]] - xw[idx[0]]) if len(idx) >= 2 else 15.0
[?2004l[?2004h>     p0 = [max(amp_guess, 1.0), x0_guess, max(float(gamma_guess), 1.0), off_guess]
