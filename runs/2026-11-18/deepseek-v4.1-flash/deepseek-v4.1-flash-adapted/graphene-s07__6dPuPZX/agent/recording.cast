[33.905355, "i", "python3 - <<'PY'\nimport numpy as np, pandas as pd\ndf = pd.read_csv('/app/spectrum.csv')\nx = df['raman_shift_cm-1'].to_numpy()\ny = df['intensity'].to_numpy()\nprint('range', x.min(), x.max(), 'n', len(x))\nfor name, lo, hi in [('D', 1250, 1450), ('G', 1500, 1700), ('2D', 2550, 2850)]:\n    m = (x >= lo) & (x <= hi)\n    i = np.argmax(y[m])\n    print(name, 'max at', x[m][i], 'intensity', y[m][i], 'window edges', x[m][0], x[m][-1])\n    # rough FWHM using half maximum relative to local baseline at edges\n    baseline = 0.5*(y[m][0] + y[m][-1])\n    half = baseline + 0.5*(y[m][i]-baseline)\n    above = m.copy()\n    above[m] = y[m] >= half\n    idx = np.where(above)[0]\n    if len(idx):\n        print(' rough FWHM indices', x[idx[0]], x[idx[-1]], 'width', x[idx[-1]]-x[idx[0]])\nPY\n"]
