[48.046901, "o", "\u001b[?2004hroot@j-openenv-6afd8af9e5cad0e4dc3e6be9-7h2egm7d-cff77-24vqr:/app# "]
[66.340115, "i", "python3 - <<'PY'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amp, x0, gamma, off):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data[data.dtype.names[0]].astype(float)\ny = data['intensity'].astype(float)\nwindows = {'D': (1250.0, 1450.0), 'G': (1500.0, 1700.0), '2D': (2550.0, 2850.0)}\nresults = {}\nfor name, (lo, hi) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    xw = x[mask]\n    yw = y[mask]\n    imax = int(np.argmax(yw))\n    x0_guess = float(xw[imax])\n    off_guess = float(0.5 * (yw[0] + yw[-1]))\n    amp_guess = float(yw[imax] - off_guess)\n    half = off_guess + 0.5 * amp_guess\n    idx = np.where(yw >= half)[0]\n    gamma_guess = 0.5 * (xw[idx[-1]] - xw[idx[0]]) if len(idx) >= 2 else 15.0\n    p0 = [max(amp_guess, 1.0), x0_guess, max(float(gamma_guess), 1.0), off_guess]\n    lower = [0.0, lo, 0.0, -np.inf]\n    upper = [np.inf, hi, np.inf, np.inf]\n    popt, _ = curve_fit(lorentz"]
[66.340294, "i", ", xw, yw, p0=p0, bounds=(lower, upper), maxfev=20000)\n    amp, x0, gamma, off = [float(v) for v in popt]\n    yfit = lorentz(xw, *popt)\n    rmse = float(np.sqrt(np.mean((yw - yfit) ** 2)))\n    results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amp, 'offset': off}\n    print(name, 'fit', results[name], 'rmse', rmse)\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('ID_IG', results['ID_IG'])\nPY\ncat /app/results.json\n"]
