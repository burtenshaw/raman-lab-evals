[38.780236, "i", "python3 - <<'PY'\nimport numpy as np\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm1'] if 'raman_shift_cm1' in data.dtype.names else data[data.dtype.names[0]]\ny = data['intensity']\nprint('columns', data.dtype.names)\nprint('range', x.min(), x.max(), 'n', len(x))\nfor name, lo, hi in [('D', 1250, 1450), ('G', 1500, 1700), ('2D', 2550, 2850)]:\n    m = (x >= lo) & (x <= hi)\n    i = np.argmax(y[m])\n    print(name, 'max at', x[m][i], 'intensity', y[m][i], 'window edges', x[m][0], x[m][-1])\n    baseline = 0.5*(y[m][0] + y[m][-1])\n    half = baseline + 0.5*(y[m][i]-baseline)\n    above = np.where(m & (y >= half))[0]\n    if len(above):\n        print(' rough FWHM indices', x[above[0]], x[above[-1]], 'width', x[above[-1]]-x[above[0]])\nPY\n"]
