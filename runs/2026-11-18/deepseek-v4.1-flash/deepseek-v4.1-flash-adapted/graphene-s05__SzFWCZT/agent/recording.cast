[29.013118, "o", "Successfully installed numpy-2.5.5 scipy-1.18.1\r\n"]
[29.013302, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[29.014185, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m26.2.2\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.3\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[29.110884, "o", "\u001b[?2004hroot@j-openenv-6afd8a88e5cad0e4dc3e6b83-a4b9r6n4-ae53d-bnxmz:/app# "]
[40.836247, "i", "python3 - <<'PY'\nimport csv\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nxdata = []\nydata = []\nwith open('/app/spectrum.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        xdata.append(float(row['raman_shift_cm-1']))\n        ydata.append(float(row['intensity']))\nx = np.array(xdata)\ny = np.array(ydata)\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  (1200.0, 1500.0),\n    'G':  (1500.0, 1700.0),\n    '2D': (2500.0, 2850.0),\n}\n\nresults = {}\nfor name, (lo, hi) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    xw = x[mask]\n    yw = y[mask]\n    imax = np.argmax(yw)\n    x0_guess = xw[imax]\n    ymax = yw[imax]\n    offset_guess = np.min(yw)\n    amp_guess = ymax - offset_guess\n    p0 = [amp_guess, 20.0, x0_guess, offset_guess]\n    bounds = ([0.0, 1.0, lo, -np.inf], [np.inf, 200.0, hi, np.inf])\n    popt, pcov = curve_fit(lorentzian, xw, yw, p0=p0, bounds=bounds, maxfev=20000)\n "]
[40.836396, "i", "   amplitude, gamma, x0, offset = popt\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amplitude),\n        'offset': float(offset),\n    }\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nPY\n"]
[40.836497, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> "]
