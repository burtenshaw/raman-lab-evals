[10.310727, "i", "python3 - <<'PY'\nimport csv\nrows=[]\nwith open('spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x=float(row['raman_shift_cm-1']); y=float(row['intensity'])\n        rows.append((x,y))\nprint('n',len(rows),'xmin',rows[0][0],'xmax',rows[-1][0])\nfor name,lo,hi in [('D',1200,1500),('G',1500,1700),('2D',2500,2850)]:\n    win=[(x,y) for x,y in rows if lo<=x<=hi]\n    xm,ym=max(win,key=lambda p:p[1])\n    print(name,'max',xm,ym)\nPY\n"]
