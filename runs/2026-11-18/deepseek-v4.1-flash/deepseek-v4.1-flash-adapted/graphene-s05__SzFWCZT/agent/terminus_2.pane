[?2004l[?2004h>     x0_guess = xw[imax]
[?2004l[?2004h>     ymax = yw[imax]
[?2004l[?2004h>     offset_guess = np.min(yw)
[?2004l[?2004h>     amp_guess = ymax - offset_guess
[?2004l[?2004h>     p0 = [amp_guess, 20.0, x0_guess, offset_guess]
[?2004l[?2004h>     bounds = ([0.0, 1.0, lo, -np.inf], [np.inf, 200.0, hi, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xw, yw, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     amplitude, gamma, x0, offset = popt
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amplitude),
[?2004l[?2004h>         'offset': float(offset),
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
