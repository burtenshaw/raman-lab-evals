[39.911344, "o", "\u001b[?2004hroot@j-openenv-6afd8bc729e8b7ccfbbb82b7-gdj52b3o-db0d2-zl4zf:/app# "]
[53.051295, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd=np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx,y=d[:,0],d[:,1]\n\ndef lor(x, amp, x0, gamma, off):\n    return amp * gamma**2 / ((x-x0)**2 + gamma**2) + off\n\ndef fitwin(lo,hi,guess_x0):\n    m=(x>=lo)&(x<=hi)\n    xw,yw=x[m],y[m]\n    # initial estimates\n    ymax=yw.max(); off0=np.percentile(yw,10)\n    amp0=max(ymax-off0,1.0); gam0=20.0\n    p0=[amp0,guess_x0,gam0,off0]\n    bounds=([0,lo,1e-6,-np.inf],[np.inf,hi,np.inf,np.inf])\n    try:\n        popt,pcov=curve_fit(lor,xw,yw,p0=p0,bounds=bounds,maxfev=100000)\n        r=yw-lor(xw,*popt)\n        rmse=np.sqrt(np.mean(r*r))\n        return popt,rmse\n    except Exception as e:\n        return None,str(e)\n\ncases={\n'D':[(1250,1450,1347),(1275,1425,1347),(1300,1400,1347),(1280,1410,1347)],\n'G':[(1500,1700,1579),(1520,1640,1579),(1540,1620,1579),(1550,1610,1579)],\n'2D':[(2550,2850,2694),(2600,2800,2694),(2630,2770,2694),(2650,2740,2694)],\n}\nfor name,wins in cases.items():\n    print('\\n',name)\n "]
[53.051445, "i", "   for lo,hi,x0 in wins:\n        p,rmse=fitwin(lo,hi,x0)\n        if p is None:\n            print(f'  {lo}-{hi}: FAIL {rmse}')\n        else:\n            print(f'  {lo}-{hi}: amp={p[0]:.3f} x0={p[1]:.4f} gamma={p[2]:.4f} off={p[3]:.3f} rmse={rmse:.3f}')\nPY\n"]
[53.051464, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[53.051796, "o", "   for lo,hi,x0 in wins:\r\n        p,rmse=fitwin(lo,hi,x0)\r\n        if p is None:\r\n            print(f'  {lo}-{hi}: FAIL {rmse}')\r\n        else:\r\n            print(f'  {lo}-{hi}: amp={p[0]:.3f} x0={p[1]:.4f} gamma={p[2]:.4f} off={p[3]:.3f} rmse={rmse:.3f}')\r\nPY\r\n\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
