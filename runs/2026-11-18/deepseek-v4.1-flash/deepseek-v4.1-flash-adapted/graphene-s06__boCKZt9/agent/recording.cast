[81.594642, "i", "python3 - <<'PY'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# Load spectrum\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx = data[:, 0]\ny = data[:, 1]\n\n# Lorentzian plus constant offset\ndef lorentzian_offset(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  (1250.0, 1450.0),\n    'G':  (1500.0, 1700.0),\n    '2D': (2550.0, 2850.0),\n}\n\nresults = {}\nfor name, (lo, hi) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    xw, yw = x[mask], y[mask]\n    idx = np.argmax(yw)\n    offset0 = np.percentile(yw, 10)\n    amp0 = max(yw[idx] - offset0, 1.0)\n    p0 = [amp0, xw[idx], 20.0, offset0]\n    bounds = ([0.0, lo, 1e-6, -np.inf], [np.inf, hi, np.inf, np.inf])\n    popt, _ = curve_fit(lorentzian_offset, xw, yw, p0=p0, bounds=bounds, maxfev=100000)\n    amp, x0, gamma, offset = map(float, popt)\n    results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amp, 'offset': offset}\n    print(name, results[name])\n"]
[81.596703, "i", "\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG', results['ID_IG'])\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('\\nSaved results.json:')\nprint(open('results.json').read())\nPY\n"]
[81.596735, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load spectrum\r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h> x = data[:, 0]\r\n\u001b[?2004l\r\u001b[?2004h> y = data[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Lorentzian plus constant offset\r\n\u001b[?2004l\r\u001b[?2004h> def lorentzian_offset(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r\u001b[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> windows = {\r\n\u001b[?2004l\r\u001b[?2004h>     'D':  (1250.0, 1450.0),\r\n\u001b[?2004l\r\u001b[?2004h>     'G':  (1500.0, 1700.0),\r\n\u001b[?2004l\r\u001b[?2004h>     '2D': (2550.0, 2850.0),\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = {}\r\n\u001b[?2004l\r\u001b[?2004h> for name, (lo, hi) in windows.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.597109, "o", "    mask = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r\u001b[?2004h>     xw, yw = x[mask], y[mask]\r\n\u001b[?2004l\r\u001b[?2004h>     idx = np.argmax(yw)\r\n\u001b[?2004l\r\u001b[?2004h>     offset0 = np.percentile(yw, 10)\r\n\u001b[?2004l\r\u001b[?2004h>     amp0 = max(yw[idx] - offset0, 1.0)\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [amp0, xw[idx], 20.0, offset0]\r\n\u001b[?2004l\r\u001b[?2004h>     bounds = ([0.0, lo, 1e-6, -np.inf], [np.inf, hi, np.inf, np.inf])\r\n\u001b[?2004l\r\u001b[?2004h> "]
