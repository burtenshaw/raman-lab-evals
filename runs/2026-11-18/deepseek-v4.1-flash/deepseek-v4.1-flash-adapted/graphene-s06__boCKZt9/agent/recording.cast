[6.288635, "i", "python3 - <<'PY'\nimport numpy as np\nd=np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx,y=d[:,0],d[:,1]\nprint('x range',x.min(),x.max(),'n',len(x))\nfor lo,hi in [(1250,1450),(1500,1700),(2550,2800)]:\n    m=(x>=lo)&(x<=hi)\n    i=np.argmax(y[m])\n    print(lo,hi,'max at',x[m][i],y[m][i])\nPY\n"]
