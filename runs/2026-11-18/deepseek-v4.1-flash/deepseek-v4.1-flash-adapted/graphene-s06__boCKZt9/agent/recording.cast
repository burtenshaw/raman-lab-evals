[38.621646, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.signal import find_peaks\nd=np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx,y=d[:,0],d[:,1]\nprint('x range',x.min(),x.max(),'n',len(x))\nfor lo,hi in [(1200,1500),(1500,1700),(2500,2850)]:\n    m=(x>=lo)&(x<=hi)\n    xw,yw=x[m],y[m]\n    idx,_=find_peaks(yw, distance=20, prominence=100)\n    order=np.argsort(yw[idx])[::-1]\n    print('\\nwindow',lo,hi)\n    for j in order[:8]:\n        print(' peak',xw[idx[j]],yw[idx[j]])\nPY\n"]
