        p,rmse=fitwin(lo,hi,x0)
        if p is None:
            print(f'  {lo}-{hi}: FAIL {rmse}')
        else:
            print(f'  {lo}-{hi}: amp={p[0]:.3f} x0={p[1]:.4f} gamma={p[2]:.4f} off={p[3]:.3f} rmse={rmse:.3f}')
PY
[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d=np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x,y=d[:,0],d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp * gamma**2 / ((x-x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def fitwin(lo,hi,guess_x0):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xw,yw=x[m],y[m]
[?2004l[?2004h>     # initial estimates
[?2004l[?2004h>     ymax=yw.max(); off0=np.percentile(yw,10)
[?2004l[?2004h>     amp0=max(ymax-off0,1.0); gam0=20.0
[?2004l[?2004h>     p0=[amp0,guess_x0,gam0,off0]
[?2004l[?2004h>     bounds=([0,lo,1e-6,-np.inf],[np.inf,hi,np.inf,np.inf])
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt,pcov=curve_fit(lor,xw,yw,p0=p0,bounds=bounds,maxfev=100000)
[?2004l[?2004h>         r=yw-lor(xw,*popt)
[?2004l[?2004h>         rmse=np.sqrt(np.mean(r*r))
[?2004l[?2004h>         return popt,rmse
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return None,str(e)
[?2004l[?2004h> 
[?2004l[?2004h> cases={
[?2004l[?2004h> 'D':[(1250,1450,1347),(1275,1425,1347),(1300,1400,1347),(1280,1410,1347)],
[?2004l[?2004h> 'G':[(1500,1700,1579),(1520,1640,1579),(1540,1620,1579),(1550,1610,1579)],
[?2004l[?2004h> '2D':[(2550,2850,2694),(2600,2800,2694),(2630,2770,2694),(2650,2740,2694)],
[?2004l[?2004h> }
[?2004l[?2004h> for name,wins in cases.items():
[?2004l[?2004h>     print('\n',name)
[?2004l[?2004h>     for lo,hi,x0 in wins:
[?2004l[?2004h>         p,rmse=fitwin(lo,hi,x0)
[?2004l[?2004h>         if p is None:
[?2004l[?2004h>             print(f'  {lo}-{hi}: FAIL {rmse}')
[?2004l[?2004h>         else:
[?2004l[?2004h>             print(f'  {lo}-{hi}: amp={p[0]:.3f} x0={p[1]:.4f} gamma={p[2]:.4f} off={p[3]:.3f} rmse={rmse:.3f}')
