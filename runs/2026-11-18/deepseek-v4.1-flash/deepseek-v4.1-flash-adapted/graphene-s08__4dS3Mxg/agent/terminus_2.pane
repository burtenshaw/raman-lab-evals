[?2004l[?2004h> 
[?2004l[?2004h> def solve_for_x0_gamma(xs, ys, x0, gamma):
[?2004l[?2004h>     n = len(xs)
[?2004l[?2004h>     SLL = SL = SLY = SY = SYY = 0.0
[?2004l[?2004h>     g2 = gamma * gamma
[?2004l[?2004h>     for xi, yi in zip(xs, ys):
[?2004l[?2004h>         d = xi - x0
[?2004l[?2004h>         L = g2 / (d*d + g2)
[?2004l[?2004h>         SLL += L*L
[?2004l[?2004h>         SL += L
[?2004l[?2004h>         SLY += L*yi
[?2004l[?2004h>         SY += yi
[?2004l[?2004h>         SYY += yi*yi
[?2004l[?2004h>     det = SLL*n - SL*SL
[?2004l[?2004h>     if det <= 1e-300:
[?2004l[?2004h>         return float('inf'), None, None
[?2004l[?2004h>     A = (SLY*n - SL*SY) / det
[?2004l[?2004h>     b = (SLL*SY - SL*SLY) / det
[?2004l[?2004h>     sse = SYY - A*SLY - b*SY
[?2004l[?2004h>     if sse < 0 and sse > -1e-7:
[?2004l[?2004h>         sse = 0.0
[?2004l[?2004h>     return sse, A, b
[?2004l[?2004h> 
[?2004l[?2004h> def golden(f, a, b, tol=1e-9, maxit=200):
[?2004l[?2004h>     invphi = (math.sqrt(5.0) - 1.0) / 2.0
[?2004l[?2004h>     c = b - invphi*(b-a)
[?2004l[?2004h>     d = a + invphi*(b-a)
[?2004l[?2004h>     fc = f(c); fd = f(d)
[?2004l[?2004h>     it = 0
[?2004l[?2004h>     while b-a > tol and it < maxit:
[?2004l[?2004h>         if fc < fd:
[?2004l[?2004h>             b, d, fd = d, c, fc
[?2004l[?2004h>             c = b - invphi*(b-a)
[?2004l[?2004h>             fc = f(c)
[?2004l[?2004h>         else:
[?2004l[?2004h>             a, c, fc = c, d, fd
[?2004l[?2004h>             d = a + invphi*(b-a)
[?2004l[?2004h>             fd = f(d)
[?2004l[?2004h>         it += 1
[?2004l[?2004h>     return (c, fc) if fc < fd else (d, fd)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(name, lo, hi):
[?2004l[?2004h>     xs = [xx for xx in x if lo <= xx <= hi]
[?2004l[?2004h>     ys = [yy for xx, yy in zip(x,y) if lo <= xx <= hi]
[?2004l[?2004h>     n = len(xs)
[?2004l[?2004h>     base = sorted(ys)[max(0, n//10)]
[?2004l[?2004h>     imax = max(range(n), key=lambda i: ys[i])
[?2004l[?2004h>     x0 = xs[imax]
[?2004l[?2004h>     ymax = ys[imax]
[?2004l[?2004h>     gamma = 5.0
[?2004l[?2004h>     # Estimate gamma from half-maximum above local baseline
[?2004l[?2004h>     half = base + (ymax - base)/2.0
[?2004l[?2004h>     left = None; right = None
[?2004l[?2004h>     for i in range(imax, -1, -1):
[?2004l[?2004h>         if ys[i] <= half:
[?2004l[?2004h>             left = xs[i]; break
[?2004l[?2004h>     for i in range(imax, n):
[?2004l[?2004h>         if ys[i] <= half:
[?2004l[?2004h>             right = xs[i]; break
[?2004l[?2004h>     if left is not None and right is not None and right > left:
[?2004l[?2004h>         gamma = max(0.5, (right-left)/2.0)
[?2004l[?2004h>     
[?2004l[?2004h>     def sse_at(x0v, gv):
[?2004l[?2004h>         if gv <= 0:
[?2004l[?2004h>             return float('inf')
[?2004l[?2004h>         return solve_for_x0_gamma(xs, ys, x0v, gv)[0]
