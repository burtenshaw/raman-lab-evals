[?2004l[?2004h>     print(name, 'window', lo, hi, 'n', n, 'x0', x0, 'gamma', gamma, 'A', A, 'b', b, 'SSE', sse)
[?2004l[?2004h>     return {'x0': x0, 'gamma': gamma, 'amplitude': A, 'offset': b}, sse
