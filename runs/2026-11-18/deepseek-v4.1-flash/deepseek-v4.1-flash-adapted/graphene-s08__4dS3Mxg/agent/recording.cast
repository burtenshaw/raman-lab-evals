[113.537413, "o", "ID_IG 0.19914105144226482\r\nJSON {\r\n  \"D\": {\r\n    \"x0\": 1349.2335983069866,\r\n    \"gamma\": 13.5326368730774,\r\n    \"amplitude\": 1313.5098082944328,\r\n    \"offset\": 971.7087296203194\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1581.1300063728427,\r\n    \"gamma\": 8.432165118195869,\r\n    \"amplitude\": 6595.876635085694,\r\n    \"offset\": 943.2842467152616\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2684.731107789109,\r\n    \"gamma\": 17.005678050454488,\r\n    \"amplitude\": 13066.567538398063,\r\n    \"offset\": 807.762440336538\r\n  },\r\n  \"ID_IG\": 0.19914105144226482\r\n}\r\n"]
