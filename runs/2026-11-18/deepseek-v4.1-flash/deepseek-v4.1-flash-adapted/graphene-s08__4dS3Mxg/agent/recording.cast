[150.380386, "i", "python3 - <<'PY'\nimport csv, math\nx=[]; y=[]\nfor r in csv.DictReader(open('/app/spectrum.csv')):\n    x.append(float(r['raman_shift_cm-1'])); y.append(float(r['intensity']))\n\ndef linfit(xs,ys,x0,gamma):\n    n=len(xs); g2=gamma*gamma\n    SLL=SL=SLY=SY=SYY=0.0\n    for xi,yi in zip(xs,ys):\n        d=xi-x0\n        L=g2/(d*d+g2)\n        SLL+=L*L; SL+=L; SLY+=L*yi; SY+=yi; SYY+=yi*yi\n    det=SLL*n-SL*SL\n    if det<=0: return float('inf'),0,0\n    A=(SLY*n-SL*SY)/det\n    b=(SLL*SY-SL*SLY)/det\n    sse=SYY-A*SLY-b*SY\n    return max(0.0,sse),A,b\n\nfor name,lo,hi,x0c,gc in [\n    ('D',1250,1450,1349.2336,13.5326),\n    ('G',1500,1650,1581.1300,8.4322),\n    ('2D',2580,2790,2684.7311,17.0057)]:\n    xs=[xx for xx in x if lo<=xx<=hi]\n    ys=[yy for xx,yy in zip(x,y) if lo<=xx<=hi]\n    best=(float('inf'),None,None,None,None)\n    for i in range(-50,51):\n        x0=x0c+i*0.2\n        for j in range(0,101):\n            gamma=0.1+j*0.5\n            sse,A,b=linfit(xs,ys,x0,gamma)\n            if sse<best[0]: best=(sse,x0,gamma,A,b)\n    #"]
[150.380511, "i", " local refine around grid best\n    s0,x0b,gb,Ab,bb=best\n    for i in range(-20,21):\n        x0=x0b+i*0.01\n        for j in range(-50,51):\n            gamma=max(0.01,gb+j*0.01)\n            sse,A,b=linfit(xs,ys,x0,gamma)\n            if sse<best[0]: best=(sse,x0,gamma,A,b)\n    print(name,'grid_best',best)\nPY\n"]
