[28.071105, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\nprint('n', len(x), 'xrange', x[0], x[-1])\nfor name,lo,hi in [('D',1200,1500),('G',1450,1750),('2D',2450,2900)]:\n    pts=[(xx,yy) for xx,yy in zip(x,y) if lo<=xx<=hi]\n    xm,ym=max(pts,key=lambda p:p[1])\n    ys=sorted(yy for xx,yy in pts)\n    print(name, 'window', lo, hi, 'n', len(pts), 'max', xm, ym, 'min', min(yy for xx,yy in pts), 'median', ys[len(ys)//2])\n    # print values near max\n    near=[(xx,yy) for xx,yy in pts if abs(xx-xm)<=5]\n    print('  near max:', near)\nPY\n"]
