[15.307316, "i", "python3 - <<'PY'\nimport numpy as np\nprint('numpy', np.__version__)\narr = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = arr[:,0], arr[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nfor name, lo, hi in [('D',1250,1450),('G',1500,1650),('2D',2550,2800)]:\n    m = (x>=lo)&(x<=hi)\n    print(name, 'range', lo, hi, 'max', x[m][y[m].argmax()], y[m].max(), 'min', y[m].min())\nPY\n"]
