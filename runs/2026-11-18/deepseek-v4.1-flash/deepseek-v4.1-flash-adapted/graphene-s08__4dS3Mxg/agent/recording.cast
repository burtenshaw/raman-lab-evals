[75.681777, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nfor r in csv.DictReader(open('/app/spectrum.csv')):\n    x.append(float(r['raman_shift_cm-1'])); y.append(float(r['intensity']))\nfor xv in [1100,1150,1200,1250,1450,1480,1500,1520,1700,1750,2400,2500,2800,2850,2900,3000]:\n    i=min(range(len(x)), key=lambda j: abs(x[j]-xv))\n    print(xv, x[i], y[i])\nfor name,lo,hi in [('D',1200,1500),('G',1450,1750),('2D',2450,2900)]:\n    pts=[(xx,yy) for xx,yy in zip(x,y) if lo<=xx<=hi]\n    base=sorted(yy for xx,yy in pts)[len(pts)//10]\n    xm,ym=max(pts,key=lambda p:p[1])\n    half=base+(ym-base)/2\n    left=min((xx for xx,yy in pts if xx<xm and yy<=half), key=lambda xx:abs(xx-xm), default=None)\n    right=min((xx for xx,yy in pts if xx>xm and yy<=half), key=lambda xx:abs(xx-xm), default=None)\n    print(name,'baseline',base,'max',xm,ym,'half',half,'left',left,'right',right,'approx gamma',None if left is None or right is None else (xm-left+right-xm)/2)\nPY\n"]
