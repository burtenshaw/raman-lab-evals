[10.302099, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nprint('n', len(xs))\nprint('x range', min(xs), max(xs))\nprint('y range', min(ys), max(ys))\nfor lo,hi,name in [(1250,1450,'D'),(1500,1650,'G'),(2550,2800,'2D')]:\n    vals=[(y,x) for x,y in zip(xs,ys) if lo<=x<=hi]\n    ymax,xmax=max(vals)\n    print(name, 'max', ymax, 'at', xmax, 'window', lo, hi)\nPY\n"]
[10.302261, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
