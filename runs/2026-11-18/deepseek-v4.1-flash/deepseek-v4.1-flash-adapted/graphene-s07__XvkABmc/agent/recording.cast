[100.950715, "i", "python3 - <<'PY'\nimport json\n\nresults = {\n    \"D\": {\"x0\": 1348.251997, \"gamma\": 16.733461, \"amplitude\": 8212.085067, \"offset\": 1260.802889},\n    \"G\": {\"x0\": 1580.385806, \"gamma\": 12.988350, \"amplitude\": 7520.186020, \"offset\": 1296.332127},\n    \"2D\": {\"x0\": 2692.410158, \"gamma\": 20.931416, \"amplitude\": 10380.364857, \"offset\": 1407.084958}\n}\nresults[\"ID_IG\"] = results[\"D\"][\"amplitude\"] / results[\"G\"][\"amplitude\"]\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\nprint(json.dumps(results, indent=2))\nPY\n"]
