[164.028081, "o", "    \"D\": {\"x0\": 1348.251998914, \"gamma\": 16.733459473, \"amplitude\": 8212.085268608, \"offset\": 1260.803036193},\r\n\u001b[?2004l\r"]
[164.028131, "o", "\u001b[?2004h> "]
[164.028243, "o", "    \"G\": {\"x0\": 1580.385805408, \"gamma\": 12.988357544, \"amplitude\": 7520.185111546, \"offset\": 1296.331406128},\r\n\u001b[?2004l\r"]
[164.028255, "o", "\u001b[?2004h> "]
[164.028391, "o", "    \"2D\": {\"x0\": 2692.410161072, \"gamma\": 20.931411743, \"amplitude\": 10380.365265352, \"offset\": 1407.085255126}\r\n\u001b[?2004l\r"]
[164.028439, "o", "\u001b[?2004h> }\r\n"]
[164.028481, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[164.028524, "o", "results[\"ID_IG\"] = results[\"D\"][\"amplitude\"] / results[\"G\"][\"amplitude\"]\r\n\u001b[?2004l\r"]
[164.028561, "o", "\u001b[?2004h> "]
[164.028594, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.028628, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[164.028637, "o", "\u001b[?2004h"]
[164.028677, "o", "> "]
[164.028704, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[164.028728, "o", "\u001b[?2004h> "]
[164.028758, "o", "    f.write('\\n')\r\n\u001b[?2004l\r"]
[164.028777, "o", "\u001b[?2004h> \r\n"]
[164.028802, "o", "\u001b[?2004l\r"]
