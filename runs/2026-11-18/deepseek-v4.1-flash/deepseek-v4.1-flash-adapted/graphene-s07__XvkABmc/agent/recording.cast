[149.07934, "o", "    cands=[]\r\n\u001b[?2004l\r"]
[149.079363, "o", "\u001b[?2004h> "]
[149.079409, "o", "    for i in range(-30,31):\r\n\u001b[?2004l\r"]
[149.079425, "o", "\u001b[?2004h> "]
[149.079473, "o", "        x0=xpeak+i*0.5\r\n\u001b[?2004l\r"]
[149.079497, "o", "\u001b[?2004h> "]
[149.079535, "o", "        for j in range(50):\r\n\u001b[?2004l\r"]
[149.079559, "o", "\u001b[?2004h> "]
[149.079598, "o", "            gamma=2.0+2.0*j\r\n\u001b[?2004l\r"]
[149.079623, "o", "\u001b[?2004h> "]
[149.079686, "o", "            res=fit_linear(xw,yw,x0,gamma)\r\n\u001b[?2004l\r"]
[149.079715, "o", "\u001b[?2004h> "]
[149.079759, "o", "            if res is not None:\r\n\u001b[?2004l\r"]
[149.079785, "o", "\u001b[?2004h> "]
[149.079844, "o", "                cands.append((res[2],x0,gamma))\r\n\u001b[?2004l\r"]
[149.079853, "o", "\u001b[?2004h> "]
[149.079921, "o", "    cands.sort(key=lambda t:t[0])\r\n\u001b[?2004l\r"]
[149.079948, "o", "\u001b[?2004h"]
[149.079973, "o", ">     best=None\r\n\u001b[?2004l\r"]
[149.079989, "o", "\u001b[?2004h> "]
[149.080051, "o", "    for sse0,x0c,gammac in cands[:20]:\r\n\u001b[?2004l\r"]
[149.080075, "o", "\u001b[?2004h> "]
[149.080153, "o", "        x0,gamma,sse=local_refine(xw,yw,x0c,gammac,sse0)\r\n\u001b[?2004l\r"]
[149.080178, "o", "\u001b[?2004h> "]
[149.080238, "o", "        if best is None or sse<best[2]:\r\n\u001b[?2004l\r"]
[149.080262, "o", "\u001b[?2004h> "]
[149.080309, "o", "            best=(x0,gamma,sse)\r\n\u001b[?2004l\r"]
[149.080327, "o", "\u001b[?2004h> "]
[149.080371, "o", "    x0,gamma,sse=best\r\n\u001b[?2004l\r"]
[149.080401, "o", "\u001b[?2004h> "]
[149.080464, "o", "    A,c,_=fit_linear(xw,yw,x0,gamma)\r\n\u001b[?2004l\r"]
[149.080489, "o", "\u001b[?2004h> "]
[149.080538, "o", "    return x0,gamma,A,c,sse\r\n\u001b[?2004l\r"]
[149.080564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.080588, "o", "\u001b[?2004h> "]
[149.080651, "o", "xs,ys=load_data('/app/spectrum.csv')\r\n\u001b[?2004l\r"]
[149.080675, "o", "\u001b[?2004h> "]
[149.080757, "o", "regions=[('D',1250,1450),('G',1500,1650),('2D',2550,2800)]\r\n\u001b[?2004l\r"]
[149.080783, "o", "\u001b[?2004h> "]
[149.080825, "o", "for name,lo,hi in regions:\r\n\u001b[?2004l\r"]
[149.080849, "o", "\u001b[?2004h> "]
[149.080906, "o", "    xw=[x for x,y in zip(xs,ys) if lo<=x<=hi]\r\n\u001b[?2004l\r"]
[149.080932, "o", "\u001b[?2004h> "]
[149.080994, "o", "    yw=[y for x,y in zip(xs,ys) if lo<=x<=hi]\r\n\u001b[?2004l\r"]
[149.08102, "o", "\u001b[?2004h> "]
[149.081076, "o", "    x0,gamma,A,c,sse=fit_peak(xw,yw)\r\n\u001b[?2004l\r"]
[149.0811, "o", "\u001b[?2004h> "]
[149.081146, "o", "    rmse=math.sqrt(sse/len(xw))\r\n\u001b[?2004l\r"]
[149.08117, "o", "\u001b[?2004h> "]
[149.081298, "o", "    print(name, 'x0=%.9f gamma=%.9f amplitude=%.9f offset=%.9f rmse=%.9f' % (x0,gamma,A,c,rmse))\r\n\u001b[?2004l\r"]
[149.081331, "o", "\u001b[?2004h> PY\r\n"]
[149.081355, "o", "\u001b[?2004l\r"]
[150.137066, "o", "D x0=1348.251998914 gamma=16.733459473 amplitude=8212.085268608 offset=1260.803036193 rmse=104.330180015\r\n"]
[150.844213, "o", "G x0=1580.385805408 gamma=12.988357544 amplitude=7520.185111546 offset=1296.331406128 rmse=98.290829593\r\n"]
[152.098455, "o", "2D x0=2692.410161072 gamma=20.931411743 amplitude=10380.365265352 offset=1407.085255126 rmse=100.033497467\r\n"]
[152.102732, "o", "\u001b[?2004hroot@j-openenv-6afd8be529e8b7ccfbbb82cc-yqw5g5w0-ef0b2-glbnv:/app# "]
[164.027669, "i", "python3 - <<'PY'\nimport json\n\nresults = {\n    \"D\": {\"x0\": 1348.251998914, \"gamma\": 16.733459473, \"amplitude\": 8212.085268608, \"offset\": 1260.803036193},\n    \"G\": {\"x0\": 1580.385805408, \"gamma\": 12.988357544, \"amplitude\": 7520.185111546, \"offset\": 1296.331406128},\n    \"2D\": {\"x0\": 2692.410161072, \"gamma\": 20.931411743, \"amplitude\": 10380.365265352, \"offset\": 1407.085255126}\n}\nresults[\"ID_IG\"] = results[\"D\"][\"amplitude\"] / results[\"G\"][\"amplitude\"]\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\nprint(json.dumps(results, indent=2))\nPY\n"]
[164.027811, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.027825, "o", "> "]
