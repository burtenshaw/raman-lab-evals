[75.86725, "o", "            xs.append(xi); ys.append(yi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.86729, "o", "> "]
[75.867331, "o", "    imax=max(range(len(ys)), key=ys.__getitem__)\r\n\u001b[?2004l\r"]
[75.867375, "o", "\u001b[?2004h>     x0c=xs[imax]\r\n\u001b[?2004l\r"]
[75.867415, "o", "\u001b[?2004h> "]
[75.867466, "o", "    best=(float('inf'),x0c,10.0,0.0,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.867542, "o", "    x0=x0c-20.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.867578, "o", "    while x0 <= x0c+20.0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.867615, "o", "        if lo <= x0 <= hi:\r\n\u001b[?2004l\r"]
[75.867651, "o", "\u001b[?2004h>             g=1.0\r\n\u001b[?2004l\r"]
[75.867685, "o", "\u001b[?2004h> "]
[75.867724, "o", "            while g <= 200.0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.867759, "o", "> "]
[75.867798, "o", "                sse,A,c=linear_fit(xs,ys,x0,g)\r\n\u001b[?2004l\r"]
[75.867832, "o", "\u001b[?2004h> "]
[75.86787, "o", "                if sse < best[0]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.867913, "o", "                    best=(sse,x0,g,A,c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.86795, "o", "                g += 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.867975, "o", "> "]
[75.868016, "o", "        x0 += 1.0\r\n\u001b[?2004l\r"]
[75.868047, "o", "\u001b[?2004h> "]
[75.868084, "o", "    sse,x0,g,A,c=best\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.868121, "o", "    sx=1.0; sg=1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.86816, "o", "    while sx > 1e-5 or sg > 1e-5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.868193, "o", ">         improved=False\r\n\u001b[?2004l\r"]
[75.868225, "o", "\u001b[?2004h> "]
[75.868315, "o", "        for dx,dg in ((sx,0.0),(-sx,0.0),(0.0,sg),(0.0,-sg),(sx,sg),(sx,-sg),(-sx,sg),(-sx,-sg)):\r\n\u001b[?2004l\r"]
[75.86835, "o", "\u001b[?2004h> "]
[75.86838, "o", "            x0t=x0+dx; gt=g+dg\r\n\u001b[?2004l\r"]
[75.868414, "o", "\u001b[?2004h> "]
[75.868446, "o", "            if not (lo <= x0t <= hi) or gt <= 0.0:\r\n\u001b[?2004l\r"]
[75.868456, "o", "\u001b[?2004h> "]
[75.868499, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.868531, "o", "> "]
[75.868574, "o", "            sse_t,A_t,c_t=linear_fit(xs,ys,x0t,gt)\r\n\u001b[?2004l\r"]
[75.868607, "o", "\u001b[?2004h> "]
[75.868639, "o", "            if sse_t < sse:\r\n\u001b[?2004l\r"]
[75.868671, "o", "\u001b[?2004h> "]
[75.8687, "o", "                sse,x0,g,A,c=sse_t,x0t,gt,A_t,c_t\r\n\u001b[?2004l\r"]
[75.868731, "o", "\u001b[?2004h> "]
[75.868759, "o", "                improved=True\r\n\u001b[?2004l\r"]
[75.86879, "o", "\u001b[?2004h> "]
[75.868822, "o", "        if not improved:\r\n\u001b[?2004l\r"]
[75.868853, "o", "\u001b[?2004h> "]
[75.868885, "o", "            sx*=0.5; sg*=0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.868947, "o", "    return {'x0':x0,'gamma':g,'amplitude':A,'offset':c}, sse\r\n\u001b[?2004l\r"]
[75.868982, "o", "\u001b[?2004h> \r\n"]
[75.869022, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[75.869055, "o", "x,y=load()\r\n\u001b[?2004l\r\u001b[?2004h> out={}\r\n\u001b[?2004l\r"]
[75.869091, "o", "\u001b[?2004h> "]
[75.869165, "o", "for name,lo,hi in [('D',1250.0,1450.0),('G',1500.0,1660.0),('2D',2550.0,2820.0)]:\r\n\u001b[?2004l\r"]
[75.869215, "o", "\u001b[?2004h> "]
[75.869256, "o", "    p,sse=fit_peak(x,y,lo,hi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.869289, "o", "> "]
[75.869317, "o", "    out[name]=p\r\n\u001b[?2004l\r"]
[75.869358, "o", "\u001b[?2004h> "]
[75.869401, "o", "    print(name, p, 'sse', sse)\r\n\u001b[?2004l\r"]
[75.869423, "o", "\u001b[?2004h"]
[75.869458, "o", "> "]
[75.869516, "o", "out['ID_IG']=out['D']['amplitude']/out['G']['amplitude']\r\n\u001b[?2004l\r"]
[75.869551, "o", "\u001b[?2004h> "]
[75.869596, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r"]
[75.869624, "o", "\u001b[?2004h> "]
[75.869679, "o", "    json.dump(out,f,indent=2)\r\n\u001b[?2004l\r"]
[75.869711, "o", "\u001b[?2004h> "]
[75.869781, "o", "print('ID_IG',out['ID_IG'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.869854, "o", "print(open('/app/results.json').read())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
