[75.865297, "i", "python3 - <<'PY'\nimport csv, json\n\ndef load():\n    x=[]; y=[]\n    with open('/app/spectrum.csv', newline='') as f:\n        r=csv.reader(f)\n        next(r)\n        for row in r:\n            if len(row) >= 2:\n                x.append(float(row[0])); y.append(float(row[1]))\n    return x,y\n\ndef linear_fit(x,y,x0,g):\n    n=len(x); Sbb=Sb=Sby=Syy=Sy=0.0\n    for xi,yi in zip(x,y):\n        b=g*g/((xi-x0)*(xi-x0)+g*g)\n        Sbb+=b*b; Sb+=b; Sby+=b*yi; Syy+=yi*yi; Sy+=yi\n    det=Sbb*n-Sb*Sb\n    if det <= 1e-15:\n        return float('inf'),0.0,0.0\n    A=(Sby*n-Sb*Sy)/det\n    c=(Sbb*Sy-Sb*Sby)/det\n    if A < 0:\n        return float('inf'),A,c\n    sse=Syy-2.0*A*Sby-2.0*c*Sy+A*A*Sbb+2.0*A*c*Sb+c*c*n\n    if sse < 0 and sse > -1e-8:\n        sse=0.0\n    return sse,A,c\n\ndef fit_peak(x,y,lo,hi):\n    xs=[]; ys=[]\n    for xi,yi in zip(x,y):\n        if lo <= xi <= hi:\n            xs.append(xi); ys.append(yi)\n    imax=max(range(len(ys)), key=ys.__getitem__)\n    x0c=xs[imax]\n    best=(float('inf'),x0c,10.0,0.0,0.0)\n    x0=x0c-20.0"]
[75.865444, "i", "\n    while x0 <= x0c+20.0:\n        if lo <= x0 <= hi:\n            g=1.0\n            while g <= 200.0:\n                sse,A,c=linear_fit(xs,ys,x0,g)\n                if sse < best[0]:\n                    best=(sse,x0,g,A,c)\n                g += 1.0\n        x0 += 1.0\n    sse,x0,g,A,c=best\n    sx=1.0; sg=1.0\n    while sx > 1e-5 or sg > 1e-5:\n        improved=False\n        for dx,dg in ((sx,0.0),(-sx,0.0),(0.0,sg),(0.0,-sg),(sx,sg),(sx,-sg),(-sx,sg),(-sx,-sg)):\n            x0t=x0+dx; gt=g+dg\n            if not (lo <= x0t <= hi) or gt <= 0.0:\n                continue\n            sse_t,A_t,c_t=linear_fit(xs,ys,x0t,gt)\n            if sse_t < sse:\n                sse,x0,g,A,c=sse_t,x0t,gt,A_t,c_t\n                improved=True\n        if not improved:\n            sx*=0.5; sg*=0.5\n    return {'x0':x0,'gamma':g,'amplitude':A,'offset':c}, sse\n\nx,y=load()\nout={}\nfor name,lo,hi in [('D',1250.0,1450.0),('G',1500.0,1660.0),('2D',2550.0,2820.0)]:\n    p,sse=fit_peak(x,y,lo,hi)\n    out[name]=p\n    print(name, p, 'sse', sse)\nout"]
[75.865577, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, json\r\n\u001b[?2004l\r"]
[75.865633, "i", "['ID_IG']=out['D']['amplitude']/out['G']['amplitude']\nwith open('/app/results.json','w') as f:\n    json.dump(out,f,indent=2)\nprint('ID_IG',out['ID_IG'])\nprint(open('/app/results.json').read())\nPY\n"]
