[9.021762, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nprint('numpy', np.__version__)\nprint('scipy', __import__('scipy').__version__)\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:,0], data[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nfor name, lo, hi in [('D',1200,1500),('G',1500,1700),('2D',2500,2900)]:\n    m = (x>=lo)&(x<=hi)\n    i = np.argmax(y[m])\n    print(name, 'window max at', x[m][i], y[m][i])\nPY\n"]
