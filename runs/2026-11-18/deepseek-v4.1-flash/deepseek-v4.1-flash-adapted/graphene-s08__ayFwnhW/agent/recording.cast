[30.402408, "i", "python3 - <<'PY'\nimport csv, math\nx=[]; y=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2:\n            x.append(float(row[0])); y.append(float(row[1]))\nprint('n', len(x), 'x range', x[0], x[-1])\nfor name, lo, hi in [('D',1200,1500),('G',1500,1700),('2D',2500,2900)]:\n    vals=[(yy,xx) for xx,yy in zip(x,y) if lo<=xx<=hi]\n    ymax, xmax=max(vals)\n    ymin=min(vals)[0]\n    print(name, 'window', lo, hi, 'max', xmax, ymax, 'min', ymin, 'n', len(vals))\n# Print values at peaks and some nearby points\nfor center in [1350,1580,2690]:\n    idx=min(range(len(x)), key=lambda i: abs(x[i]-center))\n    print('near', center, [(round(x[i],1), round(y[i],1)) for i in range(max(0,idx-3), min(len(x),idx+4))])\nPY\n"]
