[?2004l[?2004h> def linear_fit(x,y,x0,g):
[?2004l[?2004h>     n=len(x); Sbb=Sb=Sby=Syy=Sy=0.0
[?2004l[?2004h>     for xi,yi in zip(x,y):
[?2004l[?2004h>         b=g*g/((xi-x0)*(xi-x0)+g*g)
[?2004l[?2004h>         Sbb+=b*b; Sb+=b; Sby+=b*yi; Syy+=yi*yi; Sy+=yi
[?2004l[?2004h>     det=Sbb*n-Sb*Sb
[?2004l[?2004h>     if det <= 1e-15:
[?2004l[?2004h>         return float('inf'),0.0,0.0
[?2004l[?2004h>     A=(Sby*n-Sb*Sy)/det
[?2004l[?2004h>     c=(Sbb*Sy-Sb*Sby)/det
[?2004l[?2004h>     if A < 0:
[?2004l[?2004h>         return float('inf'),A,c
[?2004l[?2004h>     sse=Syy-2.0*A*Sby-2.0*c*Sy+A*A*Sbb+2.0*A*c*Sb+c*c*n
[?2004l[?2004h>     if sse < 0 and sse > -1e-8:
[?2004l[?2004h>         sse=0.0
[?2004l[?2004h>     return sse,A,c
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x,y,lo,hi):
[?2004l[?2004h>     xs=[]; ys=[]
[?2004l[?2004h>     for xi,yi in zip(x,y):
[?2004l[?2004h>         if lo <= xi <= hi:
[?2004l[?2004h>             xs.append(xi); ys.append(yi)
[?2004l[?2004h>     imax=max(range(len(ys)), key=ys.__getitem__)
[?2004l[?2004h>     x0c=xs[imax]
[?2004l[?2004h>     best=(float('inf'),x0c,10.0,0.0,0.0)
[?2004l[?2004h>     x0=x0c-20.0
[?2004l[?2004h>     while x0 <= x0c+20.0:
[?2004l[?2004h>         if lo <= x0 <= hi:
[?2004l[?2004h>             g=1.0
[?2004l[?2004h>             while g <= 200.0:
[?2004l[?2004h>                 sse,A,c=linear_fit(xs,ys,x0,g)
[?2004l[?2004h>                 if sse < best[0]:
[?2004l[?2004h>                     best=(sse,x0,g,A,c)
[?2004l[?2004h>                 g += 1.0
[?2004l[?2004h>         x0 += 1.0
[?2004l[?2004h>     sse,x0,g,A,c=best
[?2004l[?2004h>     sx=1.0; sg=1.0
[?2004l[?2004h>     while sx > 1e-5 or sg > 1e-5:
[?2004l[?2004h>         improved=False
[?2004l[?2004h>         for dx,dg in ((sx,0.0),(-sx,0.0),(0.0,sg),(0.0,-sg),(sx,sg),(sx,-sg),(-sx,sg),(-sx,-sg)):
[?2004l[?2004h>             x0t=x0+dx; gt=g+dg
[?2004l[?2004h>             if not (lo <= x0t <= hi) or gt <= 0.0:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             sse_t,A_t,c_t=linear_fit(xs,ys,x0t,gt)
[?2004l[?2004h>             if sse_t < sse:
[?2004l[?2004h>                 sse,x0,g,A,c=sse_t,x0t,gt,A_t,c_t
[?2004l[?2004h>                 improved=True
[?2004l[?2004h>         if not improved:
[?2004l[?2004h>             sx*=0.5; sg*=0.5
[?2004l[?2004h>     return {'x0':x0,'gamma':g,'amplitude':A,'offset':c}, sse
