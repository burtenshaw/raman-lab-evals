[?2004l[?2004h>     for it in range(300):
[?2004l[?2004h>         J=[[0.0]*4 for _ in range(4)]
[?2004l[?2004h>         r=[0.0]*4
[?2004l[?2004h>         cost=0.0
[?2004l[?2004h>         for x,y in zip(xw,yw):
[?2004l[?2004h>             den=(x-p[2])**2+p[1]**2
[?2004l[?2004h>             e=model(p,x)-y
[?2004l[?2004h>             cost+=e*e
[?2004l[?2004h>             d=[p[1]*p[1]/den,
[?2004l[?2004h>                2.0*p[0]*p[1]*(x-p[2])**2/(den*den),
[?2004l[?2004h>                2.0*p[0]*p[1]*p[1]*(x-p[2])/(den*den),
[?2004l[?2004h>                1.0]
[?2004l[?2004h>             for i in range(4):
[?2004l[?2004h>                 r[i]+=d[i]*e
[?2004l[?2004h>                 for j in range(4):
[?2004l[?2004h>                     J[i][j]+=d[i]*d[j]
[?2004l[?2004h>         for i in range(4):
[?2004l[?2004h>             J[i][i]+=lam*max(J[i][i],1e-12)
[?2004l[?2004h>         M=[J[i][:]+[r[i]] for i in range(4)]
[?2004l[?2004h>         ok=True
[?2004l[?2004h>         for col in range(4):
[?2004l[?2004h>             piv=max(range(col,4),key=lambda rr: abs(M[rr][col]))
[?2004l[?2004h>             if abs(M[piv][col])<1e-18:
[?2004l[?2004h>                 ok=False
[?2004l[?2004h>                 break
[?2004l[?2004h>             M[col],M[piv]=M[piv],M[col]
[?2004l[?2004h>             pv=M[col][col]
[?2004l[?2004h>             for j in range(col,5):
[?2004l[?2004h>                 M[col][j]/=pv
[?2004l[?2004h>             for rr in range(4):
[?2004l[?2004h>                 if rr==col:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 fac=M[rr][col]
[?2004l[?2004h>                 for j in range(col,5):
[?2004l[?2004h>                     M[rr][j]-=fac*M[col][j]
[?2004l[?2004h>         if not ok:
[?2004l[?2004h>             lam*=10.0
[?2004l[?2004h>             continue
[?2004l[?2004h>         dlt=[M[i][4] for i in range(4)]
[?2004l[?2004h>         pn=[p[i]+dlt[i] for i in range(4)]
[?2004l[?2004h>         if pn[0]<=0 or pn[1]<=0:
[?2004l[?2004h>             lam*=10.0
[?2004l[?2004h>             continue
[?2004l[?2004h>         nc=sse(xw,yw,pn)
[?2004l[?2004h>         if nc<cost:
[?2004l[?2004h>             p=pn
[?2004l[?2004h>             lam=max(lam*0.3,1e-15)
[?2004l[?2004h>             if sum(v*v for v in dlt)<1e-18:
[?2004l[?2004h>                 break
[?2004l[?2004h>         else:
[?2004l[?2004h>             lam=min(lam*3.0,1e15)
[?2004l[?2004h>     return p,cost
