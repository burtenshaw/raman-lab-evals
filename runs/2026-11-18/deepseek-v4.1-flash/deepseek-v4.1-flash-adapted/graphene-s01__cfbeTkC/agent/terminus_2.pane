[?2004l[?2004h> 
[?2004l[?2004h> def model(p,x):
[?2004l[?2004h>     A,g,x0,b=p
[?2004l[?2004h>     return A*g*g/((x-x0)**2+g*g)+b
[?2004l[?2004h> 
[?2004l[?2004h> def linfit(xw,yw,x0,g):
[?2004l[?2004h>     us=[g*g/((x-x0)**2+g*g) for x in xw]
[?2004l[?2004h>     n=len(xw); suu=sum(u*u for u in us); su=sum(us)
[?2004l[?2004h>     suy=sum(u*y for u,y in zip(us,yw)); sy=sum(yw)
[?2004l[?2004h>     det=n*suu-su*su
[?2004l[?2004h>     if abs(det)<1e-20:
[?2004l[?2004h>         return None
[?2004l[?2004h>     A=(n*suy-su*sy)/det
[?2004l[?2004h>     b=(suu*sy-su*suy)/det
[?2004l[?2004h>     return A,b
[?2004l[?2004h> 
[?2004l[?2004h> def sse(xw,yw,p):
[?2004l[?2004h>     return sum((model(p,x)-y)**2 for x,y in zip(xw,yw))
[?2004l[?2004h> PY
