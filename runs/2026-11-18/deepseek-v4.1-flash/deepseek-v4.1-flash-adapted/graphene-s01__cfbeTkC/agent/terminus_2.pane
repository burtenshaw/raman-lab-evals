[?2004l[?2004h> def fit_peak(xw,yw,center,hw):
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for ix in range(-30,31):
[?2004l[?2004h>         x0=center+ix*0.5
[?2004l[?2004h>         for ig in range(1,121):
[?2004l[?2004h>             g=ig*0.5
[?2004l[?2004h>             ab=linfit(xw,yw,x0,g)
[?2004l[?2004h>             if ab is None:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             A,b=ab
[?2004l[?2004h>             if A<=0:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             p=[A,g,x0,b]
[?2004l[?2004h>             e=sse(xw,yw,p)
[?2004l[?2004h>             if best is None or e<best[0]:
[?2004l[?2004h>                 best=(e,p)
[?2004l[?2004h>     p=best[1]
[?2004l[?2004h>     lam=1e-3
[?2004l[?2004h> PY
