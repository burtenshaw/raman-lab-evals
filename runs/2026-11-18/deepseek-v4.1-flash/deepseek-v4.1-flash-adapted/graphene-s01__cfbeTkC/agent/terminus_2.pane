[?2004l[?2004h> import csv, json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/spectrum.csv') as f:
[?2004l[?2004h>     rows = list(csv.reader(f))[1:]
[?2004l[?2004h> x = np.array([float(r[0]) for r in rows])
[?2004l[?2004h> y = np.array([float(r[1]) for r in rows])
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> out = {}
[?2004l[?2004h> for name, center, half_width in [('D', 1350, 70), ('G', 1580, 80), ('2D', 2690, 110)]:
[?2004l[?2004h>     mask = np.abs(x - center) <= half_width
[?2004l[?2004h>     xw, yw = x[mask], y[mask]
[?2004l[?2004h>     b0 = np.percentile(yw, 10)
[?2004l[?2004h>     a0 = yw.max() - b0
[?2004l[?2004h>     p0 = [a0, 10.0, center, b0]
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, xw, yw, p0=p0, maxfev=20000)
[?2004l[?2004h>     amplitude, gamma, x0, offset = map(float, popt)
[?2004l[?2004h>     out[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amplitude, 'offset': offset}
[?2004l[?2004h> 
[?2004l[?2004h> out['ID_IG'] = out['D']['amplitude'] / out['G']['amplitude']
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(out, f, indent=2)
[?2004l[?2004h> print(json.dumps(out, indent=2))
