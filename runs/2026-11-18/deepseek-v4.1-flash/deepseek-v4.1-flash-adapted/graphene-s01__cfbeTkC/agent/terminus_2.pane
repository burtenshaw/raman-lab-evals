[?2004l[?2004h> import csv, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/spectrum.csv') as f:
[?2004l[?2004h>     rows=list(csv.reader(f))[1:]
[?2004l[?2004h> x=np.array([float(r[0]) for r in rows])
[?2004l[?2004h> y=np.array([float(r[1]) for r in rows])
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x,A,g,x0,b):
[?2004l[?2004h>     return A*g*g/((x-x0)**2+g*g)+b
[?2004l[?2004h> 
[?2004l[?2004h> for name,center,hw in [('D',1350,70),('G',1580,80),('2D',2690,110)]:
[?2004l[?2004h>     m=np.abs(x-center)<=hw
[?2004l[?2004h>     xw=x[m]; yw=y[m]
[?2004l[?2004h>     b0=np.percentile(yw,10)
[?2004l[?2004h>     A0=yw.max()-b0
[?2004l[?2004h>     g0=10
[?2004l[?2004h>     p0=[A0,g0,center,b0]
[?2004l[?2004h>     popt,pcov=curve_fit(lor,xw,yw,p0=p0,maxfev=20000)
[?2004l[?2004h>     pred=lor(xw,*popt)
[?2004l[?2004h>     rms=np.sqrt(np.mean((yw-pred)**2))
[?2004l[?2004h>     print(name, 'popt', popt, 'rms', rms, 'pcov diag', np.diag(pcov))
