[194.498054, "o", "\u001b[?2004h> "]
[194.498115, "o", "    rows = list(csv.reader(f))[1:]\r\n\u001b[?2004l\r"]
[194.498147, "o", "\u001b[?2004h"]
[194.498181, "o", "> "]
[194.498236, "o", "x = np.array([float(r[0]) for r in rows])\r\n\u001b[?2004l\r"]
[194.498264, "o", "\u001b[?2004h> "]
[194.498345, "o", "y = np.array([float(r[1]) for r in rows])\r\n\u001b[?2004l\r"]
[194.49838, "o", "\u001b[?2004h"]
[194.498418, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[194.498451, "o", "> "]
[194.498506, "o", "def lorentzian(x, amplitude, gamma, x0, offset):\r\n\u001b[?2004l\r"]
[194.498535, "o", "\u001b[?2004h> "]
[194.498665, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[194.498692, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[194.498726, "o", "\u001b[?2004h> "]
[194.498758, "o", "out = {}\r\n\u001b[?2004l\r"]
[194.498794, "o", "\u001b[?2004h> "]
[194.498939, "o", "for name, center, half_width in [('D', 1350, 70), ('G', 1580, 80), ('2D', 2690, 110)]:\r\n\u001b[?2004l\r"]
[194.498985, "o", "\u001b[?2004h> "]
[194.499051, "o", "    mask = np.abs(x - center) <= half_width\r\n\u001b[?2004l\r"]
[194.4991, "o", "\u001b[?2004h> "]
[194.499136, "o", "    xw, yw = x[mask], y[mask]\r\n\u001b[?2004l\r"]
[194.49917, "o", "\u001b[?2004h"]
[194.499197, "o", "> "]
[194.499235, "o", "    b0 = np.percentile(yw, 10)\r\n\u001b[?2004l\r"]
[194.499262, "o", "\u001b[?2004h"]
[194.499288, "o", "> "]
[194.499319, "o", "    a0 = yw.max() - b0\r\n\u001b[?2004l\r"]
[194.499347, "o", "\u001b[?2004h> "]
[194.499433, "o", "    p0 = [a0, 10.0, center, b0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[194.499533, "o", "> "]
[194.499583, "o", "    popt, _ = curve_fit(lorentzian, xw, yw, p0=p0, maxfev=20000)\r\n\u001b[?2004l\r"]
[194.499618, "o", "\u001b[?2004h> "]
[194.499714, "o", "    amplitude, gamma, x0, offset = map(float, popt)\r\n\u001b[?2004l\r"]
[194.499754, "o", "\u001b[?2004h> "]
[194.499908, "o", "    out[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amplitude, 'offset': offset}\r\n\u001b[?2004l\r"]
[194.499939, "o", "\u001b[?2004h> "]
[194.499968, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.500088, "o", "out['ID_IG'] = out['D']['amplitude'] / out['G']['amplitude']\r\n\u001b[?2004l\r"]
[194.50012, "o", "\u001b[?2004h> "]
[194.500203, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[194.500246, "o", "\u001b[?2004h> "]
[194.50031, "o", "    json.dump(out, f, indent=2)\r\n\u001b[?2004l\r"]
[194.500343, "o", "\u001b[?2004h> "]
[194.500407, "o", "print(json.dumps(out, indent=2))\r\n\u001b[?2004l\r"]
[194.500438, "o", "\u001b[?2004h> "]
