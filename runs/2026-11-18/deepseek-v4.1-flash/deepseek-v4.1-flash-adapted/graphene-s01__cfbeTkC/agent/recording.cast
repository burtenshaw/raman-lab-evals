[145.539824, "i", "cat > /app/fit_spectrum.py <<'PY'\nimport csv, json\n\nwith open('/app/spectrum.csv') as f:\n    rows=list(csv.reader(f))[1:]\nxs=[float(r[0]) for r in rows]\nys=[float(r[1]) for r in rows]\n\ndef model(p,x):\n    A,g,x0,b=p\n    return A*g*g/((x-x0)**2+g*g)+b\n\ndef linfit(xw,yw,x0,g):\n    us=[g*g/((x-x0)**2+g*g) for x in xw]\n    n=len(xw); suu=sum(u*u for u in us); su=sum(us)\n    suy=sum(u*y for u,y in zip(us,yw)); sy=sum(yw)\n    det=n*suu-su*su\n    if abs(det)<1e-20:\n        return None\n    A=(n*suy-su*sy)/det\n    b=(suu*sy-su*suy)/det\n    return A,b\n\ndef sse(xw,yw,p):\n    return sum((model(p,x)-y)**2 for x,y in zip(xw,yw))\nPY\n"]
