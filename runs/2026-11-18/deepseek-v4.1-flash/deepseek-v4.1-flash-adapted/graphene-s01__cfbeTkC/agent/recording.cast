[168.613716, "i", "python3 -m pip install numpy scipy -q\n"]
[168.613889, "o", "python3 -m pip install numpy scipy -q"]
[168.614001, "o", "\r\n\u001b[?2004l\r"]
[176.960237, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[176.961238, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m26.2.2\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.3\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[177.032467, "o", "\u001b[?2004hroot@j-openenv-6afd8b10e5cad0e4dc3e6bf2-983o2qui-4699e-6nhn9:/app# "]
[186.770502, "i", "python3 - <<'PY'\nimport csv, numpy as np\nfrom scipy.optimize import curve_fit\n\nwith open('/app/spectrum.csv') as f:\n    rows=list(csv.reader(f))[1:]\nx=np.array([float(r[0]) for r in rows])\ny=np.array([float(r[1]) for r in rows])\n\ndef lor(x,A,g,x0,b):\n    return A*g*g/((x-x0)**2+g*g)+b\n\nfor name,center,hw in [('D',1350,70),('G',1580,80),('2D',2690,110)]:\n    m=np.abs(x-center)<=hw\n    xw=x[m]; yw=y[m]\n    b0=np.percentile(yw,10)\n    A0=yw.max()-b0\n    g0=10\n    p0=[A0,g0,center,b0]\n    popt,pcov=curve_fit(lor,xw,yw,p0=p0,maxfev=20000)\n    pred=lor(xw,*popt)\n    rms=np.sqrt(np.mean((yw-pred)**2))\n    print(name, 'popt', popt, 'rms', rms, 'pcov diag', np.diag(pcov))\nPY\n"]
[186.770639, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[186.770675, "o", "\u001b[?2004h> "]
