[145.601011, "o", "    lam=1e-3\r\n\u001b[?2004l\r"]
[145.601033, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[145.602266, "o", "\u001b[?2004hroot@j-openenv-6afd8b10e5cad0e4dc3e6bf2-983o2qui-4699e-6nhn9:/app# "]
[145.702064, "i", "cat >> /app/fit_spectrum.py <<'PY'\n    for it in range(300):\n        J=[[0.0]*4 for _ in range(4)]\n        r=[0.0]*4\n        cost=0.0\n        for x,y in zip(xw,yw):\n            den=(x-p[2])**2+p[1]**2\n            e=model(p,x)-y\n            cost+=e*e\n            d=[p[1]*p[1]/den,\n               2.0*p[0]*p[1]*(x-p[2])**2/(den*den),\n               2.0*p[0]*p[1]*p[1]*(x-p[2])/(den*den),\n               1.0]\n            for i in range(4):\n                r[i]+=d[i]*e\n                for j in range(4):\n                    J[i][j]+=d[i]*d[j]\n        for i in range(4):\n            J[i][i]+=lam*max(J[i][i],1e-12)\n        M=[J[i][:]+[r[i]] for i in range(4)]\n        ok=True\n        for col in range(4):\n            piv=max(range(col,4),key=lambda rr: abs(M[rr][col]))\n            if abs(M[piv][col])<1e-18:\n                ok=False\n                break\n            M[col],M[piv]=M[piv],M[col]\n            pv=M[col][col]\n            for j in range(col,5):\n                M[col][j]/=pv\n            for rr in range(4):\n        "]
[145.702177, "i", "        if rr==col:\n                    continue\n                fac=M[rr][col]\n                for j in range(col,5):\n                    M[rr][j]-=fac*M[col][j]\n        if not ok:\n            lam*=10.0\n            continue\n        dlt=[M[i][4] for i in range(4)]\n        pn=[p[i]+dlt[i] for i in range(4)]\n        if pn[0]<=0 or pn[1]<=0:\n            lam*=10.0\n            continue\n        nc=sse(xw,yw,pn)\n        if nc<cost:\n            p=pn\n            lam=max(lam*0.3,1e-15)\n            if sum(v*v for v in dlt)<1e-18:\n                break\n        else:\n            lam=min(lam*3.0,1e15)\n    return p,cost\nPY\n"]
