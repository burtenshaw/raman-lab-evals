[186.770728, "o", "\u001b[?2004h> "]
[186.770828, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.770894, "o", "\u001b[?2004h> "]
