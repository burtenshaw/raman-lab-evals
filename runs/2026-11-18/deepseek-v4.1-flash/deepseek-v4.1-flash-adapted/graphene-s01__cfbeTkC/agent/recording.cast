[145.59986, "i", "cat >> /app/fit_spectrum.py <<'PY'\n\ndef fit_peak(xw,yw,center,hw):\n    best=None\n    for ix in range(-30,31):\n        x0=center+ix*0.5\n        for ig in range(1,121):\n            g=ig*0.5\n            ab=linfit(xw,yw,x0,g)\n            if ab is None:\n                continue\n            A,b=ab\n            if A<=0:\n                continue\n            p=[A,g,x0,b]\n            e=sse(xw,yw,p)\n            if best is None or e<best[0]:\n                best=(e,p)\n    p=best[1]\n    lam=1e-3\nPY\n"]
