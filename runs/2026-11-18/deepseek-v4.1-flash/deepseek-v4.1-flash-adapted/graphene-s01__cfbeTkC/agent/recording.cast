[186.771382, "o", "> "]
[186.771463, "o", "for name,center,hw in [('D',1350,70),('G',1580,80),('2D',2690,110)]:\r\n\u001b[?2004l\r"]
[186.771499, "o", "\u001b[?2004h> "]
[186.771536, "o", "    m=np.abs(x-center)<=hw\r\n\u001b[?2004l\r"]
[186.771559, "o", "\u001b[?2004h> "]
[186.7716, "o", "    xw=x[m]; yw=y[m]\r\n\u001b[?2004l\r"]
[186.771633, "o", "\u001b[?2004h> "]
