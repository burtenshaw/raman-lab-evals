[194.497468, "i", "python3 - <<'PY'\nimport csv, json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nwith open('/app/spectrum.csv') as f:\n    rows = list(csv.reader(f))[1:]\nx = np.array([float(r[0]) for r in rows])\ny = np.array([float(r[1]) for r in rows])\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nout = {}\nfor name, center, half_width in [('D', 1350, 70), ('G', 1580, 80), ('2D', 2690, 110)]:\n    mask = np.abs(x - center) <= half_width\n    xw, yw = x[mask], y[mask]\n    b0 = np.percentile(yw, 10)\n    a0 = yw.max() - b0\n    p0 = [a0, 10.0, center, b0]\n    popt, _ = curve_fit(lorentzian, xw, yw, p0=p0, maxfev=20000)\n    amplitude, gamma, x0, offset = map(float, popt)\n    out[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amplitude, 'offset': offset}\n\nout['ID_IG'] = out['D']['amplitude'] / out['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint(json.dumps(out, indent=2))\nPY\n"]
[194.497616, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[194.497667, "o", "\u001b[?2004h"]
