[145.844165, "i", "cat >> /app/fit_spectrum.py <<'PY'\n\nout={}\nfor name,center,hw in [('D',1350,70),('G',1580,80),('2D',2690,110)]:\n    xw=[x for x in xs if abs(x-center)<=hw]\n    yw=[y for x,y in zip(xs,ys) if abs(x-center)<=hw]\n    p,c=fit_peak(xw,yw,center,hw)\n    out[name]={'x0':p[2],'gamma':p[1],'amplitude':p[0],'offset':p[3]}\n    print(name,p,c)\nout['ID_IG']=out['D']['amplitude']/out['G']['amplitude']\nwith open('/app/results.json','w') as f:\n    json.dump(out,f,indent=2)\nprint('ID_IG',out['ID_IG'])\nPY\n"]
