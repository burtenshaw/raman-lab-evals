[168.115469, "i", "python3 - <<'PY'\nimport csv, json, math\nwith open('spectrum.csv') as f:\n    rows=list(csv.reader(f))[1:]\nxs=[float(r[0]) for r in rows]; ys=[float(r[1]) for r in rows]\nwith open('results.json') as f:\n    res=json.load(f)\nfor name, center, hw in [('D',1350,60),('G',1580,60),('2D',2690,90)]:\n    p=res[name]\n    print('\\n',name,p)\n    pts=[(x,y) for x,y in zip(xs,ys) if abs(x-center)<=hw]\n    # print every 10th point\n    for x,y in pts[::10]:\n        pred=p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)+p['offset']\n        print(f'{x:9.3f} {y:10.3f} {pred:10.3f} {y-pred:10.3f}')\nPY\n"]
