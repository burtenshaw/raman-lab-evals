[7.588098, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\nprint('n', len(xs), 'xmin', min(xs), 'xmax', max(xs), 'ymin', min(ys), 'ymax', max(ys))\nfor center in (1350,1580,2690):\n    vals=[(x,y) for x,y in zip(xs,ys) if abs(x-center)<80]\n    mx=max(vals,key=lambda p:p[1])\n    print(center, 'window max', mx)\nPY\n"]
