def fit_lm(x, y, p0, maxiter=400):
    p = p0[:]
    npar = 4
    # scale parameters so LM steps are well balanced
    scale = [max(100.0, max(y)), max(1.0, p[1]), 1.0, max(100.0, max(y))]
