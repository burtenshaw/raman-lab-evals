[249.501516, "i", "python3 - <<'PY'\nimport csv, json\nwith open('/app/spectrum.csv') as f:\n    rows = list(csv.reader(f))\ndata = [(float(a), float(b)) for a, b in rows[1:]]\n\ndef fit_linear(xs, ys, x0, g):\n    g2 = g * g\n    fs = []\n    Sf = Sff = Sfy = Sy = Syy = 0.0\n    for x, y in zip(xs, ys):\n        f = g2 / ((x - x0) ** 2 + g2)\n        fs.append(f)\n        Sf += f\n        Sff += f * f\n        Sfy += f * y\n        Sy += y\n        Syy += y * y\n    n = len(xs)\n    det = n * Sff - Sf * Sf\n    if det <= 0.0:\n        return None\n    A = (n * Sfy - Sf * Sy) / det\n    c = (Sff * Sy - Sf * Sfy) / det\n    if A <= 0.0 or c < 0.0:\n        return None\n    sse = sum((A * f + c - y) ** 2 for f, y in zip(fs, ys))\n    return A, c, sse\n\ndef scan(xs, ys, x0s, gs):\n    best = None\n    for g in gs:\n        for x0 in x0s:\n            if x0 <= xs[0] or x0 >= xs[-1]:\n                continue\n            r = fit_linear(xs, ys, x0, g)\n            if r is not None and (best is None or r[2] < best[4]):\n                best = (r[0], g, x0, r[1], r[2])\n"]
[249.501702, "i", "    return best\n\ndef fit_peak(xs, ys):\n    imax = max(range(len(ys)), key=lambda i: ys[i])\n    x0c = xs[imax]\n    best = scan(xs, ys, [x0c + 0.2 * k for k in range(-25, 26)], [float(g) for g in range(2, 101)])\n    best = scan(xs, ys, [best[2] + 0.02 * k for k in range(-25, 26)], [best[1] + 0.05 * k for k in range(-20, 21)])\n    best = scan(xs, ys, [best[2] + 0.002 * k for k in range(-25, 26)], [best[1] + 0.005 * k for k in range(-20, 21)])\n    return best\n\nwindows = {'D': (1250.0, 1450.0), 'G': (1500.0, 1650.0), '2D': (2550.0, 2800.0)}\nresults = {}\nfor name, (lo, hi) in windows.items():\n    xs = [x for x, y in data if lo <= x <= hi]\n    ys = [y for x, y in data if lo <= x <= hi]\n    A, g, x0, c, sse = fit_peak(xs, ys)\n    results[name] = {'x0': x0, 'gamma': g, 'amplitude': A, 'offset': c}\n    print(name, results[name], 'SSE', sse)\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG', results['ID_IG'])\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent="]
