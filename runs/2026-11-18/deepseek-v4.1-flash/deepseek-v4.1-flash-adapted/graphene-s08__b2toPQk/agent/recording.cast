[87.918128, "i", " in range(len(x)))\n            JTr[k] = sum(Jq[k][i]*r[i] for i in range(len(x)))\n        # check gradient\n        if max(abs(v) for v in JTr) < 1e-10:\n            break\n        diag = [max(JTJ[i][i], 1e-15) for i in range(npar)]\n        accepted = False\n        for _ in range(50):\n            M = [[JTJ[i][j] + (lam*diag[i] if i == j else 0.0) for j in range(npar)] for i in range(npar)]\n            try:\n                delta = solve_linear(M, [-v for v in JTr])\n            except ZeroDivisionError:\n                lam *= 10.0\n                continue\n            qnew = [q[i] + delta[i] for i in range(npar)]\n            pnew = [base[i] + scale[i]*qnew[i] for i in range(npar)]\n            if pnew[1] <= 0.05:\n                lam *= 10.0\n                continue\n            snew = sse(pnew, x, y)\n            if snew < s - 1e-12*max(1.0, s):\n                p = pnew\n                q = qnew\n                s = snew\n                lam = max(lam*0.3, 1e-12)\n                accepted = True\n                break\n    "]
