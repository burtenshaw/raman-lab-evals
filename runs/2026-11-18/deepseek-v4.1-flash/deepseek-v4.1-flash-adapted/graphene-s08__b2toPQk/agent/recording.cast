[52.610404, "i", "python3 - <<'PY'\nimport csv\nwith open('spectrum.csv') as f:\n    r = csv.reader(f)\n    next(r)\n    data = [(float(a), float(b)) for a, b in r]\nfor name, lo, hi in [('D', 1250, 1450), ('G', 1500, 1650), ('2D', 2550, 2800)]:\n    w = [(x, y) for x, y in data if lo <= x <= hi]\n    xm, ym = max(w, key=lambda p: p[1])\n    print(name, 'max at', xm, ym, 'min', min(y for x, y in w), 'max', max(y for x, y in w), 'n', len(w))\nPY\n"]
