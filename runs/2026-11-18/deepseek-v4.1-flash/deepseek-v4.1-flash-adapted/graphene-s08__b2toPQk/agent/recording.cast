[87.918743, "o", "m *= 10.0\r\n                continue\r\n            snew = sse(pnew, x, y)\r\n            if snew < s - 1e-12*max(1.0, s):\r\n     "]
[87.918777, "o", "           p = pnew\r\n                q = qnew\r\n                s = snew\r\n                lam = max("]
[87.918807, "o", "lam*0.3, 1e-12)\r\n                accepted = True\r\n                br"]
[87.918825, "o", "eak\r\n            else:\r\n     "]
[87.918863, "o", "           lam *= 10.0\r\n        if\u001b[?2004h"]
[87.918894, "o", "> "]
[87.918954, "o", "with open('spectrum.csv') as f:\r\n\u001b[?2004l\r"]
[87.918987, "o", "\u001b[?2004h> "]
[87.919072, "o", "    r = csv.reader(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.919112, "o", "    next(r)\r\n\u001b[?2004l\r"]
[87.919129, "o", "\u001b[?2004h> "]
[87.919308, "o", "    data = [(float(a), float(b)) for a, b in r]\r\n\u001b[?2004l\r"]
[87.919336, "o", "\u001b[?2004h> "]
[87.919382, "o", "xs = [p[0] for p in data]\r\n\u001b[?2004l\r"]
[87.919398, "o", "\u001b[?2004h> "]
[87.919485, "o", "ys = [p[1] for p in data]\r\n\u001b[?2004l\r"]
[87.919515, "o", "\u001b[?2004h> "]
[87.919537, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.919584, "o", "# Lorentzian plus constant offset\r\n\u001b[?2004l\r"]
[87.919608, "o", "\u001b[?2004h> "]
[87.919682, "o", "# I = amp * gamma^2 / ((x-x0)^2 + gamma^2) + offset\r\n\u001b[?2004l\r"]
[87.919724, "o", "\u001b[?2004h> "]
[87.919747, "o", "def model(p, x):\r\n\u001b[?2004l\r"]
[87.91977, "o", "\u001b[?2004h> "]
[87.919805, "o", "    A, g, x0, c = p\r\n\u001b[?2004l\r"]
[87.919816, "o", "\u001b[?2004h> "]
[87.919921, "o", "    d = (x - x0)**2 + g*g\r\n\u001b[?2004l\r"]
[87.919931, "o", "\u001b[?2004h> "]
[87.920024, "o", "    return A*g*g/d + c\r\n\u001b[?2004l\r"]
[87.920052, "o", "\u001b[?2004h> "]
[87.920092, "o", "\r\n\u001b[?2004l\rf\u001b[?2004h"]
[87.920132, "o", "> "]
[87.920165, "o", "def jacobian(p, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.920205, "o", "    A, g, x0, c = p\r\n\u001b[?2004l\r"]
[87.920227, "o", "\u001b[?2004h> "]
[87.920288, "o", "    d = (x - x0)**2 + g*g\r\n\u001b[?2004l\r"]
[87.92032, "o", "\u001b[?2004h> "]
[87.920355, "o", "    d2 = d*d\r\n\u001b[?2004l\r"]
[87.920386, "o", "\u001b[?2004h> "]
[87.920414, "o", "    g2 = g*g\r\n\u001b[?2004l\r"]
[87.920445, "o", "\u001b[?2004h> "]
[87.920479, "o", "    return [\r\n\u001b[?2004l\r"]
[87.920505, "o", "\u001b[?2004h> "]
[87.920558, "o", "        g2/d,\r\n\u001b[?2004l\r"]
[87.920589, "o", "\u001b[?2004h> "]
[87.920646, "o", "        2.0*A*g*(x-x0)**2/d2,\r\n\u001b[?2004l\r"]
[87.920681, "o", "\u001b[?2004h> "]
[87.920737, "o", "        2.0*A*g2*(x-x0)/d2,\r\n\u001b[?2004l\r"]
[87.920769, "o", "\u001b[?2004h> "]
[87.920826, "o", "        1.0,\r\n\u001b[?2004l\r"]
[87.920845, "o", "\u001b[?2004h"]
[87.920878, "o", "> "]
[87.920903, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.92093, "o", "\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[87.920963, "o", "def sse(p, x, y):\r\n\u001b[?2004l\r  \u001b[?2004h"]
[87.920989, "o", "> "]
[87.921092, "o", "    return sum((model(p, xi) - yi)**2 for xi, yi in zip(x, y))\r\n\u001b[?2004l\r"]
[87.921119, "o", "\u001b[?2004h> "]
[87.921143, "o", "\r\n\u001b[?2004l\rt\u001b[?2004h"]
[87.921166, "o", "> "]
[87.921192, "o", "def solve_linear(A, b):\r\n\u001b[?2004l\r"]
[87.921216, "o", "\u001b[?2004h> "]
[87.921257, "o", "    n = len(b)\r\n\u001b[?2004l\r"]
[87.921273, "o", "\u001b[?2004h> "]
[87.92136, "o", "    M = [A[i][:] + [b[i]] for i in range(n)]\r\n\u001b[?2004l\re"]
[87.921385, "o", "\u001b[?2004h> "]
[87.921417, "o", "    for col in range(n):\r\n\u001b[?2004l\r"]
[87.921441, "o", "\u001b[?2004h> "]
[87.921622, "o", "        piv = max(range(col, n), key=lambda r: abs(M[r][col]))\r\n\u001b[?2004l\r"]
[87.921648, "o", "\u001b[?2004h> "]
[87.921778, "o", "        if abs(M[piv][col]) < 1e-15:\r\n\u001b[?2004l\r"]
[87.921806, "o", "\u001b[?2004h> "]
[87.92187, "o", "            raise ZeroDivisionError('singular matrix')\r\n\u001b[?2004l\r"]
[87.921889, "o", "\u001b[?2004h> "]
[87.921912, "o", "        if piv != col:\r\n\u001b[?2004l\r"]
[87.921937, "o", "\u001b[?2004h> "]
[87.921985, "o", "            M[col], M[piv] = M[piv], M[col]\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.922014, "o", "> "]
[87.922041, "o", "        pv = M[col][col]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.922089, "o", "        for r in range(col+1, n):\r\n\u001b[?2004l\r"]
[87.922116, "o", "\u001b[?2004h> "]
[87.922144, "o", "            f = M[r][col] / pv\r\n\u001b[?2004l\r"]
[87.922169, "o", "\u001b[?2004h> "]
[87.922195, "o", "            if f != 0.0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.922223, "o", "> "]
[87.92226, "o", "                for k in range(col, n+1):\r\n\u001b[?2004l\r"]
[87.922285, "o", "\u001b[?2004h> "]
[87.922332, "o", "                    M[r][k] -= f * M[col][k]\r\n\u001b[?2004l\r"]
[87.922357, "o", "\u001b[?2004h> "]
[87.92238, "o", "    x = [0.0]*n\r\n\u001b[?2004l\r"]
[87.922405, "o", "\u001b[?2004h> "]
[87.922432, "o", "    for i in range(n-1, -1, -1):\r\n\u001b[?2004l\r"]
[87.922457, "o", "\u001b[?2004h> "]
[87.922516, "o", "        s = M[i][n] - sum(M[i][j]*x[j] for j in range(i+1, n))\r\n\u001b[?2004l\r"]
[87.92254, "o", "\u001b[?2004h> "]
[87.92257, "o", "        x[i] = s / M[i][i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.922599, "o", "    return x\r\n\u001b[?2004l\r"]
[87.922622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[87.922639, "o", "\u001b[?2004h> "]
[87.922664, "o", "def initial_guess(x, y):\r\n"]
[87.922688, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.922742, "o", "    imax = max(range(len(y)), key=lambda i: y[i])\r\n\u001b[?2004l\r"]
[87.92276, "o", "\u001b[?2004h> "]
[87.922785, "o", "    x0 = x[imax]\r\n\u001b[?2004l\r"]
[87.922801, "o", "\u001b[?2004h> "]
[87.922837, "o", "    peak = y[imax]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.922861, "o", "    c0 = min(y)\r\n\u001b[?2004l\r"]
[87.922886, "o", "\u001b[?2004h> "]
[87.922913, "o", "    half = c0 + 0.5*(peak - c0)\r\n\u001b[?2004l\r"]
[87.922938, "o", "\u001b[?2004h> "]
[87.922973, "o", "    # left half-max crossing\r\n\u001b[?2004l\r"]
[87.922997, "o", "\u001b[?2004h> "]
[87.923014, "o", "    xl = x[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.923048, "o", "    for i in range(imax-1, -1, -1):\r\n\u001b[?2004l\r"]
[87.923072, "o", "\u001b[?2004h> "]
[87.923094, "o", "        if y[i] <= half:\r\n\u001b[?2004l\r"]
[87.923118, "o", "\u001b[?2004h> "]
[87.923185, "o", "            xl = x[i] + (x[i+1]-x[i])*(half-y[i])/(y[i+1]-y[i])\r\n\u001b[?2004l\r"]
[87.923209, "o", "\u001b[?2004h> "]
[87.923234, "o", "            break\r\n\u001b[?2004l\r"]
[87.923257, "o", "\u001b[?2004h> "]
[87.923274, "o", "    xr = x[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.923323, "o", "    for i in range(imax+1, len(y)):\r\n\u001b[?2004l\r"]
[87.92334, "o", "\u001b[?2004h> "]
[87.923369, "o", "        if y[i] <= half:\r\n\u001b[?2004l\r"]
[87.923386, "o", "\u001b[?2004h> "]
[87.923463, "o", "            xr = x[i-1] + (x[i]-x[i-1])*(half-y[i-1])/(y[i]-y[i-1])\r\n\u001b[?2004l\r"]
[87.923487, "o", "\u001b[?2004h> "]
[87.923512, "o", "            break\r\n\u001b[?2004l\r"]
[87.923537, "o", "\u001b[?2004h> "]
[87.923568, "o", "    fwhm = max(0.1, xr-xl)\r\n\u001b[?2004l\r"]
[87.923596, "o", "\u001b[?2004h> "]
[87.923631, "o", "    gamma0 = fwhm/2.0\r\n\u001b[?2004l\r"]
[87.923655, "o", "\u001b[?2004h> "]
[87.923717, "o", "    if not (0.1 <= gamma0 <= 300):\r\n\u001b[?2004l\r"]
[87.923747, "o", "\u001b[?2004h> "]
[87.9238, "o", "        gamma0 = 15.0\r\n\u001b[?2004l\r"]
[87.923833, "o", "\u001b[?2004h> "]
[87.923931, "o", "    return [max(peak-c0, 1.0), gamma0, x0, c0]\r\n\u001b[?2004l\r"]
[87.923955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[87.923972, "o", "\u001b[?2004h> "]
[87.924057, "o", "def fit_peak(x, y, gammas=(5.0, 10.0, 20.0, 40.0, 80.0)):\r\n\u001b[?2004l\r"]
[87.924087, "o", "\u001b[?2004h> "]
[87.924124, "o", "    best = None\r\n\u001b[?2004l\r"]
[87.924155, "o", "\u001b[?2004h> "]
[87.924185, "o", "    for gamma0 in gammas:\r\n\u001b[?2004l\r"]
[87.924225, "o", "\u001b[?2004h> "]
[87.924277, "o", "        p0 = initial_guess(x, y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.924335, "o", "        p0[1] = gamma0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.924409, "o", "        p, s = fit_lm(x, y, p0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.924475, "o", "        if best is None or s < best[1]:\r\n\u001b[?2004l\r"]
[87.92451, "o", "\u001b[?2004h> "]
[87.924552, "o", "            best = (p, s)\r\n\u001b[?2004l\r"]
[87.924579, "o", "\u001b[?2004h"]
[87.924596, "o", "> "]
[87.92462, "o", "    return best[0]\r\n\u001b[?2004l\r"]
[87.924643, "o", "\u001b[?2004h"]
[87.924668, "o", "> \r\n\u001b[?2004l\r"]
[87.924689, "o", "\u001b[?2004h"]
[87.924714, "o", "> "]
[87.92476, "o", "def fit_lm(x, y, p0, maxiter=400):\r\n\u001b[?2004l\r"]
[87.924784, "o", "\u001b[?2004h> "]
[87.924806, "o", "    p = p0[:]\r\n\u001b[?2004l\r"]
[87.924829, "o", "\u001b[?2004h"]
[87.924847, "o", "> "]
[87.924864, "o", "    npar = 4\r\n\u001b[?2004l\r"]
[87.924882, "o", "\u001b[?2004h> "]
[87.924967, "o", "    # scale parameters so LM steps are well balanced\r\n\u001b[?2004l\r"]
[87.924991, "o", "\u001b[?2004h> "]
[87.925093, "o", "    scale = [max(100.0, max(y)), max(1.0, p[1]), 1.0, max(100.0, max(y))]\r\n\u001b[?2004l\r"]
[87.92511, "o", "\u001b[?2004h> "]
[87.925132, "o", "    base = p[:]\r\n\u001b[?2004l\r"]
[87.925156, "o", "\u001b[?2004h> "]
[87.925195, "o", "    q = [0.0]*npar\r\n\u001b[?2004l\r"]
[87.925225, "o", "\u001b[?2004h> "]
[87.925245, "o", "    lam = 1e-3\r\n\u001b[?2004l\r"]
[87.925267, "o", "\u001b[?2004h"]
[87.925288, "o", "> "]
[87.925314, "o", "    s = sse(p, x, y)\r\n\u001b[?2004l\r"]
[87.925339, "o", "\u001b[?2004h> "]
[87.925396, "o", "    for it in range(maxiter):\r\n\u001b[?2004l\r"]
[87.925412, "o", "\u001b[?2004h> "]
[87.9255, "o", "        # residual and Jacobian in original coordinates\r\n\u001b[?2004l\r"]
[87.925517, "o", "\u001b[?2004h> "]
[87.925608, "o", "        r = [model(p, xi) - yi for xi, yi in zip(x, y)]\r\n\u001b[?2004l\r"]
[87.925625, "o", "\u001b[?2004h> "]
[87.925689, "o", "        cols = jacobian(p, x)  # 4 x n\r\n\u001b[?2004l\r"]
[87.925705, "o", "\u001b[?2004h> "]
[87.925802, "o", "        # convert to scaled parameter q where p = base + scale*q\r\n\u001b[?2004l\r"]
[87.925832, "o", "\u001b[?2004h> "]
[87.92594, "o", "        Jq = [[cols[k][i]*scale[k] for i in range(len(x))] for k in range(npar)]\r\n\u001b[?2004l\r"]
[87.925968, "o", "\u001b[?2004h> "]
[87.926035, "o", "        JTJ = [[0.0]*npar for _ in range(npar)]\r\n\u001b[?2004l\r"]
[87.926065, "o", "\u001b[?2004h> "]
[87.926094, "o", "        JTr = [0.0]*npar\r\n\u001b[?2004l\r"]
[87.926127, "o", "\u001b[?2004h> "]
[87.926174, "o", "        for k in range(npar):\r\n\u001b[?2004l\r"]
[87.926206, "o", "\u001b[?2004h> "]
[87.926258, "o", "            for l in range(npar):\r\n\u001b[?2004l\r"]
[87.926283, "o", "\u001b[?2004h> "]
[87.926383, "o", "                JTJ[k][l] = sum(Jq[k][i]*Jq[l][i] for i in range(len(x)))\r\n\u001b[?2004l\r"]
[87.926406, "o", "\u001b[?2004h> "]
[87.926502, "o", "            JTr[k] = sum(Jq[k][i]*r[i] for i in range(len(x)))\r\n\u001b[?2004l\r"]
[87.926527, "o", "\u001b[?2004h> "]
[87.926554, "o", "        # check gradient\r\n\u001b[?2004l\r"]
[87.926585, "o", "\u001b[?2004h> "]
[87.926657, "o", "        if max(abs(v) for v in JTr) < 1e-10:\r\n\u001b[?2004l\r"]
[87.92668, "o", "\u001b[?2004h> "]
[87.926708, "o", "            break\r\n\u001b[?2004l\r"]
[87.926733, "o", "\u001b[?2004h> "]
[87.926821, "o", "        diag = [max(JTJ[i][i], 1e-15) for i in range(npar)]\r\n\u001b[?2004l\r"]
[87.92685, "o", "\u001b[?2004h> "]
[87.926883, "o", "        accepted = False\r\n\u001b[?2004l\r"]
[87.926914, "o", "\u001b[?2004h"]
[87.926937, "o", "> "]
[87.926971, "o", "        for _ in range(50):\r\n\u001b[?2004l\r"]
[87.926997, "o", "\u001b[?2004h> "]
[87.927135, "o", "            M = [[JTJ[i][j] + (lam*diag[i] if i == j else 0.0) for j in range(npar)] for i in range(npar)]\r\n\u001b[?2004l\r"]
[87.927166, "o", "\u001b[?2004h> "]
[87.927187, "o", "            try:\r\n\u001b[?2004l\r"]
[87.927217, "o", "\u001b[?2004h> "]
[87.927302, "o", "                delta = solve_linear(M, [-v for v in JTr])\r\n\u001b[?2004l\r"]
[87.927331, "o", "\u001b[?2004h> "]
[87.927381, "o", "            except ZeroDivisionError:\r\n\u001b[?2004l\r"]
[87.927398, "o", "\u001b[?2004h> "]
[87.927451, "o", "                lam *= 10.0\r\n\u001b[?2004l\r"]
[87.927484, "o", "\u001b[?2004h> "]
[87.927519, "o", "                continue\r\n\u001b[?2004l\r"]
[87.927554, "o", "\u001b[?2004h> "]
[87.927645, "o", "            qnew = [q[i] + delta[i] for i in range(npar)]\r\n\u001b[?2004l\r"]
[87.927667, "o", "\u001b[?2004h> "]
[87.927765, "o", "            pnew = [base[i] + scale[i]*qnew[i] for i in range(npar)]\r\n\u001b[?2004l\r"]
[87.927794, "o", "\u001b[?2004h> "]
[87.927834, "o", "            if pnew[1] <= 0.05:\r\n\u001b[?2004l\r"]
[87.927866, "o", "\u001b[?2004h> "]
[87.927905, "o", "                lam *= 10.0\r\n\u001b[?2004l\r"]
[87.927929, "o", "\u001b[?2004h> "]
[87.927989, "o", "                continue\r\n\u001b[?2004l\r"]
[87.928019, "o", "\u001b[?2004h> "]
[87.928064, "o", "            snew = sse(pnew, x, y)\r\n\u001b[?2004l\r"]
[87.928117, "o", "\u001b[?2004h> "]
[87.928165, "o", "            if snew < s - 1e-12*max(1.0, s):\r\n\u001b[?2004l\r"]
[87.9282, "o", "\u001b[?2004h> "]
[87.928247, "o", "                p = pnew\r\n\u001b[?2004l\r"]
[87.928279, "o", "\u001b[?2004h> "]
[87.928313, "o", "                q = qnew\r\n\u001b[?2004l\r"]
[87.928349, "o", "\u001b[?2004h> "]
[87.928396, "o", "                s = snew\r\n\u001b[?2004l\r"]
[87.928428, "o", "\u001b[?2004h> "]
[87.928491, "o", "                lam = max(lam*0.3, 1e-12)\r\n\u001b[?2004l\r"]
[87.928515, "o", "\u001b[?2004h> "]
[87.928565, "o", "                accepted = True\r\n\u001b[?2004l\r"]
[87.928598, "o", "\u001b[?2004h> "]
