[87.918186, "i", "        else:\n                lam *= 10.0\n        if not accepted:\n            break\n        if max(abs(delta[i]*scale[i]) for i in range(npar)) < 1e-9:\n            break\n    return p, s\n\nwindows = {\n    'D': (1250.0, 1450.0),\n    'G': (1500.0, 1650.0),\n    '2D': (2550.0, 2800.0),\n}\n\nresults = {}\nfor name, (lo, hi) in windows.items():\n    xw = [x for x in xs if lo <= x <= hi]\n    yw = [y for x, y in data if lo <= x <= hi]\n    p = fit_peak(xw, yw)\n    A, g, x0, c = p\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(g),\n        'amplitude': float(A),\n        'offset': float(c),\n    }\n    print(name, results[name], 'SSE', sse(p, xw, yw))\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG', results['ID_IG'])\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('wrote /app/results.json')\nPY\n"]
