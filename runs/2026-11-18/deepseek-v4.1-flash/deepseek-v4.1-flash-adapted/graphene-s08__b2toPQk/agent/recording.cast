[17.118862, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lor(x, amp, gamma, x0, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\npeaks = {\n    'D': (1250.0, 1450.0),\n    'G': (1500.0, 1650.0),\n    '2D': (2550.0, 2800.0),\n}\n\nresults = {}\nfor name, (lo, hi) in peaks.items():\n    m = (x >= lo) & (x <= hi)\n    xw = x[m]\n    yw = y[m]\n    i0 = int(np.argmax(yw))\n    p0 = [max(yw) - min(yw), 20.0, xw[i0], min(yw)]\n    bounds = ([0.0, 0.1, lo, 0.0], [np.inf, 200.0, hi, np.inf])\n    popt, pcov = curve_fit(lor, xw, yw, p0=p0, bounds=bounds, maxfev=20000)\n    amp, gamma, x0, offset = popt\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset),\n    }\n    print(name, results[name])\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG', results['ID_IG'])\n\nw"]
[17.118912, "i", "ith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('wrote results.json')\nPY\n"]
