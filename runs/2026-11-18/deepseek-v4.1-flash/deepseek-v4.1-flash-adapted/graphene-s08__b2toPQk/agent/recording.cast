[87.917712, "i", "python3 - <<'PY'\nimport csv, json, math\n\n# Load data\nwith open('spectrum.csv') as f:\n    r = csv.reader(f)\n    next(r)\n    data = [(float(a), float(b)) for a, b in r]\nxs = [p[0] for p in data]\nys = [p[1] for p in data]\n\n# Lorentzian plus constant offset\n# I = amp * gamma^2 / ((x-x0)^2 + gamma^2) + offset\ndef model(p, x):\n    A, g, x0, c = p\n    d = (x - x0)**2 + g*g\n    return A*g*g/d + c\n\ndef jacobian(p, x):\n    A, g, x0, c = p\n    d = (x - x0)**2 + g*g\n    d2 = d*d\n    g2 = g*g\n    return [\n        g2/d,\n        2.0*A*g*(x-x0)**2/d2,\n        2.0*A*g2*(x-x0)/d2,\n        1.0,\n    ]\n\ndef sse(p, x, y):\n    return sum((model(p, xi) - yi)**2 for xi, yi in zip(x, y))\n\ndef solve_linear(A, b):\n    n = len(b)\n    M = [A[i][:] + [b[i]] for i in range(n)]\n    for col in range(n):\n        piv = max(range(col, n), key=lambda r: abs(M[r][col]))\n        if abs(M[piv][col]) < 1e-15:\n            raise ZeroDivisionError('singular matrix')\n        if piv != col:\n            M[col], M[piv] = M[piv], M[col]\n        pv = M[col][c"]
[87.917909, "i", "ol]\n        for r in range(col+1, n):\n            f = M[r][col] / pv\n            if f != 0.0:\n                for k in range(col, n+1):\n                    M[r][k] -= f * M[col][k]\n    x = [0.0]*n\n    for i in range(n-1, -1, -1):\n        s = M[i][n] - sum(M[i][j]*x[j] for j in range(i+1, n))\n        x[i] = s / M[i][i]\n    return x\n\ndef initial_guess(x, y):\n    imax = max(range(len(y)), key=lambda i: y[i])\n    x0 = x[imax]\n    peak = y[imax]\n    c0 = min(y)\n    half = c0 + 0.5*(peak - c0)\n    # left half-max crossing\n    xl = x[0]\n    for i in range(imax-1, -1, -1):\n        if y[i] <= half:\n            xl = x[i] + (x[i+1]-x[i])*(half-y[i])/(y[i+1]-y[i])\n            break\n    xr = x[-1]\n    for i in range(imax+1, len(y)):\n        if y[i] <= half:\n            xr = x[i-1] + (x[i]-x[i-1])*(half-y[i-1])/(y[i]-y[i-1])\n            break\n    fwhm = max(0.1, xr-xl)\n    gamma0 = fwhm/2.0\n    if not (0.1 <= gamma0 <= 300):\n        gamma0 = 15.0\n    return [max(peak-c0, 1.0), gamma0, x0, c0]\n\ndef fit_peak(x, y, gammas=(5."]
[87.917988, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.918041, "i", "0, 10.0, 20.0, 40.0, 80.0)):\n    best = None\n    for gamma0 in gammas:\n        p0 = initial_guess(x, y)\n        p0[1] = gamma0\n        p, s = fit_lm(x, y, p0)\n        if best is None or s < best[1]:\n            best = (p, s)\n    return best[0]\n\ndef fit_lm(x, y, p0, maxiter=400):\n    p = p0[:]\n    npar = 4\n    # scale parameters so LM steps are well balanced\n    scale = [max(100.0, max(y)), max(1.0, p[1]), 1.0, max(100.0, max(y))]\n    base = p[:]\n    q = [0.0]*npar\n    lam = 1e-3\n    s = sse(p, x, y)\n    for it in range(maxiter):\n        # residual and Jacobian in original coordinates\n        r = [model(p, xi) - yi for xi, yi in zip(x, y)]\n        cols = jacobian(p, x)  # 4 x n\n        # convert to scaled parameter q where p = base + scale*q\n        Jq = [[cols[k][i]*scale[k] for i in range(len(x))] for k in range(npar)]\n        JTJ = [[0.0]*npar for _ in range(npar)]\n        JTr = [0.0]*npar\n        for k in range(npar):\n            for l in range(npar):\n                JTJ[k][l] = sum(Jq[k][i]*Jq[l][i] for i"]
