[?2004l[?2004h> import csv, math, json
[?2004l[?2004h> def read_data(path):
[?2004l[?2004h>     xs=[]; ys=[]
[?2004l[?2004h>     with open(path, newline='') as f:
[?2004l[?2004h>         r=csv.reader(f)
[?2004l[?2004h>         next(r)
[?2004l[?2004h>         for row in r:
[?2004l[?2004h>             if len(row)>=2:
[?2004l[?2004h>                 xs.append(float(row[0])); ys.append(float(row[1]))
[?2004l[?2004h>     return xs, ys
[?2004l[?2004h> def model(p, x):
[?2004l[?2004h>     A, g, x0, c = p
[?2004l[?2004h>     d=x-x0
[?2004l[?2004h>     return A*g*g/(d*d+g*g)+c
[?2004l[?2004h> def cost(p, xs, ys):
[?2004l[?2004h>     return sum((y-model(p,x))**2 for x,y in zip(xs,ys))
[?2004l[?2004h> def linear_shape(xs, ys, x0, g):
[?2004l[?2004h>     us=[g*g/((x-x0)**2+g*g) for x in xs]
[?2004l[?2004h>     n=len(xs)
[?2004l[?2004h>     Suu=sum(u*u for u in us); Su=sum(us)
[?2004l[?2004h>     Suy=sum(u*y for u,y in zip(us,ys)); Sy=sum(ys)
[?2004l[?2004h>     det=n*Suu-Su*Su
[?2004l[?2004h>     if abs(det)<1e-12: return None
[?2004l[?2004h>     A=(n*Suy-Su*Sy)/det
[?2004l[?2004h>     c=(Suu*Sy-Su*Suy)/det
[?2004l[?2004h>     sse=sum((y-(A*u+c))**2 for u,y in zip(us,ys))
[?2004l[?2004h>     return sse, A, c
[?2004l[?2004h> def initial_fit(xs, ys):
[?2004l[?2004h>     im=max(range(len(ys)), key=lambda i: ys[i])
[?2004l[?2004h>     xm=xs[im]
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for i in range(81):
[?2004l[?2004h>         x0=xm-40.0+i
[?2004l[?2004h>         for g in [5,7.5,10,12.5,15,18,22,27,33,40,50,65,80]:
[?2004l[?2004h>             r=linear_shape(xs,ys,x0,g)
[?2004l[?2004h>             if r is None: continue
[?2004l[?2004h>             sse,A,c=r
[?2004l[?2004h>             if A>0 and (best is None or sse<best[0]):
[?2004l[?2004h>                 best=(sse,[A,g,x0,c])
[?2004l[?2004h>     if best is None: raise RuntimeError('no initial fit')
[?2004l[?2004h>     return best[1]
[?2004l[?2004h> def solve4(A,b):
[?2004l[?2004h>     M=[A[i][:]+[b[i]] for i in range(4)]
[?2004l[?2004h>     for col in range(4):
[?2004l[?2004h>         piv=max(range(col,4), key=lambda r: abs(M[r][col]))
[?2004l[?2004h>         if abs(M[piv][col])<1e-15: return None
[?2004l[?2004h>         if piv!=col: M[col],M[piv]=M[piv],M[col]
[?2004l[?2004h>         pv=M[col][col]
[?2004l[?2004h>         for j in range(col,5): M[col][j]/=pv
[?2004l[?2004h>         for r in range(4):
[?2004l[?2004h>             if r!=col:
[?2004l[?2004h>                 fac=M[r][col]
[?2004l[?2004h>                 if fac!=0.0:
[?2004l[?2004h>                     for j in range(col,5): M[r][j]-=fac*M[col][j]
[?2004l[?2004h>     return [M[i][4] for i in range(4)]
[?2004l[?2004h> def lm_fit(xs,ys,p):
[?2004l[?2004h>     p=list(p)
[?2004l[?2004h>     if p[1]<=0: p[1]=1.0
[?2004l[?2004h>     cur=cost(p,xs,ys)
[?2004l[?2004h>     lam=1e-3
[?2004l[?2004h>     for it in range(300):
[?2004l[?2004h>         JtJ=[[0.0]*4 for _ in range(4)]; Jtr=[0.0]*4
[?2004l[?2004h>         for x,y in zip(xs,ys):
[?2004l[?2004h>             A,g,x0,c=p
[?2004l[?2004h>             d=x-x0; den=d*d+g*g
[?2004l[?2004h>             f=A*g*g/den+c; r=y-f
[?2004l[?2004h>             j=[g*g/den, 2.0*A*g*d*d/(den*den), 2.0*A*g*g*d/(den*den), 1.0]
[?2004l[?2004h>             for a in range(4):
[?2004l[?2004h>                 Jtr[a]+=j[a]*r
[?2004l[?2004h>                 for b in range(4): JtJ[a][b]+=j[a]*j[b]
[?2004l[?2004h>         M=[row[:] for row in JtJ]
[?2004l[?2004h>         for a in range(4): M[a][a]+=lam*max(JtJ[a][a],1e-12)
[?2004l[?2004h>         delta=solve4(M,Jtr)
[?2004l[?2004h>         if delta is None: break
[?2004l[?2004h>         cand=[p[a]+delta[a] for a in range(4)]
[?2004l[?2004h>         if cand[1]<=0.0:
[?2004l[?2004h>             lam*=10.0
[?2004l[?2004h>             if lam>1e15: break
[?2004l[?2004h>             continue
[?2004l[?2004h>         nc=cost(cand,xs,ys)
[?2004l[?2004h>         if nc<cur:
[?2004l[?2004h>             p=cand; cur=nc; lam*=0.3
[?2004l[?2004h>             if lam<1e-15: lam=1e-15
[?2004l[?2004h>             step=sum(d*d for d in delta); scale=sum(q*q for q in p)+1e-12
[?2004l[?2004h>             if step<1e-12*scale: break
[?2004l[?2004h>         else:
[?2004l[?2004h>             lam*=10.0
[?2004l[?2004h>             if lam>1e15: break
[?2004l[?2004h>     return p,cur
[?2004l[?2004h> def main():
[?2004l[?2004h>     xs,ys=read_data('/app/spectrum.csv')
[?2004l[?2004h>     windows={'D':(1250.0,1450.0),'G':(1500.0,1680.0),'2D':(2500.0,2850.0)}
[?2004l[?2004h>     res={}
[?2004l[?2004h>     for name,(lo,hi) in windows.items():
[?2004l[?2004h>         wx=[x for x in xs if lo<=x<=hi]
[?2004l[?2004h>         wy=[y for x,y in zip(xs,ys) if lo<=x<=hi]
[?2004l[?2004h>         p0=initial_fit(wx,wy)
[?2004l[?2004h>         p,c=lm_fit(wx,wy,p0)
[?2004l[?2004h>         A,g,x0,c=p
[?2004l[?2004h>         rms=math.sqrt(c/len(wx))
[?2004l[?2004h>         print(name, 'x0', x0, 'gamma', g, 'amp', A, 'offset', c, 'rms', rms)
[?2004l[?2004h>         res[name]={'x0':x0,'gamma':g,'amplitude':A,'offset':c}
[?2004l[?2004h>     res['ID_IG']=res['D']['amplitude']/res['G']['amplitude']
[?2004l[?2004h>     with open('/app/results.json','w') as f: json.dump(res,f,indent=2)
