[10.256566, "i", "python3 - <<'PY'\nimport numpy as np\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1).T\nprint('npoints', len(x))\nprint('x range', x.min(), x.max())\nfor name, lo, hi in [('D', 1250, 1450), ('G', 1500, 1680), ('2D', 2500, 2850)]:\n    m = (x >= lo) & (x <= hi)\n    i = np.argmax(y[m])\n    print(name, 'max at', x[m][i], 'intensity', y[m][i])\ntry:\n    import scipy\n    print('scipy', scipy.__version__)\nexcept Exception as e:\n    print('scipy unavailable', repr(e))\nPY\n"]
