[19.117687, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('spectrum.csv', newline='') as f:\n    r=csv.reader(f)\n    header=next(r)\n    print('header', header)\n    for row in r:\n        if len(row)>=2:\n            x.append(float(row[0])); y.append(float(row[1]))\nprint('npoints', len(x))\nprint('x range', min(x), max(x))\nfor name, lo, hi in [('D',1250,1450),('G',1500,1680),('2D',2500,2850)]:\n    pairs=[(xx,yy) for xx,yy in zip(x,y) if lo<=xx<=hi]\n    mx=max(pairs, key=lambda p:p[1])\n    mn=min(pairs, key=lambda p:p[1])\n    print(name, 'max', mx, 'min', mn)\nPY\n"]
