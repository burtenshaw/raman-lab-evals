[18.731078, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\nprint('n', len(x))\nprint('x range', min(x), max(x))\nprint('y range', min(y), max(y))\nfor name, lo, hi in [('D',1200,1450),('G',1500,1700),('2D',2550,2850)]:\n    idx=[i for i,xi in enumerate(x) if lo <= xi <= hi]\n    j=max(idx, key=lambda i:y[i])\n    print(name, 'window', lo, hi, 'n', len(idx), 'max', x[j], y[j])\nPY\n"]
