[41.797907, "i", "python3 - <<'PY'\nimport csv, math\n\n# Read data\nx=[]; y=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\n\nwindows={\n    'D': (1230.0, 1460.0, 1347.0),\n    'G': (1490.0, 1670.0, 1579.0),\n    '2D': (2550.0, 2840.0, 2694.0),\n}\n\ndef linear_fit_for_x0_gamma(xs, ys, x0, gamma):\n    g2 = gamma*gamma\n    g=[]; sgy=0.0; sg=0.0; sy=0.0; sg2=0.0; n=len(xs)\n    for xi, yi in zip(xs, ys):\n        gi = g2 / ((xi-x0)*(xi-x0) + g2)\n        g.append(gi)\n        sg += gi\n        sgy += gi*yi\n        sy += yi\n        sg2 += gi*gi\n    den = n*sg2 - sg*sg\n    if abs(den) < 1e-15:\n        return None\n    A = (n*sgy - sg*sy) / den\n    c = (sy - A*sg) / n\n    sse = 0.0\n    for xi, yi, gi in zip(xs, ys, g):\n        pred = A*gi + c\n        d = yi - pred\n        sse += d*d\n    return sse, A, c\n\ndef fit_peak(name):\n    lo, hi, peak_guess = windows[name]\n    xs=[]; ys=[]\n    for xi, yi in zip(x, y):\n     "]
[41.798057, "i", "   if lo <= xi <= hi:\n            xs.append(xi); ys.append(yi)\n    # coarse grid around observed peak maximum\n    coarse_best=None\n    for x0 in [peak_guess-30.0 + 2.0*i for i in range(31)]:\n        for gamma in [5.0 + 2.0*j for j in range(41)]:\n            r=linear_fit_for_x0_gamma(xs, ys, x0, gamma)\n            if r is not None and (coarse_best is None or r[0] < coarse_best[0]):\n                coarse_best=(r[0], x0, gamma, r[1], r[2])\n    # pattern-search refinement\n    sse, x0, gamma, A, c = coarse_best\n    step=1.0\n    while step >= 0.01:\n        improved=False\n        candidates=[(x0+step,gamma),(x0-step,gamma),(x0,gamma+step),(x0,gamma-step),\n                    (x0+step,gamma+step),(x0+step,gamma-step),(x0-step,gamma+step),(x0-step,gamma-step)]\n        for nx, ng in candidates:\n            if ng <= 0.0:\n                continue\n            r=linear_fit_for_x0_gamma(xs, ys, nx, ng)\n            if r is not None and r[0] < sse - 1e-12:\n                sse, A, c = r\n                x0, gamma = nx, ng\n    "]
[41.798075, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.798092, "i", "            improved=True\n        if not improved:\n            step *= 0.5\n    return {'x0':x0, 'gamma':gamma, 'amplitude':A, 'offset':c, '_sse':sse, '_n':len(xs)}\n\nresults={}\nfor name in ['D','G','2D']:\n    results[name]=fit_peak(name)\n    print(name, results[name])\nprint('ID_IG', results['D']['amplitude']/results['G']['amplitude'])\nPY\n"]
