[41.80253, "o", "                sse, A, c = r\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.80256, "o", "> "]
[41.802597, "o", "                x0, gamma = nx, ng\r\n\u001b[?2004l\r"]
[41.802629, "o", "\u001b[?2004h> "]
[41.802663, "o", "                improved=True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.802697, "o", "        if not improved:\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802727, "o", "> "]
[41.80276, "o", "            step *= 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.802852, "o", "    return {'x0':x0, 'gamma':gamma, 'amplitude':A, 'offset':c, '_sse':sse, '_n':len(xs)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802893, "o", "> \r\n\u001b[?2004l\r"]
[41.802917, "o", "\u001b[?2004h> results={}\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.802939, "o", "> "]
[41.802973, "o", "for name in ['D','G','2D']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.80301, "o", "    results[name]=fit_peak(name)\r\n\u001b[?2004l\r"]
[41.803047, "o", "\u001b[?2004h> "]
[41.803074, "o", "    print(name, results[name])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.803164, "o", "print('ID_IG', results['D']['amplitude']/results['G']['amplitude'])\r\n\u001b[?2004l\r"]
[41.803208, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
