    # coarse grid around observed peak maximum
    coarse_best=None
    for x0 in [peak_guess-30.0 + 2.0*i for i in range(31)]:
        for gamma in [5.0 + 2.0*j for j in range(41)]:
            r=linear_fit_for_x0_gamma(xs, ys, x0, gamma)
            if r is not None and (coarse_best is None or r[0] < coarse_best[0]):
                coarse_best=(r[0], x0, gamma, r[1], r[2])
    # pattern-search refinement
    sse, x0, gamma, A, c = coarse_best
    step=1.0
    while step >= 0.01:
        improved=False
        candidates=[(x0+step,gamma),(x0-step,gamma),(x0,gamma+step),(x0,gamma-step),
                    (x0+step,gamma+step),(x0+step,gamma-step),(x0-step,gamma+step),(x0-step,gamma-step)]
        for nx, ng in candidates:
            if ng <= 0.0:
                continue
            r=linear_fit_for_x0_gamma(xs, ys, nx, ng)
            if r is not None and r[0] < sse - 1e-12:
                sse, A, c = r
                x0, gamma = nx, ng
                improved=True
        if not improved:
            step *= 0.5
    return {'x0':x0, 'gamma':gamma, 'amplitude':A, 'offset':c, '_sse':sse, '_n':len(xs)}

results={}
for name in ['D','G','2D']:
    results[name]=fit_peak(name)
    print(name, results[name])
print('ID_IG', results['D']['amplitude']/results['G']['amplitude'])
