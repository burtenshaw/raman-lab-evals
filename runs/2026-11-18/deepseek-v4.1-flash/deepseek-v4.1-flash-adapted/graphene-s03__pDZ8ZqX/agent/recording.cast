[48.313149, "i", "python3 - <<'PY'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\ndef lorentz(x, amp, x0, gamma, off):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\n\nwindows = {\n    'D':  (1220.0, 1480.0),\n    'G':  (1480.0, 1700.0),\n    '2D': (2500.0, 2850.0),\n}\n\nresults = {}\nfor name, (lo, hi) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    imax = np.argmax(yw)\n    x0_guess = xw[imax]\n    off_guess = np.percentile(yw, 5)\n    amp_guess = yw[imax] - off_guess\n    half = off_guess + amp_guess / 2\n    above = np.where(yw >= half)[0]\n    gamma_guess = max(5.0, (xw[above[-1]] - xw[above[0]]) / 2) if len(above) >= 2 else 20.0\n\n    p0 = [amp_guess, x0_guess, gamma_guess, off_guess]\n    bounds = ([0.0, lo, 1e-6, -np.inf], [np.inf, hi, hi - lo, np.inf])\n    popt, _ = curve_fit(lorentz, xw, yw, p0=p0, bounds=bounds, maxfev=20000)\n    amp, x0, gamma, offset = popt\n    results[name] = {\n        'x0':"]
[48.31327, "i", " float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset),\n    }\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\nprint(json.dumps(results, indent=2))\nPY\n"]
