[8.291525, "i", "python3 - <<'PY'\nimport numpy as np\ntry:\n    import scipy\n    print('scipy', scipy.__version__)\nexcept Exception as e:\n    print('scipy unavailable', e)\n\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:,0], data[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nfor lo, hi, name in [(1200,1500,'D'), (1500,1700,'G'), (2500,2900,'2D')]:\n    m = (x >= lo) & (x <= hi)\n    xm, ym = x[m], y[m]\n    idx = np.argmax(ym)\n    print(name, 'window', lo, hi, 'max at', xm[idx], ym[idx])\nPY\n"]
