[?2004hroot@j-openenv-6afd8b50e5cad0e4dc3e6c36-dhoa9t68-98a9a-fx9ss:/app# python3 - <<'PY'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> x, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D':  (1220.0, 1480.0),
[?2004l[?2004h>     'G':  (1480.0, 1700.0),
[?2004l[?2004h>     '2D': (2500.0, 2850.0),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi) in windows.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     imax = np.argmax(yw)
[?2004l[?2004h>     x0_guess = xw[imax]
[?2004l[?2004h>     off_guess = np.percentile(yw, 5)
[?2004l[?2004h>     amp_guess = yw[imax] - off_guess
[?2004l[?2004h>     half = off_guess + amp_guess / 2
[?2004l[?2004h>     above = np.where(yw >= half)[0]
[?2004l[?2004h>     gamma_guess = max(5.0, (xw[above[-1]] - xw[above[0]]) / 2) if len(above) >= 2 else 20.0
[?2004l[?2004h> 
[?2004l[?2004h>     p0 = [amp_guess, x0_guess, gamma_guess, off_guess]
[?2004l[?2004h>     bounds = ([0.0, lo, 1e-6, -np.inf], [np.inf, hi, hi - lo, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xw, yw, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     amp, x0, gamma, offset = popt
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amp),
[?2004l[?2004h>         'offset': float(offset),
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h>     f.write('\n')
