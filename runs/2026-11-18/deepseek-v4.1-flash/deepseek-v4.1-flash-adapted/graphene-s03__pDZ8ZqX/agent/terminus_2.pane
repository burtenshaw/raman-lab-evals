[?2004hroot@j-openenv-6afd8b50e5cad0e4dc3e6c36-dhoa9t68-98a9a-fx9ss:/app# python3 - <<'PY'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> x, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)
[?2004l[?2004h> print('x range:', x.min(), x.max(), 'n:', len(x))
[?2004l[?2004h> for lo, hi, name in [(1150,1500,'D'), (1450,1750,'G'), (2450,2950,'2D')]:
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     i = np.argmax(y[m])
[?2004l[?2004h>     print(f'{name}: broad max x={x[m][i]:.3f}, y={y[m][i]:.2f}, window=[{lo},{hi}]')
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D':  (1220.0, 1480.0),
[?2004l[?2004h>     'G':  (1480.0, 1700.0),
[?2004l[?2004h>     '2D': (2500.0, 2850.0),
[?2004l[?2004h> }
[?2004l[?2004h> for name, (lo, hi) in windows.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     imax = np.argmax(yw)
[?2004l[?2004h>     x0 = xw[imax]
[?2004l[?2004h>     off0 = np.percentile(yw, 5)
[?2004l[?2004h>     amp0 = yw[imax] - off0
[?2004l[?2004h>     # width estimate: half-width at half maximum relative to local baseline
[?2004l[?2004h>     half = off0 + amp0/2
[?2004l[?2004h>     above = np.where(yw >= half)[0]
[?2004l[?2004h>     if len(above) >= 2:
[?2004l[?2004h>         gamma0 = max(5.0, (xw[above[-1]] - xw[above[0]])/2)
[?2004l[?2004h>     else:
[?2004l[?2004h>         gamma0 = 20.0
[?2004l[?2004h>     p0 = [amp0, x0, gamma0, off0]
[?2004l[?2004h>     bounds = ([0, lo, 1e-6, -np.inf], [np.inf, hi, hi-lo, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     print(f'\n{name} fit window [{lo},{hi}] n={len(xw)}')
[?2004l[?2004h>     print('  amp   =', popt[0], '+/-', perr[0])
[?2004l[?2004h>     print('  x0    =', popt[1], '+/-', perr[1])
[?2004l[?2004h>     print('  gamma =', popt[2], '+/-', perr[2])
[?2004l[?2004h>     print('  offset=', popt[3], '+/-', perr[3])
[?2004l[?2004h>     r = yw - lorentz(xw, *popt)
[?2004l[?2004h>     print('  RMSE  =', np.sqrt(np.mean(r*r)))
