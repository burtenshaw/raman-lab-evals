[28.687306, "i", "python3 - <<'PY'\nimport csv, math\nx=[]; y=[]\nwith open('spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1'])); y.append(float(row['intensity']))\nfor lo,hi,name in [(1250,1450,'D'),(1500,1700,'G'),(2550,2800,'2D')]:\n    vals=[y[i] for i in range(len(x)) if lo<=x[i]<=hi]\n    vals_sorted=sorted(vals)\n    n=len(vals_sorted)\n    print(name, 'n', n, 'min', vals_sorted[0], 'p10', vals_sorted[n//10], 'p25', vals_sorted[n//4], 'median', vals_sorted[n//2], 'max', vals_sorted[-1])\nprint('values near boundaries:')\nfor target in [1200,1250,1300,1350,1400,1450,1500,1550,1580,1600,1650,1700,2500,2550,2600,2650,2690,2700,2750,2800,2850]:\n    i=min(range(len(x)), key=lambda j:abs(x[j]-target))\n    print(target, x[i], y[i])\nPY\n"]
