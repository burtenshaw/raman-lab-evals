[8.984415, "i", "python3 - <<'PY'\nimport numpy as np\ntry:\n    import scipy\n    print('scipy', scipy.__version__)\nexcept Exception as e:\n    print('no scipy', repr(e))\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\nprint('range', x.min(), x.max(), 'n', len(x))\nfor lo, hi in [(1250, 1450), (1500, 1700), (2550, 2800)]:\n    m = (x >= lo) & (x <= hi)\n    i = np.argmax(y[m])\n    print(lo, hi, 'max at', x[m][i], 'intensity', y[m][i])\nPY\n"]
