[82.622901, "o", "def model(p, x):\r\n\u001b[?2004l\r"]
[82.622928, "o", "\u001b[?2004h> "]
[82.622983, "o", "    x0, lg, lA, off = p\r\n\u001b[?2004l\r"]
[82.62301, "o", "\u001b[?2004h> "]
[82.623041, "o", "    g = math.exp(lg)\r\n\u001b[?2004l\r"]
[82.623068, "o", "\u001b[?2004h> "]
[82.623104, "o", "    A = math.exp(lA)\r\n\u001b[?2004l\r"]
[82.623139, "o", "\u001b[?2004h> "]
[82.623209, "o", "    return A*g*g/((x-x0)*(x-x0)+g*g) + off\r\n\u001b[?2004l\r"]
[82.623244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[82.623266, "o", "> "]
[82.623293, "o", "def sse(p, xs, ys):\r\n\u001b[?2004l\r"]
[82.623324, "o", "\u001b[?2004h> "]
[82.62341, "o", "    return sum((model(p, x)-y)**2 for x, y in zip(xs, ys))\r\n\u001b[?2004l\r"]
[82.623438, "o", "\u001b[?2004h> "]
[82.62346, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.623502, "o", "def solve_linear(A, b):\r\n\u001b[?2004l\r"]
[82.623528, "o", "\u001b[?2004h> "]
[82.623553, "o", "    n = len(b)\r\n\u001b[?2004l\r"]
[82.623584, "o", "\u001b[?2004h> "]
[82.623652, "o", "    M = [A[i][:] + [b[i]] for i in range(n)]\r\n\u001b[?2004l\r"]
[82.623674, "o", "\u001b[?2004h> "]
[82.623714, "o", "    for col in range(n):\r\n\u001b[?2004l\r"]
[82.623745, "o", "\u001b[?2004h> "]
[82.623786, "o", "        piv = col\r\n\u001b[?2004l\r"]
[82.62382, "o", "\u001b[?2004h> "]
