[112.312536, "i", "python3 - <<'PY'\nimport json, math\nimport fit_peaks as fp\n\nxs, ys = fp.load_data()\nfits = {}\nfor name, lo, hi, g0 in [\n    ('D', 1250, 1450, 16.0),\n    ('G', 1500, 1700, 9.0),\n    ('2D', 2500, 2850, 24.0),\n]:\n    p, ss, it = fp.fit(xs, ys, lo, hi, g0)\n    fits[name] = {\n        'x0': p[0],\n        'gamma': math.exp(p[1]),\n        'amplitude': math.exp(p[2]),\n        'offset': p[3],\n    }\n    print(name, 'SSE=', ss, 'iterations=', it)\n\nfits['ID_IG'] = fits['D']['amplitude'] / fits['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(fits, f, indent=2)\nprint(json.dumps(fits, indent=2))\nPY\n"]
