[82.623901, "o", "\u001b[?2004h> "]
[82.623974, "o", "            if abs(M[row][col]) > abs(M[piv][col]):\r\n\u001b[?2004l\r"]
[82.623996, "o", "\u001b[?2004h> "]
[82.624039, "o", "                piv = row\r\n\u001b[?2004l\r"]
[82.624074, "o", "\u001b[?2004h> "]
[82.624124, "o", "        if abs(M[piv][col]) < 1e-18:\r\n\u001b[?2004l\r"]
[82.624159, "o", "\u001b[?2004h> "]
[82.62419, "o", "            return None\r\n\u001b[?2004l\r"]
[82.624213, "o", "\u001b[?2004h> "]
[82.624281, "o", "        M[col], M[piv] = M[piv], M[col]\r\n\u001b[?2004l\r"]
[82.624303, "o", "\u001b[?2004h> "]
[82.624343, "o", "        pv = M[col][col]\r\n\u001b[?2004l\r"]
[82.624378, "o", "\u001b[?2004h> "]
[82.624438, "o", "        for j in range(col, n+1):\r\n\u001b[?2004l\r"]
[82.624459, "o", "\u001b[?2004h> "]
[82.624504, "o", "            M[col][j] /= pv\r\n\u001b[?2004l\r"]
[82.624533, "o", "\u001b[?2004h"]
[82.624554, "o", "> "]
[82.624586, "o", "        for row in range(n):\r\n\u001b[?2004l\r"]
[82.624612, "o", "\u001b[?2004h> "]
[82.624671, "o", "            if row == col:\r\n\u001b[?2004l\r"]
[82.624692, "o", "\u001b[?2004h> "]
