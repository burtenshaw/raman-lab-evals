[101.967837, "i", "python3 - <<'PY'\nimport math, fit_peaks as fp\nxs, ys = fp.load_data()\nfor name, lo, hi, gammas in [\n    ('D', 1250, 1450, [8, 12, 16, 20, 30, 50]),\n    ('G', 1500, 1700, [5, 8, 12, 16, 25, 40]),\n    ('2D', 2500, 2850, [15, 20, 30, 45, 70]),\n]:\n    print('---', name)\n    best = None\n    for g0 in gammas:\n        p, ss, it = fp.fit(xs, ys, lo, hi, g0)\n        vals = (p[0], math.exp(p[1]), math.exp(p[2]), p[3])\n        n = sum(1 for x in xs if lo <= x <= hi)\n        rmse = math.sqrt(ss/n)\n        print('g0=%5.1f it=%2d SSE=%12.3f RMSE=%7.3f x0=%9.4f gamma=%8.4f amp=%10.3f off=%8.3f' % (g0, it, ss, rmse, *vals))\n        if best is None or ss < best[0]:\n            best = (ss, vals, n)\n    print('BEST', best)\nPY\n"]
