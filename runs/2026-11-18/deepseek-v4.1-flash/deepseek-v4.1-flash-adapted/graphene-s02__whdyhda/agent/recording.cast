[82.625009, "o", "\u001b[?2004h> "]
[82.625093, "o", "                    M[row][j] -= fac*M[col][j]\r\n\u001b[?2004l\r"]
[82.625116, "o", "\u001b[?2004h> "]
[82.625179, "o", "    return [M[i][n] for i in range(n)]\r\n\u001b[?2004l\r"]
