[18.98269, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\nprint('points', len(x), 'range', x[0], x[-1])\n# simple 5-point moving average\nys=[]\nfor i in range(len(y)):\n    lo=max(0,i-2); hi=min(len(y),i+3)\n    ys.append(sum(y[lo:hi])/(hi-lo))\nfor lo,hi,name in [(1250,1450,'D'),(1500,1700,'G'),(2550,2800,'2D')]:\n    inds=[i for i,v in enumerate(x) if lo<=v<=hi]\n    imax=max(inds, key=lambda i: ys[i])\n    print(name, 'max at', x[imax], 'raw', y[imax], 'smoothed', ys[imax])\nPY\n"]
