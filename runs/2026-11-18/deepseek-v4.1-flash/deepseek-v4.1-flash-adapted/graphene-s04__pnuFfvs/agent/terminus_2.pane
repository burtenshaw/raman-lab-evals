[?2004l[?2004h>     for ix in range(-200, 201):
[?2004l[?2004h>         x0 = cx + ix*0.1
[?2004l[?2004h>         if not (lo <= x0 <= hi):
[?2004l[?2004h>             continue
[?2004l[?2004h>         for ig in range(20, 800, 5):  # gamma = 2 to 80 in 0.5 steps
[?2004l[?2004h>             g = ig*0.1
[?2004l[?2004h>             sse, A, B = cond_fit(x, y, x0, g)
[?2004l[?2004h>             if best is None or sse < best[0]:
[?2004l[?2004h>                 best = (sse, x0, g, A, B)
[?2004l[?2004h>     best = refine(x, y, best[1], best[2], 0.1, 0.1)
[?2004l[?2004h>     sse, x0, g, A, B = best
[?2004l[?2004h>     n = len(x)
[?2004l[?2004h>     rms = math.sqrt(sse/n)
[?2004l[?2004h>     maxres = 0.0
[?2004l[?2004h>     for xi, yi in zip(x, y):
[?2004l[?2004h>         pred = A*g*g/((xi-x0)*(xi-x0)+g*g)+B
[?2004l[?2004h>         maxres = max(maxres, abs(yi-pred))
[?2004l[?2004h>     print(name, 'x0=%.10f gamma=%.10f amp=%.10f offset=%.10f rms=%.6f maxres=%.6f' % (x0,g,A,B,rms,maxres))
[?2004l[?2004h>     fits[name] = {'x0':x0, 'gamma':g, 'amplitude':A, 'offset':B}
