[52.499353, "o", "\u001b[?2004h> "]
[52.499516, "o", "    print(name, 'n=', len(x), 'x0=', x0, 'gamma=', g, 'amp=', A, 'offset=', B, 'chi2=', old, 'rms=', rms, 'iters=', it)\r\n\u001b[?2004l\r"]
[52.499528, "o", "\u001b[?2004h> "]
[52.499658, "o", "    return {'x0':x0, 'gamma':g, 'amplitude':A, 'offset':B}, old, len(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
