[52.491031, "i", "ight = imax\n    while right < len(y)-1 and y[right] > half:\n        right += 1\n    if right > left and x[right] > x[left]:\n        fwhm = x[right]-x[left]\n        g0 = max(1.0, fwhm/2.0)\n    else:\n        g0 = 20.0\n    p = [x[imax], math.log(g0), ymax-baseline, baseline]\n    lam = 1e-3\n    old = chi2(x, y, p)\n    for it in range(300):\n        J = jacobian(x, y, p)\n        r = residuals(x, y, p)\n        n = len(p)\n        JTJ = [[sum(J[k][i]*J[k][j] for k in range(len(x))) for j in range(n)] for i in range(n)]\n        g = [sum(J[k][i]*r[k] for k in range(len(x))) for i in range(n)]\n        improved = False\n        for attempt in range(30):\n            M = [row[:] for row in JTJ]\n            for i in range(n):\n                M[i][i] *= (1.0 + lam)\n            try:\n                delta = solve_linear(M, g)\n            except Exception:\n                lam *= 10.0; continue\n            pnew = [p[i] + delta[i] for i in range(n)]\n            new = chi2(x, y, pnew)\n            if new < old:\n                p = pne"]
