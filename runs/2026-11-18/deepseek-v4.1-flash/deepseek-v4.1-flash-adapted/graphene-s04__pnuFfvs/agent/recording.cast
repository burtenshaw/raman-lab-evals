[31.878506, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\nfor center in [1350,1580,2690]:\n    print('\\ncenter', center)\n    for xv in range(center-200, center+201, 25):\n        # nearest point\n        j=min(range(len(xs)), key=lambda i: abs(xs[i]-xv))\n        print(f'{xs[j]:7.1f} {ys[j]:10.1f}')\nPY\n"]
