[52.543182, "o", "\u001b[?2004hroot@j-openenv-6afd8a8829e8b7ccfbbb81c7-od2w0ah3-d0dd4-n7bgp:/app# "]
[76.25023, "i", "python3 - <<'PY'\nimport csv, math\n\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\n\nwindows = {\n    'D':  (1250.0, 1450.0),\n    'G':  (1530.0, 1650.0),\n    '2D': (2600.0, 2770.0),\n}\n\ndef cond_fit(x, y, x0, g):\n    n = len(x)\n    g2 = g*g\n    Sf=Sff=Sfy=Sy=Syy=0.0\n    for xi, yi in zip(x, y):\n        f = g2 / ((xi-x0)*(xi-x0) + g2)\n        Sf += f; Sff += f*f; Sfy += f*yi; Sy += yi; Syy += yi*yi\n    den = n*Sff - Sf*Sf\n    if abs(den) < 1e-300:\n        return float('inf'), 0.0, Sy/n\n    A = (n*Sfy - Sf*Sy) / den\n    B = (Sy - A*Sf) / n\n    sse = Syy - 2*A*Sfy - 2*B*Sy + A*A*Sff + 2*A*B*Sf + n*B*B\n    return sse, A, B\n\ndef refine(x, y, x0, g, sx, sg):\n    best_sse, best_A, best_B = cond_fit(x, y, x0, g)\n    best = (best_sse, x0, g, best_A, best_B)\n    # pattern moves in both dimensions\n    while sx > 1e-5 or sg > 1e-5:\n        improved = False\n        for dx, dg in [(sx,0),(-sx,0),(0,sg),(0,-s"]
[76.250438, "i", "g),(sx,sg),(sx,-sg),(-sx,sg),(-sx,-sg)]:\n            nx0 = best[1] + dx\n            ng = best[2] + dg\n            if ng <= 0.01:\n                continue\n            sse, A, B = cond_fit(x, y, nx0, ng)\n            if sse < best[0]:\n                best = (sse, nx0, ng, A, B)\n                improved = True\n        if not improved:\n            sx *= 0.5\n            sg *= 0.5\n    return best\n\nfits = {}\nfor name, (lo, hi) in windows.items():\n    x=[]; y=[]\n    for xi, yi in zip(xs, ys):\n        if lo <= xi <= hi:\n            x.append(xi); y.append(yi)\n    imax = max(range(len(y)), key=lambda i: y[i])\n    cx = x[imax]\n    # coarse grid around local maximum\n    best = None\n    for ix in range(-200, 201):\n        x0 = cx + ix*0.1\n        if not (lo <= x0 <= hi):\n            continue\n        for ig in range(20, 800, 5):  # gamma = 2 to 80 in 0.5 steps\n            g = ig*0.1\n            sse, A, B = cond_fit(x, y, x0, g)\n            if best is None or sse < best[0]:\n                best = (sse, x0, g, A, B)\n    best ="]
[76.250462, "o", "python3 - <<'PY'"]
[76.250497, "i", " refine(x, y, best[1], best[2], 0.1, 0.1)\n    sse, x0, g, A, B = best\n    n = len(x)\n    rms = math.sqrt(sse/n)\n    maxres = 0.0\n    for xi, yi in zip(x, y):\n        pred = A*g*g/((xi-x0)*(xi-x0)+g*g)+B\n        maxres = max(maxres, abs(yi-pred))\n    print(name, 'x0=%.10f gamma=%.10f amp=%.10f offset=%.10f rms=%.6f maxres=%.6f' % (x0,g,A,B,rms,maxres))\n    fits[name] = {'x0':x0, 'gamma':g, 'amplitude':A, 'offset':B}\n\nprint('ID_IG =', fits['D']['amplitude']/fits['G']['amplitude'])\nPY\n"]
[76.250556, "o", "\r\n\u001b[?2004l\r"]
