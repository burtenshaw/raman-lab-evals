[20.826877, "i", "python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row)>=2:\n            xs.append(float(row[0])); ys.append(float(row[1]))\nprint('n', len(xs), 'x', min(xs), max(xs), 'y', min(ys), max(ys))\nfor name, lo, hi in [('D',1250,1450),('G',1500,1650),('2D',2550,2800)]:\n    vals=[(y,x,i) for i,(x,y) in enumerate(zip(xs,ys)) if lo <= x <= hi]\n    ymax,xmax,imax=max(vals)\n    ymin=min(v[0] for v in vals)\n    print(name, 'max', xmax, ymax, 'min', ymin, 'range', ymax-ymin, 'i', imax)\n    print('  around:', [(round(xs[j],1),round(ys[j],1)) for j in range(max(0,imax-3), min(len(xs),imax+4))])\nPY\n"]
