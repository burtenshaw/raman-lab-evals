[12.826252, "i", "python3 - <<'PY'\nimport numpy as np\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = data[:,0]\ny = data[:,1]\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\nfor name, lo, hi in [('D',1250,1450), ('G',1500,1650), ('2D',2550,2800)]:\n    m = (x >= lo) & (x <= hi)\n    i = np.argmax(y[m])\n    xw = x[m][i]\n    yw = y[m][i]\n    print(name, 'max x=', xw, 'y=', yw)\nPY\n"]
