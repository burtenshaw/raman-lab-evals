Sending keys: ["python3 - <<'PY'\nimport csv, math, json\n\n# Load data\nx=[]; y=[]\nwith open('/app/spectrum.csv') as f:\n    for row in csv.DictReader(f):\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\n\ndef solve_for_x0_gamma(xs, ys, x0, gamma):\n    n = len(xs)\n    SLL = SL = SLY = SY = SYY = 0.0\n    g2 = gamma * gamma\n    for xi, yi in zip(xs, ys):\n        d = xi - x0\n        L = g2 / (d*d + g2)\n        SLL += L*L\n        SL += L\n        SLY += L*yi\n        SY += yi\n        SYY += yi*yi\n    det = SLL*n - SL*SL\n    if det <= 1e-300:\n        return float('inf'), None, None\n    A = (SLY*n - SL*SY) / det\n    b = (SLL*SY - SL*SLY) / det\n    sse = SYY - A*SLY - b*SY\n    if sse < 0 and sse > -1e-7:\n        sse = 0.0\n    return sse, A, b\n\ndef golden(f, a, b, tol=1e-9, maxit=200):\n    invphi = (math.sqrt(5.0) - 1.0) / 2.0\n    c = b - invphi*(b-a)\n    d = a + invphi*(b-a)\n    fc = f(c); fd = f(d)\n    it = 0\n    while b-a > tol and it < maxit:\n        if fc < fd:\n            b, d, fd = d, c, fc\n            c = b - invphi*(b-a)\n            fc = f(c)\n        else:\n            a, c, fc = c, d, fd\n            d = a + invphi*(b-a)\n            fd = f(d)\n        it += 1\n    return (c, fc) if fc < fd else (d, fd)\n\ndef fit_peak(name, lo, hi):\n    xs = [xx for xx in x if lo <= xx <= hi]\n    ys = [yy for xx, yy in zip(x,y) if lo <= xx <= hi]\n    n = len(xs)\n    base = sorted(ys)[max(0, n//10)]\n    imax = max(range(n), key=lambda i: ys[i])\n    x0 = xs[imax]\n    ymax = ys[imax]\n    gamma = 5.0\n    # Estimate gamma from half-maximum above local baseline\n    half = base + (ymax - base)/2.0\n    left = None; right = None\n    for i in range(imax, -1, -1):\n        if ys[i] <= half:\n            left = xs[i]; break\n    for i in range(imax, n):\n        if ys[i] <= half:\n            right = xs[i]; break\n    if left is not None and right is not None and right > left:\n        gamma = max(0.5, (right-left)/2.0)\n    \n    def sse_at(x0v, gv):\n        if gv <= 0:\n            return float('inf')\n        return solve_for_x0_gamma(xs, ys, x0v, gv)[0]\n    \n    # Alternate golden-section minimization over x0 and gamma\n    for it in range(100):\n        nx, fx = golden(lambda xx: sse_at(xx, gamma), x0-10.0, x0+10.0, 1e-10)\n        ng, fg = golden(lambda gg: sse_at(nx, gg), 0.01, 200.0, 1e-10)\n        if abs(nx-x0) < 1e-9 and abs(ng-gamma) < 1e-9:\n            x0, gamma = nx, ng\n            break\n        x0, gamma = nx, ng\n    sse, A, b = solve_for_x0_gamma(xs, ys, x0, gamma)\n    print(name, 'window', lo, hi, 'n', n, 'x0', x0, 'gamma', gamma, 'A', A, 'b', b, 'SSE', sse)\n    return {'x0': x0, 'gamma': gamma, 'amplitude': A, 'offset': b}, sse\n\nwindows = [('D', 1250.0, 1450.0), ('G', 1500.0, 1650.0), ('2D', 2580.0, 2790.0)]\nresults = {}\nfor name, lo, hi in windows:\n    p, _ = fit_peak(name, lo, hi)\n    results[name] = p\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG', results['ID_IG'])\nprint('JSON', json.dumps(results, indent=2))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
