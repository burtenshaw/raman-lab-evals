Sending keys: ["cat > /app/fit_spectrum.py <<'PY'\nimport csv, json, math\n\ndef load_spectrum(path):\n    xs = []\n    ys = []\n    with open(path, newline='') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            xs.append(float(row['raman_shift_cm-1']))\n            ys.append(float(row['intensity']))\n    return xs, ys\n\ndef solve4(A, b):\n    n = 4\n    M = [A[i][:] + [b[i]] for i in range(n)]\n    for col in range(n):\n        piv = col\n        best = abs(M[col][col])\n        for r in range(col + 1, n):\n            v = abs(M[r][col])\n            if v > best:\n                best = v\n                piv = r\n        if best < 1e-300:\n            return None\n        if piv != col:\n            M[col], M[piv] = M[piv], M[col]\n        pv = M[col][col]\n        for j in range(col, n + 1):\n            M[col][j] /= pv\n        for r in range(n):\n            if r == col:\n                continue\n            fac = M[r][col]\n            if fac == 0.0:\n                continue\n            for j in range(col, n + 1):\n                M[r][j] -= fac * M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef fit_peak(xs, ys, lo, hi):\n    data = [(x, y) for x, y in zip(xs, ys) if lo <= x <= hi]\n    xd = [d[0] for d in data]\n    yd = [d[1] for d in data]\n    n = len(data)\n    imax = max(range(n), key=lambda i: yd[i])\n    x0_init = xd[imax]\n    edge = max(1, n // 10)\n    left_base = sum(yd[:edge]) / edge\n    right_base = sum(yd[-edge:]) / edge\n    b0 = min(left_base, right_base)\n    A0 = max(yd[imax] - b0, 1.0)\n    half = b0 + 0.5 * A0\n    left = x0_init\n    right = x0_init\n    for i in range(imax, -1, -1):\n        if yd[i] <= half:\n            left = xd[i]\n            break\n    for i in range(imax, n):\n        if yd[i] <= half:\n            right = xd[i]\n            break\n    gamma0 = max((right - left) / 2.0, 1.0)\n    xr = x0_init\n    p = [0.0, math.log(gamma0), math.log(A0), b0]\n\n    def model(x, params):\n        dx = x - xr - params[0]\n        g = math.exp(params[1])\n        A = math.exp(params[2])\n        return A * g * g / (dx * dx + g * g) + params[3]\n\n    cost = 0.0\n    for x, y in zip(xd, yd):\n        r = y - model(x, p)\n        cost += r * r\n    lam = 1e-3\n    for it in range(400):\n        JTJ = [[0.0] * 4 for _ in range(4)]\n        JTr = [0.0] * 4\n        for x, y in zip(xd, yd):\n            dx = x - xr - p[0]\n            g = math.exp(p[1])\n            A = math.exp(p[2])\n            den = dx * dx + g * g\n            f = A * g * g / den + p[3]\n            r = y - f\n            d0 = 2.0 * A * g * g * dx / (den * den)\n            d1 = 2.0 * A * g * g * dx * dx / (den * den)\n            d2 = A * g * g / den\n            d3 = 1.0\n            ders = (d0, d1, d2, d3)\n            for j in range(4):\n                dj = ders[j]\n                JTr[j] += dj * r\n                for k in range(4):\n                    JTJ[j][k] += dj * ders[k]\n        M = [JTJ[i][:] for i in range(4)]\n        for i in range(4):\n            M[i][i] += lam * max(JTJ[i][i], 1e-30)\n        delta = solve4(M, JTr)\n        if delta is None:\n            break\n        newp = [p[i] + delta[i] for i in range(4)]\n        newcost = 0.0\n        for x, y in zip(xd, yd):\n            r = y - model(x, newp)\n            newcost += r * r\n        if newcost < cost:\n            improvement = cost - newcost\n            p = newp\n            cost = newcost\n            lam = max(lam * 0.3, 1e-15)\n            if improvement < 1e-10 * (1.0 + cost):\n                break\n        else:\n            lam *= 10.0\n            if lam > 1e12:\n                break\n    return {\n        'x0': xr + p[0],\n        'gamma': math.exp(p[1]),\n        'amplitude': math.exp(p[2]),\n        'offset': p[3],\n    }\n\ndef main():\n    xs, ys = load_spectrum('/app/spectrum.csv')\n    windows = {\n        'D': (1230.0, 1460.0),\n        'G': (1480.0, 1680.0),\n        '2D': (2540.0, 2820.0),\n    }\n    res = {}\n    for name, (lo, hi) in windows.items():\n        res[name] = fit_peak(xs, ys, lo, hi)\n        print(name, res[name])\n    res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\n    print('ID_IG', res['ID_IG'])\n    with open('/app/results.json', 'w') as f:\n        json.dump(res, f, indent=2)\n        f.write(chr(10))\n\nif __name__ == '__main__':\n    main()\nPY\npython3 /app/fit_spectrum.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
