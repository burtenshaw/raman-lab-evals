Sending keys: ["cat >> /app/fit_spectrum.py <<'PY'\n\ndef solve_linear(A, b):\n    n = len(b)\n    M = [A[i][:] + [b[i]] for i in range(n)]\n    for col in range(n):\n        pivot = max(range(col, n), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col]) < 1e-18:\n            raise ValueError('singular matrix')\n        if pivot != col:\n            M[col], M[pivot] = M[pivot], M[col]\n        pv = M[col][col]\n        for j in range(col, n + 1):\n            M[col][j] /= pv\n        for r in range(n):\n            if r == col:\n                continue\n            factor = M[r][col]\n            if factor == 0.0:\n                continue\n            for j in range(col, n + 1):\n                M[r][j] -= factor * M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef lm_fit(xs, ys, p0, max_iter=300, lam=1e-3):\n    p = p0[:]\n    r = residuals(xs, ys, p)\n    c = sum(v * v for v in r)\n    for iteration in range(max_iter):\n        J = jacobian(xs, ys, p)\n        npar = 4\n        JtJ = [[0.0] * npar for _ in range(npar)]\n        Jtr = [0.0] * npar\n        for row, ri in zip(J, r):\n            for i in range(npar):\n                Jtr[i] += row[i] * ri\n                for j in range(i, npar):\n                    JtJ[i][j] += row[i] * row[j]\n        for i in range(npar):\n            for j in range(i):\n                JtJ[i][j] = JtJ[j][i]\n        A = [row[:] for row in JtJ]\n        for i in range(npar):\n            A[i][i] += lam * max(abs(JtJ[i][i]), 1e-12)\n        try:\n            delta = solve_linear(A, [-v for v in Jtr])\n        except ValueError:\n            lam *= 10.0\n            if lam > 1e14:\n                break\n            continue\n        newp = [p[i] + delta[i] for i in range(npar)]\n        # Keep the fitted peak center inside the selected window.\n        lo_x = min(xs)\n        hi_x = max(xs)\n        newp[2] = min(max(newp[2], lo_x), hi_x)\n        # Guard against overflow in exp().\n        newp[0] = min(max(newp[0], -20.0), 20.0)\n        newp[1] = min(max(newp[1], -10.0), 10.0)\n        try:\n            newr = residuals(xs, ys, newp)\n            newc = sum(v * v for v in newr)\n        except (OverflowError, ZeroDivisionError):\n            newc = float('inf')\n        if newc < c:\n            improvement = c - newc\n            p = newp\n            r = newr\n            c = newc\n            lam = max(lam * 0.3, 1e-15)\n            if improvement <= 1e-12 * max(c, 1.0):\n                step2 = sum(v * v for v in delta)\n                if step2 < 1e-12:\n                    break\n        else:\n            lam *= 3.0\n            if lam > 1e14:\n                break\n    return p, c, iteration + 1\n\ndef fit_peak(xs, ys, lo, hi, init_x0, init_gamma):\n    wx = []\n    wy = []\n    for x, y in zip(xs, ys):\n        if lo <= x <= hi:\n            wx.append(x)\n            wy.append(y)\n    if not wx:\n        raise ValueError('empty fitting window')\n    offset0 = min(wy)\n    amp0 = max(wy) - offset0\n    if amp0 <= 0:\n        amp0 = max(wy)\n    p0 = [math.log(amp0), math.log(init_gamma), init_x0, offset0]\n    p, c, iters = lm_fit(wx, wy, p0)\n    return {\n        'x0': p[2],\n        'gamma': math.exp(p[1]),\n        'amplitude': math.exp(p[0]),\n        'offset': p[3],\n        '_cost': c,\n        '_iterations': iters,\n        '_npoints': len(wx),\n    }\n\ndef main():\n    xs, ys = load_spectrum()\n    d = fit_peak(xs, ys, 1250.0, 1470.0, 1356.6, 20.0)\n    g = fit_peak(xs, ys, 1500.0, 1650.0, 1580.1, 15.0)\n    td = fit_peak(xs, ys, 2550.0, 2820.0, 2689.4, 25.0)\n    result = {\n        'D': {k: d[k] for k in ('x0', 'gamma', 'amplitude', 'offset')},\n        'G': {k: g[k] for k in ('x0', 'gamma', 'amplitude', 'offset')},\n        '2D': {k: td[k] for k in ('x0', 'gamma', 'amplitude', 'offset')},\n        'ID_IG': d['amplitude'] / g['amplitude'],\n    }\n    with open('/app/results.json', 'w') as f:\n        json.dump(result, f, indent=2)\n    print(json.dumps(result, indent=2))\n    print('diagnostics:', {'D': {k: v for k, v in d.items() if k.startswith('_')},\n                            'G': {k: v for k, v in g.items() if k.startswith('_')},\n                            '2D': {k: v for k, v in td.items() if k.startswith('_')}})\n\nif __name__ == '__main__':\n    main()\nPY\npython3 /app/fit_spectrum.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
