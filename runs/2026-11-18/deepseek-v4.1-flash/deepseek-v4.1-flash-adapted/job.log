Sending keys: ["python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\ndef lorentz_offset(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  (1250.0, 1450.0),\n    'G':  (1500.0, 1650.0),\n    '2D': (2550.0, 2800.0),\n}\n\nfor name, (lo, hi) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    x0_0 = xw[np.argmax(yw)]\n    A0 = yw.max() - np.percentile(yw, 5)\n    c0 = np.percentile(yw, 5)\n    p0 = [x0_0, 20.0, A0, c0]\n    bounds = ([lo, 0.1, 0.0, -np.inf], [hi, 200.0, np.inf, np.inf])\n    popt, pcov = curve_fit(lorentz_offset, xw, yw, p0=p0, bounds=bounds, maxfev=20000)\n    perr = np.sqrt(np.diag(pcov))\n    print(name)\n    for label, val, err in zip(['x0', 'gamma', 'amplitude', 'offset'], popt, perr):\n        print(f'  {label}: {val:.10g} +/- {err:.3g}')\n    print('  window', lo, hi, 'n', m.sum(), 'rms', np.sqrt(np.mean((yw-lorentz_offset(xw,*popt))**2)))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
