Sending keys: ['def fit_peak(x,y,lo,hi):\n    xs=[]; ys=[]\n    for xv,yv in zip(x,y):\n        if lo<=xv<=hi:\n            xs.append(xv); ys.append(yv)\n    n=len(xs)\n    imax=max(range(n), key=lambda i: ys[i])\n    x0=xs[imax]\n    c0=min(ys)\n    A0=max(ys)-c0\n    half=c0+0.5*A0\n    li=imax\n    while li>0 and ys[li]>half:\n        li-=1\n    ri=imax\n    while ri<n-1 and ys[ri]>half:\n        ri+=1\n    if li>0 and ri<n-1:\n        yl0,yl1=ys[li],ys[li+1]\n        xl0,xl1=xs[li],xs[li+1]\n        if abs(yl1-yl0)>1e-12:\n            xl=xl0+(half-yl0)*(xl1-xl0)/(yl1-yl0)\n        else:\n            xl=xl0\n        yr0,yr1=ys[ri-1],ys[ri]\n        xr0,xr1=xs[ri-1],xs[ri]\n        if abs(yr1-yr0)>1e-12:\n            xr=xr0+(half-yr0)*(xr1-xr0)/(yr1-yr0)\n        else:\n            xr=xr0\n        g0=max(1.0,0.5*(xr-xl))\n    else:\n        g0=10.0\n    p=[x0,math.log(g0),math.log(max(A0,1e-9)),c0]\n    lam=1e-3\n    last_cost=None\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
