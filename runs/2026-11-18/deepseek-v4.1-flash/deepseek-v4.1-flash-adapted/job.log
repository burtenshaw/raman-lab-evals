t[0],best[1],best[2],best[3][0],best[3][1]))\n    return best\n\ngrid_search('D', 1250, 1450, 1330, 1370, 3, 50)\ngrid_search('G', 1480, 1670, 1570, 1595, 3, 30)\ngrid_search('2D', 2500, 2850, 2680, 2710, 10, 60)\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
