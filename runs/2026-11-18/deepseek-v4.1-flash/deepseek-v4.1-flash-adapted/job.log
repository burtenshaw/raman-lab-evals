Sending keys: ["cat > /app/fit.py <<'PY'\nimport csv, math, json\n\ndef read_data(path):\n    x = []\n    y = []\n    with open(path, newline='') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            x.append(float(row['raman_shift_cm-1']))\n            y.append(float(row['intensity']))\n    return x, y\n\ndef linear_fit(x, y, x0, gamma):\n    n = len(x)\n    g2 = gamma * gamma\n    Sg = 0.0\n    Sgg = 0.0\n    Sy = 0.0\n    Sgy = 0.0\n    for xi, yi in zip(x, y):\n        gi = g2 / ((xi - x0) * (xi - x0) + g2)\n        Sg += gi\n        Sgg += gi * gi\n        Sy += yi\n        Sgy += gi * yi\n    det = n * Sgg - Sg * Sg\n    if det <= 1e-300:\n        return None\n    A = (n * Sgy - Sg * Sy) / det\n    b = (Sy * Sgg - Sg * Sgy) / det\n    sse = 0.0\n    for xi, yi in zip(x, y):\n        gi = g2 / ((xi - x0) * (xi - x0) + g2)\n        r = yi - (A * gi + b)\n        sse += r * r\n    return A, b, sse\n\ndef nelder_mead(fun, start, step, max_iter=1000, tol=1e-9):\n    n = len(start)\n    sim = [list(start)]\n    for i in range(n):\n        p = list(start)\n        p[i] += step[i]\n        sim.append(p)\n    fv = [fun(p) for p in sim]\n    it = 0\n    for it in range(max_iter):\n        order = sorted(range(n + 1), key=lambda i: fv[i])\n        sim = [sim[i] for i in order]\n        fv = [fv[i] for i in order]\n        if abs(fv[-1] - fv[0]) <= tol * (abs(fv[0]) + abs(fv[-1]) + 1e-12):\n            break\n        cen = [sum(sim[i][j] for i in range(n)) / n for j in range(n)]\n        xr = [cen[j] + (cen[j] - sim[-1][j]) for j in range(n)]\n        fr = fun(xr)\n        if fr < fv[0]:\n            xe = [cen[j] + 2.0 * (cen[j] - sim[-1][j]) for j in range(n)]\n            fe = fun(xe)\n            if fe < fr:\n                sim[-1] = xe\n                fv[-1] = fe\n            else:\n                sim[-1] = xr\n                fv[-1] = fr\n        elif fr < fv[-2]:\n            sim[-1] = xr\n            fv[-1] = fr\n        else:\n            xc = [cen[j] + 0.5 * (sim[-1][j] - cen[j]) for j in range(n)]\n            fc = fun(xc)\n            if fc < fv[-1]:\n                sim[-1] = xc\n                fv[-1] = fc\n            else:\n                for i in range(1, n + 1):\n                    sim[i] = [(sim[i][j] + sim[0][j]) * 0.5 for j in range(n)]\n                    fv[i] = fun(sim[i])\n    best = min(range(n + 1), key=lambda i: fv[i])\n    return sim[best], fv[best], it\n\ndef fit_peak(x, y, xlo, xhi):\n    pairs = [(xi, yi) for xi, yi in zip(x, y) if xlo <= xi <= xhi]\n    xw = [p[0] for p in pairs]\n    yw = [p[1] for p in pairs]\n    center = xw[max(range(len(yw)), key=lambda i: yw[i])]\n    gammas = [4, 6, 8, 10, 12, 15, 18, 22, 26, 32, 40, 50, 65, 80, 100, 130]\n    best = None\n    for x0 in [center + d for d in range(-25, 26)]:\n        for gamma in gammas:\n            res = linear_fit(xw, yw, x0, gamma)\n            if res is not None and (best is None or res[2] < best[0]):\n                best = (res[2], x0, gamma, res[0], res[1])\n    def obj(q):\n        x0 = q[0]\n        gamma = math.exp(q[1])\n        if gamma < 0.5 or gamma > 250.0 or x0 < xlo - 100.0 or x0 > xhi + 100.0:\n            return 1e100\n        res = linear_fit(xw, yw, x0, gamma)\n        if res is None:\n            return 1e100\n        return res[2]\n    start = [best[1], math.log(best[2])]\n    opt, fval, iters = nelder_mead(obj, start, [2.0, 0.2])\n    x0 = opt[0]\n    gamma = math.exp(opt[1])\n    A, b, sse = linear_fit(xw, yw, x0, gamma)\n    return {'x0': x0, 'gamma': gamma, 'amplitude': A, 'offset': b}, len(xw), sse, iters\n\nx, y = read_data('/app/spectrum.csv')\nwindows = {'D': (1240.0, 1460.0), 'G': (1480.0, 1700.0), '2D': (2540.0, 2820.0)}\nout = {}\nfor name, (lo, hi) in windows.items():\n    params, n, sse, iters = fit_peak(x, y, lo, hi)\n    out[name] = params\n    print(name, 'n', n, 'sse', sse, 'iters', iters, params)\nout['ID_IG'] = out['D']['amplitude'] / out['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint('ID_IG', out['ID_IG'])\nprint('wrote /app/results.json')\nPY\npython3 /app/fit.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
