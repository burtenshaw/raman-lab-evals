0\n    if not (0.1 <= gamma0 <= 300):\n        gamma0 = 15.0\n    return [max(peak-c0, 1.0), gamma0, x0, c0]\n\ndef fit_peak(x, y, gammas=(5.0, 10.0, 20.0, 40.0, 80.0)):\n    best = None\n    for gamma0 in gammas:\n        p0 = initial_guess(x, y)\n        p0[1] = gamma0\n        p, s = fit_lm(x, y, p0)\n        if best is None or s < best[1]:\n            best = (p, s)\n    return best[0]\n\ndef fit_lm(x, y, p0, maxiter=400):\n    p = p0[:]\n    npar = 4\n    # scale parameters so LM steps are well balanced\n    scale = [max(100.0, max(y)), max(1.0, p[1]), 1.0, max(100.0, max(y))]\n    base = p[:]\n    q = [0.0]*npar\n    lam = 1e-3\n    s = sse(p, x, y)\n    for it in range(maxiter):\n        # residual and Jacobian in original coordinates\n        r = [model(p, xi) - yi for xi, yi in zip(x, y)]\n        cols = jacobian(p, x)  # 4 x n\n        # convert to scaled parameter q where p = base + scale*q\n        Jq = [[cols[k][i]*scale[k] for i in range(len(x))] for k in range(npar)]\n        JTJ = [[0.0]*npar for _ in range(npar)]\n        JTr = [0.0]*npar\n        for k in range(npar):\n            for l in range(npar):\n                JTJ[k][l] = sum(Jq[k][i]*Jq[l][i] for i in range(len(x)))\n            JTr[k] = sum(Jq[k][i]*r[i] for i in range(len(x)))\n        # check gradient\n        if max(abs(v) for v in JTr) < 1e-10:\n            break\n        diag = [max(JTJ[i][i], 1e-15) for i in range(npar)]\n        accepted = False\n        for _ in range(50):\n            M = [[JTJ[i][j] + (lam*diag[i] if i == j else 0.0) for j in range(npar)] for i in range(npar)]\n            try:\n                delta = solve_linear(M, [-v for v in JTr])\n            except ZeroDivisionError:\n                lam *= 10.0\n                continue\n            qnew = [q[i] + delta[i] for i in range(npar)]\n            pnew = [base[i] + scale[i]*qnew[i] for i in range(npar)]\n            if pnew[1] <= 0.05:\n                lam *= 10.0\n                continue\n            snew = sse(pnew, x, y)\n            if snew < s - 1e-12*max(1.0, s):\n                p = pnew\n                q = qnew\n                s = snew\n                lam = max(lam*0.3, 1e-12)\n                accepted = True\n                break\n            else:\n                lam *= 10.0\n        if not accepted:\n            break\n        if max(abs(delta[i]*scale[i]) for i in range(npar)) < 1e-9:\n            break\n    return p, s\n\nwindows = {\n    'D': (1250.0, 1450.0),\n    'G': (1500.0, 1650.0),\n    '2D': (2550.0, 2800.0),\n}\n\nresults = {}\nfor name, (lo, hi) in windows.items():\n    xw = [x for x in xs if lo <= x <= hi]\n    yw = [y for x, y in data if lo <= x <= hi]\n    p = fit_peak(xw, yw)\n    A, g, x0, c = p\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(g),\n        'amplitude': float(A),\n        'offset': float(c),\n    }\n    print(name, results[name], 'SSE', sse(p, xw, yw))\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG', results['ID_IG'])\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('wrote /app/results.json')\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
