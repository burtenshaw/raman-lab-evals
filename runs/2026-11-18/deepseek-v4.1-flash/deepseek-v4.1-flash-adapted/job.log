Sending keys: ["python3 - <<'PY'\nimport csv, math\n\n# load data\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\n\nwindows = {\n    'D':  (1250.0, 1450.0),\n    'G':  (1530.0, 1650.0),\n    '2D': (2600.0, 2770.0),\n}\n\ndef model(x, p):\n    x0, logg, A, B = p\n    g = math.exp(logg)\n    return A * g*g / ((x-x0)*(x-x0) + g*g) + B\n\ndef residuals(x, y, p):\n    return [yy - model(xx, p) for xx, yy in zip(x, y)]\n\ndef chi2(x, y, p):\n    return sum(r*r for r in residuals(x, y, p))\n\ndef solve_linear(A, b):\n    n = len(b)\n    M = [A[i][:] + [b[i]] for i in range(n)]\n    for col in range(n):\n        piv = max(range(col, n), key=lambda r: abs(M[r][col]))\n        if abs(M[piv][col]) < 1e-300:\n            raise ValueError('singular matrix')\n        M[col], M[piv] = M[piv], M[col]\n        pv = M[col][col]\n        for j in range(col, n+1):\n            M[col][j] /= pv\n        for i in range(n):\n            if i != col and abs(M[i][col]) > 1e-300:\n                fac = M[i][col]\n                for j in range(col, n+1):\n                    M[i][j] -= fac * M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef jacobian(x, y, p):\n    # residual derivative J_ij = dr_i/dp_j, numerical central differences\n    m = len(x); n = len(p)\n    J = [[0.0]*n for _ in range(m)]\n    steps = [1e-5, 1e-6, 1e-6, 1e-6]\n    for j in range(n):\n        h = steps[j]\n        pp = p[:]; pm = p[:]\n        pp[j] += h; pm[j] -= h\n        for i in range(m):\n            J[i][j] = ((y[i] - model(x[i], pp)) - (y[i] - model(x[i], pm))) / (2*h)\n    return J\n\ndef fit_peak(name, lo, hi):\n    inds = [i for i,xv in enumerate(xs) if lo <= xv <= hi]\n    x = [xs[i] for i in inds]\n    y = [ys[i] for i in inds]\n    imax = max(range(len(y)), key=lambda i: y[i])\n    baseline = min(y)\n    # initial gamma estimate via half-max crossings around peak\n    ymax = y[imax]\n    half = baseline + 0.5*(ymax-baseline)\n    left = imax\n    while left > 0 and y[left] > half:\n        left -= 1\n    right = imax\n    while right < len(y)-1 and y[right] > half:\n        right += 1\n    if right > left and x[right] > x[left]:\n        fwhm = x[right]-x[left]\n        g0 = max(1.0, fwhm/2.0)\n    else:\n        g0 = 20.0\n    p = [x[imax], math.log(g0), ymax-baseline, baseline]\n    lam = 1e-3\n    old = chi2(x, y, p)\n    for it in range(300):\n        J = jacobian(x, y, p)\n        r = residuals(x, y, p)\n        n = len(p)\n        JTJ = [[sum(J[k][i]*J[k][j] for k in range(len(x))) for j in range(n)] for i in range(n)]\n        g = [sum(J[k][i]*r[k] for k in range(len(x))) for i in range(n)]\n        improved = False\n        for attempt in range(30):\n            M = [row[:] for row in JTJ]\n            for i in range(n):\n                M[i][i] *= (1.0 + lam)\n            try:\n                delta = solve_linear(M, g)\n            except Exception:\n                lam *= 10.0; continue\n            pnew = [p[i] + delta[i] for i in range(n)]\n            new = chi2(x, y, pnew)\n            if new < old:\n                p = pnew\n                old = new\n                lam = max(1e-12, lam*0.3)\n                improved = True\n                break\n            else:\n                lam *= 3.0\n        if not improved:\n            break\n        if max(abs(d) for d in delta) < 1e-10:\n            break\n    x0, logg, A, B = p\n    g = math.exp(logg)\n    rms = math.sqrt(old/len(x))\n    print(name, 'n=', len(x), 'x0=', x0, 'gamma=', g, 'amp=', A, 'offset=', B, 'chi2=', old, 'rms=', rms, 'iters=', it)\n    return {'x0':x0, 'gamma':g, 'amplitude':A, 'offset':B}, old, len(x)\n\nfor name,(lo,hi) in windows.items():\n    fit_peak(name, lo, hi)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
