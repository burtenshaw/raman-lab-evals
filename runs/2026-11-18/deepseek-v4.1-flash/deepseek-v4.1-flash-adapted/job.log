Sending keys: ["python3 - <<'PY'\nimport csv, json\nwith open('/app/results.json') as f: R=json.load(f)\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    data=[(float(a),float(b)) for a,b in r]\np=R['D']\nlast=-1e9\nprint('D region every ~5 cm:')\nfor x,y in data:\n    if 1250<=x<=1450 and x-last>=5:\n        m=p['offset']+p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)\n        print(f'{x:7.2f} y={y:8.2f} model={m:8.2f} resid={y-m:8.2f}')\n        last=x\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# Load data\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\ndef lorentzian_offset(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  (1250.0, 1450.0),\n    'G':  (1500.0, 1650.0),\n    '2D': (2550.0, 2800.0),\n}\n\n# Initial guesses and bounds [x0, gamma, amplitude, offset]\ninitial = {\n    'D':  (1347.0, 30.0, 5000.0, 500.0),\n    'G':  (1579.0, 30.0, 9000.0, 500.0),\n    '2D': (2694.0, 50.0, 18000.0, 500.0),\n}\nbounds = {\n    'D':  ([1300.0, 5.0, 0.0, -5000.0], [1400.0, 150.0, 50000.0, 10000.0]),\n    'G':  ([1530.0, 5.0, 0.0, -5000.0], [1630.0, 150.0, 50000.0, 10000.0]),\n    '2D': ([2550.0, 10.0, 0.0, -5000.0], [2800.0, 250.0, 100000.0, 10000.0]),\n}\n\nresults = {}\nfor peak, (lo, hi) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    p0 = initial[peak]\n    lb, ub = bounds[peak]\n    popt, pcov = curve_fit(lorentzian_offset, xw, yw, p0=p0, bounds=(lb, ub), maxfev=20000)\n    perr = np.sqrt(np.diag(pcov))\n    yfit = lorentzian_offset(xw, *popt)\n    rmse = np.sqrt(np.mean((yw - yfit)**2))\n    x0, gamma, amplitude, offset = popt\n    results[peak] = {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amplitude),\n        'offset': float(offset),\n    }\n    print(f'{peak}: x0={x0:.6f} +/- {perr[0]:.6f}, gamma={gamma:.6f} +/- {perr[1]:.6f}, amp={amplitude:.6f} +/- {perr[2]:.6f}, offset={offset:.6f} +/- {perr[3]:.6f}, RMSE={rmse:.3f}')\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG =', results['ID_IG'])\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Wrote /app/results.json')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\nimport json, math\nimport fit_peaks as fp\n\nxs, ys = fp.load_data()\nfits = {}\nfor name, lo, hi, g0 in [\n    ('D', 1250, 1450, 16.0),\n    ('G', 1500, 1700, 9.0),\n    ('2D', 2500, 2850, 24.0),\n]:\n    p, ss, it = fp.fit(xs, ys, lo, hi, g0)\n    fits[name] = {\n        'x0': p[0],\n        'gamma': math.exp(p[1]),\n        'amplitude': math.exp(p[2]),\n        'offset': p[3],\n    }\n    print(name, 'SSE=', ss, 'iterations=', it)\n\nfits['ID_IG'] = fits['D']['amplitude'] / fits['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(fits, f, indent=2)\nprint(json.dumps(fits, indent=2))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
