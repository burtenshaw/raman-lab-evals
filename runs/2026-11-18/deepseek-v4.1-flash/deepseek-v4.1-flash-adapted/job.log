Sending keys: ["python3 - <<'PY'\nimport csv, math\n\ndef load_data(path):\n    xs=[]\n    ys=[]\n    with open(path, newline='') as f:\n        r=csv.DictReader(f)\n        for row in r:\n            xs.append(float(row['raman_shift_cm-1']))\n            ys.append(float(row['intensity']))\n    return xs, ys\n\ndef fit_linear_params(xw, yw, x0, gamma):\n    b=[]\n    for x in xw:\n        d=x-x0\n        b.append(gamma*gamma/(d*d+gamma*gamma))\n    n=len(xw)\n    sb=sum(b)\n    sy=sum(yw)\n    sbb=sum(v*v for v in b)\n    sby=sum(bi*yi for bi,yi in zip(b,yw))\n    det=n*sbb-sb*sb\n    if abs(det) < 1e-12:\n        return None\n    A=(n*sby-sb*sy)/det\n    c=(sy-A*sb)/n\n    if A <= 0.0:\n        return None\n    sse=0.0\n    for bi,yi in zip(b,yw):\n        r=A*bi+c-yi\n        sse += r*r\n    return A, c, sse\n\ndef fit_peak(xs, ys, lo, hi):\n    data=[(x,y) for x,y in zip(xs,ys) if lo <= x <= hi]\n    xw=[p[0] for p in data]\n    yw=[p[1] for p in data]\n    ymax=max(yw)\n    xpeak=xw[yw.index(ymax)]\n    gamma_grid=[2,3,4,5,6,8,10,12,15,18,22,26,30,35,40,50,60,80,100,120]\n    best=None\n    for i in range(-20,21):\n        x0=xpeak+i*0.5\n        for gamma in gamma_grid:\n            res=fit_linear_params(xw,yw,x0,gamma)\n            if res is not None:\n                A,c,sse=res\n                if best is None or sse < best[4]:\n                    best=(x0,gamma,A,c,sse)\n    x0,gamma,A,c,best_sse=best\n    sx=1.0\n    sg=2.0\n    steps=[(sx,0.0),(-sx,0.0),(0.0,sg),(0.0,-sg),(sx,sg),(sx,-sg),(-sx,sg),(-sx,-sg)]\n    while sx > 1e-6 or sg > 1e-6:\n        improved=False\n        for dx,dg in steps:\n            cx=x0+dx\n            cg=gamma+dg\n            if cg <= 0.05:\n                continue\n            res=fit_linear_params(xw,yw,cx,cg)\n            if res is not None:\n                nA,nc,nsse=res\n                if nsse < best_sse:\n                    x0,gamma,A,c,best_sse=cx,cg,nA,nc,nsse\n                    improved=True\n        if not improved:\n            sx *= 0.5\n            sg *= 0.5\n            steps=[(sx,0.0),(-sx,0.0),(0.0,sg),(0.0,-sg),(sx,sg),(sx,-sg),(-sx,sg),(-sx,-sg)]\n    rmse=math.sqrt(best_sse/len(xw))\n    return {'x0':x0,'gamma':gamma,'amplitude':A,'offset':c,'rmse':rmse,'n':len(xw)}\n\nxs,ys=load_data('/app/spectrum.csv')\nregions=[('D',1250,1450),('G',1500,1650),('2D',2550,2800)]\nresults={}\nfor name,lo,hi in regions:\n    fit=fit_peak(xs,ys,lo,hi)\n    results[name]=fit\n    print(name, 'x0=%.6f gamma=%.6f amplitude=%.6f offset=%.6f rmse=%.6f n=%d' % (fit['x0'],fit['gamma'],fit['amplitude'],fit['offset'],fit['rmse'],fit['n']))\nprint('ID_IG', results['D']['amplitude']/results['G']['amplitude'])\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
