Sending keys: ["python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)\nprint('x range:', x.min(), x.max(), 'n:', len(x))\nfor lo, hi, name in [(1150,1500,'D'), (1450,1750,'G'), (2450,2950,'2D')]:\n    m = (x >= lo) & (x <= hi)\n    i = np.argmax(y[m])\n    print(f'{name}: broad max x={x[m][i]:.3f}, y={y[m][i]:.2f}, window=[{lo},{hi}]')\n\ndef lorentz(x, amp, x0, gamma, off):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\n\nwindows = {\n    'D':  (1220.0, 1480.0),\n    'G':  (1480.0, 1700.0),\n    '2D': (2500.0, 2850.0),\n}\nfor name, (lo, hi) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    imax = np.argmax(yw)\n    x0 = xw[imax]\n    off0 = np.percentile(yw, 5)\n    amp0 = yw[imax] - off0\n    # width estimate: half-width at half maximum relative to local baseline\n    half = off0 + amp0/2\n    above = np.where(yw >= half)[0]\n    if len(above) >= 2:\n        gamma0 = max(5.0, (xw[above[-1]] - xw[above[0]])/2)\n    else:\n        gamma0 = 20.0\n    p0 = [amp0, x0, gamma0, off0]\n    bounds = ([0, lo, 1e-6, -np.inf], [np.inf, hi, hi-lo, np.inf])\n    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, bounds=bounds, maxfev=20000)\n    perr = np.sqrt(np.diag(pcov))\n    print(f'\\n{name} fit window [{lo},{hi}] n={len(xw)}')\n    print('  amp   =', popt[0], '+/-', perr[0])\n    print('  x0    =', popt[1], '+/-', perr[1])\n    print('  gamma =', popt[2], '+/-', perr[2])\n    print('  offset=', popt[3], '+/-', perr[3])\n    r = yw - lorentz(xw, *popt)\n    print('  RMSE  =', np.sqrt(np.mean(r*r)))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
