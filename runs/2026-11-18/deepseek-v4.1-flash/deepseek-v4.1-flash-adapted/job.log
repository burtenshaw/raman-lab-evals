Sending keys: ["python3 - <<'PY'\nimport csv, math\n\ndef load_data(path):\n    xs=[]; ys=[]\n    with open(path, newline='') as f:\n        r=csv.DictReader(f)\n        for row in r:\n            xs.append(float(row['raman_shift_cm-1']))\n            ys.append(float(row['intensity']))\n    return xs, ys\n\ndef fit_linear(xw, yw, x0, gamma):\n    b=[]\n    for x in xw:\n        d=x-x0\n        b.append(gamma*gamma/(d*d+gamma*gamma))\n    n=len(xw)\n    sb=sum(b)\n    sy=sum(yw)\n    sbb=sum(v*v for v in b)\n    sby=sum(v*y for v,y in zip(b,yw))\n    det=n*sbb-sb*sb\n    if abs(det)<1e-12:\n        return None\n    A=(n*sby-sb*sy)/det\n    c=(sy-A*sb)/n\n    if A<=0.0:\n        return None\n    sse=0.0\n    for v,y in zip(b,yw):\n        r=A*v+c-y\n        sse+=r*r\n    return A,c,sse\n\ndef local_refine(xw, yw, x0, gamma, sse):\n    dx=0.5\n    dg=1.0\n    while dx>1e-5 or dg>1e-5:\n        improved=False\n        for ix in (-1,0,1):\n            for ig in (-1,0,1):\n                if ix==0 and ig==0:\n                    continue\n                cx=x0+ix*dx\n                cg=gamma+ig*dg\n                if cg<=0.01:\n                    continue\n                res=fit_linear(xw,yw,cx,cg)\n                if res is not None and res[2]<sse:\n                    x0,gamma,A,c,sse=cx,cg,res[0],res[1],res[2]\n                    improved=True\n        if not improved:\n            dx*=0.5\n            dg*=0.5\n    return x0,gamma,sse\n\ndef fit_peak(xw, yw):\n    ymax=max(yw)\n    xpeak=xw[yw.index(ymax)]\n    cands=[]\n    for i in range(-30,31):\n        x0=xpeak+i*0.5\n        for j in range(50):\n            gamma=2.0+2.0*j\n            res=fit_linear(xw,yw,x0,gamma)\n            if res is not None:\n                cands.append((res[2],x0,gamma))\n    cands.sort(key=lambda t:t[0])\n    best=None\n    for sse0,x0c,gammac in cands[:20]:\n        x0,gamma,sse=local_refine(xw,yw,x0c,gammac,sse0)\n        if best is None or sse<best[2]:\n            best=(x0,gamma,sse)\n    x0,gamma,sse=best\n    A,c,_=fit_linear(xw,yw,x0,gamma)\n    return x0,gamma,A,c,sse\n\nxs,ys=load_data('/app/spectrum.csv')\nregions=[('D',1250,1450),('G',1500,1650),('2D',2550,2800)]\nfor name,lo,hi in regions:\n    xw=[x for x,y in zip(xs,ys) if lo<=x<=hi]\n    yw=[y for x,y in zip(xs,ys) if lo<=x<=hi]\n    x0,gamma,A,c,sse=fit_peak(xw,yw)\n    rmse=math.sqrt(sse/len(xw))\n    print(name, 'x0=%.9f gamma=%.9f amplitude=%.9f offset=%.9f rmse=%.9f' % (x0,gamma,A,c,rmse))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
