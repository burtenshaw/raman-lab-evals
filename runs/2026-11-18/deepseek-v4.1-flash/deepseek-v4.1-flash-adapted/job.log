Sending keys: ["python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        xs.append(float(row[0])); ys.append(float(row[1]))\nfor name, lo, hi in [('D',1250,1450),('G',1480,1680),('2D',2580,2800)]:\n    inds=[i for i,x in enumerate(xs) if lo<=x<=hi]\n    imax=max(inds,key=lambda i:ys[i])\n    edge_inds=[inds[0],inds[-1]]\n    base=min(ys[i] for i in edge_inds)\n    half=(ys[imax]+base)/2\n    left=None; right=None\n    for i in inds:\n        if i<=imax and ys[i]<=half: left=i\n        if i>=imax and ys[i]<=half and right is None: right=i\n    fwhm=(xs[right]-xs[left]) if left is not None and right is not None else None\n    print(name, 'max', xs[imax], ys[imax], 'edge baseline', base, 'half', half, 'fwhm', fwhm)\n    print('  edge values', [(xs[i], ys[i]) for i in edge_inds])\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
