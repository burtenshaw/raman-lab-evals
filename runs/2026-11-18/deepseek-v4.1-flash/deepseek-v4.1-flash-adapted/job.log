Sending keys: ["python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data[data.dtype.names[0]].astype(float)\ny = data['intensity'].astype(float)\n\ndef lorentz(x, amp, x0, gamma, off):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\n\nwindows = {'D': (1250, 1450), 'G': (1500, 1700), '2D': (2550, 2850)}\nfor name, (lo, hi) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    imax = np.argmax(yw)\n    x0_guess = xw[imax]\n    baseline_guess = 0.5*(yw[0] + yw[-1])\n    amp_guess = yw[imax] - baseline_guess\n    # estimate HWHM from points above half maximum\n    half = baseline_guess + 0.5*amp_guess\n    idx = np.where(yw >= half)[0]\n    if len(idx) >= 2:\n        gamma_guess = 0.5*(xw[idx[-1]] - xw[idx[0]])\n    else:\n        gamma_guess = 15.0\n    p0 = [amp_guess, x0_guess, max(gamma_guess, 1.0), baseline_guess]\n    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\n    yfit = lorentz(xw, *popt)\n    rmse = np.sqrt(np.mean((yw-yfit)**2))\n    print(name)\n    print('  window', lo, hi, 'n', len(xw))\n    print('  p0', p0)\n    print('  fit amp=%.8g x0=%.8g gamma=%.8g off=%.8g' % tuple(popt))\n    print('  rmse', rmse, 'maxres', np.max(np.abs(yw-yfit)))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
