Sending keys: ["python3 - <<'PY'\nimport csv, json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx=[]; y=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\nx=np.array(x, float); y=np.array(y, float)\n\ndef lorentz(x, amp, x0, gamma, offset):\n    return amp * gamma**2 / ((x-x0)**2 + gamma**2) + offset\n\nwindows={'D':(1250,1450),'G':(1500,1700),'2D':(2550,2850)}\n# Initial guesses: x0 at local max, gamma 20-40, amp ~ peak-height above estimated baseline, offset min window\nresults={}\nfor name,(lo,hi) in windows.items():\n    m=(x>=lo)&(x<=hi)\n    xw=x[m]; yw=y[m]\n    imax=np.argmax(yw)\n    x0_guess=xw[imax]\n    offset_guess=np.percentile(yw, 5)\n    amp_guess=yw[imax]-offset_guess\n    gamma_guess=25.0 if name!='2D' else 40.0\n    p0=[amp_guess, x0_guess, gamma_guess, offset_guess]\n    bounds=([0,lo,1e-6,-np.inf],[np.inf,hi,np.inf,np.inf])\n    popt,pcov=curve_fit(lorentz,xw,yw,p0=p0,bounds=bounds,maxfev=20000)\n    amp,x0,gamma,offset=popt\n    results[name]={'x0':float(x0),'gamma':float(gamma),'amplitude':float(amp),'offset':float(offset)}\n    print(name, results[name], 'window', lo, hi, 'n', len(xw), 'rms', float(np.sqrt(np.mean((yw-lorentz(xw,*popt))**2))))\n\nresults['ID_IG']=results['D']['amplitude']/results['G']['amplitude']\nwith open('/app/results.json','w') as f:\n    json.dump(results,f,indent=2)\nprint('ID_IG',results['ID_IG'])\nprint('wrote /app/results.json')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
