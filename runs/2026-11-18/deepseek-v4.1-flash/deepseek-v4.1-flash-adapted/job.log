Sending keys: ["cat > fit_peaks.py <<'PY'\nimport csv, math\n\ndef load_data():\n    xs=[]; ys=[]\n    with open('/app/spectrum.csv') as f:\n        r=csv.DictReader(f)\n        for row in r:\n            xs.append(float(row['raman_shift_cm-1']))\n            ys.append(float(row['intensity']))\n    return xs, ys\n\ndef model(p, x):\n    x0, lg, lA, off = p\n    g = math.exp(lg)\n    A = math.exp(lA)\n    return A*g*g/((x-x0)*(x-x0)+g*g) + off\n\ndef sse(p, xs, ys):\n    return sum((model(p, x)-y)**2 for x, y in zip(xs, ys))\n\ndef solve_linear(A, b):\n    n = len(b)\n    M = [A[i][:] + [b[i]] for i in range(n)]\n    for col in range(n):\n        piv = col\n        for row in range(col+1, n):\n            if abs(M[row][col]) > abs(M[piv][col]):\n                piv = row\n        if abs(M[piv][col]) < 1e-18:\n            return None\n        M[col], M[piv] = M[piv], M[col]\n        pv = M[col][col]\n        for j in range(col, n+1):\n            M[col][j] /= pv\n        for row in range(n):\n            if row == col:\n                continue\n            fac = M[row][col]\n            if abs(fac) > 0.0:\n                for j in range(col, n+1):\n                    M[row][j] -= fac*M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef fit(xs, ys, lo, hi, gamma0):\n    X=[]; Y=[]\n    for x, y in zip(xs, ys):\n        if lo <= x <= hi:\n            X.append(x); Y.append(y)\n    n = len(X)\n    im = max(range(n), key=lambda i: Y[i])\n    off0 = sorted(Y)[max(0, n//10)]\n    p = [X[im], math.log(gamma0), math.log(max(Y[im]-off0, 1.0)), off0]\n    lam = 1e-3\n    for it in range(200):\n        base = [model(p, x) for x in X]\n        r = [base[i]-Y[i] for i in range(n)]\n        ss = sum(v*v for v in r)\n        J = [[0.0]*4 for _ in range(n)]\n        for j in range(4):\n            h = 1e-5*(abs(p[j])+1.0)\n            pp = p[:]\n            pp[j] += h\n            for i in range(n):\n                J[i][j] = (model(pp, X[i])-base[i])/h\n        A = [[0.0]*4 for _ in range(4)]\n        g = [0.0]*4\n        for i in range(n):\n            for a in range(4):\n                g[a] += J[i][a]*r[i]\n                for b in range(4):\n                    A[a][b] += J[i][a]*J[i][b]\n        accepted = False\n        for attempt in range(30):\n            Ad = [row[:] for row in A]\n            for i in range(4):\n                Ad[i][i] += lam*max(A[i][i], 1e-12)\n            delta = solve_linear(Ad, [-v for v in g])\n            if delta is None:\n                lam *= 10.0\n                continue\n            pn = [p[i]+delta[i] for i in range(4)]\n            ssn = sse(pn, X, Y)\n            if ssn < ss:\n                p = pn\n                lam = max(lam*0.3, 1e-12)\n                accepted = True\n                break\n            lam *= 10.0\n        if not accepted:\n            break\n        if abs(ss-ssn) < 1e-12*(1.0+ss):\n            break\n    return p, sse(p, X, Y), it+1\n\nxs, ys = load_data()\nfor name, lo, hi, g0 in [('D', 1250, 1450, 20.0), ('G', 1500, 1700, 20.0), ('2D', 2500, 2850, 30.0)]:\n    p, ss, it = fit(xs, ys, lo, hi, g0)\n    print(name, 'iter', it, 'SSE', ss)\n    print(' x0', p[0])\n    print(' gamma', math.exp(p[1]))\n    print(' amp', math.exp(p[2]))\n    print(' offset', p[3])\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
