[?2004l[?2004h> import csv, math, json
[?2004l[?2004h> 
[?2004l[?2004h> def load_data():
[?2004l[?2004h>     x=[]; y=[]
[?2004l[?2004h>     with open('/app/spectrum.csv', newline='') as f:
[?2004l[?2004h>         reader=csv.reader(f)
[?2004l[?2004h>         next(reader)
[?2004l[?2004h>         for row in reader:
[?2004l[?2004h>             if len(row)>=2:
[?2004l[?2004h>                 x.append(float(row[0]))
[?2004l[?2004h>                 y.append(float(row[1]))
[?2004l[?2004h>     return x,y
[?2004l[?2004h> 
[?2004l[?2004h> def peak_model(p,xv):
[?2004l[?2004h>     x0,lg,lA,c=p
[?2004l[?2004h>     g=math.exp(lg)
[?2004l[?2004h>     A=math.exp(lA)
[?2004l[?2004h>     d=xv-x0
[?2004l[?2004h>     return A*g*g/(d*d+g*g)+c
[?2004l[?2004h> 
[?2004l[?2004h> def solve_linear(A,b):
[?2004l[?2004h>     n=len(b)
[?2004l[?2004h>     M=[A[i][:]+[b[i]] for i in range(n)]
[?2004l[?2004h>     for col in range(n):
[?2004l[?2004h>         piv=max(range(col,n), key=lambda r: abs(M[r][col]))
[?2004l[?2004h>         if abs(M[piv][col])<1e-18:
[?2004l[?2004h>             return None
[?2004l[?2004h>         if piv!=col:
[?2004l[?2004h>             M[col],M[piv]=M[piv],M[col]
[?2004l[?2004h>         pv=M[col][col]
[?2004l[?2004h>         for j in range(col,n+1):
[?2004l[?2004h>             M[col][j]/=pv
[?2004l[?2004h>         for r in range(n):
[?2004l[?2004h>             if r!=col:
[?2004l[?2004h>                 fac=M[r][col]
[?2004l[?2004h>                 if abs(fac)>1e-18:
[?2004l[?2004h>                     for j in range(col,n+1):
[?2004l[?2004h>                         M[r][j]-=fac*M[col][j]
[?2004l[?2004h>     return [M[i][n] for i in range(n)]
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x,y,lo,hi):
[?2004l[?2004h>     xs=[]; ys=[]
[?2004l[?2004h>     for xv,yv in zip(x,y):
[?2004l[?2004h>         if lo<=xv<=hi:
[?2004l[?2004h>             xs.append(xv); ys.append(yv)
[?2004l[?2004h>     n=len(xs)
[?2004l[?2004h>     imax=max(range(n), key=lambda i: ys[i])
[?2004l[?2004h>     x0=xs[imax]
[?2004l[?2004h>     c0=min(ys)
[?2004l[?2004h>     A0=max(ys)-c0
[?2004l[?2004h>     half=c0+0.5*A0
[?2004l[?2004h>     li=imax
[?2004l[?2004h>     while li>0 and ys[li]>half:
[?2004l[?2004h>         li-=1
[?2004l[?2004h>     ri=imax
[?2004l[?2004h>     while ri<n-1 and ys[ri]>half:
[?2004l[?2004h>         ri+=1
[?2004l[?2004h>     if li>0 and ri<n-1:
[?2004l[?2004h>         yl0,yl1=ys[li],ys[li+1]
[?2004l[?2004h>         xl0,xl1=xs[li],xs[li+1]
[?2004l[?2004h>         if abs(yl1-yl0)>1e-12:
[?2004l[?2004h>             xl=xl0+(half-yl0)*(xl1-xl0)/(yl1-yl0)
[?2004l[?2004h>         else:
[?2004l[?2004h>             xl=xl0
[?2004l[?2004h>         yr0,yr1=ys[ri-1],ys[ri]
[?2004l[?2004h>         xr0,xr1=xs[ri-1],xs[ri]
[?2004l[?2004h>         if abs(yr1-yr0)>1e-12:
[?2004l[?2004h>             xr=xr0+(half-yr0)*(xr1-xr0)/(yr1-yr0)
[?2004l[?2004h>         else:
[?2004l[?2004h>             xr=xr0
[?2004l[?2004h>         g0=max(1.0,0.5*(xr-xl))
[?2004l[?2004h>     else:
[?2004l[?2004h>         g0=10.0
[?2004l[?2004h>     p=[x0,math.log(g0),math.log(max(A0,1e-9)),c0]
[?2004l[?2004h>     lam=1e-3
[?2004l[?2004h>     last_cost=None
[?2004l[?2004h>     for it in range(300):
[?2004l[?2004h>         m=len(xs)
[?2004l[?2004h>         r=[0.0]*m
[?2004l[?2004h>         B=[[0.0]*4 for _ in range(m)]
[?2004l[?2004h>         cost=0.0
[?2004l[?2004h>         for i,(xv,yv) in enumerate(zip(xs,ys)):
[?2004l[?2004h>             x0,lg,lA,c=p
[?2004l[?2004h>             g=math.exp(lg)
[?2004l[?2004h>             A=math.exp(lA)
[?2004l[?2004h>             g2=g*g
[?2004l[?2004h>             d=xv-x0
[?2004l[?2004h>             den=d*d+g2
[?2004l[?2004h>             term=A*g2/den
[?2004l[?2004h>             fi=term+c
[?2004l[?2004h>             ri=yv-fi
[?2004l[?2004h>             r[i]=ri
[?2004l[?2004h>             B[i][0]=2.0*term*d/den
[?2004l[?2004h>             B[i][1]=2.0*term*d*d/den
[?2004l[?2004h>             B[i][2]=term
[?2004l[?2004h>             B[i][3]=1.0
[?2004l[?2004h>             cost+=ri*ri
[?2004l[?2004h>         N=[[0.0]*4 for _ in range(4)]
[?2004l[?2004h>         b=[0.0]*4
[?2004l[?2004h>         for i in range(m):
[?2004l[?2004h>             bi=B[i]; ri=r[i]
[?2004l[?2004h>             for a in range(4):
[?2004l[?2004h>                 b[a]+=bi[a]*ri
[?2004l[?2004h>                 for bb in range(4):
[?2004l[?2004h>                     N[a][bb]+=bi[a]*bi[bb]
[?2004l[?2004h>         for a in range(4):
[?2004l[?2004h>             N[a][a]+=lam*max(N[a][a],1e-12)
[?2004l[?2004h>         delta=solve_linear(N,b)
[?2004l[?2004h>         if delta is None:
[?2004l[?2004h>             break
[?2004l[?2004h>         pnew=[p[a]+delta[a] for a in range(4)]
[?2004l[?2004h>         ct=0.0
[?2004l[?2004h>         for xv,yv in zip(xs,ys):
[?2004l[?2004h>             ct+=(yv-peak_model(pnew,xv))**2
[?2004l[?2004h>         if ct<cost:
[?2004l[?2004h>             p=pnew
[?2004l[?2004h>             lam=max(lam/3.0,1e-12)
[?2004l[?2004h>             if last_cost is not None and abs(last_cost-ct)<1e-12*(last_cost+1.0):
[?2004l[?2004h>                 last_cost=ct
[?2004l[?2004h>                 break
[?2004l[?2004h>             last_cost=ct
[?2004l[?2004h>         else:
[?2004l[?2004h>             lam*=10.0
[?2004l[?2004h>             if lam>1e15:
[?2004l[?2004h>                 break
[?2004l[?2004h>         if max(abs(d) for d in delta)<1e-10:
[?2004l[?2004h>             break
[?2004l[?2004h>     x0,lg,lA,c=p
[?2004l[?2004h>     g=math.exp(lg)
[?2004l[?2004h>     A=math.exp(lA)
[?2004l[?2004h>     rms=0.0
[?2004l[?2004h>     for xv,yv in zip(xs,ys):
[?2004l[?2004h>         e=yv-peak_model(p,xv)
[?2004l[?2004h>         rms+=e*e
[?2004l[?2004h>     rms=math.sqrt(rms/len(xs))
[?2004l[?2004h>     return {'x0':x0,'gamma':g,'amplitude':A,'offset':c},rms,it+1,len(xs)
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     x,y=load_data()
[?2004l[?2004h>     windows={'D':(1200.0,1450.0),'G':(1500.0,1700.0),'2D':(2500.0,2850.0)}
[?2004l[?2004h>     out={}
[?2004l[?2004h>     for name,(lo,hi) in windows.items():
[?2004l[?2004h>         res,rms,its,n=fit_peak(x,y,lo,hi)
[?2004l[?2004h>         out[name]=res
[?2004l[?2004h>         print(name,res,'rmse',rms,'iter',its,'n',n)
[?2004l[?2004h>     out['ID_IG']=out['D']['amplitude']/out['G']['amplitude']
[?2004l[?2004h>     print('ID_IG',out['ID_IG'])
[?2004l[?2004h>     with open('/app/results.json','w') as f:
[?2004l[?2004h>         json.dump(out,f,indent=2)
[?2004l[?2004h>     print('wrote /app/results.json')
[?2004l[?2004h> 
[?2004l[?2004h> main()
