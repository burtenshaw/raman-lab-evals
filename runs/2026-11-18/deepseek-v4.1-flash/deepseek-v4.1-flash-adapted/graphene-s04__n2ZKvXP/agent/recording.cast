[12.057761, "i", "python3 - <<'PY'\nimport csv\nimport numpy as np\nx=[]; y=[]\nwith open('spectrum.csv') as f:\n    r=csv.reader(f)\n    header=next(r)\n    for row in r:\n        if len(row) >= 2:\n            x.append(float(row[0])); y.append(float(row[1]))\nx=np.array(x); y=np.array(y)\nprint('header:', header)\nprint('n:', len(x))\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\nfor lo,hi,name in [(1200,1500,'D'),(1500,1700,'G'),(2500,2900,'2D')]:\n    m=(x>=lo)&(x<=hi)\n    idx=np.where(m)[0][np.argmax(y[m])]\n    print(name, 'coarse max:', x[idx], y[idx])\nPY\n"]
