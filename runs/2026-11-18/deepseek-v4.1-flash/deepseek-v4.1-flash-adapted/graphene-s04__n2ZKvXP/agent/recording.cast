[25.347795, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row) >= 2:\n            x.append(float(row[0])); y.append(float(row[1]))\nprint('n =', len(x))\nprint('x range:', min(x), max(x))\nprint('y range:', min(y), max(y))\nfor lo,hi,name in [(1200,1500,'D'),(1500,1700,'G'),(2500,2900,'2D')]:\n    pairs=[(x[i],y[i]) for i in range(len(x)) if lo <= x[i] <= hi]\n    mx=max(pairs, key=lambda p:p[1])\n    print(name, 'coarse max:', mx, 'nwindow:', len(pairs))\nPY\n"]
