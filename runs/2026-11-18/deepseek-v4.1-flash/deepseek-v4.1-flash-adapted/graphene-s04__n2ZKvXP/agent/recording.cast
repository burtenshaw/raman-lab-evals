[52.247654, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        if len(row) >= 2:\n            x.append(float(row[0])); y.append(float(row[1]))\nfor xv in [1150,1200,1250,1300,1350,1400,1450,1500,1550,1580,1600,1650,1700,2500,2600,2650,2700,2750,2800,2900]:\n    # nearest point\n    j=min(range(len(x)), key=lambda i: abs(x[i]-xv))\n    print(f'{x[j]:8.3f} {y[j]:10.3f}')\nPY\n"]
