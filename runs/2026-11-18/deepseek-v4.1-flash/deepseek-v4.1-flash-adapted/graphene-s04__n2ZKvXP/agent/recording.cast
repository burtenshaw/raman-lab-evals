[133.280395, "i", "    for it in range(300):\n        m=len(xs)\n        r=[0.0]*m\n        B=[[0.0]*4 for _ in range(m)]\n        cost=0.0\n        for i,(xv,yv) in enumerate(zip(xs,ys)):\n            x0,lg,lA,c=p\n            g=math.exp(lg)\n            A=math.exp(lA)\n            g2=g*g\n            d=xv-x0\n            den=d*d+g2\n            term=A*g2/den\n            fi=term+c\n            ri=yv-fi\n            r[i]=ri\n            B[i][0]=2.0*term*d/den\n            B[i][1]=2.0*term*d*d/den\n            B[i][2]=term\n            B[i][3]=1.0\n            cost+=ri*ri\n        N=[[0.0]*4 for _ in range(4)]\n        b=[0.0]*4\n        for i in range(m):\n            bi=B[i]; ri=r[i]\n            for a in range(4):\n                b[a]+=bi[a]*ri\n                for bb in range(4):\n                    N[a][bb]+=bi[a]*bi[bb]\n        for a in range(4):\n            N[a][a]+=lam*max(N[a][a],1e-12)\n        delta=solve_linear(N,b)\n        if delta is None:\n            break\n        pnew=[p[a]+delta[a] for a in range(4)]\n        ct=0.0\n        for xv,yv in z"]
