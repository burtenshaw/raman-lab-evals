[132.881126, "i", "def load_data():\n    x=[]; y=[]\n    with open('/app/spectrum.csv', newline='') as f:\n        reader=csv.reader(f)\n        next(reader)\n        for row in reader:\n            if len(row)>=2:\n                x.append(float(row[0]))\n                y.append(float(row[1]))\n    return x,y\n\n"]
