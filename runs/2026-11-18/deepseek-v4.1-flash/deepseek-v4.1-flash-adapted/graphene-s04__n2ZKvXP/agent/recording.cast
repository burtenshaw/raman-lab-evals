[132.978466, "i", "def peak_model(p,xv):\n    x0,lg,lA,c=p\n    g=math.exp(lg)\n    A=math.exp(lA)\n    d=xv-x0\n    return A*g*g/(d*d+g*g)+c\n\n"]
[132.978599, "o", "def peak_model(p,xv):\r\n\u001b[?2004l\r"]
[132.978653, "o", "\u001b[?2004h> "]
[132.978711, "o", "    x0,lg,lA,c=p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.97876, "o", "    g=math.exp(lg)\r\n\u001b[?2004l\r"]
[132.978831, "o", "\u001b[?2004h>     A=math.exp(lA)\r\n\u001b[?2004l\r\u001b[?2004h>     d=xv-x0\r\n\u001b[?2004l\r"]
[132.978864, "o", "\u001b[?2004h> "]
[132.978912, "o", "    return A*g*g/(d*d+g*g)+c\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.978951, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.083852, "i", "def solve_linear(A,b):\n    n=len(b)\n    M=[A[i][:]+[b[i]] for i in range(n)]\n    for col in range(n):\n        piv=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[piv][col])<1e-18:\n            return None\n        if piv!=col:\n            M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for j in range(col,n+1):\n            M[col][j]/=pv\n        for r in range(n):\n            if r!=col:\n                fac=M[r][col]\n                if abs(fac)>1e-18:\n                    for j in range(col,n+1):\n                        M[r][j]-=fac*M[col][j]\n    return [M[i][n] for i in range(n)]\n\n"]
[133.08402, "o", "def solve_linear(A,b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
