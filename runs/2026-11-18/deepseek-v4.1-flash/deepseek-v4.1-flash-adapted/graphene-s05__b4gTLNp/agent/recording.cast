[9.106601, "i", "python3 - <<'PY'\nimport csv\nxs=[]\nys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nprint('n=', len(xs))\nprint('x range:', min(xs), max(xs))\nprint('y range:', min(ys), max(ys))\nmax_i=max(range(len(ys)), key=ys.__getitem__)\nprint('max index/x/y:', max_i, xs[max_i], ys[max_i])\nfor center in (1350,1580,2690):\n    idx=min(range(len(xs)), key=lambda i: abs(xs[i]-center))\n    print(center, 'nearest x,y:', xs[idx], ys[idx])\nPY\n"]
