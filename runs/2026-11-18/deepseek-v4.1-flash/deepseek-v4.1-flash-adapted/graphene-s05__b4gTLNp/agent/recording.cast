[19.229599, "i", "python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\n\ndef show(lo, hi, step=5):\n    print(f'--- {lo}-{hi} ---')\n    last=None\n    for x,y in zip(xs,ys):\n        if lo <= x <= hi:\n            if last is None or x-last >= step or abs(x-lo)<1e-9 or abs(x-hi)<1e-9:\n                print(f'{x:.2f} {y:.2f}')\n                last=x\nshow(1250,1450,10)\nshow(1480,1680,10)\nshow(2500,2900,20)\nPY\n"]
