[86.612541, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nprint('D region:')\nfor x,y in zip(xs,ys):\n    if 1300 <= x <= 1420:\n        if abs((x-1300)*2-round((x-1300)*2)) < 1e-6 or x<1302:\n            pass\n# print every 2 cm-1 approximately\nlast=-999\nfor x,y in zip(xs,ys):\n    if 1300 <= x <= 1420 and x-last >= 2.0:\n        print(f'{x:.3f} {y:.2f}')\n        last=x\nPY\n"]
