[67.049396, "i", "python3 - <<'PY'\nimport csv, math, json\n\n# Read data\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\n\ndef lorentz_fit(lo, hi, name, verbose=True):\n    X=[]; Y=[]\n    for x,y in zip(xs,ys):\n        if lo <= x <= hi:\n            X.append(x); Y.append(y)\n    n=len(X)\n    sy=sum(Y); sy2=sum(y*y for y in Y)\n    \n    def objective(p):\n        x0, logg = p\n        gamma=math.exp(logg)\n        if gamma < 0.5 or gamma > 100.0 or x0 < lo or x0 > hi:\n            return 1e100\n        sl=sll=sly=0.0\n        for x,y in zip(X,Y):\n            d=x-x0\n            L=gamma*gamma/(d*d+gamma*gamma)\n            sl += L\n            sll += L*L\n            sly += L*y\n        den=n*sll-sl*sl\n        if den <= 1e-18:\n            return 1e100\n        A=(n*sly-sl*sy)/den\n        C=(sy-A*sl)/n\n        if A < 0:\n            return 1e100\n        # SSE from normal-equation form\n        sse=sy2 - 2.0*A*sl"]
[67.04958, "i", "y - 2.0*C*sy + A*A*sll + 2.0*A*C*sl + n*C*C\n        return max(sse,0.0)\n    \n    peak_i=max(range(n), key=Y.__getitem__)\n    xpk=X[peak_i]\n    best=None; bestp=None\n    # Coarse grid around the observed maximum\n    dxs=[d*0.5 for d in range(-40,41)]\n    gs=[1.0+0.5*i for i in range(101)]  # 1.0 to 51.0\n    for x0 in [xpk+d for d in dxs]:\n        if x0 < lo or x0 > hi: continue\n        for g in gs:\n            p=(x0, math.log(g))\n            v=objective(p)\n            if best is None or v < best:\n                best=v; bestp=p\n    \n    def nelder_mead(f, p0, step, max_iter=2000, tol=1e-12):\n        dim=len(p0)\n        sim=[list(p0)]\n        for i in range(dim):\n            q=list(p0); q[i]+=step[i]; sim.append(q)\n        vals=[f(q) for q in sim]\n        for it in range(max_iter):\n            order=sorted(range(dim+1), key=lambda i: vals[i])\n            sim=[sim[i] for i in order]\n            vals=[vals[i] for i in order]\n            spread=max(max(abs(sim[i][j]-sim[0][j]) for j in range(dim)) for i in range(1"]
[67.049604, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.049654, "i", ",dim+1))\n            if spread < 1e-9 or abs(vals[-1]-vals[0]) < tol*(abs(vals[0])+1.0):\n                break\n            cen=[sum(sim[i][j] for i in range(dim))/dim for j in range(dim)]\n            xr=[cen[j]+(cen[j]-sim[-1][j]) for j in range(dim)]\n            fr=f(xr)\n            if fr < vals[0]:\n                xe=[cen[j]+2.0*(cen[j]-sim[-1][j]) for j in range(dim)]\n                fe=f(xe)\n                if fe < fr:\n                    sim[-1]=xe; vals[-1]=fe\n                else:\n                    sim[-1]=xr; vals[-1]=fr\n            elif fr < vals[-2]:\n                sim[-1]=xr; vals[-1]=fr\n            else:\n                if fr < vals[-1]:\n                    xc=[cen[j]+0.5*(cen[j]-sim[-1][j]) for j in range(dim)]\n                    fc=f(xc)\n                    if fc <= fr:\n                        sim[-1]=xc; vals[-1]=fc\n                    else:\n                        for i in range(1,dim+1):\n                            sim[i]=[(sim[i][j]+sim[0][j])/2.0 for j in range(dim)]\n                   "]
[67.050186, "i", "         vals[i]=f(sim[i])\n                else:\n                    xc=[cen[j]+0.5*(sim[-1][j]-cen[j]) for j in range(dim)]\n                    fc=f(xc)\n                    if fc < vals[-1]:\n                        sim[-1]=xc; vals[-1]=fc\n                    else:\n                        for i in range(1,dim+1):\n                            sim[i]=[(sim[i][j]+sim[0][j])/2.0 for j in range(dim)]\n                            vals[i]=f(sim[i])\n        best_i=min(range(dim+1), key=lambda i: vals[i])\n        return sim[best_i], vals[best_i]\n    \n    p_best, sse_best=nelder_mead(objective,bestp,[1.0,0.2])\n    x0, logg = p_best\n    gamma=math.exp(logg)\n    sl=sll=sly=0.0\n    for x,y in zip(X,Y):\n        d=x-x0\n        L=gamma*gamma/(d*d+gamma*gamma)\n        sl+=L; sll+=L*L; sly+=L*y\n    den=n*sll-sl*sl\n    A=(n*sly-sl*sy)/den\n    C=(sy-A*sl)/n\n    rms=math.sqrt(max(sse_best,0.0)/n)\n    if verbose:\n        print(f'{name}: window {lo}-{hi}, n={n}')\n        print(f'  x0={x0:.6f}, gamma={gamma:.6f}, amplitude={A:.6f}, of"]
[67.05025, "o", "import csv, math, json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Read data\r\n\u001b[?2004l\r\u001b[?2004h> xs=[]; ys=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/spectrum.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for row in csv.DictReader(f):\r\n\u001b[?2004l\r\u001b[?2004h>         xs.append(float(row['raman_shift_cm-1']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.050275, "i", "fset={C:.6f}, sse={sse_best:.6f}, rms={rms:.4f}')\n    return {'x0':x0,'gamma':gamma,'amplitude':A,'offset':C,'sse':sse_best,'rms':rms,'n':n}\n\nres={}\nres['D']=lorentz_fit(1250,1450,'D')\nres['G']=lorentz_fit(1500,1660,'G')\nres['2D']=lorentz_fit(2500,2900,'2D')\nprint('ID_IG=',res['D']['amplitude']/res['G']['amplitude'])\nPY\n"]
[67.050324, "o", "        ys.append(float(row['intensity']))\r\n\u001b[?2004l\r"]
[67.050377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[67.050396, "o", "> "]
[67.050489, "o", "def lorentz_fit(lo, hi, name, verbose=True):\r\n\u001b[?2004l\r"]
[67.050539, "o", "\u001b[?2004h> "]
[67.050588, "o", "    X=[]; Y=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.050686, "o", "    for x,y in zip(xs,ys):\r\n"]
[67.050766, "o", "\u001b[?2004l\r\u001b[?2004h>         if lo <= x <= hi:\r\n\u001b[?2004l\r"]
[67.050831, "o", "\u001b[?2004h> "]
[67.050904, "o", "            X.append(x); Y.append(y)\r\n\u001b[?2004l\r"]
[67.05096, "o", "\u001b[?2004h>     n=len(X)\r\n\u001b[?2004l\r"]
[67.051036, "o", "\u001b[?2004h>     sy=sum(Y); sy2=sum(y*y for y in Y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.051099, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.051136, "o", "    def objective(p):\r\n\u001b[?2004l\r"]
[67.051176, "o", "\u001b[?2004h> "]
[67.051248, "o", "        x0, logg = p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.051334, "o", "        gamma=math.exp(logg)\r\n\u001b[?2004l\r"]
[67.051398, "o", "\u001b[?2004h> "]
[67.051472, "o", "        if gamma < 0.5 or gamma > 100.0 or x0 < lo or x0 > hi:\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.051525, "o", "> "]
[67.051589, "o", "            return 1e100\r\n\u001b[?2004l\r\u001b[?2004h>         sl=sll=sly=0.0\r\n\u001b[?2004l\r"]
[67.051654, "o", "\u001b[?2004h> "]
[67.051688, "o", "        for x,y in zip(X,Y):\r\n\u001b[?2004l\r"]
[67.051815, "o", "\u001b[?2004h>             d=x-x0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.05188, "o", "            L=gamma*gamma/(d*d+gamma*gamma)\r\n\u001b[?2004l\r"]
[67.051936, "o", "\u001b[?2004h> "]
[67.052036, "o", "            sl += L\r\n\u001b[?2004l\r\u001b[?2004h>             sll += L*L\r\n\u001b[?2004l\r"]
[67.052113, "o", "\u001b[?2004h>             sly += L*y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.052192, "o", "        den=n*sll-sl*sl\r\n\u001b[?2004l\r"]
[67.052271, "o", "\u001b[?2004h>         if den <= 1e-18:\r\n\u001b[?2004l\r"]
[67.052306, "o", "\u001b[?2004h>             return 1e100\r\n\u001b[?2004l\r"]
[67.05246, "o", "\u001b[?2004h> "]
[67.05254, "o", "        A=(n*sly-sl*sy)/den\r\n\u001b[?2004l\r\u001b[?2004h>         C=(sy-A*sl)/n\r\n\u001b[?2004l\r\u001b[?2004h>         if A < 0:\r\n\u001b[?2004l\r"]
[67.052697, "o", "\u001b[?2004h>             return 1e100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.052777, "o", "        # SSE from normal-equation form\r\n"]
[67.052835, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.052904, "o", "        sse=sy2 - 2.0*A*sly - 2.0*C*sy + A*A*sll + 2.0*A*C*sl + n*C*C\r\n\u001b[?2004l\r"]
[67.052966, "o", "\u001b[?2004h> "]
[67.053039, "o", "        return max(sse,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.053116, "o", "    \r\n\u001b[?2004l\r"]
[67.053192, "o", "\u001b[?2004h> "]
[67.053255, "o", "    peak_i=max(range(n), key=Y.__getitem__)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.053297, "o", "    xpk=X[peak_i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.053415, "o", "    best=None; bestp=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.0535, "o", "    # Coarse grid around the observed maximum\r\n\u001b[?2004l\r"]
[67.053518, "o", "\u001b[?2004h> "]
[67.053622, "o", "    dxs=[d*0.5 for d in range(-40,41)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.053702, "o", "    gs=[1.0+0.5*i for i in range(101)]  # 1.0 to 51.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.05377, "o", "    for x0 in [xpk+d for d in dxs]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.05383, "o", "> "]
[67.05388, "o", "        if x0 < lo or x0 > hi: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.053931, "o", "> "]
[67.053978, "o", "        for g in gs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.054382, "o", ">             p=(x0, math.log(g))"]
[67.054496, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.054576, "o", "            v=objective(p)"]
[67.054813, "o", "\r\n\u001b[?2004l\r"]
[67.054906, "o", "\u001b[?2004h"]
[67.054955, "o", "> "]
[67.055614, "o", "            if best is None or v < best:\r\n\u001b[?2004l\r\u001b[?2004h>                 best=v; bestp=p\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def nelder_mead(f, p0, step, max_iter=2000, tol=1e-12):\r\n\u001b[?2004l\r\u001b[?2004h>         dim=len(p0)\r\n\u001b[?2004l\r\u001b[?2004h>         sim=[list(p0)]\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(dim):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.055687, "o", "            q=list(p0); q[i]+=step[i]; sim.append(q)\r\n"]
[67.055734, "o", "\u001b[?2004l\r"]
[67.05577, "o", "\u001b[?2004h> "]
[67.055844, "o", "        vals=[f(q) for q in sim]\r\n"]
[67.055947, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.055997, "o", ">         for it in range(max_iter):"]
[67.056037, "o", "\r\n\u001b[?2004l\r"]
[67.056198, "o", "\u001b[?2004h> "]
[67.056257, "o", "            order=sorted(range(dim+1), key=lambda i: vals[i])"]
[67.056287, "o", "\r\n\u001b[?2004l\r"]
[67.056332, "o", "\u001b[?2004h"]
[67.056945, "o", ">             sim=[sim[i] for i in order]\r\n\u001b[?2004l\r\u001b[?2004h>             vals=[vals[i] for i in order]\r\n\u001b[?2004l\r\u001b[?2004h>             spread=max(max(abs(sim[i][j]-sim[0][j]) for j in range(dim)) for i in range(1,dim+1))\r\n\u001b[?2004l\r\u001b[?2004h>             if spread < 1e-9 or abs(vals[-1]-vals[0]) < tol*(abs(vals[0])+1.0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.057152, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h>             cen=[sum(sim[i][j] for i in range(dim))/dim for j in range(dim)]"]
[67.057211, "o", "\r\n\u001b[?2004l\r"]
[67.05725, "o", "\u001b[?2004h"]
[67.057303, "o", "> "]
[67.057436, "o", "            xr=[cen[j]+(cen[j]-sim[-1][j]) for j in range(dim)]"]
[67.057488, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.057558, "o", ">             fr=f(xr)"]
[67.057625, "o", "\r\n\u001b[?2004l\r"]
[67.05779, "o", "\u001b[?2004h"]
[67.057812, "o", ">             if fr < vals[0]:"]
[67.05783, "o", "\r\n"]
[67.057848, "o", "\u001b[?2004l\r"]
[67.058066, "o", "\u001b[?2004h"]
[67.058119, "o", ">                 xe=[cen[j]+2.0*(cen[j]-sim[-1][j]) for j in range(dim)]"]
[67.058162, "o", "\r\n\u001b[?2004l\r"]
[67.058196, "o", "\u001b[?2004h"]
[67.058223, "o", "> "]
[67.058287, "o", "                fe=f(xe)"]
[67.058335, "o", "\r\n\u001b[?2004l\r"]
[67.058381, "o", "\u001b[?2004h> "]
[67.058468, "o", "                if fe < fr:\r\n"]
[67.058496, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.058581, "o", "> "]
[67.058625, "o", "                    sim[-1]=xe; vals[-1]=fe"]
[67.058642, "o", "\r\n\u001b[?2004l\r"]
[67.058695, "o", "\u001b[?2004h"]
[67.058716, "o", "> "]
[67.058792, "o", "                else:\r\n"]
[67.05882, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.058917, "o", ">                     sim[-1]=xr; vals[-1]=fr"]
[67.058974, "o", "\r\n\u001b[?2004l\r"]
[67.059114, "o", "\u001b[?2004h"]
[67.05921, "o", ">             elif fr < vals[-2]:"]
[67.059263, "o", "\r\n\u001b[?2004l\r"]
[67.059305, "o", "\u001b[?2004h> "]
[67.059361, "o", "                sim[-1]=xr; vals[-1]=fr\r\n\u001b[?2004l\r"]
[67.059417, "o", "\u001b[?2004h"]
[67.059469, "o", ">             else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.059486, "o", "> "]
[67.059558, "o", "                if fr < vals[-1]:\r\n\u001b[?2004l\r"]
[67.059611, "o", "\u001b[?2004h> "]
[67.059678, "o", "                    xc=[cen[j]+0.5*(cen[j]-sim[-1][j]) for j in range(dim)]\r\n\u001b[?2004l\r"]
[67.059744, "o", "\u001b[?2004h> "]
[67.05977, "o", "                    fc=f(xc)\r\n\u001b[?2004l\r"]
[67.059799, "o", "\u001b[?2004h> "]
[67.05989, "o", "                    if fc <= fr:\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.059931, "o", "> "]
[67.059946, "o", "                        sim[-1]=xc; vals[-1]=fc"]
[67.059984, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.060024, "o", "                    else:\r\n"]
[67.060049, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.060223, "o", "                        for i in range(1,dim+1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.060278, "o", "                            sim[i]=[(sim[i][j]+sim[0][j])/2.0 for j in range(dim)]\r\n\u001b[?2004l\r"]
[67.060329, "o", "\u001b[?2004h> "]
[67.060388, "o", "                            vals[i]=f(sim[i])\r\n\u001b[?2004l\r"]
[67.060455, "o", "\u001b[?2004h> "]
[67.060469, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.060505, "o", "> "]
[67.060615, "o", "                    xc=[cen[j]+0.5*(sim[-1][j]-cen[j]) for j in range(dim)]\r\n\u001b[?2004l\r"]
[67.060682, "o", "\u001b[?2004h> "]
[67.060736, "o", "                    fc=f(xc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.060777, "o", "                    if fc < vals[-1]:\r\n\u001b[?2004l\r"]
[67.06084, "o", "\u001b[?2004h> "]
[67.060895, "o", "                        sim[-1]=xc; vals[-1]=fc\r\n\u001b[?2004l\r"]
[67.060945, "o", "\u001b[?2004h> "]
[67.060991, "o", "                    else:\r\n\u001b[?2004l\r"]
[67.061051, "o", "\u001b[?2004h> "]
[67.061097, "o", "                        for i in range(1,dim+1):\r\n\u001b[?2004l\r"]
[67.061142, "o", "\u001b[?2004h> "]
[67.061233, "o", "                            sim[i]=[(sim[i][j]+sim[0][j])/2.0 for j in range(dim)]\r\n\u001b[?2004l\r"]
[67.061292, "o", "\u001b[?2004h> "]
[67.061358, "o", "                            vals[i]=f(sim[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.061379, "o", "> "]
[67.061537, "o", "        best_i=min(range(dim+1), key=lambda i: vals[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.063166, "o", "        return sim[best_i], vals[best_i]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     p_best, sse_best=nelder_mead(objective,bestp,[1.0,0.2])\r\n\u001b[?2004l\r\u001b[?2004h>     x0, logg = p_best\r\n\u001b[?2004l\r\u001b[?2004h>     gamma=math.exp(logg)\r\n\u001b[?2004l\r\u001b[?2004h>     sl=sll=sly=0.0\r\n\u001b[?2004l\r\u001b[?2004h>     for x,y in zip(X,Y):\r\n\u001b[?2004l\r\u001b[?2004h>         d=x-x0\r\n\u001b[?2004l\r\u001b[?2004h>         L=gamma*gamma/(d*d+gamma*gamma)\r\n\u001b[?2004l\r\u001b[?2004h>         sl+=L; sll+=L*L; sly+=L*y\r\n\u001b[?2004l\r\u001b[?2004h>     den=n*sll-sl*sl\r\n\u001b[?2004l\r\u001b[?2004h>     A=(n*sly-sl*sy)/den\r\n\u001b[?2004l\r\u001b[?2004h>     C=(sy-A*sl)/n\r\n\u001b[?2004l\r\u001b[?2004h>     rms=math.sqrt(max(sse_best,0.0)/n)\r\n\u001b[?2004l\r\u001b[?2004h>     if verbose:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'{name}: window {lo}-{hi}, n={n}')\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'  x0={x0:.6f}, gamma={gamma:.6f}, amplitude={A:.6f}, offset={C:.6f}, sse={sse_best:.6f}, rms={rms:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h>     return {'x0':x0,'gamma':gamma,'amplitude':A,'offset':C,'sse':sse_best,'rms':rms,'n':n}\r\n\u001b[?2004l\r\u001b[?2004h>"]
[67.063321, "o", " \r\n\u001b[?2004l\r\u001b[?2004h> res={}\r\n\u001b[?2004l\r\u001b[?2004h> res['D']=lorentz_fit(1250,1450,'D')\r\n\u001b[?2004l\r\u001b[?2004h> res['G']=lorentz_fit(1500,1660,'G')\r\n\u001b[?2004l\r\u001b[?2004h> res['2D']=lorentz_fit(2500,2900,'2D')\r\n\u001b[?2004l\r\u001b[?2004h> print('ID_IG=',res['D']['amplitude']/res['G']['amplitude'])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
