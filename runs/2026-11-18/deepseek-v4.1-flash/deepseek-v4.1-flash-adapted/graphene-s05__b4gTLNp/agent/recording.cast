[116.892499, "o", "history | tail -20\r\n\u001b[?2004l\r"]
[116.894392, "o", "import csv\r\nxs=[]; ys=[]\r\nwith open('/app/spectrum.csv', newline='') as f:\r\n    for row in csv.DictReader(f):\r\n        xs.append(float(row['raman_shift_cm-1']))\r\n        ys.append(float(row['intensity']))\r\nprint('D region:')\r\nfor x,y in zip(xs,ys):\r\n    if 1300 <= x <= 1420:\r\n        if abs((x-1300)*2-round((x-1300)*2)) < 1e-6 or x<1302:\r\n            pass\r\n# print every 2 cm-1 approximately\r\nlast=-999\r\nfor x,y in zip(xs,ys):\r\n    if 1300 <= x <= 1420 and x-last >= 2.0:\r\n        print(f'{x:.3f} {y:.2f}')\r\n        last=x\r\nPY\r\n\r\n   10  history | tail -20\r\n"]
[116.894653, "o", "\u001b[?2004hroot@j-openenv-6afd8caae5cad0e4dc3e6d6a-frqrx59x-087c8-22drm:/app# "]
[168.571377, "i", "python3 - <<'PY'\nimport csv, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nX=[]; Y=[]\nfor x,y in zip(xs,ys):\n    if 1250.0 <= x <= 1450.0:\n        X.append(x); Y.append(y)\nn=len(X); sy=sum(Y); syy=sum(y*y for y in Y)\ndef obj(x0, gamma):\n    g2=gamma*gamma\n    sl=sll=sly=0.0\n    for x,y in zip(X,Y):\n        d=x-x0\n        l=g2/(d*d+g2)\n        sl+=l; sll+=l*l; sly+=l*y\n    den=n*sll-sl*sl\n    if den <= 1e-18:\n        return 1e100, 0.0, 0.0\n    A=(n*sly-sl*sy)/den\n    C=(sy-A*sl)/n\n    if A < 0:\n        return 1e100, A, C\n    sse=syy-2*A*sly-2*C*sy+A*A*sll+2*A*C*sl+n*C*C\n    return max(sse,0.0), A, C\nbest=[]\nfor ix in range(0,201):\n    x0=1250.0+ix\n    for ig in range(1,61):\n        g=float(ig)\n        s,a,c=obj(x0,g)\n        best.append((s,x0,g,a,c))\nbest.sort(key=lambda t:t[0])\nprint('Top D candidates:')\nfor row in best[:10]:\n    print(f'sse={row[0]:.3f} x0={row[1"]
[168.571513, "i", "]:.4f} gamma={row[2]:.4f} amp={row[3]:.4f} off={row[4]:.4f}')\nPY\n"]
