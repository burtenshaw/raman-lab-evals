[?2004l[?2004h>     sy=sum(Y); sy2=sum(y*y for y in Y)
[?2004l[?2004h>     
[?2004l[?2004h>     def objective(p):
[?2004l[?2004h>         x0, logg = p
[?2004l[?2004h>         gamma=math.exp(logg)
[?2004l[?2004h>         if gamma < 0.5 or gamma > 100.0 or x0 < lo or x0 > hi:
[?2004l[?2004h>             return 1e100
[?2004l[?2004h>         sl=sll=sly=0.0
[?2004l[?2004h>         for x,y in zip(X,Y):
[?2004l[?2004h>             d=x-x0
[?2004l[?2004h>             L=gamma*gamma/(d*d+gamma*gamma)
[?2004l[?2004h>             sl += L
[?2004l[?2004h>             sll += L*L
[?2004l[?2004h>             sly += L*y
[?2004l[?2004h>         den=n*sll-sl*sl
[?2004l[?2004h>         if den <= 1e-18:
[?2004l[?2004h>             return 1e100
[?2004l[?2004h>         A=(n*sly-sl*sy)/den
[?2004l[?2004h>         C=(sy-A*sl)/n
[?2004l[?2004h>         if A < 0:
[?2004l[?2004h>             return 1e100
[?2004l[?2004h>         # SSE from normal-equation form
[?2004l[?2004h>         sse=sy2 - 2.0*A*sly - 2.0*C*sy + A*A*sll + 2.0*A*C*sl + n*C*C
[?2004l[?2004h>         return max(sse,0.0)
[?2004l[?2004h>     
[?2004l[?2004h>     peak_i=max(range(n), key=Y.__getitem__)
