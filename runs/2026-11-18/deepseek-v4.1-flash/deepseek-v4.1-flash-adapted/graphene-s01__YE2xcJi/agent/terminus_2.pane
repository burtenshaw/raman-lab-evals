[?2004hroot@j-openenv-6afd8a8829e8b7ccfbbb81c9-ecokh1by-a641b-qdq68:/app# cat > /app/fit_peaks.py <<'PY'
[?2004l[?2004h> import csv, math, json
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> xs_all=[]; ys_all=[]
[?2004l[?2004h> with open('/app/spectrum.csv') as f:
[?2004l[?2004h>     r=csv.reader(f)
[?2004l[?2004h>     header=next(r)
[?2004l[?2004h>     for row in r:
[?2004l[?2004h>         xs_all.append(float(row[0])); ys_all.append(float(row[1]))
[?2004l[?2004h> 
[?2004l[?2004h> def solve4(A, b):
[?2004l[?2004h>     # Gaussian elimination with partial pivoting
[?2004l[?2004h>     M=[row[:] + [b[i]] for i,row in enumerate(A)]
[?2004l[?2004h>     n=4
[?2004l[?2004h>     for col in range(n):
[?2004l[?2004h>         piv=max(range(col,n), key=lambda r: abs(M[r][col]))
[?2004l[?2004h>         if abs(M[piv][col]) < 1e-30:
[?2004l[?2004h>             raise ValueError('singular matrix')
[?2004l[?2004h>         M[col],M[piv]=M[piv],M[col]
[?2004l[?2004h>         pv=M[col][col]
[?2004l[?2004h>         for j in range(col, n+1):
[?2004l[?2004h>             M[col][j] /= pv
[?2004l[?2004h>         for r in range(n):
[?2004l[?2004h>             if r==col: continue
[?2004l[?2004h>             factor=M[r][col]
[?2004l[?2004h>             if factor != 0.0:
[?2004l[?2004h>                 for j in range(col, n+1):
[?2004l[?2004h>                     M[r][j] -= factor*M[col][j]
[?2004l[?2004h>     return [M[i][n] for i in range(n)]
[?2004l[?2004h> 
[?2004l[?2004h> def model(x, p, center):
[?2004l[?2004h>     A,g,x0c,c=p
[?2004l[?2004h>     x0=x0c+center
[?2004l[?2004h>     d=(x-x0)*(x-x0)+g*g
[?2004l[?2004h>     return c + A*g*g/d
[?2004l[?2004h> 
[?2004l[?2004h> def jac(x, p, center):
[?2004l[?2004h>     A,g,x0c,c=p
[?2004l[?2004h>     x0=x0c+center
[?2004l[?2004h>     dx=x-x0
[?2004l[?2004h>     d=dx*dx+g*g
[?2004l[?2004h>     return [g*g/d, 2.0*A*g*dx*dx/(d*d), 2.0*A*g*g*dx/(d*d), 1.0]
[?2004l[?2004h> 
[?2004l[?2004h> def fit_lorentz(x, y, p0, center, max_iter=500):
[?2004l[?2004h>     p=p0[:]
[?2004l[?2004h>     lam=1e-3
[?2004l[?2004h>     old_cost=sum((yy-model(xx,p,center))**2 for xx,yy in zip(x,y))
[?2004l[?2004h>     for it in range(max_iter):
[?2004l[?2004h>         n=len(x)
[?2004l[?2004h>         J=[]; res=[]
[?2004l[?2004h>         for xx,yy in zip(x,y):
[?2004l[?2004h>             J.append(jac(xx,p,center))
[?2004l[?2004h>             res.append(yy-model(xx,p,center))
[?2004l[?2004h>         A=[[0.0]*4 for _ in range(4)]
[?2004l[?2004h>         b=[0.0]*4
[?2004l[?2004h>         for row,rr in zip(J,res):
[?2004l[?2004h>             for i in range(4):
[?2004l[?2004h>                 b[i]+=row[i]*rr
[?2004l[?2004h>                 for j in range(4):
[?2004l[?2004h>                     A[i][j]+=row[i]*row[j]
[?2004l[?2004h>         for i in range(4):
[?2004l[?2004h>             A[i][i]*=(1.0+lam)
[?2004l[?2004h>         try:
[?2004l[?2004h>             delta=solve4(A,b)
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             lam*=10
[?2004l[?2004h>             if lam>1e12: break
[?2004l[?2004h>             continue
[?2004l[?2004h>         pn=[p[i]+delta[i] for i in range(4)]
[?2004l[?2004h>         # keep physically reasonable parameters
[?2004l[?2004h>         if pn[0] <= 0 or pn[1] <= 0:
[?2004l[?2004h>             lam*=5
[?2004l[?2004h>             if lam>1e12: break
[?2004l[?2004h>             continue
[?2004l[?2004h>         new_cost=sum((yy-model(xx,pn,center))**2 for xx,yy in zip(x,y))
[?2004l[?2004h>         if new_cost < old_cost:
[?2004l[?2004h>             p=pn
[?2004l[?2004h>             old_cost=new_cost
[?2004l[?2004h>             lam=max(lam*0.3,1e-12)
[?2004l[?2004h>             if max(abs(d) for d in delta) < 1e-11:
[?2004l[?2004h>                 break
[?2004l[?2004h>         else:
[?2004l[?2004h>             lam*=5
[?2004l[?2004h>             if lam>1e12: break
[?2004l[?2004h>     return p, old_cost
[?2004l[?2004h> 
[?2004l[?2004h> def fit_window(name, lo, hi):
[?2004l[?2004h>     inds=[i for i,v in enumerate(xs_all) if lo <= v <= hi]
[?2004l[?2004h>     x=[xs_all[i] for i in inds]
[?2004l[?2004h>     y=[ys_all[i] for i in inds]
[?2004l[?2004h>     imax=max(range(len(x)), key=lambda i:y[i])
[?2004l[?2004h>     xp=x[imax]; yp=y[imax]
[?2004l[?2004h>     c0=min(y)
[?2004l[?2004h>     A0=max(yp-c0, 1.0)
[?2004l[?2004h>     # estimate gamma as half-width at half max around the peak
[?2004l[?2004h>     target=c0+A0/2.0
[?2004l[?2004h>     li=imax
[?2004l[?2004h>     while li>0 and y[li]>=target: li-=1
[?2004l[?2004h>     ri=imax
[?2004l[?2004h>     while ri<len(y)-1 and y[ri]>=target: ri+=1
[?2004l[?2004h>     gamma0=max(2.0,(x[ri]-x[li])/2.0)
[?2004l[?2004h>     center=xp
[?2004l[?2004h>     p0=[A0,gamma0,0.0,c0]
[?2004l[?2004h>     p,cost=fit_lorentz(x,y,p0,center)
[?2004l[?2004h>     A,g,x0c,c=p
[?2004l[?2004h>     x0=x0c+center
[?2004l[?2004h>     return {'x0':x0,'gamma':g,'amplitude':A,'offset':c}, cost, len(x)
[?2004l[?2004h> 
[?2004l[?2004h> windows=[('D',1250,1450),('G',1480,1670),('2D',2500,2850)]
[?2004l[?2004h> results={}
[?2004l[?2004h> for name,lo,hi in windows:
[?2004l[?2004h>     p,cost,n=fit_window(name,lo,hi)
[?2004l[?2004h>     results[name]=p
[?2004l[?2004h>     print(name, 'window',lo,hi,'n',n,'cost',cost)
[?2004l[?2004h>     print('  x0=%.6f gamma=%.6f amp=%.6f offset=%.6f' % (p['x0'],p['gamma'],p['amplitude'],p['offset']))
[?2004l[?2004h> print('ID_IG=%.10f' % (results['D']['amplitude']/results['G']['amplitude']))
[?2004l[?2004h> 
[?2004l[?2004h> # Save a first version; will inspect before finalizing
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     out={
[?2004l[?2004h>       'D':results['D'], 'G':results['G'], '2D':results['2D'],
[?2004l[?2004h>       'ID_IG':results['D']['amplitude']/results['G']['amplitude']
[?2004l[?2004h>     }
[?2004l[?2004h>     json.dump(out,f,indent=2)
[?2004l[?2004h> PY
