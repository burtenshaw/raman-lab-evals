[?2004hroot@j-openenv-6afd8a8829e8b7ccfbbb81c9-ecokh1by-a641b-qdq68:/app# python3 - <<'PY'
[?2004l[?2004h> import csv, math
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/spectrum.csv') as f:
[?2004l[?2004h>     r=csv.reader(f); next(r)
[?2004l[?2004h>     data=[(float(a),float(b)) for a,b in r]
[?2004l[?2004h> 
[?2004l[?2004h> def best_linear(xs, ys, x0, gamma):
[?2004l[?2004h>     # y = c + A*b, b=gamma^2/((x-x0)^2+gamma^2)
[?2004l[?2004h>     n=len(xs)
[?2004l[?2004h>     sb=sb2=sby=sy=0.0
[?2004l[?2004h>     for x,y in zip(xs,ys):
[?2004l[?2004h>         b=gamma*gamma/((x-x0)*(x-x0)+gamma*gamma)
[?2004l[?2004h>         sb += b; sb2 += b*b; sby += b*y; sy += y
[?2004l[?2004h>     den=n*sb2-sb*sb
[?2004l[?2004h>     if den <= 0: return None
[?2004l[?2004h>     A=(n*sby-sb*sy)/den
[?2004l[?2004h>     c=(sy-A*sb)/n
[?2004l[?2004h>     sse=0.0
[?2004l[?2004h>     for x,y in zip(xs,ys):
[?2004l[?2004h>         b=gamma*gamma/((x-x0)*(x-x0)+gamma*gamma)
[?2004l[?2004h>         m=c+A*b
[?2004l[?2004h>         sse += (y-m)*(y-m)
[?2004l[?2004h>     return sse,A,c
[?2004l[?2004h> 
[?2004l[?2004h> def grid_search(name, lo, hi, x0lo, x0hi, glo, ghi, nx=101, ng=101):
[?2004l[?2004h>     xs=[x for x,y in data if lo<=x<=hi]
[?2004l[?2004h>     ys=[y for x,y in data if lo<=x<=hi]
[?2004l[?2004h>     best=(1e99,None,None,None)
[?2004l[?2004h>     for i in range(nx):
[?2004l[?2004h>         x0=x0lo+(x0hi-x0lo)*i/(nx-1)
[?2004l[?2004h>         for j in range(ng):
[?2004l[?2004h>             g=glo+(ghi-glo)*j/(ng-1)
[?2004l[?2004h>             r=best_linear(xs,ys,x0,g)
[?2004l[?2004h>             if r is None: continue
[?2004l[?2004h>             sse,A,c=r
[?2004l[?2004h>             if sse<best[0]:
[?2004l[?2004h>                 best=(sse,x0,g,(A,c))
[?2004l[?2004h>     print(name, 'coarse best: sse=%.3f x0=%.6f gamma=%.6f A=%.6f c=%.6f' % (best[0],best[1],best[2],best[3][0],best[3][1]))
[?2004l[?2004h>     # local refinement by shrinking grid around current best
[?2004l[?2004h>     x0,x0w=best[1],(x0hi-x0lo)/(nx-1)
[?2004l[?2004h>     g,gw=best[2],(ghi-glo)/(ng-1)
[?2004l[?2004h>     for it in range(8):
[?2004l[?2004h>         b=best
[?2004l[?2004h>         for i in range(21):
[?2004l[?2004h>             xt=x0+(i-10)*x0w/10
[?2004l[?2004h>             if not (x0lo<=xt<=x0hi): continue
[?2004l[?2004h>             for j in range(21):
[?2004l[?2004h>                 gt=g+(j-10)*gw/10
[?2004l[?2004h>                 if not (glo<=gt<=ghi): continue
[?2004l[?2004h>                 r=best_linear(xs,ys,xt,gt)
[?2004l[?2004h>                 if r is None: continue
[?2004l[?2004h>                 sse,A,c=r
[?2004l[?2004h>                 if sse<b[0]: b=(sse,xt,gt,(A,c))
[?2004l[?2004h>         best=b
[?2004l[?2004h>         x0,x0w=best[1],x0w/10
[?2004l[?2004h>         g,gw=best[2],gw/10
[?2004l[?2004h>     print(name, 'refined best: sse=%.3f x0=%.9f gamma=%.9f A=%.9f c=%.9f' % (best[0],best[1],best[2],best[3][0],best[3][1]))
[?2004l[?2004h>     return best
[?2004l[?2004h> 
[?2004l[?2004h> grid_search('D', 1250, 1450, 1330, 1370, 3, 50)
[?2004l[?2004h> grid_search('G', 1480, 1670, 1570, 1595, 3, 30)
[?2004l[?2004h> grid_search('2D', 2500, 2850, 2680, 2710, 10, 60)
