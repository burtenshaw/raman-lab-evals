[44.290047, "o", "    for it in range(max_iter):\r\n\u001b[?2004l\r"]
[44.290072, "o", "\u001b[?2004h> "]
[44.290109, "o", "        n=len(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.290133, "o", "> "]
[44.290165, "o", "        J=[]; res=[]\r\n\u001b[?2004l\r"]
[44.29019, "o", "\u001b[?2004h> "]
[44.290236, "o", "        for xx,yy in zip(x,y):\r\n\u001b[?2004l\r"]
[44.290271, "o", "\u001b[?2004h> "]
[44.290313, "o", "            J.append(jac(xx,p,center))\r\n\u001b[?2004l\r"]
[44.290337, "o", "\u001b[?2004h> "]
[44.290401, "o", "            res.append(yy-model(xx,p,center))\r\n\u001b[?2004l\r"]
[44.290435, "o", "\u001b[?2004h> "]
[44.290476, "o", "        A=[[0.0]*4 for _ in range(4)]\r\n\u001b[?2004l\r"]
[44.290501, "o", "\u001b[?2004h> "]
[44.290535, "o", "        b=[0.0]*4\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.29056, "o", "> "]
[44.290602, "o", "        for row,rr in zip(J,res):\r\n\u001b[?2004l\r"]
[44.290627, "o", "\u001b[?2004h> "]
[44.290672, "o", "            for i in range(4):\r\n\u001b[?2004l\r"]
[44.290696, "o", "\u001b[?2004h> "]
[44.29074, "o", "                b[i]+=row[i]*rr\r\n\u001b[?2004l\r"]
[44.290761, "o", "\u001b[?2004h> "]
[44.29082, "o", "                for j in range(4):\r\n\u001b[?2004l\r"]
[44.290844, "o", "\u001b[?2004h> "]
[44.290901, "o", "                    A[i][j]+=row[i]*row[j]\r\n\u001b[?2004l\r"]
[44.290926, "o", "\u001b[?2004h> "]
[44.290966, "o", "        for i in range(4):\r\n\u001b[?2004l\r"]
[44.29099, "o", "\u001b[?2004h> "]
[44.291033, "o", "            A[i][i]*=(1.0+lam)\r\n\u001b[?2004l\r"]
[44.291057, "o", "\u001b[?2004h> "]
[44.291083, "o", "        try:\r\n\u001b[?2004l\r"]
[44.291108, "o", "\u001b[?2004h> "]
[44.291152, "o", "            delta=solve4(A,b)\r\n\u001b[?2004l\r"]
[44.291176, "o", "\u001b[?2004h> "]
[44.291213, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[44.291248, "o", "\u001b[?2004h> "]
[44.291282, "o", "            lam*=10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.291341, "o", "            if lam>1e12: break\r\n\u001b[?2004l\r"]
[44.291365, "o", "\u001b[?2004h> "]
[44.291399, "o", "            continue\r\n\u001b[?2004l\r"]
[44.291433, "o", "\u001b[?2004h> "]
[44.291477, "o", "        pn=[p[i]+delta[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[44.291512, "o", "\u001b[?2004h> "]
[44.29155, "o", "        # keep physically reasonable parameters\r\n\u001b[?2004l\r"]
[44.291574, "o", "\u001b[?2004h> "]
[44.29161, "o", "        if pn[0] <= 0 or pn[1] <= 0:\r\n\u001b[?2004l\r"]
[44.291635, "o", "\u001b[?2004h> "]
[44.291669, "o", "            lam*=5\r\n\u001b[?2004l\r"]
[44.291693, "o", "\u001b[?2004h> "]
[44.291702, "o", "            if lam>1e12: break\r\n\u001b[?2004l\r"]
[44.291741, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r"]
[44.291773, "o", "\u001b[?2004h> "]
[44.291877, "o", "        new_cost=sum((yy-model(xx,pn,center))**2 for xx,yy in zip(x,y))\r\n\u001b[?2004l\r"]
[44.291887, "o", "\u001b[?2004h> "]
[44.291951, "o", "        if new_cost < old_cost:\r\n\u001b[?2004l\r"]
[44.291976, "o", "\u001b[?2004h> "]
[44.292006, "o", "            p=pn\r\n\u001b[?2004l\r"]
[44.292035, "o", "\u001b[?2004h> "]
[44.292073, "o", "            old_cost=new_cost\r\n\u001b[?2004l\r"]
[44.292082, "o", "\u001b[?2004h> "]
[44.292149, "o", "            lam=max(lam*0.3,1e-12)\r\n\u001b[?2004l\r"]
[44.292183, "o", "\u001b[?2004h> "]
[44.29222, "o", "            if max(abs(d) for d in delta) < 1e-11:\r\n\u001b[?2004l\r"]
[44.292248, "o", "\u001b[?2004h> "]
[44.292279, "o", "                break\r\n\u001b[?2004l\r"]
[44.292315, "o", "\u001b[?2004h> "]
[44.29235, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.292386, "o", "            lam*=5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.292424, "o", "            if lam>1e12: break\r\n\u001b[?2004l\r"]
[44.292449, "o", "\u001b[?2004h> "]
[44.292485, "o", "    return p, old_cost\r\n\u001b[?2004l\r"]
[44.292521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.292564, "o", "def fit_window(name, lo, hi):\r\n\u001b[?2004l\r"]
[44.292599, "o", "\u001b[?2004h> "]
[44.292639, "o", "    inds=[i for i,v in enumerate(xs_all) if lo <= v <= hi]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.292683, "o", "    x=[xs_all[i] for i in inds]\r\n\u001b[?2004l\r"]
[44.292709, "o", "\u001b[?2004h> "]
[44.292754, "o", "    y=[ys_all[i] for i in inds]\r\n\u001b[?2004l\r"]
[44.292792, "o", "\u001b[?2004h> "]
[44.292863, "o", "    imax=max(range(len(x)), key=lambda i:y[i])\r\n\u001b[?2004l\r"]
[44.292901, "o", "\u001b[?2004h> "]
[44.292941, "o", "    xp=x[imax]; yp=y[imax]\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.292964, "o", "> "]
[44.293001, "o", "    c0=min(y)\r\n\u001b[?2004l\r"]
[44.293033, "o", "\u001b[?2004h> "]
[44.293065, "o", "    A0=max(yp-c0, 1.0)"]
[44.293099, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.293189, "o", "    # estimate gamma as half-width at half max around the peak\r\n\u001b[?2004l\r"]
[44.29323, "o", "\u001b[?2004h> "]
[44.293263, "o", "    target=c0+A0/2.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.293299, "o", "    li=imax\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.293336, "o", "    while li>0 and y[li]>=target: li-=1\r\n\u001b[?2004l\r"]
[44.293371, "o", "\u001b[?2004h> "]
[44.293406, "o", "    ri=imax\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.293435, "o", "    while ri<len(y)-1 and y[ri]>=target: ri+=1\r\n\u001b[?2004l\r"]
[44.293473, "o", "\u001b[?2004h> "]
[44.293505, "o", "    gamma0=max(2.0,(x[ri]-x[li])/2.0)\r\n\u001b[?2004l\r"]
[44.293514, "o", "\u001b[?2004h"]
[44.293554, "o", "> "]
[44.293587, "o", "    center=xp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.29362, "o", "    p0=[A0,gamma0,0.0,c0]\r\n\u001b[?2004l\r"]
[44.293669, "o", "\u001b[?2004h>     p,cost=fit_lorentz(x,y,p0,center)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.293709, "o", "    A,g,x0c,c=p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.293743, "o", "    x0=x0c+center\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.293877, "o", "    return {'x0':x0,'gamma':g,'amplitude':A,'offset':c}, cost, len(x)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[44.293982, "o", "\u001b[?2004h> "]
[44.294023, "o", "windows=[('D',1250,1450),('G',1480,1670),('2D',2500,2850)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.294044, "o", "results={}\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.294091, "o", "> "]
[44.294126, "o", "for name,lo,hi in windows:\r\n\u001b[?2004l\r"]
[44.294161, "o", "\u001b[?2004h> "]
[44.29421, "o", "    p,cost,n=fit_window(name,lo,hi)\r\n\u001b[?2004l\r"]
[44.294246, "o", "\u001b[?2004h> "]
[44.294278, "o", "    results[name]=p\r\n\u001b[?2004l\r"]
[44.294301, "o", "\u001b[?2004h> "]
[44.294365, "o", "    print(name, 'window',lo,hi,'n',n,'cost',cost)\r\n\u001b[?2004l\r"]
[44.294388, "o", "\u001b[?2004h> "]
[44.294519, "o", "    print('  x0=%.6f gamma=%.6f amp=%.6f offset=%.6f' % (p['x0'],p['gamma'],p['amplitude'],p['offset']))\r\n\u001b[?2004l\r"]
[44.294552, "o", "\u001b[?2004h> "]
[44.294645, "o", "print('ID_IG=%.10f' % (results['D']['amplitude']/results['G']['amplitude']))\r\n\u001b[?2004l\r"]
[44.294676, "o", "\u001b[?2004h> "]
[44.294701, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.294776, "o", "# Save a first version; will inspect before finalizing\r\n\u001b[?2004l\r"]
[44.294799, "o", "\u001b[?2004h> "]
[44.294859, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r"]
[44.294895, "o", "\u001b[?2004h> "]
[44.294932, "o", "    out={\r\n\u001b[?2004l\r"]
[44.294955, "o", "\u001b[?2004h> "]
[44.295021, "o", "      'D':results['D'], 'G':results['G'], '2D':results['2D'],\r\n\u001b[?2004l\r"]
[44.295044, "o", "\u001b[?2004h> "]
[44.295133, "o", "      'ID_IG':results['D']['amplitude']/results['G']['amplitude']\r\n\u001b[?2004l\r"]
[44.295155, "o", "\u001b[?2004h> "]
[44.295187, "o", "    }\r\n\u001b[?2004l\r"]
[44.295211, "o", "\u001b[?2004h> "]
[44.295256, "o", "    json.dump(out,f,indent=2)\r\n\u001b[?2004l\r"]
[44.295286, "o", "\u001b[?2004h> PY\r\n"]
[44.295323, "o", "\u001b[?2004l\r"]
[44.296555, "o", "\u001b[?2004hroot@j-openenv-6afd8a8829e8b7ccfbbb81c9-ecokh1by-a641b-qdq68:/app# "]
[44.296606, "o", "python3 /app/fit_peaks.py\r\n\u001b[?2004l\r"]
