[44.286702, "i", "cat > /app/fit_peaks.py <<'PY'\nimport csv, math, json\n\n# Load data\nxs_all=[]; ys_all=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    header=next(r)\n    for row in r:\n        xs_all.append(float(row[0])); ys_all.append(float(row[1]))\n\ndef solve4(A, b):\n    # Gaussian elimination with partial pivoting\n    M=[row[:] + [b[i]] for i,row in enumerate(A)]\n    n=4\n    for col in range(n):\n        piv=max(range(col,n), key=lambda r: abs(M[r][col]))\n        if abs(M[piv][col]) < 1e-30:\n            raise ValueError('singular matrix')\n        M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for j in range(col, n+1):\n            M[col][j] /= pv\n        for r in range(n):\n            if r==col: continue\n            factor=M[r][col]\n            if factor != 0.0:\n                for j in range(col, n+1):\n                    M[r][j] -= factor*M[col][j]\n    return [M[i][n] for i in range(n)]\n\ndef model(x, p, center):\n    A,g,x0c,c=p\n    x0=x0c+center\n    d=(x-x0)*(x-x0)+g*g\n    return c + A*g*g/d\n\ndef"]
[44.286863, "i", " jac(x, p, center):\n    A,g,x0c,c=p\n    x0=x0c+center\n    dx=x-x0\n    d=dx*dx+g*g\n    return [g*g/d, 2.0*A*g*dx*dx/(d*d), 2.0*A*g*g*dx/(d*d), 1.0]\n\ndef fit_lorentz(x, y, p0, center, max_iter=500):\n    p=p0[:]\n    lam=1e-3\n    old_cost=sum((yy-model(xx,p,center))**2 for xx,yy in zip(x,y))\n    for it in range(max_iter):\n        n=len(x)\n        J=[]; res=[]\n        for xx,yy in zip(x,y):\n            J.append(jac(xx,p,center))\n            res.append(yy-model(xx,p,center))\n        A=[[0.0]*4 for _ in range(4)]\n        b=[0.0]*4\n        for row,rr in zip(J,res):\n            for i in range(4):\n                b[i]+=row[i]*rr\n                for j in range(4):\n                    A[i][j]+=row[i]*row[j]\n        for i in range(4):\n            A[i][i]*=(1.0+lam)\n        try:\n            delta=solve4(A,b)\n        except Exception:\n            lam*=10\n            if lam>1e12: break\n            continue\n        pn=[p[i]+delta[i] for i in range(4)]\n        # keep physically reasonable parameters\n        if pn[0] <= 0 or pn"]
[44.286909, "o", "cat > /app/fit_peaks.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.286941, "i", "[1] <= 0:\n            lam*=5\n            if lam>1e12: break\n            continue\n        new_cost=sum((yy-model(xx,pn,center))**2 for xx,yy in zip(x,y))\n        if new_cost < old_cost:\n            p=pn\n            old_cost=new_cost\n            lam=max(lam*0.3,1e-12)\n            if max(abs(d) for d in delta) < 1e-11:\n                break\n        else:\n            lam*=5\n            if lam>1e12: break\n    return p, old_cost\n\ndef fit_window(name, lo, hi):\n    inds=[i for i,v in enumerate(xs_all) if lo <= v <= hi]\n    x=[xs_all[i] for i in inds]\n    y=[ys_all[i] for i in inds]\n    imax=max(range(len(x)), key=lambda i:y[i])\n    xp=x[imax]; yp=y[imax]\n    c0=min(y)\n    A0=max(yp-c0, 1.0)\n    # estimate gamma as half-width at half max around the peak\n    target=c0+A0/2.0\n    li=imax\n    while li>0 and y[li]>=target: li-=1\n    ri=imax\n    while ri<len(y)-1 and y[ri]>=target: ri+=1\n    gamma0=max(2.0,(x[ri]-x[li])/2.0)\n    center=xp\n    p0=[A0,gamma0,0.0,c0]\n    p,cost=fit_lorentz(x,y,p0,center)\n    A,g,x0c,c=p\n    x"]
[44.286976, "o", "import csv, math, json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.287007, "i", "0=x0c+center\n    return {'x0':x0,'gamma':g,'amplitude':A,'offset':c}, cost, len(x)\n\nwindows=[('D',1250,1450),('G',1480,1670),('2D',2500,2850)]\nresults={}\nfor name,lo,hi in windows:\n    p,cost,n=fit_window(name,lo,hi)\n    results[name]=p\n    print(name, 'window',lo,hi,'n',n,'cost',cost)\n    print('  x0=%.6f gamma=%.6f amp=%.6f offset=%.6f' % (p['x0'],p['gamma'],p['amplitude'],p['offset']))\nprint('ID_IG=%.10f' % (results['D']['amplitude']/results['G']['amplitude']))\n\n# Save a first version; will inspect before finalizing\nwith open('/app/results.json','w') as f:\n    out={\n      'D':results['D'], 'G':results['G'], '2D':results['2D'],\n      'ID_IG':results['D']['amplitude']/results['G']['amplitude']\n    }\n    json.dump(out,f,indent=2)\nPY\npython3 /app/fit_peaks.py\n"]
