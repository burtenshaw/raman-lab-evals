[57.363623, "o", "            m=p['offset'] + p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)\r\n\u001b[?2004l\r"]
[57.363655, "o", "\u001b[?2004h> "]
[57.36371, "o", "            print(f'{x:.2f}, {y:.2f}, {m:.2f}, {y-m:.2f}')\r\n\u001b[?2004l\r"]
[57.363749, "o", "\u001b[?2004h> "]
