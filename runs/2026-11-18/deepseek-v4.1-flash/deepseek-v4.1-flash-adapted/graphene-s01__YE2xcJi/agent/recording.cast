[72.41579, "i", "python3 - <<'PY'\nimport csv, math\n\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    data=[(float(a),float(b)) for a,b in r]\n\ndef best_linear(xs, ys, x0, gamma):\n    # y = c + A*b, b=gamma^2/((x-x0)^2+gamma^2)\n    n=len(xs)\n    sb=sb2=sby=sy=0.0\n    for x,y in zip(xs,ys):\n        b=gamma*gamma/((x-x0)*(x-x0)+gamma*gamma)\n        sb += b; sb2 += b*b; sby += b*y; sy += y\n    den=n*sb2-sb*sb\n    if den <= 0: return None\n    A=(n*sby-sb*sy)/den\n    c=(sy-A*sb)/n\n    sse=0.0\n    for x,y in zip(xs,ys):\n        b=gamma*gamma/((x-x0)*(x-x0)+gamma*gamma)\n        m=c+A*b\n        sse += (y-m)*(y-m)\n    return sse,A,c\n\ndef grid_search(name, lo, hi, x0lo, x0hi, glo, ghi, nx=101, ng=101):\n    xs=[x for x,y in data if lo<=x<=hi]\n    ys=[y for x,y in data if lo<=x<=hi]\n    best=(1e99,None,None,None)\n    for i in range(nx):\n        x0=x0lo+(x0hi-x0lo)*i/(nx-1)\n        for j in range(ng):\n            g=glo+(ghi-glo)*j/(ng-1)\n            r=best_linear(xs,ys,x0,g)\n            if r is None: continue\n          "]
[72.416001, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, math\r\n\u001b[?2004l\r"]
[72.416086, "i", "  sse,A,c=r\n            if sse<best[0]:\n                best=(sse,x0,g,(A,c))\n    print(name, 'coarse best: sse=%.3f x0=%.6f gamma=%.6f A=%.6f c=%.6f' % (best[0],best[1],best[2],best[3][0],best[3][1]))\n    # local refinement by shrinking grid around current best\n    x0,x0w=best[1],(x0hi-x0lo)/(nx-1)\n    g,gw=best[2],(ghi-glo)/(ng-1)\n    for it in range(8):\n        b=best\n        for i in range(21):\n            xt=x0+(i-10)*x0w/10\n            if not (x0lo<=xt<=x0hi): continue\n            for j in range(21):\n                gt=g+(j-10)*gw/10\n                if not (glo<=gt<=ghi): continue\n                r=best_linear(xs,ys,xt,gt)\n                if r is None: continue\n                sse,A,c=r\n                if sse<b[0]: b=(sse,xt,gt,(A,c))\n        best=b\n        x0,x0w=best[1],x0w/10\n        g,gw=best[2],gw/10\n    print(name, 'refined best: sse=%.3f x0=%.9f gamma=%.9f A=%.9f c=%.9f' % (best[0],best[1],best[2],best[3][0],best[3][1]))\n    return best\n\ngrid_search('D', 1250, 1450, 1330, 1370, 3, 50)\ngrid_search"]
[72.416145, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/spectrum.csv') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.416185, "i", "('G', 1480, 1670, 1570, 1595, 3, 30)\ngrid_search('2D', 2500, 2850, 2680, 2710, 10, 60)\nPY\n"]
[72.416221, "o", "    r=csv.reader(f); next(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.416255, "o", "    data=[(float(a),float(b)) for a,b in r]\r\n\u001b[?2004l\r"]
[72.416288, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.416315, "o", "> "]
[72.416347, "o", "def best_linear(xs, ys, x0, gamma):\r\n\u001b[?2004l\r"]
[72.416396, "o", "\u001b[?2004h> "]
[72.416432, "o", "    # y = c + A*b, b=gamma^2/((x-x0)^2+gamma^2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.416465, "o", "    n=len(xs)\r\n\u001b[?2004l\r"]
[72.416494, "o", "\u001b[?2004h>     sb=sb2=sby=sy=0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.416527, "o", "> "]
[72.416561, "o", "    for x,y in zip(xs,ys):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.416609, "o", "        b=gamma*gamma/((x-x0)*(x-x0)+gamma*gamma)\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.416641, "o", "> "]
[72.416688, "o", "        sb += b; sb2 += b*b; sby += b*y; sy += y\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.41672, "o", "> "]
[72.416755, "o", "    den=n*sb2-sb*sb\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.416785, "o", "    if den <= 0: return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.416812, "o", "> "]
[72.416842, "o", "    A=(n*sby-sb*sy)/den\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.41687, "o", "    c=(sy-A*sb)/n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.416898, "o", "    sse=0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.416926, "o", "> "]
[72.416957, "o", "    for x,y in zip(xs,ys):\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.416986, "o", "> "]
[72.417022, "o", "        b=gamma*gamma/((x-x0)*(x-x0)+gamma*gamma)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.417061, "o", "        m=c+A*b\r\n\u001b[?2004l\r"]
[72.41709, "o", "\u001b[?2004h> "]
[72.417118, "o", "        sse += (y-m)*(y-m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.41715, "o", "    return sse,A,c\r\n\u001b[?2004l\r"]
[72.41718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.41721, "o", "\u001b[?2004h> "]
[72.417269, "o", "def grid_search(name, lo, hi, x0lo, x0hi, glo, ghi, nx=101, ng=101):\r\n\u001b[?2004l\r"]
[72.417299, "o", "\u001b[?2004h> "]
[72.417356, "o", "    xs=[x for x,y in data if lo<=x<=hi]\r\n\u001b[?2004l\r"]
[72.417385, "o", "\u001b[?2004h> "]
[72.417427, "o", "    ys=[y for x,y in data if lo<=x<=hi]\r\n\u001b[?2004l\r"]
[72.417456, "o", "\u001b[?2004h> "]
[72.417497, "o", "    best=(1e99,None,None,None)"]
[72.417527, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.417557, "o", "    for i in range(nx):\r\n\u001b[?2004l\r"]
[72.417586, "o", "\u001b[?2004h> "]
[72.417616, "o", "        x0=x0lo+(x0hi-x0lo)*i/(nx-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.417642, "o", "        for j in range(ng):"]
[72.417672, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.417711, "o", "            g=glo+(ghi-glo)*j/(ng-1)\r\n\u001b[?2004l\r"]
[72.417741, "o", "\u001b[?2004h> "]
[72.417766, "o", "            r=best_linear(xs,ys,x0,g)\r\n\u001b[?2004l\r"]
[72.417795, "o", "\u001b[?2004h> "]
[72.417833, "o", "            if r is None: continue\r\n\u001b[?2004l\r"]
[72.417859, "o", "\u001b[?2004h> "]
[72.417888, "o", "            sse,A,c=r\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.417908, "o", "> "]
[72.417943, "o", "            if sse<best[0]:\r\n\u001b[?2004l\r"]
[72.417975, "o", "\u001b[?2004h> "]
[72.418007, "o", "                best=(sse,x0,g,(A,c))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.418149, "o", "    print(name, 'coarse best: sse=%.3f x0=%.6f gamma=%.6f A=%.6f c=%.6f' % (best[0],best[1],best[2],best[3][0],best[3][1]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.418181, "o", "> "]
[72.418242, "o", "    # local refinement by shrinking grid around current best\r\n\u001b[?2004l\r"]
[72.418271, "o", "\u001b[?2004h> "]
[72.418301, "o", "    x0,x0w=best[1],(x0hi-x0lo)/(nx-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.418363, "o", "    g,gw=best[2],(ghi-glo)/(ng-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.418411, "o", "    for it in range(8):\r\n\u001b[?2004l\r"]
[72.418437, "o", "\u001b[?2004h> "]
[72.418468, "o", "        b=best\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.418499, "o", "        for i in range(21):\r\n"]
[72.418528, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[72.418553, "o", "            xt=x0+(i-10)*x0w/10\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.418582, "o", "> "]
[72.418627, "o", "            if not (x0lo<=xt<=x0hi): continue\r\n\u001b[?2004l\r"]
[72.418656, "o", "\u001b[?2004h> "]
[72.418684, "o", "            for j in range(21):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.418735, "o", "                gt=g+(j-10)*gw/10\r\n\u001b[?2004l\r"]
[72.418764, "o", "\u001b[?2004h> "]
[72.418807, "o", "                if not (glo<=gt<=ghi): continue\r\n\u001b[?2004l\r"]
[72.418844, "o", "\u001b[?2004h> "]
[72.418879, "o", "                r=best_linear(xs,ys,xt,gt)\r\n\u001b[?2004l\r"]
[72.418908, "o", "\u001b[?2004h> "]
[72.418943, "o", "                if r is None: continue\r\n\u001b[?2004l\r"]
[72.418971, "o", "\u001b[?2004h> "]
[72.419009, "o", "                sse,A,c=r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.419067, "o", "                if sse<b[0]: b=(sse,xt,gt,(A,c))\r\n\u001b[?2004l\r"]
[72.419096, "o", "\u001b[?2004h> "]
[72.419131, "o", "        best=b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.419168, "o", "        x0,x0w=best[1],x0w/10\r\n\u001b[?2004l\r"]
[72.419197, "o", "\u001b[?2004h> "]
[72.419225, "o", "        g,gw=best[2],gw/10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.419376, "o", "    print(name, 'refined best: sse=%.3f x0=%.9f gamma=%.9f A=%.9f c=%.9f' % (best[0],best[1],best[2],best[3][0],best[3][1]))\r\n\u001b[?2004l\r"]
[72.419406, "o", "\u001b[?2004h> "]
[72.419435, "o", "    return best\r\n\u001b[?2004l\r"]
[72.419466, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
