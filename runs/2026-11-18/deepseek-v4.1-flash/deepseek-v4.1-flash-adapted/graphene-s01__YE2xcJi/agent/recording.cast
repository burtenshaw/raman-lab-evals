[149.153042, "i", "python3 - <<'PY'\nimport importlib.util\nspec=importlib.util.spec_from_file_location('fp','/app/fit_peaks.py')\nfp=importlib.util.module_from_spec(spec)\nspec.loader.exec_module(fp)\nprint('\\nWindow stability checks:')\nfor name, windows in [\n    ('D', [(1250,1450),(1300,1400),(1320,1380),(1250,1400),(1300,1450)]),\n    ('G', [(1480,1670),(1530,1630),(1550,1610)]),\n    ('2D', [(2500,2850),(2600,2800),(2650,2750)]),\n]:\n    for lo,hi in windows:\n        p,cost,n=fp.fit_window(name,lo,hi)\n        print(f'{name} [{lo},{hi}] n={n} x0={p[\"x0\"]:.4f} gamma={p[\"gamma\"]:.4f} amp={p[\"amplitude\"]:.3f} off={p[\"offset\"]:.3f} sse={cost:.1f}')\nPY\n"]
