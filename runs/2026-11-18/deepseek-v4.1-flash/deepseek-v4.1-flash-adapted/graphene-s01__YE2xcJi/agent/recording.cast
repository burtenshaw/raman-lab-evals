[352.104262, "o", "> "]
[352.10435, "o", "    row=[0.0]*10\r\n\u001b[?2004l\r\u001b[?2004h>     for k in range(0,9,3):\r\n\u001b[?2004l\r"]
[352.104381, "o", "\u001b[?2004h"]
[352.104405, "o", "> "]
[352.10444, "o", "        A,g,x0=p[k],p[k+1],p[k+2]\r\n\u001b[?2004l\r"]
[352.104473, "o", "\u001b[?2004h"]
[352.104497, "o", "> "]
[352.104534, "o", "        dx=x-x0\r\n\u001b[?2004l\r"]
[352.104558, "o", "\u001b[?2004h> "]
[352.104587, "o", "        d=dx*dx+g*g\r\n\u001b[?2004l\r"]
[352.10462, "o", "\u001b[?2004h"]
[352.104643, "o", "> "]
[352.104681, "o", "        row[k]=g*g/d\r\n\u001b[?2004l\r"]
[352.104705, "o", "\u001b[?2004h> "]
[352.104747, "o", "        row[k+1]=2.0*A*g*dx*dx/(d*d)\r\n\u001b[?2004l\r"]
[352.104785, "o", "\u001b[?2004h> "]
[352.104835, "o", "        row[k+2]=2.0*A*g*g*dx/(d*d)\r\n\u001b[?2004l\r"]
[352.104857, "o", "\u001b[?2004h"]
[352.104905, "o", "> "]
[352.104942, "o", "    row[9]=1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.104971, "o", "    return row\r\n\u001b[?2004l\r"]
[352.104997, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[352.105033, "o", "> "]
[352.105058, "o", "def solve(A,b):\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.105094, "o", "> "]
[352.105124, "o", "    n=len(b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.105177, "o", "    M=[A[i][:]+[b[i]] for i in range(n)]\r\n\u001b[?2004l\r"]
[352.10521, "o", "\u001b[?2004h"]
[352.105247, "o", "> "]
[352.105272, "o", "    for col in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.105308, "o", "> "]
[352.105363, "o", "        piv=max(range(col,n), key=lambda i: abs(M[i][col]))\r\n\u001b[?2004l\r"]
[352.105391, "o", "\u001b[?2004h> "]
[352.10548, "o", "        if abs(M[piv][col])<1e-30: raise ValueError('singular')\r\n\u001b[?2004l\r"]
[352.105518, "o", "\u001b[?2004h"]
[352.105542, "o", "> "]
[352.105586, "o", "        M[col],M[piv]=M[piv],M[col]\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.10561, "o", "> "]
[352.105655, "o", "        pv=M[col][col]\r\n\u001b[?2004l\r"]
[352.105679, "o", "\u001b[?2004h> "]
[352.105731, "o", "        for j in range(col,n+1): M[col][j]/=pv\r\n\u001b[?2004l\r"]
[352.105778, "o", "\u001b[?2004h> "]
[352.105817, "o", "        for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.105839, "o", "> "]
[352.105889, "o", "            if i==col: continue\r\n\u001b[?2004l\r"]
[352.105921, "o", "\u001b[?2004h"]
[352.105958, "o", "> "]
[352.105996, "o", "            f=M[i][col]\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.10602, "o", ">             if f:\r\n\u001b[?2004l\r"]
[352.106057, "o", "\u001b[?2004h> "]
[352.106129, "o", "                for j in range(col,n+1): M[i][j]-=f*M[col][j]\r\n\u001b[?2004l\r"]
[352.10616, "o", "\u001b[?2004h"]
[352.106202, "o", "> "]
[352.106232, "o", "    return [M[i][n] for i in range(n)]\r\n\u001b[?2004l\r"]
[352.106269, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[352.106292, "o", "\u001b[?2004h> "]
[352.106366, "o", "cost=sum((y-model(x,p))**2 for x,y in zip(xs,ys))\r\n"]
[352.106389, "o", "\u001b[?2004l\r"]
[352.106422, "o", "\u001b[?2004h"]
[352.106452, "o", "> lam=1e-3"]
[352.106476, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.106512, "o", "> "]
[352.106549, "o", "for it in range(300):\r\n"]
[352.106571, "o", "\u001b[?2004l\r"]
[352.106585, "o", "\u001b[?2004h"]
[352.106616, "o", "> "]
[352.106681, "o", "    A=[[0.0]*10 for _ in range(10)]\r\n"]
[352.106706, "o", "\u001b[?2004l\r"]
[352.106742, "o", "\u001b[?2004h"]
[352.106766, "o", "> "]
[352.106805, "o", "    b=[0.0]*10"]
[352.106844, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.106891, "o", "    for x,y in zip(xs,ys):\r\n"]
[352.106929, "o", "\u001b[?2004l\r"]
[352.106967, "o", "\u001b[?2004h> "]
[352.107001, "o", "        row=jac(x,p)\r\n\u001b[?2004l\r"]
[352.107037, "o", "\u001b[?2004h"]
[352.107076, "o", "> "]
[352.10712, "o", "        rr=y-model(x,p)\r\n"]
[352.10716, "o", "\u001b[?2004l\r"]
[352.107199, "o", "\u001b[?2004h> "]
[352.107239, "o", "        for i in range(10):\r\n"]
[352.107276, "o", "\u001b[?2004l\r"]
[352.107315, "o", "\u001b[?2004h> "]
[352.107366, "o", "            b[i]+=row[i]*rr\r\n"]
[352.107404, "o", "\u001b[?2004l\r"]
[352.107442, "o", "\u001b[?2004h> "]
[352.107543, "o", "            for j in range(10): A[i][j]+=row[i]*row[j]\r\n"]
[352.10758, "o", "\u001b[?2004l\r"]
[352.107624, "o", "\u001b[?2004h> "]
[352.107696, "o", "    for i in range(10): A[i][i]*=(1.0+lam)\r\n"]
[352.107734, "o", "\u001b[?2004l\r"]
[352.107772, "o", "\u001b[?2004h> "]
[352.107792, "o", "    try:\r\n\u001b[?2004l\r"]
[352.107833, "o", "\u001b[?2004h> "]
[352.10789, "o", "        delta=solve(A,b)\r\n"]
[352.107941, "o", "\u001b[?2004l\r"]
[352.107985, "o", "\u001b[?2004h> "]
[352.108026, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[352.108066, "o", "\u001b[?2004h"]
[352.108104, "o", "> "]
[352.108144, "o", "        lam*=10\r\n\u001b[?2004l\r"]
[352.108182, "o", "\u001b[?2004h> "]
[352.108234, "o", "        if lam>1e14: break\r\n"]
[352.108271, "o", "\u001b[?2004l\r"]
[352.108386, "o", "\u001b[?2004h"]
[352.108425, "o", "> "]
[352.108468, "o", "        continue\r\n\u001b[?2004l\r"]
[352.108508, "o", "\u001b[?2004h> "]
[352.108553, "o", "    # step halving if unphysical\r\n\u001b[?2004l\r"]
[352.108598, "o", "\u001b[?2004h> "]
[352.108646, "o", "    scale=1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.108667, "o", "> "]
[352.108705, "o", "    while True:\r\n\u001b[?2004l\r"]
[352.108724, "o", "\u001b[?2004h> "]
[352.108819, "o", "        pn=[p[i]+scale*delta[i] for i in range(10)]\r\n\u001b[?2004l\r"]
[352.108858, "o", "\u001b[?2004h"]
[352.108888, "o", ">         ok=True\r\n\u001b[?2004l\r"]
[352.108921, "o", "\u001b[?2004h> "]
[352.108976, "o", "        for k in range(0,9,3):\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.109014, "o", "> "]
[352.109075, "o", "            if pn[k]<=0 or pn[k+1]<=0: ok=False\r\n\u001b[?2004l\r"]
[352.109113, "o", "\u001b[?2004h"]
[352.109152, "o", ">         if ok: break\r\n\u001b[?2004l\r"]
[352.109183, "o", "\u001b[?2004h> "]
[352.109221, "o", "        scale*=0.5\r\n\u001b[?2004l\r"]
[352.10926, "o", "\u001b[?2004h> "]
[352.1093, "o", "        if scale<1e-6:\r\n\u001b[?2004l\r"]
[352.10934, "o", "\u001b[?2004h> "]
[352.10938, "o", "            pn=None; break\r\n\u001b[?2004l\r"]
[352.109422, "o", "\u001b[?2004h> "]
[352.109462, "o", "    if pn is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.109494, "o", "        lam*=5; continue\r\n\u001b[?2004l\r"]
[352.109533, "o", "\u001b[?2004h> "]
[352.109625, "o", "    newcost=sum((y-model(x,pn))**2 for x,y in zip(xs,ys))\r\n\u001b[?2004l\r"]
[352.109663, "o", "\u001b[?2004h> "]
[352.109695, "o", "    if newcost<cost:\r\n\u001b[?2004l\r"]
[352.109733, "o", "\u001b[?2004h> "]
[352.109816, "o", "        p=pn; cost=newcost; lam=max(lam*0.3,1e-15)\r\n\u001b[?2004l\r"]
[352.109861, "o", "\u001b[?2004h"]
[352.109899, "o", "> "]
[352.109946, "o", "        if max(abs(d) for d in delta)<1e-11: break\r\n\u001b[?2004l\r"]
[352.109985, "o", "\u001b[?2004h> "]
[352.110024, "o", "    else:\r\n\u001b[?2004l\r"]
[352.110068, "o", "\u001b[?2004h>         lam*=5\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.110101, "o", "> "]
[352.110143, "o", "        if lam>1e14: break\r\n\u001b[?2004l\r"]
[352.11018, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[352.110209, "o", "\u001b[?2004h> "]
[352.110291, "o", "print('iterations done, global cost', cost)\r\n\u001b[?2004l\r"]
[352.110331, "o", "\u001b[?2004h> "]
[352.110405, "o", "for name,k in [('D',0),('G',3),('2D',6)]:\r\n\u001b[?2004l\r"]
[352.110444, "o", "\u001b[?2004h> "]
[352.110571, "o", "    print(f'{name} x0={p[k+2]:.9f} gamma={p[k+1]:.9f} amp={p[k]:.9f}')\r\n\u001b[?2004l\r"]
[352.110617, "o", "\u001b[?2004h> "]
[352.110656, "o", "print('offset',p[9])\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.110694, "o", "> "]
[352.110727, "o", "print('ID_IG',p[0]/p[3])\r\n\u001b[?2004l\r"]
[352.110749, "o", "\u001b[?2004h> "]
[352.110881, "o", "# Print local SSE using global parameters for each peak window\r\n\u001b[?2004l\r"]
[352.110921, "o", "\u001b[?2004h> "]
[352.111063, "o", "for name,lo,hi,k in [('D',1250,1450,0),('G',1480,1670,3),('2D',2500,2850,6)]:\r\n\u001b[?2004l\r"]
[352.111104, "o", "\u001b[?2004h> "]
[352.11123, "o", "    sse=sum((y-model(x,p))**2 for x,y in zip(xs,ys) if lo<=x<=hi)\r\n\u001b[?2004l\r"]
[352.111258, "o", "\u001b[?2004h> "]
[352.111326, "o", "    print(name,'window sse',sse)\r\n\u001b[?2004l\r"]
[352.111348, "o", "\u001b[?2004h> "]
[352.111392, "o", "PY\r\n\u001b[?2004l\r"]
[358.294427, "o", "iterations done, global cost 8265911.191539827\r\nD x0=1351.993443826 gamma=31.311951333 amp=345.439612247\r\n"]
[358.294545, "o", "G x0=1581.083688147 gamma=8.124024120 amp=6931.575627845\r\n2D x0=2694.884848826 gamma=26.727664949 amp=14090.705084312\r\noffset 1224.101441172506\r\nID_IG 0.04983565509393423\r\n"]
[358.295021, "o", "D window sse 898739.8003459921\r\n"]
