[57.362536, "i", "python3 - <<'PY'\nimport csv, json, math\nwith open('/app/results.json') as f:\n    R=json.load(f)\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    data=[(float(a),float(b)) for a,b in r]\nfor name,lo,hi in [('D',1320,1385),('G',1560,1605),('2D',2670,2720)]:\n    p=R[name]\n    print('\\n',name)\n    print('x, y, model, residual')\n    for x,y in data:\n        if lo<=x<=hi:\n            m=p['offset'] + p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)\n            print(f'{x:.2f}, {y:.2f}, {m:.2f}, {y-m:.2f}')\nPY\n"]
[57.362699, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[57.362738, "o", "\u001b[?2004h> "]
[57.362779, "o", "import csv, json, math\r\n\u001b[?2004l\r"]
[57.362795, "o", "\u001b[?2004h> "]
[57.362842, "o", "with open('/app/results.json') as f:\r\n\u001b[?2004l\r"]
[57.362869, "o", "\u001b[?2004h> "]
[57.362901, "o", "    R=json.load(f)\r\n\u001b[?2004l\r"]
[57.36293, "o", "\u001b[?2004h> "]
[57.362981, "o", "with open('/app/spectrum.csv') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.363014, "o", "> "]
[57.363046, "o", "    r=csv.reader(f); next(r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.363069, "o", "> "]
