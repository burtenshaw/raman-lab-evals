[112.091957, "i", "python3 - <<'PY'\nimport csv, json\nwith open('/app/results.json') as f: R=json.load(f)\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    data=[(float(a),float(b)) for a,b in r]\np=R['D']\nlast=-1e9\nprint('D region every ~5 cm:')\nfor x,y in data:\n    if 1250<=x<=1450 and x-last>=5:\n        m=p['offset']+p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)\n        print(f'{x:7.2f} y={y:8.2f} model={m:8.2f} resid={y-m:8.2f}')\n        last=x\nPY\n"]
