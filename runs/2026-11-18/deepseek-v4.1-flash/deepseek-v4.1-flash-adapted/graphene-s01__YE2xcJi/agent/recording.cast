[203.515481, "i", "python3 - <<'PY'\nimport csv, math\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    data=[(float(a),float(b)) for a,b in r]\n\ndef solve3(A,b):\n    M=[A[i][:]+[b[i]] for i in range(3)]\n    for col in range(3):\n        piv=max(range(col,3), key=lambda i: abs(M[i][col]))\n        if abs(M[piv][col])<1e-30: return None\n        M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for j in range(col,4): M[col][j]/=pv\n        for i in range(3):\n            if i==col: continue\n            f=M[i][col]\n            for j in range(col,4): M[i][j]-=f*M[col][j]\n    return [M[i][3] for i in range(3)]\n\ndef fitlin(xs,ys,x0,g):\n    xref=sum(xs)/len(xs)\n    S=[[0.0]*3 for _ in range(3)]; b=[0.0]*3\n    for x,y in zip(xs,ys):\n        v=[1.0,x-xref,g*g/((x-x0)**2+g*g)]\n        for i in range(3):\n            b[i]+=v[i]*y\n            for j in range(3): S[i][j]+=v[i]*v[j]\n    p=solve3(S,b)\n    if p is None: return None\n    c,m,A=p\n    sse=0.0\n    for x,y in zip(xs,ys):\n        v=[1.0,x-xref,g*g/((x-x0)**2+g*g)"]
[203.515618, "i", "]\n        pred=sum(p[i]*v[i] for i in range(3))\n        sse+=(y-pred)**2\n    return sse,c,m,A,xref\n\ndef run(lo,hi):\n    xs=[x for x,y in data if lo<=x<=hi]; ys=[y for x,y in data if lo<=x<=hi]\n    best=None\n    for i in range(201):\n        x0=1330+(1370-1330)*i/200\n        for j in range(201):\n            g=3+(50-3)*j/200\n            r=fitlin(xs,ys,x0,g)\n            if r and (best is None or r[0]<best[0]): best=(r[0],x0,g,r[1],r[2],r[3],r[4])\n    # refine\n    sse,x0,g,c,m,A,xref=best\n    for it in range(6):\n        dx=(1370-1330)/200/(10**(it)); dg=(50-3)/200/(10**(it))\n        b=best\n        for i in range(-10,11):\n            xt=x0+i*dx/10\n            if not 1330<=xt<=1370: continue\n            for j in range(-10,11):\n                gt=g+j*dg/10\n                if not 3<=gt<=50: continue\n                r=fitlin(xs,ys,xt,gt)\n                if r and r[0]<b[0]: b=(r[0],xt,gt,r[1],r[2],r[3],r[4])\n        best=b; sse,x0,g,c,m,A,xref=best\n    print(f'window [{lo},{hi}] x0={x0:.6f} gamma={g:.6f} A={A:.6f} c={c:"]
