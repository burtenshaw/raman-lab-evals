[352.102848, "i", "python3 - <<'PY'\nimport csv, math\n\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    xs=[]; ys=[]\n    for a,b in r:\n        xs.append(float(a)); ys.append(float(b))\nN=len(xs)\n\n# params: AD,gD,xD, AG,gG,xG, A2,g2,x2, c\np=[347.728468,19.501280,1352.458389,\n   6928.023480,8.016368,1581.082231,\n   14097.959839,26.945255,2694.885195,\n   1200.0]\n\ndef model(x,p):\n    s=p[9]\n    for k in range(0,9,3):\n        A,g,x0=p[k],p[k+1],p[k+2]\n        s += A*g*g/((x-x0)*(x-x0)+g*g)\n    return s\n\ndef jac(x,p):\n    row=[0.0]*10\n    for k in range(0,9,3):\n        A,g,x0=p[k],p[k+1],p[k+2]\n        dx=x-x0\n        d=dx*dx+g*g\n        row[k]=g*g/d\n        row[k+1]=2.0*A*g*dx*dx/(d*d)\n        row[k+2]=2.0*A*g*g*dx/(d*d)\n    row[9]=1.0\n    return row\n\ndef solve(A,b):\n    n=len(b)\n    M=[A[i][:]+[b[i]] for i in range(n)]\n    for col in range(n):\n        piv=max(range(col,n), key=lambda i: abs(M[i][col]))\n        if abs(M[piv][col])<1e-30: raise ValueError('singular')\n        M[col],M[piv]=M[piv],M[col]\n        pv=M"]
[352.103002, "i", "[col][col]\n        for j in range(col,n+1): M[col][j]/=pv\n        for i in range(n):\n            if i==col: continue\n            f=M[i][col]\n            if f:\n                for j in range(col,n+1): M[i][j]-=f*M[col][j]\n    return [M[i][n] for i in range(n)]\n\ncost=sum((y-model(x,p))**2 for x,y in zip(xs,ys))\nlam=1e-3\nfor it in range(300):\n    A=[[0.0]*10 for _ in range(10)]\n    b=[0.0]*10\n    for x,y in zip(xs,ys):\n        row=jac(x,p)\n        rr=y-model(x,p)\n        for i in range(10):\n            b[i]+=row[i]*rr\n            for j in range(10): A[i][j]+=row[i]*row[j]\n    for i in range(10): A[i][i]*=(1.0+lam)\n    try:\n        delta=solve(A,b)\n    except Exception:\n        lam*=10\n        if lam>1e14: break\n        continue\n    # step halving if unphysical\n    scale=1.0\n    while True:\n        pn=[p[i]+scale*delta[i] for i in range(10)]\n        ok=True\n        for k in range(0,9,3):\n            if pn[k]<=0 or pn[k+1]<=0: ok=False\n        if ok: break\n        scale*=0.5\n        if scale<1e-6:\n            pn=N"]
[352.103087, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv, math\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.103126, "i", "one; break\n    if pn is None:\n        lam*=5; continue\n    newcost=sum((y-model(x,pn))**2 for x,y in zip(xs,ys))\n    if newcost<cost:\n        p=pn; cost=newcost; lam=max(lam*0.3,1e-15)\n        if max(abs(d) for d in delta)<1e-11: break\n    else:\n        lam*=5\n        if lam>1e14: break\n\nprint('iterations done, global cost', cost)\nfor name,k in [('D',0),('G',3),('2D',6)]:\n    print(f'{name} x0={p[k+2]:.9f} gamma={p[k+1]:.9f} amp={p[k]:.9f}')\nprint('offset',p[9])\nprint('ID_IG',p[0]/p[3])\n# Print local SSE using global parameters for each peak window\nfor name,lo,hi,k in [('D',1250,1450,0),('G',1480,1670,3),('2D',2500,2850,6)]:\n    sse=sum((y-model(x,p))**2 for x,y in zip(xs,ys) if lo<=x<=hi)\n    print(name,'window sse',sse)\nPY\n"]
