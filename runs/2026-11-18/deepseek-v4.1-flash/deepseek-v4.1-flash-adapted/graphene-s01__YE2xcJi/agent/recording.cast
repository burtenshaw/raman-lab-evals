[57.363392, "o", "    print('x, y, model, residual')\r\n\u001b[?2004l\r"]
[57.363418, "o", "\u001b[?2004h> "]
[57.363454, "o", "    for x,y in data:\r\n\u001b[?2004l\r"]
[57.363495, "o", "\u001b[?2004h> "]
