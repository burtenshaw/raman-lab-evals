[266.120432, "i", "python3 - <<'PY'\nimport csv\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    data=[(float(a),float(b)) for a,b in r]\n\ndef solve3(A,b):\n    M=[A[i][:]+[b[i]] for i in range(3)]\n    for col in range(3):\n        piv=max(range(col,3), key=lambda i: abs(M[i][col]))\n        if abs(M[piv][col])<1e-30: return None\n        M[col],M[piv]=M[piv],M[col]\n        pv=M[col][col]\n        for j in range(col,4): M[col][j]/=pv\n        for i in range(3):\n            if i==col: continue\n            f=M[i][col]\n            for j in range(col,4): M[i][j]-=f*M[col][j]\n    return [M[i][3] for i in range(3)]\n\ndef fitlin(xs,ys,x0,g):\n    xref=sum(xs)/len(xs)\n    S=[[0.0]*3 for _ in range(3)]; b=[0.0]*3\n    for x,y in zip(xs,ys):\n        v=(1.0,x-xref,g*g/((x-x0)**2+g*g))\n        for i in range(3):\n            b[i]+=v[i]*y\n            for j in range(3): S[i][j]+=v[i]*v[j]\n    p=solve3(S,b)\n    if p is None: return None\n    c,m,A=p; sse=0.0\n    for x,y in zip(xs,ys):\n        v=(1.0,x-xref,g*g/((x-x0)**2+g*g))\n       "]
[266.120558, "i", " sse+=(y-sum(p[i]*v[i] for i in range(3)))**2\n    return sse,A,c,m\n\ndef run(lo,hi):\n    xs=[x for x,y in data if lo<=x<=hi]; ys=[y for x,y in data if lo<=x<=hi]\n    best=None\n    for i in range(61):\n        x0=1335+(1370-1335)*i/60\n        for j in range(61):\n            g=5+(40-5)*j/60\n            r=fitlin(xs,ys,x0,g)\n            if r and (best is None or r[0]<best[0]): best=(r[0],x0,g,r[1],r[2],r[3])\n    for it in range(5):\n        sse,x0,g,A,c,m=best; b=best\n        dx=(1370-1335)/60/(10**it); dg=(40-5)/60/(10**it)\n        for i in range(-5,6):\n            xt=x0+i*dx/5\n            if not 1335<=xt<=1370: continue\n            for j in range(-5,6):\n                gt=g+j*dg/5\n                if not 5<=gt<=40: continue\n                r=fitlin(xs,ys,xt,gt)\n                if r and r[0]<b[0]: b=(r[0],xt,gt,r[1],r[2],r[3])\n        best=b\n    sse,x0,g,A,c,m=best\n    print(f'D linear-baseline diagnostic [{lo},{hi}] x0={x0:.6f} gamma={g:.6f} amp={A:.6f} offset={c:.6f} slope={m:.6f} sse={sse:.2f}')\nrun(1250,1450)\nru"]
