[57.312943, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1352.4583891997038,\r\n    \"gamma\": 19.501280125811213,\r\n    \"amplitude\": 347.7284684271517,\r\n    \"offset\": 1282.018974939232\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1581.0822307383523,\r\n    \"gamma\": 8.016367836234938,\r\n    \"amplitude\": 6928.023480085522,\r\n    \"offset\": 1264.3865783453325\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2694.8851950004705,\r\n    \"gamma\": 26.94525538200539,\r\n    \"amplitude\": 14097.959839374229,\r\n    \"offset\": 1190.7064558989125\r\n  },\r\n  \"ID_IG\": 0.05019158341866058\r\n}"]
