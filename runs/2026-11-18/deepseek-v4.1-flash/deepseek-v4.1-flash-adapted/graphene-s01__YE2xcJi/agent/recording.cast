[15.612703, "i", "python3 - <<'PY'\nimport csv, math\nx=[]; y=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    next(r)\n    for row in r:\n        x.append(float(row[0])); y.append(float(row[1]))\nprint('n', len(x), 'range', x[0], x[-1])\nfor name, lo, hi in [('D',1300,1400),('G',1530,1630),('2D',2640,2740)]:\n    inds=[i for i,v in enumerate(x) if lo<=v<=hi]\n    imax=max(inds, key=lambda i:y[i])\n    print(name, 'max', x[imax], y[imax], 'min/max y', min(y[i] for i in inds), max(y[i] for i in inds))\n    step=max(1,len(inds)//10)\n    print([(round(x[i],1),round(y[i],1)) for i in inds[::step]])\nPY\n"]
