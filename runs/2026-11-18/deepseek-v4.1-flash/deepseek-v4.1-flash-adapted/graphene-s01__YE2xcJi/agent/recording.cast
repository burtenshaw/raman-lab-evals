[164.60348, "i", "python3 - <<'PY'\nimport csv\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f); next(r)\n    data=[(float(a),float(b)) for a,b in r]\nfor center in [1250,1300,1350,1400,1450,1480,1530,1580,1630,1670,2500,2600,2650,2695,2750,2800,2850,2900,3000]:\n    best=min(data, key=lambda xy: abs(xy[0]-center))\n    print(f'{best[0]:8.2f} {best[1]:10.2f}')\nPY\n"]
