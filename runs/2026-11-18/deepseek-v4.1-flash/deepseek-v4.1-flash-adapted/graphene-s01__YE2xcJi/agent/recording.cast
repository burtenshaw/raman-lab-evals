[57.363126, "o", "\u001b[?2004h> "]
[57.363219, "o", "for name,lo,hi in [('D',1320,1385),('G',1560,1605),('2D',2670,2720)]:\r\n\u001b[?2004l\r"]
[57.363251, "o", "\u001b[?2004h> "]
