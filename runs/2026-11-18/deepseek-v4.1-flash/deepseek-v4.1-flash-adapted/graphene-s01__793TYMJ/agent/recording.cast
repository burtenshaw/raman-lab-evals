[7.779647, "i", "python3 - <<'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nx = pd.read_csv('/app/spectrum.csv')\nprint(x.columns.tolist())\nprint('rows', len(x), 'x range', x.iloc[:,0].min(), x.iloc[:,0].max())\nfor name, lo, hi in [('D',1250,1450),('G',1500,1680),('2D',2550,2800)]:\n    m = (x.iloc[:,0] >= lo) & (x.iloc[:,0] <= hi)\n    sub = x[m]\n    idx = sub.iloc[:,1].idxmax()\n    print(name, 'max at', sub.loc[idx, sub.columns[0]], sub.loc[idx, sub.columns[1]])\nPY\n"]
