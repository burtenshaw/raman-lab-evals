[72.571674, "o", "\u001b[?2004h> "]
[72.571761, "o", "    imax = max(range(n), key=lambda i: yd[i])\r\n\u001b[?2004l\r"]
[72.571795, "o", "\u001b[?2004h> "]
[72.571837, "o", "    x0_init = xd[imax]\r\n\u001b[?2004l\r"]
[72.571872, "o", "\u001b[?2004h> "]
[72.571918, "o", "    edge = max(1, n // 10)\r\n\u001b[?2004l\r"]
[72.571955, "o", "\u001b[?2004h> "]
[72.57202, "o", "    left_base = sum(yd[:edge]) / edge\r\n\u001b[?2004l\r"]
[72.572049, "o", "\u001b[?2004h> "]
[72.572127, "o", "    right_base = sum(yd[-edge:]) / edge\r\n\u001b[?2004l\r"]
[72.572164, "o", "\u001b[?2004h> "]
[72.572261, "o", "    b0 = min(left_base, right_base)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.572312, "o", "    A0 = max(yd[imax] - b0, 1.0)\r\n\u001b[?2004l\r"]
[72.572341, "o", "\u001b[?2004h> "]
[72.572389, "o", "    half = b0 + 0.5 * A0\r\n\u001b[?2004l\r"]
[72.572419, "o", "\u001b[?2004h> "]
[72.57246, "o", "    left = x0_init\r\n\u001b[?2004l\r"]
[72.572493, "o", "\u001b[?2004h> "]
[72.572523, "o", "    right = x0_init\r\n\u001b[?2004l\r"]
[72.572562, "o", "\u001b[?2004h> "]
[72.572618, "o", "    for i in range(imax, -1, -1):\r\n\u001b[?2004l\r"]
[72.572644, "o", "\u001b[?2004h> "]
[72.572697, "o", "        if yd[i] <= half:\r\n\u001b[?2004l\r"]
[72.57273, "o", "\u001b[?2004h> "]
[72.572774, "o", "            left = xd[i]\r\n\u001b[?2004l\r"]
[72.572814, "o", "\u001b[?2004h> "]
[72.572852, "o", "            break\r\n\u001b[?2004l\r"]
[72.572892, "o", "\u001b[?2004h> "]
[72.572923, "o", "    for i in range(imax, n):\r\n\u001b[?2004l\r"]
[72.572953, "o", "\u001b[?2004h> "]
[72.573001, "o", "        if yd[i] <= half:\r\n\u001b[?2004l\r"]
[72.573031, "o", "\u001b[?2004h> "]
[72.57308, "o", "            right = xd[i]\r\n\u001b[?2004l\r"]
[72.573111, "o", "\u001b[?2004h> "]
[72.573143, "o", "            break\r\n\u001b[?2004l\r"]
[72.573176, "o", "\u001b[?2004h> "]
[72.573256, "o", "    gamma0 = max((right - left) / 2.0, 1.0)\r\n\u001b[?2004l\r"]
[72.573288, "o", "\u001b[?2004h> "]
[72.573318, "o", "    xr = x0_init\r\n\u001b[?2004l\r"]
[72.573349, "o", "\u001b[?2004h> "]
[72.573443, "o", "    p = [0.0, math.log(gamma0), math.log(A0), b0]\r\n\u001b[?2004l\r"]
[72.573462, "o", "\u001b[?2004h> \r\n"]
[72.573502, "o", "\u001b[?2004l\r"]
[72.573532, "o", "\u001b[?2004h> "]
[72.573563, "o", "    def model(x, params):\r\n\u001b[?2004l\r"]
[72.573606, "o", "\u001b[?2004h> "]
[72.573641, "o", "        dx = x - xr - params[0]\r\n\u001b[?2004l\r"]
[72.573671, "o", "\u001b[?2004h> "]
[72.573732, "o", "        g = math.exp(params[1])\r\n\u001b[?2004l\r"]
[72.573774, "o", "\u001b[?2004h> "]
[72.573833, "o", "        A = math.exp(params[2])\r\n\u001b[?2004l\r"]
[72.573902, "o", "\u001b[?2004h> "]
[72.57397, "o", "        return A * g * g / (dx * dx + g * g) + params[3]\r\n\u001b[?2004l\r"]
[72.57401, "o", "\u001b[?2004h> "]
[72.574039, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.574066, "o", "    cost = 0.0\r\n\u001b[?2004l\r"]
[72.574097, "o", "\u001b[?2004h> "]
[72.574146, "o", "    for x, y in zip(xd, yd):\r\n\u001b[?2004l\r"]
[72.574176, "o", "\u001b[?2004h> "]
[72.574228, "o", "        r = y - model(x, p)\r\n\u001b[?2004l\r"]
[72.574269, "o", "\u001b[?2004h> "]
[72.574311, "o", "        cost += r * r\r\n\u001b[?2004l\r"]
[72.574353, "o", "\u001b[?2004h> "]
[72.574396, "o", "    lam = 1e-3\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.574435, "o", "> "]
[72.574467, "o", "    for it in range(400):\r\n\u001b[?2004l\r"]
[72.57451, "o", "\u001b[?2004h> "]
[72.574561, "o", "        JTJ = [[0.0] * 4 for _ in range(4)]\r\n\u001b[?2004l\r"]
[72.574596, "o", "\u001b[?2004h> "]
[72.574635, "o", "        JTr = [0.0] * 4\r\n\u001b[?2004l\r"]
[72.57466, "o", "\u001b[?2004h> "]
[72.574725, "o", "        for x, y in zip(xd, yd):\r\n\u001b[?2004l\r"]
[72.574758, "o", "\u001b[?2004h> "]
[72.574813, "o", "            dx = x - xr - p[0]\r\n\u001b[?2004l\r"]
[72.574849, "o", "\u001b[?2004h> "]
[72.574898, "o", "            g = math.exp(p[1])\r\n\u001b[?2004l\r"]
[72.57495, "o", "\u001b[?2004h> "]
[72.574993, "o", "            A = math.exp(p[2])\r\n\u001b[?2004l\r"]
[72.575041, "o", "\u001b[?2004h> "]
[72.575085, "o", "            den = dx * dx + g * g\r\n\u001b[?2004l\r"]
[72.575156, "o", "\u001b[?2004h> "]
[72.575187, "o", "            f = A * g * g / den + p[3]\r\n\u001b[?2004l\r"]
[72.575224, "o", "\u001b[?2004h> "]
[72.575258, "o", "            r = y - f\r\n\u001b[?2004l\r"]
[72.575295, "o", "\u001b[?2004h> "]
[72.575392, "o", "            d0 = 2.0 * A * g * g * dx / (den * den)\r\n\u001b[?2004l\r"]
[72.575429, "o", "\u001b[?2004h> "]
[72.575528, "o", "            d1 = 2.0 * A * g * g * dx * dx / (den * den)\r\n\u001b[?2004l\r"]
[72.575571, "o", "\u001b[?2004h> "]
[72.57562, "o", "            d2 = A * g * g / den\r\n\u001b[?2004l\r"]
[72.575668, "o", "\u001b[?2004h> "]
[72.575722, "o", "            d3 = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.575828, "o", "            ders = (d0, d1, d2, d3)\r\n\u001b[?2004l\r"]
[72.575863, "o", "\u001b[?2004h> "]
[72.575916, "o", "            for j in range(4):\r\n\u001b[?2004l\r"]
[72.575949, "o", "\u001b[?2004h> "]
[72.576, "o", "                dj = ders[j]\r\n\u001b[?2004l\r"]
[72.576033, "o", "\u001b[?2004h> "]
[72.576094, "o", "                JTr[j] += dj * r\r\n\u001b[?2004l\r"]
[72.576117, "o", "\u001b[?2004h> "]
[72.57619, "o", "                for k in range(4):\r\n\u001b[?2004l\r"]
[72.576223, "o", "\u001b[?2004h> "]
[72.576308, "o", "                    JTJ[j][k] += dj * ders[k]\r\n\u001b[?2004l\r"]
[72.576342, "o", "\u001b[?2004h> "]
[72.576418, "o", "        M = [JTJ[i][:] for i in range(4)]\r\n\u001b[?2004l\r"]
[72.576451, "o", "\u001b[?2004h> "]
[72.576497, "o", "        for i in range(4):\r\n\u001b[?2004l\r"]
[72.576525, "o", "\u001b[?2004h> "]
[72.576623, "o", "            M[i][i] += lam * max(JTJ[i][i], 1e-30)\r\n\u001b[?2004l\r"]
[72.576656, "o", "\u001b[?2004h> "]
[72.576712, "o", "        delta = solve4(M, JTr)\r\n\u001b[?2004l\r"]
[72.576744, "o", "\u001b[?2004h> "]
[72.576791, "o", "        if delta is None:\r\n\u001b[?2004l\r"]
[72.576822, "o", "\u001b[?2004h> "]
[72.576864, "o", "            break\r\n\u001b[?2004l\r"]
[72.576887, "o", "\u001b[?2004h> "]
[72.576984, "o", "        newp = [p[i] + delta[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[72.577007, "o", "\u001b[?2004h> "]
[72.577055, "o", "        newcost = 0.0\r\n\u001b[?2004l\r"]
[72.577087, "o", "\u001b[?2004h> "]
[72.577147, "o", "        for x, y in zip(xd, yd):\r\n\u001b[?2004l\r"]
[72.57718, "o", "\u001b[?2004h> "]
[72.577243, "o", "            r = y - model(x, newp)\r\n\u001b[?2004l\r"]
[72.577276, "o", "\u001b[?2004h> "]
[72.57735, "o", "            newcost += r * r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.577411, "o", "        if newcost < cost:\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.577446, "o", "> "]
[72.577511, "o", "            improvement = cost - newcost\r\n\u001b[?2004l\r"]
[72.577548, "o", "\u001b[?2004h> "]
[72.577591, "o", "            p = newp\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.577624, "o", "> "]
[72.577665, "o", "            cost = newcost\r\n\u001b[?2004l\r"]
[72.577686, "o", "\u001b[?2004h> "]
[72.577771, "o", "            lam = max(lam * 0.3, 1e-15)\r\n\u001b[?2004l\r"]
[72.577819, "o", "\u001b[?2004h> "]
[72.577908, "o", "            if improvement < 1e-10 * (1.0 + cost):\r\n\u001b[?2004l\r"]
[72.577931, "o", "\u001b[?2004h> "]
[72.577979, "o", "                break\r\n\u001b[?2004l\r"]
[72.57801, "o", "\u001b[?2004h> "]
[72.578046, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.578062, "o", "> "]
[72.578139, "o", "            lam *= 10.0\r\n\u001b[?2004l\r"]
[72.578177, "o", "\u001b[?2004h> "]
[72.578192, "o", "            if lam > 1e12:\r\n\u001b[?2004l\r"]
[72.578203, "o", "\u001b[?2004h"]
[72.578268, "o", ">                 break\r\n\u001b[?2004l\r"]
[72.578307, "o", "\u001b[?2004h> "]
[72.578322, "o", "    return {\r\n\u001b[?2004l\r"]
[72.578353, "o", "\u001b[?2004h> "]
[72.578422, "o", "        'x0': xr + p[0],\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.578458, "o", "> "]
[72.578543, "o", "        'gamma': math.exp(p[1]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.578596, "o", "        'amplitude': math.exp(p[2]),\r\n\u001b[?2004l\r"]
[72.578635, "o", "\u001b[?2004h> "]
[72.578671, "o", "        'offset': p[3],\r\n\u001b[?2004l\r"]
[72.578709, "o", "\u001b[?2004h> "]
[72.578749, "o", "    }\r\n\u001b[?2004l\r"]
[72.578791, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.578833, "o", "def main():\r\n\u001b[?2004l\r"]
[72.578879, "o", "\u001b[?2004h> "]
[72.578922, "o", "    xs, ys = load_spectrum('/app/spectrum.csv')\r\n\u001b[?2004l\r"]
[72.57896, "o", "\u001b[?2004h> "]
[72.578998, "o", "    windows = {\r\n\u001b[?2004l\r"]
[72.579037, "o", "\u001b[?2004h> "]
[72.579071, "o", "        'D': (1230.0, 1460.0),\r\n\u001b[?2004l\r"]
[72.579098, "o", "\u001b[?2004h> "]
[72.579158, "o", "        'G': (1480.0, 1680.0),\r\n\u001b[?2004l\r"]
[72.5792, "o", "\u001b[?2004h> "]
[72.579248, "o", "        '2D': (2540.0, 2820.0),\r\n\u001b[?2004l\r"]
[72.579288, "o", "\u001b[?2004h> "]
[72.57933, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.57937, "o", ">     res = {}\r\n\u001b[?2004l\r"]
[72.579414, "o", "\u001b[?2004h> "]
[72.579458, "o", "    for name, (lo, hi) in windows.items():\r\n\u001b[?2004l\r"]
[72.579496, "o", "\u001b[?2004h> "]
[72.579576, "o", "        res[name] = fit_peak(xs, ys, lo, hi)\r\n\u001b[?2004l\r"]
[72.579629, "o", "\u001b[?2004h> "]
[72.579669, "o", "        print(name, res[name])\r\n\u001b[?2004l\r"]
[72.579703, "o", "\u001b[?2004h> "]
[72.579831, "o", "    res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\r\n\u001b[?2004l\r"]
[72.579881, "o", "\u001b[?2004h> "]
[72.579917, "o", "    print('ID_IG', res['ID_IG'])\r\n\u001b[?2004l\r"]
[72.579955, "o", "\u001b[?2004h> "]
[72.580034, "o", "    with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[72.580075, "o", "\u001b[?2004h> "]
[72.580133, "o", "        json.dump(res, f, indent=2)\r\n\u001b[?2004l\r"]
[72.580172, "o", "\u001b[?2004h> "]
[72.580209, "o", "        f.write(chr(10))\r\n\u001b[?2004l\r"]
[72.580254, "o", "\u001b[?2004h> \r\n"]
[72.580292, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[72.580323, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[72.580358, "o", "\u001b[?2004h> "]
[72.580402, "o", "    main()\r\n\u001b[?2004l\r"]
[72.580442, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[72.581984, "o", "\u001b[?2004hroot@j-openenv-6afd8c39e5cad0e4dc3e6ce8-ih3ih1sm-117db-w2kw6:/app# "]
[72.582077, "o", "python3 /app/fit_spectrum.py\r\n\u001b[?2004l\r"]
[72.62552, "o", "D {'x0': 1352.4741830479234, 'gamma': 19.272585333541354, 'amplitude': 346.39134036330347, 'offset': 1284.0404484174114}\r\n"]
[72.629734, "o", "G {'x0': 1581.082190555254, 'gamma': 8.021061581499781, 'amplitude': 6928.499158547418, 'offset': 1263.016173016676}\r\n"]
[72.635424, "o", "2D {'x0': 2694.8857241558776, 'gamma': 26.9534857267855, 'amplitude': 14098.68104048322, 'offset': 1189.088367095033}\r\nID_IG 0.04999514792983326\r\n"]
[72.640007, "o", "\u001b[?2004hroot@j-openenv-6afd8c39e5cad0e4dc3e6ce8-ih3ih1sm-117db-w2kw6:/app# "]
[82.00782, "i", "cat /app/results.json\n"]
[82.007998, "o", "cat /app/results.json\r\n\u001b[?2004l\r"]
[82.009227, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1352.4741830479234,\r\n    \"gamma\": 19.272585333541354,\r\n    \"amplitude\": 346.39134036330347,\r\n    \"offset\": 1284.0404484174114\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1581.082190555254,\r\n    \"gamma\": 8.021061581499781,\r\n    \"amplitude\": 6928.499158547418,\r\n    \"offset\": 1263.016173016676\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2694.8857241558776,\r\n    \"gamma\": 26.9534857267855,\r\n    \"amplitude\": 14098.68104048322,\r\n    \"offset\": 1189.088367095033\r\n  },\r\n  \"ID_IG\": 0.04999514792983326\r\n}\r\n"]
[82.009441, "o", "\u001b[?2004hroot@j-openenv-6afd8c39e5cad0e4dc3e6ce8-ih3ih1sm-117db-w2kw6:/app# "]
[82.109327, "i", "python3 - <<'PY'\nimport csv, json, math\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    for row in csv.DictReader(f):\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nwith open('/app/results.json') as f:\n    r=json.load(f)\nwindows={'D':(1230,1460),'G':(1480,1680),'2D':(2540,2820)}\nfor name,(lo,hi) in windows.items():\n    p=r[name]\n    def model(x):\n        return p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)+p['offset']\n    sub=[(x,y) for x,y in zip(xs,ys) if lo<=x<=hi]\n    obs_max=max(y for x,y in sub)\n    fit_max=model(p['x0'])\n    rmse=(sum((y-model(x))**2 for x,y in sub)/len(sub))**0.5\n    print(name, 'obs_max', round(obs_max,3), 'fit_at_x0', round(fit_max,3), 'rmse', round(rmse,3))\nprint('ID_IG', r['ID_IG'])\nPY\n"]
[82.109458, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[82.109498, "o", "\u001b[?2004h"]
[82.109535, "o", "> "]
[82.109561, "o", "import csv, json, math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.109584, "o", "xs=[]; ys=[]\r\n\u001b[?2004l\r"]
[82.109613, "o", "\u001b[?2004h> "]
[82.109649, "o", "with open('/app/spectrum.csv') as f:\r\n\u001b[?2004l\r"]
[82.109676, "o", "\u001b[?2004h> "]
[82.10973, "o", "    for row in csv.DictReader(f):\r\n\u001b[?2004l\r"]
[82.109762, "o", "\u001b[?2004h> "]
[82.109833, "o", "        xs.append(float(row['raman_shift_cm-1']))\r\n\u001b[?2004l\r"]
[82.109865, "o", "\u001b[?2004h"]
[82.109897, "o", "> "]
[82.109937, "o", "        ys.append(float(row['intensity']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.109986, "o", "with open('/app/results.json') as f:\r\n\u001b[?2004l\r"]
[82.109996, "o", "\u001b[?2004h"]
[82.110038, "o", "> "]
[82.110069, "o", "    r=json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.110162, "o", "windows={'D':(1230,1460),'G':(1480,1680),'2D':(2540,2820)}\r\n\u001b[?2004l\r"]
[82.110187, "o", "\u001b[?2004h> "]
[82.11023, "o", "for name,(lo,hi) in windows.items():\r\n\u001b[?2004l\r"]
[82.110255, "o", "\u001b[?2004h>     p=r[name]\r\n\u001b[?2004l\r"]
[82.11028, "o", "\u001b[?2004h> "]
[82.110306, "o", "    def model(x):\r\n\u001b[?2004l\r"]
[82.110318, "o", "\u001b[?2004h> "]
[82.110443, "o", "        return p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)+p['offset']\r\n\u001b[?2004l\r"]
[82.110486, "o", "\u001b[?2004h> "]
[82.110537, "o", "    sub=[(x,y) for x,y in zip(xs,ys) if lo<=x<=hi]\r\n\u001b[?2004l\r"]
[82.110571, "o", "\u001b[?2004h> "]
[82.110613, "o", "    obs_max=max(y for x,y in sub)\r\n\u001b[?2004l\r"]
[82.110642, "o", "\u001b[?2004h> "]
