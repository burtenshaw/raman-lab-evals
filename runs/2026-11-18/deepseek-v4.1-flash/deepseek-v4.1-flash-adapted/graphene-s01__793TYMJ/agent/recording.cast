[115.295844, "i", "python3 - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom fit_spectrum import load_spectrum, fit_peak\nimport math\nxs, ys = load_spectrum('/app/spectrum.csv')\nwindows = {\n 'D': [(1250,1450),(1280,1420),(1300,1400),(1320,1380),(1230,1460)],\n 'G': [(1500,1660),(1520,1640),(1540,1620),(1550,1610),(1480,1680)],\n '2D':[(2550,2840),(2600,2800),(2650,2740),(2500,2900),(2540,2820)],\n}\nfor peak, wins in windows.items():\n    print('---', peak)\n    for lo,hi in wins:\n        p=fit_peak(xs,ys,lo,hi)\n        # compute rmse for this window\n        data=[(x,y) for x,y in zip(xs,ys) if lo<=x<=hi]\n        rmse=(sum((y-(p['amplitude']*p['gamma']**2/((x-p['x0'])**2+p['gamma']**2)+p['offset']))**2 for x,y in data)/len(data))**0.5\n        print(f'win ({lo},{hi}) x0={p[\"x0\"]:.4f} gamma={p[\"gamma\"]:.4f} amp={p[\"amplitude\"]:.3f} off={p[\"offset\"]:.3f} rmse={rmse:.3f}')\nPY\n"]
