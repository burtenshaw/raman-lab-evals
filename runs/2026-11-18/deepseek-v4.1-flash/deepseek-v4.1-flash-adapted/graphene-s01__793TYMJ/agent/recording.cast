[93.351827, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    for row in csv.DictReader(f):\n        x=float(row['raman_shift_cm-1']); y=float(row['intensity'])\n        if 1335 <= x <= 1370:\n            xs.append(x); ys.append(y)\nfor x,y in zip(xs,ys):\n    print(f'{x:8.3f} {y:10.3f}')\nPY\n"]
