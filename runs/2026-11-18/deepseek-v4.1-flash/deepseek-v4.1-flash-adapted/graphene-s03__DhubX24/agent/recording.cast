[10.876896, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\nprint('n', len(x), 'range', x[0], x[-1])\nfor lo,hi in [(1200,1500),(1450,1700),(2500,2850)]:\n    inds=[i for i,xx in enumerate(x) if lo<=xx<=hi]\n    imax=max(inds, key=lambda i:y[i])\n    imin=min(inds, key=lambda i:y[i])\n    print((lo,hi), 'max', x[imax], y[imax], 'min', x[imin], y[imin])\nPY\n"]
