[65.019375, "o", "\u001b[?2004h> "]
[65.019525, "o", "            xc = [cen[j] + 0.5 * (sim[-1][j] - cen[j]) for j in range(n)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.019589, "o", "            fc = fun(xc)\r\n\u001b[?2004l\r"]
[65.019763, "o", "\u001b[?2004h>             if fc < fv[-1]:\r\n\u001b[?2004l\r\u001b[?2004h>                 sim[-1] = xc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.019823, "o", "                fv[-1] = fc\r\n\u001b[?2004l\r"]
[65.019838, "o", "\u001b[?2004h> "]
[65.019932, "o", "            else:\r\n\u001b[?2004l\r"]
[65.019991, "o", "\u001b[?2004h>                 for i in range(1, n + 1):\r\n\u001b[?2004l\r"]
[65.02001, "o", "\u001b[?2004h> "]
[65.020131, "o", "                    sim[i] = [(sim[i][j] + sim[0][j]) * 0.5 for j in range(n)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.020212, "o", "                    fv[i] = fun(sim[i])\r\n\u001b[?2004l\r"]
[65.020297, "o", "\u001b[?2004h> "]
[65.020345, "o", "    best = min(range(n + 1), key=lambda i: fv[i])\r\n"]
[65.020406, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.020485, "o", "    return sim[best], fv[best], it\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[65.020681, "o", "\u001b[?2004h> def fit_peak(x, y, xlo, xhi):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.02071, "o", "    pairs = [(xi, yi) for xi, yi in zip(x, y) if xlo <= xi <= xhi]\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.020722, "o", "> "]
[65.020883, "o", "    xw = [p[0] for p in pairs]\r\n\u001b[?2004l\r\u001b[?2004h>     yw = [p[1] for p in pairs]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.021024, "o", "    center = xw[max(range(len(yw)), key=lambda i: yw[i])]\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.021163, "o", "> "]
[65.021214, "o", "    gammas = [4, 6, 8, 10, 12, 15, 18, 22, 26, 32, 40, 50, 65, 80, 100, 130]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.021248, "o", "    best = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.021343, "o", "    for x0 in [center + d for d in range(-25, 26)]:\r\n\u001b[?2004l\r"]
[65.021359, "o", "\u001b[?2004h> "]
[65.021467, "o", "        for gamma in gammas:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.021627, "o", "            res = linear_fit(xw, yw, x0, gamma)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.0217, "o", "            if res is not None and (best is None or res[2] < best[0]):\r\n\u001b[?2004l\r"]
[65.021714, "o", "\u001b[?2004h> "]
[65.021821, "o", "                best = (res[2], x0, gamma, res[0], res[1])\r\n\u001b[?2004l\r"]
[65.021836, "o", "\u001b[?2004h> "]
[65.021901, "o", "    def obj(q):\r\n\u001b[?2004l\r"]
[65.021937, "o", "\u001b[?2004h>         x0 = q[0]\r\n\u001b[?2004l\r"]
[65.021974, "o", "\u001b[?2004h> "]
[65.022025, "o", "        gamma = math.exp(q[1])\r\n\u001b[?2004l\r"]
[65.022047, "o", "\u001b[?2004h> "]
[65.022177, "o", "        if gamma < 0.5 or gamma > 250.0 or x0 < xlo - 100.0 or x0 > xhi + 100.0:\r\n\u001b[?2004l\r"]
[65.022244, "o", "\u001b[?2004h> "]
[65.022262, "o", "            return 1e100\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.022303, "o", "> "]
[65.022349, "o", "        res = linear_fit(xw, yw, x0, gamma)\r\n\u001b[?2004l\r"]
[65.022392, "o", "\u001b[?2004h> "]
[65.022424, "o", "        if res is None:\r\n\u001b[?2004l\r"]
[65.022474, "o", "\u001b[?2004h"]
[65.022491, "o", ">             return 1e100\r\n"]
[65.022498, "o", "\u001b[?2004l\r"]
[65.022565, "o", "\u001b[?2004h> "]
[65.022592, "o", "        return res[2]\r\n"]
[65.022603, "o", "\u001b[?2004l\r"]
[65.022614, "o", "\u001b[?2004h"]
[65.022679, "o", "> "]
[65.022714, "o", "    start = [best[1], math.log(best[2])]\r\n\u001b[?2004l\r"]
[65.022793, "o", "\u001b[?2004h> "]
[65.022877, "o", "    opt, fval, iters = nelder_mead(obj, start, [2.0, 0.2])\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.022891, "o", "> "]
[65.022934, "o", "    x0 = opt[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.022947, "o", "> "]
[65.023008, "o", "    gamma = math.exp(opt[1])\r\n\u001b[?2004l\r"]
[65.023022, "o", "\u001b[?2004h> "]
[65.02312, "o", "    A, b, sse = linear_fit(xw, yw, x0, gamma)\r\n\u001b[?2004l\r"]
[65.023197, "o", "\u001b[?2004h> "]
[65.023287, "o", "    return {'x0': x0, 'gamma': gamma, 'amplitude': A, 'offset': b}, len(xw), sse, iters\r\n\u001b[?2004l\r"]
[65.023331, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[65.023362, "o", "\u001b[?2004h"]
[65.023443, "o", "> x, y = read_data('/app/spectrum.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.023544, "o", "windows = {'D': (1240.0, 1460.0), 'G': (1480.0, 1700.0), '2D': (2540.0, 2820.0)}\r\n\u001b[?2004l\r"]
[65.023558, "o", "\u001b[?2004h> "]
[65.023568, "o", "out = {}\r\n\u001b[?2004l\r"]
[65.023591, "o", "\u001b[?2004h> "]
[65.023654, "o", "for name, (lo, hi) in windows.items():\r\n\u001b[?2004l\r"]
[65.023665, "o", "\u001b[?2004h> "]
[65.023781, "o", "    params, n, sse, iters = fit_peak(x, y, lo, hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.023825, "o", "    out[name] = params\r\n\u001b[?2004l\r"]
[65.023862, "o", "\u001b[?2004h> "]
[65.023948, "o", "    print(name, 'n', n, 'sse', sse, 'iters', iters, params)\r\n\u001b[?2004l\r"]
[65.023966, "o", "\u001b[?2004h> "]
[65.024175, "o", "out['ID_IG'] = out['D']['amplitude'] / out['G']['amplitude']\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(out, f, indent=2)\r\n\u001b[?2004l\r"]
[65.024195, "o", "\u001b[?2004h> "]
[65.024261, "o", "print('ID_IG', out['ID_IG'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.024297, "o", "> "]
[65.024339, "o", "print('wrote /app/results.json')\r\n\u001b[?2004l\r"]
[65.024358, "o", "\u001b[?2004h> "]
[65.024369, "o", "PY\r\n\u001b[?2004l\r"]
[65.025989, "o", "\u001b[?2004hroot@j-openenv-6afd8a8829e8b7ccfbbb81c6-p90ydj00-dd2ef-r6sls:/app# "]
[65.02612, "o", "python3 /app/fit.py\r\n\u001b[?2004l\r"]
