[65.215712, "o", " 2579302.8673335304 iters 38 {'x0': 1354.910720476299, 'gamma': 18.536825469318753, 'amplitude': 5996.824146550515, 'offset': 920.0030309624967}\r\n"]
[65.372314, "o", "G n 440 sse 3154907.8716602386 iters 39 "]
[65.372455, "o", "{'x0': 1583.3958651355447, 'gamma': 10.925583262466922, 'amplitude': 7487.295623495061, 'offset': 928.7159165455615}\r\n"]
[65.578528, "o", "2D n 560 sse 3778597.7266871864 "]
[65.578656, "o", "iters 40 {'x0': 2676.5341067266, 'gamma': 28.51889701301966, 'amplitude': 9969.577872390617, 'offset': 792.3951768756704}\r\n"]
[65.578868, "o", "ID_IG 0.8009332672443892\r\nwrote /app/results.json"]
[65.578894, "o", "\r\n"]
