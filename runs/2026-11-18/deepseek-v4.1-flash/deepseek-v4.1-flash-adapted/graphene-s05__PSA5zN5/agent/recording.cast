[128.574433, "o", "def lm_fit(xs, ys, p0, max_iter=300, lam=1e-3):\r\n\u001b[?2004l\r"]
[128.574464, "o", "\u001b[?2004h> "]
[128.574491, "o", "    p = p0[:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[128.574521, "o", "> "]
[128.574567, "o", "    r = residuals(xs, ys, p)\r\n\u001b[?2004l\r"]
[128.574617, "o", "\u001b[?2004h> "]
[128.574645, "o", "    c = sum(v * v for v in r)\r\n\u001b[?2004l\r"]
[128.574676, "o", "\u001b[?2004h> "]
[128.574731, "o", "    for iteration in range(max_iter):\r\n\u001b[?2004l\r"]
[128.574762, "o", "\u001b[?2004h> "]
[128.574809, "o", "        J = jacobian(xs, ys, p)\r\n\u001b[?2004l\r"]
[128.57484, "o", "\u001b[?2004h> "]
[128.574865, "o", "        npar = 4\r\n\u001b[?2004l\r"]
[128.574895, "o", "\u001b[?2004h> "]
[128.574965, "o", "        JtJ = [[0.0] * npar for _ in range(npar)]\r\n\u001b[?2004l\r"]
[128.574996, "o", "\u001b[?2004h> "]
[128.575036, "o", "        Jtr = [0.0] * npar\r\n\u001b[?2004l\r"]
[128.575075, "o", "\u001b[?2004h> "]
[128.575125, "o", "        for row, ri in zip(J, r):\r\n\u001b[?2004l\r"]
[128.575157, "o", "\u001b[?2004h> "]
[128.575208, "o", "            for i in range(npar):\r\n\u001b[?2004l\r"]
[128.57524, "o", "\u001b[?2004h> "]
[128.575292, "o", "                Jtr[i] += row[i] * ri\r\n\u001b[?2004l\r"]
[128.575323, "o", "\u001b[?2004h> "]
[128.575386, "o", "                for j in range(i, npar):\r\n\u001b[?2004l\r"]
[128.575424, "o", "\u001b[?2004h> "]
[128.575489, "o", "                    JtJ[i][j] += row[i] * row[j]\r\n\u001b[?2004l\r"]
[128.575522, "o", "\u001b[?2004h> "]
[128.575565, "o", "        for i in range(npar):\r\n\u001b[?2004l\r"]
[128.575596, "o", "\u001b[?2004h> "]
[128.575642, "o", "            for j in range(i):\r\n\u001b[?2004l\r"]
[128.575672, "o", "\u001b[?2004h> "]
[128.575726, "o", "                JtJ[i][j] = JtJ[j][i]\r\n\u001b[?2004l\r"]
[128.575756, "o", "\u001b[?2004h> "]
[128.575807, "o", "        A = [row[:] for row in JtJ]\r\n\u001b[?2004l\r"]
[128.57584, "o", "\u001b[?2004h> "]
[128.575883, "o", "        for i in range(npar):\r\n\u001b[?2004l\r"]
[128.575913, "o", "\u001b[?2004h> "]
[128.575985, "o", "            A[i][i] += lam * max(abs(JtJ[i][i]), 1e-12)\r\n\u001b[?2004l\r"]
[128.576016, "o", "\u001b[?2004h> "]
[128.576044, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[128.576073, "o", "> "]
[128.576144, "o", "            delta = solve_linear(A, [-v for v in Jtr])\r\n\u001b[?2004l\r"]
[128.576174, "o", "\u001b[?2004h> "]
[128.576216, "o", "        except ValueError:\r\n\u001b[?2004l\r"]
[128.576252, "o", "\u001b[?2004h> "]
[128.576282, "o", "            lam *= 10.0\r\n\u001b[?2004l\r"]
[128.576314, "o", "\u001b[?2004h> "]
[128.576357, "o", "            if lam > 1e14:\r\n\u001b[?2004l\r"]
[128.576386, "o", "\u001b[?2004h> "]
[128.576424, "o", "                break\r\n\u001b[?2004l\r"]
[128.576454, "o", "\u001b[?2004h> "]
[128.576491, "o", "            continue\r\n\u001b[?2004l\r"]
[128.57652, "o", "\u001b[?2004h> "]
[128.576592, "o", "        newp = [p[i] + delta[i] for i in range(npar)]\r\n\u001b[?2004l\r"]
[128.576622, "o", "\u001b[?2004h> "]
[128.576705, "o", "        # Keep the fitted peak center inside the selected window.\r\n\u001b[?2004l\r"]
[128.576735, "o", "\u001b[?2004h> "]
[128.576772, "o", "        lo_x = min(xs)\r\n\u001b[?2004l\r"]
[128.576802, "o", "\u001b[?2004h> "]
