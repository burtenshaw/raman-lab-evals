[128.572626, "o", "def solve_linear(A, b):\r\n\u001b[?2004l\r"]
[128.572659, "o", "\u001b[?2004h> "]
[128.572701, "o", "    n = len(b)\r\n\u001b[?2004l\r:\r\n"]
[128.572732, "o", "\u001b[?2004h> "]
[128.572841, "o", "    M = [A[i][:] + [b[i]] for i in range(n)]\r\n\u001b[?2004l\r"]
[128.572875, "o", "\u001b[?2004h> "]
[128.572912, "o", "    for col in range(n):\r\n\u001b[?2004l\r"]
[128.572946, "o", "\u001b[?2004h> "]
[128.573028, "o", "        pivot = max(range(col, n), key=lambda r: abs(M[r][col]))\r\n\u001b[?2004l\r"]
[128.573062, "o", "\u001b[?2004h> "]
[128.573117, "o", "        if abs(M[pivot][col]) < 1e-18:\r\n\u001b[?2004l\r"]
[128.573148, "o", "\u001b[?2004h> "]
[128.573213, "o", "            raise ValueError('singular matrix')\r\n\u001b[?2004l\r"]
[128.573244, "o", "\u001b[?2004h> "]
[128.573282, "o", "        if pivot != col:\r\n\u001b[?2004l\r"]
[128.573312, "o", "\u001b[?2004h> "]
[128.573376, "o", "            M[col], M[pivot] = M[pivot], M[col]\r\n\u001b[?2004l\r"]
[128.573417, "o", "\u001b[?2004h> "]
[128.573445, "o", "        pv = M[col][col]\r\n\u001b[?2004l\r"]
[128.573476, "o", "\u001b[?2004h> "]
[128.573529, "o", "        for j in range(col, n + 1):\r\n\u001b[?2004l\r"]
[128.57356, "o", "\u001b[?2004h> "]
[128.573601, "o", "            M[col][j] /= pv\r\n\u001b[?2004l\r"]
[128.573633, "o", "\u001b[?2004h> "]
[128.573675, "o", "        for r in range(n):\r\n\u001b[?2004l\r"]
[128.573706, "o", "\u001b[?2004h> "]
[128.573746, "o", "            if r == col:\r\n\u001b[?2004l\r"]
[128.573783, "o", "\u001b[?2004h> "]
[128.573818, "o", "                continue\r\n\u001b[?2004l\r"]
[128.573856, "o", "\u001b[?2004h> "]
[128.573896, "o", "            factor = M[r][col]\r\n\u001b[?2004l\r"]
[128.573928, "o", "\u001b[?2004h> "]
[128.573977, "o", "            if factor == 0.0:\r\n\u001b[?2004l\r"]
[128.574007, "o", "\u001b[?2004h> "]
[128.574043, "o", "                continue\r\n\u001b[?2004l\r"]
[128.574074, "o", "\u001b[?2004h> "]
[128.57413, "o", "            for j in range(col, n + 1):\r\n\u001b[?2004l\r"]
[128.574161, "o", "\u001b[?2004h> "]
[128.574224, "o", "                M[r][j] -= factor * M[col][j]\r\n\u001b[?2004l\r"]
[128.574256, "o", "\u001b[?2004h> "]
[128.574309, "o", "    return [M[i][n] for i in range(n)]\r\n\u001b[?2004l\r"]
[128.574342, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
