[169.548342, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('/app/spectrum.csv') as f:\n    for row in csv.DictReader(f):\n        xs.append(float(row['raman_shift_cm-1'])); ys.append(float(row['intensity']))\nfor name, lo, hi in [('D',1250,1470),('G',1500,1650),('2D',2550,2820)]:\n    print('---', name)\n    for x,y in zip(xs,ys):\n        if lo <= x <= hi and abs((x-lo) % 10.0) < 0.6:\n            print(f'{x:7.1f} {y:9.2f}')\nPY\n"]
