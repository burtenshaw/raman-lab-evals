[183.245176, "i", "python3 - <<'PY'\nimport math, fit_spectrum as fs\nxs, ys = fs.load_spectrum()\nconfigs = {\n 'D': [(1200,1500,1354),(1250,1470,1354),(1300,1420,1354),(1320,1390,1354)],\n 'G': [(1450,1700,1580),(1500,1650,1580),(1540,1620,1580),(1560,1610,1580)],\n '2D': [(2500,2900,2689),(2550,2820,2689),(2600,2800,2689),(2640,2740,2689)],\n}\nfor name, wins in configs.items():\n    print('---', name)\n    for lo,hi,x0 in wins:\n        r=fs.fit_peak(xs,ys,lo,hi,x0,20.0)\n        print(f'win=({lo},{hi}) x0={r[\"x0\"]:.4f} gamma={r[\"gamma\"]:.4f} amp={r[\"amplitude\"]:.3f} off={r[\"offset\"]:.3f} rmse={math.sqrt(r[\"_cost\"]/r[\"_npoints\"]):.3f}')\nPY\n"]
