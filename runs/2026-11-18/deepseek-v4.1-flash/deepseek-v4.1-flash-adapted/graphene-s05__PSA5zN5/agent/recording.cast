[128.580008, "o", "    return {\r\n\u001b[?2004l\r"]
[128.580041, "o", "\u001b[?2004h> "]
[128.580066, "o", "        'x0': p[2],\r\n\u001b[?2004l\r"]
[128.580098, "o", "\u001b[?2004h> "]
[128.580146, "o", "        'gamma': math.exp(p[1]),\r\n\u001b[?2004l\r"]
[128.580179, "o", "\u001b[?2004h> "]
[128.58023, "o", "        'amplitude': math.exp(p[0]),\r\n\u001b[?2004l\r"]
[128.580263, "o", "\u001b[?2004h> "]
[128.580298, "o", "        'offset': p[3],\r\n\u001b[?2004l\r"]
[128.580332, "o", "\u001b[?2004h> "]
[128.580361, "o", "        '_cost': c,\r\n\u001b[?2004l\r"]
[128.580396, "o", "\u001b[?2004h> "]
[128.580441, "o", "        '_iterations': iters,\r\n\u001b[?2004l\r"]
[128.580475, "o", "\u001b[?2004h> "]
[128.580516, "o", "        '_npoints': len(wx),\r\n\u001b[?2004l\r"]
[128.58055, "o", "\u001b[?2004h> "]
[128.580575, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[128.580608, "o", "> \r\n\u001b[?2004l\r"]
[128.58064, "o", "\u001b[?2004h> "]
[128.580673, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.580717, "o", "    xs, ys = load_spectrum()\r\n\u001b[?2004l\r"]
[128.580751, "o", "\u001b[?2004h> "]
[128.580822, "o", "    d = fit_peak(xs, ys, 1250.0, 1470.0, 1356.6, 20.0)\r\n\u001b[?2004l\r"]
[128.580855, "o", "\u001b[?2004h> "]
[128.580925, "o", "    g = fit_peak(xs, ys, 1500.0, 1650.0, 1580.1, 15.0)\r\n\u001b[?2004l\r"]
[128.58096, "o", "\u001b[?2004h> "]
[128.58103, "o", "    td = fit_peak(xs, ys, 2550.0, 2820.0, 2689.4, 25.0)\r\n\u001b[?2004l\r"]
[128.581063, "o", "\u001b[?2004h> "]
[128.581091, "o", "    result = {\r\n\u001b[?2004l\r"]
[128.581124, "o", "\u001b[?2004h> "]
[128.581213, "o", "        'D': {k: d[k] for k in ('x0', 'gamma', 'amplitude', 'offset')},\r\n\u001b[?2004l\r"]
[128.581248, "o", "\u001b[?2004h> "]
[128.581334, "o", "        'G': {k: g[k] for k in ('x0', 'gamma', 'amplitude', 'offset')},\r\n\u001b[?2004l\r"]
[128.581369, "o", "\u001b[?2004h> "]
[128.581458, "o", "        '2D': {k: td[k] for k in ('x0', 'gamma', 'amplitude', 'offset')},\r\n\u001b[?2004l\r"]
[128.581491, "o", "\u001b[?2004h> "]
[128.581562, "o", "        'ID_IG': d['amplitude'] / g['amplitude'],\r\n\u001b[?2004l\r"]
[128.581595, "o", "\u001b[?2004h> "]
[128.581629, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.581692, "o", "    with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[128.581727, "o", "\u001b[?2004h> "]
[128.58178, "o", "        json.dump(result, f, indent=2)\r\n\u001b[?2004l\r"]
[128.581808, "o", "\u001b[?2004h> "]
[128.581865, "o", "    print(json.dumps(result, indent=2))\r\n\u001b[?2004l\r"]
[128.581898, "o", "\u001b[?2004h> "]
[128.582001, "o", "    print('diagnostics:', {'D': {k: v for k, v in d.items() if k.startswith('_')},\r\n\u001b[?2004l\r"]
[128.582036, "o", "\u001b[?2004h> "]
[128.58214, "o", "                            'G': {k: v for k, v in g.items() if k.startswith('_')},\r\n\u001b[?2004l\r"]
[128.582174, "o", "\u001b[?2004h> "]
[128.58228, "o", "                            '2D': {k: v for k, v in td.items() if k.startswith('_')}})\r\n\u001b[?2004l\r"]
[128.582316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[128.582349, "o", "> "]
[128.582386, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[128.582418, "o", "\u001b[?2004h> "]
[128.582448, "o", "    main()\r\n\u001b[?2004l\r"]
