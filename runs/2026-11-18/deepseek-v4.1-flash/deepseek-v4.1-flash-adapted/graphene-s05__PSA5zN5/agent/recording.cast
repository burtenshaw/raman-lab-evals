[128.57687, "o", "\u001b[?2004h> "]
[128.576933, "o", "        newp[2] = min(max(newp[2], lo_x), hi_x)\r\n\u001b[?2004l\r"]
[128.576967, "o", "\u001b[?2004h> "]
[128.577024, "o", "        # Guard against overflow in exp().\r\n\u001b[?2004l\r"]
[128.577055, "o", "\u001b[?2004h> "]
[128.577123, "o", "        newp[0] = min(max(newp[0], -20.0), 20.0)\r\n\u001b[?2004l\r"]
[128.577153, "o", "\u001b[?2004h> "]
[128.577222, "o", "        newp[1] = min(max(newp[1], -10.0), 10.0)\r\n\u001b[?2004l\r"]
[128.57725, "o", "\u001b[?2004h> "]
