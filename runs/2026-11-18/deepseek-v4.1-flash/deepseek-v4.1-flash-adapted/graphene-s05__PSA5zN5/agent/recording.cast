[157.771096, "i", "python3 - <<'PY'\nimport math, fit_spectrum as fs\nxs, ys = fs.load_spectrum()\nwindows = {\n    'D': (1250.0, 1470.0, [1348, 1354, 1360]),\n    'G': (1500.0, 1650.0, [1574, 1580, 1586]),\n    '2D': (2550.0, 2820.0, [2680, 2689, 2698]),\n}\nfor name, (lo, hi, x0s) in windows.items():\n    wx=[x for x in xs if lo<=x<=hi]\n    wy=[y for x,y in zip(xs,ys) if lo<=x<=hi]\n    best=None\n    for x0 in x0s:\n        for gamma0 in [5.0, 10.0, 20.0, 40.0]:\n            off0=min(wy)\n            amp0=max(wy)-off0\n            if amp0<=0: amp0=max(wy)\n            p0=[math.log(amp0), math.log(gamma0), x0, off0]\n            p,c,it=fs.lm_fit(wx,wy,p0,max_iter=500)\n            rec=(c,it,p[2],math.exp(p[1]),math.exp(p[0]),p[3])\n            if best is None or c<best[0]: best=rec\n    c,it,x0,g,a,o=best\n    print(name, 'cost', c, 'iters', it, 'x0', x0, 'gamma', g, 'amp', a, 'offset', o, 'rmse', math.sqrt(c/len(wx)))\nPY\n"]
[157.771242, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
