[11.981176, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nprint('n',len(xs),'x range',min(xs),max(xs),'y range',min(ys),max(ys))\nfor name,lo,hi in [('D',1150,1500),('G',1500,1700),('2D',2500,2900)]:\n    inds=[i for i,x in enumerate(xs) if lo<=x<=hi]\n    im=max(inds,key=lambda i:ys[i])\n    print(name,'max',ys[im],'at',xs[im])\n    # also print a few values around local max\n    a=max(0,im-2); b=min(len(xs),im+3)\n    print([(xs[i],ys[i]) for i in range(a,b)])\nPY\n"]
