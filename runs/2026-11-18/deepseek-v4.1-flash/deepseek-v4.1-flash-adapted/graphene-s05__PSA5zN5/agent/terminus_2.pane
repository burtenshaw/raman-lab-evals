[?2004limport csv, math, json

def load_spectrum():
    xs = []
    ys = []
    with open('/app/spectrum.csv') as f:
        reader = csv.DictReader(f)
        for row in reader:
            xs.append(float(row['raman_shift_cm-1']))
            ys.append(float(row['intensity']))
    return xs, ys

def median(values):
    vals = sorted(values)
    n = len(vals)
    if n % 2 == 1:
        return vals[n // 2]
    return 0.5 * (vals[n // 2 - 1] + vals[n // 2])

def lorentz_model(x, p):
    log_a, log_g, x0, offset = p
    amp = math.exp(log_a)
    gamma = math.exp(log_g)
    z = x - x0
    return amp * gamma * gamma / (z * z + gamma * gamma) + offset

def residuals(xs, ys, p):
    return [lorentz_model(x, p) - y for x, y in zip(xs, ys)]

def cost(xs, ys, p):
    return sum(r * r for r in residuals(xs, ys, p))

def jacobian(xs, ys, p):
    log_a, log_g, x0, offset = p
    amp = math.exp(log_a)
    gamma = math.exp(log_g)
    rows = []
    for x in xs:
        z = x - x0
        d = z * z + gamma * gamma
        base = amp * gamma * gamma / d
        da = base
        dg = 2.0 * amp * gamma * gamma * z * z / (d * d)
        dx0 = 2.0 * amp * gamma * gamma * z / (d * d)
        rows.append([da, dg, dx0, 1.0])
    return rows
