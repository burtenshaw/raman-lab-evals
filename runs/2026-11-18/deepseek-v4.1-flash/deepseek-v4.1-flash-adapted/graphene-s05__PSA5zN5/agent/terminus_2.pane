[?2004l[?2004h>     'D': (1250.0, 1470.0, [1348, 1354, 1360]),
[?2004l[?2004h>     'G': (1500.0, 1650.0, [1574, 1580, 1586]),
[?2004l[?2004h>     '2D': (2550.0, 2820.0, [2680, 2689, 2698]),
[?2004l[?2004h> }
[?2004l[?2004h> for name, (lo, hi, x0s) in windows.items():
[?2004l[?2004h>     wx=[x for x in xs if lo<=x<=hi]
[?2004l[?2004h>     wy=[y for x,y in zip(xs,ys) if lo<=x<=hi]
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for x0 in x0s:
[?2004l[?2004h>         for gamma0 in [5.0, 10.0, 20.0, 40.0]:
[?2004l[?2004h>             off0=min(wy)
[?2004l[?2004h>             amp0=max(wy)-off0
[?2004l[?2004h>             if amp0<=0: amp0=max(wy)
[?2004l[?2004h>             p0=[math.log(amp0), math.log(gamma0), x0, off0]
[?2004l[?2004h>             p,c,it=fs.lm_fit(wx,wy,p0,max_iter=500)
[?2004l[?2004h>             rec=(c,it,p[2],math.exp(p[1]),math.exp(p[0]),p[3])
[?2004l[?2004h>             if best is None or c<best[0]: best=rec
[?2004l[?2004h>     c,it,x0,g,a,o=best
[?2004l[?2004h>     print(name, 'cost', c, 'iters', it, 'x0', x0, 'gamma', g, 'amp', a, 'offset', o, 'rmse', math.sqrt(c/len(wx)))
