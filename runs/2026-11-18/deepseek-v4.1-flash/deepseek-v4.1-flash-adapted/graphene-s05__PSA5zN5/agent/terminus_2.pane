def fit_peak(xs, ys, lo, hi, init_x0, init_gamma):
    wx = []
    wy = []
    for x, y in zip(xs, ys):
        if lo <= x <= hi:
            wx.append(x)
            wy.append(y)
    if not wx:
        raise ValueError('empty fitting window')
    offset0 = min(wy)
    amp0 = max(wy) - offset0
    if amp0 <= 0:
        amp0 = max(wy)
    p0 = [math.log(amp0), math.log(init_gamma), init_x0, offset0]
    p, c, iters = lm_fit(wx, wy, p0)
    return {
        'x0': p[2],
        'gamma': math.exp(p[1]),
        'amplitude': math.exp(p[0]),
        'offset': p[3],
        '_cost': c,
        '_iterations': iters,
        '_npoints': len(wx),
    }

def main():
    xs, ys = load_spectrum()
