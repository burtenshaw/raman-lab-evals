python3 - <<'PY'
import csv, math
path='/app/spectrum.csv'
rows=[]
with open(path, newline='') as f:
    r=csv.reader(f)
    header=next(r)
    for row in r:
        if len(row)>=2:
            rows.append((float(row[0]), float(row[1])))
print('header', header, 'n', len(rows), 'x range', rows[0][0], rows[-1][0])
for name, lo, hi in [('D',1300,1400),('G',1530,1630),('2D',2600,2780)]:
    win=[(x,y) for x,y in rows if lo<=x<=hi]
    xm, ym=max(win, key=lambda p:p[1])
    print(name, 'max', xm, ym)
    # print values every ~10 cm-1 near max
    for x,y in win[::20]:
        if abs(x-xm)<=60:
            print(f'  {x:.2f} {y:.1f}')
