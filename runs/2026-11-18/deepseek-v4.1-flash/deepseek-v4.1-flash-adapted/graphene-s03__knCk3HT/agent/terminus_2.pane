[?2004l[?2004h> for name, (lo, hi, x0_guess) in windows.items():
[?2004l[?2004h>     mask = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[mask], y[mask]
[?2004l[?2004h>     offset_guess = float(np.median(np.r_[yw[:20], yw[-20:]]))
[?2004l[?2004h>     amp_guess = float(np.max(yw) - offset_guess)
[?2004l[?2004h>     p0 = [x0_guess, 15.0, amp_guess, offset_guess]
[?2004l[?2004h>     bounds = ([lo, 1.0, 0.0, -np.inf], [hi, 100.0, np.inf, np.inf])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     x0, gamma, amplitude, offset = map(float, popt)
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': x0,
[?2004l[?2004h>         'gamma': gamma,
[?2004l[?2004h>         'amplitude': amplitude,
[?2004l[?2004h>         'offset': offset,
[?2004l[?2004h>     }
[?2004l[?2004h>     yfit = lorentz(xw, *popt)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean((yw - yfit)**2)))
[?2004l[?2004h>     print(f'{name}: x0={x0:.6f} gamma={gamma:.6f} amplitude={amplitude:.6f} offset={offset:.6f} rms={rms:.3f}')
[?2004l[?2004h>     print('  stderr', perr)
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
