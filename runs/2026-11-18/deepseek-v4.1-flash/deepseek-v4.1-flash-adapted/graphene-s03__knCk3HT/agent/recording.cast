[36.102334, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[36.103121, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m26.2.2\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.3\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[36.162657, "o", "\u001b[?2004hroot@j-openenv-6afd8c7929e8b7ccfbbb8316-3kelkmyt-e7f40-gwvwc:/app# "]
[50.201168, "i", "python3 - <<'PY'\nimport csv, json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\npath = '/app/spectrum.csv'\nx, y = [], []\nwith open(path, newline='') as f:\n    r = csv.reader(f)\n    header = next(r)\n    for row in r:\n        if len(row) >= 2:\n            x.append(float(row[0]))\n            y.append(float(row[1]))\nx = np.array(x)\ny = np.array(y)\n\ndef lorentz(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  (1280.0, 1430.0, 1353.6),\n    'G':  (1510.0, 1660.0, 1582.6),\n    '2D': (2590.0, 2780.0, 2676.9),\n}\nresults = {}\nfor name, (lo, hi, x0_guess) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    xw, yw = x[mask], y[mask]\n    offset_guess = float(np.median(np.r_[yw[:20], yw[-20:]]))\n    amp_guess = float(np.max(yw) - offset_guess)\n    p0 = [x0_guess, 15.0, amp_guess, offset_guess]\n    bounds = ([lo, 1.0, 0.0, -np.inf], [hi, 100.0, np.inf, np.inf])\n    popt, pcov = curve_fit(lorentz, xw, yw, p0=p0, bounds=bounds, maxfev=2"]
[50.201233, "i", "0000)\n    perr = np.sqrt(np.diag(pcov))\n    x0, gamma, amplitude, offset = map(float, popt)\n    results[name] = {\n        'x0': x0,\n        'gamma': gamma,\n        'amplitude': amplitude,\n        'offset': offset,\n    }\n    yfit = lorentz(xw, *popt)\n    rms = float(np.sqrt(np.mean((yw - yfit)**2)))\n    print(f'{name}: x0={x0:.6f} gamma={gamma:.6f} amplitude={amplitude:.6f} offset={offset:.6f} rms={rms:.3f}')\n    print('  stderr', perr)\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nPY\n"]
