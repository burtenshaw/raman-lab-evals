[?2004hroot@j-openenv-6afd8acc29e8b7ccfbbb820e-jrnqkdyj-6b712-l4p6l:/app# python3 - <<'PY'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> x, y = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1, unpack=True)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian_offset(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D':  (1250.0, 1450.0),
[?2004l[?2004h>     'G':  (1500.0, 1650.0),
[?2004l[?2004h>     '2D': (2550.0, 2800.0),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Initial guesses and bounds [x0, gamma, amplitude, offset]
[?2004l[?2004h> initial = {
[?2004l[?2004h>     'D':  (1347.0, 30.0, 5000.0, 500.0),
[?2004l[?2004h>     'G':  (1579.0, 30.0, 9000.0, 500.0),
[?2004l[?2004h>     '2D': (2694.0, 50.0, 18000.0, 500.0),
[?2004l[?2004h> }
[?2004l[?2004h> bounds = {
[?2004l[?2004h>     'D':  ([1300.0, 5.0, 0.0, -5000.0], [1400.0, 150.0, 50000.0, 10000.0]),
[?2004l[?2004h>     'G':  ([1530.0, 5.0, 0.0, -5000.0], [1630.0, 150.0, 50000.0, 10000.0]),
[?2004l[?2004h>     '2D': ([2550.0, 10.0, 0.0, -5000.0], [2800.0, 250.0, 100000.0, 10000.0]),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for peak, (lo, hi) in windows.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     p0 = initial[peak]
[?2004l[?2004h>     lb, ub = bounds[peak]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian_offset, xw, yw, p0=p0, bounds=(lb, ub), maxfev=20000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     yfit = lorentzian_offset(xw, *popt)
[?2004l[?2004h>     rmse = np.sqrt(np.mean((yw - yfit)**2))
[?2004l[?2004h>     x0, gamma, amplitude, offset = popt
