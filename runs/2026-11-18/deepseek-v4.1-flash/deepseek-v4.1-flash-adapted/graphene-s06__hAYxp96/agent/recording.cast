[8.493771, "i", "python3 - <<'PY'\nimport numpy as np\ntry:\n    import scipy\n    print('scipy', scipy.__version__)\nexcept Exception as e:\n    print('scipy import failed:', e)\n\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nprint('shape:', data.shape)\nprint('x range:', data[0,0], data[-1,0])\nfor lo, hi in [(1300, 1400), (1530, 1630), (2600, 2750)]:\n    mask = (data[:,0] >= lo) & (data[:,0] <= hi)\n    sub = data[mask]\n    idx = np.argmax(sub[:,1])\n    print(f'window {lo}-{hi}: max at x={sub[idx,0]}, I={sub[idx,1]}')\nPY\n"]
