[35.148993, "i", "python3 - <<'PY'\nimport numpy as np\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:,0], data[:,1]\nprint('shape:', data.shape)\nprint('x range:', x.min(), x.max())\nfor name, lo, hi in [('D', 1250, 1450), ('G', 1500, 1650), ('2D', 2550, 2800)]:\n    m = (x >= lo) & (x <= hi)\n    idx = np.argmax(y[m])\n    print(name, 'window', lo, hi, 'max x=', x[m][idx], 'I=', y[m][idx], 'n=', m.sum())\nPY\n"]
