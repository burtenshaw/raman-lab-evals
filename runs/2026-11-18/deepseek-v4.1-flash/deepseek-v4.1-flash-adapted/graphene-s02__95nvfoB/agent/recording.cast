[17.449693, "i", "python3 - <<'PY'\nimport csv\nxs=[]; ys=[]\nwith open('spectrum.csv', newline='') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        xs.append(float(row['raman_shift_cm-1']))\n        ys.append(float(row['intensity']))\nprint('n', len(xs), 'xrange', xs[0], xs[-1])\nfor name, lo, hi in [('D',1250,1450),('G',1500,1700),('2D',2500,2850)]:\n    best=max((y,x,i) for i,(x,y) in enumerate(zip(xs,ys)) if lo<=x<=hi)\n    y,x,i=best\n    print(name, 'max', x, y, 'index', i)\n    for j in range(max(0,i-5), min(len(xs),i+6)):\n        print('   ', xs[j], ys[j])\nPY\n"]
