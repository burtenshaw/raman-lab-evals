[?2004hroot@j-openenv-6afd8b10e5cad0e4dc3e6bf5-g9b213mh-f9e66-bp85q:/app# python3 - <<'PY'
[?2004l[?2004h> import csv, json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> x=[]; y=[]
[?2004l[?2004h> with open('/app/spectrum.csv', newline='') as f:
[?2004l[?2004h>     for row in csv.DictReader(f):
[?2004l[?2004h>         x.append(float(row['raman_shift_cm-1']))
[?2004l[?2004h>         y.append(float(row['intensity']))
[?2004l[?2004h> x=np.array(x, float); y=np.array(y, float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amp, x0, gamma, offset):
[?2004l[?2004h>     return amp * gamma**2 / ((x-x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> windows={'D':(1250,1450),'G':(1500,1700),'2D':(2550,2850)}
[?2004l[?2004h> # Initial guesses: x0 at local max, gamma 20-40, amp ~ peak-height above estimated baseline, offset min window
[?2004l[?2004h> results={}
[?2004l[?2004h> for name,(lo,hi) in windows.items():
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xw=x[m]; yw=y[m]
[?2004l[?2004h>     imax=np.argmax(yw)
[?2004l[?2004h>     x0_guess=xw[imax]
[?2004l[?2004h>     offset_guess=np.percentile(yw, 5)
[?2004l[?2004h>     amp_guess=yw[imax]-offset_guess
[?2004l[?2004h>     gamma_guess=25.0 if name!='2D' else 40.0
[?2004l[?2004h>     p0=[amp_guess, x0_guess, gamma_guess, offset_guess]
[?2004l[?2004h>     bounds=([0,lo,1e-6,-np.inf],[np.inf,hi,np.inf,np.inf])
[?2004l[?2004h>     popt,pcov=curve_fit(lorentz,xw,yw,p0=p0,bounds=bounds,maxfev=20000)
[?2004l[?2004h>     amp,x0,gamma,offset=popt
[?2004l[?2004h>     results[name]={'x0':float(x0),'gamma':float(gamma),'amplitude':float(amp),'offset':float(offset)}
[?2004l[?2004h>     print(name, results[name], 'window', lo, hi, 'n', len(xw), 'rms', float(np.sqrt(np.mean((yw-lorentz(xw,*popt))**2))))
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG']=results['D']['amplitude']/results['G']['amplitude']
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     json.dump(results,f,indent=2)
[?2004l[?2004h> print('ID_IG',results['ID_IG'])
[?2004l[?2004h> print('wrote /app/results.json')
