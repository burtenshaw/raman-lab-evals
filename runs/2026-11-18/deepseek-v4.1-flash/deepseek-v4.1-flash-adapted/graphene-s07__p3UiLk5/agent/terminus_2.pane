[?2004l[?2004h> import csv, math
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> x, y = [], []
[?2004l[?2004h> with open('spectrum.csv') as f:
[?2004l[?2004h>     r = csv.DictReader(f)
[?2004l[?2004h>     for row in r:
[?2004l[?2004h>         x.append(float(row['raman_shift_cm-1']))
[?2004l[?2004h>         y.append(float(row['intensity']))
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(xv, p):
[?2004l[?2004h>     A, x0, g, c = p
[?2004l[?2004h>     return A*g*g/((xv-x0)**2 + g*g) + c
[?2004l[?2004h> 
[?2004l[?2004h> def cost(xs, ys, p):
[?2004l[?2004h>     return sum((yy - lorentz(xx, p))**2 for xx, yy in zip(xs, ys))
[?2004l[?2004h> 
[?2004l[?2004h> def solve4(A, b):
[?2004l[?2004h>     n = 4
[?2004l[?2004h>     A = [row[:] for row in A]
[?2004l[?2004h>     b = b[:]
[?2004l[?2004h>     for i in range(n):
[?2004l[?2004h>         piv = max(range(i, n), key=lambda r: abs(A[r][i]))
[?2004l[?2004h>         if abs(A[piv][i]) < 1e-18:
[?2004l[?2004h>             raise ValueError('singular matrix')
[?2004l[?2004h>         if piv != i:
[?2004l[?2004h>             A[i], A[piv] = A[piv], A[i]
[?2004l[?2004h>             b[i], b[piv] = b[piv], b[i]
[?2004l[?2004h>         pv = A[i][i]
[?2004l[?2004h>         for j in range(i, n):
[?2004l[?2004h>             A[i][j] /= pv
[?2004l[?2004h>         b[i] /= pv
[?2004l[?2004h>         for r in range(n):
[?2004l[?2004h>             if r == i:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             fac = A[r][i]
[?2004l[?2004h>             if fac != 0.0:
[?2004l[?2004h>                 for j in range(i, n):
[?2004l[?2004h>                     A[r][j] -= fac*A[i][j]
[?2004l[?2004h>                 b[r] -= fac*b[i]
[?2004l[?2004h>     return b
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(xs, ys, p0, lo, hi, maxit=300):
[?2004l[?2004h>     p = p0[:]
[?2004l[?2004h>     lam = 1e-3
[?2004l[?2004h>     oldcost = cost(xs, ys, p)
[?2004l[?2004h>     for it in range(maxit):
[?2004l[?2004h>         # Build normal equations from residual r = y - model
[?2004l[?2004h>         H = [[0.0]*4 for _ in range(4)]
[?2004l[?2004h>         gvec = [0.0]*4
[?2004l[?2004h>         A, x0, g, c = p
[?2004l[?2004h>         for xx, yy in zip(xs, ys):
[?2004l[?2004h>             den = (xx-x0)**2 + g*g
[?2004l[?2004h>             if den <= 0:
[?2004l[?2004h>                 raise ValueError('bad gamma')
[?2004l[?2004h>             r = yy - (A*g*g/den + c)
[?2004l[?2004h>             jac = [
[?2004l[?2004h>                 g*g/den,
[?2004l[?2004h>                 A*g*g*2.0*(xx-x0)/(den*den),
[?2004l[?2004h>                 2.0*A*g*(xx-x0)**2/(den*den),
[?2004l[?2004h>                 1.0
[?2004l[?2004h>             ]
[?2004l[?2004h>             for a in range(4):
[?2004l[?2004h>                 gvec[a] += jac[a]*r
[?2004l[?2004h>                 for b in range(4):
[?2004l[?2004h>                     H[a][b] += jac[a]*jac[b]
[?2004l[?2004h>         M = [row[:] for row in H]
[?2004l[?2004h>         for a in range(4):
[?2004l[?2004h>             M[a][a] *= (1.0 + lam)
[?2004l[?2004h>         try:
[?2004l[?2004h>             delta = solve4(M, gvec)
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             lam *= 10.0
[?2004l[?2004h>             continue
[?2004l[?2004h>         # limit step size to avoid wild jumps
[?2004l[?2004h>         maxrel = max(abs(delta[i])/max(abs(p[i]), 1e-12) for i in range(4))
[?2004l[?2004h>         if maxrel > 2.0:
[?2004l[?2004h>             scale = 2.0/maxrel
[?2004l[?2004h>             delta = [d*scale for d in delta]
[?2004l[?2004h>         pnew = [p[i] + delta[i] for i in range(4)]
[?2004l[?2004h>         # valid parameter checks
[?2004l[?2004h>         if pnew[0] <= 0 or pnew[2] <= 0 or not (lo <= pnew[1] <= hi):
[?2004l[?2004h>             lam *= 10.0
[?2004l[?2004h>             continue
[?2004l[?2004h>         newcost = cost(xs, ys, pnew)
[?2004l[?2004h>         if newcost < oldcost:
[?2004l[?2004h>             p = pnew
[?2004l[?2004h>             improvement = oldcost - newcost
[?2004l[?2004h>             oldcost = newcost
[?2004l[?2004h>             lam = max(lam/3.0, 1e-12)
[?2004l[?2004h>             if improvement < 1e-10*max(1.0, oldcost):
[?2004l[?2004h>                 break
[?2004l[?2004h>         else:
[?2004l[?2004h>             lam *= 10.0
[?2004l[?2004h>             if lam > 1e12:
[?2004l[?2004h>                 break
[?2004l[?2004h>     return p, oldcost
[?2004l[?2004h> 
[?2004l[?2004h> def initial_guess(xs, ys, lo, hi):
[?2004l[?2004h>     im = max(range(len(ys)), key=lambda i: ys[i])
[?2004l[?2004h>     xmax, ymax = xs[im], ys[im]
[?2004l[?2004h>     # baseline from edge medians
[?2004l[?2004h>     k = max(3, min(30, len(ys)//10))
[?2004l[?2004h>     left = sorted(ys[:k])[k//2]
[?2004l[?2004h>     right = sorted(ys[-k:])[k//2]
[?2004l[?2004h>     c0 = 0.5*(left+right)
[?2004l[?2004h>     A0 = max(1.0, ymax-c0)
[?2004l[?2004h>     half = c0 + 0.5*A0
[?2004l[?2004h>     # crossings nearest maximum
[?2004l[?2004h>     li = None
[?2004l[?2004h>     for i in range(im, -1, -1):
[?2004l[?2004h>         if ys[i] <= half:
[?2004l[?2004h>             li = i
[?2004l[?2004h>             break
[?2004l[?2004h>     ri = None
[?2004l[?2004h>     for i in range(im, len(ys)):
[?2004l[?2004h>         if ys[i] <= half:
[?2004l[?2004h>             ri = i
[?2004l[?2004h>             break
[?2004l[?2004h>     if li is not None and ri is not None and ri > li:
[?2004l[?2004h>         g0 = max(3.0, 0.5*(xs[ri]-xs[li]))
[?2004l[?2004h>     else:
[?2004l[?2004h>         g0 = 20.0
[?2004l[?2004h>     return [A0, xmax, g0, c0]
[?2004l[?2004h> 
[?2004l[?2004h> windows = [('D', 1250.0, 1450.0), ('G', 1490.0, 1680.0), ('2D', 2570.0, 2820.0)]
[?2004l[?2004h> for name, lo, hi in windows:
[?2004l[?2004h>     pairs = [(xx, yy) for xx, yy in zip(x, y) if lo <= xx <= hi]
[?2004l[?2004h>     xs = [p[0] for p in pairs]
[?2004l[?2004h>     ys = [p[1] for p in pairs]
[?2004l[?2004h>     p0 = initial_guess(xs, ys, lo, hi)
[?2004l[?2004h>     p, ss = fit_peak(xs, ys, p0, lo, hi)
[?2004l[?2004h>     rms = math.sqrt(ss/len(xs))
[?2004l[?2004h>     print(name, 'n=', len(xs), 'p0=', [round(v, 4) for v in p0])
[?2004l[?2004h>     print('  A=%.6f x0=%.6f gamma=%.6f offset=%.6f rms=%.4f' % (p[0], p[1], p[2], p[3], rms))
