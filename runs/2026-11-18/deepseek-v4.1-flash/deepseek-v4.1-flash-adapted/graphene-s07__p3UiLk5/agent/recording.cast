[14.814872, "i", "python3 - <<'PY'\nimport numpy as np\ndata = np.loadtxt('spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:, 0], data[:, 1]\nprint('shape:', data.shape)\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\nfor lo, hi, name in [(1250, 1450, 'D'), (1500, 1700, 'G'), (2550, 2850, '2D')]:\n    m = (x >= lo) & (x <= hi)\n    xm, ym = x[m], y[m]\n    i = np.argmax(ym)\n    print(name, 'window', lo, hi, 'max at', xm[i], 'value', ym[i])\n    print('  near max:', [(round(float(xx), 2), round(float(yy), 2)) for xx, yy in zip(xm[max(0, i-2):i+3], ym[max(0, i-2):i+3])])\nPY\n"]
