[56.147143, "i", "python3 - <<'PY'\nimport csv, math\n\n# Load data\nx, y = [], []\nwith open('spectrum.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\n\ndef lorentz(xv, p):\n    A, x0, g, c = p\n    return A*g*g/((xv-x0)**2 + g*g) + c\n\ndef cost(xs, ys, p):\n    return sum((yy - lorentz(xx, p))**2 for xx, yy in zip(xs, ys))\n\ndef solve4(A, b):\n    n = 4\n    A = [row[:] for row in A]\n    b = b[:]\n    for i in range(n):\n        piv = max(range(i, n), key=lambda r: abs(A[r][i]))\n        if abs(A[piv][i]) < 1e-18:\n            raise ValueError('singular matrix')\n        if piv != i:\n            A[i], A[piv] = A[piv], A[i]\n            b[i], b[piv] = b[piv], b[i]\n        pv = A[i][i]\n        for j in range(i, n):\n            A[i][j] /= pv\n        b[i] /= pv\n        for r in range(n):\n            if r == i:\n                continue\n            fac = A[r][i]\n            if fac != 0.0:\n                for j in range(i, n):\n                    A[r][j"]
[56.147372, "i", "] -= fac*A[i][j]\n                b[r] -= fac*b[i]\n    return b\n\ndef fit_peak(xs, ys, p0, lo, hi, maxit=300):\n    p = p0[:]\n    lam = 1e-3\n    oldcost = cost(xs, ys, p)\n    for it in range(maxit):\n        # Build normal equations from residual r = y - model\n        H = [[0.0]*4 for _ in range(4)]\n        gvec = [0.0]*4\n        A, x0, g, c = p\n        for xx, yy in zip(xs, ys):\n            den = (xx-x0)**2 + g*g\n            if den <= 0:\n                raise ValueError('bad gamma')\n            r = yy - (A*g*g/den + c)\n            jac = [\n                g*g/den,\n                A*g*g*2.0*(xx-x0)/(den*den),\n                2.0*A*g*(xx-x0)**2/(den*den),\n                1.0\n            ]\n            for a in range(4):\n                gvec[a] += jac[a]*r\n                for b in range(4):\n                    H[a][b] += jac[a]*jac[b]\n        M = [row[:] for row in H]\n        for a in range(4):\n            M[a][a] *= (1.0 + lam)\n        try:\n            delta = solve4(M, gvec)\n        except ValueError:\n            l"]
[56.147489, "o", "python3 - <<'PY'"]
[56.147515, "i", "am *= 10.0\n            continue\n        # limit step size to avoid wild jumps\n        maxrel = max(abs(delta[i])/max(abs(p[i]), 1e-12) for i in range(4))\n        if maxrel > 2.0:\n            scale = 2.0/maxrel\n            delta = [d*scale for d in delta]\n        pnew = [p[i] + delta[i] for i in range(4)]\n        # valid parameter checks\n        if pnew[0] <= 0 or pnew[2] <= 0 or not (lo <= pnew[1] <= hi):\n            lam *= 10.0\n            continue\n        newcost = cost(xs, ys, pnew)\n        if newcost < oldcost:\n            p = pnew\n            improvement = oldcost - newcost\n            oldcost = newcost\n            lam = max(lam/3.0, 1e-12)\n            if improvement < 1e-10*max(1.0, oldcost):\n                break\n        else:\n            lam *= 10.0\n            if lam > 1e12:\n                break\n    return p, oldcost\n\ndef initial_guess(xs, ys, lo, hi):\n    im = max(range(len(ys)), key=lambda i: ys[i])\n    xmax, ymax = xs[im], ys[im]\n    # baseline from edge medians\n    k = max(3, min(30, len(ys)//10"]
[56.147732, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.147769, "i", "))\n    left = sorted(ys[:k])[k//2]\n    right = sorted(ys[-k:])[k//2]\n    c0 = 0.5*(left+right)\n    A0 = max(1.0, ymax-c0)\n    half = c0 + 0.5*A0\n    # crossings nearest maximum\n    li = None\n    for i in range(im, -1, -1):\n        if ys[i] <= half:\n            li = i\n            break\n    ri = None\n    for i in range(im, len(ys)):\n        if ys[i] <= half:\n            ri = i\n            break\n    if li is not None and ri is not None and ri > li:\n        g0 = max(3.0, 0.5*(xs[ri]-xs[li]))\n    else:\n        g0 = 20.0\n    return [A0, xmax, g0, c0]\n\nwindows = [('D', 1250.0, 1450.0), ('G', 1490.0, 1680.0), ('2D', 2570.0, 2820.0)]\nfor name, lo, hi in windows:\n    pairs = [(xx, yy) for xx, yy in zip(x, y) if lo <= xx <= hi]\n    xs = [p[0] for p in pairs]\n    ys = [p[1] for p in pairs]\n    p0 = initial_guess(xs, ys, lo, hi)\n    p, ss = fit_peak(xs, ys, p0, lo, hi)\n    rms = math.sqrt(ss/len(xs))\n    print(name, 'n=', len(xs), 'p0=', [round(v, 4) for v in p0])\n    print('  A=%.6f x0=%.6f gamma=%.6f offset=%.6f rms=%.4"]
[56.14779, "i", "f' % (p[0], p[1], p[2], p[3], rms))\nPY\n"]
