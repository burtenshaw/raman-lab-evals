[27.083951, "i", "python3 - <<'PY'\nimport csv\nx=[]; y=[]\nwith open('spectrum.csv') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        x.append(float(row['raman_shift_cm-1']))\n        y.append(float(row['intensity']))\nprint('n', len(x), 'x range', x[0], x[-1], 'y range', min(y), max(y))\nfor lo,hi,name in [(1200,1480,'D'),(1480,1700,'G'),(2500,2900,'2D')]:\n    inds=[i for i,xx in enumerate(x) if lo<=xx<=hi]\n    im=max(inds,key=lambda i:y[i])\n    print(name,'max',x[im],y[im])\n    print(' endpoints', x[inds[0]], y[inds[0]], x[inds[-1]], y[inds[-1]])\n    for j in range(max(0,im-3), min(len(x),im+4)):\n        print('  ', x[j], y[j])\nPY\n"]
