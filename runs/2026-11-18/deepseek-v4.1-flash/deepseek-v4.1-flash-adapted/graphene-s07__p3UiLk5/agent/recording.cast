[56.156106, "o", "\u001b[?2004h> def solve4(A, b):\r\n\u001b[?2004l\r\u001b[?2004h>     n = 4\r\n\u001b[?2004l\r\u001b[?2004h>     A = [row[:] for row in A]\r\n\u001b[?2004l\r\u001b[?2004h>     b = b[:]\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>         piv = max(range(i, n), key=lambda r: abs(A[r][i]))\r\n\u001b[?2004l\r\u001b[?2004h>         if abs(A[piv][i]) < 1e-18:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError('singular matrix')\r\n\u001b[?2004l\r\u001b[?2004h>         if piv != i:\r\n\u001b[?2004l\r\u001b[?2004h>             A[i], A[piv] = A[piv], A[i]\r\n\u001b[?2004l\r\u001b[?2004h>             b[i], b[piv] = b[piv], b[i]\r\n\u001b[?2004l\r\u001b[?2004h>         pv = A[i][i]\r\n\u001b[?2004l\r\u001b[?2004h>         for j in range(i, n):\r\n\u001b[?2004l\r\u001b[?2004h>             A[i][j] /= pv\r\n\u001b[?2004l\r\u001b[?2004h>         b[i] /= pv\r\n\u001b[?2004l\r\u001b[?2004h>         for r in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>             if r == i:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             fac = A[r][i]\r\n\u001b[?2004l\r\u001b[?2004h>             if fac != 0.0:\r\n\u001b[?2004l\r\u001b[?2004h>                 for j in range(i, n):\r\n\u001b[?2004l\r\u001b[?20"]
[56.156126, "o", "04h>                     A[r][j] -= fac*A[i][j]\r\n\u001b[?2004l\r\u001b[?2004h>                 b[r] -= fac*b[i]\r\n\u001b[?2004l\r\u001b[?2004h>     return b\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fit_peak(xs, ys, p0, lo, hi, maxit=300):\r\n\u001b[?2004l\r\u001b[?2004h>     p = p0[:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.156447, "o", ">     lam = 1e-3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.156543, "o", "    oldcost = cost(xs, ys, p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.156647, "o", "    for it in range(maxit):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.15671, "o", "        # Build normal equations from residual r = y - model\r\n\u001b[?2004l\r"]
[56.156759, "o", "\u001b[?2004h> "]
[56.156853, "o", "        H = [[0.0]*4 for _ in range(4)]\r\n\u001b[?2004l\r"]
[56.156914, "o", "\u001b[?2004h>         gvec = [0.0]*4\r\n\u001b[?2004l\r"]
[56.156984, "o", "\u001b[?2004h> "]
[56.15715, "o", "        A, x0, g, c = p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.157175, "o", "        for xx, yy in zip(xs, ys):\r\n\u001b[?2004l\r\u001b[?2004h>             den = (xx-x0)**2 + g*g\r\n\u001b[?2004l\r"]
[56.157191, "o", "\u001b[?2004h> "]
[56.157412, "o", "            if den <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.157455, "o", "                raise ValueError('bad gamma')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.157615, "o", "            r = yy - (A*g*g/den + c)\r\n\u001b[?2004l\r\u001b[?2004h>             jac = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.157824, "o", "                g*g/den,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.157866, "o", "                A*g*g*2.0*(xx-x0)/(den*den),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.157948, "o", "                2.0*A*g*(xx-x0)**2/(den*den),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.158068, "o", "                1.0\r\n\u001b[?2004l\r\u001b[?2004h>             ]\r\n\u001b[?2004l\r"]
[56.158233, "o", "\u001b[?2004h>             for a in range(4):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.158291, "o", "                gvec[a] += jac[a]*r\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.158303, "o", "> "]
[56.158525, "o", "                for b in range(4):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.158568, "o", "                    H[a][b] += jac[a]*jac[b]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.158654, "o", "        M = [row[:] for row in H]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.158965, "o", "        for a in range(4):\r\n\u001b[?2004l\r\u001b[?2004h>             M[a][a] *= (1.0 + lam)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.159007, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.15911, "o", "            delta = solve4(M, gvec)\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.159196, "o", ">         except ValueError:\r\n\u001b[?2004l\r"]
[56.159243, "o", "\u001b[?2004h>             lam *= 10.0\r\n\u001b[?2004l\r"]
[56.159337, "o", "\u001b[?2004h> "]
[56.159395, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.159593, "o", "        # limit step size to avoid wild jumps\r\n\u001b[?2004l\r"]
[56.159613, "o", "\u001b[?2004h>         maxrel = max(abs(delta[i])/max(abs(p[i]), 1e-12) for i in range(4))\r\n\u001b[?2004l\r"]
[56.159628, "o", "\u001b[?2004h> "]
[56.159692, "o", "        if maxrel > 2.0:\r\n\u001b[?2004l\r"]
[56.159708, "o", "\u001b[?2004h> "]
[56.159805, "o", "            scale = 2.0/maxrel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.159901, "o", "            delta = [d*scale for d in delta]\r\n\u001b[?2004l\r"]
[56.159935, "o", "\u001b[?2004h"]
[56.159946, "o", "> "]
[56.160047, "o", "        pnew = [p[i] + delta[i] for i in range(4)]\r\n\u001b[?2004l\r"]
[56.160073, "o", "\u001b[?2004h"]
[56.160084, "o", "> "]
[56.160176, "o", "        # valid parameter checks\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.160187, "o", "> "]
[56.160321, "o", "        if pnew[0] <= 0 or pnew[2] <= 0 or not (lo <= pnew[1] <= hi):\r\n\u001b[?2004l\r"]
[56.160345, "o", "\u001b[?2004h"]
[56.160355, "o", "> "]
[56.160403, "o", "            lam *= 10.0\r\n\u001b[?2004l\r"]
[56.160425, "o", "\u001b[?2004h"]
[56.160437, "o", "> "]
[56.16048, "o", "            continue\r\n\u001b[?2004l\r"]
[56.160503, "o", "\u001b[?2004h"]
[56.160513, "o", "> "]
[56.160592, "o", "        newcost = cost(xs, ys, pnew)\r\n\u001b[?2004l\r"]
[56.160615, "o", "\u001b[?2004h"]
[56.160625, "o", "> "]
[56.160696, "o", "        if newcost < oldcost:\r\n\u001b[?2004l\r"]
[56.160713, "o", "\u001b[?2004h> "]
[56.160758, "o", "            p = pnew\r\n\u001b[?2004l\r"]
[56.160781, "o", "\u001b[?2004h> "]
[56.160895, "o", "            improvement = oldcost - newcost\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.160906, "o", "> "]
[56.160967, "o", "            oldcost = newcost\r\n\u001b[?2004l\r"]
[56.160989, "o", "\u001b[?2004h"]
[56.161, "o", "> "]
[56.16107, "o", "            lam = max(lam/3.0, 1e-12)\r\n\u001b[?2004l\r"]
[56.161091, "o", "\u001b[?2004h"]
[56.161101, "o", "> "]
[56.161205, "o", "            if improvement < 1e-10*max(1.0, oldcost):\r\n\u001b[?2004l\r"]
[56.161227, "o", "\u001b[?2004h"]
[56.161237, "o", "> "]
[56.161282, "o", "                break\r\n\u001b[?2004l\r"]
[56.161303, "o", "\u001b[?2004h"]
[56.161313, "o", "> "]
[56.16135, "o", "        else:\r\n\u001b[?2004l\r"]
[56.161373, "o", "\u001b[?2004h> "]
[56.161429, "o", "            lam *= 10.0\r\n\u001b[?2004l\r"]
[56.16145, "o", "\u001b[?2004h"]
[56.16146, "o", "> "]
[56.16155, "o", "            if lam > 1e12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.1616, "o", "                break\r\n\u001b[?2004l\r"]
[56.161621, "o", "\u001b[?2004h"]
[56.161632, "o", "> "]
[56.161682, "o", "    return p, oldcost\r\n\u001b[?2004l\r"]
[56.161705, "o", "\u001b[?2004h"]
[56.16172, "o", "> \r\n\u001b[?2004l\r"]
[56.161739, "o", "\u001b[?2004h"]
[56.16175, "o", "> "]
[56.161839, "o", "def initial_guess(xs, ys, lo, hi):\r\n\u001b[?2004l\r"]
[56.161852, "o", "\u001b[?2004h> "]
[56.162179, "o", "    im = max(range(len(ys)), key=lambda i: ys[i])"]
[56.162272, "o", "\r\n"]
[56.162384, "o", "\u001b[?2004l\r"]
[56.162481, "o", "\u001b[?2004h"]
[56.162582, "o", "> "]
[56.162737, "o", "    xmax, ymax = xs[im], ys[im]\r\n\u001b[?2004l\r"]
[56.162833, "o", "\u001b[?2004h>     # baseline from edge medians\r\n\u001b[?2004l\r"]
[56.163016, "o", "\u001b[?2004h>     k = max(3, min(30, len(ys)//10))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.163103, "o", "    left = sorted(ys[:k])[k//2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.163213, "o", "    right = sorted(ys[-k:])[k//2]"]
[56.16339, "o", "\r\n"]
[56.163494, "o", "\u001b[?2004l\r\u001b[?2004h"]
[56.163645, "o", "> "]
[56.163662, "o", "    c0 = 0.5*(left+right)"]
[56.163878, "o", "\r\n"]
[56.163964, "o", "\u001b[?2004l\r\u001b[?2004h>     A0 = max(1.0, ymax-c0)"]
[56.163974, "o", "\r\n"]
[56.163985, "o", "\u001b[?2004l\r"]
[56.164211, "o", "\u001b[?2004h>     half = c0 + 0.5*A0\r\n\u001b[?2004l\r\u001b[?2004h>     # crossings nearest maximum"]
[56.16423, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.164252, "o", "> "]
[56.164414, "o", "    li = None"]
[56.164431, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(im, -1, -1):\r\n\u001b[?2004l\r"]
[56.164461, "o", "\u001b[?2004h"]
[56.164541, "o", "> "]
[56.164574, "o", "        if ys[i] <= half:"]
[56.164609, "o", "\r\n\u001b[?2004l\r"]
[56.164635, "o", "\u001b[?2004h"]
[56.164684, "o", "> "]
[56.164696, "o", "            li = i"]
[56.164713, "o", "\r\n"]
[56.165066, "o", "\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     ri = None\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(im, len(ys)):\r\n\u001b[?2004l\r\u001b[?2004h>         if ys[i] <= half:\r\n\u001b[?2004l\r\u001b[?2004h>             ri = i"]
[56.16508, "o", "\r\n"]
[56.16514, "o", "\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[56.16521, "o", "\u001b[?2004h> "]
[56.165282, "o", "    if li is not None and ri is not None and ri > li:\r\n"]
[56.165294, "o", "\u001b[?2004l\r"]
[56.165525, "o", "\u001b[?2004h>         g0 = max(3.0, 0.5*(xs[ri]-xs[li]))\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.165559, "o", "        g0 = 20.0"]
[56.165582, "o", "\r\n"]
[56.16572, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[56.165738, "o", "    return [A0, xmax, g0, c0]"]
[56.165759, "o", "\r\n"]
[56.16578, "o", "\u001b[?2004l\r"]
[56.16587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.166051, "o", "> "]
[56.166126, "o", "windows = [('D', 1250.0, 1450.0), ('G', 1490.0, 1680.0), ('2D', 2570.0, 2820.0)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.16614, "o", "for name, lo, hi in windows:\r\n\u001b[?2004l\r"]
[56.16616, "o", "\u001b[?2004h> "]
[56.166542, "o", "    pairs = [(xx, yy) for xx, yy in zip(x, y) if lo <= xx <= hi]\r\n\u001b[?2004l\r\u001b[?2004h>     xs = [p[0] for p in pairs]\r\n\u001b[?2004l\r\u001b[?2004h>     ys = [p[1] for p in pairs]\r\n\u001b[?2004l\r"]
[56.166566, "o", "\u001b[?2004h>     p0 = initial_guess(xs, ys, lo, hi)\r\n\u001b[?2004l\r"]
[56.166576, "o", "\u001b[?2004h"]
[56.167192, "o", ">     p, ss = fit_peak(xs, ys, p0, lo, hi)\r\n\u001b[?2004l\r\u001b[?2004h>     rms = math.sqrt(ss/len(xs))\r\n\u001b[?2004l\r\u001b[?2004h>     print(name, 'n=', len(xs), 'p0=', [round(v, 4) for v in p0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.167428, "o", "    print('  A=%.6f x0=%.6f gamma=%.6f offset=%.6f rms=%.4f' % (p[0], p[1], p[2], p[3], rms))\r\n\u001b[?2004l\r"]
[56.167692, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[56.201744, "o", "D n= 400 p0= [8170.9845, 1348.0653, 16.2543, 1518.3755]\r\n  A=8212.084984 x0=1348.251997 gamma=16.733462 offset=1260.802829 rms=104.3302\r\n"]
[56.206404, "o", "G n= 380 p0= [7383.356, 1579.6262, 12.7533, 1490.507]\r\n"]
[56.206558, "o", "  A=7516.448109 x0=1580.384158 gamma=12.959746 offset=1303.304975 rms=98.6128\r\n"]
[56.212234, "o", "2D n= 500 "]
[56.212391, "o", "p0= [10189.953, 2690.4185, 20.2554, 1724.535]\r\n  A=10377.901346 x0=2692.409765 gamma=20.910049 offset=1411.603859 rms=99.8998\r\n"]
[56.216137, "o", "\u001b[?2004hroot@j-openenv-6afd8ce229e8b7ccfbbb8363-5wrzliju-7fb4b-sn99b:/app# "]
[64.984019, "i", "python3 - <<'PY'\nimport json\nres = {\n    \"D\": {\"x0\": 1348.251997, \"gamma\": 16.733462, \"amplitude\": 8212.084984, \"offset\": 1260.802829},\n    \"G\": {\"x0\": 1580.384158, \"gamma\": 12.959746, \"amplitude\": 7516.448109, \"offset\": 1303.304975},\n    \"2D\": {\"x0\": 2692.409765, \"gamma\": 20.910049, \"amplitude\": 10377.901346, \"offset\": 1411.603859},\n}\nres[\"ID_IG\"] = res[\"D\"][\"amplitude\"] / res[\"G\"][\"amplitude\"]\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(open('/app/results.json').read())\nPY\n"]
[64.984169, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[64.984237, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[64.984314, "o", "\u001b[?2004h> res = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.984465, "o", "    \"D\": {\"x0\": 1348.251997, \"gamma\": 16.733462, \"amplitude\": 8212.084984, \"offset\": 1260.802829},\r\n\u001b[?2004l\r"]
[64.984523, "o", "\u001b[?2004h> "]
[64.984634, "o", "    \"G\": {\"x0\": 1580.384158, \"gamma\": 12.959746, \"amplitude\": 7516.448109, \"offset\": 1303.304975},\r\n\u001b[?2004l\r"]
[64.984671, "o", "\u001b[?2004h> "]
[64.984807, "o", "    \"2D\": {\"x0\": 2692.409765, \"gamma\": 20.910049, \"amplitude\": 10377.901346, \"offset\": 1411.603859},\r\n\u001b[?2004l\r"]
[64.984816, "o", "\u001b[?2004h> "]
[64.984856, "o", "}\r\n\u001b[?2004l\r"]
[64.98489, "o", "\u001b[?2004h> "]
[64.984969, "o", "res[\"ID_IG\"] = res[\"D\"][\"amplitude\"] / res[\"G\"][\"amplitude\"]\r\n\u001b[?2004l\r"]
[64.985013, "o", "\u001b[?2004h> "]
[64.985065, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[64.98511, "o", "\u001b[?2004h> "]
[64.985145, "o", "    json.dump(res, f, indent=2)\r\n\u001b[?2004l\r"]
[64.985184, "o", "\u001b[?2004h> "]
[64.985239, "o", "print(open('/app/results.json').read())\r\n\u001b[?2004l\r"]
[64.985273, "o", "\u001b[?2004h> "]
[64.985302, "o", "PY\r\n\u001b[?2004l\r"]
[65.012109, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1348.251997,\r\n    \"gamma\": 16.733462,\r\n    \"amplitude\": 8212.084984,\r\n    \"offset\": 1260.802829\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1580.384158,\r\n    \"gamma\": 12.959746,\r\n    \"amplitude\": 7516.448109,\r\n    \"offset\": 1303.304975\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2692.409765,\r\n    \"gamma\": 20.910049,\r\n    \"amplitude\": 10377.901346,\r\n    \"offset\": 1411.603859\r\n  },\r\n  \"ID_IG\": 1.0925486167019582\r\n}\r\n"]
[65.015864, "o", "\u001b[?2004hroot@j-openenv-6afd8ce229e8b7ccfbbb8363-5wrzliju-7fb4b-sn99b:/app# "]
