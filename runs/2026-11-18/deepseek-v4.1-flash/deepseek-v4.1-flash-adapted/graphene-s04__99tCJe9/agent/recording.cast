[67.87737, "i", "python3 - <<'PY'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\ndef lorentz_offset(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D': (1250.0, 1450.0),\n    'G': (1500.0, 1650.0),\n    '2D': (2550.0, 2800.0),\n}\nresults = {}\nfor name, (lo, hi) in windows.items():\n    mask = (x >= lo) & (x <= hi)\n    xw, yw = x[mask], y[mask]\n    x0_0 = xw[np.argmax(yw)]\n    a0 = yw.max() - np.percentile(yw, 5)\n    o0 = np.percentile(yw, 5)\n    popt, _ = curve_fit(\n        lorentz_offset, xw, yw,\n        p0=[x0_0, 20.0, a0, o0],\n        bounds=([lo, 0.1, 0.0, -np.inf], [hi, 200.0, np.inf, np.inf]),\n        maxfev=20000,\n    )\n    x0, gamma, amplitude, offset = map(float, popt)\n    results[name] = {\n        'x0': x0,\n        'gamma': gamma,\n        'amplitude': amplitude,\n        'offset': offset,\n    }\n\nresults['ID_IG'] = results['D']['amplitude'] / results["]
[67.877424, "i", "'G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\nprint(json.dumps(results, indent=2))\nPY\n"]
[67.877566, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r'G']['amplitude']\r\nwith open('/app/results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\n    f.write('\\n')\r\n\r\nprint(json.dumps(results, indent=2))\r\nPY\r\n\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
