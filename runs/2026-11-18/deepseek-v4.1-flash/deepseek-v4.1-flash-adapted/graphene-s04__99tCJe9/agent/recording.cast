[93.721927, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)\n\ndef lorentz_offset(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit(name, center, half_width):\n    lo, hi = center - half_width, center + half_width\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    x0_0 = xw[np.argmax(yw)]\n    a0 = max(yw.max() - np.percentile(yw, 5), 1.0)\n    o0 = np.percentile(yw, 5)\n    popt, _ = curve_fit(\n        lorentz_offset, xw, yw,\n        p0=[x0_0, 20.0, a0, o0],\n        bounds=([lo, 0.1, 0.0, -np.inf], [hi, 200.0, np.inf, np.inf]),\n        maxfev=20000,\n    )\n    return popt\n\nfor name, c in [('D', 1346.0), ('G', 1585.0), ('2D', 2678.5)]:\n    print(name)\n    for hw in [30, 50, 75, 100, 125, 150]:\n        if name == '2D' and hw < 50:\n            pass\n        try:\n            x0, g, a, o = fit(name, c, hw)\n            print(f'  hw={hw:3d} x0={x0:9.4f} gamma={g:8."]
[93.722045, "i", "4f} amp={a:10.3f} off={o:9.3f}')\n        except Exception as e:\n            print(f'  hw={hw:3d} failed {e}')\nPY\n"]
