[40.306488, "i", "python3 - <<'PY'\nimport numpy as np\nx, y = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1, unpack=True)\nprint('n', len(x), 'range', x.min(), x.max())\nfor name, lo, hi in [('D', 1250, 1450), ('G', 1500, 1650), ('2D', 2550, 2800)]:\n    m = (x >= lo) & (x <= hi)\n    imax = np.argmax(y[m])\n    xm = x[m][imax]\n    ym = y[m][imax]\n    print(name, 'local max', xm, ym, 'points', m.sum())\n    idx = np.where(m)[0][imax]\n    for j in range(max(0, idx-3), min(len(x), idx+4)):\n        print(f'  {x[j]:.3f} {y[j]:.3f}')\nPY\n"]
