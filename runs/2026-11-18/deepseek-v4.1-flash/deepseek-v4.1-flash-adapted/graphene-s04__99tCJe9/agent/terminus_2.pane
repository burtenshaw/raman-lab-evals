[?2004l[?2004h> def lorentz_offset(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit(name, center, half_width):
[?2004l[?2004h>     lo, hi = center - half_width, center + half_width
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     x0_0 = xw[np.argmax(yw)]
[?2004l[?2004h>     a0 = max(yw.max() - np.percentile(yw, 5), 1.0)
[?2004l[?2004h>     o0 = np.percentile(yw, 5)
[?2004l[?2004h>     popt, _ = curve_fit(
[?2004l[?2004h>         lorentz_offset, xw, yw,
[?2004l[?2004h>         p0=[x0_0, 20.0, a0, o0],
[?2004l[?2004h>         bounds=([lo, 0.1, 0.0, -np.inf], [hi, 200.0, np.inf, np.inf]),
[?2004l[?2004h>         maxfev=20000,
[?2004l[?2004h>     )
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
