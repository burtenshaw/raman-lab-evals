t is None or r[3]<best[3]): best=(r[3],x0,gamma)+r[:3]\n    # pattern search over x0,gamma\n    sx=sg=0.1\n    while sx>1e-6 or sg>1e-6:\n        sse0,x0,gamma,A,c,b=best; improved=False\n        for dx in (-sx,0,sx):\n            for dg in (-sg,0,sg):\n                nx=x0+dx; ng=gamma+dg\n                if ng<=0.01: continue\n                r=fit(xw,yw,nx,ng,kind,linear)\n                if r and r[3]<sse0-1e-12:\n                    sse0=r[3]; best=(r[3],nx,ng,r[0],r[1],r[2]); improved=True\n        if not improved: sx*=0.5; sg*=0.5\n    sse,x0,gamma,A,c,b=best\n    return x0,gamma,A,c,b,math.sqrt(sse/len(xw)),len(xw)\n\nfor name,center in [('G',1580),('2D',2670)]:\n    print('\\n',name)\n    for w in [60,80,100,120]:\n        xw=[x for x in xs if abs(x-center)<=w]\n        yw=[yy for x,yy in zip(xs,ys) if abs(x-center)<=w]\n        for lin in [False,True]:\n            x0,g,A,c,b,rmse,n=optimize(xw,yw,center,'lor',lin)\n            print(f'  w={w:3d} linear={int(lin)} x0={x0:9.4f} gamma={g:8.4f} A={A:10.1f} offset={c:9.1f} slope={b:8.2f} rmse={rmse:7.2f} n={n}')\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
