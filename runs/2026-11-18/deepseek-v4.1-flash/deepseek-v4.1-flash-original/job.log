,5000])\n\nprint('\\nRAW ABSOLUTE INTERPRETATION')\n# 2D-like around 15800-16700\nfit_one(xr,yr,15500,16900,[16245,150,2000],1,[15000,1,0],[17000,1000,10000])\n# G-like around 17000-18000\nfit_one(xr,yr,16800,18100,[17560,100,1000],2,[16500,1,0],[18200,1000,20000])\n# two-peak global-ish in 15500-18100, with linear bg\nfit_two(xr,yr,15500,18100,[16245,150,2000,17560,100,1000],1,[15000,1,0,16500,1,0],[17000,1000,10000,18200,1000,20000])\nPY\npython3 /tmp/compare_fits.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
