Sending keys: ["python3 - <<'PY'\nimport math\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\ndata=sorted((1e7/v, yy) for v,yy in zip(raw,y))\nxs=[a for a,b in data]; ys=[b for a,b in data]\n\ndef solve(cols, y):\n    m=len(cols); n=len(y)\n    A=[[sum(cols[i][k]*cols[j][k] for k in range(n)) for j in range(m)] for i in range(m)]\n    b=[sum(cols[i][k]*y[k] for k in range(n)) for i in range(m)]\n    for i in range(m):\n        p=max(range(i,m), key=lambda r: abs(A[r][i]))\n        A[i],A[p]=A[p],A[i]; b[i],b[p]=b[p],b[i]\n        piv=A[i][i]\n        if abs(piv)<1e-15: return None\n        for j in range(i+1,m):\n            f=A[j][i]/piv\n            for k in range(i,m): A[j][k]-=f*A[i][k]\n            b[j]-=f*b[i]\n    x=[0.0]*m\n    for i in range(m-1,-1,-1):\n        x[i]=(b[i]-sum(A[i][j]*x[j] for j in range(i+1,m)))/A[i][i]\n    return x\n\ndef fit_for(x,y,x0,g,degree):\n    f=[g*g/((xi-x0)**2+g*g) for xi in x]\n    cols=[f]+[[ (xi-x0)**k for xi in x] for k in range(degree+1)]\n    coef=solve(cols,y)\n    if coef is None: return None\n    A=coef[0]\n    if A<=0: return None\n    pred=[]\n    for i,xi in enumerate(x):\n        v=coef[0]*f[i]\n        for k in range(degree+1): v+=coef[1+k]*((xi-x0)**k)\n        pred.append(v)\n    sse=sum((yi-pi)**2 for yi,pi in zip(y,pred))\n    return A,coef[1],sse\n\ndef opt(x,y,c0,degree):\n    best=None\n    x0=c0-2\n    while x0<=c0+2+1e-9:\n        g=4\n        while g<=40+1e-9:\n            r=fit_for(x,y,x0,g,degree)\n            if r and (best is None or r[2]<best[0]): best=(r[2],x0,g,r[0],r[1])\n            g+=0.2\n        x0+=0.2\n    sx=sg=0.05\n    while sx>1e-6 or sg>1e-6:\n        s0,x0,g,A,off=best; imp=False\n        for dx in (-sx,0,sx):\n            for dg in (-sg,0,sg):\n                nx=x0+dx; ng=g+dg\n                if ng<=0.01: continue\n                r=fit_for(x,y,nx,ng,degree)\n                if r and r[2]<s0-1e-12:\n                    best=(r[2],nx,ng,r[0],r[1]); s0=r[2]; imp=True\n        if not imp: sx*=.5; sg*=.5\n    sse,x0,g,A,off=best\n    return x0,g,A,off,math.sqrt(sse/len(x)),len(x)\n\nfor name,c0,window in [('G',1580,(1500,1660)),('2D',2670,(2500,2850))]:\n    lo,hi=window\n    x=[xi for xi in xs if lo<=xi<=hi]\n    yw=[yy for xi,yy in zip(xs,ys) if lo<=xi<=hi]\n    print('\\n'+name)\n    for deg in [0,1,2,3]:\n        x0,g,A,off,rmse,n=opt(x,yw,c0,deg)\n        print(f'poly_deg={deg}: x0={x0:.6f} gamma={g:.6f} amplitude={A:.6f} offset={off:.6f} rmse={rmse:.6f} n={n}')\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
