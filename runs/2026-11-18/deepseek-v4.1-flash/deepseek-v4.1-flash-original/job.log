Sending keys: ["python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]), float(p[1])))\n# ensure ascending for local max detection\narr=sorted(arr)\nxs=[x for x,y in arr]; ys=[y for x,y in arr]\n# coarse bins of 200 cm^-1\nprint('coarse max:')\nlo=min(xs); hi=max(xs)\nb=lo\nwhile b<hi:\n    vals=[y for x,y in arr if b<=x<b+200]\n    if vals:\n        print(f'{b:8.1f}-{b+200:8.1f}: n={len(vals):4d} max={max(vals):10.2f} mean={sum(vals)/len(vals):10.2f}')\n    b+=200\n# local maxima with simple window\nprint('\\nlocal maxima (prominence > 100):')\npeaks=[]\nfor i in range(5,len(arr)-5):\n    if ys[i]==max(ys[i-5:i+6]):\n        base=min(ys[max(0,i-30):i]+ys[i+1:min(len(ys),i+31)])\n        prom=ys[i]-base\n        if prom>100:\n            peaks.append((xs[i],ys[i],prom))\nfor x,y,p in sorted(peaks,key=lambda t:t[1],reverse=True)[:50]:\n    print(f'x={x:10.2f} y={y:10.2f} prom={p:10.2f}')\n# print values around likely 2D peak sorted\nfor center in [1350,1580,2450,2600,2700,2900,3200]:\n    print('\\nregion',center)\n    reg=[(x,y) for x,y in arr if center-50<x<center+50]\n    if reg:\n        for x,y in reg:\n            print(f'{x:9.2f} {y:10.2f}')\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
