for name,center in [('G',1580.0),('2D',2670.0)]:\n        for w in [50,70,90,110,130]:\n            x0,g,A,c,rmse,n=fit_peak(xs,ys,kind,center,w)\n            print(f'{name:2s} w={w:3d} x0={x0:10.4f} gamma={g:9.4f} A={A:11.2f} off={c:10.2f} rmse={rmse:8.2f} n={n}')\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
