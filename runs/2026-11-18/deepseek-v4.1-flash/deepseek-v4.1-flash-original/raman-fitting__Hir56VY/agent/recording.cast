[416.667051, "i", "python3 - <<'PY'\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\nw=[1e7/v for v in raw]\ndiffs=[w[i+1]-w[i] for i in range(len(w)-1)]\nprint('w first last',w[0],w[-1])\nprint('w diff min max mean',min(diffs),max(diffs),sum(diffs)/len(diffs))\nfor i in [0,1,2,10,100,500,1000,2000,3000]:\n    print(i,w[i],diffs[i])\n# background at selected wavenumbers: nearest y\nprint('\\nselected points:')\nfor target in [1200,1300,1400,1450,1500,1550,1600,1650,1700,1800,1900,2000,2200,2400,2500,2550,2600,2625,2700,2750,2800,2900,3000]:\n    i=min(range(len(w)), key=lambda j: abs(w[j]-target))\n    print(f'{target:5.0f} -> {w[i]:9.3f} {y[i]:10.1f}')\nPY\n"]
