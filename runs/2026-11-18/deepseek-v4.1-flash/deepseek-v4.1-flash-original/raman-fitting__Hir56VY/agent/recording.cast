[696.979052, "i", "python3 - <<'PY'\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\ndata=sorted((1e7/v, yy) for v,yy in zip(raw,y))\nxs=[a for a,b in data]; ys=[b for a,b in data]\n\ndef linfit(points):\n    n=len(points); sx=sum(p[0] for p in points); sy=sum(p[1] for p in points)\n    sxx=sum(p[0]*p[0] for p in points); sxy=sum(p[0]*p[1] for p in points)\n    d=n*sxx-sx*sx\n    m=(n*sxy-sx*sy)/d; c=(sy-m*sx)/n\n    return m,c\n\ndef baseline(name,center,left,right):\n    pts=[]\n    for x,yv in zip(xs,ys):\n        if left[0]<=x<=left[1] or right[0]<=x<=right[1]:\n            pts.append((x,yv))\n    m,c=linfit(pts)\n    val=m*center+c\n    print(f'{name}: nbase={len(pts)} slope={m:.6f} intercept={c:.3f} baseline@center={val:.3f}')\n    # print off-peak sampled values\n    for x,yv in pts[::max(1,len(pts)//15)]:\n        print(f'   {x:9.3f} {yv:10.1f}')\n\nbaseline("]
[696.979233, "i", "'G',1580,(1380,1530),(1630,1800))\nbaseline('2D',2670,(2350,2550),(2780,3000))\nPY\n"]
