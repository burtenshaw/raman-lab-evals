[601.163862, "o", "04h>     return s\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # initial from local fits\r\n\u001b[?2004l\r\u001b[?2004h> p=[1580.34,8.5,8300,2670.13,18.5,12500,900.0]\r\n\u001b[?2004l\r\u001b[?2004h> print('initial sse',sse(p))\r\n\u001b[?2004l\r\u001b[?2004h> # coordinate descent with decreasing step\r\n\u001b[?2004l\r\u001b[?2004h> steps=[5,2,1,0.5,0.2,0.1,0.05,0.02,0.01,0.005,0.002,0.001]\r\n\u001b[?2004l\r\u001b[?2004h> for st in steps:\r\n\u001b[?2004l\r\u001b[?2004h>     improved=True\r\n\u001b[?2004l\r\u001b[?2004h>     while improved:\r\n\u001b[?2004l\r\u001b[?2004h>         improved=False\r\n\u001b[?2004l\r\u001b[?2004h>         for k in range(7):\r\n\u001b[?2004l\r\u001b[?2004h>             best=sse(p); bp=p[:]\r\n\u001b[?2004l\r\u001b[?2004h>             for d in (-st,st):\r\n\u001b[?2004l\r\u001b[?2004h>                 q=p[:]; q[k]+=d\r\n\u001b[?2004l\r\u001b[?2004h>                 v=sse(q)\r\n\u001b[?2004l\r\u001b[?2004h>                 if v<best-1e-9:\r\n\u001b[?2004l\r\u001b[?2004h>                     best=v; bp=q; improved=True\r\n\u001b[?2004l\r\u001b[?2004h>             p=bp\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'step {st:.4f} sse {sse(p):.3f} p {[round(v,4) for v in p]}')\r\n\u001b[?2004l\r\u001b[?2004h> print('f"]
