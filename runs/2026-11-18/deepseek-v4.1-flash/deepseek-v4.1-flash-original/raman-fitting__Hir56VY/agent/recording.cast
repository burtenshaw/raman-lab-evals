[188.429199, "i", "python3 - <<'PY'\n# Parse and convert x to wavenumber (cm^-1)\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\nwn=[1e7/v for v in raw]\ndata=sorted(zip(wn,y))\nwn=[a for a,b in data]; y=[b for a,b in data]\nprint('wavenumber range', wn[0], wn[-1])\n# simple smoothing\nm=15\nsm=[]\nfor i in range(len(y)):\n    lo=max(0,i-m//2); hi=min(len(y),i+m//2+1)\n    sm.append(sum(y[lo:hi])/(hi-lo))\n# local maxima in windows\nfor lo,hi in [(1400,1800),(2400,2900),(450,600),(900,1050)]:\n    print('\\nwindow',lo,hi)\n    inds=[i for i,x in enumerate(wn) if lo<=x<=hi]\n    loc=[i for i in inds if 0<i<len(wn)-1 and sm[i]>=sm[i-1] and sm[i]>sm[i+1]]\n    for i in loc:\n        print(f'i={i} wn={wn[i]:.4f} y={y[i]:.2f} sm={sm[i]:.2f}')\n# print detailed points around G and 2D peaks at intervals\nfor center,name in [(1580,'G'),(2670,'2D')]:\n    print('\\nDETAIL',n"]
[188.429818, "o", "python3 - <<'PY'"]
[188.429864, "i", "ame,'center',center)\n    inds=[i for i,x in enumerate(wn) if abs(x-center)<80]\n    for j,i in enumerate(inds):\n        if j%5==0:\n            print(f'wn={wn[i]:10.4f} y={y[i]:12.4f}')\nPY\n"]
