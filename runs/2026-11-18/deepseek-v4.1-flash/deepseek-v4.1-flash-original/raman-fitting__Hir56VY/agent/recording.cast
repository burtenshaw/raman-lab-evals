[247.364308, "i", "python3 - <<'PY'\nimport math\n\n# Load and convert x to Raman shift\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\nwn=[1e7/v for v in raw]\ndata=sorted(zip(wn,y))\nxs=[a for a,b in data]; ys=[b for a,b in data]\n\ndef fit_const(x,y,x0,gamma,kind):\n    n=len(x)\n    if kind=='lor':\n        f=[gamma*gamma/((xi-x0)**2+gamma*gamma) for xi in x]\n    else:\n        s2=gamma*gamma/(8*math.log(2))  # gamma=FWHM for Gaussian\n        f=[math.exp(-0.5*(xi-x0)**2/s2) for xi in x]\n    sf=sum(f); sy=sum(y)\n    sff=sum(v*v for v in f); sfy=sum(fi*yi for fi,yi in zip(f,y))\n    det=n*sff-sf*sf\n    A=(n*sfy-sf*sy)/det\n    c=(sy-A*sf)/n\n    sse=sum((yi-c-A*fi)**2 for xi,fi,yi in zip(x,f,y))\n    return A,c,sse\n\ndef fit_peak(x,y,kind,center,gamma0,window):\n    xw=[]; yw=[]\n    for xi,yi in zip(x,y):\n        if abs(xi-center)<=window:\n            xw.appe"]
[247.364863, "o", "python3 - <<'PY'"]
[247.364898, "i", "nd(xi); yw.append(yi)\n    best=None\n    # coarse grid\n    x0=center-5.0\n    while x0<=center+5.0+1e-9:\n        gamma=4.0\n        while gamma<=60.0+1e-9:\n            A,c,sse=fit_const(xw,yw,x0,gamma,kind)\n            if A>0 and (best is None or sse<best[0]):\n                best=(sse,x0,gamma,A,c)\n            gamma+=0.5\n        x0+=0.5\n    # pattern search\n    stepx=0.25; stepg=0.25\n    while stepx>1e-5 or stepg>1e-5:\n        sse0,x0,gamma,A,c=best\n        improved=False\n        for dx in (-stepx,0.0,stepx):\n            for dg in (-stepg,0.0,stepg):\n                nx=x0+dx; ng=gamma+dg\n                if ng<=0.01: continue\n                A2,c2,sse2=fit_const(xw,yw,nx,ng,kind)\n                if A2>0 and sse2<sse0-1e-12:\n                    best=(sse2,nx,ng,A2,c2); sse0=sse2; improved=True\n        if not improved:\n            stepx*=0.5; stepg*=0.5\n    sse,x0,gamma,A,c=best\n    return x0,gamma,A,c,sse,math.sqrt(sse/len(xw)),len(xw)\n\nfor kind in ['lor','gauss']:\n    print('\\nMODEL',kind)\n    for name,center,ga"]
