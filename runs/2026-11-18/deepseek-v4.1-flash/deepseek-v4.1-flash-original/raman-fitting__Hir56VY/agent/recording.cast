[47.081833, "i", "python3 - <<'PY'\n# Parse data\nxs=[]; ys=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        xs.append(float(a.replace(',','.')))\n        ys.append(float(b.replace(',','.')))\nprint('n',len(xs),'x first/last',xs[0],xs[-1])\n# print every 100th point\nfor i in range(0,len(xs),100):\n    print(i, f'{xs[i]:.3f}', f'{ys[i]:.3f}')\nPY\n"]
