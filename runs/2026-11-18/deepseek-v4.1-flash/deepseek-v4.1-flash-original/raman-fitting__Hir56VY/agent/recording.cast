[303.91897, "i", "python3 - <<'PY'\nimport math\n\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\ndata=sorted((1e7/v, yy) for v,yy in zip(raw,y))\nxs=[a for a,b in data]; ys=[b for a,b in data]\n\ndef profile(x,x0,gamma,kind):\n    if kind=='lor':\n        return gamma*gamma/((x-x0)**2+gamma*gamma)\n    return math.exp(-0.5*((x-x0)/gamma)**2)  # gamma = sigma for gaussian\n\ndef linear_peak_fit(x,y,x0,gamma,kind):\n    f=[profile(xi,x0,gamma,kind) for xi in x]\n    n=len(x); sf=sum(f); sy=sum(y); sff=sum(v*v for v in f); sfy=sum(fi*yi for fi,yi in zip(f,y))\n    det=n*sff-sf*sf\n    A=(n*sfy-sf*sy)/det\n    c=(sy-A*sf)/n\n    sse=sum((yi-c-A*fi)**2 for xi,fi,yi in zip(x,f,y))\n    return A,c,sse\n\ndef fit_peak(x,y,kind,center,window):\n    xw=[xi for xi in x if abs(xi-center)<=window]\n    yw=[yi for xi,yi in zip(x,y) if abs(xi-center)<=window]\n    best=None\n    "]
[303.919409, "i", "x0=center-3.0\n    while x0<=center+3.0+1e-9:\n        gamma=2.0 if kind=='lor' else 2.0\n        while gamma<=30.0+1e-9:\n            A,c,sse=linear_peak_fit(xw,yw,x0,gamma,kind)\n            if A>0 and (best is None or sse<best[0]): best=(sse,x0,gamma,A,c)\n            gamma+=0.25\n        x0+=0.25\n    sx=0.1; sg=0.1\n    while sx>1e-6 or sg>1e-6:\n        sse0,x0,gamma,A,c=best; improved=False\n        for dx in (-sx,0,sx):\n            for dg in (-sg,0,sg):\n                nx=x0+dx; ng=gamma+dg\n                if ng<=0.01: continue\n                A2,c2,sse2=linear_peak_fit(xw,yw,nx,ng,kind)\n                if A2>0 and sse2<sse0-1e-12:\n                    best=(sse2,nx,ng,A2,c2); sse0=sse2; improved=True\n        if not improved:\n            sx*=0.5; sg*=0.5\n    sse,x0,gamma,A,c=best\n    return x0,gamma,A,c,math.sqrt(sse/len(xw)),len(xw)\n\nfor kind in ['lor','gauss']:\n    print('\\nMODEL',kind)\n    for name,center in [('G',1580.0),('2D',2670.0)]:\n        for w in [50,70,90,110,130]:\n            x0,g,A,c,rmse,n=fit_peak"]
