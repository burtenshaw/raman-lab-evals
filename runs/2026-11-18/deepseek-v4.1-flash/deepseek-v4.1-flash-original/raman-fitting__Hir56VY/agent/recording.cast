[601.157892, "i", "python3 - <<'PY'\nimport math\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\ndata=sorted((1e7/v, yy) for v,yy in zip(raw,y))\nxs=[a for a,b in data]; ys=[b for a,b in data]\n\n# select broad region but avoid strong Si peaks at ~520 and ~960\nx=[]; yv=[]\nfor xi,yi in zip(xs,ys):\n    if 1200<=xi<=3000:\n        x.append(xi); yv.append(yi)\nprint('points',len(x))\n\ndef lor(xi,x0,g):\n    return g*g/((xi-x0)**2+g*g)\n\ndef sse(params):\n    x01,g1,A1,x02,g2,A2,c=params\n    if g1<=0 or g2<=0 or A1<=0 or A2<=0: return 1e99\n    s=0.0\n    for xi,yi in zip(x,yv):\n        m=c+A1*lor(xi,x01,g1)+A2*lor(xi,x02,g2)\n        d=yi-m; s+=d*d\n    return s\n\n# initial from local fits\np=[1580.34,8.5,8300,2670.13,18.5,12500,900.0]\nprint('initial sse',sse(p))\n# coordinate descent with decreasing step\nsteps=[5,2,1,0.5,0.2,0.1,0.05,0.02,0.01,0.005,0.002,0.001]\nf"]
[601.15794, "i", "or st in steps:\n    improved=True\n    while improved:\n        improved=False\n        for k in range(7):\n            best=sse(p); bp=p[:]\n            for d in (-st,st):\n                q=p[:]; q[k]+=d\n                v=sse(q)\n                if v<best-1e-9:\n                    best=v; bp=q; improved=True\n            p=bp\n    print(f'step {st:.4f} sse {sse(p):.3f} p {[round(v,4) for v in p]}')\nprint('final',p,'rmse',math.sqrt(sse(p)/len(x)))\nPY\n"]
