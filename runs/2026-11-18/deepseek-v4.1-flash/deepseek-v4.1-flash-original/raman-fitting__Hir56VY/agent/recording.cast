[47.557292, "o", "    if sm[i]>=sm[i-2] and sm[i]>=sm[i-1] and sm[i]>=sm[i+1] and sm[i]>=sm[i+2] and sm[i]>max(sm[max(0,i-100):i]+sm[i+1:min(len(sm),i+101)]):\r\n\u001b[?2004l\r"]
[47.557443, "o", "\u001b[?2004h>         peaks.append(i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
