[87.83604, "i", "python3 - <<'PY'\nxs=[]; ys=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        xs.append(float(a.replace(',','.')))\n        ys.append(float(b.replace(',','.')))\n# simple smoothing\nm=9\nsm=[]\nfor i in range(len(ys)):\n    lo=max(0,i-m//2); hi=min(len(ys),i+m//2+1)\n    sm.append(sum(ys[lo:hi])/(hi-lo))\n# local maxima, require prominence over 100-point window\npeaks=[]\nfor i in range(1,len(sm)-1):\n    if sm[i]>=sm[i-1] and sm[i]>sm[i+1]:\n        left=max(sm[max(0,i-150):i]) if i>0 else -1\n        right=max(sm[i+1:min(len(sm),i+151)]) if i+1<len(sm) else -1\n        prom=sm[i]-max(left,right)\n        if prom>200:\n            peaks.append((i,xs[i],ys[i],sm[i],prom))\nfor p in peaks:\n    print(f'idx={p[0]:4d} x={p[1]:12.4f} y={p[2]:12.4f} sm={p[3]:12.4f} prom={p[4]:12.4f}')\nPY\n"]
