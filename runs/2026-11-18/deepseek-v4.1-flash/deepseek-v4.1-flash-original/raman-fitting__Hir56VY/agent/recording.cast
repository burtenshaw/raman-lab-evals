[874.929043, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def opt(x,y,c0,degree):\r\n\u001b[?2004l\r\u001b[?2004h>     best=None\r\n\u001b[?2004l\r\u001b[?2004h>     x0=c0-2\r\n\u001b[?2004l\r\u001b[?2004h>     while x0<=c0+2+1e-9:\r\n\u001b[?2004l\r\u001b[?2004h>         g=4\r\n\u001b[?2004l\r\u001b[?2004h>         while g<=40+1e-9:\r\n\u001b[?2004l\r\u001b[?2004h>             r=fit_for(x,y,x0,g,degree)\r\n\u001b[?2004l\r\u001b[?2004h>             if r and (best is None or r[2]<best[0]): best=(r[2],x0,g,r[0],r[1])\r\n\u001b[?2004l\r\u001b[?2004h>             g+=0.2\r\n\u001b[?2004l\r\u001b[?2004h>         x0+=0.2\r\n\u001b[?2004l\r\u001b[?2004h>     sx=sg=0.05\r\n\u001b[?2004l\r\u001b[?2004h>     while sx>1e-6 or sg>1e-6:\r\n\u001b[?2004l\r\u001b[?2004h>         s0,x0,g,A,off=best; imp=False\r\n\u001b[?2004l\r\u001b[?2004h>         for dx in (-sx,0,sx):\r\n\u001b[?2004l\r\u001b[?2004h>             for dg in (-sg,0,sg):\r\n\u001b[?2004l\r\u001b[?2004h>                 nx=x0+dx; ng=g+dg\r\n\u001b[?2004l\r\u001b[?2004h>                 if ng<=0.01: continue\r\n\u001b[?2004l\r\u001b[?2004h>                 r=fit_for(x,y,nx,ng,degree)\r\n\u001b[?2004l\r\u001b[?2004h>                 if r and r[2]<s0-1e-12:\r\n\u001b[?2004l\r\u001b[?2004h>                     best=(r[2],nx,"]
[874.929059, "o", "ng,r[0],r[1]); s0=r[2]; imp=True\r\n\u001b[?2004l\r\u001b[?2004h>         if not imp: sx*=.5; sg*=.5\r\n\u001b[?2004l\r\u001b[?2004h>     sse,x0,g,A,off=best\r\n\u001b[?2004l\r\u001b[?2004h>     return x0,g,A,off,math.sqrt(sse/len(x)),len(x)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for name,c0,window in [('G',1580,(1500,1660)),('2D',2670,(2500,2850))]:\r\n\u001b[?2004l\r\u001b[?2004h>     lo,hi=window\r\n\u001b[?2004l\r\u001b[?2004h>     x=[xi for xi in xs if lo<=xi<=hi]\r\n\u001b[?2004l\r\u001b[?2004h>     yw=[yy for xi,yy in zip(xs,ys) if lo<=xi<=hi]\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n'+name)\r\n\u001b[?2004l\r\u001b[?2004h>     for deg in [0,1,2,3]:\r\n\u001b[?2004l\r\u001b[?2004h>         x0,g,A,off,rmse,n=opt(x,yw,c0,deg)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'poly_deg={deg}: x0={x0:.6f} gamma={g:.6f} amplitude={A:.6f} offset={off:.6f} rmse={rmse:.6f} n={n}')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
