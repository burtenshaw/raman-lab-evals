[524.60785, "i", "python3 - <<'PY'\nimport math\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\ndata=sorted((1e7/v, yy) for v,yy in zip(raw,y))\nxs=[a for a,b in data]; ys=[b for a,b in data]\n\ndef fit_const(x,y,x0,g):\n    f=[g*g/((xi-x0)**2+g*g) for xi in x]\n    n=len(x); sf=sum(f); sy=sum(y); sff=sum(v*v for v in f); sfy=sum(fi*yi for fi,yi in zip(f,y))\n    det=n*sff-sf*sf\n    A=(n*sfy-sf*sy)/det\n    c=(sy-A*sf)/n\n    sse=sum((yi-c-A*fi)**2 for xi,fi,yi in zip(x,f,y))\n    return A,c,sse\n\ndef opt(x,y,c0):\n    best=None\n    for x0 in [c0-2+0.1*i for i in range(41)]:\n        for g in [4+0.1*i for i in range(261)]:\n            A,c,sse=fit_const(x,y,x0,g)\n            if A>0 and (best is None or sse<best[0]): best=(sse,x0,g,A,c)\n    sx=sg=0.05\n    while sx>1e-6 or sg>1e-6:\n        s0,x0,g,A,c=best; imp=False\n        for dx in (-sx,0,sx):\n            "]
[524.607909, "i", "for dg in (-sg,0,sg):\n                nx=x0+dx; ng=g+dg\n                if ng<=0.01: continue\n                A2,c2,sse=fit_const(x,y,nx,ng)\n                if A2>0 and sse<s0-1e-12:\n                    best=(sse,nx,ng,A2,c2); s0=sse; imp=True\n        if not imp: sx*=.5; sg*=.5\n    sse,x0,g,A,c=best\n    return x0,g,A,c,math.sqrt(sse/len(x)),len(x)\n\nfor name,c0,windows in [('G',1580,[(1500,1660),(1500,1700),(1520,1640),(1500,1650)]),('2D',2670,[(2550,2800),(2600,2750),(2620,2720),(2600,2800)])]:\n    print('\\n'+name)\n    for lo,hi in windows:\n        x=[xi for xi in xs if lo<=xi<=hi]\n        yw=[yy for xi,yy in zip(xs,ys) if lo<=xi<=hi]\n        x0,g,A,c,rmse,n=opt(x,yw,c0)\n        print(f'{lo}-{hi}: x0={x0:.4f} gamma={g:.4f} A={A:.2f} offset={c:.2f} rmse={rmse:.2f} n={n}')\nPY\n"]
