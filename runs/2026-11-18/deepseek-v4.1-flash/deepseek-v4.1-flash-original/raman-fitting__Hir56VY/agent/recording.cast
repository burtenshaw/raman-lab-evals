[27.509916, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata=np.loadtxt('graphene.dat',delimiter='\\t',decimal=',')\nx=data[:,0]\ny=data[:,1]\nprint('shape',data.shape)\nprint('x range',x[0],x[-1])\nprint('y range',y.min(),y.max())\npeaks,props=find_peaks(y,prominence=500)\nprint('num peaks',len(peaks))\norder=np.argsort(props['prominences'])[::-1][:15]\nfor i in order:\n    p=peaks[i]\n    print(x[p], y[p], props['prominences'][i])\nPY\n"]
