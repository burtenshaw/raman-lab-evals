[303.921377, "o", "    f=[profile(xi,x0,gamma,kind) for xi in x]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[303.921469, "o", "    n=len(x); sf=sum(f); sy=sum(y); sff=sum(v*v for v in f); sfy=sum(fi*yi for fi,yi in zip(f,y))\r\n\u001b[?2004l\r"]
[303.921484, "o", "\u001b[?2004h> "]
[303.921652, "o", "    det=n*sff-sf*sf\r\n\u001b[?2004l\r\u001b[?2004h>     A=(n*sfy-sf*sy)/det\r\n\u001b[?2004l\r\u001b[?2004h>     c=(sy-A*sf)/n\r\n\u001b[?2004l\r\u001b[?2004h"]
[303.921701, "o", "> "]
[303.921754, "o", "    sse=sum((yi-c-A*fi)**2 for xi,fi,yi in zip(x,f,y))\r\n\u001b[?2004l\r"]
[303.921831, "o", "\u001b[?2004h> "]
[303.921892, "o", "    return A,c,sse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[303.921907, "o", "> def fit_peak(x,y,kind,center,window):"]
[303.921918, "o", "\r\n\u001b[?2004l\r"]
[303.921945, "o", "\u001b[?2004h> "]
[303.922021, "o", "    xw=[xi for xi in x if abs(xi-center)<=window]\r\n\u001b[?2004l\r"]
[303.92209, "o", "\u001b[?2004h> "]
[303.922135, "o", "    yw=[yi for xi,yi in zip(x,y) if abs(xi-center)<=window]\r\n\u001b[?2004l\r"]
[303.922176, "o", "\u001b[?2004h> "]
[303.922209, "o", "    best=None\r\n\u001b[?2004l\r"]
[303.922245, "o", "\u001b[?2004h> "]
[303.922281, "o", "    x0=center-3.0\r\n\u001b[?2004l\r"]
[303.922299, "o", "\u001b[?2004h> "]
[303.922327, "o", "    while x0<=center+3.0+1e-9:\r\n\u001b[?2004l\r"]
[303.922377, "o", "\u001b[?2004h> "]
[303.922436, "o", "        gamma=2.0 if kind=='lor' else 2.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[303.922501, "o", "        while gamma<=30.0+1e-9:\r\n\u001b[?2004l\r\u001b[?2004h"]
[303.92252, "o", "> "]
[303.922597, "o", "            A,c,sse=linear_peak_fit(xw,yw,x0,gamma,kind)\r\n\u001b[?2004l\r"]
[303.922656, "o", "\u001b[?2004h> "]
[303.922733, "o", "            if A>0 and (best is None or sse<best[0]): best=(sse,x0,gamma,A,c)\r\n\u001b[?2004l\r"]
[303.922786, "o", "\u001b[?2004h> "]
[303.922798, "o", "            gamma+=0.25\r\n\u001b[?2004l\r"]
[303.922845, "o", "\u001b[?2004h> "]
[303.922879, "o", "        x0+=0.25\r\n\u001b[?2004l\r\u001b[?2004h> "]
[303.922895, "o", "    sx=0.1; sg=0.1\r\n\u001b[?2004l\r"]
[303.922952, "o", "\u001b[?2004h"]
[303.92299, "o", ">     while sx>1e-6 or sg>1e-6:\r\n\u001b[?2004l\r"]
[303.923018, "o", "\u001b[?2004h> "]
[303.92306, "o", "        sse0,x0,gamma,A,c=best; improved=False\r\n\u001b[?2004l\r"]
[303.923087, "o", "\u001b[?2004h> "]
[303.923131, "o", "        for dx in (-sx,0,sx):\r\n\u001b[?2004l\r"]
[303.923167, "o", "\u001b[?2004h> "]
[303.923226, "o", "            for dg in (-sg,0,sg):\r\n\u001b[?2004l\r\u001b[?2004h"]
[303.923285, "o", "> "]
[303.923321, "o", "                nx=x0+dx; ng=gamma+dg\r\n\u001b[?2004l\r\u001b[?2004h"]
[303.923362, "o", "> "]
[303.923401, "o", "                if ng<=0.01: continue\r\n\u001b[?2004l\r"]
[303.923419, "o", "\u001b[?2004h> "]
[303.923493, "o", "                A2,c2,sse2=linear_peak_fit(xw,yw,nx,ng,kind)\r\n\u001b[?2004l\r"]
[303.923531, "o", "\u001b[?2004h> "]
[303.923582, "o", "                if A2>0 and sse2<sse0-1e-12:\r\n\u001b[?2004l\r"]
[303.923614, "o", "\u001b[?2004h> "]
[303.923706, "o", "                    best=(sse2,nx,ng,A2,c2); sse0=sse2; improved=True\r\n\u001b[?2004l\r"]
[303.923737, "o", "\u001b[?2004h> "]
[303.923767, "o", "        if not improved:\r\n\u001b[?2004l\r"]
[303.923806, "o", "\u001b[?2004h> "]
[303.923841, "o", "            sx*=0.5; sg*=0.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[303.923879, "o", "> "]
[303.92391, "o", "    sse,x0,gamma,A,c=best\r\n\u001b[?2004l\r\u001b[?2004h> "]
[303.924006, "o", "    return x0,gamma,A,c,math.sqrt(sse/len(xw)),len(xw)\r\n\u001b[?2004l\r"]
[303.92407, "o", "\u001b[?2004h> \r\n"]
[303.924105, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[303.92414, "o", "for kind in ['lor','gauss']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[303.924171, "o", "    print('\\nMODEL',kind)\r\n\u001b[?2004l\r\u001b[?2004h"]
[303.924212, "o", "> "]
[303.924274, "o", "    for name,center in [('G',1580.0),('2D',2670.0)]:\r\n\u001b[?2004l\r"]
[303.924295, "o", "\u001b[?2004h> "]
[303.924354, "o", "        for w in [50,70,90,110,130]:\r\n\u001b[?2004l\r"]
[303.924393, "o", "\u001b[?2004h> "]
[303.924458, "o", "            x0,g,A,c,rmse,n=fit_peak(xs,ys,kind,center,w)\r\n\u001b[?2004l\r"]
[303.924495, "o", "\u001b[?2004h> "]
[303.924771, "o", "            print(f'{name:2s} w={w:3d} x0={x0:10.4f} gamma={g:9.4f} A={A:11.2f} off={c:10.2f} rmse={rmse:8.2f} n={n}')\r\n\u001b[?2004l\r"]
[303.924868, "o", "\u001b[?2004h> "]
[303.924907, "o", "PY\r\n\u001b[?2004l\r"]
