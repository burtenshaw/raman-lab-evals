[87.380076, "i", "python3 - <<'PY'\nxs=[]; ys=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        xs.append(float(a.replace(',','.')))\n        ys.append(float(b.replace(',','.')))\n# x spacing stats\ndiffs=[xs[i+1]-xs[i] for i in range(len(xs)-1)]\nprint('x spacing min/max/mean', min(diffs), max(diffs), sum(diffs)/len(diffs))\nprint('first diffs', [round(d,6) for d in diffs[:10]])\nprint('last diffs', [round(d,6) for d in diffs[-10:]])\n# Detailed range prints\nfor lo,hi in [(1400,3600),(5000,12500),(15000,20500)]:\n    print('\\nRANGE',lo,hi)\n    for i,(x,y) in enumerate(zip(xs,ys)):\n        if lo<=x<=hi:\n            if i%5==0:\n                print(f'{i:4d} {x:12.4f} {y:12.4f}')\nPY\n"]
[87.380175, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> xs=[]; ys=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line: continue\r\n\u001b[?2004l\r\u001b[?2004h>         a,b=line.split()\r\n\u001b[?2004l\r\u001b[?2004h>         xs.append(float(a.replace(',','.')))\r\n\u001b[?2004l\r\u001b[?2004h>         ys.append(float(b.replace(',','.')))\r\n\u001b[?2004l\r\u001b[?2004h> # x spacing stats\r\n\u001b[?2004l\r\u001b[?2004h> diffs=[xs[i+1]-xs[i] for i in range(len(xs)-1)]\r\n\u001b[?2004l\r\u001b[?2004h> print('x spacing min/max/mean', min(diffs), max(diffs), sum(diffs)/len(diffs))\r\n\u001b[?2004l\r\u001b[?2004h> print('first diffs', [round(d,6) for d in diffs[:10]])\r\n\u001b[?2004l\r\u001b[?2004h> print('last diffs', [round(d,6) for d in diffs[-10:]])\r\n\u001b[?2004l\r\u001b[?2004h> # Detailed range prints\r\n\u001b[?2004l\r\u001b[?2004h> for lo,hi in [(1400,3600),(5000,12500),(15000,20500)]:\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\nRANGE',lo,hi)\r\n\u001b[?2004l\r\u001b[?2004h>     for i,(x,y) in enumerate(zip(xs,ys)):\r\n\u001b[?2004l\r\u001b[?2004h>         i"]
[87.380192, "o", "f lo<=x<=hi:\r\n\u001b[?2004l\r\u001b[?2004h>             if i%5==0:\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f'{i:4d} {x:12.4f} {y:12.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
