[303.919947, "i", "(xs,ys,kind,center,w)\n            print(f'{name:2s} w={w:3d} x0={x0:10.4f} gamma={g:9.4f} A={A:11.2f} off={c:10.2f} rmse={rmse:8.2f} n={n}')\nPY\n"]
