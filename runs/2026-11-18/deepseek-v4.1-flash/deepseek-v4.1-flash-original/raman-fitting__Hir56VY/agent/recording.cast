[473.711088, "i", "python3 - <<'PY'\nimport math\n\nraw=[]; y=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        raw.append(float(a.replace(',','.')))\n        y.append(float(b.replace(',','.')))\ndata=sorted((1e7/v, yy) for v,yy in zip(raw,y))\nxs=[a for a,b in data]; ys=[b for a,b in data]\n\ndef solve_lsq(cols, y):\n    # normal equations for small number of columns\n    m=len(cols)\n    A=[[sum(cols[i][k]*cols[j][k] for k in range(len(y))) for j in range(m)] for i in range(m)]\n    b=[sum(cols[i][k]*y[k] for k in range(len(y))) for i in range(m)]\n    # gaussian elimination\n    for i in range(m):\n        p=max(range(i,m), key=lambda r: abs(A[r][i]))\n        A[i],A[p]=A[p],A[i]; b[i],b[p]=b[p],b[i]\n        piv=A[i][i]\n        if abs(piv)<1e-15: return None\n        for j in range(i+1,m):\n            f=A[j][i]/piv\n            for k in range(i,m): A[j][k]-=f*A[i][k]\n            b[j]-=f*b[i]\n    x=[0.0]*m\n    for i in range(m-1,-1,-1):\n        s=b[i]-"]
[473.711361, "i", "sum(A[i][j]*x[j] for j in range(i+1,m))\n        x[i]=s/A[i][i]\n    return x\n\ndef fit(xw,yw,x0,gamma,kind='lor',linear=False):\n    if kind=='lor':\n        f=[gamma*gamma/((x-x0)**2+gamma*gamma) for x in xw]\n    else:\n        f=[math.exp(-0.5*((x-x0)/gamma)**2) for x in xw]\n    cols=[f,[1.0]*len(xw)]\n    if linear: cols.append([x-x0 for x in xw])\n    coef=solve_lsq(cols,yw)\n    if coef is None: return None\n    A=coef[0]; c=coef[1]; b=coef[2] if linear else 0.0\n    if A<=0: return None\n    pred=[c+b*(x-x0)+A*fi for x,fi in zip(xw,f)]\n    sse=sum((yy-pp)**2 for yy,pp in zip(yw,pred))\n    return A,c,b,sse\n\ndef optimize(xw,yw,center,kind='lor',linear=False):\n    best=None\n    for x0 in [center-2.0+i*0.25 for i in range(17)]:\n        gmin=2.0; gmax=35.0\n        for gamma in [gmin+i*0.25 for i in range(int((gmax-gmin)/0.25)+1)]:\n            r=fit(xw,yw,x0,gamma,kind,linear)\n            if r and (best is None or r[3]<best[3]): best=(r[3],x0,gamma)+r[:3]\n    # pattern search over x0,gamma\n    sx=sg=0.1\n    while sx>1e-"]
[473.711437, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.711633, "i", "6 or sg>1e-6:\n        sse0,x0,gamma,A,c,b=best; improved=False\n        for dx in (-sx,0,sx):\n            for dg in (-sg,0,sg):\n                nx=x0+dx; ng=gamma+dg\n                if ng<=0.01: continue\n                r=fit(xw,yw,nx,ng,kind,linear)\n                if r and r[3]<sse0-1e-12:\n                    sse0=r[3]; best=(r[3],nx,ng,r[0],r[1],r[2]); improved=True\n        if not improved: sx*=0.5; sg*=0.5\n    sse,x0,gamma,A,c,b=best\n    return x0,gamma,A,c,b,math.sqrt(sse/len(xw)),len(xw)\n\nfor name,center in [('G',1580),('2D',2670)]:\n    print('\\n',name)\n    for w in [60,80,100,120]:\n        xw=[x for x in xs if abs(x-center)<=w]\n        yw=[yy for x,yy in zip(xs,ys) if abs(x-center)<=w]\n        for lin in [False,True]:\n            x0,g,A,c,b,rmse,n=optimize(xw,yw,center,'lor',lin)\n            print(f'  w={w:3d} linear={int(lin)} x0={x0:9.4f} gamma={g:8.4f} A={A:10.1f} offset={c:9.1f} slope={b:8.2f} rmse={rmse:7.2f} n={n}')\nPY\n"]
