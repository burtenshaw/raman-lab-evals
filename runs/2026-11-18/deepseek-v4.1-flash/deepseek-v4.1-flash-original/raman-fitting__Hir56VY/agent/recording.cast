[47.546788, "i", "python3 - <<'PY'\n# Find smooth local maxima with simple prominence\nxs=[]; ys=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        a,b=line.split()\n        xs.append(float(a.replace(',','.')))\n        ys.append(float(b.replace(',','.')))\n# smooth 11-point moving average\nm=11\nsm=[]\nfor i in range(len(ys)):\n    lo=max(0,i-m//2); hi=min(len(ys),i+m//2+1)\n    sm.append(sum(ys[lo:hi])/(hi-lo))\n# local maxima in smoothed data\npeaks=[]\nfor i in range(2,len(sm)-2):\n    if sm[i]>=sm[i-2] and sm[i]>=sm[i-1] and sm[i]>=sm[i+1] and sm[i]>=sm[i+2] and sm[i]>max(sm[max(0,i-100):i]+sm[i+1:min(len(sm),i+101)]):\n        peaks.append(i)\nprint('local maxima:')\nfor i in peaks:\n    print(i, f'{xs[i]:.3f}', f'{ys[i]:.3f}', f'sm={sm[i]:.3f}')\nPY\n"]
