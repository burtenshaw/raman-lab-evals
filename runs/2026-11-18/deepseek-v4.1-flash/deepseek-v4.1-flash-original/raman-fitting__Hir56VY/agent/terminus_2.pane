[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c5-bkajluce-01ad4-fd79m:/app# python3 - <<'PY'
[?2004l[?2004h> raw=[]; y=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         a,b=line.split()
[?2004l[?2004h>         raw.append(float(a.replace(',','.')))
[?2004l[?2004h>         y.append(float(b.replace(',','.')))
[?2004l[?2004h> data=sorted((1e7/v, yy) for v,yy in zip(raw,y))
[?2004l[?2004h> xs=[a for a,b in data]; ys=[b for a,b in data]
[?2004l[?2004h> 
[?2004l[?2004h> def linfit(points):
[?2004l[?2004h>     n=len(points); sx=sum(p[0] for p in points); sy=sum(p[1] for p in points)
[?2004l[?2004h>     sxx=sum(p[0]*p[0] for p in points); sxy=sum(p[0]*p[1] for p in points)
[?2004l[?2004h>     d=n*sxx-sx*sx
[?2004l[?2004h>     m=(n*sxy-sx*sy)/d; c=(sy-m*sx)/n
[?2004l[?2004h>     return m,c
[?2004l[?2004h> 
[?2004l[?2004h> def baseline(name,center,left,right):
[?2004l[?2004h>     pts=[]
[?2004l[?2004h>     for x,yv in zip(xs,ys):
[?2004l[?2004h>         if left[0]<=x<=left[1] or right[0]<=x<=right[1]:
[?2004l[?2004h>             pts.append((x,yv))
[?2004l[?2004h>     m,c=linfit(pts)
[?2004l[?2004h>     val=m*center+c
[?2004l[?2004h>     print(f'{name}: nbase={len(pts)} slope={m:.6f} intercept={c:.3f} baseline@center={val:.3f}')
[?2004l[?2004h>     # print off-peak sampled values
[?2004l[?2004h>     for x,yv in pts[::max(1,len(pts)//15)]:
[?2004l[?2004h>         print(f'   {x:9.3f} {yv:10.1f}')
[?2004l[?2004h> 
[?2004l[?2004h> baseline('G',1580,(1380,1530),(1630,1800))
