[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c5-bkajluce-01ad4-fd79m:/app# python3 - <<'PY'
[?2004l[?2004h> xs=[]; ys=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         a,b=line.split()
[?2004l[?2004h>         xs.append(float(a.replace(',','.')))
[?2004l[?2004h>         ys.append(float(b.replace(',','.')))
[?2004l[?2004h> # simple smoothing
[?2004l[?2004h> m=9
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(ys)):
[?2004l[?2004h>     lo=max(0,i-m//2); hi=min(len(ys),i+m//2+1)
[?2004l[?2004h>     sm.append(sum(ys[lo:hi])/(hi-lo))
[?2004l[?2004h> # local maxima, require prominence over 100-point window
[?2004l[?2004h> peaks=[]
[?2004l[?2004h> for i in range(1,len(sm)-1):
[?2004l[?2004h>     if sm[i]>=sm[i-1] and sm[i]>sm[i+1]:
[?2004l[?2004h>         left=max(sm[max(0,i-150):i]) if i>0 else -1
[?2004l[?2004h>         right=max(sm[i+1:min(len(sm),i+151)]) if i+1<len(sm) else -1
[?2004l[?2004h>         prom=sm[i]-max(left,right)
[?2004l[?2004h>         if prom>200:
[?2004l[?2004h>             peaks.append((i,xs[i],ys[i],sm[i],prom))
[?2004l[?2004h> for p in peaks:
[?2004l[?2004h>     print(f'idx={p[0]:4d} x={p[1]:12.4f} y={p[2]:12.4f} sm={p[3]:12.4f} prom={p[4]:12.4f}')
[?2004l[?2004h> PY
[?2004l[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c5-bkajluce-01ad4-fd79m:/app# python3 - <<'PY'
[?2004l[?2004h> # Parse and convert x to wavenumber (cm^-1)
[?2004l[?2004h> raw=[]; y=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         a,b=line.split()
[?2004l[?2004h>         raw.append(float(a.replace(',','.')))
[?2004l[?2004h>         y.append(float(b.replace(',','.')))
[?2004l[?2004h> wn=[1e7/v for v in raw]
[?2004l[?2004h> data=sorted(zip(wn,y))
[?2004l[?2004h> wn=[a for a,b in data]; y=[b for a,b in data]
[?2004l[?2004h> print('wavenumber range', wn[0], wn[-1])
[?2004l[?2004h> # simple smoothing
[?2004l[?2004h> m=15
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>     lo=max(0,i-m//2); hi=min(len(y),i+m//2+1)
[?2004l[?2004h>     sm.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h> # local maxima in windows
[?2004l[?2004h> for lo,hi in [(1400,1800),(2400,2900),(450,600),(900,1050)]:
[?2004l[?2004h>     print('\nwindow',lo,hi)
[?2004l[?2004h>     inds=[i for i,x in enumerate(wn) if lo<=x<=hi]
[?2004l[?2004h>     loc=[i for i in inds if 0<i<len(wn)-1 and sm[i]>=sm[i-1] and sm[i]>sm[i+1]]
[?2004l[?2004h>     for i in loc:
[?2004l[?2004h>         print(f'i={i} wn={wn[i]:.4f} y={y[i]:.2f} sm={sm[i]:.2f}')
[?2004l[?2004h> # print detailed points around G and 2D peaks at intervals
[?2004l[?2004h> for center,name in [(1580,'G'),(2670,'2D')]:
[?2004l[?2004h>     print('\nDETAIL',name,'center',center)
[?2004l[?2004h>     inds=[i for i,x in enumerate(wn) if abs(x-center)<80]
[?2004l[?2004h>     for j,i in enumerate(inds):
[?2004l[?2004h>         if j%5==0:
[?2004l[?2004h>             print(f'wn={wn[i]:10.4f} y={y[i]:12.4f}')
[?2004l[?2004h> PY
[?2004lwavenumber range 211.93824999939102 6065.295070382182

