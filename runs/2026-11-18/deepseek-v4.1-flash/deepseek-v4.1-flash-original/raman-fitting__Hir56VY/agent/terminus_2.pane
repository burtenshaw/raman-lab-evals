[?2004l[?2004h> import math
[?2004l[?2004h> 
[?2004l[?2004h> raw=[]; y=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         a,b=line.split()
[?2004l[?2004h>         raw.append(float(a.replace(',','.')))
[?2004l[?2004h>         y.append(float(b.replace(',','.')))
[?2004l[?2004h> data=sorted((1e7/v, yy) for v,yy in zip(raw,y))
[?2004l[?2004h> xs=[a for a,b in data]; ys=[b for a,b in data]
[?2004l[?2004h> 
[?2004l[?2004h> def solve_lsq(cols, y):
[?2004l[?2004h>     # normal equations for small number of columns
[?2004l[?2004h>     m=len(cols)
[?2004l[?2004h>     A=[[sum(cols[i][k]*cols[j][k] for k in range(len(y))) for j in range(m)] for i in range(m)]
[?2004l[?2004h>     b=[sum(cols[i][k]*y[k] for k in range(len(y))) for i in range(m)]
[?2004l[?2004h>     # gaussian elimination
[?2004l[?2004h>     for i in range(m):
[?2004l[?2004h>         p=max(range(i,m), key=lambda r: abs(A[r][i]))
[?2004l[?2004h>         A[i],A[p]=A[p],A[i]; b[i],b[p]=b[p],b[i]
[?2004l[?2004h>         piv=A[i][i]
[?2004l[?2004h>         if abs(piv)<1e-15: return None
[?2004l[?2004h>         for j in range(i+1,m):
[?2004l[?2004h>             f=A[j][i]/piv
[?2004l[?2004h>             for k in range(i,m): A[j][k]-=f*A[i][k]
[?2004l[?2004h>             b[j]-=f*b[i]
[?2004l[?2004h>     x=[0.0]*m
[?2004l[?2004h>     for i in range(m-1,-1,-1):
[?2004l[?2004h>         s=b[i]-sum(A[i][j]*x[j] for j in range(i+1,m))
[?2004l[?2004h>         x[i]=s/A[i][i]
[?2004l[?2004h>     return x
[?2004l[?2004h> 
[?2004l[?2004h> def fit(xw,yw,x0,gamma,kind='lor',linear=False):
[?2004l[?2004h>     if kind=='lor':
[?2004l[?2004h>         f=[gamma*gamma/((x-x0)**2+gamma*gamma) for x in xw]
[?2004l[?2004h>     else:
[?2004l[?2004h>         f=[math.exp(-0.5*((x-x0)/gamma)**2) for x in xw]
[?2004l[?2004h>     cols=[f,[1.0]*len(xw)]
[?2004l[?2004h>     if linear: cols.append([x-x0 for x in xw])
[?2004l[?2004h>     coef=solve_lsq(cols,yw)
[?2004l[?2004h>     if coef is None: return None
[?2004l[?2004h>     A=coef[0]; c=coef[1]; b=coef[2] if linear else 0.0
[?2004l[?2004h>     if A<=0: return None
[?2004l[?2004h>     pred=[c+b*(x-x0)+A*fi for x,fi in zip(xw,f)]
[?2004l[?2004h>     sse=sum((yy-pp)**2 for yy,pp in zip(yw,pred))
[?2004l[?2004h>     return A,c,b,sse
[?2004l[?2004h> 
[?2004l[?2004h> def optimize(xw,yw,center,kind='lor',linear=False):
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for x0 in [center-2.0+i*0.25 for i in range(17)]:
[?2004l[?2004h>         gmin=2.0; gmax=35.0
[?2004l[?2004h>         for gamma in [gmin+i*0.25 for i in range(int((gmax-gmin)/0.25)+1)]:
[?2004l[?2004h>             r=fit(xw,yw,x0,gamma,kind,linear)
[?2004l[?2004h>             if r and (best is None or r[3]<best[3]): best=(r[3],x0,gamma)+r[:3]
[?2004l[?2004h>     # pattern search over x0,gamma
[?2004l[?2004h>     sx=sg=0.1
[?2004l[?2004h>     while sx>1e-6 or sg>1e-6:
[?2004l[?2004h>         sse0,x0,gamma,A,c,b=best; improved=False
[?2004l[?2004h>         for dx in (-sx,0,sx):
[?2004l[?2004h>             for dg in (-sg,0,sg):
[?2004l[?2004h>                 nx=x0+dx; ng=gamma+dg
[?2004l[?2004h>                 if ng<=0.01: continue
[?2004l[?2004h>                 r=fit(xw,yw,nx,ng,kind,linear)
[?2004l[?2004h>                 if r and r[3]<sse0-1e-12:
[?2004l[?2004h>                     sse0=r[3]; best=(r[3],nx,ng,r[0],r[1],r[2]); improved=True
[?2004l[?2004h>         if not improved: sx*=0.5; sg*=0.5
[?2004l[?2004h>     sse,x0,gamma,A,c,b=best
[?2004l[?2004h>     return x0,gamma,A,c,b,math.sqrt(sse/len(xw)),len(xw)
[?2004l[?2004h> 
[?2004l[?2004h> for name,center in [('G',1580),('2D',2670)]:
[?2004l[?2004h>     print('\n',name)
[?2004l[?2004h>     for w in [60,80,100,120]:
[?2004l[?2004h>         xw=[x for x in xs if abs(x-center)<=w]
[?2004l[?2004h>         yw=[yy for x,yy in zip(xs,ys) if abs(x-center)<=w]
[?2004l[?2004h>         for lin in [False,True]:
[?2004l[?2004h>             x0,g,A,c,b,rmse,n=optimize(xw,yw,center,'lor',lin)
[?2004l[?2004h>             print(f'  w={w:3d} linear={int(lin)} x0={x0:9.4f} gamma={g:8.4f} A={A:10.1f} offset={c:9.1f} slope={b:8.2f} rmse={rmse:7.2f} n={n}')
