[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         a,b=line.split()
[?2004l[?2004h>         raw.append(float(a.replace(',','.')))
[?2004l[?2004h>         y.append(float(b.replace(',','.')))
[?2004l[?2004h> data=sorted((1e7/v, yy) for v,yy in zip(raw,y))
[?2004l[?2004h> xs=[a for a,b in data]; ys=[b for a,b in data]
[?2004l[?2004h> 
[?2004l[?2004h> def fit_const(x,y,x0,g):
[?2004l[?2004h>     f=[g*g/((xi-x0)**2+g*g) for xi in x]
[?2004l[?2004h>     n=len(x); sf=sum(f); sy=sum(y); sff=sum(v*v for v in f); sfy=sum(fi*yi for fi,yi in zip(f,y))
[?2004l[?2004h>     det=n*sff-sf*sf
[?2004l[?2004h>     A=(n*sfy-sf*sy)/det
[?2004l[?2004h>     c=(sy-A*sf)/n
[?2004l[?2004h>     sse=sum((yi-c-A*fi)**2 for xi,fi,yi in zip(x,f,y))
[?2004l[?2004h>     return A,c,sse
[?2004l[?2004h> 
[?2004l[?2004h> def opt(x,y,c0):
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for x0 in [c0-2+0.1*i for i in range(41)]:
[?2004l[?2004h>         for g in [4+0.1*i for i in range(261)]:
[?2004l[?2004h>             A,c,sse=fit_const(x,y,x0,g)
[?2004l[?2004h>             if A>0 and (best is None or sse<best[0]): best=(sse,x0,g,A,c)
[?2004l[?2004h>     sx=sg=0.05
[?2004l[?2004h>     while sx>1e-6 or sg>1e-6:
[?2004l[?2004h>         s0,x0,g,A,c=best; imp=False
[?2004l[?2004h>         for dx in (-sx,0,sx):
[?2004l[?2004h>             for dg in (-sg,0,sg):
[?2004l[?2004h>                 nx=x0+dx; ng=g+dg
[?2004l[?2004h>                 if ng<=0.01: continue
[?2004l[?2004h>                 A2,c2,sse=fit_const(x,y,nx,ng)
[?2004l[?2004h>                 if A2>0 and sse<s0-1e-12:
[?2004l[?2004h>                     best=(sse,nx,ng,A2,c2); s0=sse; imp=True
[?2004l[?2004h>         if not imp: sx*=.5; sg*=.5
[?2004l[?2004h>     sse,x0,g,A,c=best
[?2004l[?2004h>     return x0,g,A,c,math.sqrt(sse/len(x)),len(x)
