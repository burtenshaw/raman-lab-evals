[?2004l[?2004h>     print('\n'+name)
[?2004l[?2004h>     for lo,hi in windows:
[?2004l[?2004h>         x=[xi for xi in xs if lo<=xi<=hi]
[?2004l[?2004h>         yw=[yy for xi,yy in zip(xs,ys) if lo<=xi<=hi]
[?2004l[?2004h>         x0,g,A,c,rmse,n=opt(x,yw,c0)
[?2004l[?2004h>         print(f'{lo}-{hi}: x0={x0:.4f} gamma={g:.4f} A={A:.2f} offset={c:.2f} rmse={rmse:.2f} n={n}')
