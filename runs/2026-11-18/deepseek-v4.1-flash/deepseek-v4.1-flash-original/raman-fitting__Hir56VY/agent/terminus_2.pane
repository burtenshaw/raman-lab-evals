[?2004l[?2004h> # Find smooth local maxima with simple prominence
[?2004l[?2004h> xs=[]; ys=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         a,b=line.split()
[?2004l[?2004h>         xs.append(float(a.replace(',','.')))
[?2004l[?2004h>         ys.append(float(b.replace(',','.')))
[?2004l[?2004h> # smooth 11-point moving average
[?2004l[?2004h> m=11
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(ys)):
[?2004l[?2004h>     lo=max(0,i-m//2); hi=min(len(ys),i+m//2+1)
[?2004l[?2004h>     sm.append(sum(ys[lo:hi])/(hi-lo))
[?2004l[?2004h> # local maxima in smoothed data
[?2004l[?2004h> peaks=[]
[?2004l[?2004h> for i in range(2,len(sm)-2):
[?2004l[?2004h>     if sm[i]>=sm[i-2] and sm[i]>=sm[i-1] and sm[i]>=sm[i+1] and sm[i]>=sm[i+2] and sm[i]>max(sm[max(0,i-100):i]+sm[i+1:min(len(sm),i+101)]):
[?2004l[?2004h>         peaks.append(i)
[?2004l[?2004h> print('local maxima:')
[?2004l[?2004h> for i in peaks:
[?2004l[?2004h>     print(i, f'{xs[i]:.3f}', f'{ys[i]:.3f}', f'sm={sm[i]:.3f}')
[?2004l[?2004h> PY
