[?2004l[?2004h>     if 1200<=xi<=3000:
[?2004l[?2004h>         x.append(xi); yv.append(yi)
[?2004l[?2004h> print('points',len(x))
[?2004l[?2004h> 
[?2004l[?2004h> def lor(xi,x0,g):
[?2004l[?2004h>     return g*g/((xi-x0)**2+g*g)
[?2004l[?2004h> 
[?2004l[?2004h> def sse(params):
[?2004l[?2004h>     x01,g1,A1,x02,g2,A2,c=params
[?2004l[?2004h>     if g1<=0 or g2<=0 or A1<=0 or A2<=0: return 1e99
[?2004l[?2004h>     s=0.0
[?2004l[?2004h>     for xi,yi in zip(x,yv):
[?2004l[?2004h>         m=c+A1*lor(xi,x01,g1)+A2*lor(xi,x02,g2)
[?2004l[?2004h>         d=yi-m; s+=d*d
[?2004l[?2004h>     return s
[?2004l[?2004h> 
[?2004l[?2004h> # initial from local fits
[?2004l[?2004h> p=[1580.34,8.5,8300,2670.13,18.5,12500,900.0]
[?2004l[?2004h> print('initial sse',sse(p))
[?2004l[?2004h> # coordinate descent with decreasing step
[?2004l[?2004h> steps=[5,2,1,0.5,0.2,0.1,0.05,0.02,0.01,0.005,0.002,0.001]
[?2004l[?2004h> for st in steps:
[?2004l[?2004h>     improved=True
[?2004l[?2004h>     while improved:
[?2004l[?2004h>         improved=False
[?2004l[?2004h>         for k in range(7):
[?2004l[?2004h>             best=sse(p); bp=p[:]
[?2004l[?2004h>             for d in (-st,st):
[?2004l[?2004h>                 q=p[:]; q[k]+=d
[?2004l[?2004h>                 v=sse(q)
[?2004l[?2004h>                 if v<best-1e-9:
[?2004l[?2004h>                     best=v; bp=q; improved=True
[?2004l[?2004h>             p=bp
[?2004l[?2004h>     print(f'step {st:.4f} sse {sse(p):.3f} p {[round(v,4) for v in p]}')
[?2004l[?2004h> print('final',p,'rmse',math.sqrt(sse(p)/len(x)))
