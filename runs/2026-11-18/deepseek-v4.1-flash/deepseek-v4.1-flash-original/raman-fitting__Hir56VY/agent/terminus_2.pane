[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c5-bkajluce-01ad4-fd79m:/app# python3 - <<'PY'
[?2004l[?2004h> import math
[?2004l[?2004h> 
[?2004l[?2004h> # Load and convert x to Raman shift
[?2004l[?2004h> raw=[]; y=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         a,b=line.split()
[?2004l[?2004h>         raw.append(float(a.replace(',','.')))
[?2004l[?2004h>         y.append(float(b.replace(',','.')))
[?2004l[?2004h> wn=[1e7/v for v in raw]
[?2004l[?2004h> data=sorted(zip(wn,y))
[?2004l[?2004h> xs=[a for a,b in data]; ys=[b for a,b in data]
[?2004l[?2004h> 
[?2004l[?2004h> def fit_const(x,y,x0,gamma,kind):
[?2004l[?2004h>     n=len(x)
[?2004l[?2004h>     if kind=='lor':
[?2004l[?2004h>         f=[gamma*gamma/((xi-x0)**2+gamma*gamma) for xi in x]
[?2004l[?2004h>     else:
[?2004l[?2004h>         s2=gamma*gamma/(8*math.log(2))  # gamma=FWHM for Gaussian
[?2004l[?2004h>         f=[math.exp(-0.5*(xi-x0)**2/s2) for xi in x]
[?2004l[?2004h>     sf=sum(f); sy=sum(y)
[?2004l[?2004h>     sff=sum(v*v for v in f); sfy=sum(fi*yi for fi,yi in zip(f,y))
[?2004l[?2004h>     det=n*sff-sf*sf
[?2004l[?2004h>     A=(n*sfy-sf*sy)/det
[?2004l[?2004h>     c=(sy-A*sf)/n
[?2004l[?2004h>     sse=sum((yi-c-A*fi)**2 for xi,fi,yi in zip(x,f,y))
[?2004l[?2004h>     return A,c,sse
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x,y,kind,center,gamma0,window):
[?2004l[?2004h>     xw=[]; yw=[]
[?2004l[?2004h>     for xi,yi in zip(x,y):
[?2004l[?2004h>         if abs(xi-center)<=window:
[?2004l[?2004h>             xw.append(xi); yw.append(yi)
[?2004l[?2004h>     best=None
[?2004l[?2004h>     # coarse grid
[?2004l[?2004h>     x0=center-5.0
[?2004l[?2004h>     while x0<=center+5.0+1e-9:
[?2004l[?2004h>         gamma=4.0
[?2004l[?2004h>         while gamma<=60.0+1e-9:
[?2004l[?2004h>             A,c,sse=fit_const(xw,yw,x0,gamma,kind)
[?2004l[?2004h>             if A>0 and (best is None or sse<best[0]):
[?2004l[?2004h>                 best=(sse,x0,gamma,A,c)
[?2004l[?2004h>             gamma+=0.5
[?2004l[?2004h>         x0+=0.5
[?2004l[?2004h>     # pattern search
[?2004l[?2004h>     stepx=0.25; stepg=0.25
[?2004l[?2004h>     while stepx>1e-5 or stepg>1e-5:
[?2004l[?2004h>         sse0,x0,gamma,A,c=best
[?2004l[?2004h>         improved=False
[?2004l[?2004h>         for dx in (-stepx,0.0,stepx):
[?2004l[?2004h>             for dg in (-stepg,0.0,stepg):
[?2004l[?2004h>                 nx=x0+dx; ng=gamma+dg
[?2004l[?2004h>                 if ng<=0.01: continue
[?2004l[?2004h>                 A2,c2,sse2=fit_const(xw,yw,nx,ng,kind)
[?2004l[?2004h>                 if A2>0 and sse2<sse0-1e-12:
[?2004l[?2004h>                     best=(sse2,nx,ng,A2,c2); sse0=sse2; improved=True
[?2004l[?2004h>         if not improved:
[?2004l[?2004h>             stepx*=0.5; stepg*=0.5
[?2004l[?2004h>     sse,x0,gamma,A,c=best
[?2004l[?2004h>     return x0,gamma,A,c,sse,math.sqrt(sse/len(xw)),len(xw)
[?2004l[?2004h> 
[?2004l[?2004h> for kind in ['lor','gauss']:
[?2004l[?2004h>     print('\nMODEL',kind)
[?2004l[?2004h>     for name,center,gamma0,window in [('G',1579.9,12,90),('2D',2670.2,18,140)]:
[?2004l[?2004h>         x0,gamma,A,c,sse,rmse,n=fit_peak(xs,ys,kind,center,gamma0,window)
[?2004l[?2004h>         print(f'{name}: x0={x0:.6f} gamma={gamma:.6f} A={A:.6f} offset={c:.6f} rmse={rmse:.3f} n={n}')
