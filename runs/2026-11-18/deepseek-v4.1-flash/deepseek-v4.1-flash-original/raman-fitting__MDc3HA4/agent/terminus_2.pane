[?2004l[?2004h>     # simple local maxima, prominence not available if scipy installed yes
[?2004l[?2004h>     from scipy.signal import find_peaks
[?2004l[?2004h>     pk,props=find_peaks(res[mm],prominence=200,distance=10)
[?2004l[?2004h>     print('deg',deg,'peaks:')
[?2004l[?2004h>     for p in pk:
