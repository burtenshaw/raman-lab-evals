[?2004l[?2004h> # simple moving average, print local maxima over every 50 points after smoothing
[?2004l[?2004h> window=41
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(pts)):
[?2004l[?2004h>     lo=max(0,i-window//2); hi=min(len(pts),i+window//2+1)
