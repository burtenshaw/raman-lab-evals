[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> 
[?2004l[?2004h> D=[]
[?2004l[?2004h> with open('/app/graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         a,b=line.replace(',','.').split()
[?2004l[?2004h>         D.append((float(a),float(b)))
[?2004l[?2004h> D=np.array(sorted(D))
[?2004l[?2004h> x=D[:,0]; y=D[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x,x0,g,a):
[?2004l[?2004h>     return a*g*g/((x-x0)**2+g*g)
[?2004l[?2004h> 
[?2004l[?2004h> def model_lor_lin(p,x):
[?2004l[?2004h>     x0,g,a,b0,b1=p
[?2004l[?2004h>     return b0 + b1*(x-x0) + lor(x,x0,g,a)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_lor_lin(name, lo, hi, p0, bounds=None, ntry=1):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xx=x[m]; yy=y[m]
[?2004l[?2004h>     def res(p): return model_lor_lin(p,xx)-yy
[?2004l[?2004h>     if bounds is None:
[?2004l[?2004h>         out=least_squares(res,p0,max_nfev=200000,xtol=1e-14,ftol=1e-14,gtol=1e-14)
[?2004l[?2004h>     else:
[?2004l[?2004h>         out=least_squares(res,p0,bounds=bounds,max_nfev=200000,xtol=1e-14,ftol=1e-14,gtol=1e-14)
[?2004l[?2004h>     p=out.x
[?2004l[?2004h>     rms=np.sqrt(np.mean(out.fun**2))
[?2004l[?2004h>     print(name,'success',out.success,'rms',rms)
[?2004l[?2004h>     print('  x0',p[0],'gamma',p[1],'amp',p[2],'offset(x0)',p[3],'slope',p[4])
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> print('Rayleigh:')
[?2004l[?2004h> fit_lor_lin('Rayleigh',18400,19600,[19139,30,70000,20000,10],([19000,1,0,-1e6,-1e4],[19300,1000,1e7,1e6,1e4]))
[?2004l[?2004h> 
[?2004l[?2004h> print('\n2D candidate raw x:')
[?2004l[?2004h> # use wide and narrow windows
[?2004l[?2004h> for lo,hi in [(15500,16900),(15800,16700),(15900,16650)]:
[?2004l[?2004h>     fit_lor_lin(f'2D {lo}-{hi}',lo,hi,[16245,150,2000,16000,0.4],([16000,10,0,0,-100],[16500,1000,10000,30000,100]))
[?2004l[?2004h> 
[?2004l[?2004h> print('\nG candidate raw x:')
[?2004l[?2004h> for lo,hi in [(16800,18100),(17000,18000),(17100,17900)]:
[?2004l[?2004h>     fit_lor_lin(f'G {lo}-{hi}',lo,hi,[17560,80,1000,18000,5],([17200,5,0,0,-100],[18000,1000,20000,40000,100]))
[?2004l[?2004h> 
[?2004l[?2004h> print('\nG candidate with polynomial background (deg 2):')
[?2004l[?2004h> def model_lor_poly(p,x,deg):
[?2004l[?2004h>     x0,g,a=p[:3]
[?2004l[?2004h>     b=p[3:]
[?2004l[?2004h>     return np.polyval(b,x-x0) + lor(x,x0,g,a)
[?2004l[?2004h> for lo,hi in [(16800,18100),(17000,18000)]:
[?2004l[?2004h>     m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]
[?2004l[?2004h>     p0=[17560,80,1000,18000,5,0]
[?2004l[?2004h>     def res(p): return model_lor_poly(p,xx,2)-yy
[?2004l[?2004h>     out=least_squares(res,p0,max_nfev=200000)
