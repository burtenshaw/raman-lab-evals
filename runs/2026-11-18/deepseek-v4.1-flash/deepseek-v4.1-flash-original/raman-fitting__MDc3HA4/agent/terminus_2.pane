[?2004l[?2004h> x=D[:,0]; y=D[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x,x0,g,a,off):
[?2004l[?2004h>     return off + a*g*g/((x-x0)**2+g*g)
[?2004l[?2004h> 
[?2004l[?2004h> def lor_lin(x,x0,g,a,b0,b1):
[?2004l[?2004h>     return b0 + b1*(x-x0) + a*g*g/((x-x0)**2+g*g)
