[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.signal import savgol_filter, find_peaks
[?2004l[?2004h> 
[?2004l[?2004h> D=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         a,b=line.replace(',','.').split()
[?2004l[?2004h>         D.append((float(a),float(b)))
[?2004l[?2004h> D=np.array(sorted(D))
[?2004l[?2004h> x=D[:,0]; y=D[:,1]
[?2004l[?2004h> # uniform grid 1 cm-1 spacing
[?2004l[?2004h> xg=np.arange(np.ceil(x.min()), np.floor(x.max())+1, 1.0)
[?2004l[?2004h> yg=np.interp(xg, x, y)
[?2004l[?2004h> # smooth over varying window widths to detect broad and sharp peaks
[?2004l[?2004h> for win in [51,101,201,501]:
[?2004l[?2004h>     if win % 2 == 0: win += 1
[?2004l[?2004h>     ys=savgol_filter(yg, win, 3)
[?2004l[?2004h>     pk,props=find_peaks(ys, prominence=200, distance=10)
[?2004l[?2004h>     print('\nwindow',win,'num peaks',len(pk))
[?2004l[?2004h>     for i in pk:
[?2004l[?2004h>         if ys[i] > 500:
[?2004l[?2004h>             print(f'  x={xg[i]:9.3f} y_sm={ys[i]:10.2f} prom={props["prominences"][list(pk).index(i)]:10.2f}')
