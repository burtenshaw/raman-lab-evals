[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> 
[?2004l[?2004h> D=[]
[?2004l[?2004h> with open('/app/graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         a,b=line.replace(',','.').split()
[?2004l[?2004h>         D.append((float(a),float(b)))
[?2004l[?2004h> D=np.array(sorted(D))
[?2004l[?2004h> x=D[:,0]; y=D[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, p):
[?2004l[?2004h>     x0,g,a = p
[?2004l[?2004h>     return a*g*g/((x-x0)**2+g*g)
[?2004l[?2004h> 
[?2004l[?2004h> def model2(p, x, deg):
[?2004l[?2004h>     # p = [x01,g1,a1,x02,g2,a2, b0,b1,...,bdeg]
[?2004l[?2004h>     n=3+3+deg+1
[?2004l[?2004h>     b=p[6:]
[?2004l[?2004h>     z=x-17000.0 if x.max()>1000 else x-2000.0
[?2004l[?2004h>     bg=np.polyval(b,z)
[?2004l[?2004h>     return bg + lor(x,p[0:3]) + lor(x,p[3:6])
[?2004l[?2004h> 
[?2004l[?2004h> def fit_case(name, lo, hi, p0, lb, ub, deg):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xx=x[m]; yy=y[m]
[?2004l[?2004h>     # parameter order as above
[?2004l[?2004h>     # set initial bg coefficients zeros except b0 = median y
[?2004l[?2004h>     p=[p0[0],p0[1],p0[2],p0[3],p0[4],p0[5]] + [0.0]*deg + [float(np.median(yy))]
[?2004l[?2004h>     # curve_fit expects list, but we will use least_squares with residual
[?2004l[?2004h>     def res(p): return model2(p,xx,deg)-yy
[?2004l[?2004h>     l=[lb[0],lb[1],lb[2],lb[3],lb[4],lb[5]] + [-1e9]*(deg+1)
[?2004l[?2004h>     u=[ub[0],ub[1],ub[2],ub[3],ub[4],ub[5]] + [1e9]*(deg+1)
[?2004l[?2004h>     try:
[?2004l[?2004h>         out=least_squares(res,p,bounds=(l,u),max_nfev=20000,xtol=1e-12,ftol=1e-12,gtol=1e-12)
[?2004l[?2004h>         p=out.x
[?2004l[?2004h>         rms=np.sqrt(np.mean(out.fun**2))
[?2004l[?2004h>         print(f'{name} deg={deg} success={out.success} cost={out.cost:.3e} rms={rms:.2f}')
[?2004l[?2004h>         print('  G ',p[0],p[1],p[2])
[?2004l[?2004h>         print('  2D',p[3],p[4],p[5])
[?2004l[?2004h>         print('  bg',p[6:])
[?2004l[?2004h>         return p
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(name,'ERR',e)
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h> print('=== raw absolute x, region 15000-18500 ===')
[?2004l[?2004h> for deg in [0,1,2,3]:
[?2004l[?2004h>     fit_case('raw', 15000,18500, [17560,80,1000,16245,100,2000],
[?2004l[?2004h>              [17000,5,0,15800,5,0], [18100,1000,20000,16800,1000,20000], deg)
[?2004l[?2004h> 
[?2004l[?2004h> print('\n=== x/10 interpretation, region 1450-3000 ===')
[?2004l[?2004h> x10=x/10.0
[?2004l[?2004h> # temporarily replace x/y arrays for fit_case? easier separate copy function not; do manual call after mutating globals
[?2004l[?2004h> globals()['x_save']=x.copy()
[?2004l[?2004h> globals()['x']=x10
[?2004l[?2004h> for deg in [0,1,2,3]:
[?2004l[?2004h>     fit_case('x10', 1450,3000, [1620,40,1000,2650,100,2000],
[?2004l[?2004h>              [1500,5,0,2500,5,0], [1700,1000,20000,2800,1000,20000], deg)
[?2004l[?2004h> globals()['x']=globals()['x_save']
[?2004l[?2004h> PY
