[?2004l[?2004h> 
[?2004l[?2004h> def lor(x,x0,g,a):
[?2004l[?2004h>     return a*g*g/((x-x0)**2+g*g)
[?2004l[?2004h> 
[?2004l[?2004h> def one_lor_poly(p,x,deg):
