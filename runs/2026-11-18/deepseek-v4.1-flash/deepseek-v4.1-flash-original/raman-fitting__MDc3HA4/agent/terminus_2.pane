[?2004l[?2004h>     p=p0+[np.median(yy)]+[0.0]*(deg-1) if deg>=1 else p0+[np.median(yy)]
[?2004l[?2004h>     l=lb+[-1e9]*(deg+1); u=ub+[1e9]*(deg+1)
[?2004l[?2004h>     out=least_squares(lambda p: one_lor_poly(p,xx,deg)-yy,p,bounds=(l,u),max_nfev=200000)
[?2004l[?2004h>     rms=np.sqrt(np.mean(out.fun**2))
[?2004l[?2004h>     print(f'one lor {lo}-{hi} deg{deg}: x0={out.x[0]:.6f} gamma={out.x[1]:.6f} amp={out.x[2]:.6f} bg={out.x[3:]} rms={rms:.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> def fit_two(x,y,lo,hi,p0,deg,lb,ub):
