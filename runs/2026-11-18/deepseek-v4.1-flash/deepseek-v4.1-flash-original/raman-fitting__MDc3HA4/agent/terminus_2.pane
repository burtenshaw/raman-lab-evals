[?2004l[?2004h>     return np.polyval(b,x-x0)+lor(x,x0,g,a)
[?2004l[?2004h> 
[?2004l[?2004h> def two_lor_poly(p,x,deg):
[?2004l[?2004h>     x01,g1,a1,x02,g2,a2=p[:6]; b=p[6:]
[?2004l[?2004h>     return np.polyval(b,x-x01)+lor(x,x01,g1,a1)+lor(x,x02,g2,a2)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_one(x,y,lo,hi,p0,deg,lb,ub):
