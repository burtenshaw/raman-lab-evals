[?2004l[?2004h>     pk,_=find_peaks(res[mm], prominence=200, distance=2)
[?2004l[?2004h>     print('deg',deg,'coef',coef)
[?2004l[?2004h>     for p in pk:
[?2004l[?2004h>         i=np.where(mm)[0][p]
