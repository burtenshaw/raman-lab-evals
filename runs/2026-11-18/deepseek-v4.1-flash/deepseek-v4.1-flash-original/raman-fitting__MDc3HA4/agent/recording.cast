[355.832416, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nD=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        D.append((float(a),float(b)))\nD=np.array(sorted(D))\nx=D[:,0]; y=D[:,1]\n# Fit baseline to broad region excluding laser line\nfor deg in [2,3,4,5,6]:\n    m=(x>=15000)&(x<=19000)\n    # Exclude laser peak and very close wings\n    m &= ~((x>=18700)&(x<=19600))\n    coef=np.polyfit(x[m],y[m],deg)\n    base=np.polyval(coef,x)\n    res=y-base\n    # find positive residual peaks in 15500-18500\n    mm=(x>=15500)&(x<=18500)\n    pk,_=find_peaks(res[mm], prominence=200, distance=2)\n    print('deg',deg,'coef',coef)\n    for p in pk:\n        i=np.where(mm)[0][p]\n        print('  peak at',x[i],'y',y[i],'res',res[i])\nPY\n"]
[355.832581, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[355.832641, "o", "\u001b[?2004h"]
[355.832686, "o", "> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.83273, "o", "from scipy.signal import find_peaks\r\n\u001b[?2004l\r"]
