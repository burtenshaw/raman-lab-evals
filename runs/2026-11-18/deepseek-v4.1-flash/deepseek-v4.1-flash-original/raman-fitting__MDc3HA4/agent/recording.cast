[503.78953, "o", "    bg=np.polyval(b,z)\r\n\u001b[?2004l\r"]
[503.78957, "o", "\u001b[?2004h> "]
[503.789621, "o", "    return bg + lor(x,p[0:3]) + lor(x,p[3:6])\r\n\u001b[?2004l\r"]
[503.789662, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[503.789704, "o", "\u001b[?2004h> "]
[503.789806, "o", "def fit_case(name, lo, hi, p0, lb, ub, deg):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.789854, "o", "    m=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.789921, "o", "    xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.789978, "o", "> "]
[503.789993, "o", "    # parameter order as above\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.790092, "o", "    # set initial bg coefficients zeros except b0 = median y\r\n\u001b[?2004l\r"]
[503.790149, "o", "\u001b[?2004h> "]
[503.790206, "o", "    p=[p0[0],p0[1],p0[2],p0[3],p0[4],p0[5]] + [0.0]*deg + [float(np.median(yy))]\r\n\u001b[?2004l\r"]
[503.79025, "o", "\u001b[?2004h> "]
[503.79032, "o", "    # curve_fit expects list, but we will use least_squares with residual\r\n\u001b[?2004l\r"]
[503.79036, "o", "\u001b[?2004h> "]
[503.790405, "o", "    def res(p): return model2(p,xx,deg)-yy\r\n\u001b[?2004l\r"]
[503.790444, "o", "\u001b[?2004h> "]
[503.790508, "o", "    l=[lb[0],lb[1],lb[2],lb[3],lb[4],lb[5]] + [-1e9]*(deg+1)\r\n\u001b[?2004l\r"]
[503.790539, "o", "\u001b[?2004h> "]
[503.790611, "o", "    u=[ub[0],ub[1],ub[2],ub[3],ub[4],ub[5]] + [1e9]*(deg+1)\r\n\u001b[?2004l\r"]
[503.790651, "o", "\u001b[?2004h> "]
[503.79069, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.79078, "o", "        out=least_squares(res,p,bounds=(l,u),max_nfev=20000,xtol=1e-12,ftol=1e-12,gtol=1e-12)\r\n\u001b[?2004l\r"]
[503.79082, "o", "\u001b[?2004h> "]
[503.790866, "o", "        p=out.x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.790902, "o", "        rms=np.sqrt(np.mean(out.fun**2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.791034, "o", "        print(f'{name} deg={deg} success={out.success} cost={out.cost:.3e} rms={rms:.2f}')\r\n\u001b[?2004l\r"]
[503.791079, "o", "\u001b[?2004h> "]
[503.791122, "o", "        print('  G ',p[0],p[1],p[2])\r\n\u001b[?2004l\r"]
[503.791174, "o", "\u001b[?2004h> "]
[503.791214, "o", "        print('  2D',p[3],p[4],p[5])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.791255, "o", "        print('  bg',p[6:])\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.791285, "o", ">         return p\r\n\u001b[?2004l\r"]
[503.791312, "o", "\u001b[?2004h> "]
[503.791349, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[503.791389, "o", "\u001b[?2004h> "]
[503.791429, "o", "        print(name,'ERR',e)\r\n\u001b[?2004l\r"]
[503.791469, "o", "\u001b[?2004h> "]
[503.791502, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[503.791542, "o", "> "]
[503.791586, "o", "print('=== raw absolute x, region 15000-18500 ===')\r\n\u001b[?2004l\r"]
[503.791624, "o", "\u001b[?2004h> "]
[503.791663, "o", "for deg in [0,1,2,3]:\r\n\u001b[?2004l\r"]
[503.791702, "o", "\u001b[?2004h> "]
[503.791759, "o", "    fit_case('raw', 15000,18500, [17560,80,1000,16245,100,2000],\r\n\u001b[?2004l\r"]
[503.791799, "o", "\u001b[?2004h> "]
[503.791875, "o", "             [17000,5,0,15800,5,0], [18100,1000,20000,16800,1000,20000], deg)\r\n\u001b[?2004l\r"]
[503.791919, "o", "\u001b[?2004h> "]
[503.791949, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.791985, "o", "print('\\n=== x/10 interpretation, region 1450-3000 ===')\r\n\u001b[?2004l\r"]
[503.792025, "o", "\u001b[?2004h> "]
[503.792066, "o", "x10=x/10.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.792186, "o", "# temporarily replace x/y arrays for fit_case? easier separate copy function not; do manual call after mutating globals\r\n\u001b[?2004l\r"]
[503.792229, "o", "\u001b[?2004h> "]
[503.792269, "o", "globals()['x_save']=x.copy()\r\n\u001b[?2004l\r"]
[503.792308, "o", "\u001b[?2004h> "]
[503.792347, "o", "globals()['x']=x10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.792388, "o", "for deg in [0,1,2,3]:\r\n\u001b[?2004l\r"]
[503.792433, "o", "\u001b[?2004h> "]
[503.792471, "o", "    fit_case('x10', 1450,3000, [1620,40,1000,2650,100,2000],\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.79251, "o", "> "]
[503.79257, "o", "             [1500,5,0,2500,5,0], [1700,1000,20000,2800,1000,20000], deg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.79261, "o", "> "]
[503.792651, "o", "globals()['x']=globals()['x_save']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.79269, "o", "PY\r\n\u001b[?2004l\r"]
