[583.488872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[583.488894, "o", "\u001b[?2004h> "]
[583.48895, "o", "def fit_lor_lin(name, lo, hi, p0, bounds=None, ntry=1):\r\n\u001b[?2004l\r"]
[583.488978, "o", "\u001b[?2004h> "]
[583.489007, "o", "    m=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[583.489029, "o", "\u001b[?2004h> "]
[583.489051, "o", "    xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.489072, "o", "> "]
[583.489108, "o", "    def res(p): return model_lor_lin(p,xx)-yy\r\n\u001b[?2004l\r"]
[583.48913, "o", "\u001b[?2004h> "]
[583.489161, "o", "    if bounds is None:\r\n\u001b[?2004l\r"]
[583.489183, "o", "\u001b[?2004h> "]
[583.489278, "o", "        out=least_squares(res,p0,max_nfev=200000,xtol=1e-14,ftol=1e-14,gtol=1e-14)\r\n\u001b[?2004l\r"]
[583.489307, "o", "\u001b[?2004h> "]
[583.48933, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.489433, "o", "        out=least_squares(res,p0,bounds=bounds,max_nfev=200000,xtol=1e-14,ftol=1e-14,gtol=1e-14)\r\n\u001b[?2004l\r"]
[583.489456, "o", "\u001b[?2004h> "]
[583.489478, "o", "    p=out.x\r\n\u001b[?2004l\r"]
[583.4895, "o", "\u001b[?2004h> "]
[583.489539, "o", "    rms=np.sqrt(np.mean(out.fun**2))\r\n\u001b[?2004l\r"]
[583.48956, "o", "\u001b[?2004h> "]
[583.489613, "o", "    print(name,'success',out.success,'rms',rms)\r\n\u001b[?2004l\r"]
[583.489635, "o", "\u001b[?2004h> "]
[583.489724, "o", "    print('  x0',p[0],'gamma',p[1],'amp',p[2],'offset(x0)',p[3],'slope',p[4])\r\n\u001b[?2004l\r"]
[583.489779, "o", "\u001b[?2004h> "]
[583.489814, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.489838, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.489862, "o", "print('Rayleigh:')\r\n\u001b[?2004l\r"]
[583.489886, "o", "\u001b[?2004h> "]
[583.489997, "o", "fit_lor_lin('Rayleigh',18400,19600,[19139,30,70000,20000,10],([19000,1,0,-1e6,-1e4],[19300,1000,1e7,1e6,1e4]))\r\n\u001b[?2004l\r"]
[583.49002, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[583.490036, "o", "\u001b[?2004h> "]
[583.490069, "o", "print('\\n2D candidate raw x:')\r\n\u001b[?2004l\r"]
[583.490092, "o", "\u001b[?2004h> "]
[583.490123, "o", "# use wide and narrow windows\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.490151, "o", "> "]
[583.490209, "o", "for lo,hi in [(15500,16900),(15800,16700),(15900,16650)]:\r\n\u001b[?2004l\r"]
[583.490237, "o", "\u001b[?2004h> "]
[583.490368, "o", "    fit_lor_lin(f'2D {lo}-{hi}',lo,hi,[16245,150,2000,16000,0.4],([16000,10,0,0,-100],[16500,1000,10000,30000,100]))\r\n\u001b[?2004l\r"]
[583.490393, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[583.490409, "o", "\u001b[?2004h> "]
[583.490439, "o", "print('\\nG candidate raw x:')\r\n\u001b[?2004l\r"]
[583.490462, "o", "\u001b[?2004h> "]
[583.49052, "o", "for lo,hi in [(16800,18100),(17000,18000),(17100,17900)]:\r\n\u001b[?2004l\r"]
[583.490544, "o", "\u001b[?2004h> "]
[583.490664, "o", "    fit_lor_lin(f'G {lo}-{hi}',lo,hi,[17560,80,1000,18000,5],([17200,5,0,0,-100],[18000,1000,20000,40000,100]))\r\n\u001b[?2004l\r"]
[583.490687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[583.490712, "o", "\u001b[?2004h> "]
[583.490767, "o", "print('\\nG candidate with polynomial background (deg 2):')\r\n\u001b[?2004l\r"]
[583.49079, "o", "\u001b[?2004h> "]
[583.490822, "o", "def model_lor_poly(p,x,deg):\r\n\u001b[?2004l\r"]
[583.490845, "o", "\u001b[?2004h> "]
[583.490869, "o", "    x0,g,a=p[:3]\r\n\u001b[?2004l\r"]
[583.490893, "o", "\u001b[?2004h> "]
[583.490909, "o", "    b=p[3:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.490969, "o", "    return np.polyval(b,x-x0) + lor(x,x0,g,a)\r\n\u001b[?2004l\r"]
[583.490993, "o", "\u001b[?2004h> "]
[583.491036, "o", "for lo,hi in [(16800,18100),(17000,18000)]:\r\n\u001b[?2004l\r"]
[583.49106, "o", "\u001b[?2004h> "]
[583.491101, "o", "    m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r"]
[583.491124, "o", "\u001b[?2004h> "]
[583.491157, "o", "    p0=[17560,80,1000,18000,5,0]\r\n\u001b[?2004l\r"]
[583.49118, "o", "\u001b[?2004h> "]
[583.491232, "o", "    def res(p): return model_lor_poly(p,xx,2)-yy\r\n\u001b[?2004l\r"]
[583.491258, "o", "\u001b[?2004h> "]
[583.491302, "o", "    out=least_squares(res,p0,max_nfev=200000)\r\n\u001b[?2004l\r"]
[583.491326, "o", "\u001b[?2004h> "]
[583.491374, "o", "    p=out.x; rms=np.sqrt(np.mean(out.fun**2))\r\n\u001b[?2004l\r"]
[583.491397, "o", "\u001b[?2004h> "]
[583.491532, "o", "    print(f'Gpoly {lo}-{hi} success={out.success} rms={rms:.2f} x0={p[0]:.6f} gamma={p[1]:.6f} amp={p[2]:.6f} bg={p[3:]}')\r\n\u001b[?2004l\r"]
[583.491549, "o", "\u001b[?2004h> "]
[583.491564, "o", "PY\r\n\u001b[?2004l\r"]
