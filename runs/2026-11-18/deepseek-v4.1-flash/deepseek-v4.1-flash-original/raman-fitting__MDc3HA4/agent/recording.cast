[845.177111, "i", "python3 - <<'PY'\nimport numpy as np\nD=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split(); D.append((float(a),float(b)))\nx=np.array([a for a,b in D]); y=np.array([b for a,b in D]); i=np.arange(len(x))\nfor label,z in [('x',x),('1/x',1/x),('log x',np.log(x))]:\n    A=np.vstack([i,np.ones_like(i)]).T\n    coef,res,rank,s=np.linalg.lstsq(A,z,rcond=None)\n    pred=A@coef\n    ss=((z-pred)**2).sum(); tot=((z-z.mean())**2).sum()\n    print(label,'linear R2',1-ss/tot,'coef',coef)\nprint('first 10 1/x:',1/x[:10])\nprint('last 10 1/x:',1/x[-10:])\nPY\n"]
