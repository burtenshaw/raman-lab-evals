[644.173743, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import least_squares\nD=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split(); D.append((float(a),float(b)))\nD=np.array(sorted(D)); x=D[:,0]; y=D[:,1]\n# x/10 spectrum, fit polynomial baseline to 1200-3500 excluding 1500-1700 and 2500-2900 perhaps\nfor deg in [2,3,4,5,6,7]:\n    m=(x>=12000)&(x<=35000)\n    # exclude likely peaks at 1622 and 1914, 3324\n    m &= ~((x>=15800)&(x<=16600))\n    m &= ~((x>=18800)&(x<=19500))\n    m &= ~((x>=32800)&(x<=33700))\n    coef=np.polyfit(x[m]/10.0,y[m],deg)\n    base=np.polyval(coef,x/10.0)\n    res=y-base\n    # report local residual maxima in 1450-3000\n    mm=(x/10.0>=1450)&(x/10.0<=3000)\n    # simple local maxima, prominence not available if scipy installed yes\n    from scipy.signal import find_peaks\n    pk,props=find_peaks(res[mm],prominence=200,distance=10)\n    print('deg',deg,'peaks:')\n    for p in pk:\n        i=np.where(mm)[0][p]\n        print(f'  x={x[i]/10:8.3f} y={y[i]:9.2f} r"]
[644.173887, "i", "es={res[i]:9.2f} prom={props[\"prominences\"][list(pk).index(p)]:.2f}')\nPY\n"]
[644.173957, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
[644.174002, "o", "\u001b[?2004h> "]
[644.174103, "o", "from scipy.optimize import least_squares\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.174164, "o", "> D=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.174195, "o", "    for line in f:\r\n\u001b[?2004l\r"]
[644.174237, "o", "\u001b[?2004h> "]
[644.174356, "o", "        a,b=line.replace(',','.').split(); D.append((float(a),float(b)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.174397, "o", "> "]
[644.174425, "o", "D=np.array(sorted(D)); x=D[:,0]; y=D[:,1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.17446, "o", "> "]
[644.174556, "o", "# x/10 spectrum, fit polynomial baseline to 1200-3500 excluding 1500-1700 and 2500-2900 perhaps\r\n\u001b[?2004l\r"]
[644.174588, "o", "\u001b[?2004h> "]
[644.174629, "o", "for deg in [2,3,4,5,6,7]:\r\n\u001b[?2004l\r"]
[644.174664, "o", "\u001b[?2004h> "]
[644.174703, "o", "    m=(x>=12000)&(x<=35000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.174746, "o", "    # exclude likely peaks at 1622 and 1914, 3324\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.174786, "o", "> "]
[644.174831, "o", "    m &= ~((x>=15800)&(x<=16600))\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.174876, "o", "> "]
[644.17491, "o", "    m &= ~((x>=18800)&(x<=19500))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.174958, "o", "    m &= ~((x>=32800)&(x<=33700))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.174999, "o", "    coef=np.polyfit(x[m]/10.0,y[m],deg)\r\n\u001b[?2004l\r"]
[644.175038, "o", "\u001b[?2004h"]
[644.175078, "o", "> "]
[644.17512, "o", "    base=np.polyval(coef,x/10.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.175164, "o", "    res=y-base\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.1752, "o", "    # report local residual maxima in 1450-3000\r\n\u001b[?2004l\r"]
[644.175239, "o", "\u001b[?2004h> "]
[644.175283, "o", "    mm=(x/10.0>=1450)&(x/10.0<=3000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.175379, "o", "    # simple local maxima, prominence not available if scipy installed yes\r\n\u001b[?2004l\r"]
[644.175417, "o", "\u001b[?2004h> "]
[644.175452, "o", "    from scipy.signal import find_peaks\r\n\u001b[?2004l\r"]
[644.175493, "o", "\u001b[?2004h> "]
[644.175533, "o", "    pk,props=find_peaks(res[mm],prominence=200,distance=10)\r\n\u001b[?2004l\r"]
