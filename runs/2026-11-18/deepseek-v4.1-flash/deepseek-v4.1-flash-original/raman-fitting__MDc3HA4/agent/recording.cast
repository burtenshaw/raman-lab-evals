[503.788107, "i", "cat > /tmp/explore_models.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import least_squares\n\nD=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        D.append((float(a),float(b)))\nD=np.array(sorted(D))\nx=D[:,0]; y=D[:,1]\n\ndef lor(x, p):\n    x0,g,a = p\n    return a*g*g/((x-x0)**2+g*g)\n\ndef model2(p, x, deg):\n    # p = [x01,g1,a1,x02,g2,a2, b0,b1,...,bdeg]\n    n=3+3+deg+1\n    b=p[6:]\n    z=x-17000.0 if x.max()>1000 else x-2000.0\n    bg=np.polyval(b,z)\n    return bg + lor(x,p[0:3]) + lor(x,p[3:6])\n\ndef fit_case(name, lo, hi, p0, lb, ub, deg):\n    m=(x>=lo)&(x<=hi)\n    xx=x[m]; yy=y[m]\n    # parameter order as above\n    # set initial bg coefficients zeros except b0 = median y\n    p=[p0[0],p0[1],p0[2],p0[3],p0[4],p0[5]] + [0.0]*deg + [float(np.median(yy))]\n    # curve_fit expects list, but we will use least_squares with residual\n    def res(p): return model2(p,xx,deg)-yy\n    l=[lb[0],lb[1],lb[2],lb[3],lb[4],lb[5]] + [-1e9]*(deg+1)\n    u=[ub[0],ub[1],ub[2],u"]
[503.788248, "i", "b[3],ub[4],ub[5]] + [1e9]*(deg+1)\n    try:\n        out=least_squares(res,p,bounds=(l,u),max_nfev=20000,xtol=1e-12,ftol=1e-12,gtol=1e-12)\n        p=out.x\n        rms=np.sqrt(np.mean(out.fun**2))\n        print(f'{name} deg={deg} success={out.success} cost={out.cost:.3e} rms={rms:.2f}')\n        print('  G ',p[0],p[1],p[2])\n        print('  2D',p[3],p[4],p[5])\n        print('  bg',p[6:])\n        return p\n    except Exception as e:\n        print(name,'ERR',e)\n        return None\n\nprint('=== raw absolute x, region 15000-18500 ===')\nfor deg in [0,1,2,3]:\n    fit_case('raw', 15000,18500, [17560,80,1000,16245,100,2000],\n             [17000,5,0,15800,5,0], [18100,1000,20000,16800,1000,20000], deg)\n\nprint('\\n=== x/10 interpretation, region 1450-3000 ===')\nx10=x/10.0\n# temporarily replace x/y arrays for fit_case? easier separate copy function not; do manual call after mutating globals\nglobals()['x_save']=x.copy()\nglobals()['x']=x10\nfor deg in [0,1,2,3]:\n    fit_case('x10', 1450,3000, [1620,40,1000,2650,100,2000],\n       "]
[503.788314, "o", "cat > /tmp/explore_models.py <<'PY'\r\n\u001b[?2004l\r"]
[503.78842, "i", "      [1500,5,0,2500,5,0], [1700,1000,20000,2800,1000,20000], deg)\nglobals()['x']=globals()['x_save']\nPY\npython3 /tmp/explore_models.py\n"]
