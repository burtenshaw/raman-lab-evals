[808.752994, "i", "cat > /tmp/global_fit.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import least_squares\n\nD=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split(); D.append((float(a),float(b)))\nD=np.array(sorted(D)); x=D[:,0]; y=D[:,1]\n\ndef lor(x,x0,g,a):\n    return a*g*g/((x-x0)**2+g*g)\n\ndef model(p,x):\n    x1,g1,a1,x2,g2,a2,x3,g3,a3,b0,b1=p\n    return b0+b1*(x-19139.0)+lor(x,x1,g1,a1)+lor(x,x2,g2,a2)+lor(x,x3,g3,a3)\n\nm=(x>=15000)&(x<=20000)\nxx=x[m]; yy=y[m]\n# Rayleigh, G, 2D\np0=[19139,150,65000, 17560,100,2500, 16245,180,2500, 15000, 0.5]\nlb=[19000,1,0, 17200,5,0, 15900,5,0, -1e6,-1e4]\nub=[19300,1000,1e7, 17900,1000,10000, 16600,1000,10000, 1e6,1e4]\nout=least_squares(lambda p: model(p,xx)-yy, p0, bounds=(lb,ub), max_nfev=500000)\np=out.x\nrms=np.sqrt(np.mean(out.fun**2))\nprint('success',out.success,'rms',rms)\nprint('Rayleigh x0 gamma amp',p[0],p[1],p[2])\nprint('G        x0 gamma amp',p[3],p[4],p[5])\nprint('2D       x0 gamma amp',p[6],p[7],p[8])\nprint('bg b0 b1',p[9],p[10])\nPY\n"]
[808.75312, "i", "python3 /tmp/global_fit.py\n"]
[808.753189, "o", "cat > /tmp/global_fit.py <<'PY'\r\n"]
