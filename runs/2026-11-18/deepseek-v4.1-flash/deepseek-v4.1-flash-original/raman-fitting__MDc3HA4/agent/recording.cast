[432.978354, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.signal import savgol_filter, find_peaks\n\nD=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        D.append((float(a),float(b)))\nD=np.array(sorted(D))\nx=D[:,0]; y=D[:,1]\n# uniform grid 1 cm-1 spacing\nxg=np.arange(np.ceil(x.min()), np.floor(x.max())+1, 1.0)\nyg=np.interp(xg, x, y)\n# smooth over varying window widths to detect broad and sharp peaks\nfor win in [51,101,201,501]:\n    if win % 2 == 0: win += 1\n    ys=savgol_filter(yg, win, 3)\n    pk,props=find_peaks(ys, prominence=200, distance=10)\n    print('\\nwindow',win,'num peaks',len(pk))\n    for i in pk:\n        if ys[i] > 500:\n            print(f'  x={xg[i]:9.3f} y_sm={ys[i]:10.2f} prom={props[\"prominences\"][list(pk).index(i)]:10.2f}')\nPY\n"]
