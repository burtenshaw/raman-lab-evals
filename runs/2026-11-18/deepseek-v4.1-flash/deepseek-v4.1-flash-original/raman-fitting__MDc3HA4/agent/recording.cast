[190.156018, "o", "?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # global 2 Lorentzians + linear background\r\n\u001b[?2004l\r\u001b[?2004h> m=(x>=15800)&(x<=18200)\r\n\u001b[?2004l\r\u001b[?2004h> xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h> def two_lor_lin(x,x01,g1,a1,x02,g2,a2,b0,b1):\r\n\u001b[?2004l\r\u001b[?2004h>     return b0 + b1*(x-17000) + a1*g1**2/((x-x01)**2+g1**2) + a2*g2**2/((x-x02)**2+g2**2)\r\n\u001b[?2004l\r\u001b[?2004h> p0=[16450,100,1000,17560,200,3000,17000,1]\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     popt,pcov=curve_fit(two_lor_lin,xx,yy,p0=p0,maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h>     print('global',popt)\r\n\u001b[?2004l\r\u001b[?2004h>     print('rms',np.sqrt(np.mean((yy-two_lor_lin(xx,*popt))**2)))\r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>     print('global ERR',e)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
