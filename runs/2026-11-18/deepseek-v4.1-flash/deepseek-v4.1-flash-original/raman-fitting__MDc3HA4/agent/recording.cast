[731.394165, "i", "cat > /tmp/compare_fits.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import least_squares\n\nD=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split(); D.append((float(a),float(b)))\nD=np.array(sorted(D)); xr=D[:,0]; yr=D[:,1]\n\ndef lor(x,x0,g,a):\n    return a*g*g/((x-x0)**2+g*g)\n\ndef one_lor_poly(p,x,deg):\n    x0,g,a=p[:3]; b=p[3:]\n    return np.polyval(b,x-x0)+lor(x,x0,g,a)\n\ndef two_lor_poly(p,x,deg):\n    x01,g1,a1,x02,g2,a2=p[:6]; b=p[6:]\n    return np.polyval(b,x-x01)+lor(x,x01,g1,a1)+lor(x,x02,g2,a2)\n\ndef fit_one(x,y,lo,hi,p0,deg,lb,ub):\n    m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]\n    p=p0+[np.median(yy)]+[0.0]*(deg-1) if deg>=1 else p0+[np.median(yy)]\n    l=lb+[-1e9]*(deg+1); u=ub+[1e9]*(deg+1)\n    out=least_squares(lambda p: one_lor_poly(p,xx,deg)-yy,p,bounds=(l,u),max_nfev=200000)\n    rms=np.sqrt(np.mean(out.fun**2))\n    print(f'one lor {lo}-{hi} deg{deg}: x0={out.x[0]:.6f} gamma={out.x[1]:.6f} amp={out.x[2]:.6f} bg={out.x[3:]} rms={rms:.2f}')\n\ndef fit_two(x,y,"]
[731.394297, "i", "lo,hi,p0,deg,lb,ub):\n    m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]\n    p=p0+[np.median(yy)]+[0.0]*deg\n    l=lb+[-1e9]*(deg+1); u=ub+[1e9]*(deg+1)\n    out=least_squares(lambda p: two_lor_poly(p,xx,deg)-yy,p,bounds=(l,u),max_nfev=200000)\n    rms=np.sqrt(np.mean(out.fun**2))\n    print(f'two lor {lo}-{hi} deg{deg}: x1={out.x[0]:.6f} g1={out.x[1]:.6f} a1={out.x[2]:.6f} | x2={out.x[3]:.6f} g2={out.x[4]:.6f} a2={out.x[5]:.6f} bg={out.x[6:]} rms={rms:.2f}')\n\nprint('X/10 INTERPRETATION')\nx=xr/10\n# one G-like around 1500-1600\nfit_one(x,yr,1500,1600,[1575,20,500],1,[1450,1,0],[1650,500,5000])\n# one broad G-like around 1550-1650\nfit_one(x,yr,1500,1650,[1618,30,2000],2,[1450,1,0],[1700,500,10000])\n# two G+D' model around 1500-1700\nfit_two(x,yr,1450,1700,[1575,30,500,1625,30,1500],2,[1450,1,0,1550,1,0],[1650,500,10000,1700,500,10000])\n# 2D model around 2500-3000\nfit_one(x,yr,2500,3000,[2650,30,300],2,[2400,1,0],[3100,500,5000])\n\nprint('\\nRAW ABSOLUTE INTERPRETATION')\n# 2D-like around 15800-16700\nfit_one(xr,yr,15500,16900,[16245,"]
[731.394355, "o", "cat > /tmp/compare_fits.py <<'PY'\r\n\u001b[?2004l\r"]
[731.394368, "i", "150,2000],1,[15000,1,0],[17000,1000,10000])\n# G-like around 17000-18000\nfit_one(xr,yr,16800,18100,[17560,100,1000],2,[16500,1,0],[18200,1000,20000])\n# two-peak global-ish in 15500-18100, with linear bg\nfit_two(xr,yr,15500,18100,[16245,150,2000,17560,100,1000],1,[15000,1,0,16500,1,0],[17000,1000,10000,18200,1000,20000])\nPY\npython3 /tmp/compare_fits.py\n"]
