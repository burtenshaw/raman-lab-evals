[63.063788, "i", "python3 - <<'PY'\nxs=[]; ys=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        xs.append(float(a)); ys.append(float(b))\npts=sorted(zip(xs,ys))\nprint('x range', pts[0][0], pts[-1][0])\nfor lo in range(0, 40000, 1000):\n    vals=[y for x,y in pts if lo<=x<lo+1000]\n    if vals:\n        print(f'{lo:5d}-{lo+1000:5d}: n={len(vals):4d} avg={sum(vals)/len(vals):9.1f} max={max(vals):9.1f}')\nPY\n"]
[63.063951, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
