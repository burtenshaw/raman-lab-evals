[99.935601, "i", "python3 - <<'PY'\npts=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        pts.append((float(a),float(b)))\npts.sort()\nfor lo,hi in [(15800,16600),(16800,18000)]:\n    print('\\nREGION',lo,hi)\n    for x,y in pts:\n        if lo<=x<=hi:\n            print(f'{x:12.6f} {y:12.6f}')\nPY\n"]
[99.939146, "o", "python3 - <<'PY'"]
[99.939794, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> pts=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         a,b=line.replace(',','.').split()\r\n\u001b[?2004l\r\u001b[?2004h>         pts.append((float(a),float(b)))\r\n\u001b[?2004l\r\u001b[?2004h> pts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> for lo,hi in [(15800,16600),(16800,18000)]:\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\nREGION',lo,hi)\r\n\u001b[?2004l\r\u001b[?2004h>     for x,y in pts:\r\n\u001b[?2004l\r\u001b[?2004h>         if lo<=x<=hi:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f'{x:12.6f} {y:12.6f}')\r\n\u001b[?2004l\r"]
