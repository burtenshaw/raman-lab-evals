[16.078306, "i", "python3 - <<'PY'\nimport sys, math\nxs=[]; ys=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        xs.append(float(a)); ys.append(float(b))\nprint('n',len(xs),'xmin',min(xs),'xmax',max(xs),'ymin',min(ys),'ymax',max(ys))\n# report points around known G and 2D regions\nfor lo,hi,name in [(1500,1700,'G'),(2500,2800,'2D')]:\n    pts=[(x,y) for x,y in zip(xs,ys) if lo<=x<=hi]\n    print(name, 'n', len(pts), 'xrange', pts[0][0] if pts else None, pts[-1][0] if pts else None)\n    if pts:\n        mx=max(pts,key=lambda t:t[1])\n        print(name,'max',mx)\nPY\n"]
[16.078473, "o", "python3 - <<'PY'\r\nimport sys, math\r\nxs=[]; ys=[]\r\nwith open('graphene.dat') as f:\r\n    for line in f:\r\n        a,b=line.replace(',','.').split()\r\n        xs.append(float(a)); ys.append(float(b))\r\nprint('n',len(xs),'xmin',min(xs),'xmax',max(xs),'ymin',min(ys),'ymax',max(ys))\r\n# report points around known G and 2D regions\r\nfor lo,hi,name in [(1500,1700,'G'),(2500,2800,'2D')]:\r\n    pts=[(x,y) for x,y in zip(xs,ys) if lo<=x<=hi]\r\n    print(name, 'n', len(pts), 'xrange', pts[0][0] if pts else None, pts[-1][0] if pts else None)\r\n    if pts:\r\n        mx=max(pts,key=lambda t:t[1])\r\n        print(name,'max',mx)\r\nPY\r\n"]
[16.922565, "o", "pip 25.2 from /usr/local/lib/python3.13/site-packages/pip (python 3.13)\r\n"]
