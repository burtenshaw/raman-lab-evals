[583.487828, "i", "cat > /tmp/fit_peaks.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import least_squares\n\nD=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        D.append((float(a),float(b)))\nD=np.array(sorted(D))\nx=D[:,0]; y=D[:,1]\n\ndef lor(x,x0,g,a):\n    return a*g*g/((x-x0)**2+g*g)\n\ndef model_lor_lin(p,x):\n    x0,g,a,b0,b1=p\n    return b0 + b1*(x-x0) + lor(x,x0,g,a)\n\ndef fit_lor_lin(name, lo, hi, p0, bounds=None, ntry=1):\n    m=(x>=lo)&(x<=hi)\n    xx=x[m]; yy=y[m]\n    def res(p): return model_lor_lin(p,xx)-yy\n    if bounds is None:\n        out=least_squares(res,p0,max_nfev=200000,xtol=1e-14,ftol=1e-14,gtol=1e-14)\n    else:\n        out=least_squares(res,p0,bounds=bounds,max_nfev=200000,xtol=1e-14,ftol=1e-14,gtol=1e-14)\n    p=out.x\n    rms=np.sqrt(np.mean(out.fun**2))\n    print(name,'success',out.success,'rms',rms)\n    print('  x0',p[0],'gamma',p[1],'amp',p[2],'offset(x0)',p[3],'slope',p[4])\n    return p\n\nprint('Rayleigh:')\nfit_lor_lin('Rayleigh',18400,19600,[19139,30"]
[583.487947, "i", ",70000,20000,10],([19000,1,0,-1e6,-1e4],[19300,1000,1e7,1e6,1e4]))\n\nprint('\\n2D candidate raw x:')\n# use wide and narrow windows\nfor lo,hi in [(15500,16900),(15800,16700),(15900,16650)]:\n    fit_lor_lin(f'2D {lo}-{hi}',lo,hi,[16245,150,2000,16000,0.4],([16000,10,0,0,-100],[16500,1000,10000,30000,100]))\n\nprint('\\nG candidate raw x:')\nfor lo,hi in [(16800,18100),(17000,18000),(17100,17900)]:\n    fit_lor_lin(f'G {lo}-{hi}',lo,hi,[17560,80,1000,18000,5],([17200,5,0,0,-100],[18000,1000,20000,40000,100]))\n\nprint('\\nG candidate with polynomial background (deg 2):')\ndef model_lor_poly(p,x,deg):\n    x0,g,a=p[:3]\n    b=p[3:]\n    return np.polyval(b,x-x0) + lor(x,x0,g,a)\nfor lo,hi in [(16800,18100),(17000,18000)]:\n    m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]\n    p0=[17560,80,1000,18000,5,0]\n    def res(p): return model_lor_poly(p,xx,2)-yy\n    out=least_squares(res,p0,max_nfev=200000)\n    p=out.x; rms=np.sqrt(np.mean(out.fun**2))\n    print(f'Gpoly {lo}-{hi} success={out.success} rms={rms:.2f} x0={p[0]:.6f} gamma={p[1]:.6f} am"]
[583.487988, "o", "cat > /tmp/fit_peaks.py <<'PY'\r\n\u001b[?2004l\r"]
[583.487998, "i", "p={p[2]:.6f} bg={p[3:]}')\nPY\npython3 /tmp/fit_peaks.py\n"]
