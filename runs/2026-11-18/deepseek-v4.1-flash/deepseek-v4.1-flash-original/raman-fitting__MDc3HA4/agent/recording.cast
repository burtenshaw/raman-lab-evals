[643.714546, "i", "python3 - <<'PY'\nimport numpy as np\nD=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split(); D.append((float(a),float(b)))\nD=np.array(sorted(D)); x=D[:,0]; y=D[:,1]\ndx=np.diff(x)\nprint('dx min/median/max',dx.min(),np.median(dx),dx.max())\nfor lo,hi in [(0,5000),(5000,10000),(10000,20000),(20000,30000),(30000,40000),(40000,48000)]:\n    m=(x[:-1]>=lo)&(x[:-1]<hi)\n    if m.any(): print(f'{lo}-{hi}: n={m.sum()} dx med={np.median(dx[m]):.4f} min={dx[m].min():.4f} max={dx[m].max():.4f}')\nPY\n"]
[643.714715, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[643.714816, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[643.714883, "o", "D=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[643.714945, "o", "    for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[643.715007, "o", "        a,b=line.replace(',','.').split(); D.append((float(a),float(b)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[643.715053, "o", "> "]
[643.715098, "o", "D=np.array(sorted(D)); x=D[:,0]; y=D[:,1]\r\n\u001b[?2004l\r"]
[643.715141, "o", "\u001b[?2004h> "]
