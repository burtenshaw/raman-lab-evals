[29.611654, "i", "python3 - <<'PY'\nxs=[]; ys=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        xs.append(float(a)); ys.append(float(b))\n# sort top y\norder=sorted(range(len(ys)), key=lambda i: ys[i], reverse=True)[:30]\nprint('Top 30 intensities:')\nfor i in order:\n    print(i, xs[i], ys[i])\n# sort x ascending for smoothing\npts=sorted(zip(xs,ys))\n# simple moving average, print local maxima over every 50 points after smoothing\nwindow=41\nsm=[]\nfor i in range(len(pts)):\n    lo=max(0,i-window//2); hi=min(len(pts),i+window//2+1)\n    sm.append(sum(p[1] for p in pts[lo:hi])/(hi-lo))\npeaks=[]\nfor i in range(2,len(pts)-2):\n    if sm[i]>sm[i-1] and sm[i]>=sm[i+1]:\n        peaks.append((pts[i][0], pts[i][1], sm[i]))\n# filter local maxima in descending x; print top by smoothed height\npeaks_sorted=sorted(peaks, key=lambda t:t[2], reverse=True)\nprint('\\nTop smoothed local maxima:')\nfor p in peaks_sorted[:40]:\n    print(p)\nPY\n"]
