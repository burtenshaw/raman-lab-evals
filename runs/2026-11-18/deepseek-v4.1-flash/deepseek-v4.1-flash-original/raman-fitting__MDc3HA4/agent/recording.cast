[190.148642, "i", "python3 - <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nD=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        D.append((float(a),float(b)))\nD=np.array(sorted(D))\nx=D[:,0]; y=D[:,1]\n\ndef lor(x,x0,gamma,amp,off):\n    return off + amp*gamma**2/((x-x0)**2+gamma**2)\n\ndef lor_lin(x,x0,gamma,amp,a,b):\n    return a + b*(x-x0) + amp*gamma**2/((x-x0)**2+gamma**2)\n\n# fit G region with linear background\nfor lo,hi,name,p0 in [(16900,18100,'G',[17560,100,1000,18000,10]),\n                      (15900,16900,'2D',[16450,80,1000,17000,0])]:\n    m=(x>=lo)&(x<=hi)\n    xx=x[m]; yy=y[m]\n    try:\n        if name=='G':\n            popt,pcov=curve_fit(lor_lin,xx,yy,p0=p0,maxfev=100000)\n            print(name,'linear',popt)\n            print('rms',np.sqrt(np.mean((yy-lor_lin(xx,*popt))**2)))\n        else:\n            popt,pcov=curve_fit(lor,xx,yy,p0=p0,maxfev=100000)\n            print(name,'const',popt)\n            print('rms',np.sqrt(np.mean((yy-lor(xx,*popt))**2))"]
[190.148797, "i", ")\n    except Exception as e:\n        print(name,'ERR',e)\n\n# global 2 Lorentzians + linear background\nm=(x>=15800)&(x<=18200)\nxx=x[m]; yy=y[m]\ndef two_lor_lin(x,x01,g1,a1,x02,g2,a2,b0,b1):\n    return b0 + b1*(x-17000) + a1*g1**2/((x-x01)**2+g1**2) + a2*g2**2/((x-x02)**2+g2**2)\np0=[16450,100,1000,17560,200,3000,17000,1]\ntry:\n    popt,pcov=curve_fit(two_lor_lin,xx,yy,p0=p0,maxfev=200000)\n    print('global',popt)\n    print('rms',np.sqrt(np.mean((yy-two_lor_lin(xx,*popt))**2)))\nexcept Exception as e:\n    print('global ERR',e)\nPY\n"]
[190.148822, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
