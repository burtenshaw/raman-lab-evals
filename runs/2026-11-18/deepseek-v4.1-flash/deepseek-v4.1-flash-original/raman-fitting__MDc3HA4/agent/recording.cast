[277.475735, "i", "cat > /tmp/fit_explore.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nD=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        D.append((float(a),float(b)))\nD=np.array(sorted(D))\nx=D[:,0]; y=D[:,1]\n\ndef lor(x,x0,g,a,off):\n    return off + a*g*g/((x-x0)**2+g*g)\n\ndef lor_lin(x,x0,g,a,b0,b1):\n    return b0 + b1*(x-x0) + a*g*g/((x-x0)**2+g*g)\n\ndef fitwin(name, xx, yy, model, p0, bounds):\n    try:\n        popt,pcov=curve_fit(model, xx, yy, p0=p0, bounds=bounds, maxfev=200000)\n        rms=np.sqrt(np.mean((yy-model(xx,*popt))**2))\n        print(name, 'popt=', popt, 'rms=', rms)\n        return popt\n    except Exception as e:\n        print(name, 'ERR', e)\n        return None\n\nprint('RAW X INTERPRETATION')\n# 2D local maximum near 16245\nm=(x>=15800)&(x<=16900)\nfitwin('raw 2D const', x[m], y[m], lor, [16245,80,1000,16000], ([16000,20,0,0],[16800,500,5000,30000]))\nfitwin('raw 2D linear', x[m], y[m], lor_lin, [16245,80,1000,16000,0], ([16000,20,0,0,-"]
[277.475904, "i", "500],[16800,500,5000,30000,500]))\n# G region\nm=(x>=16800)&(x<=18200)\nfitwin('raw G const', x[m], y[m], lor, [17560,100,1000,18000], ([17000,20,0,0],[18100,1000,20000,30000]))\nfitwin('raw G linear', x[m], y[m], lor_lin, [17560,100,1000,18000,10], ([17000,20,0,0,-500],[18100,1000,20000,30000,500]))\n\nprint('\\nX/10 INTERPRETATION')\nx10=x/10.0\n# G near 1580 cm-1\nm=(x10>=1500)&(x10<=1650)\nfitwin('x10 G linear', x10[m], y[m], lor_lin, [1580,30,1000,17000,0], ([1500,5,0,0,-500],[1650,500,10000,30000,500]))\n# 2D near 2700 cm-1\nm=(x10>=2500)&(x10<=2950)\nfitwin('x10 2D linear', x10[m], y[m], lor_lin, [2700,100,1000,16000,0], ([2500,20,0,0,-500],[2950,1000,10000,30000,500]))\nPY\npython3 /tmp/fit_explore.py\n"]
