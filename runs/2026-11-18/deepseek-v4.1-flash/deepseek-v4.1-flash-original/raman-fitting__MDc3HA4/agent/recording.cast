[87.769385, "i", "python3 - <<'PY'\npts=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        pts.append((float(a),float(b)))\npts.sort()\nfor lo,hi in [(1500,1800),(2400,2900)]:\n    print('\\nREGION',lo,hi)\n    for x,y in pts:\n        if lo<=x<=hi:\n            print(f'{x:12.6f} {y:12.6f}')\nPY\n"]
