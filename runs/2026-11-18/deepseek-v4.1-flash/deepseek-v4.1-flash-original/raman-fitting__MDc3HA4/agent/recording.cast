[535.910134, "i", "python3 - <<'PY'\nimport numpy as np\nD=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        a,b=line.replace(',','.').split()\n        D.append((float(a),float(b)))\nD=np.array(sorted(D)); x=D[:,0]; y=D[:,1]\nfor lo,hi in [(15000,16500),(25000,30000)]:\n    m=(x>=lo)&(x<=hi)\n    print('\\nREGION',lo,hi,'n=',m.sum())\n    for xx,yy in zip(x[m],y[m]):\n        print(f'{xx:12.6f} {yy:12.6f}')\nPY\n"]
