[?2004l[?2004h>         x=xs[i]*scale
[?2004l[?2004h>         if not (lo<=x<=hi): continue
[?2004l[?2004h>         if sm[i]>=max(sm[i-10:i+11]):
[?2004l[?2004h>             left=min(sm[max(0,i-50):i] or [sm[i]])
[?2004l[?2004h>             right=min(sm[i+1:min(len(sm),i+51)] or [sm[i]])
[?2004l[?2004h>             prom=sm[i]-max(left,right)
[?2004l[?2004h>             if prom>5:
[?2004l[?2004h>                 cand.append((x,ys[i],sm[i],prom))
[?2004l[?2004h>     cand=sorted(cand,key=lambda t:t[2],reverse=True)
[?2004l[?2004h>     keep=[]
[?2004l[?2004h>     for c in cand:
[?2004l[?2004h>         if all(abs(c[0]-k[0])>20 for k in keep):
[?2004l[?2004h>             keep.append(c)
[?2004l[?2004h>     print('\nTop maxima for',name)
[?2004l[?2004h>     for x,y,s,p in keep[:25]:
[?2004l[?2004h>         print(f'x={x:10.2f} y={y:10.2f} smooth={s:10.2f} prom={p:8.2f}')
[?2004l[?2004h> 
