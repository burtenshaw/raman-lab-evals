[?2004l[?2004h>         if len(p)>=2:
[?2004l[?2004h>             arr.append((float(p[0]), float(p[1])))
[?2004l[?2004h> # ensure ascending for local max detection
[?2004l[?2004h> arr=sorted(arr)
[?2004l[?2004h> xs=[x for x,y in arr]; ys=[y for x,y in arr]
[?2004l[?2004h> # coarse bins of 200 cm^-1
[?2004l[?2004h> print('coarse max:')
[?2004l[?2004h> lo=min(xs); hi=max(xs)
[?2004l[?2004h> b=lo
[?2004l[?2004h> while b<hi:
[?2004l[?2004h>     vals=[y for x,y in arr if b<=x<b+200]
[?2004l[?2004h>     if vals:
[?2004l[?2004h>         print(f'{b:8.1f}-{b+200:8.1f}: n={len(vals):4d} max={max(vals):10.2f} mean={sum(vals)/len(vals):10.2f}')
[?2004l[?2004h>     b+=200
[?2004l[?2004h> # local maxima with simple window
[?2004l[?2004h> print('\nlocal maxima (prominence > 100):')
[?2004l[?2004h> peaks=[]
[?2004l[?2004h> for i in range(5,len(arr)-5):
[?2004l[?2004h>     if ys[i]==max(ys[i-5:i+6]):
[?2004l[?2004h>         base=min(ys[max(0,i-30):i]+ys[i+1:min(len(ys),i+31)])
[?2004l[?2004h>         prom=ys[i]-base
[?2004l[?2004h>         if prom>100:
[?2004l[?2004h>             peaks.append((xs[i],ys[i],prom))
[?2004l[?2004h> for x,y,p in sorted(peaks,key=lambda t:t[1],reverse=True)[:50]:
[?2004l[?2004h>     print(f'x={x:10.2f} y={y:10.2f} prom={p:10.2f}')
[?2004l[?2004h> # print values around likely 2D peak sorted
