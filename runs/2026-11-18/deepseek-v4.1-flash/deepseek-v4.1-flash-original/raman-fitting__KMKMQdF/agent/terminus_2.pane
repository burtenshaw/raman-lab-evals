[?2004l[?2004h> for mod in ['numpy','scipy','matplotlib','lmfit']:
[?2004l[?2004h>     try:
[?2004l[?2004h>         m=__import__(mod)
[?2004l[?2004h>         print(mod,'available',getattr(m,'__version__',''))
