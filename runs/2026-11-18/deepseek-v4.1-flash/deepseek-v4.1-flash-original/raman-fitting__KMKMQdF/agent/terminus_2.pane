[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c6-yt7dvijp-30681-wcvjb:/app# python3 - <<'PY'
[?2004l[?2004h> rows=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.replace(',','.').split()
[?2004l[?2004h>         if len(p)>=2:
[?2004l[?2004h>             rows.append((float(p[0])*0.1,float(p[1])))
[?2004l[?2004h> rows.sort()
[?2004l[?2004h> xs=[x for x,y in rows]; ys=[y for x,y in rows]
[?2004l[?2004h> # uniform grid
[?2004l[?2004h> step=1.0
[?2004l[?2004h> xmin=170.0; xmax=4710.0
[?2004l[?2004h> grid=[]
[?2004l[?2004h> x=xmin
[?2004l[?2004h> import bisect
[?2004l[?2004h> i=0
[?2004l[?2004h> while x<=xmax:
[?2004l[?2004h>     while i+1<len(xs) and xs[i+1]<x: i+=1
[?2004l[?2004h>     if i+1>=len(xs): break
[?2004l[?2004h>     t=(x-xs[i])/(xs[i+1]-xs[i])
[?2004l[?2004h>     grid.append((x,ys[i]+t*(ys[i+1]-ys[i])))
[?2004l[?2004h>     x+=step
[?2004l[?2004h> # smooth moving average 9
[?2004l[?2004h> gy=[y for x,y in grid]
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(gy)):
[?2004l[?2004h>     a=max(0,i-4); b=min(len(gy),i+5)
[?2004l[?2004h>     sm.append(sum(gy[a:b])/(b-a))
[?2004l[?2004h> # rolling median baseline window 101
[?2004l[?2004h> base=[]
[?2004l[?2004h> for i in range(len(sm)):
[?2004l[?2004h>     a=max(0,i-50); b=min(len(sm),i+51)
[?2004l[?2004h>     w=sorted(sm[a:b]); base.append(w[len(w)//2])
[?2004l[?2004h> corr=[sm[i]-base[i] for i in range(len(sm))]
[?2004l[?2004h> # local maxima on corr
[?2004l[?2004h> cand=[]
[?2004l[?2004h> for i in range(5,len(corr)-5):
[?2004l[?2004h>     if corr[i]>=max(corr[i-5:i+6]):
[?2004l[?2004h>         left=min(corr[max(0,i-100):i] or [corr[i]])
[?2004l[?2004h>         right=min(corr[i+1:min(len(corr),i+101)] or [corr[i]])
[?2004l[?2004h>         prom=corr[i]-max(left,right)
[?2004l[?2004h>         if prom>10:
[?2004l[?2004h>             cand.append((grid[i][0],corr[i],prom,gy[i],base[i]))
[?2004l[?2004h> cand=sorted(cand,key=lambda t:t[2],reverse=True)
[?2004l[?2004h> keep=[]
[?2004l[?2004h> for c in cand:
[?2004l[?2004h>     if all(abs(c[0]-k[0])>15 for k in keep):
[?2004l[?2004h>         keep.append(c)
[?2004l[?2004h> print('top baseline-corrected maxima (x, corr, prom, raw y, base):')
[?2004l[?2004h> for c in keep[:30]:
[?2004l[?2004h>     print(f'x={c[0]:8.2f} corr={c[1]:9.1f} prom={c[2]:9.1f} y={c[3]:10.1f} base={c[4]:9.1f}')
[?2004l[?2004h> PY
