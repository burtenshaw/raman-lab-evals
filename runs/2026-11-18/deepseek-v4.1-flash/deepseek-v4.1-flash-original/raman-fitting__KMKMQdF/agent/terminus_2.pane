[?2004l[?2004h>     reg=[(x,y) for x,y in arr if center-50<x<center+50]
[?2004l[?2004h>     if reg:
[?2004l[?2004h>         for x,y in reg:
[?2004l[?2004h>             print(f'{x:9.2f} {y:10.2f}')
