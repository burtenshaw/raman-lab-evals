[?2004hroot@j-openenv-6afd86eb884144d2f44fd3c6-yt7dvijp-30681-wcvjb:/app# python3 - <<'PY'
[?2004l[?2004h> arr=[]
[?2004l[?2004h> with open('graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.replace(',','.').split()
[?2004l[?2004h>         if len(p)>=2:
[?2004l[?2004h>             arr.append((float(p[0]),float(p[1])))
[?2004l[?2004h> arr.sort()
[?2004l[?2004h> xs=[x for x,y in arr]; ys=[y for x,y in arr]
[?2004l[?2004h> w=5
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(ys)):
[?2004l[?2004h>     a=max(0,i-w//2); b=min(len(ys),i+w//2+1)
[?2004l[?2004h>     sm.append(sum(ys[a:b])/(b-a))
[?2004l[?2004h> for scale,name in [(0.25,'/4'),(0.1,'/10')]:
[?2004l[?2004h>     print('\n=== scaling',name,'===')
[?2004l[?2004h>     cand=[]
[?2004l[?2004h>     for i in range(10,len(arr)-10):
[?2004l[?2004h>         if sm[i]>=max(sm[i-10:i+11]):
[?2004l[?2004h>             left=min(sm[max(0,i-100):i] or [sm[i]])
[?2004l[?2004h>             right=min(sm[i+1:min(len(sm),i+101)] or [sm[i]])
[?2004l[?2004h>             prom=sm[i]-max(left,right)
[?2004l[?2004h>             if prom>10:
[?2004l[?2004h>                 cand.append((xs[i]*scale,ys[i],sm[i],prom,xs[i]))
[?2004l[?2004h>     cand=sorted(cand,key=lambda t:t[2],reverse=True)
[?2004l[?2004h>     keep=[]
[?2004l[?2004h>     for c in cand:
[?2004l[?2004h>         if all(abs(c[0]-k[0])>20 for k in keep):
[?2004l[?2004h>             keep.append(c)
[?2004l[?2004h>     for c in keep[:20]:
[?2004l[?2004h>         print(f'x={c[0]:8.2f} y={c[1]:9.1f} sm={c[2]:9.1f} prom={c[3]:8.1f} raw={c[4]:9.2f}')
[?2004l[?2004h> print('\n=== data near G candidates ===')
[?2004l[?2004h> for lo,hi in [(6200,6500),(15500,16500)]:
[?2004l[?2004h>     print('raw window',lo,hi)
[?2004l[?2004h>     for x,y in arr:
[?2004l[?2004h>         if lo<=x<=hi:
[?2004l[?2004h>             print(f'{x:9.2f} /4={x/4:8.2f} /10={x/10:8.2f} y={y:9.2f}')
[?2004l[?2004h> print('\n=== data near 2D candidates ===')
[?2004l[?2004h> for lo,hi in [(10300,10800),(26200,26800)]:
[?2004l[?2004h>     print('raw window',lo,hi)
[?2004l[?2004h>     for x,y in arr:
[?2004l[?2004h>         if lo<=x<=hi:
[?2004l[?2004h>             print(f'{x:9.2f} /4={x/4:8.2f} /10={x/10:8.2f} y={y:9.2f}')
[?2004l[?2004h> PY
