[215.120784, "i", "python3 - <<'PY'\nrows=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            rows.append((float(p[0])*0.1,float(p[1])))\nrows.sort()\nfor lo,hi in [(1500,1750),(2400,3000)]:\n    print(f'\\n=== {lo}-{hi} cm^-1, 10 cm^-1 bins ===')\n    b=lo\n    while b<hi:\n        vals=[y for x,y in rows if b<=x<b+10]\n        if vals:\n            print(f'{b:6.1f}-{b+10:6.1f}: n={len(vals):3d} mean={sum(vals)/len(vals):9.1f} max={max(vals):9.1f}')\n        b+=10\nPY\n"]
