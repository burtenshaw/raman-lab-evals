[68.361338, "i", "python3 - <<'PY'\nfor mod in ['numpy','scipy','matplotlib','lmfit']:\n    try:\n        m=__import__(mod)\n        print(mod,'available',getattr(m,'__version__',''))\n    except Exception as e:\n        print(mod,'NOT available:',e)\nPY\n"]
[68.361478, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[68.361544, "o", "\u001b[?2004h> "]
[68.361649, "o", "for mod in ['numpy','scipy','matplotlib','lmfit']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.361711, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
