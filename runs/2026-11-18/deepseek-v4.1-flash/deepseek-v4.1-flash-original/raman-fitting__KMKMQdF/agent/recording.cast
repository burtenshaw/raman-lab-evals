[612.9404, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]),float(p[1])))\narr.sort()\nfor lo,hi in [(5600,7200),(9500,11600)]:\n    print(f'\\n=== raw {lo}-{hi} (x/4) ===')\n    for x,y in arr:\n        if lo<=x<=hi:\n            print(f'raw={x:10.3f} x4={x/4:8.3f} y={y:10.3f}')\nPY\n"]
[612.940565, "o", "python3 - <<'PY'"]
