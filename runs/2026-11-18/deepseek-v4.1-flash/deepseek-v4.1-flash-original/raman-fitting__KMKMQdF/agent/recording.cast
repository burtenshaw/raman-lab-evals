[170.299812, "i", "python3 - <<'PY'\nrows=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            rows.append((float(p[0]),float(p[1])))\n\nfor label,xidx,yidx,scale in [('A col1/10 x, col2 y',0,1,0.1),('B col2/10 x, col1 y',1,0,0.1)]:\n    arr=sorted((r[xidx]*scale, r[yidx]) for r in rows)\n    print('\\n===',label,'===')\n    for lo in range(1000,3500,50):\n        vals=[y for x,y in arr if lo<=x<lo+50]\n        if vals:\n            print(f'{lo:4d}-{lo+50:4d}: n={len(vals):4d} mean={sum(vals)/len(vals):9.1f} max={max(vals):9.1f}')\nPY\n"]
