[642.285495, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]),float(p[1])))\narr.sort()\nfor name,lo,hi in [('G',5900,6700),('2D',9900,11300)]:\n    print(f'\\n=== {name} raw {lo}-{hi} (x=raw/4) ===')\n    for x,y in arr:\n        if lo<=x<=hi:\n            print(f'{x:9.2f} {x/4:8.2f} {y:9.2f}')\nPY\n"]
