[494.308884, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]),float(p[1])))\narr=sorted(arr)\nxs=[x for x,y in arr]; ys=[y for x,y in arr]\nw=5\nsm=[]\nfor i in range(len(ys)):\n    a=max(0,i-w//2); b=min(len(ys),i+w//2+1)\n    sm.append(sum(ys[a:b])/(b-a))\nprint('local maxima in raw 15000-20000:')\nfor i in range(5,len(arr)-5):\n    if 15000<=xs[i]<=20000 and sm[i]>=max(sm[i-5:i+6]):\n        left=min(sm[max(0,i-100):i] or [sm[i]])\n        right=min(sm[i+1:min(len(sm),i+101)] or [sm[i]])\n        prom=sm[i]-max(left,right)\n        if prom>20:\n            print(f'x={xs[i]:10.2f} y={ys[i]:10.2f} sm={sm[i]:10.2f} prom={prom:10.2f}')\n# print data around region, every 3rd point\nprint('\\ndata raw 15800-18400:')\nreg=[(x,y) for x,y in arr if 15800<=x<=18400]\nstep=max(1,len(reg)//100)\nfor x,y in reg[::step]:\n    print(f'{x:10.2f} {y:10.2f}')\nPY\n"]
