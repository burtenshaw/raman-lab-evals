[276.50475, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]),float(p[1])))\narr=sorted(arr)\nfor lo,hi in [(19000,19500),(15500,18000),(25000,28000)]:\n    print(f'\\n=== raw x {lo}-{hi} ===')\n    reg=[(x,y) for x,y in arr if lo<=x<=hi]\n    # print every point if small, else every ~5\n    step=max(1,len(reg)//80)\n    for x,y in reg[::step]:\n        print(f'{x:10.2f} {y:10.2f}')\nPY\n"]
[276.505046, "o", "python3 - <<'PY'"]
