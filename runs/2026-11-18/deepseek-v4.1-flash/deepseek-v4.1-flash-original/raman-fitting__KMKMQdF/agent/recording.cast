[444.073846, "i", "python3 - <<'PY'\nrows=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            rows.append((float(p[0])*0.1,float(p[1])))\nrows.sort()\nxs=[x for x,y in rows]; ys=[y for x,y in rows]\n# uniform grid\nstep=1.0\nxmin=170.0; xmax=4710.0\ngrid=[]\nx=xmin\nimport bisect\ni=0\nwhile x<=xmax:\n    while i+1<len(xs) and xs[i+1]<x: i+=1\n    if i+1>=len(xs): break\n    t=(x-xs[i])/(xs[i+1]-xs[i])\n    grid.append((x,ys[i]+t*(ys[i+1]-ys[i])))\n    x+=step\n# smooth moving average 9\ngy=[y for x,y in grid]\nsm=[]\nfor i in range(len(gy)):\n    a=max(0,i-4); b=min(len(gy),i+5)\n    sm.append(sum(gy[a:b])/(b-a))\n# rolling median baseline window 101\nbase=[]\nfor i in range(len(sm)):\n    a=max(0,i-50); b=min(len(sm),i+51)\n    w=sorted(sm[a:b]); base.append(w[len(w)//2])\ncorr=[sm[i]-base[i] for i in range(len(sm))]\n# local maxima on corr\ncand=[]\nfor i in range(5,len(corr)-5):\n    if corr[i]>=max(corr[i-5:i+6]):\n        left=min(corr[max(0,i-100):i] or [corr[i]])\n        right="]
[444.073885, "i", "min(corr[i+1:min(len(corr),i+101)] or [corr[i]])\n        prom=corr[i]-max(left,right)\n        if prom>10:\n            cand.append((grid[i][0],corr[i],prom,gy[i],base[i]))\ncand=sorted(cand,key=lambda t:t[2],reverse=True)\nkeep=[]\nfor c in cand:\n    if all(abs(c[0]-k[0])>15 for k in keep):\n        keep.append(c)\nprint('top baseline-corrected maxima (x, corr, prom, raw y, base):')\nfor c in keep[:30]:\n    print(f'x={c[0]:8.2f} corr={c[1]:9.1f} prom={c[2]:9.1f} y={c[3]:10.1f} base={c[4]:9.1f}')\nPY\n"]
