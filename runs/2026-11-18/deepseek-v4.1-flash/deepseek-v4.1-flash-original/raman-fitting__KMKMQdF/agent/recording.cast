[858.766448, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]),float(p[1])))\narr.sort()\nfor name,lo,hi in [('G',5900,6700),('2D',9900,11200)]:\n    print('\\n===',name,'raw',lo,hi,'===')\n    reg=[(x,y) for x,y in arr if lo<=x<=hi]\n    print('n',len(reg))\n    for x,y in reg:\n        print(f'{x:9.2f} {x/4:8.2f} {y:9.2f}')\nPY\n"]
[858.766593, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[858.766653, "o", "\u001b[?2004h> arr=[]\r\n"]
