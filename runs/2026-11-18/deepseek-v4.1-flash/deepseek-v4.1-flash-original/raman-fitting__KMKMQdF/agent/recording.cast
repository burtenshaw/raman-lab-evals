[116.953594, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]),float(p[1])))\narr=sorted(arr)\nxs=[x for x,y in arr]; ys=[y for x,y in arr]\n# smoothed\nw=7\nsm=[]\nfor i in range(len(ys)):\n    a=max(0,i-w//2); b=min(len(ys),i+w//2+1)\n    sm.append(sum(ys[a:b])/(b-a))\n# local maxima in scaled region\nfor scale,name,lo,hi in [(0.1,'x/10',1200,3200),(1.0,'raw',0,50000)]:\n    cand=[]\n    for i in range(10,len(arr)-10):\n        x=xs[i]*scale\n        if not (lo<=x<=hi): continue\n        if sm[i]>=max(sm[i-10:i+11]):\n            left=min(sm[max(0,i-50):i] or [sm[i]])\n            right=min(sm[i+1:min(len(sm),i+51)] or [sm[i]])\n            prom=sm[i]-max(left,right)\n            if prom>5:\n                cand.append((x,ys[i],sm[i],prom))\n    cand=sorted(cand,key=lambda t:t[2],reverse=True)\n    keep=[]\n    for c in cand:\n        if all(abs(c[0]-k[0])>20 for k in keep):\n            keep.append(c)\n    print('\\nTop maxi"]
[116.953802, "i", "ma for',name)\n    for x,y,s,p in keep[:25]:\n        print(f'x={x:10.2f} y={y:10.2f} smooth={s:10.2f} prom={p:8.2f}')\n\n# data around raw positions corresponding to G and 2D if x/10\nfor target in [1580,2700]:\n    print('\\n--- raw x around',target*10,'(scaled',target,') ---')\n    reg=[(x,y) for x,y in arr if target*10-1000<x<target*10+1000]\n    if not reg:\n        print('none')\n        continue\n    step=max(1,len(reg)//20)\n    for x,y in reg[::step]:\n        print(f'raw={x:10.2f} scaled={x/10:8.2f} y={y:10.2f}')\nPY\n"]
[116.953926, "o", "python3 - <<'PY'\r\n\u001b[?2004l\rma for',name)\r\n    for x,y,s,p in keep[:25]:\r\n        print(f'x={x:10.2f} y={y:10.2f} smooth={s:10.2f} prom={p:8.2f}')\r\n\r\n# data around raw positions corresponding to G and 2D if x/10\r\nfor target in [1580,2700]:\r\n    print('\\n--- raw x around',target*10,'(scaled',target,') ---')\r\n    reg=[(x,y) for x,y in arr if target*10-1000<x<target*10+1000]\r\n    if not reg:\r\n        print('none')\r\n        continue\r\n    step=max(1,len(reg)//20)\r\n    for x,y in reg[::step]:\r\n        print(f'raw={x:10.2f} scaled={x/10:8.2f} y={y:10.2f}')\r\nPY\r\n\u001b[?2004h> arr=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
