[17.454962, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]), float(p[1])))\nprint('n',len(arr))\nprint('x range',min(x for x,y in arr),max(x for x,y in arr),'decreasing?',arr[0][0]>arr[-1][0])\nprint('y range',min(y for x,y in arr),max(y for x,y in arr))\nfor center in [2700,1580]:\n    reg=[(x,y) for x,y in arr if center-100<x<center+100]\n    print('\\nregion',center,'n',len(reg),'max y',max(y for x,y in reg) if reg else None)\n    step=max(1,len(reg)//15)\n    for x,y in reg[::step]:\n        print(f'{x:.2f} {y:.2f}')\nPY\n"]
