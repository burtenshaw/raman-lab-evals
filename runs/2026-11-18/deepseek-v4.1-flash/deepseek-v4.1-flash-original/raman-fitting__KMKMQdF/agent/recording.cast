[786.781321, "i", "python3 - <<'PY'\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append((float(p[0]),float(p[1])))\narr.sort()\nxs=[x for x,y in arr]; ys=[y for x,y in arr]\nw=5\nsm=[]\nfor i in range(len(ys)):\n    a=max(0,i-w//2); b=min(len(ys),i+w//2+1)\n    sm.append(sum(ys[a:b])/(b-a))\nfor scale,name in [(0.25,'/4'),(0.1,'/10')]:\n    print('\\n=== scaling',name,'===')\n    cand=[]\n    for i in range(10,len(arr)-10):\n        if sm[i]>=max(sm[i-10:i+11]):\n            left=min(sm[max(0,i-100):i] or [sm[i]])\n            right=min(sm[i+1:min(len(sm),i+101)] or [sm[i]])\n            prom=sm[i]-max(left,right)\n            if prom>10:\n                cand.append((xs[i]*scale,ys[i],sm[i],prom,xs[i]))\n    cand=sorted(cand,key=lambda t:t[2],reverse=True)\n    keep=[]\n    for c in cand:\n        if all(abs(c[0]-k[0])>20 for k in keep):\n            keep.append(c)\n    for c in keep[:20]:\n        print(f'x={c[0]:8.2f} y={c[1]:9.1f} sm={c[2]:9.1f} prom={c[3]:8."]
[786.781463, "i", "1f} raw={c[4]:9.2f}')\nprint('\\n=== data near G candidates ===')\nfor lo,hi in [(6200,6500),(15500,16500)]:\n    print('raw window',lo,hi)\n    for x,y in arr:\n        if lo<=x<=hi:\n            print(f'{x:9.2f} /4={x/4:8.2f} /10={x/10:8.2f} y={y:9.2f}')\nprint('\\n=== data near 2D candidates ===')\nfor lo,hi in [(10300,10800),(26200,26800)]:\n    print('raw window',lo,hi)\n    for x,y in arr:\n        if lo<=x<=hi:\n            print(f'{x:9.2f} /4={x/4:8.2f} /10={x/10:8.2f} y={y:9.2f}')\nPY\n"]
