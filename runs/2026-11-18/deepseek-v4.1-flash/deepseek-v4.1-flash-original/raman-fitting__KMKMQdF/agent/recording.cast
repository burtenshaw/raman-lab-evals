[546.970217, "i", "python3 - <<'PY'\nrows=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            rows.append((float(p[0])*0.1,float(p[1])))\nrows.sort()\nxs=[x for x,y in rows]; ys=[y for x,y in rows]\n# interpolate onto 1 cm^-1 grid\ngrid=[]\ni=0\nx=1000.0\nwhile x<=3200.0:\n    while i+1<len(xs) and xs[i+1]<x: i+=1\n    if i+1>=len(xs): break\n    t=(x-xs[i])/(xs[i+1]-xs[i])\n    grid.append((x,ys[i]+t*(ys[i+1]-ys[i])))\n    x+=1.0\ngx=[p[0] for p in grid]; gy=[p[1] for p in grid]\n# smooth 9 pt moving average\nsm=[]\nfor i in range(len(gy)):\n    a=max(0,i-4); b=min(len(gy),i+5)\n    sm.append(sum(gy[a:b])/(b-a))\n# rolling median baseline window 151 cm^-1\nbase=[]\nfor i in range(len(sm)):\n    a=max(0,i-75); b=min(len(sm),i+76)\n    w=sorted(sm[a:b]); base.append(w[len(w)//2])\ncorr=[sm[i]-base[i] for i in range(len(sm))]\n# local maxima\ncand=[]\nfor i in range(3,len(corr)-3):\n    if corr[i]>=max(corr[i-3:i+4]):\n        left=min(corr[max(0,i-100):i] or [corr[i]])\n        right="]
[546.970398, "i", "min(corr[i+1:min(len(corr),i+101)] or [corr[i]])\n        prom=corr[i]-max(left,right)\n        if prom>2:\n            cand.append((gx[i],corr[i],prom,gy[i],base[i]))\ncand=sorted(cand,key=lambda t:t[2],reverse=True)\nkeep=[]\nfor c in cand:\n    if all(abs(c[0]-k[0])>20 for k in keep):\n        keep.append(c)\nprint('candidate peaks:')\nfor c in keep[:40]:\n    print(f'x={c[0]:8.1f} corr={c[1]:8.2f} prom={c[2]:8.2f} y={c[3]:9.1f} base={c[4]:9.1f}')\nPY\n"]
[546.970447, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> rows=[]\r\n\u001b[?2004l\rmin(corr[i+1:min(len(corr),i+101)] or [corr[i]])\r\n        prom=corr[i]-max(left,right)\r\n        if prom>2:\r\n            cand.append((gx[i],corr[i],prom,gy[i],base[i]))\r\ncand=sorted(cand,key=lambda t:t[2],reverse=True)\r\nkeep=[]\r\nfor c in cand:\r\n   "]
