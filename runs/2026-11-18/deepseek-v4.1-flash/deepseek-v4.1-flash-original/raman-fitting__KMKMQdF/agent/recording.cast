[68.36179, "o", "\u001b[?2004h> "]
[68.361911, "o", "        print(mod,'available',getattr(m,'__version__',''))\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.361945, "o", "> "]
[68.361999, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
