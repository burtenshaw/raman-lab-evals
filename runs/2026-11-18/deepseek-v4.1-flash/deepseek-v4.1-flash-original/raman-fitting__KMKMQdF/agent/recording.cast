[12.472628, "i", "python3 - <<'PY'\nimport numpy as np\narr=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            arr.append([float(p[0]), float(p[1])])\na=np.array(arr)\nprint('shape',a.shape)\nprint('x range',a[:,0].min(),a[:,0].max(),'decreasing?',a[0,0]>a[-1,0])\nprint('y range',a[:,1].min(),a[:,1].max())\nfor center in [2700,1580]:\n    m=(a[:,0]>center-50)&(a[:,0]<center+50)\n    print('region',center,'n',m.sum(),'max y',a[m,1].max() if m.any() else None)\n    for x,y in a[m][::max(1,m.sum()//10)]:\n        print(f'{x:.2f} {y:.2f}')\nPY\n"]
