[74.246907, "o", "\u001b[?2004hroot@j-openenv-6afd8abee5cad0e4dc3e6bcb-r1lw3l2h-8b533-zrn8h:/app# "]
[85.665401, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, half_window=150):\n    m = (x > center - half_window) & (x < center + half_window)\n    xs, ys = x[m], y[m]\n    off0 = float(ys.min())\n    amp0 = float(ys.max() - ys.min())\n    x00 = float(xs[np.argmax(ys)])\n    p0 = [amp0, x00, 15.0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)\n    amplitude, x0, gamma, offset = popt\n    return {\n        'x0': float(x0),\n        'gamma': float(abs(gamma)),\n        'amplitude': float(amplitude),\n        'offset': float(offset),\n    }\n\nres = {\n    'D': fit_peak(1350),\n    'G': fit_peak(1580),\n    '2D': fit_peak(2690),\n}\nres['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    "]
[85.665534, "i", "json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"]
