[70.661741, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, half_window=120.0):\n    m = (x > center - half_window) & (x < center + half_window)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    i = int(np.argmax(ys))\n    x00 = float(xs[i])\n    amp0 = float(ys[i] - off0)\n    gamma0 = 15.0\n    p0 = [amp0, x00, gamma0, off0]\n    bounds = ([0, center - half_window, 0.1, -np.inf],\n              [np.inf, center + half_window, half_window, np.inf])\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    amp, x0, gamma, off = popt\n    return {'x0': float(x0), 'gamma': float(gamma),\n            'amplitude': float(amp), 'offset': float(off)}\n\nresults = {\n    'D': fit_peak(1350.0),\n    'G': fit_peak(1580.0),\n    '2D': "]
[70.661857, "i", "fit_peak(2690.0, half_window=150.0),\n}\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nEOF\n"]
[70.661928, "o", "cat > /app/fit.py << 'EOF'\r\n"]
