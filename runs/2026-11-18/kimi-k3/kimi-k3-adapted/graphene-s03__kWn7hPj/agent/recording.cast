[60.751419, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwin):\n    m = (x >= center - halfwin) & (x <= center + halfwin)\n    xs, ys = x[m], y[m]\n    off0 = ys.min()\n    x00 = xs[np.argmax(ys)]\n    amp0 = ys.max() - off0\n    gamma0 = 10.0\n    p0 = [x00, gamma0, amp0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)\n    x0, gamma, amp, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gamma)), 'amplitude': float(amp), 'offset': float(off)}\n\nresults = {\n    'D': fit_peak(1350, 100),\n    'G': fit_peak(1580, 100),\n    '2D': fit_peak(2690, 150),\n}\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.du"]
[60.751561, "i", "mps(results, indent=2))\nEOF\n"]
