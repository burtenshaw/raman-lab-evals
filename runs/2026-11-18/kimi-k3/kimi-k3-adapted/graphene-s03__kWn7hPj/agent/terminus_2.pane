[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, halfwin):
[?2004l[?2004h>     m = (x >= center - halfwin) & (x <= center + halfwin)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = ys.min()
[?2004l[?2004h>     x00 = xs[np.argmax(ys)]
[?2004l[?2004h>     amp0 = ys.max() - off0
[?2004l[?2004h>     gamma0 = 10.0
[?2004l[?2004h>     p0 = [x00, gamma0, amp0, off0]
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)
[?2004l[?2004h>     x0, gamma, amp, off = popt
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(abs(gamma)), 'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> results = {
[?2004l[?2004h>     'D': fit_peak(1350, 100),
[?2004l[?2004h>     'G': fit_peak(1580, 100),
[?2004l[?2004h>     '2D': fit_peak(2690, 150),
[?2004l[?2004h> }
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
