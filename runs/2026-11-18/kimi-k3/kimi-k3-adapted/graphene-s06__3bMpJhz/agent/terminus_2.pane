[?2004hroot@j-openenv-6afd89ea29e8b7ccfbbb8173-m3gwrjek-30f81-gng7s:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(xlo, xhi):
[?2004l[?2004h>     m = (x >= xlo) & (x <= xhi)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(yw))
[?2004l[?2004h>     amp0 = float(np.max(yw) - off0)
[?2004l[?2004h>     x00 = float(xw[np.argmax(yw)])
[?2004l[?2004h>     p0 = [amp0, x00, 15.0, off0]
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)
[?2004l[?2004h>     amp, x0, gamma, off = popt
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(abs(gamma)),
[?2004l[?2004h>             'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> results = {
[?2004l[?2004h>     'D': fit_peak(1250, 1450),
[?2004l[?2004h>     'G': fit_peak(1500, 1650),
[?2004l[?2004h>     '2D': fit_peak(2550, 2850),
[?2004l[?2004h> }
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
