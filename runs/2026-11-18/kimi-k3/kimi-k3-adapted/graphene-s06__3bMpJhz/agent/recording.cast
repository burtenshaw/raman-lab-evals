[88.468022, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(xlo, xhi):\n    m = (x >= xlo) & (x <= xhi)\n    xw, yw = x[m], y[m]\n    off0 = float(np.min(yw))\n    amp0 = float(np.max(yw) - off0)\n    x00 = float(xw[np.argmax(yw)])\n    p0 = [amp0, x00, 15.0, off0]\n    popt, _ = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\n    amp, x0, gamma, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gamma)),\n            'amplitude': float(amp), 'offset': float(off)}\n\nresults = {\n    'D': fit_peak(1250, 1450),\n    'G': fit_peak(1500, 1650),\n    '2D': fit_peak(2550, 2850),\n}\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, "]
[88.468176, "i", "indent=2))\nEOF\n"]
