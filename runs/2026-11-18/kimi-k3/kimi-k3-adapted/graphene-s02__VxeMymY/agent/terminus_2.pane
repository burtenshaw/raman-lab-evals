[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, halfwidth):
[?2004l[?2004h>     m = (x >= center - halfwidth) & (x <= center + halfwidth)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(ys))
[?2004l[?2004h>     i = int(np.argmax(ys))
[?2004l[?2004h>     x00 = float(xs[i])
[?2004l[?2004h>     amp0 = float(ys[i] - off0)
[?2004l[?2004h>     g0 = 15.0
[?2004l[?2004h>     p0 = [amp0, x00, g0, off0]
[?2004l[?2004h>     bounds = ([0, center - halfwidth, 0.1, -np.inf],
[?2004l[?2004h>               [np.inf, center + halfwidth, halfwidth * 2, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     amp, x0, gam, off = popt
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(abs(gam)), 'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> res = {}
[?2004l[?2004h> res['D'] = fit_peak(1350, 100)
[?2004l[?2004h> res['G'] = fit_peak(1580, 100)
[?2004l[?2004h> res['2D'] = fit_peak(2690, 150)
[?2004l[?2004h> res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(res, f, indent=2)
