[?2004hroot@j-openenv-6afd88e7e5cad0e4dc3e693d-yev40w6b-45d5b-lcljb:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, halfwin):
[?2004l[?2004h>     m = (x >= center - halfwin) & (x <= center + halfwin)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(ys))
[?2004l[?2004h>     amp0 = float(np.max(ys) - off0)
[?2004l[?2004h>     x00 = float(xs[np.argmax(ys)])
[?2004l[?2004h>     p0 = [amp0, x00, 10.0, off0]
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)
[?2004l[?2004h>     amp, x0, gam, off = popt
[?2004l[?2004h>     gam = abs(gam)
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> results['D'] = fit_peak(1350.0, 100.0)
[?2004l[?2004h> results['G'] = fit_peak(1580.0, 100.0)
[?2004l[?2004h> results['2D'] = fit_peak(2690.0, 150.0)
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
