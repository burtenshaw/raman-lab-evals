[84.590252, "o", "\u001b[?2004hroot@j-openenv-6afd89b8e5cad0e4dc3e69f2-nb8sossu-1385f-l5fh7:/app# "]
[89.242091, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window):\n    m = (x >= center - window) & (x <= center + window)\n    xs, ys = x[m], y[m]\n    off0 = ys.min()\n    i = ys.argmax()\n    amp0 = ys[i] - off0\n    x00 = xs[i]\n    half = off0 + amp0 / 2.0\n    above = xs[ys >= half]\n    fwhm0 = max(above.max() - above.min(), 5.0) if above.size >= 2 else 20.0\n    p0 = [amp0, x00, fwhm0 / 2.0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=200000)\n    amp, x0, gamma, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gamma)),\n            'amplitude': float(amp), 'offset': float(off)}\n\nres = {\n    'D': fit_peak(1350.0, 150.0),\n    'G': fit_peak(1580.0, 150.0),\n    '2D': fit_peak(2690.0, 200.0),\n}\nres['ID_IG'] = res['D']"]
[89.242154, "i", "['amplitude'] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"]
