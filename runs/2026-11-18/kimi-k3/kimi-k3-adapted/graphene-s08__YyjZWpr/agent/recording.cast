[78.575296, "o", "\u001b[?2004hroot@j-openenv-6afd8acee5cad0e4dc3e6bd1-tm5fnrxz-10ca5-wgztj:/app# "]
[98.156324, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=100.0):\n    m = (x >= center - window) & (x <= center + window)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    amp0 = float(np.max(ys) - off0)\n    x00 = float(xs[np.argmax(ys)])\n    # estimate FWHM\n    half = off0 + amp0 / 2.0\n    above = xs[ys >= half]\n    fwhm = float(above.max() - above.min()) if len(above) > 1 else 20.0\n    g0 = max(fwhm / 2.0, 1.0)\n    p0 = [amp0, x00, g0, off0]\n    bounds = ([0.0, xs.min(), 0.1, -np.inf], [np.inf, xs.max(), window, np.inf])\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    return {'x0': float(popt[1]), 'gamma': float(popt[2]),\n            'amplitude': float(popt[0]), 'offset': float(popt[3])}\n\n"]
[98.156496, "i", "res = {'D': fit_peak(1350.0), 'G': fit_peak(1580.0), '2D': fit_peak(2690.0)}\nres['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"]
[98.156581, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
