[?2004hroot@j-openenv-6afd8acee5cad0e4dc3e6bd1-tm5fnrxz-10ca5-wgztj:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, window=100.0):
[?2004l[?2004h>     m = (x >= center - window) & (x <= center + window)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(ys))
[?2004l[?2004h>     amp0 = float(np.max(ys) - off0)
[?2004l[?2004h>     x00 = float(xs[np.argmax(ys)])
[?2004l[?2004h>     # estimate FWHM
[?2004l[?2004h>     half = off0 + amp0 / 2.0
[?2004l[?2004h>     above = xs[ys >= half]
[?2004l[?2004h>     fwhm = float(above.max() - above.min()) if len(above) > 1 else 20.0
[?2004l[?2004h>     g0 = max(fwhm / 2.0, 1.0)
[?2004l[?2004h>     p0 = [amp0, x00, g0, off0]
[?2004l[?2004h>     bounds = ([0.0, xs.min(), 0.1, -np.inf], [np.inf, xs.max(), window, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     return {'x0': float(popt[1]), 'gamma': float(popt[2]),
[?2004l[?2004h>             'amplitude': float(popt[0]), 'offset': float(popt[3])}
[?2004l[?2004h> 
[?2004l[?2004h> res = {'D': fit_peak(1350.0), 'G': fit_peak(1580.0), '2D': fit_peak(2690.0)}
[?2004l[?2004h> res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(res, f, indent=2)
[?2004l[?2004h> print(json.dumps(res, indent=2))
[?2004l[?2004h> EOF
