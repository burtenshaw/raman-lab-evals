[47.699656, "o", "\u001b[?2004hroot@j-openenv-6afd8a1f29e8b7ccfbbb819a-yx6iww8l-23fbf-vzxqb:/app# "]
[65.795189, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwidth):\n    m = (x > center - halfwidth) & (x < center + halfwidth)\n    xs, ys = x[m], y[m]\n    off0 = float(ys.min())\n    amp0 = float(ys.max() - ys.min())\n    x00 = float(xs[np.argmax(ys)])\n    g0 = 15.0\n    p0 = [amp0, x00, g0, off0]\n    bounds = ([0, center - halfwidth, 0.1, -np.inf],\n              [np.inf, center + halfwidth, halfwidth, np.inf])\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    a, x0, g, off = popt\n    return {'x0': float(x0), 'gamma': float(g), 'amplitude': float(a), 'offset': float(off)}\n\nres = {\n    'D': fit_peak(1350, 120),\n    'G': fit_peak(1580, 120),\n    '2D': fit_peak(2690, 150),\n}\nres['ID_IG'] = res['D']['amplitude'"]
[65.795316, "i", "] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"]
[65.795387, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
[65.795421, "o", "\u001b[?2004h"]
