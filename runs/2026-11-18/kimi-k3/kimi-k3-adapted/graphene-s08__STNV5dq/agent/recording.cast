[65.797454, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.797481, "o", "> "]
[65.797542, "o", "res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\r\n\u001b[?2004l\r"]
[65.797574, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[65.797606, "o", "\u001b[?2004h"]
[65.79764, "o", "> "]
[65.797713, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
