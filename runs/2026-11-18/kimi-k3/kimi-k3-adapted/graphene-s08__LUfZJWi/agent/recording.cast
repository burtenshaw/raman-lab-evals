[63.945108, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = data['raman_shift_cm1']\ny = data['intensity']\n\ndef lorentz(x, x0, gamma, amp, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nresults = {}\nfor name, center in [('D', 1350.0), ('G', 1580.0), ('2D', 2690.0)]:\n    m = (x > center - 120) & (x < center + 120)\n    xw, yw = x[m], y[m]\n    off0 = float(np.min(yw))\n    amp0 = float(np.max(yw) - off0)\n    x00 = float(xw[np.argmax(yw)])\n    p0 = [x00, 15.0, amp0, off0]\n    popt, _ = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)\n    x0, gamma, amp, offset = popt\n    results[name] = {'x0': float(x0), 'gamma': float(abs(gamma)),\n                     'amplitude': float(amp), 'offset': float(offset)}\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2"]
[63.945147, "i", "))\nEOF\n"]
