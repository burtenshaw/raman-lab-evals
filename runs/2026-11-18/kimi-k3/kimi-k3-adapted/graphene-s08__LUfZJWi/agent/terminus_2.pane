[?2004hroot@j-openenv-6afd8958e5cad0e4dc3e69c8-8fuq1a6f-74589-24b8z:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = data['raman_shift_cm1']
[?2004l[?2004h> y = data['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, x0, gamma, amp, offset):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, center in [('D', 1350.0), ('G', 1580.0), ('2D', 2690.0)]:
[?2004l[?2004h>     m = (x > center - 120) & (x < center + 120)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(yw))
[?2004l[?2004h>     amp0 = float(np.max(yw) - off0)
[?2004l[?2004h>     x00 = float(xw[np.argmax(yw)])
[?2004l[?2004h>     p0 = [x00, 15.0, amp0, off0]
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xw, yw, p0=p0, maxfev=20000)
[?2004l[?2004h>     x0, gamma, amp, offset = popt
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(abs(gamma)),
[?2004l[?2004h>                      'amplitude': float(amp), 'offset': float(offset)}
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print(json.dumps(results, indent=2))
[?2004l[?2004h> EOF
