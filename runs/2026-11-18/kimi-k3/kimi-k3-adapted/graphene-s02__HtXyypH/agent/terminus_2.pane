[?2004hroot@j-openenv-6afd88e729e8b7ccfbbb7f93-hjrulasu-4e33d-nphnn:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, halfwin=120.0):
[?2004l[?2004h>     m = (x > center - halfwin) & (x < center + halfwin)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(ys.min())
[?2004l[?2004h>     amp0 = float(ys.max() - ys.min())
[?2004l[?2004h>     x00 = float(xs[np.argmax(ys)])
[?2004l[?2004h>     # estimate gamma from FWHM
[?2004l[?2004h>     above = xs[ys > off0 + amp0 / 2.0]
[?2004l[?2004h>     fwhm = (above.max() - above.min()) if len(above) > 1 else 20.0
[?2004l[?2004h>     g0 = max(fwhm / 2.0, 1.0)
[?2004l[?2004h>     p0 = [x00, g0, amp0, off0]
[?2004l[?2004h>     bounds = ([x00 - halfwin, 0.1, 0.0, -np.inf],
[?2004l[?2004h>               [x00 + halfwin, halfwin * 2, np.inf, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=200000)
[?2004l[?2004h>     return {'x0': float(popt[0]), 'gamma': float(popt[1]),
[?2004l[?2004h>             'amplitude': float(popt[2]), 'offset': float(popt[3])}
[?2004l[?2004h> 
[?2004l[?2004h> D = fit_peak(1350.0)
[?2004l[?2004h> G = fit_peak(1580.0)
[?2004l[?2004h> D2 = fit_peak(2690.0)
[?2004l[?2004h> results = {'D': D, 'G': G, '2D': D2, 'ID_IG': D['amplitude'] / G['amplitude']}
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print(json.dumps(results, indent=2))
[?2004l[?2004h> EOF
