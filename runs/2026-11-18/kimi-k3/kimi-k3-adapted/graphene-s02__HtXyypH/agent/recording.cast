[51.570181, "o", "\u001b[?2004hroot@j-openenv-6afd88e729e8b7ccfbbb7f93-hjrulasu-4e33d-nphnn:/app# "]
[68.53893, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwin=120.0):\n    m = (x > center - halfwin) & (x < center + halfwin)\n    xs, ys = x[m], y[m]\n    off0 = float(ys.min())\n    amp0 = float(ys.max() - ys.min())\n    x00 = float(xs[np.argmax(ys)])\n    # estimate gamma from FWHM\n    above = xs[ys > off0 + amp0 / 2.0]\n    fwhm = (above.max() - above.min()) if len(above) > 1 else 20.0\n    g0 = max(fwhm / 2.0, 1.0)\n    p0 = [x00, g0, amp0, off0]\n    bounds = ([x00 - halfwin, 0.1, 0.0, -np.inf],\n              [x00 + halfwin, halfwin * 2, np.inf, np.inf])\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=200000)\n    return {'x0': float(popt[0]), 'gamma': float(popt[1]),\n            'amplitude': float(popt[2]), 'offset"]
[68.538996, "i", "': float(popt[3])}\n\nD = fit_peak(1350.0)\nG = fit_peak(1580.0)\nD2 = fit_peak(2690.0)\nresults = {'D': D, 'G': G, '2D': D2, 'ID_IG': D['amplitude'] / G['amplitude']}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nEOF\n"]
[68.539168, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
