[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, window=150):
[?2004l[?2004h>     m = (x > center - window) & (x < center + window)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(ys))
[?2004l[?2004h>     a0 = float(np.max(ys) - off0)
[?2004l[?2004h>     x00 = float(xs[np.argmax(ys)])
[?2004l[?2004h>     p0 = [a0, x00, 15.0, off0]
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)
[?2004l[?2004h>     amp, x0, gamma, off = popt
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(abs(gamma)),
[?2004l[?2004h>             'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> res = {
[?2004l[?2004h>     'D': fit_peak(1350),
[?2004l[?2004h>     'G': fit_peak(1580),
[?2004l[?2004h>     '2D': fit_peak(2690),
[?2004l[?2004h> }
[?2004l[?2004h> res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(res, f, indent=2)
