[53.763515, "o", "\u001b[?2004hroot@j-openenv-6afd88e7e5cad0e4dc3e693e-npijuqek-084f7-m62t4:/app# "]
[66.20367, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=150):\n    m = (x > center - window) & (x < center + window)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    a0 = float(np.max(ys) - off0)\n    x00 = float(xs[np.argmax(ys)])\n    p0 = [a0, x00, 15.0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)\n    amp, x0, gamma, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gamma)),\n            'amplitude': float(amp), 'offset': float(off)}\n\nres = {\n    'D': fit_peak(1350),\n    'G': fit_peak(1580),\n    '2D': fit_peak(2690),\n}\nres['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF"]
[66.203792, "i", "\n"]
[66.203854, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
