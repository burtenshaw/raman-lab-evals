[?2004hroot@j-openenv-6afd895529e8b7ccfbbb802b-wf6yucuk-4defa-dnktn:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, half_window=150.0):
[?2004l[?2004h>     m = (x > center - half_window) & (x < center + half_window)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(ys))
[?2004l[?2004h>     i = int(np.argmax(ys))
[?2004l[?2004h>     x00 = float(xs[i])
[?2004l[?2004h>     a0 = float(ys[i] - off0)
[?2004l[?2004h>     # FWHM estimate for gamma init
[?2004l[?2004h>     above = xs[ys - off0 > a0 / 2.0]
[?2004l[?2004h>     g0 = max((above.max() - above.min()) / 2.0, 1.0) if above.size > 1 else 10.0
[?2004l[?2004h>     p0 = [a0, x00, g0, off0]
[?2004l[?2004h>     bounds = ([0.0, center - half_window, 0.1, -np.inf],
[?2004l[?2004h>               [np.inf, center + half_window, half_window, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=100000)
[?2004l[?2004h>     return {'x0': float(popt[1]), 'gamma': float(popt[2]),
[?2004l[?2004h>             'amplitude': float(popt[0]), 'offset': float(popt[3])}
[?2004l[?2004h> 
[?2004l[?2004h> results = {
[?2004l[?2004h>     'D': fit_peak(1350.0),
[?2004l[?2004h>     'G': fit_peak(1580.0),
[?2004l[?2004h>     '2D': fit_peak(2690.0, half_window=200.0),
[?2004l[?2004h> }
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
