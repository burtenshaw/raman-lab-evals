Sending keys: ["cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\npeaks = {'D': 1350.0, 'G': 1580.0, '2D': 2690.0}\nresults = {}\n\nfor name, center in peaks.items():\n    mask = (x >= center - 150) & (x <= center + 150)\n    xs, ys = x[mask], y[mask]\n    offset0 = float(np.min(ys))\n    x00 = float(xs[np.argmax(ys)])\n    amp0 = float(np.max(ys) - np.min(ys))\n    gamma0 = 15.0\n    p0 = [amp0, x00, gamma0, offset0]\n    bounds = ([0, center - 150, 1.0, -np.inf], [np.inf, center + 150, 300.0, np.inf])\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=100000)\n    amp, x0, gamma, off = popt\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(abs(gamma)),\n        'amplitude': float(amp),\n        'offset': float(off),\n    }\n    print(name, results[name])\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('ID_IG =', results['ID_IG'])\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
