Sending keys: ["cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef model(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwin):\n    m = (x >= center - halfwin) & (x <= center + halfwin)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    amp0 = float(np.max(ys) - off0)\n    x00 = float(xs[np.argmax(ys)])\n    p0 = [amp0, x00, 15.0, off0]\n    popt, _ = curve_fit(model, xs, ys, p0=p0, maxfev=100000)\n    amplitude, x0, gamma, offset = popt\n    return {'x0': float(x0), 'gamma': float(abs(gamma)),\n            'amplitude': float(amplitude), 'offset': float(offset)}\n\nD = fit_peak(1350, 120)\nG = fit_peak(1580, 120)\nD2 = fit_peak(2690, 200)\n\nresults = {'D': D, 'G': G, '2D': D2, 'ID_IG': D['amplitude'] / G['amplitude']}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 0.3 max_timeout_sec: 180.0
