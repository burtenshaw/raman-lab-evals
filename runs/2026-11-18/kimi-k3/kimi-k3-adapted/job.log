Sending keys: ["cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwin):\n    m = (x >= center - halfwin) & (x <= center + halfwin)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    amp0 = float(np.max(ys) - off0)\n    x00 = float(xs[np.argmax(ys)])\n    p0 = [amp0, x00, 10.0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)\n    amp, x0, gam, off = popt\n    gam = abs(gam)\n    return {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(off)}\n\nresults = {}\nresults['D'] = fit_peak(1350.0, 100.0)\nresults['G'] = fit_peak(1580.0, 100.0)\nresults['2D'] = fit_peak(2690.0, 150.0)\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
