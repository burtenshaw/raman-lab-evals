Sending keys: ["cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwidth):\n    m = (x >= center - halfwidth) & (x <= center + halfwidth)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    i = int(np.argmax(ys))\n    x00 = float(xs[i])\n    amp0 = float(ys[i] - off0)\n    g0 = 15.0\n    p0 = [amp0, x00, g0, off0]\n    bounds = ([0, center - halfwidth, 0.1, -np.inf],\n              [np.inf, center + halfwidth, halfwidth * 2, np.inf])\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    amp, x0, gam, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gam)), 'amplitude': float(amp), 'offset': float(off)}\n\nres = {}\nres['D'] = fit_peak(1350, 100)\nres['G'] = fit_peak(1580, 100)\nres['2D'] = fit_peak(2690, 150)\nres['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
