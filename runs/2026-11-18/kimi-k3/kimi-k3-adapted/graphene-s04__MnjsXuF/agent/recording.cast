[114.463804, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:,0], data[:,1]\n\ndef model(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwin):\n    m = (x > center - halfwin) & (x < center + halfwin)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    amp0 = float(np.max(ys) - off0)\n    x00 = float(xs[np.argmax(ys)])\n    p0 = [amp0, x00, 20.0, off0]\n    bounds = ([0, center-halfwin, 0.1, -np.inf], [np.inf, center+halfwin, halfwin*2, np.inf])\n    popt, _ = curve_fit(model, xs, ys, p0=p0, bounds=bounds, maxfev=20000)\n    amp, x0, gam, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gam)), 'amplitude': float(amp), 'offset': float(off)}\n\nres = {\n    'D': fit_peak(1350, 120),\n    'G': fit_peak(1580, 120),\n    '2D': fit_peak(2690, 200),\n}\nres['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\nwith op"]
[114.463937, "i", "en('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"]
