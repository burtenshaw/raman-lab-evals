[?2004hroot@j-openenv-6afd88e7e5cad0e4dc3e6942-92s8ojh5-83810-q49p5:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = data[:,0], data[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def model(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, halfwin):
[?2004l[?2004h>     m = (x > center - halfwin) & (x < center + halfwin)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(ys))
[?2004l[?2004h>     amp0 = float(np.max(ys) - off0)
[?2004l[?2004h>     x00 = float(xs[np.argmax(ys)])
[?2004l[?2004h>     p0 = [amp0, x00, 20.0, off0]
[?2004l[?2004h>     bounds = ([0, center-halfwin, 0.1, -np.inf], [np.inf, center+halfwin, halfwin*2, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(model, xs, ys, p0=p0, bounds=bounds, maxfev=20000)
[?2004l[?2004h>     amp, x0, gam, off = popt
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(abs(gam)), 'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> res = {
[?2004l[?2004h>     'D': fit_peak(1350, 120),
[?2004l[?2004h>     'G': fit_peak(1580, 120),
[?2004l[?2004h>     '2D': fit_peak(2690, 200),
[?2004l[?2004h> }
[?2004l[?2004h> res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(res, f, indent=2)
