[103.82487, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window):\n    m = (x > center - window) & (x < center + window)\n    xs, ys = x[m], y[m]\n    off0 = float(ys.min())\n    amp0 = float(ys.max() - ys.min())\n    x00 = float(xs[np.argmax(ys)])\n    p0 = [amp0, x00, 15.0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)\n    amp, x0, gam, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gam)), 'amplitude': float(amp), 'offset': float(off)}\n\nresults = {\n    'D': fit_peak(1350, 150),\n    'G': fit_peak(1580, 150),\n    '2D': fit_peak(2690, 200),\n}\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps("]
[103.824921, "i", "results, indent=2))\nEOF\n"]
[103.827288, "o", "cat > /app/fit.py << 'EOF'"]
[103.832795, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\r\n\u001b[?2004l\r\u001b[?2004h> x = data[:, 0]\r\n\u001b[?2004l\r\u001b[?2004h> y = data[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lorentz(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r\u001b[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fit_peak(center, window):\r\n\u001b[?2004l\r\u001b[?2004h>     m = (x > center - window) & (x < center + window)\r\n\u001b[?2004l\r\u001b[?2004h>     xs, ys = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     off0 = float(ys.min())\r\n\u001b[?2004l\r\u001b[?2004h>     amp0 = float(ys.max() - ys.min())\r\n\u001b[?2004l\r\u001b[?2004h>     x00 = float(xs[np.argmax(ys)])\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [amp0, x00, 15.0, off0]\r\n\u001b[?2004l\r\u001b[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=100000)\r\n\u001b[?2004l\r\u001b[?2004h>     amp, x0, gam, off = popt\r\n\u001b["]
[103.833216, "o", "?2004l\r\u001b[?2004h>     return {'x0': float(x0), 'gamma': float(abs(gam)), 'amplitude': float(amp), 'offset': float(off)}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = {\r\n\u001b[?2004l\r\u001b[?2004h>     'D': fit_peak(1350, 150),\r\n\u001b[?2004l\r\u001b[?2004h>     'G': fit_peak(1580, 150),\r\n\u001b[?2004l\r\u001b[?2004h>     '2D': fit_peak(2690, 200),\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
