[?2004hroot@j-openenv-6afd88e7e5cad0e4dc3e693c-qa9z2nyl-fde6b-kzcls:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {'D': 1350.0, 'G': 1580.0, '2D': 2690.0}
[?2004l[?2004h> results = {}
[?2004l[?2004h> 
[?2004l[?2004h> for name, center in peaks.items():
[?2004l[?2004h>     mask = (x >= center - 150) & (x <= center + 150)
[?2004l[?2004h>     xs, ys = x[mask], y[mask]
[?2004l[?2004h>     offset0 = float(np.min(ys))
[?2004l[?2004h>     x00 = float(xs[np.argmax(ys)])
[?2004l[?2004h>     amp0 = float(np.max(ys) - np.min(ys))
[?2004l[?2004h>     gamma0 = 15.0
[?2004l[?2004h>     p0 = [amp0, x00, gamma0, offset0]
[?2004l[?2004h>     bounds = ([0, center - 150, 1.0, -np.inf], [np.inf, center + 150, 300.0, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=100000)
[?2004l[?2004h>     amp, x0, gamma, off = popt
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(abs(gamma)),
[?2004l[?2004h>         'amplitude': float(amp),
[?2004l[?2004h>         'offset': float(off),
[?2004l[?2004h>     }
[?2004l[?2004h>     print(name, results[name])
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('ID_IG =', results['ID_IG'])
[?2004l[?2004h> EOF
