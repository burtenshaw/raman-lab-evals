[53.264482, "o", "\u001b[?2004hroot@j-openenv-6afd89b9e5cad0e4dc3e69f4-ax5yezgl-12e2a-c9zqh:/app# "]
[71.317899, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, x0, gamma, amp, offset):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center):\n    m = (x > center - 150) & (x < center + 150)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    x00 = float(xs[np.argmax(ys)])\n    amp0 = float(np.max(ys) - off0)\n    p0 = [x00, 15.0, amp0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=200000)\n    x0, gamma, amp, offset = popt\n    return {'x0': float(x0), 'gamma': float(abs(gamma)), 'amplitude': float(amp), 'offset': float(offset)}\n\nD = fit_peak(1350)\nG = fit_peak(1580)\nD2 = fit_peak(2690)\n\nresults = {'D': D, 'G': G, '2D': D2, 'ID_IG': D['amplitude'] / G['amplitude']}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nEOF\n"]
[71.319185, "o", "cat > /app/fit.py << 'EOF'"]
