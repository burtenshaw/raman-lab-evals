[?2004hroot@j-openenv-6afd8a6fe5cad0e4dc3e6b6d-erq1djwy-ca777-96fcc:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, A, x0, g, c):
[?2004l[?2004h>     return A * g**2 / ((x - x0)**2 + g**2) + c
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = data[:, 0], data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, center in [('D', 1350.0), ('G', 1580.0), ('2D', 2690.0)]:
[?2004l[?2004h>     m = (x > center - 150) & (x < center + 150)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     c0 = np.percentile(ys, 10)
[?2004l[?2004h>     x00 = xs[np.argmax(ys)]
[?2004l[?2004h>     A0 = ys.max() - c0
[?2004l[?2004h>     p0 = [A0, x00, 20.0, c0]
[?2004l[?2004h>     popt, _ = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     A, x0, g, c = popt
[?2004l[?2004h>     g = abs(g)
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(g), 'amplitude': float(A), 'offset': float(c)}
[?2004l[?2004h>     print(name, p0, '->', results[name])
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print(json.dumps(results, indent=2))
