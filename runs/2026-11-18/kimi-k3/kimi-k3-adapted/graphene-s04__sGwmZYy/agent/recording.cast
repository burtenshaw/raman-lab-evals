[60.310968, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef lor(x, A, x0, g, c):\n    return A * g**2 / ((x - x0)**2 + g**2) + c\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = data[:, 0], data[:, 1]\n\nresults = {}\nfor name, center in [('D', 1350.0), ('G', 1580.0), ('2D', 2690.0)]:\n    m = (x > center - 150) & (x < center + 150)\n    xs, ys = x[m], y[m]\n    c0 = np.percentile(ys, 10)\n    x00 = xs[np.argmax(ys)]\n    A0 = ys.max() - c0\n    p0 = [A0, x00, 20.0, c0]\n    popt, _ = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    A, x0, g, c = popt\n    g = abs(g)\n    results[name] = {'x0': float(x0), 'gamma': float(g), 'amplitude': float(A), 'offset': float(c)}\n    print(name, p0, '->', results[name])\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nEOF\n"]
