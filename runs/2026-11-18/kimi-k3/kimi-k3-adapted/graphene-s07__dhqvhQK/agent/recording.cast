[56.840278, "o", "1.18.1 2.5.5\r\n"]
[56.855848, "o", "\u001b[?2004hroot@j-openenv-6afd895729e8b7ccfbbb8032-96rpwnh1-52801-6nctm:/app# "]
[61.554152, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, window=120):\n    m = (x > center - window) & (x < center + window)\n    xs, ys = x[m], y[m]\n    offset0 = np.min(ys)\n    i = np.argmax(ys)\n    x00 = xs[i]\n    amp0 = ys[i] - offset0\n    # estimate gamma from FWHM\n    half = offset0 + amp0 / 2\n    above = xs[ys > half]\n    gamma0 = max((above.max() - above.min()) / 2, 2.0) if len(above) > 1 else 10.0\n    p0 = [x00, gamma0, amp0, offset0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=20000)\n    x0f, gf, af, of = popt\n    return {'x0': float(x0f), 'gamma': float(abs(gf)), 'amplitude': float(af), 'offset': float(of)}\n\nres = {\n    'D': fit_peak(1350),\n    'G': fit_peak(1580),\n    '2D': fit_peak(2690, window=150),\n}\nres['ID_IG']"]
[61.554207, "i", " = res['D']['amplitude'] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"]
