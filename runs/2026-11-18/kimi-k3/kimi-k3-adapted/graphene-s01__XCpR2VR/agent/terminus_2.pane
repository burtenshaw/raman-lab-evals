[?2004hroot@j-openenv-6afd8a2929e8b7ccfbbb819c-n54r9zgq-fddb3-dtmkn:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, half_window=120):
[?2004l[?2004h>     m = (x > center - half_window) & (x < center + half_window)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.min(ys))
[?2004l[?2004h>     i = int(np.argmax(ys))
[?2004l[?2004h>     x00 = float(xs[i])
[?2004l[?2004h>     a0 = float(ys[i] - off0)
[?2004l[?2004h>     # FWHM estimate
[?2004l[?2004h>     half = off0 + a0 / 2.0
[?2004l[?2004h>     above = xs[ys > half]
[?2004l[?2004h>     g0 = max((above.max() - above.min()) / 2.0, 1.0) if len(above) > 1 else 10.0
[?2004l[?2004h>     p0 = [a0, x00, g0, off0]
[?2004l[?2004h>     bounds = ([0, center - half_window, 0.1, -np.inf],
[?2004l[?2004h>               [np.inf, center + half_window, half_window * 2, np.inf])
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=100000)
[?2004l[?2004h>     amp, x0, gamma, off = popt
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(abs(gamma)),
[?2004l[?2004h>             'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> res = {
[?2004l[?2004h>     'D': fit_peak(1350),
[?2004l[?2004h>     'G': fit_peak(1580),
[?2004l[?2004h>     '2D': fit_peak(2690),
[?2004l[?2004h> }
[?2004l[?2004h> res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(res, f, indent=2)
[?2004l[?2004h> print(json.dumps(res, indent=2))
