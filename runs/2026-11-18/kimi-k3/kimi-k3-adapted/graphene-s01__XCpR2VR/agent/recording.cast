[53.601302, "o", "\u001b[?2004hroot@j-openenv-6afd8a2929e8b7ccfbbb819c-n54r9zgq-fddb3-dtmkn:/app# "]
[74.320149, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, half_window=120):\n    m = (x > center - half_window) & (x < center + half_window)\n    xs, ys = x[m], y[m]\n    off0 = float(np.min(ys))\n    i = int(np.argmax(ys))\n    x00 = float(xs[i])\n    a0 = float(ys[i] - off0)\n    # FWHM estimate\n    half = off0 + a0 / 2.0\n    above = xs[ys > half]\n    g0 = max((above.max() - above.min()) / 2.0, 1.0) if len(above) > 1 else 10.0\n    p0 = [a0, x00, g0, off0]\n    bounds = ([0, center - half_window, 0.1, -np.inf],\n              [np.inf, center + half_window, half_window * 2, np.inf])\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, bounds=bounds, maxfev=100000)\n    amp, x0, gamma, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gamma)),\n"]
[74.320292, "i", "            'amplitude': float(amp), 'offset': float(off)}\n\nres = {\n    'D': fit_peak(1350),\n    'G': fit_peak(1580),\n    '2D': fit_peak(2690),\n}\nres['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\n"]
[74.320364, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
