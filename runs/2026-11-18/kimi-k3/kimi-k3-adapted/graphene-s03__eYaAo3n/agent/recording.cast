[64.009602, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentz(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwidth=150):\n    m = (x > center - halfwidth) & (x < center + halfwidth)\n    xs, ys = x[m], y[m]\n    off0 = float(ys.min())\n    amp0 = float(ys.max() - ys.min())\n    x00 = float(xs[np.argmax(ys)])\n    p0 = [amp0, x00, 15.0, off0]\n    popt, _ = curve_fit(lorentz, xs, ys, p0=p0, maxfev=20000)\n    amp, x0, gam, off = popt\n    return {'x0': float(x0), 'gamma': float(abs(gam)), 'amplitude': float(amp), 'offset': float(off)}\n\nresults = {\n    'D': fit_peak(1350),\n    'G': fit_peak(1580),\n    '2D': fit_peak(2690),\n}\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(re"]
[64.009751, "o", "cat > /app/fit.py << 'EOF'"]
[64.010028, "i", "sults, indent=2))\nEOF\n"]
