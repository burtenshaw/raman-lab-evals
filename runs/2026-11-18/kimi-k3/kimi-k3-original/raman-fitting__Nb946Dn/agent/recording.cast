[190.443111, "o", "\u001b[?2004h> "]
[190.443178, "o", "    (x0, gamma, amp, off), perr = fit_peak(center)\r\n\u001b[?2004l\r"]
[190.443218, "o", "\u001b[?2004h> "]
[190.443322, "o", "    print(f'{name}: x0={x0:.3f} gamma={abs(gamma):.3f} amp={amp:.2f} off={off:.2f}')\r\n\u001b[?2004l\r"]
