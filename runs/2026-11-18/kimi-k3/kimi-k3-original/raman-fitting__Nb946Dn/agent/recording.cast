[67.614475, "i", "python3 - <<'EOF'\nimport numpy as np\ndata = np.loadtxt('/app/graphene.dat', converters={0: lambda s: float(s.replace(b',' if isinstance(s,bytes) else ',', b'.' if isinstance(s,bytes) else '.')), 1: lambda s: float(s.replace(b',' if isinstance(s,bytes) else ',', b'.' if isinstance(s,bytes) else '.'))})\nx, y = data[:,0], data[:,1]\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\nprint('x range:', x.min(), x.max(), 'n=', len(x))\nprint('y range:', y.min(), y.max())\n# rough baseline\nbase = np.median(y)\nprint('median y:', base)\n# find top intensities\norder = np.argsort(y)[::-1][:20]\nfor i in sorted(order):\n    print(f'x={x[i]:.2f} y={y[i]:.1f}')\nEOF\n"]
