[122.881909, "i", "python3 - <<'EOF'\nimport numpy as np\nconv = lambda s: float(s.replace(',', '.'))\ndata = np.loadtxt('/app/graphene.dat', converters={0: conv, 1: conv})\nx, y = data[:,0], data[:,1]\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\nnb = 80\nbins = np.linspace(x.min(), x.max(), nb+1)\nfor i in range(nb):\n    m = (x >= bins[i]) & (x < bins[i+1])\n    if m.sum():\n        ym = y[m].mean()\n        bar = '#' * int(70 * ym / 80000)\n        print(f'{bins[i]:9.0f} {ym:9.0f} {bar}')\nEOF\n"]
