[83.409693, "i", "python3 - <<'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nconv = lambda s: float(s.replace(',', '.'))\ndata = np.loadtxt('/app/graphene.dat', converters={0: conv, 1: conv})\nx, y = data[:,0], data[:,1]\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\npeaks, props = find_peaks(y, prominence=500)\nprint('num peaks:', len(peaks))\nfor p, prom in zip(peaks, props['prominences']):\n    print(f'x={x[p]:.2f} y={y[p]:.1f} prom={prom:.1f}')\nEOF\n"]
