[132.11162, "i", "python3 - <<'EOF'\nimport numpy as np\nconv = lambda s: float(s.replace(',', '.'))\ndata = np.loadtxt('/app/graphene.dat', converters={0: conv, 1: conv})\nx, y = data[:,0], data[:,1]\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\nfor c in [3745, 6329, 10289, 16245, 19139, 33244]:\n    m = np.abs(x - c) < 120\n    xs, ys = x[m], y[m]\n    print(f'--- around {c} (n={len(xs)}) ---')\n    step = max(1, len(xs)//30)\n    for xi, yi in zip(xs[::step], ys[::step]):\n        bar = '*' * int(60 * yi / 80000)\n        print(f'{xi:9.1f} {yi:9.1f} {bar}')\nEOF\n"]
