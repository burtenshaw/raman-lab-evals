[?2004hroot@j-openenv-6afd86e5884144d2f44fd3b9-pbf8s3jx-5283f-mhrvn:/app# cat > /app/fit.py <<'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> conv = lambda s: float(s.replace(',', '.'))
[?2004l[?2004h> data = np.loadtxt('/app/graphene.dat', converters={0: conv, 1: conv})
[?2004l[?2004h> x, y = data[:, 0], data[:, 1]
[?2004l[?2004h> idx = np.argsort(x)
[?2004l[?2004h> x, y = x[idx], y[idx]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(xx, x0, gamma, amp, off):
[?2004l[?2004h>     return amp * gamma**2 / ((xx - x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, halfwin=250):
[?2004l[?2004h>     m = np.abs(x - center) < halfwin
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = np.min(ys)
[?2004l[?2004h>     amp0 = np.max(ys) - off0
[?2004l[?2004h>     x00 = xs[np.argmax(ys)]
[?2004l[?2004h>     # estimate HWHM
[?2004l[?2004h>     above = xs[ys > off0 + amp0/2]
[?2004l[?2004h>     g0 = max((above.max() - above.min())/2, 5)
[?2004l[?2004h>     p0 = [x00, g0, amp0, off0]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xs, ys, p0=p0, maxfev=20000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     return popt, perr
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, center in [('G', 3745), ('2D', 6329)]:
[?2004l[?2004h>     (x0, gamma, amp, off), perr = fit_peak(center)
[?2004l[?2004h>     print(f'{name}: x0={x0:.3f} gamma={abs(gamma):.3f} amp={amp:.2f} off={off:.2f}')
[?2004l[?2004h>     print(f'   errors: x0={perr[0]:.3f} gamma={perr[1]:.3f} amp={perr[2]:.2f} off={perr[3]:.2f}')
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(abs(gamma)),
[?2004l[?2004h>         'amplitude': float(amp),
[?2004l[?2004h>         'offset': float(off),
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print(json.dumps(results, indent=2))
[?2004l[?2004h> EOF
