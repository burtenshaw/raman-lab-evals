[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> xs, ys = [], []
[?2004l[?2004h> with open('/app/graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if not line:
[?2004l[?2004h>             continue
[?2004l[?2004h>         p = line.replace(',', '.').split()
[?2004l[?2004h>         xs.append(float(p[0])); ys.append(float(p[1]))
[?2004l[?2004h> x = 1e7/np.array(xs)
[?2004l[?2004h> y = np.array(ys)
[?2004l[?2004h> o = np.argsort(x)
[?2004l[?2004h> x, y = x[o], y[o]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, x0, gamma, amp, off):
[?2004l[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(lo, hi, name):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xf, yf = x[m], y[m]
[?2004l[?2004h>     off0 = yf.min()
[?2004l[?2004h>     x00 = xf[np.argmax(yf)]
[?2004l[?2004h>     amp0 = yf.max() - off0
[?2004l[?2004h>     p0 = [x00, 15.0, amp0, off0]
[?2004l[?2004h>     popt, _ = curve_fit(lorentz, xf, yf, p0=p0, maxfev=20000)
[?2004l[?2004h>     x0, gamma, amp, off = popt
[?2004l[?2004h>     gamma = abs(gamma)
[?2004l[?2004h>     print(name, 'x0=%.3f gamma=%.3f amp=%.1f off=%.1f' % (x0, gamma, amp, off))
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amp), 'offset': float(off)}
[?2004l[?2004h> 
[?2004l[?2004h> res = {
[?2004l[?2004h>     'G': fit_peak(1480, 1680, 'G'),
[?2004l[?2004h>     '2D': fit_peak(2580, 2800, '2D'),
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(res, f, indent=2)
