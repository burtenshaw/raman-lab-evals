[163.140405, "i", "cat > /app/peaks.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        p = line.replace(',', '.').split()\n        xs.append(float(p[0])); ys.append(float(p[1]))\nx = 1e7/np.array(xs)\ny = np.array(ys)\no = np.argsort(x)\nx, y = x[o], y[o]\nprint('wn range', x.min(), x.max(), 'monotonic diffs min', np.diff(x).min())\n# smooth lightly\nfrom scipy.signal import savgol_filter\nys = savgol_filter(y, 11, 3)\npk, props = find_peaks(ys, prominence=500)\nfor i, pidx in enumerate(pk):\n    print(f'peak at wn={x[pidx]:.1f} y={y[pidx]:.0f} prom={props[\"prominences\"][i]:.0f}')\nEOF\npython3 /app/peaks.py\n"]
