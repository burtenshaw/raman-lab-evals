[177.804299, "o", "\u001b[?2004l\r\u001b[?2004h"]
[177.804434, "o", "> with open('/app/graphene.dat') as f:"]
[177.805059, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         p = line.replace(',', '.').split()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.805134, "o", "        xs.append(float(p[0])); ys.append(float(p[1]))\r\n\u001b[?2004l\r"]
[177.805426, "o", "\u001b[?2004h> x = 1e7/np.array(xs)"]
[177.805459, "o", "\r\n"]
[177.805562, "o", "\u001b[?2004l\r"]
[177.806098, "o", "\u001b[?2004h"]
[177.806392, "o", "> y = np.array(ys)\r\n\u001b[?2004l\r\u001b[?2004h> o = np.argsort(x)\r\n\u001b[?2004l\r\u001b[?2004h> x, y = x[o], y[o]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lorentz(x, x0, gamma, amp, off):\r\n\u001b[?2004l\r\u001b[?2004h>     return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.806431, "o", "def fit_peak(lo, hi, name):\r\n\u001b[?2004l\r\u001b[?2004h>     m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[177.806577, "o", "\u001b[?2004h>     xf, yf = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.806653, "o", "    off0 = yf.min()"]
[177.806701, "o", "\r\n"]
[177.806785, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[177.806886, "o", "    x00 = xf[np.argmax(yf)]\r\n\u001b[?2004l\r"]
[177.806903, "o", "\u001b[?2004h"]
[177.807018, "o", ">     amp0 = yf.max() - off0\r\n\u001b[?2004l\r"]
[177.807097, "o", "\u001b[?2004h"]
[177.807114, "o", "> "]
[177.807303, "o", "    p0 = [x00, 15.0, amp0, off0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.80734, "o", "> "]
[177.807513, "o", "    popt, _ = curve_fit(lorentz, xf, yf, p0=p0, maxfev=20000)\r\n\u001b[?2004l\r"]
[177.807567, "o", "\u001b[?2004h"]
[177.807583, "o", "> "]
[177.807674, "o", "    x0, gamma, amp, off = popt"]
[177.807732, "o", "\r\n\u001b[?2004l\r"]
[177.807746, "o", "\u001b[?2004h"]
[177.807814, "o", "> "]
[177.807895, "o", "    gamma = abs(gamma)"]
[177.807941, "o", "\r\n\u001b[?2004l\r"]
[177.808017, "o", "\u001b[?2004h> "]
[177.808196, "o", "    print(name, 'x0=%.3f gamma=%.3f amp=%.1f off=%.1f' % (x0, gamma, amp, off))\r\n"]
[177.808249, "o", "\u001b[?2004l\r"]
[177.8083, "o", "\u001b[?2004h"]
[177.808394, "o", "> "]
[177.808551, "o", "    return {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amp), 'offset': float(off)}"]
[177.808639, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.808712, "o", "\u001b[?2004h> "]
[177.808776, "o", "res = {\r\n\u001b[?2004l\r"]
[177.80879, "o", "\u001b[?2004h"]
[177.808895, "o", "> "]
[177.808951, "o", "    'G': fit_peak(1480, 1680, 'G'),"]
[177.809073, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.809128, "o", "    '2D': fit_peak(2580, 2800, '2D'),\r\n\u001b[?2004l\r"]
[177.809241, "o", "\u001b[?2004h"]
[177.809259, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.809338, "o", "> "]
[177.809444, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[177.809517, "o", "\u001b[?2004h> "]
[177.809587, "o", "    json.dump(res, f, indent=2)"]
[177.809659, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.809716, "o", "> "]
[177.809792, "o", "print(json.dumps(res, indent=2))\r\n\u001b[?2004l\r"]
[177.80986, "o", "\u001b[?2004h> EOF"]
[177.809907, "o", "\r\n"]
[177.810019, "o", "\u001b[?2004l\r"]
[177.811538, "o", "\u001b[?2004hroot@j-openenv-6afd86e5884144d2f44fd3bb-vwdptt08-9234b-w8zbr:/app# "]
[177.811662, "o", "python3 /app/fit.py\r\n\u001b[?2004l\r"]
[178.521093, "o", "G x0=1580.329 gamma=8.478 amp=8307.4 off=5755.1\r\n2D x0=2670.111 gamma=18.305 amp=12479.2 off=984.8\r\n{\r\n  \"G\": {\r\n    \"x0\": 1580.3290635882397,\r\n    \"gamma\": 8.478014833395225,\r\n    \"amplitude\": 8307.370269019071,\r\n    \"offset\": 5755.122839793031\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2670.1107530124777,\r\n    \"gamma\": 18.304630284856977,\r\n    \"amplitude\": 12479.172086113438,\r\n    \"offset\": 984.7914437026299\r\n  }\r\n}\r\n"]
[178.588536, "o", "\u001b[?2004hroot@j-openenv-6afd86e5884144d2f44fd3bb-vwdptt08-9234b-w8zbr:/app# "]
[193.112928, "i", "cat /app/results.json\n"]
[193.11307, "o", "cat /app/results.json\r\n"]
[193.113133, "o", "\u001b[?2004l\r"]
[193.114342, "o", "{\r\n  \"G\": {\r\n    \"x0\": 1580.3290635882397,\r\n    \"gamma\": 8.478014833395225,\r\n    \"amplitude\": 8307.370269019071,\r\n    \"offset\": 5755.122839793031\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2670.1107530124777,\r\n    \"gamma\": 18.304630284856977,\r\n    \"amplitude\": 12479.172086113438,\r\n    \"offset\": 984.7914437026299\r\n  }\r\n}"]
