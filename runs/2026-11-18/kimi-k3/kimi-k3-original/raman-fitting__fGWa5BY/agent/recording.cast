[92.792282, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\n\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.replace(',', '.').split()\n        xs.append(float(parts[0])); ys.append(float(parts[1]))\nx = np.array(xs); y = np.array(ys)\nprint('N=', len(x), 'xrange=', x.min(), x.max())\n# print y stats in bins over x\norder = np.argsort(x)\nxs2, ys2 = x[order], y[order]\nfor lo in range(0, 48000, 2000):\n    m = (xs2 >= lo) & (xs2 < lo+2000)\n    if m.sum():\n        print(lo, m.sum(), ys2[m].min(), ys2[m].max(), ys2[m].mean())\nEOF\npython3 /app/explore.py\n"]
