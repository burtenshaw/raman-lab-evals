[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> 
[?2004l[?2004h> x, y = [], []
[?2004l[?2004h> with open('/app/graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if not line:
[?2004l[?2004h>             continue
[?2004l[?2004h>         parts = line.replace(',', '.').split()
[?2004l[?2004h>         x.append(float(parts[0])); y.append(float(parts[1]))
[?2004l[?2004h> x = np.array(x); y = np.array(y)
[?2004l[?2004h> print('n =', len(x))
[?2004l[?2004h> print('x range:', x.min(), x.max())
[?2004l[?2004h> print('y range:', y.min(), y.max())
[?2004l[?2004h> # sort ascending
[?2004l[?2004h> idx = np.argsort(x)
[?2004l[?2004h> xs, ys = x[idx], y[idx]
[?2004l[?2004h> # find peaks with prominence
[?2004l[?2004h> peaks, props = find_peaks(ys, prominence=500)
[?2004l[?2004h> print('num peaks:', len(peaks))
[?2004l[?2004h> proms = props['prominences']
[?2004l[?2004h> order = np.argsort(proms)[::-1]
[?2004l[?2004h> for i in order[:15]:
[?2004l[?2004h>     p = peaks[i]
[?2004l[?2004h>     print(f'peak at x={xs[p]:.2f}, y={ys[p]:.1f}, prominence={proms[i]:.1f}')
