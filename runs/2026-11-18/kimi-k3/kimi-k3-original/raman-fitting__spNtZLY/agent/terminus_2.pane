python3 /app/fit.py
[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> x, y = [], []
[?2004l[?2004h> with open('/app/graphene.dat') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if not line:
[?2004l[?2004h>             continue
[?2004l[?2004h>         p = line.replace(',', '.').split()
[?2004l[?2004h>         x.append(float(p[0])); y.append(float(p[1]))
[?2004l[?2004h> x = np.array(x); y = np.array(y)
[?2004l[?2004h> nu = 1e7 / x  # Raman shift in cm^-1
[?2004l[?2004h> idx = np.argsort(nu)
[?2004l[?2004h> nu, y = nu[idx], y[idx]
[?2004l[?2004h> print('nu range:', nu.min(), nu.max())
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(xv, x0, g, A, c):
[?2004l[?2004h>     return c + A * g**2 / ((xv - x0)**2 + g**2)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_region(xv, yv, lo, hi, x0guess, label):
[?2004l[?2004h>     m = (xv >= lo) & (xv <= hi)
[?2004l[?2004h>     xs, ys = xv[m], yv[m]
[?2004l[?2004h>     n = len(xs)
[?2004l[?2004h>     # initial guesses
[?2004l[?2004h>     c0 = np.percentile(ys, 10)
[?2004l[?2004h>     A0 = ys.max() - c0
[?2004l[?2004h>     x0g = xs[np.argmax(ys)]
[?2004l[?2004h>     # estimate HWHM
[?2004l[?2004h>     above = xs[ys > c0 + A0/2]
[?2004l[?2004h>     g0 = max((above.max() - above.min())/2, 1.0) if len(above) > 1 else 10.0
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, pcov = curve_fit(lorentz, xs, ys, p0=[x0g, g0, A0, c0], maxfev=20000)
[?2004l[?2004h>         resid = ys - lorentz(xs, *popt)
[?2004l[?2004h>         ss_res = np.sum(resid**2); ss_tot = np.sum((ys-ys.mean())**2)
[?2004l[?2004h>         r2 = 1 - ss_res/ss_tot
[?2004l[?2004h>         perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>         print(f'{label}: n={n}')
[?2004l[?2004h>         print(f'  x0={popt[0]:.4f} +/- {perr[0]:.4f}')
[?2004l[?2004h>         print(f'  gamma={popt[1]:.4f} +/- {perr[1]:.4f}')
[?2004l[?2004h>         print(f'  amplitude={popt[2]:.4f} +/- {perr[2]:.4f}')
[?2004l[?2004h>         print(f'  offset={popt[3]:.4f} +/- {perr[3]:.4f}')
[?2004l[?2004h>         print(f'  R2={r2:.5f}, RMS resid={np.sqrt(ss_res/n):.2f}')
[?2004l[?2004h>         return popt
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(label, 'fit failed:', e)
[?2004l[?2004h>         return None
[?2004l[?2004h> 
