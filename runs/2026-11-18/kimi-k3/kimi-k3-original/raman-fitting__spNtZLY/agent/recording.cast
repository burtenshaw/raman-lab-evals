[57.224724, "o", "\u001b[?2004hroot@j-openenv-6afd86e54643bac7ac634d49-0uwksnk4-cd27c-l25jf:/app# "]
[111.706824, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nx, y = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.replace(',', '.').split()\n        x.append(float(parts[0])); y.append(float(parts[1]))\nx = np.array(x); y = np.array(y)\nprint('n =', len(x))\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\n# sort ascending\nidx = np.argsort(x)\nxs, ys = x[idx], y[idx]\n# find peaks with prominence\npeaks, props = find_peaks(ys, prominence=500)\nprint('num peaks:', len(peaks))\nproms = props['prominences']\norder = np.argsort(proms)[::-1]\nfor i in order[:15]:\n    p = peaks[i]\n    print(f'peak at x={xs[p]:.2f}, y={ys[p]:.1f}, prominence={proms[i]:.1f}')\nEOF\npython3 /app/explore.py\n"]
