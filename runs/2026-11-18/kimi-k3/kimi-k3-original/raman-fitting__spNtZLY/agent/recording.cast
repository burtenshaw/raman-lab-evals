[198.264828, "o", "\u001b[?2004hroot@j-openenv-6afd86e54643bac7ac634d49-0uwksnk4-cd27c-l25jf:/app# "]
[201.339384, "i", "cat > /app/explore3.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nx, y = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.replace(',', '.').split()\n        x.append(float(parts[0])); y.append(float(parts[1]))\nx = np.array(x); y = np.array(y)\nidx = np.argsort(x)\nxs, ys = x[idx], y[idx]\npeaks, props = find_peaks(ys, prominence=200)\nproms = props['prominences']\nfor p, pr in zip(peaks, proms):\n    print(f'x={xs[p]:10.3f}  y={ys[p]:9.1f}  prom={pr:8.1f}')\nEOF\npython3 /app/explore3.py\n"]
[201.339511, "o", "cat > /app/explore3.py << 'EOF'\r\n"]
