[378.957942, "o", "\u001b[?2004hroot@j-openenv-6afd86e54643bac7ac634d49-0uwksnk4-cd27c-l25jf:/app# "]
[465.570364, "i", "cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        p = line.replace(',', '.').split()\n        x.append(float(p[0])); y.append(float(p[1]))\nx = np.array(x); y = np.array(y)\nnu = 1e7 / x\nidx = np.argsort(nu)\nnu, y = nu[idx], y[idx]\n\ndef lorentz(xv, x0, g, A, c):\n    return c + A * g**2 / ((xv - x0)**2 + g**2)\n\ndef fit(lo, hi):\n    m = (nu >= lo) & (nu <= hi)\n    xs, ys = nu[m], y[m]\n    c0 = float(np.percentile(ys, 10))\n    A0 = float(ys.max() - c0)\n    x0g = float(xs[np.argmax(ys)])\n    above = xs[ys > c0 + A0/2]\n    g0 = max(float((above.max() - above.min())/2), 1.0) if len(above) > 1 else 10.0\n    popt, _ = curve_fit(lorentz, xs, ys, p0=[x0g, g0, A0, c0], maxfev=40000)\n    return popt\n\npG = fit(1500, 1660)\np2 = fit(2580, 2760)\n\nresults = {\n    'G': {\n        'x0': round(float(pG[0]), 2),\n        'gamma': round(fl"]
[465.570507, "i", "oat(pG[1]), 2),\n        'amplitude': round(float(pG[2]), 2),\n        'offset': round(float(pG[3]), 2)\n    },\n    '2D': {\n        'x0': round(float(p2[0]), 2),\n        'gamma': round(float(p2[1]), 2),\n        'amplitude': round(float(p2[2]), 2),\n        'offset': round(float(p2[3]), 2)\n    }\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/final_fit.py\n"]
[465.570575, "o", "cat > /app/final_fit.py << 'EOF'\r\n\u001b[?2004l\roat(pG[1]), 2),\r\n        'amplitude': round(float(pG[2]), 2),\r\n        'offset': round(float(pG[3]), 2)\r\n    },\r\n    '2D': {\r\n        'x0': round(float(p2[0]), 2),\r\n      "]
[465.570646, "o", "  'gamma': round(float(p2[1]), 2),\r\n        'amplitude': round(float(p2[2]), 2),\r\n        'offset': round(float(p2[3]), 2)\r\n    }\r\n}\r\nwith open('/app/results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\nprint(json.dumps(results, indent=2))\r\nEOF\r\npython3 /app/final_fit.py\r\n"]
