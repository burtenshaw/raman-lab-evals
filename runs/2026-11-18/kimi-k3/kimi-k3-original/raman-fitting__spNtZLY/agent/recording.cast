[378.277438, "i", "cat > /app/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        p = line.replace(',', '.').split()\n        x.append(float(p[0])); y.append(float(p[1]))\nx = np.array(x); y = np.array(y)\nnu = 1e7 / x\nidx = np.argsort(nu)\nnu, y = nu[idx], y[idx]\n\ndef lor_c(xv, x0, g, A, c):\n    return c + A * g**2 / ((xv - x0)**2 + g**2)\n\ndef lor_lin(xv, x0, g, A, c, m):\n    return c + m*(xv - x0) + A * g**2 / ((xv - x0)**2 + g**2)\n\ndef fit(xv, yv, lo, hi, linear, label):\n    m = (xv >= lo) & (xv <= hi)\n    xs, ys = xv[m], yv[m]\n    n = len(xs)\n    c0 = np.percentile(ys, 10)\n    A0 = ys.max() - c0\n    x0g = xs[np.argmax(ys)]\n    above = xs[ys > c0 + A0/2]\n    g0 = max((above.max() - above.min())/2, 1.0) if len(above) > 1 else 10.0\n    try:\n        if linear:\n            popt, pcov = curve_fit(lor_lin, xs, ys, p0=[x0g, g0, A0, c0, 0.0], maxfev=40000)\n        else:"]
[378.277481, "i", "\n            popt, pcov = curve_fit(lor_c, xs, ys, p0=[x0g, g0, A0, c0], maxfev=40000)\n        fn = lor_lin if linear else lor_c\n        resid = ys - fn(xs, *popt)\n        ss_res = np.sum(resid**2); ss_tot = np.sum((ys-ys.mean())**2)\n        r2 = 1 - ss_res/ss_tot\n        perr = np.sqrt(np.diag(pcov))\n        slope = popt[4] if linear else 0.0\n        print(f'{label}: x0={popt[0]:8.3f}+-{perr[0]:.3f} g={popt[1]:6.3f}+-{perr[1]:.3f} A={popt[2]:8.1f}+-{perr[2]:.1f} c={popt[3]:8.1f}+-{perr[3]:.1f} m={slope:7.3f} R2={r2:.5f} n={n}')\n    except Exception as e:\n        print(label, 'FAILED', e)\n\nprint('--- G peak, constant offset ---')\nfor lo, hi in [(1520,1640),(1500,1660),(1480,1700),(1450,1750),(1550,1620)]:\n    fit(nu, y, lo, hi, False, f'G const [{lo},{hi}]')\nprint('--- G peak, linear baseline ---')\nfor lo, hi in [(1520,1640),(1500,1660),(1480,1700),(1450,1750),(1400,1800)]:\n    fit(nu, y, lo, hi, True, f'G lin   [{lo},{hi}]')\nprint('--- 2D peak, constant offset ---')\nfor lo, hi in [(2600,2740),(2580,2760),(25"]
[378.277623, "i", "50,2850),(2500,2900),(2620,2720)]:\n    fit(nu, y, lo, hi, False, f'2D const [{lo},{hi}]')\nprint('--- 2D peak, linear baseline ---')\nfor lo, hi in [(2600,2740),(2580,2760),(2550,2850),(2500,2900),(2450,2950)]:\n    fit(nu, y, lo, hi, True, f'2D lin   [{lo},{hi}]')\nEOF\npython3 /app/fit2.py\n"]
[378.277689, "o", "cat > /app/fit2.py << 'EOF'\r\n\u001b[?2004l\r50,2850),(2500,2900),(2620,2720)]:\r\n    fit(nu, y, lo, hi, False, f'2D const [{lo},{hi}]')\r\nprint('--- 2D peak, linear baseline ---')\r\nfor lo, hi in [(2600,2740),(2580,2760),(2550,2850),(2500,2900),(2450,295"]
[378.277777, "o", "0)]:\r\n    fit(nu, y, lo, hi, True, f'2D lin   [{lo},{hi}]')\r\nEOF\r\npython3 /app/fit2.py\r\n"]
