[305.189967, "o", " ys_all, 6000, 6700, 6329, 'G (x space, wi"]
[305.190003, "o", "n 6000-6700)')\r\nfit_region(xs_all, ys_all, 3550, 3950, 3745, '2D (x space, win 3550-3950)')\r\nEOF\r\npython3 /app/fit.py\r\n\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.190046, "o", "> "]
[305.190083, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[305.190113, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.190145, "o", "\u001b[?2004h> "]
[305.190176, "o", "x, y = [], []\r\n\u001b[?2004l\r"]
[305.190207, "o", "\u001b[?2004h> "]
[305.190258, "o", "with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r"]
[305.190288, "o", "\u001b[?2004h> "]
[305.190318, "o", "    for line in f:\r\n\u001b[?2004l\r"]
[305.190348, "o", "\u001b[?2004h> "]
[305.190392, "o", "        line = line.strip()\r\n\u001b[?2004l\r"]
[305.190423, "o", "\u001b[?2004h> "]
[305.190455, "o", "        if not line:\r\n\u001b[?2004l\r"]
[305.190485, "o", "\u001b[?2004h> "]
[305.19052, "o", "            continue\r\n\u001b[?2004l\r"]
[305.190568, "o", "\u001b[?2004h> "]
[305.190617, "o", "        p = line.replace(',', '.').split()\r\n\u001b[?2004l\r"]
[305.190644, "o", "\u001b[?2004h> "]
[305.190715, "o", "        x.append(float(p[0])); y.append(float(p[1]))\r\n\u001b[?2004l\r"]
[305.190746, "o", "\u001b[?2004h> "]
[305.190794, "o", "x = np.array(x); y = np.array(y)\r\n\u001b[?2004l\r"]
[305.190826, "o", "\u001b[?2004h> "]
[305.190876, "o", "nu = 1e7 / x  # Raman shift in cm^-1\r\n\u001b[?2004l\r"]
[305.190906, "o", "\u001b[?2004h> "]
[305.190941, "o", "idx = np.argsort(nu)\r\n\u001b[?2004l\r"]
[305.190983, "o", "\u001b[?2004h> "]
[305.191014, "o", "nu, y = nu[idx], y[idx]\r\n\u001b[?2004l\r"]
[305.191044, "o", "\u001b[?2004h> "]
[305.1911, "o", "print('nu range:', nu.min(), nu.max())\r\n\u001b[?2004l\r"]
[305.191131, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.191159, "o", "\u001b[?2004h> "]
[305.191214, "o", "def lorentz(xv, x0, g, A, c):\r\n\u001b[?2004l\r"]
[305.191245, "o", "\u001b[?2004h> "]
[305.191307, "o", "    return c + A * g**2 / ((xv - x0)**2 + g**2)\r\n\u001b[?2004l\r"]
[305.191366, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.191396, "o", "\u001b[?2004h> "]
[305.191442, "o", "def fit_region(xv, yv, lo, hi, x0guess, label):\r\n\u001b[?2004l\r"]
[305.191471, "o", "\u001b[?2004h> "]
[305.191532, "o", "    m = (xv >= lo) & (xv <= hi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.191598, "o", "> "]
[305.191645, "o", "    xs, ys = xv[m], yv[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.191691, "o", "    n = len(xs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.1917, "o", "> "]
[305.191709, "o", "    # initial guesses\r\n"]
[305.191756, "o", "\u001b[?2004l\r"]
[305.191782, "o", "\u001b[?2004h> "]
[305.19181, "o", "    c0 = np.percentile(ys, 10)\r\n\u001b[?2004l\r"]
[305.191848, "o", "\u001b[?2004h> "]
[305.191875, "o", "    A0 = ys.max() - c0\r\n\u001b[?2004l\r"]
[305.191912, "o", "\u001b[?2004h> "]
[305.191952, "o", "    x0g = xs[np.argmax(ys)]\r\n\u001b[?2004l\r"]
[305.191977, "o", "\u001b[?2004h> "]
[305.192015, "o", "    # estimate HWHM\r\n\u001b[?2004l\r"]
[305.192048, "o", "\u001b[?2004h> "]
[305.192096, "o", "    above = xs[ys > c0 + A0/2]\r\n\u001b[?2004l\r"]
[305.192145, "o", "\u001b[?2004h> "]
[305.192262, "o", "    g0 = max((above.max() - above.min())/2, 1.0) if len(above) > 1 else 10.0\r\n\u001b[?2004l\r"]
[305.192303, "o", "\u001b[?2004h> "]
[305.19234, "o", "    try:\r\n\u001b[?2004l\r"]
[305.19236, "o", "\u001b[?2004h> "]
[305.192508, "o", "        popt, pcov = curve_fit(lorentz, xs, ys, p0=[x0g, g0, A0, c0], maxfev=20000)\r\n\u001b[?2004l\r"]
[305.192556, "o", "\u001b[?2004h> "]
[305.192606, "o", "        resid = ys - lorentz(xs, *popt)\r\n\u001b[?2004l\r"]
[305.192647, "o", "\u001b[?2004h> "]
[305.192769, "o", "        ss_res = np.sum(resid**2); ss_tot = np.sum((ys-ys.mean())**2)\r\n\u001b[?2004l\r"]
[305.192786, "o", "\u001b[?2004h> "]
[305.192849, "o", "        r2 = 1 - ss_res/ss_tot\r\n\u001b[?2004l\r"]
[305.192875, "o", "\u001b[?2004h> "]
[305.192943, "o", "        perr = np.sqrt(np.diag(pcov))\r\n\u001b[?2004l\r"]
[305.192968, "o", "\u001b[?2004h> "]
[305.193031, "o", "        print(f'{label}: n={n}')\r\n\u001b[?2004l\r"]
[305.19306, "o", "\u001b[?2004h> "]
[305.193158, "o", "        print(f'  x0={popt[0]:.4f} +/- {perr[0]:.4f}')\r\n\u001b[?2004l\r"]
[305.193199, "o", "\u001b[?2004h> "]
[305.193285, "o", "        print(f'  gamma={popt[1]:.4f} +/- {perr[1]:.4f}')\r\n\u001b[?2004l\r"]
[305.193326, "o", "\u001b[?2004h> "]
[305.193385, "o", "        print(f'  amplitude={popt[2]:.4f} +/- {perr[2]:.4f}')\r\n\u001b[?2004l\r"]
[305.193438, "o", "\u001b[?2004h> "]
[305.193477, "o", "        print(f'  offset={popt[3]:.4f} +/- {perr[3]:.4f}')\r\n\u001b[?2004l\r"]
[305.193511, "o", "\u001b[?2004h> "]
[305.193578, "o", "        print(f'  R2={r2:.5f}, RMS resid={np.sqrt(ss_res/n):.2f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.193617, "o", "        return popt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.193672, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.193736, "o", "        print(label, 'fit failed:', e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.193777, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.193811, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.193881, "o", "print('=== FIT IN RAMAN SHIFT SPACE (nu = 1e7/x) ===')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.19398, "o", "pG = fit_region(nu, y, 1450, 1750, 1580, 'G (nu space, win 1450-1750)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.194075, "o", "p2D = fit_region(nu, y, 2550, 2850, 2670, '2D (nu space, win 2550-2850)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.194126, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.194169, "o", "print()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.194217, "o", "print('=== FIT IN RAW X SPACE ===')\r\n\u001b[?2004l\r"]
[305.194256, "o", "\u001b[?2004h> "]
[305.19429, "o", "xs_all = x[np.argsort(x)]; ys_all = y[np.argsort(x)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.194328, "o", "> "]
[305.194401, "o", "fit_region(xs_all, ys_all, 6000, 6700, 6329, 'G (x space, win 6000-6700)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.194515, "o", "fit_region(xs_all, ys_all, 3550, 3950, 3745, '2D (x space, win 3550-3950)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.194554, "o", "EOF\r\n\u001b[?2004l\r"]
[305.195657, "o", "\u001b[?2004hroot@j-openenv-6afd86e54643bac7ac634d49-0uwksnk4-cd27c-l25jf:/app# "]
[305.195712, "o", "python3 /app/fit.py\r\n\u001b[?2004l\r"]
