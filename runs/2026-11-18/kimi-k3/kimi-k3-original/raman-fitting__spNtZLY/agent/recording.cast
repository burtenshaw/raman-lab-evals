[197.028033, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nx, y = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.replace(',', '.').split()\n        x.append(float(parts[0])); y.append(float(parts[1]))\nx = np.array(x); y = np.array(y)\nprint('monotonic decreasing:', np.all(np.diff(x) < 0))\nidx = np.argsort(x)\nxs, ys = x[idx], y[idx]\n# coarse binned overview\nnb = 60\nedges = np.linspace(0, len(xs), nb+1).astype(int)\nfor i in range(nb):\n    seg = slice(edges[i], edges[i+1])\n    print(f'{xs[seg].mean():9.1f} {ys[seg].mean():10.1f} ' + '#'*int(60*ys[seg].mean()/ys.max()))\nEOF\npython3 /app/explore2.py\n"]
