Sending keys: ["cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        p = line.replace(',', '.').split()\n        xs.append(float(p[0])); ys.append(float(p[1]))\nx = 1e7/np.array(xs)\ny = np.array(ys)\no = np.argsort(x)\nx, y = x[o], y[o]\n\ndef lorentz(x, x0, gamma, amp, off):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\n\ndef fit_peak(lo, hi, name):\n    m = (x >= lo) & (x <= hi)\n    xf, yf = x[m], y[m]\n    off0 = yf.min()\n    x00 = xf[np.argmax(yf)]\n    amp0 = yf.max() - off0\n    p0 = [x00, 15.0, amp0, off0]\n    popt, _ = curve_fit(lorentz, xf, yf, p0=p0, maxfev=20000)\n    x0, gamma, amp, off = popt\n    gamma = abs(gamma)\n    print(name, 'x0=%.3f gamma=%.3f amp=%.1f off=%.1f' % (x0, gamma, amp, off))\n    return {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amp), 'offset': float(off)}\n\nres = {\n    'G': fit_peak(1480, 1680, 'G'),\n    '2D': fit_peak(2580, 2800, '2D'),\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\npython3 /app/fit.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
