Sending keys: ["cat > /app/fit.py <<'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nconv = lambda s: float(s.replace(',', '.'))\ndata = np.loadtxt('/app/graphene.dat', converters={0: conv, 1: conv})\nx, y = data[:, 0], data[:, 1]\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\n\ndef lorentz(xx, x0, gamma, amp, off):\n    return amp * gamma**2 / ((xx - x0)**2 + gamma**2) + off\n\ndef fit_peak(center, halfwin=250):\n    m = np.abs(x - center) < halfwin\n    xs, ys = x[m], y[m]\n    off0 = np.min(ys)\n    amp0 = np.max(ys) - off0\n    x00 = xs[np.argmax(ys)]\n    # estimate HWHM\n    above = xs[ys > off0 + amp0/2]\n    g0 = max((above.max() - above.min())/2, 5)\n    p0 = [x00, g0, amp0, off0]\n    popt, pcov = curve_fit(lorentz, xs, ys, p0=p0, maxfev=20000)\n    perr = np.sqrt(np.diag(pcov))\n    return popt, perr\n\nresults = {}\nfor name, center in [('G', 3745), ('2D', 6329)]:\n    (x0, gamma, amp, off), perr = fit_peak(center)\n    print(f'{name}: x0={x0:.3f} gamma={abs(gamma):.3f} amp={amp:.2f} off={off:.2f}')\n    print(f'   errors: x0={perr[0]:.3f} gamma={perr[1]:.3f} amp={perr[2]:.2f} off={perr[3]:.2f}')\n    results[name] = {\n        'x0': float(x0),\n        'gamma': float(abs(gamma)),\n        'amplitude': float(amp),\n        'offset': float(off),\n    }\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
