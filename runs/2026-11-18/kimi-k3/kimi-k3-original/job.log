Sending keys: ["cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nx, y = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        p = line.replace(',', '.').split()\n        x.append(float(p[0])); y.append(float(p[1]))\nx = np.array(x); y = np.array(y)\nnu = 1e7 / x  # Raman shift in cm^-1\nidx = np.argsort(nu)\nnu, y = nu[idx], y[idx]\nprint('nu range:', nu.min(), nu.max())\n\ndef lorentz(xv, x0, g, A, c):\n    return c + A * g**2 / ((xv - x0)**2 + g**2)\n\ndef fit_region(xv, yv, lo, hi, x0guess, label):\n    m = (xv >= lo) & (xv <= hi)\n    xs, ys = xv[m], yv[m]\n    n = len(xs)\n    # initial guesses\n    c0 = np.percentile(ys, 10)\n    A0 = ys.max() - c0\n    x0g = xs[np.argmax(ys)]\n    # estimate HWHM\n    above = xs[ys > c0 + A0/2]\n    g0 = max((above.max() - above.min())/2, 1.0) if len(above) > 1 else 10.0\n    try:\n        popt, pcov = curve_fit(lorentz, xs, ys, p0=[x0g, g0, A0, c0], maxfev=20000)\n        resid = ys - lorentz(xs, *popt)\n        ss_res = np.sum(resid**2); ss_tot = np.sum((ys-ys.mean())**2)\n        r2 = 1 - ss_res/ss_tot\n        perr = np.sqrt(np.diag(pcov))\n        print(f'{label}: n={n}')\n        print(f'  x0={popt[0]:.4f} +/- {perr[0]:.4f}')\n        print(f'  gamma={popt[1]:.4f} +/- {perr[1]:.4f}')\n        print(f'  amplitude={popt[2]:.4f} +/- {perr[2]:.4f}')\n        print(f'  offset={popt[3]:.4f} +/- {perr[3]:.4f}')\n        print(f'  R2={r2:.5f}, RMS resid={np.sqrt(ss_res/n):.2f}')\n        return popt\n    except Exception as e:\n        print(label, 'fit failed:', e)\n        return None\n\nprint('=== FIT IN RAMAN SHIFT SPACE (nu = 1e7/x) ===')\npG = fit_region(nu, y, 1450, 1750, 1580, 'G (nu space, win 1450-1750)')\np2D = fit_region(nu, y, 2550, 2850, 2670, '2D (nu space, win 2550-2850)')\n\nprint()\nprint('=== FIT IN RAW X SPACE ===')\nxs_all = x[np.argsort(x)]; ys_all = y[np.argsort(x)]\nfit_region(xs_all, ys_all, 6000, 6700, 6329, 'G (x space, win 6000-6700)')\nfit_region(xs_all, ys_all, 3550, 3950, 3745, '2D (x space, win 3550-3950)')\nEOF\npython3 /app/fit.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
