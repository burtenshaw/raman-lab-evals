[111.359777, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7d-gqq6sva5-2fd45-b5bg7:/app# "]
[208.923665, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\nprint('--- binned profile (50 cm-1 bins) ---')\nfor lo in range(1100,3000,50):\n    m=(x>=lo)&(x<lo+50)\n    if m.sum()>0:\n        print(f'{lo:5d} n={m.sum():3d} mean={y[m].mean():8.1f} sem={y[m].std()/np.sqrt(m.sum()):6.1f} std={y[m].std():7.1f}')\n\ndef lor(x, amp, x0, g):\n    return amp*g*g/((x-x0)**2+g*g)\n\ndef fitD(lo,hi):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    # D + G both free + offset\n    def mod(x,a1,x1,g1,a2,x2,g2,off):\n        return lor(x,a1,x1,g1)+lor(x,a2,x2,g2)+off\n    p,c=curve_fit(mod,xs,ys,p0=[600,1354,13,6500,1579,9,800],maxfev=200000)\n    r1=y[m]-mod(xs,*p)\n    # D + offset only\n    p2,_=curve_fit(lambda x,a,x0,g,off: lor(x,a,x0,g)+off, xs,ys,p0=[600,1354,13,800],maxfev=200000)\n    r2=ys-(lor(xs,*p2[:3])+p2[3])\n    # D + G(fixed from G-only fit) + offset\n    pg,_=curve_fit(lambda x,a,x0,g,off: lor("]
[208.923798, "i", "x,a,x0,g)+off, x[(x>=1450)&(x<=1720)], y[(x>=1450)&(x<=1720)], p0=[6500,1579,9,800],maxfev=200000)\n    def mod3(x,a,x0,g,off):\n        return lor(x,a,x0,g)+lor(x,pg[0],pg[1],pg[2])+off\n    p3,_=curve_fit(mod3,xs,ys,p0=[600,1354,13,800],maxfev=200000)\n    r3=ys-mod3(xs,*p3)\n    print(f'[{lo},{hi}] D+G+off: x0={p[1]:.2f} g={p[2]:.2f} a={p[0]:.1f} off={p[6]:.1f} rms={np.sqrt(np.mean(r1**2)):.1f}')\n    print(f'          D+off   : x0={p2[1]:.2f} g={p2[2]:.2f} a={p2[0]:.1f} off={p2[3]:.1f} rms={np.sqrt(np.mean(r2**2)):.1f}')\n    print(f'          D+Gfix  : x0={p3[1]:.2f} g={p3[2]:.2f} a={p3[0]:.1f} off={p3[3]:.1f} rms={np.sqrt(np.mean(r3**2)):.1f}   (G params {np.round(pg,2)})')\n\nprint('--- D region diagnostics ---')\nfor lo,hi in [(1200,1470),(1250,1450),(1150,1500),(1280,1430)]:\n    fitD(lo,hi)\nEOF\npython3 /app/diag.py\n"]
[208.923853, "o", "cat > /app/diag.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.923934, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.923965, "o", "\u001b[?2004h> "]
[208.924031, "o", "d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.924107, "o", "x = d['raman_shift_cm1']; y = d['intensity']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.924145, "o", "\u001b[?2004h> "]
[208.92419, "o", "print('--- binned profile (50 cm-1 bins) ---')\r\n\u001b[?2004l\r"]
[208.92423, "o", "\u001b[?2004h> "]
[208.924269, "o", "for lo in range(1100,3000,50):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.924299, "o", "    m=(x>=lo)&(x<lo+50)\r\n\u001b[?2004l\r\u001b[?2004h"]
[208.924334, "o", "> "]
[208.924367, "o", "    if m.sum()>0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.924473, "o", "        print(f'{lo:5d} n={m.sum():3d} mean={y[m].mean():8.1f} sem={y[m].std()/np.sqrt(m.sum()):6.1f} std={y[m].std():7.1f}')\r\n\u001b[?2004l\r"]
[208.924505, "o", "\u001b[?2004h> \r\n"]
[208.924536, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[208.924566, "o", "def lor(x, amp, x0, g):\r\n\u001b[?2004l\r\u001b[?2004h"]
[208.924589, "o", "> "]
[208.924621, "o", "    return amp*g*g/((x-x0)**2+g*g)\r\n\u001b[?2004l\r"]
[208.924644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.924675, "o", "\u001b[?2004h> "]
[208.924706, "o", "def fitD(lo,hi):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.924743, "o", "    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.924793, "o", "    # D + G both free + offset\r\n\u001b[?2004l\r"]
[208.924816, "o", "\u001b[?2004h> "]
[208.924856, "o", "    def mod(x,a1,x1,g1,a2,x2,g2,off):\r\n\u001b[?2004l\r"]
[208.92488, "o", "\u001b[?2004h> "]
[208.924932, "o", "        return lor(x,a1,x1,g1)+lor(x,a2,x2,g2)+off\r\n\u001b[?2004l\r"]
[208.924942, "o", "\u001b[?2004h> "]
[208.925045, "o", "    p,c=curve_fit(mod,xs,ys,p0=[600,1354,13,6500,1579,9,800],maxfev=200000)\r\n\u001b[?2004l\r"]
[208.925077, "o", "\u001b[?2004h> "]
[208.925133, "o", "    r1=y[m]-mod(xs,*p)\r\n\u001b[?2004l\r"]
[208.925159, "o", "\u001b[?2004h> "]
[208.925189, "o", "    # D + offset only\r\n\u001b[?2004l\r"]
[208.925231, "o", "\u001b[?2004h> "]
[208.92531, "o", "    p2,_=curve_fit(lambda x,a,x0,g,off: lor(x,a,x0,g)+off, xs,ys,p0=[600,1354,13,800],maxfev=200000)\r\n\u001b[?2004l\r"]
[208.925335, "o", "\u001b[?2004h> "]
[208.925369, "o", "    r2=ys-(lor(xs,*p2[:3])+p2[3])\r\n\u001b[?2004l\r"]
[208.925394, "o", "\u001b[?2004h> "]
[208.925441, "o", "    # D + G(fixed from G-only fit) + offset\r\n\u001b[?2004l\r"]
[208.925466, "o", "\u001b[?2004h> "]
[208.925617, "o", "    pg,_=curve_fit(lambda x,a,x0,g,off: lor(x,a,x0,g)+off, x[(x>=1450)&(x<=1720)], y[(x>=1450)&(x<=1720)], p0=[6500,1579,9,800],maxfev=200000)\r\n\u001b[?2004l\r"]
[208.925643, "o", "\u001b[?2004h> "]
[208.925669, "o", "    def mod3(x,a,x0,g,off):\r\n\u001b[?2004l\r"]
[208.925694, "o", "\u001b[?2004h> "]
[208.925758, "o", "        return lor(x,a,x0,g)+lor(x,pg[0],pg[1],pg[2])+off\r\n\u001b[?2004l\r"]
[208.925785, "o", "\u001b[?2004h> "]
[208.925857, "o", "    p3,_=curve_fit(mod3,xs,ys,p0=[600,1354,13,800],maxfev=200000)\r\n\u001b[?2004l\r"]
[208.925881, "o", "\u001b[?2004h> "]
[208.925907, "o", "    r3=ys-mod3(xs,*p3)\r\n\u001b[?2004l\r"]
[208.925932, "o", "\u001b[?2004h> "]
[208.926058, "o", "    print(f'[{lo},{hi}] D+G+off: x0={p[1]:.2f} g={p[2]:.2f} a={p[0]:.1f} off={p[6]:.1f} rms={np.sqrt(np.mean(r1**2)):.1f}')\r\n\u001b[?2004l\r"]
[208.926085, "o", "\u001b[?2004h> "]
[208.926224, "o", "    print(f'          D+off   : x0={p2[1]:.2f} g={p2[2]:.2f} a={p2[0]:.1f} off={p2[3]:.1f} rms={np.sqrt(np.mean(r2**2)):.1f}')\r\n\u001b[?2004l\r"]
[208.926251, "o", "\u001b[?2004h> "]
[208.92643, "o", "    print(f'          D+Gfix  : x0={p3[1]:.2f} g={p3[2]:.2f} a={p3[0]:.1f} off={p3[3]:.1f} rms={np.sqrt(np.mean(r3**2)):.1f}   (G params {np.round(pg,2)})')\r\n\u001b[?2004l\r"]
[208.926459, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.926485, "o", "\u001b[?2004h> "]
[208.926513, "o", "print('--- D region diagnostics ---')\r\n\u001b[?2004l\r"]
[208.926537, "o", "\u001b[?2004h> "]
[208.926605, "o", "for lo,hi in [(1200,1470),(1250,1450),(1150,1500),(1280,1430)]:\r\n\u001b[?2004l\r"]
[208.926629, "o", "\u001b[?2004h> "]
[208.926642, "o", "    fitD(lo,hi)\r\n\u001b[?2004l\r"]
[208.926672, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
