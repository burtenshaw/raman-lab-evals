[81.943769, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7d-gqq6sva5-2fd45-b5bg7:/app# "]
[110.393883, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, amp, x0, g, off):\n    return amp*g*g/((x-x0)**2+g*g)+off\n\ndef fit(lo, hi, p0):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    resid = ys - lor(xs, *p)\n    ss = float(np.sum(resid**2))\n    return p, np.sqrt(ss/len(xs)), len(xs)\n\nprint('--- D individual windows ---')\nfor lo, hi in [(1150,1500),(1200,1470),(1250,1450),(1150,1480),(1100,1500)]:\n    p, r, n = fit(lo, hi, [800,1350,20,800])\n    print(f'[{lo},{hi}] n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.3f} off={p[3]:.3f} rms={r:.2f}')\n\nprint('--- G individual windows ---')\nfor lo, hi in [(1450,1720),(1470,1700),(1500,1680),(1480,1750),(1420,1760)]:\n    p, r, n = fit(lo, hi, [6600,1580,25,800])\n    print(f'[{lo},{hi}] n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.3f} off={p[3]:.3f} rms"]
[110.394036, "i", "={r:.2f}')\n\nprint('--- 2D individual windows ---')\nfor lo, hi in [(2500,2900),(2550,2850),(2520,2880),(2580,2820),(2450,2950)]:\n    p, r, n = fit(lo, hi, [9500,2690,30,900])\n    print(f'[{lo},{hi}] n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.3f} off={p[3]:.3f} rms={r:.2f}')\n\nprint('--- global fit 3 Lorentzians + one offset ---')\ndef model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):\n    return (a1*g1*g1/((x-x1)**2+g1*g1) + a2*g2*g2/((x-x2)**2+g2*g2)\n            + a3*g3*g3/((x-x3)**2+g3*g3) + off)\np0 = [800,1350,20, 6600,1580,25, 9500,2690,30, 800]\np, cov = curve_fit(model3, x, y, p0=p0, maxfev=500000)\nprint('params', np.round(p,4))\nresid = y - model3(x, *p)\nprint('global rms', float(np.sqrt(np.mean(resid**2))))\nEOF\npython3 /app/fit_test.py\n"]
[110.394106, "o", "cat > /app/fit_test.py << 'EOF'\r\n\u001b[?2004l\r={r:.2f}')\r\n\r\nprint('--- 2D individual windows ---')\r\nfor lo, hi in [(2500,2900),(2550,2850),(2520,2880),(2580,2820),(2450,2950)]:\r\n    p, r, n = fit(lo, hi, [9500,2690,30,900])\r\n    print(f'[{lo},{hi}] n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.3f} off={p[3]:.3f} rms={r:.2f}')\r\n\r\nprint("]
[110.394249, "o", "'--- global fit 3 Lorentzians + one offset ---')\r\ndef model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):\r\n    return (a1*g1*g1/((x-x1)**2+g1*g1) + a2*g2*g2/((x-x2)**2+g2*g2)\r\n            + a3*g3*g3/((x-x3)**2+g3*g3) + off)\r\np0 = [800,1350,20, 6600,1580,25, 9500,2690,30, 800]\r\np, cov = curve_fit(model3, x"]
[110.394315, "o", ", y, p0=p0, maxfev=500000)\r\nprint('params', np.round(p,4))\r\nresid = y - model3(x, *p)\r\nprint('global rms', float(np.sqrt(np.mean(resid**2))))\r\nEOF\r\npython3 /app/fit_test.py\r\n\u001b[?2004h"]
