[81.733064, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1'] if 'raman_shift_cm1' in d.dtype.names else d[d.dtype.names[0]]\ny = d['intensity']\nprint(d.dtype.names, len(x), x.min(), x.max())\nprint('global min/max', y.min(), y.max())\nfor lo, hi, name in [(1100,1500,'D'),(1450,1750,'G'),(2500,2900,'2D')]:\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    i = np.argmax(ys)\n    print(name, 'peak at', xs[i], 'value', ys[i], 'window median', np.median(ys), 'window min', ys.min())\n# coarse profile\nfor lo in range(1100, 3001, 100):\n    m = (x>=lo)&(x<lo+100)\n    if m.sum():\n        print(lo, round(float(y[m].mean()),1), round(float(y[m].max()),1), round(float(y[m].min()),1))\nEOF\npython3 /app/explore.py\n"]
