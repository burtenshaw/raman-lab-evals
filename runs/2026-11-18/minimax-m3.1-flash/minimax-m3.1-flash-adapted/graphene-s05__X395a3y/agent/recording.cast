[308.28422, "o", "x = np.asarray(d['raman_shift_cm1'], dtype=float)\r\n\u001b[?2004l\r"]
[308.28425, "o", "\u001b[?2004h> "]
[308.284288, "o", "y = np.asarray(d['intensity'], dtype=float)\r\n\u001b[?2004l\r"]
[308.284316, "o", "\u001b[?2004h> "]
[308.284368, "o", "print('data points:', len(x), 'range', x.min(), x.max())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.284405, "o", "\r\n\u001b[?2004l\r"]
[308.284431, "o", "\u001b[?2004h> "]
[308.284468, "o", "def lorentzian(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.284501, "o", "> "]
[308.28458, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[308.284609, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.284649, "o", "\u001b[?2004h> "]
[308.284676, "o", "windows = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.28472, "o", "    'D':  (1200.0, 1470.0, [700.0, 1350.0, 15.0, 830.0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.284801, "o", "    'G':  (1450.0, 1720.0, [6500.0, 1580.0, 10.0, 800.0]),\r\n\u001b[?2004l\r"]
[308.28483, "o", "\u001b[?2004h> "]
[308.284889, "o", "    '2D': (2500.0, 2900.0, [9500.0, 2690.0, 26.0, 800.0]),\r\n\u001b[?2004l\r"]
[308.284911, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[308.28495, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.284986, "o", "> results = {}\r\n\u001b[?2004l\r"]
[308.285026, "o", "\u001b[?2004h> "]
[308.285053, "o", "for name, (lo, hi, p0) in windows.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.285094, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[308.285171, "o", "\u001b[?2004h> "]
[308.285183, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.285226, "o", "> "]
[308.285284, "o", "    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.285364, "o", "    amplitude, x0, gamma, offset = [float(v) for v in popt]\r\n\u001b[?2004l\r"]
[308.285379, "o", "\u001b[?2004h> "]
[308.285434, "o", "    resid = ys - lorentzian(xs, *popt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.285467, "o", "> "]
[308.285526, "o", "    rms = float(np.sqrt(np.mean(resid**2)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.285599, "o", "    perr = np.sqrt(np.diag(pcov))\r\n\u001b[?2004l\r"]
[308.285635, "o", "\u001b[?2004h> "]
[308.285696, "o", "    print(f'{name:3s} window [{lo},{hi}] n={m.sum()}: amp={amplitude:.4f}+-{perr[0]:.4f} '\r\n\u001b[?2004l\r"]
[308.285733, "o", "\u001b[?2004h> "]
[308.285787, "o", "          f'x0={x0:.4f}+-{perr[1]:.4f} gamma={gamma:.4f}+-{perr[2]:.4f} '\r\n\u001b[?2004l\r"]
[308.285812, "o", "\u001b[?2004h> "]
[308.285882, "o", "          f'offset={offset:.4f}+-{perr[3]:.4f} rms={rms:.3f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.285997, "o", "    results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amplitude, 'offset': offset}\r\n\u001b[?2004l\r"]
[308.286027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.286051, "o", "\u001b[?2004h> "]
[308.28612, "o", "results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\r\n\u001b[?2004l\r"]
[308.286156, "o", "\u001b[?2004h> "]
[308.286202, "o", "print('ID_IG = %.6f' % results['ID_IG'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.286226, "o", "\u001b[?2004h> "]
[308.286275, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[308.286299, "o", "\u001b[?2004h> "]
[308.286338, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[308.286366, "o", "\u001b[?2004h> EOF\r\n"]
[308.286386, "o", "\u001b[?2004l\r"]
[308.287631, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7d-gqq6sva5-2fd45-b5bg7:/app# "]
[308.287675, "o", "python3 /app/final_fit.py\r\n\u001b[?2004l\r"]
[308.93373, "o", "data points: 3800 range 1100.0 3000.0\r\n"]
[308.934632, "o", "D   window [1200.0,1470.0] n=540: amp=635.8180+-27.7579 x0=1353.9736+-0.5574 gamma=12.7984+-0.9249 offset=838.6305+-7.2856 rms=123.688\r\n"]
[308.935199, "o", "G   window [1450.0,1720.0] n=540: amp=6547.6025+-30.9074 x0=1579.3908+-0.0427 gamma=9.0498+-0.0675 offset=807.1108+-6.2315 rms=116.002\r\n"]
[308.935711, "o", "2D  window [2500.0,2900.0] n=800: amp=9807.6593+-19.6808 x0=2688.6988+-0.0510 gamma=25.5816+-0.0901 offset=734.1501+-6.7102 rms=123.625\r\n"]
[308.935765, "o", "ID_IG = 0.097107\r\n"]
[308.998707, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7d-gqq6sva5-2fd45-b5bg7:/app# "]
