[110.397873, "o", "def model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):\r\n\u001b[?2004l\r"]
[110.397901, "o", "\u001b[?2004h> "]
[110.398025, "o", "    return (a1*g1*g1/((x-x1)**2+g1*g1) + a2*g2*g2/((x-x2)**2+g2*g2)\r\n\u001b[?2004l\r"]
[110.398053, "o", "\u001b[?2004h> "]
[110.398138, "o", "            + a3*g3*g3/((x-x3)**2+g3*g3) + off)\r\n\u001b[?2004l\r"]
[110.398168, "o", "\u001b[?2004h> "]
[110.39827, "o", "p0 = [800,1350,20, 6600,1580,25, 9500,2690,30, 800]\r\n\u001b[?2004l\r"]
[110.398297, "o", "\u001b[?2004h> "]
[110.3984, "o", "p, cov = curve_fit(model3, x, y, p0=p0, maxfev=500000)\r\n\u001b[?2004l\r"]
[110.398422, "o", "\u001b[?2004h> "]
[110.398494, "o", "print('params', np.round(p,4))\r\n\u001b[?2004l\r"]
[110.398522, "o", "\u001b[?2004h> "]
[110.398573, "o", "resid = y - model3(x, *p)\r\n\u001b[?2004l\r"]
[110.398605, "o", "\u001b[?2004h> "]
[110.398703, "o", "print('global rms', float(np.sqrt(np.mean(resid**2))))\r\n\u001b[?2004l\r"]
[110.398736, "o", "\u001b[?2004h> "]
[110.398758, "o", "EOF\r\n\u001b[?2004l\r"]
[110.400082, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7d-gqq6sva5-2fd45-b5bg7:/app# "]
[110.400131, "o", "python3 /app/fit_test.py\r\n\u001b[?2004l\r"]
