[259.280641, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7d-gqq6sva5-2fd45-b5bg7:/app# "]
[308.283668, "i", "cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'], dtype=float)\ny = np.asarray(d['intensity'], dtype=float)\nprint('data points:', len(x), 'range', x.min(), x.max())\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  (1200.0, 1470.0, [700.0, 1350.0, 15.0, 830.0]),\n    'G':  (1450.0, 1720.0, [6500.0, 1580.0, 10.0, 800.0]),\n    '2D': (2500.0, 2900.0, [9500.0, 2690.0, 26.0, 800.0]),\n}\n\nresults = {}\nfor name, (lo, hi, p0) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\n    amplitude, x0, gamma, offset = [float(v) for v in popt]\n    resid = ys - lorentzian(xs, *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    perr = np.sqrt(np.diag(pcov))\n    print(f'{name:3s} window [{lo},{hi}"]
[308.283721, "i", "] n={m.sum()}: amp={amplitude:.4f}+-{perr[0]:.4f} '\n          f'x0={x0:.4f}+-{perr[1]:.4f} gamma={gamma:.4f}+-{perr[2]:.4f} '\n          f'offset={offset:.4f}+-{perr[3]:.4f} rms={rms:.3f}')\n    results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amplitude, 'offset': offset}\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG = %.6f' % results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 /app/final_fit.py\n"]
[308.283859, "o", "cat > /app/final_fit.py << 'EOF'\r\n\u001b[?2004l\r"]
[308.283906, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[308.28394, "o", "\u001b[?2004h> "]
