[328.288925, "o", "{'D': {'x0': 1353.9736221438384, 'gamma': 12.79844315868683, 'amplitude': 635.8180309016975, 'offset': 838.630463887631}, 'G': {'x0': 1579.3908064786326, 'gamma': 9.049806281034677, 'amplitude': 6547.602525040285, 'offset': 807.1107980441031}, '2D': {'x0': 2688.6987946968043, 'gamma': 25.5816492639556, 'amplitude': 9807.659265030754, 'offset': 734.1500527377491}, 'ID_IG': 0.09710699885494126}\r\n"]
[328.292247, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7d-gqq6sva5-2fd45-b5bg7:/app# "]
[339.968753, "i", "python3 -c \"\nimport json\nr=json.load(open('/app/results.json'))\nassert set(r)=={'D','G','2D','ID_IG'}\nfor k in ('D','G','2D'):\n    assert set(r[k])=={'x0','gamma','amplitude','offset'}, r[k]\n    for v in r[k].values(): assert isinstance(v,float)\nassert isinstance(r['ID_IG'],float)\nassert abs(r['ID_IG']-r['D']['amplitude']/r['G']['amplitude'])<1e-12\nprint('JSON schema OK'); print(json.dumps(r,indent=2))\n\"\n"]
[339.968911, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.968953, "o", "> import json\r\n\u001b[?2004l\r"]
[339.969041, "o", "\u001b[?2004h> "]
[339.969084, "o", "r=json.load(open('/app/results.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.969129, "o", "assert set(r)=={'D','G','2D','ID_IG'}\r\n\u001b[?2004l\r"]
[339.969157, "o", "\u001b[?2004h> "]
[339.969198, "o", "for k in ('D','G','2D'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.969294, "o", "    assert set(r[k])=={'x0','gamma','amplitude','offset'}, r[k]\r\n\u001b[?2004l\r"]
[339.969336, "o", "\u001b[?2004h> "]
[339.969388, "o", "    for v in r[k].values(): assert isinstance(v,float)\r\n\u001b[?2004l\r"]
[339.969424, "o", "\u001b[?2004h> "]
[339.969456, "o", "assert isinstance(r['ID_IG'],float)\r\n\u001b[?2004l\r"]
[339.969474, "o", "\u001b[?2004h> "]
[339.969567, "o", "assert abs(r['ID_IG']-r['D']['amplitude']/r['G']['amplitude'])<1e-12\r\n\u001b[?2004l\r"]
[339.969602, "o", "\u001b[?2004h> "]
[339.969664, "o", "print('JSON schema OK'); print(json.dumps(r,indent=2))\r\n\u001b[?2004l\r"]
[339.969696, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
[339.987521, "o", "JSON schema OK\r\n"]
