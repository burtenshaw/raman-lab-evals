[?2004l[?2004h> for lo in range(1320,1396,5):
[?2004l[?2004h>     m=(x>=lo)&(x<lo+5)
[?2004l[?2004h>     print(f'{lo+2.5:7.1f} mean={y[m].mean():8.1f} n={m.sum()}')
[?2004l[?2004h> 
[?2004l[?2004h> # 2) chi2 profile over gamma for D region, x0/amp/offset optimized (linear)
[?2004l[?2004h> def chi2_profile(lo,hi,gammas,linear_baseline=False):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for g in gammas:
[?2004l[?2004h>         # grid over x0
[?2004l[?2004h>         best=None
[?2004l[?2004h>         for x0 in np.arange(1340,1368,0.5):
[?2004l[?2004h>             L=lor(xs,1,x0,g)
[?2004l[?2004h>             if linear_baseline:
[?2004l[?2004h>                 A=np.vstack([L,np.ones_like(xs),xs-xs.mean()]).T
[?2004l[?2004h>             else:
[?2004l[?2004h>                 A=np.vstack([L,np.ones_like(xs)]).T
[?2004l[?2004h>             c,res,rk,sv=np.linalg.lstsq(A,ys,rcond=None)
[?2004l[?2004h>             r=ys-A@c
[?2004l[?2004h>             s=float(np.sum(r*r))
[?2004l[?2004h>             if best is None or s<best[0]:
[?2004l[?2004h>                 best=(s,x0,c)
[?2004l[?2004h>         out.append((g,best))
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> for lb in (False,True):
[?2004l[?2004h>     print(f'--- D chi2 profile (linear_baseline={lb}) region 1150-1500 ---')
[?2004l[?2004h>     for g,b in chi2_profile(1150,1500,[6,8,10,12,13,14,16,18,20,25,30],lb):
[?2004l[?2004h>         print(f'  gamma={g:5.1f} chi2={b[0]:12.1f} x0={b[1]:7.2f} amp={b[2][0]:8.1f} off={b[2][1]:8.1f}')
[?2004l[?2004h> 
[?2004l[?2004h> # 3) global fits with linear / quadratic background
[?2004l[?2004h> def run_global(bg):
[?2004l[?2004h>     def model(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,*bgp):
[?2004l[?2004h>         m=(lor(x,a1,x1,g1)+lor(x,a2,x2,g2)+lor(x,a3,x3,g3))
[?2004l[?2004h>         if bg=='const': m=m+bgp[0]
[?2004l[?2004h>         elif bg=='lin': m=m+bgp[0]+bgp[1]*(x-2000)
[?2004l[?2004h>         else: m=m+bgp[0]+bgp[1]*(x-2000)+bgp[2]*(x-2000)**2/1e4
[?2004l[?2004h>         return m
[?2004l[?2004h>     if bg=='const': p0=[800,1354,13,6500,1579,9,9800,2689,26,800]
[?2004l[?2004h>     elif bg=='lin': p0=[800,1354,13,6500,1579,9,9800,2689,26,800,0.0]
[?2004l[?2004h>     else: p0=[800,1354,13,6500,1579,9,9800,2689,26,800,0.0,0.0]
[?2004l[?2004h>     p,_=curve_fit(model,x,y,p0=p0,maxfev=500000)
[?2004l[?2004h>     r=y-model(x,*p)
[?2004l[?2004h>     print(bg,'rms=%.2f'%float(np.sqrt(np.mean(r**2))),np.round(p,3))
[?2004l[?2004h> for bg in ('const','lin','quad'):
[?2004l[?2004h>     run_global(bg)
