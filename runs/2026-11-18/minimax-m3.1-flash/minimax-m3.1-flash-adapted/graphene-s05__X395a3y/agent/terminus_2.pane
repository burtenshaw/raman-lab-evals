[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.asarray(d['raman_shift_cm1'], dtype=float)
[?2004l[?2004h> y = np.asarray(d['intensity'], dtype=float)
[?2004l[?2004h> print('data points:', len(x), 'range', x.min(), x.max())
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D':  (1200.0, 1470.0, [700.0, 1350.0, 15.0, 830.0]),
[?2004l[?2004h>     'G':  (1450.0, 1720.0, [6500.0, 1580.0, 10.0, 800.0]),
[?2004l[?2004h>     '2D': (2500.0, 2900.0, [9500.0, 2690.0, 26.0, 800.0]),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi, p0) in windows.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     amplitude, x0, gamma, offset = [float(v) for v in popt]
[?2004l[?2004h>     resid = ys - lorentzian(xs, *popt)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     print(f'{name:3s} window [{lo},{hi}] n={m.sum()}: amp={amplitude:.4f}+-{perr[0]:.4f} '
[?2004l[?2004h>           f'x0={x0:.4f}+-{perr[1]:.4f} gamma={gamma:.4f}+-{perr[2]:.4f} '
[?2004l[?2004h>           f'offset={offset:.4f}+-{perr[3]:.4f} rms={rms:.3f}')
[?2004l[?2004h>     results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amplitude, 'offset': offset}
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> print('ID_IG = %.6f' % results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
