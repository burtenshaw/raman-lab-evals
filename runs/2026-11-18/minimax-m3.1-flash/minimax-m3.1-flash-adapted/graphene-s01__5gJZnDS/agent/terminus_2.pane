[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d['raman_shift_cm1']; y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def l3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):
[?2004l[?2004h>     return (lor(x,a1,x1,g1,0)+lor(x,a2,x2,g2,0)+lor(x,a3,x3,g3,0)+off)
[?2004l[?2004h> 
[?2004l[?2004h> p0 = [400,1350,15, 6900,1580,20, 14000,2694,30, 1300]
[?2004l[?2004h> lb = [0,1300,1, 0,1500,1, 0,2600,1, 0]
[?2004l[?2004h> ub = [1e6,1420,200, 1e6,1700,200, 1e6,2800,200, 1e6]
[?2004l[?2004h> popt, pcov = curve_fit(l3, x, y, p0=p0, bounds=(lb,ub), maxfev=200000)
[?2004l[?2004h> print('global fit params:')
[?2004l[?2004h> print('D  amp=%.3f x0=%.3f gamma=%.3f' % (popt[0],popt[1],popt[2]))
[?2004l[?2004h> print('G  amp=%.3f x0=%.3f gamma=%.3f' % (popt[3],popt[4],popt[5]))
[?2004l[?2004h> print('2D amp=%.3f x0=%.3f gamma=%.3f' % (popt[6],popt[7],popt[8]))
[?2004l[?2004h> print('offset=%.3f' % popt[9])
[?2004l[?2004h> res = y - l3(x,*popt)
[?2004l[?2004h> print('global rms resid', np.sqrt(np.mean(res**2)))
[?2004l[?2004h> print('ID/IG global', popt[0]/popt[3])
[?2004l[?2004h> EOF
