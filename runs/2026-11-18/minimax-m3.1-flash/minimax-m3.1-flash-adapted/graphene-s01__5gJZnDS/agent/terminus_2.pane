[?2004hroot@j-openenv-6afd8d38e5cad0e4dc3e6dae-2hrc9i0v-eb966-m9jxl:/app# cat > /app/fit_explore2.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d['raman_shift_cm1']; y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> # global 3 lorentzians + constant
[?2004l[?2004h> def l3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,off):
[?2004l[?2004h>     return lor(x,a1,x1,g1,0)+lor(x,a2,x2,g2,0)+lor(x,a3,x3,g3,0)+off
[?2004l[?2004h> p0=[400,1350,15,6900,1580,20,14000,2694,30,1300]
[?2004l[?2004h> popt,_=curve_fit(l3,x,y,p0=p0,maxfev=400000)
[?2004l[?2004h> res=y-l3(x,*popt)
[?2004l[?2004h> print('block mean residuals (global const-offset fit):')
[?2004l[?2004h> for lo in range(1100,3000,100):
[?2004l[?2004h>     m=(x>=lo)&(x<lo+100)
[?2004l[?2004h>     print(lo, 'mean=%.1f'%res[m].mean(), 'std=%.1f'%res[m].std())
[?2004l[?2004h> 
[?2004l[?2004h> # global with linear baseline
[?2004l[?2004h> def l3lin(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,b,m):
[?2004l[?2004h>     return l3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,0)+b+m*(x-2000)
[?2004l[?2004h> popt2,_=curve_fit(l3lin,x,y,p0=list(popt)+[0.0],maxfev=400000)
[?2004l[?2004h> print('linear baseline fit:', np.round(popt2,3))
[?2004l[?2004h> res2=y-l3lin(x,*popt2)
[?2004l[?2004h> print('rms resid lin', np.sqrt(np.mean(res2**2)))
[?2004l[?2004h> 
[?2004l[?2004h> def fitone(lo,hi):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xs,ys=x[m],y[m]
[?2004l[?2004h>     i=np.argmax(ys)
[?2004l[?2004h>     amp0=max(ys.max()-np.median(ys),1.0)
[?2004l[?2004h>     p=[amp0,xs[i],20.0,np.median(ys)]
[?2004l[?2004h>     try:
[?2004l[?2004h>         po,_=curve_fit(lor,xs,ys,p0=p,maxfev=200000)
[?2004l[?2004h>         r=ys-lor(xs,*po)
[?2004l[?2004h>         return po,np.sqrt(np.mean(r**2)),len(xs)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return None,e,0
[?2004l[?2004h> 
[?2004l[?2004h> print('\nIndividual window fits:')
[?2004l[?2004h> for name,cands in [('D',[(1200,1500),(1250,1450),(1280,1420),(1300,1400),(1200,1450),(1220,1480)]),
[?2004l[?2004h>                    ('G',[(1450,1750),(1500,1700),(1450,1650),(1500,1750),(1420,1780)]),
[?2004l[?2004h>                    ('2D',[(2400,3000),(2500,2900),(2450,2950),(2550,2850)])]:
[?2004l[?2004h>     for lo,hi in cands:
[?2004l[?2004h>         po,rms,n=fitone(lo,hi)
[?2004l[?2004h>         print(name,(lo,hi),'n=%d'%n, np.round(po,3) if po is not None else po, 'rms=%.2f'%rms)
[?2004l[?2004h> EOF
