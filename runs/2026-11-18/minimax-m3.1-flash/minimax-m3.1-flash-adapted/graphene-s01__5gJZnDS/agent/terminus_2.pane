EOF
python3 /app/fit_spectrum.py
[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # ---- load data ----
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> cols = list(d.dtype.names)
[?2004l[?2004h> x = d[cols[0]].astype(float)
[?2004l[?2004h> y = d[cols[1]].astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, lo, hi, guess):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     p0 = [guess[0], guess[1], guess[2], guess[3]]
[?2004l[?2004h>     lb = [0.0, guess[1] - 60.0, 0.5, -np.inf]
[?2004l[?2004h>     ub = [np.inf, guess[1] + 60.0, 200.0, np.inf]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=(lb, ub), maxfev=200000)
[?2004l[?2004h>     resid = ys - lorentzian(xs, *popt)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     err = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     return dict(zip(['amplitude', 'x0', 'gamma', 'offset'], [float(v) for v in popt])), rms, err, len(xs)
[?2004l[?2004h> 
[?2004l[?2004h> # windows chosen to isolate each peak (neighbour tails are negligible there)
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D':  (1250.0, 1450.0, [350.0, 1352.0, 20.0, 1280.0]),
[?2004l[?2004h>     'G':  (1450.0, 1750.0, [6930.0, 1581.0, 8.0, 1265.0]),
[?2004l[?2004h>     '2D': (2450.0, 2950.0, [14100.0, 2695.0, 27.0, 1190.0]),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi, g) in windows.items():
[?2004l[?2004h>     params, rms, err, n = fit_peak(x, y, lo, hi, g)
[?2004l[?2004h>     results[name] = params
[?2004l[?2004h>     print('%s: window %.0f-%.0f (n=%d) rms=%.2f' % (name, lo, hi, n, rms))
[?2004l[?2004h>     print('   amplitude=%.3f (+-%.3f)  x0=%.3f (+-%.3f)  gamma=%.3f (+-%.3f)  offset=%.3f (+-%.3f)'
[?2004l[?2004h>           % (params['amplitude'], err[0], params['x0'], err[1], params['gamma'], err[2], params['offset'], err[3]))
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print('ID/IG = %.6f' % results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> out = {
[?2004l[?2004h>     'D':  {k: results['D'][k]  for k in ['x0', 'gamma', 'amplitude', 'offset']},
[?2004l[?2004h>     'G':  {k: results['G'][k]  for k in ['x0', 'gamma', 'amplitude', 'offset']},
[?2004l[?2004h>     '2D': {k: results['2D'][k] for k in ['x0', 'gamma', 'amplitude', 'offset']},
[?2004l[?2004h>     'ID_IG': results['ID_IG'],
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(out, f, indent=2)
[?2004l[?2004h> print(json.dumps(out, indent=2))
[?2004l[?2004h> EOF
