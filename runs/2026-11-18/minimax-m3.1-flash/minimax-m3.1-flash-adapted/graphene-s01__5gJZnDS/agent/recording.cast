[91.004477, "o", "    p=[amp0,xs[i],20.0,np.median(ys)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.004512, "o", "> "]
[91.00455, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.004627, "o", "        po,_=curve_fit(lor,xs,ys,p0=p,maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.004661, "o", "> "]
[91.004698, "o", "        r=ys-lor(xs,*po)\r\n\u001b[?2004l\r"]
[91.00474, "o", "\u001b[?2004h> "]
[91.004805, "o", "        return po,np.sqrt(np.mean(r**2)),len(xs)\r\n\u001b[?2004l\r"]
[91.00485, "o", "\u001b[?2004h> "]
[91.004869, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[91.004912, "o", "\u001b[?2004h> "]
[91.004946, "o", "        return None,e,0"]
[91.004981, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.005014, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.005073, "o", "print('\\nIndividual window fits:')\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.005106, "o", "> "]
[91.005231, "o", "for name,cands in [('D',[(1200,1500),(1250,1450),(1280,1420),(1300,1400),(1200,1450),(1220,1480)]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.005267, "o", "> "]
[91.005379, "o", "                   ('G',[(1450,1750),(1500,1700),(1450,1650),(1500,1750),(1420,1780)]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.005414, "o", "> "]
[91.005514, "o", "                   ('2D',[(2400,3000),(2500,2900),(2450,2950),(2550,2850)])]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.005547, "o", "> "]
[91.005582, "o", "    for lo,hi in cands:\r\n\u001b[?2004l\r"]
[91.005617, "o", "\u001b[?2004h> "]
[91.005665, "o", "        po,rms,n=fitone(lo,hi)\r\n\u001b[?2004l\r"]
[91.005706, "o", "\u001b[?2004h> "]
[91.005826, "o", "        print(name,(lo,hi),'n=%d'%n, np.round(po,3) if po is not None else po, 'rms=%.2f'%rms)\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.005872, "o", "> EOF\r\n"]
[91.005913, "o", "\u001b[?2004l\r"]
