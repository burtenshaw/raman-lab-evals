[44.250512, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1'] if 'raman_shift_cm1' in d.dtype.names else d[d.dtype.names[0]]\ny = d['intensity']\nprint(d.dtype.names, x.min(), x.max(), len(x))\nfor lo, hi in [(1150,1550),(1450,1850),(2400,3000)]:\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    print('window', lo, hi, 'max at', xs[np.argmax(ys)], ys.max(), 'min', ys.min(), 'argmin at', xs[np.argmin(ys)])\nEOF\npython3 /app/explore.py\n"]
[44.250638, "o", "cat > /app/explore.py << 'EOF'\r\n\u001b[?2004l\r"]
