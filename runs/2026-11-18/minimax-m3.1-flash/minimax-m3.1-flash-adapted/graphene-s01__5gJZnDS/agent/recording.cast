[51.01755, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\nm = (x>=1150)&(x<=1500)\nxs, ys = x[m], y[m]\n# local maxima\nfor i in range(1,len(ys)-1):\n    if ys[i] > ys[i-1] and ys[i] >= ys[i+1]:\n        print('local max', round(xs[i],2), round(ys[i],2))\nprint('---- values around 1330-1380 ----')\nfor xx, yy in zip(xs, ys):\n    if 1300 <= xx <= 1400 and int(round(xx*2))%10==0:\n        print(round(xx,2), round(yy,2))\nEOF\npython3 /app/explore2.py\n"]
