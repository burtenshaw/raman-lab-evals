[51.26466, "o", "\u001b[?2004hroot@j-openenv-6afd8d38e5cad0e4dc3e6dae-2hrc9i0v-eb966-m9jxl:/app# "]
[60.546117, "i", "cat > /app/fit_explore.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, amp, x0, gamma, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ndef l3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):\n    return (lor(x,a1,x1,g1,0)+lor(x,a2,x2,g2,0)+lor(x,a3,x3,g3,0)+off)\n\np0 = [400,1350,15, 6900,1580,20, 14000,2694,30, 1300]\nlb = [0,1300,1, 0,1500,1, 0,2600,1, 0]\nub = [1e6,1420,200, 1e6,1700,200, 1e6,2800,200, 1e6]\npopt, pcov = curve_fit(l3, x, y, p0=p0, bounds=(lb,ub), maxfev=200000)\nprint('global fit params:')\nprint('D  amp=%.3f x0=%.3f gamma=%.3f' % (popt[0],popt[1],popt[2]))\nprint('G  amp=%.3f x0=%.3f gamma=%.3f' % (popt[3],popt[4],popt[5]))\nprint('2D amp=%.3f x0=%.3f gamma=%.3f' % (popt[6],popt[7],popt[8]))\nprint('offset=%.3f' % popt[9])\nres = y - l3(x,*popt)\nprint('global rms resid', np.sqrt(np.mean(res**2)))\nprint('ID/IG global', popt[0]/popt[3])\nEOF\npython3 /app/fit_exp"]
[60.546247, "i", "lore.py\n"]
