[108.486297, "o", "d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.486398, "o", "x = np.array(d[d.dtype.names[0]], float); y = np.array(d['intensity'], float)\r\n\u001b[?2004l\r"]
[108.486463, "o", "\u001b[?2004h> "]
[108.486504, "o", "def lor(x,a,x0,g):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.486546, "o", "    return a*g**2/((x-x0)**2+g**2)\r\n\u001b[?2004l\r"]
[108.486589, "o", "\u001b[?2004h> "]
[108.486643, "o", "def model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c):\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.486741, "o", "> "]
[108.486776, "o", "    return lor(x,a1,x1,g1)+lor(x,a2,x2,g2)+lor(x,a3,x3,g3)+c\r\n\u001b[?2004l\r"]
[108.486831, "o", "\u001b[?2004h> "]
[108.486883, "o", "def model3lin(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c,m):\r\n\u001b[?2004l\r"]
[108.486927, "o", "\u001b[?2004h> "]
