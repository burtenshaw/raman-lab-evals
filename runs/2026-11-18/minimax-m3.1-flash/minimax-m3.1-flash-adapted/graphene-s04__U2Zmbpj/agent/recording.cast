[149.893624, "i", "cat > /app/fit_final.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\ncols = d.dtype.names\nx = np.array(d[cols[0]], dtype=float)\ny = np.array(d[cols[1]], dtype=float)\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# peak search ranges (nominal +-100 cm-1 around expected positions)\nsearch = {'D': (1250.0, 1450.0), 'G': (1500.0, 1700.0), '2D': (2580.0, 2800.0)}\nHW = 100.0   # half-width of fitting window (cm-1)\n\nresults = {}\nfor name, (lo, hi) in search.items():\n    sm = (x >= lo) & (x <= hi)\n    xs, ys = x[sm], y[sm]\n    i = int(np.argmax(ys))\n    xpk = xs[i]\n    ypk = ys[i]\n    base = float(np.median(np.r_[ys[:20], ys[-20:]]))\n    half = (ypk + base) / 2.0\n    j = i\n    while j > 0 and ys[j] > half:\n        j -= 1\n    k = i\n    while k < len(ys) - 1 and ys[k] > half:\n        k += 1\n    gamma0 = max((xs[k] - xs[j]) / 2.0, 5.0)\n\n    m = np.abs("]
[149.893797, "i", "x - xpk) <= HW\n    xf, yf = x[m], y[m]\n    p0 = [ypk - base, xpk, gamma0, base]\n    popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=200000)\n    perr = np.sqrt(np.diag(pcov))\n    resid = yf - lorentzian(xf, *popt)\n    results[name] = {\n        'x0': float(popt[1]),\n        'gamma': float(popt[2]),\n        'amplitude': float(popt[0]),\n        'offset': float(popt[3]),\n    }\n    print(f'{name}: window={xf.min():.1f}-{xf.max():.1f} n={xf.size}')\n    print(f'   amplitude={popt[0]:.3f} +/- {perr[0]:.3f}   x0={popt[1]:.4f} +/- {perr[1]:.4f}')\n    print(f'   gamma={popt[2]:.4f} +/- {perr[2]:.4f}   offset={popt[3]:.3f} +/- {perr[3]:.3f}   resid_rms={resid.std():.2f}')\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG =', results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 /app/fit_final.py\n"]
