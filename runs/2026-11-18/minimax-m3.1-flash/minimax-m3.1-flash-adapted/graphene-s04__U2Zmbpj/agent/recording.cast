[76.089203, "o", "print('GLOBAL:', np.array2string(popt, precision=4))\r\n\u001b[?2004l\r"]
[76.089216, "o", "\u001b[?2004h"]
[76.089234, "o", "> "]
[76.089263, "o", "res = y - lor3(x,*popt)\r\n\u001b[?2004l\r"]
[76.089296, "o", "\u001b[?2004h> "]
[76.08934, "o", "print('global resid rms', res.std(), 'max', np.abs(res).max())\r\n\u001b[?2004l\r"]
[76.089354, "o", "\u001b[?2004h"]
[76.089374, "o", "> "]
[76.089421, "o", "print('D amp, G amp ratio global:', popt[0]/popt[3])\r\n\u001b[?2004l\r"]
[76.08944, "o", "\u001b[?2004h"]
[76.089476, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.089509, "o", "# local fits, various windows\r\n\u001b[?2004l\r"]
[76.089526, "o", "\u001b[?2004h> "]
[76.089577, "o", "for name,c in [('D',1346),('G',1585),('2D',2678)]:\r\n\u001b[?2004l\r"]
[76.089603, "o", "\u001b[?2004h> "]
[76.089664, "o", "    for hw in [60,80,100,120,150,200]:\r\n\u001b[?2004l\r"]
[76.089689, "o", "\u001b[?2004h> "]
[76.089723, "o", "        m = np.abs(x-c) <= hw\r\n\u001b[?2004l\r"]
[76.089756, "o", "\u001b[?2004h> "]
[76.089788, "o", "        xx,yy = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.089818, "o", "        if name=='D':\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.089834, "o", "> "]
[76.089867, "o", "            pk=[1346,25]\r\n\u001b[?2004l\r"]
[76.089898, "o", "\u001b[?2004h> "]
[76.089917, "o", "        elif name=='G':\r\n\u001b[?2004l\r"]
[76.08995, "o", "\u001b[?2004h> "]
[76.08998, "o", "            pk=[1585,20]\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.090011, "o", ">         else:\r\n\u001b[?2004l\r"]
[76.090043, "o", "\u001b[?2004h> "]
[76.090058, "o", "            pk=[2678,25]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.090137, "o", "        p=[yy.max()-np.median(yy), pk[0], pk[1], np.median(yy)]\r\n\u001b[?2004l\r"]
[76.090178, "o", "\u001b[?2004h> "]
[76.090214, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.090263, "o", "            pp,_ = curve_fit(lor, xx, yy, p0=p, maxfev=100000)\r\n\u001b[?2004l\r"]
[76.090297, "o", "\u001b[?2004h> "]
[76.090333, "o", "            r = yy - lor(xx,*pp)\r\n"]
[76.090365, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[76.090481, "o", "            print(f'{name} hw={hw}: amp={pp[0]:.2f} x0={pp[1]:.3f} gamma={pp[2]:.3f} off={pp[3]:.2f} rms={r.std():.2f}')\r\n\u001b[?2004l\r"]
[76.090514, "o", "\u001b[?2004h> "]
[76.090555, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[76.090581, "o", "\u001b[?2004h> "]
[76.090622, "o", "            print(name, hw, 'fail', e)\r\n\u001b[?2004l\r"]
[76.090657, "o", "\u001b[?2004h> EOF"]
[76.090689, "o", "\r\n\u001b[?2004l\r"]
[76.09184, "o", "\u001b[?2004h"]
