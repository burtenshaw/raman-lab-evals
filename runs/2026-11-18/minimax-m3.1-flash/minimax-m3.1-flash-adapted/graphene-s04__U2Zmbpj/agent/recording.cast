[50.720898, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d['raman_shift_cm1'], dtype=float) if 'raman_shift_cm1' in d.dtype.names else np.array(d[d.dtype.names[0]], dtype=float)\ny = np.array(d['intensity'], dtype=float)\nprint(d.dtype.names)\nprint('n=', x.size, 'xmin=', x.min(), 'xmax=', x.max(), 'dx=', np.diff(x)[:3], np.diff(x)[-3:])\nprint('ymin=', y.min(), 'ymax=', y.max())\nfor name, c in [('D',1350), ('G',1580), ('2D',2690)]:\n    m = (x > c-60) & (x < c+60)\n    xs, ys = x[m], y[m]\n    i = np.argmax(ys)\n    print(name, 'peak x=', xs[i], 'ymax=', ys[i], 'edge mean=', np.mean(np.r_[ys[:20], ys[-20:]]))\nfor lo, hi in [(1100,1250),(1250,1450),(1450,1700),(1700,2400),(2400,2900),(2900,3100),(3100,3801)]:\n    m = (x>=lo)&(x<hi)\n    print(f'window {lo}-{hi}: n={m.sum()} min={y[m].min():.1f} max={y[m].max():.1f} mean={y[m].mean():.1f}')\nEOF\npython3 /app/explore.py\n"]
