[108.485841, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d[d.dtype.names[0]], float); y = np.array(d['intensity'], float)\ndef lor(x,a,x0,g):\n    return a*g**2/((x-x0)**2+g**2)\ndef model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c):\n    return lor(x,a1,x1,g1)+lor(x,a2,x2,g2)+lor(x,a3,x3,g3)+c\ndef model3lin(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c,m):\n    return model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c)+m*(x-2000)\ndef model4(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,a4,x4,g4,c):\n    return model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c)+lor(x,a4,x4,g4)\n\np0=[12100,1346,15, 8620,1585,14, 10760,2678,20, 1100]\npg,_=curve_fit(model3,x,y,p0=p0,maxfev=300000)\nprint('model3 params:', np.array2string(pg,precision=3), 'rms', (y-model3(x,*pg)).std())\nres = y-model3(x,*pg)\nfor lo in range(1100,3000,100):\n    m=(x>=lo)&(x<lo+100)\n    print(f'  bin {lo}-{lo+100}: resid mean={res[m].mean():8.1f} std={res[m].std():7.1f}')\n\ntry:\n    pl,_=curve_fit(model3lin,x,y,p0=list("]
[108.48596, "i", "pg)+[0.0],maxfev=300000)\n    print('model3+lin:', np.array2string(pl,precision=3),'rms',(y-model3lin(x,*pl)).std())\nexcept Exception as e: print('lin fail',e)\n\nfor x4 in [1620, 2450, 3100, 1200]:\n    try:\n        p4,_=curve_fit(model4,x,y,p0=list(pg[:9])+[200.0,x4,60.0,pg[9]],maxfev=300000)\n        print(f'model4 extra@{x4}: rms',(y-model4(x,*p4)).std(),'extra amp/g:',p4[9],p4[11])\n    except Exception as e: print('m4 fail',e)\n\n# noise estimate in flat region 1700-2400 with linear detrend\nm=(x>=1700)&(x<=2400)\nxx,yy=x[m],y[m]\nco=np.polyfit(xx,yy,1); r=yy-np.polyval(co,xx)\nprint('flat-region residual std (linear detrend):', r.std())\nEOF\npython3 /app/diag.py\n"]
[108.486025, "o", "cat > /app/diag.py << 'EOF'\r\n\u001b[?2004l\r"]
