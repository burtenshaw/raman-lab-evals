[108.488753, "o", "\u001b[?2004h> "]
[108.488819, "o", "        p4,_=curve_fit(model4,x,y,p0=list(pg[:9])+[200.0,x4,60.0,pg[9]],maxfev=300000)\r\n\u001b[?2004l\r"]
[108.488863, "o", "\u001b[?2004h> "]
[108.488971, "o", "        print(f'model4 extra@{x4}: rms',(y-model4(x,*p4)).std(),'extra amp/g:',p4[9],p4[11])\r\n\u001b[?2004l\r"]
[108.489002, "o", "\u001b[?2004h> "]
