[76.086896, "i", "cat > /app/fit_explore.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d[d.dtype.names[0]], float)\ny = np.array(d['intensity'], float)\n\ndef lor(x, amp, x0, gamma, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ndef lor3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, c):\n    return (lor(x,a1,x1,g1,0)+lor(x,a2,x2,g2,0)+lor(x,a3,x3,g3,0)+c)\n\n# rough peak/half-max analysis\nfor name,c in [('D',1346),('G',1585),('2D',2678)]:\n    m = (x>c-100)&(x<c+100)\n    xs,ys = x[m],y[m]\n    i = np.argmax(ys); ypk = ys[i]\n    base = np.median(np.r_[ys[:15], ys[-15:]])\n    half = (ypk+base)/2\n    # find crossings around index i\n    j = i\n    while j>0 and ys[j]>half: j-=1\n    k = i\n    while k<len(ys)-1 and ys[k]>half: k+=1\n    fwhm = xs[k]-xs[j]\n    print(f'{name}: xpk={xs[i]:.2f} ypk={ypk:.1f} localbase~{base:.1f} FWHM={fwhm:.2f} gamma~{fwhm/2:.2f}')\n\n# global fit\np0 = [12000,1346,25, 8500,1585,20, 10500,2678,25, 1100]\npopt, pcov = c"]
[76.087024, "i", "urve_fit(lor3, x, y, p0=p0, maxfev=200000)\nprint('GLOBAL:', np.array2string(popt, precision=4))\nres = y - lor3(x,*popt)\nprint('global resid rms', res.std(), 'max', np.abs(res).max())\nprint('D amp, G amp ratio global:', popt[0]/popt[3])\n\n# local fits, various windows\nfor name,c in [('D',1346),('G',1585),('2D',2678)]:\n    for hw in [60,80,100,120,150,200]:\n        m = np.abs(x-c) <= hw\n        xx,yy = x[m], y[m]\n        if name=='D':\n            pk=[1346,25]\n        elif name=='G':\n            pk=[1585,20]\n        else:\n            pk=[2678,25]\n        p=[yy.max()-np.median(yy), pk[0], pk[1], np.median(yy)]\n        try:\n            pp,_ = curve_fit(lor, xx, yy, p0=p, maxfev=100000)\n            r = yy - lor(xx,*pp)\n            print(f'{name} hw={hw}: amp={pp[0]:.2f} x0={pp[1]:.3f} gamma={pp[2]:.3f} off={pp[3]:.2f} rms={r.std():.2f}')\n        except Exception as e:\n            print(name, hw, 'fail', e)\nEOF\npython3 /app/fit_explore.py\n"]
[76.087107, "o", "cat > /app/fit_explore.py << 'EOF'\r\n\u001b[?2004l\rurve_fit(lor3, x, y, p0=p0, maxfev=200000)\r\nprint('GLOBAL:', np.array2string(popt, precision=4))\r\nre"]
