[108.487041, "o", "\u001b[?2004h> "]
[108.487102, "o", "def model4(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,a4,x4,g4,c):\r\n\u001b[?2004l\r"]
[108.487145, "o", "\u001b[?2004h> "]
[108.487221, "o", "    return model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c)+lor(x,a4,x4,g4)\r\n\u001b[?2004l\r"]
[108.487261, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[108.487301, "o", "\u001b[?2004h> "]
[108.487363, "o", "p0=[12100,1346,15, 8620,1585,14, 10760,2678,20, 1100]\r\n\u001b[?2004l\r"]
[108.487406, "o", "\u001b[?2004h> "]
[108.487463, "o", "pg,_=curve_fit(model3,x,y,p0=p0,maxfev=300000)\r\n\u001b[?2004l\r"]
[108.487514, "o", "\u001b[?2004h> "]
[108.487608, "o", "print('model3 params:', np.array2string(pg,precision=3), 'rms', (y-model3(x,*pg)).std())\r\n\u001b[?2004l\r"]
[108.487687, "o", "\u001b[?2004h> "]
[108.487725, "o", "res = y-model3(x,*pg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.487765, "o", "for lo in range(1100,3000,100):\r\n\u001b[?2004l\r"]
[108.487807, "o", "\u001b[?2004h> "]
[108.487849, "o", "    m=(x>=lo)&(x<lo+100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.487888, "o", "> "]
[108.488025, "o", "    print(f'  bin {lo}-{lo+100}: resid mean={res[m].mean():8.1f} std={res[m].std():7.1f}')\r\n\u001b[?2004l\r"]
[108.488076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[108.488131, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r"]
[108.48817, "o", "\u001b[?2004h> "]
[108.488236, "o", "    pl,_=curve_fit(model3lin,x,y,p0=list(pg)+[0.0],maxfev=300000)\r\n\u001b[?2004l\r"]
[108.48828, "o", "\u001b[?2004h> "]
[108.488385, "o", "    print('model3+lin:', np.array2string(pl,precision=3),'rms',(y-model3lin(x,*pl)).std())\r\n\u001b[?2004l\r"]
[108.488428, "o", "\u001b[?2004h> "]
[108.48848, "o", "except Exception as e: print('lin fail',e)\r\n\u001b[?2004l\r"]
[108.488525, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[108.488569, "o", "> "]
