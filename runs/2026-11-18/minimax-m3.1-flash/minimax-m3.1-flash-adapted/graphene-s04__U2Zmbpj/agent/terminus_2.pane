[?2004l[?2004h>         'offset': float(popt[3]),
[?2004l[?2004h>     }
[?2004l[?2004h>     print(f'{name}: window={xf.min():.1f}-{xf.max():.1f} n={xf.size}')
[?2004l[?2004h>     print(f'   amplitude={popt[0]:.3f} +/- {perr[0]:.3f}   x0={popt[1]:.4f} +/- {perr[1]:.4f}')
[?2004l[?2004h>     print(f'   gamma={popt[2]:.4f} +/- {perr[2]:.4f}   offset={popt[3]:.3f} +/- {perr[3]:.3f}   resid_rms={resid.std():.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
