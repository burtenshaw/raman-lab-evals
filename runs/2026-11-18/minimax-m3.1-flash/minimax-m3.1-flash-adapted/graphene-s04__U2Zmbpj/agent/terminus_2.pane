[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> cols = d.dtype.names
[?2004l[?2004h> x = np.array(d[cols[0]], dtype=float)
[?2004l[?2004h> y = np.array(d[cols[1]], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # peak search ranges (nominal +-100 cm-1 around expected positions)
[?2004l[?2004h> search = {'D': (1250.0, 1450.0), 'G': (1500.0, 1700.0), '2D': (2580.0, 2800.0)}
[?2004l[?2004h> HW = 100.0   # half-width of fitting window (cm-1)
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi) in search.items():
[?2004l[?2004h>     sm = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[sm], y[sm]
[?2004l[?2004h>     i = int(np.argmax(ys))
[?2004l[?2004h>     xpk = xs[i]
[?2004l[?2004h>     ypk = ys[i]
[?2004l[?2004h>     base = float(np.median(np.r_[ys[:20], ys[-20:]]))
[?2004l[?2004h>     half = (ypk + base) / 2.0
[?2004l[?2004h>     j = i
[?2004l[?2004h>     while j > 0 and ys[j] > half:
[?2004l[?2004h>         j -= 1
[?2004l[?2004h>     k = i
[?2004l[?2004h>     while k < len(ys) - 1 and ys[k] > half:
[?2004l[?2004h>         k += 1
[?2004l[?2004h>     gamma0 = max((xs[k] - xs[j]) / 2.0, 5.0)
[?2004l[?2004h> 
[?2004l[?2004h>     m = np.abs(x - xpk) <= HW
[?2004l[?2004h>     xf, yf = x[m], y[m]
[?2004l[?2004h>     p0 = [ypk - base, xpk, gamma0, base]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=200000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     resid = yf - lorentzian(xf, *popt)
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(popt[1]),
[?2004l[?2004h>         'gamma': float(popt[2]),
