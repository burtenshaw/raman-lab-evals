Sending keys: ['cat > /app/write_results.py << \'EOF\'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt(\'/app/spectrum.csv\', delimiter=\',\', skiprows=1)\nx, y = data[:, 0], data[:, 1]\n\ndef lorentzian(xx, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((xx - x0)**2 + gamma**2) + offset\n\ndef fit_peak(center, halfwidth=100.0):\n    m = (x >= center - halfwidth) & (x <= center + halfwidth)\n    xs, ys = x[m], y[m]\n    off0 = float(np.percentile(ys, 10))\n    amp0 = float(ys.max() - off0)\n    p0 = [amp0, center, 20.0, off0]\n    p, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\n    amp, x0, gamma, off = [float(v) for v in p]\n    res = ys - lorentzian(xs, *p)\n    rms = float(np.sqrt(np.mean(res**2)))\n    err = np.sqrt(np.diag(pcov))\n    print(f\'{x0:8.3f} +/- {err[1]:.3f} | amp {amp:10.3f} +/- {err[0]:.3f} | gamma {gamma:7.3f} +/- {err[2]:.3f} | off {off:9.3f} +/- {err[3]:.3f} | rms {rms:.2f} | n {len(xs)}\')\n    return {"x0": x0, "gamma": gamma, "amplitude": amp, "offset": off}\n\nD = fit_peak(1346.0)\nG = fit_peak(1585.0)\nD2 = fit_peak(2678.0)\n\nresults = {\n    "D": D,\n    "G": G,\n    "2D": D2,\n    "ID_IG": D["amplitude"] / G["amplitude"],\n}\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n    f.write(\'\\n\')\nprint(\'ID_IG =\', results[\'ID_IG\'])\nEOF\npython3 /app/write_results.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
