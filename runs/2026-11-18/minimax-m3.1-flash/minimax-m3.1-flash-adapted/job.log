Sending keys: ['cat > /app/fit_test.py << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', names=True)\nx = d[\'raman_shift_cm1\']; y = d[\'intensity\']\n\ndef lor(x, x0, gamma, amp, off):\n    return amp * gamma**2 / ((x - x0)**2 + gamma**2) + off\n\npeaks = {\n    \'D\':  (1352, 35, 350, 1300, [(1200,1500),(1250,1460),(1280,1430),(1300,1410),(1220,1480)]),\n    \'G\':  (1581, 25, 6400, 1290, [(1480,1700),(1500,1660),(1520,1640),(1450,1750),(1530,1630)]),\n    \'2D\': (2695, 35, 13900, 1350, [(2500,2900),(2550,2850),(2580,2820),(2600,2800),(2450,2950)]),\n}\n\nfor name, (x0g, gg, ag, og, windows) in peaks.items():\n    print(\'=====\', name)\n    for (lo, hi) in windows:\n        m = (x >= lo) & (x <= hi)\n        xs, ys = x[m], y[m]\n        p0 = [x0g, gg, ag, og]\n        bounds = ([lo, 1, 1, 0], [hi, 500, 1e6, 1e5])\n        try:\n            p, cov = curve_fit(lor, xs, ys, p0=p0, bounds=bounds, maxfev=100000)\n        except Exception as e:\n            print(\'   window\', lo, hi, \'FAILED\', e); continue\n        resid = ys - lor(xs, *p)\n        rms = np.sqrt(np.mean(resid**2))\n        print(f"   [{lo},{hi}] x0={p[0]:8.3f} gamma={p[1]:8.3f} amp={p[2]:10.2f} off={p[3]:9.2f} rms={rms:8.2f} perr={np.sqrt(np.diag(cov))}")\n\n# global fit: three Lorentzians + one offset\ndef multi(x, x1,g1,a1, x2,g2,a2, x3,g3,a3, off):\n    return (a1*g1**2/((x-x1)**2+g1**2) + a2*g2**2/((x-x2)**2+g2**2)\n            + a3*g3**2/((x-x3)**2+g3**2) + off)\n\np0 = [1352,35,350, 1581,25,6400, 2695,35,13900, 1300]\nbounds = ([1250,1,1, 1450,1,1, 2500,1,1, 0], [1450,500,1e6, 1700,500,1e6, 2900,500,1e6, 1e5])\np, cov = curve_fit(multi, x, y, p0=p0, bounds=bounds, maxfev=200000)\nresid = y - multi(x, *p)\nprint(\'GLOBAL:\', np.round(p, 4), \'rms\', np.sqrt(np.mean(resid**2)))\nEOF\npython3 /app/fit_test.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
