Sending keys: ["cd /app && cat > resid.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d[d.dtype.names[1]]\ndef lor(x, x0, g, a, o): return a*g**2/((x-x0)**2+g**2)+o\nfor name, lo, hi, xg in [('D',1250,1450,1350),('G',1500,1660,1580),('2D',2500,2900,2690)]:\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,_=curve_fit(lor,xs,ys,p0=[xg,20,ys.max()-np.median(ys),np.median(ys)],maxfev=200000)\n    r=ys-lor(xs,*p)\n    print(f'--- {name} params {p}')\n    for blo in range(lo,hi,25):\n        mm=(xs>=blo)&(xs<blo+25)\n        print(f'  {blo}-{blo+25}: mean_resid={r[mm].mean():8.2f} std={r[mm].std():7.2f}')\nEOF\npython3 resid.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, amp, x0, g, off):\n    return amp*g*g/((x-x0)**2+g*g)+off\n\ndef fit(lo, hi, p0):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    resid = ys - lor(xs, *p)\n    ss = float(np.sum(resid**2))\n    return p, np.sqrt(ss/len(xs)), len(xs)\n\nprint('--- D individual windows ---')\nfor lo, hi in [(1150,1500),(1200,1470),(1250,1450),(1150,1480),(1100,1500)]:\n    p, r, n = fit(lo, hi, [800,1350,20,800])\n    print(f'[{lo},{hi}] n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.3f} off={p[3]:.3f} rms={r:.2f}')\n\nprint('--- G individual windows ---')\nfor lo, hi in [(1450,1720),(1470,1700),(1500,1680),(1480,1750),(1420,1760)]:\n    p, r, n = fit(lo, hi, [6600,1580,25,800])\n    print(f'[{lo},{hi}] n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.3f} off={p[3]:.3f} rms={r:.2f}')\n\nprint('--- 2D individual windows ---')\nfor lo, hi in [(2500,2900),(2550,2850),(2520,2880),(2580,2820),(2450,2950)]:\n    p, r, n = fit(lo, hi, [9500,2690,30,900])\n    print(f'[{lo},{hi}] n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.3f} off={p[3]:.3f} rms={r:.2f}')\n\nprint('--- global fit 3 Lorentzians + one offset ---')\ndef model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):\n    return (a1*g1*g1/((x-x1)**2+g1*g1) + a2*g2*g2/((x-x2)**2+g2*g2)\n            + a3*g3*g3/((x-x3)**2+g3*g3) + off)\np0 = [800,1350,20, 6600,1580,25, 9500,2690,30, 800]\np, cov = curve_fit(model3, x, y, p0=p0, maxfev=500000)\nprint('params', np.round(p,4))\nresid = y - model3(x, *p)\nprint('global rms', float(np.sqrt(np.mean(resid**2))))\nEOF\npython3 /app/fit_test.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/global_fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1']); y = np.asarray(d['intensity'])\n\ndef model(x, aD,gD,xD, aG,gG,xG, a2,g2,x2, c0, c1=0.0, c2=0.0):\n    L = lambda a,g,x0: a*g*g/((x-x0)**2+g*g)\n    return L(aD,gD,xD)+L(aG,gG,xG)+L(a2,g2,x2)+c0+c1*(x-2000)/1000+c2*((x-2000)/1000)**2\n\np0 = [6000,18.5,1355, 7500,11,1583.5, 10000,28.5,2676.5, 900,0,0]\nfor nbg,name in [(1,'const'),(2,'linear'),(3,'quad')]:\n    p,cov = curve_fit(model, x, y, p0=p0[:9+nbg], maxfev=200000)\n    r = y - model(x, *p)\n    print(name, 'rmse=%.2f'%np.sqrt(np.mean(r**2)))\n    labels = ['aD','gD','xD','aG','gG','xG','a2','g2','x2','c0','c1','c2'][:9+nbg]\n    for lab,val in zip(labels,p):\n        print('   %-4s %12.4f'%(lab,val))\n    if nbg==1:\n        # binned residual means to look for structure\n        bins = np.arange(1100,3010,50)\n        print('   residual means per 50 cm-1:')\n        for i in range(len(bins)-1):\n            m=(x>=bins[i])&(x<bins[i+1])\n            if m.sum(): print('     %6.0f  %8.1f (n=%d)'%(bins[i], r[m].mean(), m.sum()))\nEOF\npython3 /app/global_fit.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
