Sending keys: ["cat > /app/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lor(x, amp, x0, gamma, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef pos_gamma(c, hw):\n    m = (x > c-hw) & (x < c+hw)\n    xc, yc = x[m], y[m]\n    i = np.argmax(yc); base = np.median(yc)\n    bounds = ([0, c-60, 1, -1e6],[1e7, c+60, 200, 1e6])\n    p, _ = curve_fit(lor, xc, yc, p0=[yc[i]-base, xc[i], 20.0, base], bounds=bounds, maxfev=200000)\n    res = yc - lor(xc,*p)\n    return p, np.sqrt(np.mean(res**2))\n\nprint('--- individual fits, gamma>0 ---')\nfor name, c in [('D',1348),('G',1580),('2D',2690)]:\n    for hw in [30,40,50,60,80,100,120,150]:\n        p, rms = pos_gamma(c, hw)\n        print('%3s hw=%3d amp=%9.2f x0=%9.3f gamma=%7.3f off=%9.2f rms=%7.2f' % (name,hw,p[0],p[1],p[2],p[3],rms))\n\nprint('--- background medians in peak-free windows ---')\nfor lo,hi in [(1100,1200),(1200,1250),(1450,1500),(1650,1750),(1800,2000),(2100,2400),(2450,2600),(2800,3000),(1100,3000)]:\n    m=(x>=lo)&(x<hi)\n    print('  %5d-%5d  median=%8.2f  mean=%8.2f' % (lo,hi,np.median(y[m]),np.mean(y[m])))\n\nprint('--- simultaneous 3-Lorentzian + shared constant offset ---')\ndef model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):\n    return (lor(x,a1,x1,g1,0)+lor(x,a2,x2,g2,0)+lor(x,a3,x3,g3,0)+off)\np0=[8213,1348,16.7, 7513,1580,12.9, 10377,2692,20.9, 1350]\nbounds=([0,1300,1, 0,1540,1, 0,2650,1, -1e6],[1e7,1400,200, 1e7,1620,200, 1e7,2740,200, 1e6])\np,_=curve_fit(model3, x, y, p0=p0, bounds=bounds, maxfev=200000)\nprint('  ', np.round(p,3))\nres=y-model3(x,*p)\nprint('   rms=%.2f' % np.sqrt(np.mean(res**2)))\nprint('   ID/IG=%.5f' % (p[0]/p[3]))\nEOF\npython3 /app/fit2.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
