Sending keys: ['cat > /app/fit_lorentzians.py << \'EOF\'\n#!/usr/bin/env python3\n"""Fit single Lorentzian peaks (D, G, 2D) + constant offset to a Raman spectrum."""\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nDATA = \'/app/spectrum.csv\'\nOUT = \'/app/results.json\'\n\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n\nraw = np.genfromtxt(DATA, delimiter=\',\', names=True)\nx = np.asarray(raw[\'raman_shift_cm1\'], dtype=float)\ny = np.asarray(raw[\'intensity\'], dtype=float)\n\n# (label, window (cm-1), initial guess [amplitude, x0, gamma, offset])\nPEAKS = [\n    (\'D\',  (1200.0, 1500.0), [600.0, 1354.0, 13.0, 840.0]),\n    (\'G\',  (1480.0, 1680.0), [6550.0, 1579.0, 9.0, 800.0]),\n    (\'2D\', (2550.0, 2850.0), [9800.0, 2689.0, 26.0, 730.0]),\n]\n\nresults = {}\nfor name, (lo, hi), p0 in PEAKS:\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    popt, _ = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=100000)\n    amplitude, x0, gamma, offset = popt\n    rms = float(np.sqrt(np.mean((ys - lorentzian(xs, *popt))**2)))\n    results[name] = {\n        \'x0\': float(x0),\n        \'gamma\': float(gamma),\n        \'amplitude\': float(amplitude),\n        \'offset\': float(offset),\n    }\n    print(f\'{name:>2}: amp={amplitude:10.3f}  x0={x0:9.3f}  gamma={gamma:8.3f}  \'\n          f\'offset={offset:9.3f}  rms_resid={rms:7.2f}  (window {lo}-{hi})\')\n\nresults[\'ID_IG\'] = float(results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\'])\nprint(f"ID/IG = {results[\'ID_IG\']:.5f}")\n\nwith open(OUT, \'w\') as f:\n    json.dump(results, f, indent=2)\nprint(\'wrote\', OUT)\nEOF\npython3 /app/fit_lorentzians.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef lorlin(x, x0, gamma, amp, b0, b1):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+b0+b1*(x-1400.0)\n\npeaks = {'D':(1250,1450,[1348,16,8200,1250]),'G':(1500,1660,[1580,13,7500,1300]),'2D':(2600,2790,[2692,21,10400,1420])}\nfor name,(lo,hi,p0) in peaks.items():\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,_=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)\n    r=ys-lor(xs,*p)\n    print('==',name,'const fit:', np.round(p,3))\n    # binned residuals\n    edges=np.arange(lo,hi+1,10.0)\n    for i in range(len(edges)-1):\n        mm=(xs>=edges[i])&(xs<edges[i+1])\n        if mm.sum(): print('   %6.0f  %8.1f  n=%d'%(edges[i], r[mm].mean(), mm.sum()))\n    pl,_=curve_fit(lorlin,xs,ys,p0=p0+[0.0,0.0],maxfev=200000)\n    print('   linear-bg fit:', np.round(pl,3))\nEOF\npython3 /app/diag.py\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d[d.dtype.names[0]], float)\ny = np.asarray(d['intensity'], float)\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, lo, hi, name):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    # initial guesses from the data\n    off0 = float(np.percentile(ys, 10))\n    i = int(np.argmax(ys))\n    amp0 = float(ys[i] - off0)\n    x00 = float(xs[i])\n    # half-maximum width estimate\n    half = off0 + amp0 / 2.0\n    idx = np.where(ys >= half)[0]\n    gam0 = max(float(xs[idx[-1]] - xs[idx[0]]) / 2.0, 1.0) if len(idx) > 1 else 10.0\n    p0 = [amp0, gam0, x00, off0]\n    p, cov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\n    amplitude, gamma, x0, offset = p\n    gamma = abs(gamma)\n    resid = ys - lorentzian(xs, amplitude, gamma, x0, offset)\n    rmse = float(np.sqrt(np.mean(resid**2)))\n    print(f'{name:2s} window=[{lo:.1f},{hi:.1f}] n={m.sum():4d}  amp={amplitude:10.3f}  gamma={gamma:8.4f}  '\n          f'x0={x0:10.4f}  offset={offset:9.3f}  rmse={rmse:6.2f}')\n    return dict(x0=float(x0), gamma=float(gamma), amplitude=float(amplitude), offset=float(offset))\n\n# symmetric windows (+/-100 cm-1) around each peak centre\nD  = fit_peak(x, y, 1246.7, 1446.7, 'D')\nG  = fit_peak(x, y, 1479.6, 1679.6, 'G')\nDD = fit_peak(x, y, 2593.4, 2793.4, '2D')\n\nID_IG = D['amplitude'] / G['amplitude']\nresults = {'D': D, 'G': G, '2D': DD, 'ID_IG': float(ID_IG)}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('\\nID_IG =', ID_IG)\nprint('wrote /app/results.json')\nEOF\npython3 /app/final_fit.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
