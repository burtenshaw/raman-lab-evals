Sending keys: ["cat > /app/global_check.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\ndef f(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):\n    L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o\n    return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)-oD + L(a2,g2,x2,o2)-oD\ndef g3(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):\n    L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o\n    return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)+L(a2,g2,x2,o2)-2*oD\np0=[636,12.8,1354,839,6551,9.08,1579,799,9807,25.6,2689,736]\np,cov=curve_fit(g3,x,y,p0=p0,maxfev=200000)\nnames='aD gD xD oD aG gG xG oG a2 g2 x2 o2'.split()\nfor n,v in zip(names,p): print(f'{n}={v:.4f}')\nrms=np.sqrt(np.mean((y-g3(x,*p))**2)); print('global rms',round(rms,3))\nprint('global ID_IG',round(p[0]/p[4],6))\nEOF\npython3 /app/global_check.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
