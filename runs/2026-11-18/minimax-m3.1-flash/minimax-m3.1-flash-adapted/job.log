Sending keys: ["cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef model(x, amplitude, gamma, x0, offset):\n    return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset\n\ndef fit(lo, hi, guess_x0, label=''):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    base = np.percentile(ys, 10)\n    i = np.argmax(ys)\n    amp0 = ys[i]-base\n    # estimate gamma from half max width\n    half = base + amp0/2\n    idx = np.where(ys>=half)[0]\n    g0 = max((xs[idx[-1]]-xs[idx[0]])/2, 2.0) if len(idx)>1 else 15.0\n    p0 = [amp0, g0, xs[i], base]\n    p, cov = curve_fit(model, xs, ys, p0=p0, maxfev=200000)\n    resid = ys - model(xs, *p)\n    rms = np.sqrt(np.mean(resid**2))\n    print(f'{label:22s} win=({lo},{hi}) amp={p[0]:9.2f} gamma={p[1]:7.3f} x0={p[2]:9.3f} off={p[3]:8.2f} rms={rms:7.2f} n={m.sum()}')\n    return p\n\nprint('=== D ===')\nfor lo,hi in [(1150,1500),(1200,1470),(1250,1450),(1150,1550),(1220,1480)]:\n    fit(lo,hi,1350,'D')\nprint('=== G ===')\nfor lo,hi in [(1480,1700),(1500,1680),(1520,1660),(1450,1720),(1530,1650)]:\n    fit(lo,hi,1581,'G')\nprint('=== 2D ===')\nfor lo,hi in [(2400,3000),(2450,2950),(2500,2900),(2350,3000),(2500,3000),(2450,2850),(2550,2850)]:\n    fit(lo,hi,2694,'2D')\nEOF\npython3 /app/fit.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
