Sending keys: ['cat > /app/fit.py << \'EOF\'\nimport numpy as np, itertools\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', names=True)\nx = d[d.dtype.names[0]]; y = d[\'intensity\']\n\ndef lor(x, amp, x0, gam, off):\n    return amp*gam*gam/((x-x0)**2+gam*gam) + off\n\ndef fitwin(lo, hi, p0=None):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    if p0 is None:\n        off0 = np.percentile(ys, 10)\n        i = np.argmax(ys)\n        amp0 = ys[i]-off0\n        p0 = [amp0, xs[i], 20.0, off0]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    res = lor(xs, *p)-ys\n    return p, np.sqrt(np.mean(res**2)), len(xs)\n\ncands = {\n \'D\':  [(1200,1500),(1250,1450),(1280,1420),(1300,1420),(1200,1450),(1250,1480)],\n \'G\':  [(1450,1700),(1500,1660),(1520,1650),(1480,1680),(1520,1700),(1450,1750)],\n \'2D\': [(2400,2950),(2450,2900),(2500,2850),(2550,2800),(2400,2850),(2500,2950)],\n}\nfor name, wins in cands.items():\n    print(\'===\', name)\n    for lo,hi in wins:\n        p, rms, n = fitwin(lo,hi)\n        print(f"  win=({lo},{hi}) n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.2f} off={p[3]:.2f} rms={rms:.1f}")\n\n# global fit: 3 Lorentzians + shared constant offset\ndef model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):\n    return (a1*g1*g1/((x-x1)**2+g1*g1) + a2*g2*g2/((x-x2)**2+g2*g2)\n            + a3*g3*g3/((x-x3)**2+g3*g3) + off)\np0 = [6000,1353,20, 7500,1582,20, 9800,2672,40, 900]\nlo_b = [0,1300,5, 0,1530,5, 0,2600,5, 0]\nhi_b = [20000,1400,100, 20000,1650,100, 20000,2750,200, 3000]\np, cov = curve_fit(model3, x, y, p0=p0, bounds=(lo_b,hi_b), maxfev=400000)\nres = model3(x,*p)-y\nprint(\'=== GLOBAL 3L+offset: rms\', np.sqrt(np.mean(res**2)))\nprint(\'  D : amp=%.3f x0=%.3f gamma=%.3f\'%(p[0],p[1],p[2]))\nprint(\'  G : amp=%.3f x0=%.3f gamma=%.3f\'%(p[3],p[4],p[5]))\nprint(\'  2D: amp=%.3f x0=%.3f gamma=%.3f\'%(p[6],p[7],p[8]))\nprint(\'  offset=%.3f\'%p[9])\nprint(\'  ID/IG(global)=%.5f\'%(p[0]/p[3]))\nEOF\npython3 /app/fit.py\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
