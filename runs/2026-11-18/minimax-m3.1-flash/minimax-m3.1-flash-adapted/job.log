Sending keys: ['cat > /app/fit_raman.py << \'EOF\'\n#!/usr/bin/env python3\n"""Fit Lorentzian + constant offset peaks (D, G, 2D) in a graphene Raman spectrum."""\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nCSV = \'/app/spectrum.csv\'\nOUT = \'/app/results.json\'\n\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n\ndef fit_peak(x, y, lo, hi, guess_gamma=15.0):\n    m = (x >= lo) & (x <= hi)\n    xx, yy = x[m], y[m]\n    base = np.percentile(yy, 10)\n    i = int(np.argmax(yy))\n    p0 = [float(xx[i]), guess_gamma, float(yy[i] - base), float(base)]\n    popt, _ = curve_fit(lorentzian, xx, yy, p0=p0, maxfev=200000)\n    resid = lorentzian(xx, *popt) - yy\n    rms = float(np.sqrt(np.mean(resid**2)))\n    print(f\'window {lo}-{hi}: x0={popt[0]:.4f} gamma={popt[1]:.4f} \'\n          f\'amp={popt[2]:.3f} off={popt[3]:.3f} resid_rms={rms:.2f} npts={m.sum()}\')\n    return popt\n\n\ndef main():\n    data = np.loadtxt(CSV, delimiter=\',\', skiprows=1)\n    x, y = data[:, 0], data[:, 1]\n\n    d = fit_peak(x, y, 1250.0, 1450.0)\n    g = fit_peak(x, y, 1500.0, 1700.0)\n    t = fit_peak(x, y, 2550.0, 2850.0)\n\n    results = {\n        "D":  {"x0": float(d[0]), "gamma": float(d[1]), "amplitude": float(d[2]), "offset": float(d[3])},\n        "G":  {"x0": float(g[0]), "gamma": float(g[1]), "amplitude": float(g[2]), "offset": float(g[3])},\n        "2D": {"x0": float(t[0]), "gamma": float(t[1]), "amplitude": float(t[2]), "offset": float(t[3])},\n        "ID_IG": float(d[2] / g[2]),\n    }\n    with open(OUT, \'w\') as f:\n        json.dump(results, f, indent=2)\n    print(json.dumps(results, indent=2))\n\n\nif __name__ == \'__main__\':\n    main()\nEOF\npython3 /app/fit_raman.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'], dtype=float)\ny = np.asarray(d['intensity'], dtype=float)\n\ndef lorentzian(xx, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((xx - x0)**2 + gamma**2) + offset\n\ndef fit_peak(lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=500000)\n    perr = np.sqrt(np.diag(pcov))\n    resid = ys - lorentzian(xs, *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    print('window %d-%d  n=%d  rms=%.2f' % (lo, hi, len(xs), rms))\n    print('   x0=%.4f +/- %.4f   gamma=%.4f +/- %.4f   amp=%.3f +/- %.3f   off=%.3f +/- %.3f'\n          % (popt[0], perr[0], popt[1], perr[1], popt[2], perr[2], popt[3], perr[3]))\n    return popt\n\nP_D  = fit_peak(1250, 1450, [1349.2, 13.5, 1313.0, 970.0])\nP_G  = fit_peak(1500, 1700, [1581.1,  8.5, 6600.0, 935.0])\nP_2D = fit_peak(2500, 2900, [2684.7, 17.0, 13070.0, 805.0])\n\nID_IG = float(P_D[2] / P_G[2])\nprint('\\nI_D/I_G = %.6f' % ID_IG)\n\nresults = {\n    'D':  {'x0': float(P_D[0]),  'gamma': float(P_D[1]),  'amplitude': float(P_D[2]),  'offset': float(P_D[3])},\n    'G':  {'x0': float(P_G[0]),  'gamma': float(P_G[1]),  'amplitude': float(P_G[2]),  'offset': float(P_G[3])},\n    '2D': {'x0': float(P_2D[0]), 'gamma': float(P_2D[1]), 'amplitude': float(P_2D[2]), 'offset': float(P_2D[3])},\n    'ID_IG': ID_IG,\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/final_fit.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
