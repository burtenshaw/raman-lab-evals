Sending keys: ["cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'], dtype=float)\ny = np.asarray(d['intensity'], dtype=float)\n\ndef lorentzian(xv, amplitude, gamma, x0, offset):\n    return amplitude*gamma**2/((xv-x0)**2 + gamma**2) + offset\n\ndef fit_peak(lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    i = int(np.argmax(ys))\n    x0_0 = xs[i]\n    off0 = float(np.median(np.concatenate([ys[:20], ys[-20:]])))\n    amp0 = float(ys[i] - off0)\n    half = off0 + amp0/2.0\n    above = xs[ys >= half]\n    gam0 = max(float((above[-1]-above[0])/2.0), 3.0)\n    p, _ = curve_fit(lorentzian, xs, ys, p0=[amp0, gam0, x0_0, off0], maxfev=200000)\n    resid = ys - lorentzian(xs, *p)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    print(f'window [{lo},{hi}] amp={p[0]:.3f} gamma={p[1]:.3f} x0={p[2]:.3f} off={p[3]:.3f} rms={rms:.2f}')\n    return p\n\nres = {}\nfor name, (lo, hi) in {'D': (1250.0, 1450.0), 'G': (1480.0, 1680.0), '2D': (2580.0, 2780.0)}.items():\n    amp, gam, x0, off = fit_peak(lo, hi)\n    res[name] = {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(off)}\n\nres['ID_IG'] = float(res['D']['amplitude']/res['G']['amplitude'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\npython3 /app/fit.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
