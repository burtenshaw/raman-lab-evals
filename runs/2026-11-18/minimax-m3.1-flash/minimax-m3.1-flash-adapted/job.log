Sending keys: ["cat > /app/global.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef make_model(deg):\n    def model(xx, a1,x1,g1,a2,x2,g2,a3,x3,g3, *bg):\n        L = a1*g1**2/((xx-x1)**2+g1**2) + a2*g2**2/((xx-x2)**2+g2**2) + a3*g3**2/((xx-x3)**2+g3**2)\n        poly = sum(b*( (xx-2000)/1000 )**i for i,b in enumerate(bg))\n        return L + poly\n    return model\n\nfor deg in (0,1,2,3):\n    p0 = [12080,1346,14.7, 8600,1585,13.9, 10764,2678,19.94] + [1300.0]*deg + ([-50.0] if deg==0 else [])\n    model = make_model(deg)\n    if deg==0:\n        p0 = [12080,1346,14.7, 8600,1585,13.9, 10764,2678,19.94, 1300.0]\n    p,cov = curve_fit(model, x, y, p0=p0, maxfev=200000)\n    res = y - model(x,*p)\n    rms = np.sqrt(np.mean(res**2))\n    print(f'deg={deg} rms={rms:.2f} params={np.array2string(p, precision=3)}')\n    if deg==2:\n        resid = res\n        idx = np.argsort(-np.abs(resid))[:15]\n        print(' largest residuals at x =', np.sort(x[idx]))\nEOF\npython3 /app/global.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ["cd /app && cat > fit_spectrum.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nnames = data.dtype.names\nx = data[names[0]]\ny = data[names[1]]\n\ndef lorentzian(xv, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((xv - x0)**2 + gamma**2) + offset\n\ndef fit_peak(lo, hi, x0_guess, gamma_guess=20.0):\n    mask = (x >= lo) & (x <= hi)\n    xs, ys = x[mask], y[mask]\n    offset0 = float(np.median(ys))\n    amp0 = float(ys.max() - offset0)\n    p0 = [x0_guess, gamma_guess, amp0, offset0]\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\n    resid = ys - lorentzian(xs, *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    ss_res = float(np.sum(resid**2))\n    ss_tot = float(np.sum((ys - ys.mean())**2))\n    r2 = 1 - ss_res / ss_tot\n    perr = np.sqrt(np.diag(pcov))\n    return popt, rms, r2, perr\n\npeaks = {\n    'D':  (1250.0, 1450.0, 1350.0, 18.0),\n    'G':  (1500.0, 1660.0, 1580.0, 10.0),\n    '2D': (2500.0, 2900.0, 2690.0, 25.0),\n}\n\nresults = {}\nfits = {}\nfor name, (lo, hi, g, gg) in peaks.items():\n    popt, rms, r2, perr = fit_peak(lo, hi, g, gg)\n    fits[name] = popt\n    results[name] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3]),\n    }\n    print(f'{name:>3}: window {lo}-{hi}  x0={popt[0]:.4f}+/-{perr[0]:.4f}  gamma={popt[1]:.4f}+/-{perr[1]:.4f}  '\n          f'amp={popt[2]:.3f}+/-{perr[2]:.3f}  off={popt[3]:.3f}+/-{perr[3]:.3f}  rms={rms:.2f}  R2={r2:.6f}')\n\nresults['ID_IG'] = float(fits['D'][2] / fits['G'][2])\nprint('I_D/I_G =', results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('written /app/results.json')\nEOF\npython3 fit_spectrum.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
