Sending keys: ["cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d[d.dtype.names[0]])\ny = np.array(d['intensity'])\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ndef fit(lo, hi, guess):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(lor, xs, ys, p0=guess, maxfev=100000)\n    res = lor(xs, *p) - ys\n    rms = np.sqrt(np.mean(res**2))\n    return p, rms, len(xs)\n\npeaks = {\n 'D':  [(1200,1500),(1250,1470),(1280,1450),(1300,1420),(1150,1550)],\n 'G':  [(1450,1700),(1480,1680),(1500,1660),(1400,1750)],\n '2D': [(2450,2950),(2500,2900),(2550,2850),(2400,3000),(2600,2780)],\n}\nguess = {'D': (1350,15,1400,950), 'G': (1581,15,6600,950), '2D': (2685,15,13000,900)}\nfor name, wins in peaks.items():\n    print('===', name)\n    for (lo,hi) in wins:\n        try:\n            p, rms, n = fit(lo,hi,guess[name])\n            print('win %6.1f-%6.1f n=%4d  x0=%9.3f gamma=%8.3f amp=%10.2f off=%8.2f rms=%8.3f' % (lo,hi,n,p[0],p[1],p[2],p[3],rms))\n        except Exception as e:\n            print('win', lo, hi, 'FAILED', e)\nEOF\npython3 /app/fit_test.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
