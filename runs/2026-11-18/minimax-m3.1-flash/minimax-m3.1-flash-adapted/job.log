Sending keys: ["cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, x0g, w):\n    m = (x >= x0g - w) & (x <= x0g + w)\n    xs, ys = x[m], y[m]\n    off0 = np.percentile(ys, 10)\n    amp0 = ys.max() - off0\n    p0 = [amp0, x0g, 20.0, off0]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=100000)\n    res = ys - lor(xs, *p)\n    rms = float(np.sqrt(np.mean(res**2)))\n    ss_res = float(np.sum(res**2)); ss_tot = float(np.sum((ys-np.mean(ys))**2))\n    r2 = 1 - ss_res/ss_tot\n    return p, rms, r2, len(xs)\n\nfor name, x0g, windows in [('D',1346,[100,150,200,250]),('G',1585,[100,150,200,250]),('2D',2678,[100,150,200,250])]:\n    print('===', name)\n    for w in windows:\n        p, rms, r2, n = fit_peak(x,y,x0g,w)\n        print(f'  w=+-{w}: amp={p[0]:.3f} x0={p[1]:.3f} gamma={p[2]:.3f} off={p[3]:.3f} rms={rms:.3f} r2={r2:.6f} n={n}')\nEOF\npython3 /app/fit.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
