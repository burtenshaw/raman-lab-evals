Sending keys: ["cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d[d.dtype.names[0]], float); y = np.array(d['intensity'], float)\ndef lor(x,a,x0,g):\n    return a*g**2/((x-x0)**2+g**2)\ndef model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c):\n    return lor(x,a1,x1,g1)+lor(x,a2,x2,g2)+lor(x,a3,x3,g3)+c\ndef model3lin(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c,m):\n    return model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c)+m*(x-2000)\ndef model4(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,a4,x4,g4,c):\n    return model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,c)+lor(x,a4,x4,g4)\n\np0=[12100,1346,15, 8620,1585,14, 10760,2678,20, 1100]\npg,_=curve_fit(model3,x,y,p0=p0,maxfev=300000)\nprint('model3 params:', np.array2string(pg,precision=3), 'rms', (y-model3(x,*pg)).std())\nres = y-model3(x,*pg)\nfor lo in range(1100,3000,100):\n    m=(x>=lo)&(x<lo+100)\n    print(f'  bin {lo}-{lo+100}: resid mean={res[m].mean():8.1f} std={res[m].std():7.1f}')\n\ntry:\n    pl,_=curve_fit(model3lin,x,y,p0=list(pg)+[0.0],maxfev=300000)\n    print('model3+lin:', np.array2string(pl,precision=3),'rms',(y-model3lin(x,*pl)).std())\nexcept Exception as e: print('lin fail',e)\n\nfor x4 in [1620, 2450, 3100, 1200]:\n    try:\n        p4,_=curve_fit(model4,x,y,p0=list(pg[:9])+[200.0,x4,60.0,pg[9]],maxfev=300000)\n        print(f'model4 extra@{x4}: rms',(y-model4(x,*p4)).std(),'extra amp/g:',p4[9],p4[11])\n    except Exception as e: print('m4 fail',e)\n\n# noise estimate in flat region 1700-2400 with linear detrend\nm=(x>=1700)&(x<=2400)\nxx,yy=x[m],y[m]\nco=np.polyfit(xx,yy,1); r=yy-np.polyval(co,xx)\nprint('flat-region residual std (linear detrend):', r.std())\nEOF\npython3 /app/diag.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\n# noise estimate in flat regions\nfor lo,hi in ((1900,2300),(2300,2450),(2900,3000),(1100,1180)):\n    m=(x>=lo)&(x<=hi)\n    print('noise region %d-%d: std=%.1f mean=%.1f' % (lo,hi,y[m].std(),y[m].mean()))\n\ndef model3(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off):\n    return (a1*g1**2/((x-x1)**2+g1**2)+a2*g2**2/((x-x2)**2+g2**2)+a3*g3**2/((x-x3)**2+g3**2)+off)\n\np0 = [6000,19,1355, 7500,11,1583, 10000,28,2676, 900]\np,cov = curve_fit(model3,x,y,p0=p0,maxfev=500000)\nresid = y-model3(x,*p)\nprint('\\nglobal 3L+off params:', np.array2string(p,precision=4))\nprint('global rms %.2f' % np.sqrt(np.mean(resid**2)))\nprint('binned residuals (mean per 100 cm-1):')\nfor b in np.arange(1100,3000,100.0):\n    m=(x>=b)&(x<b+100)\n    print('  %6.0f  mean=%8.1f  rms=%7.1f  n=%d' % (b,resid[m].mean(),np.sqrt(np.mean(resid[m]**2)),m.sum()))\n\n# with broad background\ndef model4(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off,a4,g4,x4):\n    return model3(x,a1,g1,x1,a2,g2,x2,a3,g3,x3,off) + a4*g4**2/((x-x4)**2+g4**2)\np04 = list(p)+[5000,300,2000]\np4,_ = curve_fit(model4,x,y,p0=p04,maxfev=500000)\nr4 = y-model4(x,*p4)\nprint('\\nwith broad bg:', np.array2string(p4,precision=4))\nprint('rms %.2f' % np.sqrt(np.mean(r4**2)))\nEOF\npython3 /app/diag.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/fit_final.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1'], dtype=float)\ny = np.array(data['intensity'], dtype=float)\n\ndef lorentzian_plus_offset(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  ((1250.0, 1450.0), (4850.0, 1347.0, 15.0, 880.0)),\n    'G':  ((1470.0, 1700.0), (8860.0, 1579.6, 10.0, 900.0)),\n    '2D': ((2500.0, 2900.0), (18460.0, 2693.4, 29.0, 1000.0)),\n}\n\nresults = {}\nfor name, ((lo, hi), p0) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    popt, pcov = curve_fit(lorentzian_plus_offset, x[m], y[m], p0=p0, maxfev=200000)\n    perr = np.sqrt(np.diag(pcov))\n    resid = y[m] - lorentzian_plus_offset(x[m], *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    A, x0, g, off = popt\n    results[name] = {'x0': float(x0), 'gamma': float(g), 'amplitude': float(A), 'offset': float(off)}\n    print('%-3s window %.0f-%.0f  x0=%.4f+-%.4f  gamma=%.4f+-%.4f  A=%.3f+-%.3f  offset=%.3f+-%.3f  rms=%.2f'\n          % (name, lo, hi, x0, perr[1], g, perr[2], A, perr[0], off, perr[3], rms))\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\nprint('ID_IG = %.6f' % results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 /app/fit_final.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
