Sending keys: ["cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\npeaks = {\n    'D':  {'window': (1250.0, 1450.0), 'p0': [1348.0, 16.0, 8200.0, 1250.0]},\n    'G':  {'window': (1500.0, 1660.0), 'p0': [1580.0, 13.0, 7500.0, 1300.0]},\n    '2D': {'window': (2600.0, 2790.0), 'p0': [2692.0, 21.0, 10400.0, 1420.0]},\n}\n\nresults = {}\nfor name, cfg in peaks.items():\n    lo, hi = cfg['window']\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(lorentzian, xs, ys, p0=cfg['p0'], maxfev=200000)\n    x0, gamma, amplitude, offset = p\n    resid = ys - lorentzian(xs, *p)\n    print('%3s win=[%g,%g] x0=%.4f gamma=%.4f amplitude=%.3f offset=%.3f rms=%.2f' %\n          (name, lo, hi, x0, gamma, amplitude, offset, np.sqrt(np.mean(resid**2))))\n    results[name] = {'x0': float(x0), 'gamma': float(gamma),\n                      'amplitude': float(amplitude), 'offset': float(offset)}\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\nprint('ID_IG =', results['ID_IG'])\nEOF\npython3 /app/final_fit.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d[d.dtype.names[0]])\ny = np.array(d['intensity'])\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ncfg = {\n  'D':  dict(win=(1250.0, 1470.0), p0=(1350.0, 14.0, 1400.0, 950.0)),\n  'G':  dict(win=(1480.0, 1680.0), p0=(1581.0,  9.0, 6600.0, 950.0)),\n  '2D': dict(win=(2500.0, 2900.0), p0=(2685.0, 17.0, 13000.0, 900.0)),\n}\n\nres = {}\nfor name, c in cfg.items():\n    lo, hi = c['win']\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(lor, xs, ys, p0=c['p0'], maxfev=200000)\n    err = np.sqrt(np.diag(cov))\n    r = ys - lor(xs, *p)\n    print('%-3s win[%.0f,%.0f] n=%d  x0=%.4f+-%.4f  gamma=%.4f+-%.4f  amp=%.3f+-%.3f  off=%.3f+-%.3f  rms=%.3f'\n          % (name, lo, hi, xs.size, p[0], err[0], p[1], err[1], p[2], err[2], p[3], err[3], np.sqrt(np.mean(r**2))))\n    res[name] = {'x0': float(p[0]), 'gamma': float(p[1]), 'amplitude': float(p[2]), 'offset': float(p[3])}\n\nres['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\nprint('ID_IG = %.6f' % res['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\n    f.write('\\n')\nEOF\npython3 /app/final_fit.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
