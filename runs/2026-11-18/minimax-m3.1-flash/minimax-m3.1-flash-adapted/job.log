Sending keys: ['cat > /app/fit_diag.py << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', names=True)\nx = d[\'raman_shift_cm1\']; y = d[\'intensity\']\n\ndef lor(x, x0, g, a, off):\n    return a*g*g/((x-x0)**2+g*g)+off\n\ndef lorlin(x, x0, g, a, b, c):\n    return a*g*g/((x-x0)**2+g*g)+b*x+c\n\ncases = {\n \'D\': (1352.46, 19.0, 345, 1288, 1252, 1452),\n \'G\': (1581.08, 8.0, 6928, 1264, 1481, 1681),\n \'2D\':(2694.89, 27.0, 14100, 1186, 2595, 2795),\n}\nfor nm,(x0g,gg,ag,og,lo,hi) in cases.items():\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,cov = curve_fit(lor, xs, ys, p0=[x0g,gg,ag,og], maxfev=200000)\n    r = ys-lor(xs,*p)\n    chi2 = np.sum(r**2)/np.var(r)\n    print(f"{nm} const: x0={p[0]:.4f} g={p[1]:.4f} a={p[2]:.3f} off={p[3]:.3f} rms={np.sqrt(np.mean(r**2)):.2f}")\n    pl,_ = curve_fit(lorlin, xs, ys, p0=[x0g,gg,ag,0.0,og-og*1e-3], maxfev=200000)\n    rl = ys-lorlin(xs,*pl)\n    print(f"{nm} lin  : x0={pl[0]:.4f} g={pl[1]:.4f} a={pl[2]:.3f} slope={pl[3]:.5f} int={pl[4]:.3f} rms={np.sqrt(np.mean(rl**2)):.2f}")\n    # binned residuals (const fit), 10 bins\n    idx=np.array_split(np.arange(len(r)),10)\n    print(\'   resid bin means:\', \' \'.join(f"{r[i].mean():7.1f}" for i in idx))\nEOF\npython3 /app/fit_diag.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
