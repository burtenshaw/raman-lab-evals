Sending keys: ["cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lor(x, amp, x0, gamma, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef fitreg(c, hw):\n    m = (x > c-hw) & (x < c+hw)\n    xc, yc = x[m], y[m]\n    i = np.argmax(yc); base = np.median(yc)\n    p, _ = curve_fit(lor, xc, yc, p0=[yc[i]-base, xc[i], 20.0, base], maxfev=200000)\n    return xc, yc, lor(xc,*p), p\n\nfor name, c in [('D',1348),('G',1580),('2D',2690)]:\n    xc, yc, mdl, p = fitreg(c, 100)\n    res = yc - mdl\n    print('===', name, 'params', np.round(p,3))\n    # binned residual means\n    nb = 20\n    edges = np.linspace(xc[0], xc[-1], nb+1)\n    for j in range(nb):\n        sel = (xc>=edges[j]) & (xc<edges[j+1])\n        if sel.sum():\n            print('   x %8.2f-%8.2f  n=%4d  mean_res=%9.2f  rms=%8.2f' % (edges[j], edges[j+1], sel.sum(), res[sel].mean(), res[sel].std()))\n\n# global search for other peaks: rolling baseline via median filter\nfrom scipy.ndimage import median_filter, gaussian_filter1d\nbase = median_filter(y, size=101)\nresid = y - base\nsm = gaussian_filter1d(resid, 3)\nprint('=== global smoothed residual peaks (top 12)')\nidx = np.where((sm[1:-1]>sm[:-2]) & (sm[1:-1]>=sm[2:]))[0]+1\nfor i in idx[np.argsort(sm[idx])[::-1]][:12]:\n    print('   x=%.2f  resid_peak=%.1f' % (x[i], sm[i]))\nEOF\npython3 /app/diag.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
