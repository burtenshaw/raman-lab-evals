Sending keys: ['cat > /app/run_fit.py << \'EOF\'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt(\'/app/spectrum.csv\', delimiter=\',\', skiprows=1)\nx, y = data[:, 0], data[:, 1]\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xx, yy = x[m], y[m]\n    k = max(1, len(xx) // 10)\n    base = float(np.median(np.concatenate([yy[:k], yy[-k:]])))\n    i = int(np.argmax(yy))\n    amp0 = max(float(yy[i] - base), 1.0)\n    x00 = float(xx[i])\n    half = base + amp0 / 2.0\n    idx = np.where(yy >= half)[0]\n    gamma0 = max(float((xx[idx[-1]] - xx[idx[0]]) / 2.0), 5.0)\n    p0 = [amp0, gamma0, x00, base]\n    bounds = ([0.0, 0.5, lo - 50.0, -np.inf], [np.inf, 400.0, hi + 50.0, np.inf])\n    p, _ = curve_fit(lorentzian, xx, yy, p0=p0, bounds=bounds, maxfev=200000)\n    amp, gamma, x0, off = p\n    rms = float(np.sqrt(np.mean((yy - lorentzian(xx, *p))**2)))\n    print(f"window {lo}-{hi}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} offset={off:.3f} rms={rms:.2f}")\n    return {\'x0\': float(x0), \'gamma\': float(gamma), \'amplitude\': float(amp), \'offset\': float(off)}\n\nD = fit_peak(1250.0, 1450.0)\nG = fit_peak(1480.0, 1680.0)\nD2 = fit_peak(2590.0, 2790.0)\n\nresults = {\n    \'D\': D,\n    \'G\': G,\n    \'2D\': D2,\n    \'ID_IG\': D[\'amplitude\'] / G[\'amplitude\'],\n}\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/run_fit.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
