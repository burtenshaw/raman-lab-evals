Sending keys: ["cat > /app/global.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef make_model(nlor, deg):\n    def f(xx, *p):\n        out = np.zeros_like(xx, dtype=float)\n        for i in range(nlor):\n            x0,g,a = p[3*i:3*i+3]\n            out = out + a*g**2/((xx-x0)**2+g**2)\n        rest = p[3*nlor:]\n        for k,c in enumerate(rest):\n            out = out + c*(xx/1000.0)**k\n        return out\n    return f\n\ndef run(nlor, deg, p0):\n    f = make_model(nlor, deg)\n    p,cov = curve_fit(f, x, y, p0=p0, maxfev=500000)\n    r = y - f(x,*p)\n    print('nlor=%d deg=%d rms=%.2f' % (nlor, deg, np.sqrt(np.mean(r**2))))\n    for i in range(nlor):\n        print('   L%d: x0=%.3f gamma=%.3f amp=%.2f' % (i+1, p[3*i], p[3*i+1], p[3*i+2]))\n    print('   bg:', np.round(p[3*nlor:],4))\n    return p\n\nrun(3, 3, [1349,13.5,1313, 1581,8.5,6598, 2685,17,13067, 950,-150,0,0])\nrun(4, 3, [1349,13.5,1313, 1581,8.5,6598, 1620,15,300, 2685,17,13067, 950,-150,0,0])\nrun(5, 3, [1349,13.5,1313, 1581,8.5,6598, 1620,15,300, 2480,40,200, 2685,17,13067, 950,-150,0,0])\nrun(6, 3, [1349,13.5,1313, 1581,8.5,6598, 1620,15,300, 2480,40,200, 2200,60,-100, 2685,17,13067, 950,-150,0,0])\nEOF\npython3 /app/global.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
