Sending keys: ["cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lor(x, a, g, x0):\n    return a*g**2/((x-x0)**2+g**2)\n\ndef model3(x, a1,g1,x1, a2,g2,x2, a3,g3,x3, B):\n    return lor(x,a1,g1,x1)+lor(x,a2,g2,x2)+lor(x,a3,g3,x3)+B\n\np0=[345,19,1352, 6929,8,1581, 14099,27,2695, 1250]\np,cov = curve_fit(model3, x, y, p0=p0, maxfev=400000)\nprint('GLOBAL: D a=%.2f g=%.3f x0=%.3f | G a=%.2f g=%.3f x0=%.3f | 2D a=%.2f g=%.3f x0=%.3f | B=%.2f' % (p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9]))\nresid = y - model3(x,*p)\nprint('global rms', np.sqrt(np.mean(resid**2)))\nprint('perr', np.sqrt(np.diag(cov)))\n\n# local fits + binned residuals\ndef model(x, a, g, x0, off):\n    return a*g**2/((x-x0)**2+g**2)+off\n\nfor (lo,hi,name) in [(1200,1470,'D'),(1500,1680,'G'),(2450,2950,'2D')]:\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    base=np.percentile(ys,10); i=np.argmax(ys); amp0=ys[i]-base\n    idx=np.where(ys>=base+amp0/2)[0]\n    g0=max((xs[idx[-1]]-xs[idx[0]])/2,2.0)\n    pp,_=curve_fit(model, xs, ys, p0=[amp0,g0,xs[i],base], maxfev=200000)\n    r=ys-model(xs,*pp)\n    print(f'--- {name} local: a={pp[0]:.2f} g={pp[1]:.3f} x0={pp[2]:.3f} off={pp[3]:.2f} rms={np.sqrt(np.mean(r**2)):.2f}')\n    # binned residuals (20 cm-1 bins)\n    bins=np.arange(lo,hi+1,20)\n    for b0 in bins:\n        mm=(xs>=b0)&(xs<b0+20)\n        if mm.sum()>0:\n            print(f'   {b0:6.0f}-{b0+20:6.0f} n={mm.sum():4d} mean_resid={r[mm].mean():8.2f} std={r[mm].std():7.2f}')\nEOF\npython3 /app/diag.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
