Sending keys: ['cat > /app/write_results.py << \'EOF\'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', names=True)\nx = d[d.dtype.names[0]]\ny = d[\'intensity\']\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    p, cov = curve_fit(lorentzian, x[m], y[m], p0=p0, maxfev=200000)\n    res = lorentzian(x[m], *p) - y[m]\n    print(f\'fit window ({lo}, {hi}) n={m.sum()} rms={np.sqrt((res**2).mean()):.2f}\')\n    print(\'   x0=%.4f gamma=%.4f amplitude=%.3f offset=%.3f\' % tuple(p))\n    return p\n\npD = fit_peak(1200, 1500, [6000, 1355, 18.5, 900])\npG = fit_peak(1450, 1700, [7500, 1583, 11.0, 900])\np2D = fit_peak(2400, 2950, [9970, 2677, 28.5, 900])\n\nID_IG = pD[0] / pG[0]\n\nresults = {\n    "D":  {"x0": float(pD[1]),  "gamma": float(pD[2]),  "amplitude": float(pD[0]), "offset": float(pD[3])},\n    "G":  {"x0": float(pG[1]),  "gamma": float(pG[2]),  "amplitude": float(pG[0]), "offset": float(pG[3])},\n    "2D": {"x0": float(p2D[1]), "gamma": float(p2D[2]), "amplitude": float(p2D[0]), "offset": float(p2D[3])},\n    "ID_IG": float(ID_IG),\n}\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n    f.write(\'\\n\')\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/write_results.py\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
