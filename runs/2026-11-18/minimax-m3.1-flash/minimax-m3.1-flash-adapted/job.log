Sending keys: ["cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = data[:, 0]\ny = data[:, 1]\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  (1150.0, 1500.0, [6000.0, 19.0, 1355.0, 900.0]),\n    'G':  (1500.0, 1800.0, [7500.0, 11.0, 1583.0, 900.0]),\n    '2D': (2450.0, 2950.0, [10000.0, 28.0, 2676.0, 800.0]),\n}\n\nresults = {}\nfor name, (lo, hi, p0) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\n    perr = np.sqrt(np.diag(pcov))\n    resid = ys - lorentzian(xs, *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    amp, gam, x0, off = (float(v) for v in popt)\n    results[name] = {'x0': x0, 'gamma': gam, 'amplitude': amp, 'offset': off}\n    print('%-3s window=[%g,%g] n=%d  amp=%.4f+-%.4f  gamma=%.4f+-%.4f  x0=%.4f+-%.4f  offset=%.4f+-%.4f  rms=%.2f'\n          % (name, lo, hi, m.sum(), amp, perr[0], gam, perr[1], x0, perr[2], off, perr[3], rms))\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('\\nID_IG = %.6f' % results['ID_IG'])\nEOF\npython3 /app/fit.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
