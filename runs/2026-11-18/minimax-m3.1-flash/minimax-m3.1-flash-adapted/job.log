Sending keys: ["cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, x0, gamma, amp, offset):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + offset\n\ndef fit(lo, hi, p0):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    r = ys - lor(xs, *p)\n    rms = np.sqrt(np.mean(r**2))\n    return p, rms, len(xs)\n\nprint('D peak windows:')\nfor (lo,hi) in [(1250,1450),(1270,1440),(1280,1430),(1290,1420),(1260,1460),(1300,1400)]:\n    p,rms,n = fit(lo,hi,[1350,10,1300,1000])\n    print('  %d-%d n=%d x0=%.3f gamma=%.3f amp=%.1f off=%.1f rms=%.1f' % (lo,hi,n,p[0],p[1],p[2],p[3],rms))\n\nprint('G peak windows:')\nfor (lo,hi) in [(1500,1700),(1520,1680),(1530,1660),(1540,1640),(1550,1630),(1520,1700),(1500,1750)]:\n    p,rms,n = fit(lo,hi,[1581,12,6500,950])\n    print('  %d-%d n=%d x0=%.3f gamma=%.3f amp=%.1f off=%.1f rms=%.1f' % (lo,hi,n,p[0],p[1],p[2],p[3],rms))\n\nprint('2D peak windows:')\nfor (lo,hi) in [(2500,2900),(2550,2850),(2580,2820),(2600,2800),(2620,2780),(2500,2950),(2450,2950)]:\n    p,rms,n = fit(lo,hi,[2685,20,12500,850])\n    print('  %d-%d n=%d x0=%.3f gamma=%.3f amp=%.1f off=%.1f rms=%.1f' % (lo,hi,n,p[0],p[1],p[2],p[3],rms))\nEOF\npython3 /app/fit_test.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
