Sending keys: ['cat > /app/fit3.py << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt(\'/app/spectrum.csv\', delimiter=\',\', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, amp, gamma, x0, offset):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset\n\ndef lorbg(x, amp, gamma, x0, offset, slope):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset + slope*(x-1400)\n\ndef do_fit(lo, hi, model=lor, extra=()):\n    m = (x>=lo)&(x<=hi)\n    xx, yy = x[m], y[m]\n    k = max(1, len(xx)//10)\n    base = np.median(np.concatenate([yy[:k], yy[-k:]]))\n    i = np.argmax(yy)\n    amp0 = max(yy[i]-base, 1.0)\n    x00 = xx[i]\n    half = base + amp0/2\n    idx = np.where(yy >= half)[0]\n    gamma0 = max((xx[idx[-1]]-xx[idx[0]])/2.0, 5.0)\n    p0 = [amp0, gamma0, x00, base] + list(extra)\n    if model is lor:\n        bounds = ([0,0.5,lo-50,-np.inf],[np.inf,400,hi+50,np.inf])\n    else:\n        bounds = ([0,0.5,lo-50,-np.inf,-np.inf],[np.inf,400,hi+50,np.inf,np.inf])\n    p, cov = curve_fit(model, xx, yy, p0=p0, bounds=bounds, maxfev=200000)\n    rms = np.sqrt(np.mean((yy - model(xx,*p))**2))\n    return p, rms, np.sqrt(np.diag(cov))\n\nwins = {\'D\':(1250,1450), \'G\':(1480,1680), \'2D\':(2590,2790)}\nprint(\'--- constant offset model (final windows) ---\')\nout={}\nfor k,(lo,hi) in wins.items():\n    p,rms,perr = do_fit(lo,hi)\n    amp,gamma,x0,off = p\n    out[k]=(x0,gamma,amp,off)\n    print(f"{k}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} off={off:.3f} rms={rms:.3f} perr={np.round(perr,4)}")\nprint(\'ID_IG =\', out[\'D\'][2]/out[\'G\'][2])\n\nprint(\'--- with linear background (amplitude check) ---\')\nfor k,(lo,hi) in wins.items():\n    p,rms,perr = do_fit(lo,hi,lorbg,(0.0,))\n    amp,gamma,x0,off,slope = p\n    print(f"{k}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} off={off:.3f} slope={slope:.5f} rms={rms:.3f}")\n\n# noise estimate from flat region\nm = (x>1800)&(x<2400)\nprint(\'noise std (diff/1.414) flat region:\', np.std(np.diff(y[m]))/np.sqrt(2))\nEOF\npython3 /app/fit3.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
