Sending keys: ['cat > /app/fit_spectrum.py << \'EOF\'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt(\'/app/spectrum.csv\', delimiter=\',\', names=True)\nx = np.asarray(data[\'raman_shift_cm1\'], dtype=float)\ny = np.asarray(data[\'intensity\'], dtype=float)\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    xi, yi = x[m], y[m]\n    p, cov = curve_fit(lorentzian, xi, yi, p0=p0, maxfev=200000)\n    x0, gamma, amp, off = p\n    gamma = abs(gamma)\n    amp = abs(amp)\n    model = lorentzian(xi, x0, gamma, amp, off)\n    res = yi - model\n    rms = float(np.sqrt(np.mean(res**2)))\n    ss_res = float(np.sum(res**2)); ss_tot = float(np.sum((yi-np.mean(yi))**2))\n    r2 = 1.0 - ss_res/ss_tot\n    return {\'x0\': float(x0), \'gamma\': float(gamma), \'amplitude\': float(amp), \'offset\': float(off)}, rms, r2, int(m.sum())\n\nspecs = {\n    \'D\':  dict(win=(1250.0, 1450.0), p0=(1346.4, 17.0, 2350.0, 1020.0)),\n    \'G\':  dict(win=(1500.0, 1700.0), p0=(1582.2,  9.0, 7870.0, 1030.0)),\n    \'2D\': dict(win=(2550.0, 2850.0), p0=(2692.7, 24.0, 16035.0, 1070.0)),\n}\n\nresults = {}\nfor name, s in specs.items():\n    p, rms, r2, n = fit_peak(x, y, s[\'win\'][0], s[\'win\'][1], s[\'p0\'])\n    results[name] = p\n    print(f"{name:>2s} win={s[\'win\']} n={n}: x0={p[\'x0\']:.4f} gamma={p[\'gamma\']:.4f} "\n          f"amplitude={p[\'amplitude\']:.3f} offset={p[\'offset\']:.3f} rms={rms:.2f} R2={r2:.5f}")\n\nresults[\'ID_IG\'] = float(results[\'D\'][\'amplitude\'] / results[\'G\'][\'amplitude\'])\nprint(\'ID_IG =\', results[\'ID_IG\'])\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 /app/fit_spectrum.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1']); y = np.asarray(d['intensity'])\n\ndef lor(x, amp, gamma, x0, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef fit(lo, hi, label):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    i = np.argmax(ys)\n    x0g = xs[i]\n    off0 = np.median(np.concatenate([ys[:15], ys[-15:]]))\n    amp0 = ys[i]-off0\n    # half max width estimate\n    half = off0 + amp0/2\n    idx = np.where(ys>=half)[0]\n    gam0 = max((xs[idx[-1]]-xs[idx[0]])/2, 3.0)\n    p, cov = curve_fit(lor, xs, ys, p0=[amp0, gam0, x0g, off0], maxfev=200000)\n    resid = ys - lor(xs,*p)\n    print(f'{label:4s} win[{lo},{hi}] amp={p[0]:9.3f} gamma={p[1]:8.3f} x0={p[2]:9.3f} off={p[3]:9.3f} rms={np.sqrt(np.mean(resid**2)):8.2f} maxres={np.max(np.abs(resid)):8.2f}')\n    return p\n\nfor lo,hi in [(1250,1450),(1230,1470),(1200,1500),(1280,1430),(1250,1420)]:\n    fit(lo,hi,'D')\nprint()\nfor lo,hi in [(1500,1700),(1480,1720),(1520,1680),(1450,1750),(1500,1750)]:\n    fit(lo,hi,'G')\nprint()\nfor lo,hi in [(2550,2800),(2520,2830),(2580,2780),(2500,2900),(2600,2750)]:\n    fit(lo,hi,'2D')\nEOF\npython3 /app/fit_test.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/check.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d['intensity']\n\ndef lor(x,a,x0,g,o): return a*g*g/((x-x0)**2+g*g)+o\ndef lorlin(x,a,x0,g,b,c): return a*g*g/((x-x0)**2+g*g)+b+c*(x-1500)\n\nregions = {'D':(1150,1520,1355,18.5),'G':(1400,1780,1583,11.0),'2D':(2300,3000,2677,28.5)}\nfor name,(lo,hi,x0g,gg) in regions.items():\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,_=curve_fit(lor,xs,ys,p0=[6000,x0g,gg,900],maxfev=200000)\n    pl,_=curve_fit(lorlin,xs,ys,p0=[6000,x0g,gg,900,0.0],maxfev=200000)\n    r1=lor(xs,*p)-ys; r2=lorlin(xs,*pl)-ys\n    print(f'{name}: const-off  x0={p[1]:.3f} g={p[2]:.3f} A={p[0]:.2f} off={p[3]:.2f} rms={np.sqrt((r1**2).mean()):.1f}')\n    print(f'{name}: lin-off    x0={pl[1]:.3f} g={pl[2]:.3f} A={pl[0]:.2f} b={pl[3]:.2f} c={pl[4]:.5f} rms={np.sqrt((r2**2).mean()):.1f}')\n\n# global: 3 sharp Lorentzians + constant + broad Lorentzian background\ndef mdl(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,bg,xb,gb):\n    return (a1*g1*g1/((x-x1)**2+g1*g1)+a2*g2*g2/((x-x2)**2+g2*g2)+a3*g3*g3/((x-x3)**2+g3*g3)\n            + bg*gb*gb/((x-xb)**2+gb*gb))\np0=[6000,1355,18.5,7500,1583,11,9970,2677,28.5,300,1900,600]\ntry:\n    p,cov=curve_fit(mdl,x,y,p0=p0,maxfev=600000)\n    r=mdl(x,*p)-y\n    print('global 3L+const+broad rms',np.sqrt((r**2).mean()))\n    print('  D amp=%.2f x0=%.3f g=%.3f'%(p[0],p[1],p[2]))\n    print('  G amp=%.2f x0=%.3f g=%.3f'%(p[3],p[4],p[5]))\n    print('  2D amp=%.2f x0=%.3f g=%.3f'%(p[6],p[7],p[8]))\n    print('  bg=%.2f xb=%.1f gb=%.1f'%(p[9],p[10],p[11]))\nexcept Exception as e:\n    print('broad bg fit failed', e)\nEOF\npython3 /app/check.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
