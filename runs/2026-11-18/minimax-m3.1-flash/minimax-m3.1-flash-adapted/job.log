Sending keys: ["cat > /app/analyze.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, amplitude, x0, gamma, offset):\n    return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset\n\ndef fitwin(lo, hi, p0):\n    m = (x>=lo)&(x<=hi)\n    p,_ = curve_fit(lor, x[m], y[m], p0=p0, maxfev=40000)\n    return p, x[m], y[m]\n\ndef binned_res(p, xs, ys, nb=12):\n    res = ys - lor(xs,*p)\n    edges = np.linspace(xs.min(), xs.max(), nb+1)\n    print('   binned residuals:', ' '.join(f'{np.mean(res[(xs>=edges[i])&(xs<edges[i+1])]):+7.1f}' for i in range(nb)))\n\nprint('D window 1200-1500')\npD,xs,ys = fitwin(1200,1500,[600,1354,13,840]); print('  ', np.round(pD,3)); binned_res(pD,xs,ys)\nprint('G window 1480-1680')\npG,xs,ys = fitwin(1480,1680,[6550,1579,9,800]); print('  ', np.round(pG,3)); binned_res(pG,xs,ys)\nprint('G window 1500-1620 (no D-prime)')\npG2,xs,ys = fitwin(1500,1620,[6550,1579,9,800]); print('  ', np.round(pG2,3)); binned_res(pG2,xs,ys)\nprint('2D window 2550-2850')\np2,xs,ys = fitwin(2550,2850,[9800,2689,26,730]); print('  ', np.round(p2,3)); binned_res(p2,xs,ys)\n\n# global fit: 3 lorentzians + linear baseline\ndef model(xx, aD,xD,gD, aG,xG,gG, a2,x2,g2, c0, c1):\n    return (lor(xx,aD,xD,gD,0)+lor(xx,aG,xG,gG,0)+lor(xx,a2,x2,g2,0)+c0+c1*(xx-2000))\np0=[636,1354,12.8, 6548,1579.4,9.06, 9810,2688.7,25.6, 900, -0.05]\np,_=curve_fit(model,x,y,p0=p0,maxfev=100000)\nprint('global fit params:', np.round(p,4))\nres = y - model(x,*p)\nprint('global rms', np.sqrt(np.mean(res**2)))\nprint('global ID/IG =', p[0]/p[3])\nEOF\npython3 /app/analyze.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
