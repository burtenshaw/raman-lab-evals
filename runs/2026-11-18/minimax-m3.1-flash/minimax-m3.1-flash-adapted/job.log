Sending keys: ["cat > /app/resid.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, x0, gamma, amp, offset):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + offset\n\ndef lorlin(x, x0, gamma, amp, c0, c1):\n    return lor(x,x0,gamma,amp,0)+c0+c1*x\n\ndef resid_profile(lo,hi,p0,label):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,_=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)\n    r=ys-lor(xs,*p)\n    print('==',label,'const-offset fit params:',np.round(p,3))\n    # binned residual profile (10 cm-1 bins)\n    for lo2 in range(int(lo), int(hi), 10):\n        mm=(xs>=lo2)&(xs<lo2+10)\n        if mm.sum(): print('   %5d  mean resid %8.1f  (n=%d)' % (lo2, r[mm].mean(), mm.sum()))\n    # linear baseline variant\n    try:\n        p2,_=curve_fit(lorlin,xs,ys,p0=[p[0],p[1],p[2],p[3],0.0],maxfev=200000)\n        print('   linear-baseline variant:',np.round(p2,4))\n    except Exception as e:\n        print('   linear fit failed',e)\n\nresid_profile(1250,1450,[1350,10,1300,1000],'D 1250-1450')\nresid_profile(1500,1700,[1581,12,6500,950],'G 1500-1700')\nresid_profile(2500,2900,[2685,20,12500,850],'2D 2500-2900')\nEOF\npython3 /app/resid.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
