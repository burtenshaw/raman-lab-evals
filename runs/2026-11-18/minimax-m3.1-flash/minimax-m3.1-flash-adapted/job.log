Sending keys: ["cat > /app/fit_final.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\ncols = d.dtype.names\nx = np.array(d[cols[0]], dtype=float)\ny = np.array(d[cols[1]], dtype=float)\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# peak search ranges (nominal +-100 cm-1 around expected positions)\nsearch = {'D': (1250.0, 1450.0), 'G': (1500.0, 1700.0), '2D': (2580.0, 2800.0)}\nHW = 100.0   # half-width of fitting window (cm-1)\n\nresults = {}\nfor name, (lo, hi) in search.items():\n    sm = (x >= lo) & (x <= hi)\n    xs, ys = x[sm], y[sm]\n    i = int(np.argmax(ys))\n    xpk = xs[i]\n    ypk = ys[i]\n    base = float(np.median(np.r_[ys[:20], ys[-20:]]))\n    half = (ypk + base) / 2.0\n    j = i\n    while j > 0 and ys[j] > half:\n        j -= 1\n    k = i\n    while k < len(ys) - 1 and ys[k] > half:\n        k += 1\n    gamma0 = max((xs[k] - xs[j]) / 2.0, 5.0)\n\n    m = np.abs(x - xpk) <= HW\n    xf, yf = x[m], y[m]\n    p0 = [ypk - base, xpk, gamma0, base]\n    popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=200000)\n    perr = np.sqrt(np.diag(pcov))\n    resid = yf - lorentzian(xf, *popt)\n    results[name] = {\n        'x0': float(popt[1]),\n        'gamma': float(popt[2]),\n        'amplitude': float(popt[0]),\n        'offset': float(popt[3]),\n    }\n    print(f'{name}: window={xf.min():.1f}-{xf.max():.1f} n={xf.size}')\n    print(f'   amplitude={popt[0]:.3f} +/- {perr[0]:.3f}   x0={popt[1]:.4f} +/- {perr[1]:.4f}')\n    print(f'   gamma={popt[2]:.4f} +/- {perr[2]:.4f}   offset={popt[3]:.3f} +/- {perr[3]:.3f}   resid_rms={resid.std():.2f}')\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID_IG =', results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 /app/fit_final.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/verify.py << 'EOF'\nimport json, numpy as np\nd = json.load(open('/app/results.json'))\nassert set(d) == {'D','G','2D','ID_IG'}\nfor k in ['D','G','2D']:\n    assert set(d[k]) == {'x0','gamma','amplitude','offset'}\n    for kk,v in d[k].items(): assert isinstance(v,float) and np.isfinite(v)\nassert isinstance(d['ID_IG'], float)\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1']); y = np.array(data['intensity'])\nfor name,(lo,hi) in [('D',(1250,1450)),('G',(1470,1700)),('2D',(2500,2900))]:\n    p = d[name]; m = (x>=lo)&(x<=hi)\n    mod = p['amplitude']*p['gamma']**2/((x[m]-p['x0'])**2+p['gamma']**2)+p['offset']\n    r = y[m]-mod\n    print('%-3s rms=%7.3f  max|res|=%7.2f  n=%d' % (name, np.sqrt((r**2).mean()), np.abs(r).max(), m.sum()))\nprint('ID_IG check:', d['D']['amplitude']/d['G']['amplitude'], '==', d['ID_IG'])\nprint('ALL CHECKS PASSED')\nEOF\npython3 /app/verify.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
