Sending keys: ["cat > /app/fit_final.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'], dtype=float)\ny = np.asarray(d['intensity'], dtype=float)\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude*gamma**2/((x-x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, lo, hi, center):\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    off0 = float(np.percentile(yw, 10))\n    i = int(np.argmin(np.abs(xw - center)))\n    amp0 = float(yw[i] - off0)\n    half = off0 + amp0/2.0\n    above = xw[yw >= half]\n    g0 = float(max((above.max()-above.min())/2.0, 3.0)) if above.size > 1 else 15.0\n    p0 = [amp0, g0, float(xw[i]), off0]\n    p, cov = curve_fit(lorentzian, xw, yw, p0=p0, maxfev=200000)\n    resid = yw - lorentzian(xw, *p)\n    err = np.sqrt(np.diag(cov))\n    print(f'window {lo}-{hi} n={m.sum()}  amplitude={p[0]:.3f}+-{err[0]:.3f}  gamma={p[1]:.4f}+-{err[1]:.4f}  x0={p[2]:.4f}+-{err[2]:.4f}  offset={p[3]:.3f}+-{err[3]:.3f}  rmse={np.sqrt(np.mean(resid**2)):.2f}')\n    return p\n\npeaks = {\n    'D':  ((1230.0, 1470.0), 1355.0),\n    'G':  ((1470.0, 1700.0), 1583.0),\n    '2D': ((2480.0, 2880.0), 2677.0),\n}\n\nresults = {}\nparams = {}\nfor name, ((lo, hi), c) in peaks.items():\n    p = fit_peak(x, y, lo, hi, c)\n    params[name] = p\n    results[name] = {\n        'x0': float(p[2]),\n        'gamma': float(p[1]),\n        'amplitude': float(p[0]),\n        'offset': float(p[3]),\n    }\n\nresults['ID_IG'] = float(params['D'][0] / params['G'][0])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit_final.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
