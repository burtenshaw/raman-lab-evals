Sending keys: ["cat > /app/fit_spectrum.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# ---- load data ----\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\ncols = list(d.dtype.names)\nx = d[cols[0]].astype(float)\ny = d[cols[1]].astype(float)\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, lo, hi, guess):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    p0 = [guess[0], guess[1], guess[2], guess[3]]\n    lb = [0.0, guess[1] - 60.0, 0.5, -np.inf]\n    ub = [np.inf, guess[1] + 60.0, 200.0, np.inf]\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=(lb, ub), maxfev=200000)\n    resid = ys - lorentzian(xs, *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    err = np.sqrt(np.diag(pcov))\n    return dict(zip(['amplitude', 'x0', 'gamma', 'offset'], [float(v) for v in popt])), rms, err, len(xs)\n\n# windows chosen to isolate each peak (neighbour tails are negligible there)\nwindows = {\n    'D':  (1250.0, 1450.0, [350.0, 1352.0, 20.0, 1280.0]),\n    'G':  (1450.0, 1750.0, [6930.0, 1581.0, 8.0, 1265.0]),\n    '2D': (2450.0, 2950.0, [14100.0, 2695.0, 27.0, 1190.0]),\n}\n\nresults = {}\nfor name, (lo, hi, g) in windows.items():\n    params, rms, err, n = fit_peak(x, y, lo, hi, g)\n    results[name] = params\n    print('%s: window %.0f-%.0f (n=%d) rms=%.2f' % (name, lo, hi, n, rms))\n    print('   amplitude=%.3f (+-%.3f)  x0=%.3f (+-%.3f)  gamma=%.3f (+-%.3f)  offset=%.3f (+-%.3f)'\n          % (params['amplitude'], err[0], params['x0'], err[1], params['gamma'], err[2], params['offset'], err[3]))\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\nprint('ID/IG = %.6f' % results['ID_IG'])\n\nout = {\n    'D':  {k: results['D'][k]  for k in ['x0', 'gamma', 'amplitude', 'offset']},\n    'G':  {k: results['G'][k]  for k in ['x0', 'gamma', 'amplitude', 'offset']},\n    '2D': {k: results['2D'][k] for k in ['x0', 'gamma', 'amplitude', 'offset']},\n    'ID_IG': results['ID_IG'],\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint(json.dumps(out, indent=2))\nEOF\npython3 /app/fit_spectrum.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
