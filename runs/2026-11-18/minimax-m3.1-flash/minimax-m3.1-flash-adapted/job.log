Sending keys: ["cd /app && cat > explore.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]\ny = d[d.dtype.names[1]]\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef fit(lo, hi, guess):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p0 = [guess, 20.0, ys.max()-np.median(ys), np.median(ys)]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    res = ys - lor(xs, *p)\n    rms = np.sqrt(np.mean(res**2))\n    ss = np.sum((ys-np.mean(ys))**2)\n    r2 = 1-np.sum(res**2)/ss\n    return p, rms, r2, m.sum()\n\nprint('=== D ===')\nfor lo,hi in [(1200,1500),(1250,1450),(1230,1480),(1280,1420),(1200,1520),(1150,1550)]:\n    p,rms,r2,n = fit(lo,hi,1350)\n    print(f'win {lo}-{hi} n={n} x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={rms:.2f} r2={r2:.5f}')\n\nprint('=== G ===')\nfor lo,hi in [(1450,1700),(1480,1680),(1500,1660),(1460,1720),(1400,1750),(1520,1640)]:\n    p,rms,r2,n = fit(lo,hi,1580)\n    print(f'win {lo}-{hi} n={n} x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={rms:.2f} r2={r2:.5f}')\n\nprint('=== 2D ===')\nfor lo,hi in [(2400,3000),(2450,2950),(2500,2900),(2350,3000),(2550,2850),(2450,2900)]:\n    p,rms,r2,n = fit(lo,hi,2690)\n    print(f'win {lo}-{hi} n={n} x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={rms:.2f} r2={r2:.5f}')\nEOF\npython3 explore.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/fit_explore.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1']); y = np.asarray(d['intensity'])\n\ndef lor(x, amp, gamma, x0, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ndef guess(xw, yw):\n    off = np.percentile(yw, 10)\n    i = np.argmax(yw)\n    amp = yw[i]-off\n    half = off + amp/2\n    above = xw[yw>=half]\n    gamma = max((above.max()-above.min())/2, 5.0) if above.size>1 else 20.0\n    return amp, gamma, xw[i], off\n\ndef fit(xw, yw):\n    p0 = guess(xw, yw)\n    p, cov = curve_fit(lor, xw, yw, p0=p0, maxfev=100000)\n    r = yw - lor(xw, *p)\n    rmse = np.sqrt(np.mean(r**2))\n    perr = np.sqrt(np.diag(cov))\n    return p, perr, rmse\n\nwindows = {\n 'D':  [(1230,1470),(1250,1450),(1270,1440),(1200,1500),(1280,1420)],\n 'G':  [(1470,1700),(1500,1660),(1510,1650),(1450,1720),(1530,1640)],\n '2D': [(2530,2850),(2570,2810),(2580,2800),(2500,2900),(2600,2780)],\n}\ncenters = {'D':1350,'G':1580,'2D':2690}\nfor name, wins in windows.items():\n    print('===', name)\n    for (lo,hi) in wins:\n        m = (x>=lo)&(x<=hi)\n        p, perr, rmse = fit(x[m], y[m])\n        print(f'win {lo}-{hi} n={m.sum():4d}  amp={p[0]:9.2f}+-{perr[0]:5.2f} gamma={p[1]:7.3f}+-{perr[1]:5.3f} x0={p[2]:8.3f}+-{perr[2]:5.3f} off={p[3]:8.2f}+-{perr[3]:5.2f} rmse={rmse:7.2f}')\nEOF\npython3 /app/fit_explore.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
