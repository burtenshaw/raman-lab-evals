Sending keys: ["cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset\n\ndef fit_peak(center, hw=80.0):\n    m = (x >= center-hw) & (x <= center+hw)\n    xc, yc = x[m], y[m]\n    i = int(np.argmax(yc))\n    base = float(np.median(yc))\n    p0 = [yc[i]-base, xc[i], 20.0, base]\n    bounds = ([0.0, center-60.0, 1.0, -1e6], [1e7, center+60.0, 200.0, 1e6])\n    p, cov = curve_fit(lorentzian, xc, yc, p0=p0, bounds=bounds, maxfev=200000)\n    err = np.sqrt(np.diag(cov))\n    res = yc - lorentzian(xc, *p)\n    rms = float(np.sqrt(np.mean(res**2)))\n    r2 = 1.0 - np.sum(res**2)/np.sum((yc-np.mean(yc))**2)\n    print('  window [%.1f, %.1f]  n=%d  rms=%.2f  R2=%.5f' % (xc[0], xc[-1], len(xc), rms, r2))\n    print('  amplitude=%.2f +- %.2f   x0=%.3f +- %.3f   gamma=%.3f +- %.3f   offset=%.2f +- %.2f'\n          % (p[0],err[0],p[1],err[1],p[2],err[2],p[3],err[3]))\n    return p\n\npeaks = {}\nfor name, center in [('D',1348.0), ('G',1580.0), ('2D',2692.0)]:\n    print('===', name)\n    peaks[name] = fit_peak(center)\n\nID_IG = float(peaks['D'][0]/peaks['G'][0])\nprint('ID_IG =', ID_IG)\n\nresults = {}\nfor name in ['D','G','2D']:\n    a,x0,g,o = [float(v) for v in peaks[name]]\n    results[name] = {'x0': x0, 'gamma': g, 'amplitude': a, 'offset': o}\nresults['ID_IG'] = ID_IG\n\nwith open('/app/results.json','w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/final_fit.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(xx, x0, g, a, c):\n    return a*g*g/((xx-x0)**2 + g*g) + c\n\ndef lor_lin(xx, x0, g, a, c, s):\n    return a*g*g/((xx-x0)**2 + g*g) + c + s*(xx-x0)\n\npeaks = {'D':(1350,13.5,1314,970), 'G':(1580,8.4,6600,940), '2D':(2685,17,13060,807)}\nfor name,(xg,gg,ag,cg) in peaks.items():\n    for half in [50, 80, 100]:\n        m = np.abs(x-xg) <= half\n        pc,_ = curve_fit(lor, x[m], y[m], p0=[xg,gg,ag,cg], maxfev=100000)\n        pl,_ = curve_fit(lor_lin, x[m], y[m], p0=[xg,gg,ag,cg,0.0], maxfev=100000)\n        rc = y[m]-lor(x[m],*pc)\n        rl = y[m]-lor_lin(x[m],*pl)\n        print(f'{name} +-{half}: const x0={pc[0]:.3f} g={pc[1]:.3f} a={pc[2]:.2f} c={pc[3]:.2f} std={rc.std():.2f} | linear x0={pl[0]:.3f} g={pl[1]:.3f} a={pl[2]:.2f} c={pl[3]:.2f} slope={pl[4]:.4f} std={rl.std():.2f}')\n    # binned residuals of constant model, +-100\n    m = np.abs(x-xg) <= 100\n    pc,_ = curve_fit(lor, x[m], y[m], p0=[xg,gg,ag,cg], maxfev=100000)\n    rc = y[m]-lor(x[m],*pc)\n    xm = x[m]\n    print(f'  {name} binned resid means (10cm bins):')\n    for lo in range(1100,3000,20):\n        mm=(xm>=lo)&(xm<lo+20)\n        if mm.any() and abs(xg-lo)<=140:\n            print(f'    {lo}: {rc[mm].mean():8.2f} (n={mm.sum()})')\nEOF\npython3 /app/diag.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
