Sending keys: ["cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef model(xv, amp, gamma, x0, off):\n    return amp*gamma**2/((xv-x0)**2 + gamma**2) + off\n\ndef fit(lo, hi, p0):\n    m = (x>=lo)&(x<=hi)\n    xv, yv = x[m], y[m]\n    p, cov = curve_fit(model, xv, yv, p0=p0, maxfev=200000)\n    resid = yv - model(xv, *p)\n    return p, np.sqrt(np.mean(resid**2)), m.sum()\n\npeaks = {'D': (1350, [1250,1275,1300,1320]), 'G': (1580, [1460,1490,1520,1550]), '2D': (2690, [2400,2450,2500,2550])}\nfor name,(ctr,wins) in peaks.items():\n    print('===',name)\n    for w in wins:\n        lo, hi = ctr-w, ctr+w\n        m = (x>=lo)&(x<=hi)\n        yv = y[m]; xv = x[m]\n        off0 = np.percentile(yv, 10)\n        amp0 = yv.max()-off0\n        i = np.argmax(yv)\n        x00 = xv[i]\n        # half width estimate at half max\n        above = xv[yv >= off0+amp0/2]\n        g0 = max((above.max()-above.min())/2, 3.0) if above.size>1 else 20.0\n        try:\n            p, rms, n = fit(lo, hi, [amp0, g0, x00, off0])\n            print(f'  window {lo:.0f}-{hi:.0f} n={n:4d} amp={p[0]:9.2f} gamma={p[1]:7.3f} x0={p[2]:9.3f} off={p[3]:8.2f} rms={rms:7.2f}')\n        except Exception as e:\n            print('  window', lo, hi, 'FAIL', e)\nEOF\npython3 /app/fit_test.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
