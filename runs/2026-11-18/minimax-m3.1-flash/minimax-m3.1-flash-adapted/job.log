Sending keys: ["cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lor(x, amp, gam, x0, off):\n    return amp*gam**2/((x-x0)**2+gam**2) + off\n\ndef fit_window(lo, hi, guess):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p0 = [guess[0], guess[1], guess[2], guess[3]]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    resid = ys - lor(xs, *p)\n    rms = np.sqrt(np.mean(resid**2))\n    return p, rms, len(xs)\n\nprint('--- per-peak window fits ---')\nsets = {\n 'D_narrow': (1180, 1500, (6000, 20, 1352, 1000)),\n 'D_wide':   (1120, 1520, (6000, 20, 1352, 1000)),\n 'G_narrow': (1500, 1800, (7500, 22, 1582, 1000)),\n 'G_wide':   (1470, 1900, (7500, 22, 1582, 1000)),\n '2D_narrow':(2450, 2950, (9800, 30, 2676, 1000)),\n '2D_wide':  (2350, 3000, (9800, 30, 2676, 1000)),\n}\nfor k,(lo,hi,g) in sets.items():\n    p, rms, n = fit_window(lo,hi,g)\n    print('%-10s win=[%d,%d] n=%d  amp=%10.2f gam=%8.3f x0=%9.3f off=%9.2f rms=%8.2f' % (k,lo,hi,n,p[0],p[1],p[2],p[3],rms))\n\nprint()\nprint('--- global simultaneous fit (3 Lorentzians + 1 offset) ---')\ndef model(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off):\n    return (a1*g1**2/((x-x1)**2+g1**2)+a2*g2**2/((x-x2)**2+g2**2)+a3*g3**2/((x-x3)**2+g3**2)+off)\np0 = [6000,20,1352, 7500,22,1582, 9800,30,2676, 1000]\np, cov = curve_fit(model, x, y, p0=p0, maxfev=500000)\nresid = y - model(x,*p)\nprint('params:', np.array2string(p, precision=4))\nprint('rms full = %.2f' % np.sqrt(np.mean(resid**2)))\nfor name,lo,hi in (('D',1150,1500),('G',1500,1800),('2D',2450,2950)):\n    m=(x>=lo)&(x<=hi)\n    print('  %s window rms = %.2f  bias(mean resid)= %.2f' % (name, np.sqrt(np.mean(resid[m]**2)), resid[m].mean()))\nEOF\npython3 /app/fit_test.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
