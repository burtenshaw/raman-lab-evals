Sending keys: ["cat > /app/fit_explore2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, amp, x0, gamma, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\n# global 3 lorentzians + constant\ndef l3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,off):\n    return lor(x,a1,x1,g1,0)+lor(x,a2,x2,g2,0)+lor(x,a3,x3,g3,0)+off\np0=[400,1350,15,6900,1580,20,14000,2694,30,1300]\npopt,_=curve_fit(l3,x,y,p0=p0,maxfev=400000)\nres=y-l3(x,*popt)\nprint('block mean residuals (global const-offset fit):')\nfor lo in range(1100,3000,100):\n    m=(x>=lo)&(x<lo+100)\n    print(lo, 'mean=%.1f'%res[m].mean(), 'std=%.1f'%res[m].std())\n\n# global with linear baseline\ndef l3lin(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,b,m):\n    return l3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,0)+b+m*(x-2000)\npopt2,_=curve_fit(l3lin,x,y,p0=list(popt)+[0.0],maxfev=400000)\nprint('linear baseline fit:', np.round(popt2,3))\nres2=y-l3lin(x,*popt2)\nprint('rms resid lin', np.sqrt(np.mean(res2**2)))\n\ndef fitone(lo,hi):\n    m=(x>=lo)&(x<=hi)\n    xs,ys=x[m],y[m]\n    i=np.argmax(ys)\n    amp0=max(ys.max()-np.median(ys),1.0)\n    p=[amp0,xs[i],20.0,np.median(ys)]\n    try:\n        po,_=curve_fit(lor,xs,ys,p0=p,maxfev=200000)\n        r=ys-lor(xs,*po)\n        return po,np.sqrt(np.mean(r**2)),len(xs)\n    except Exception as e:\n        return None,e,0\n\nprint('\\nIndividual window fits:')\nfor name,cands in [('D',[(1200,1500),(1250,1450),(1280,1420),(1300,1400),(1200,1450),(1220,1480)]),\n                   ('G',[(1450,1750),(1500,1700),(1450,1650),(1500,1750),(1420,1780)]),\n                   ('2D',[(2400,3000),(2500,2900),(2450,2950),(2550,2850)])]:\n    for lo,hi in cands:\n        po,rms,n=fitone(lo,hi)\n        print(name,(lo,hi),'n=%d'%n, np.round(po,3) if po is not None else po, 'rms=%.2f'%rms)\nEOF\npython3 /app/fit_explore2.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
