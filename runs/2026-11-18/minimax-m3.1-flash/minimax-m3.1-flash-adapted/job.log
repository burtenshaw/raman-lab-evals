Sending keys: ["cat > /app/scan.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)\nx=d[:,0]; y=d[:,1]\ndef model(x,a,g,x0,off):\n    return a*g**2/((x-x0)**2+g**2)+off\ndef fit(lo,hi):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    base=np.percentile(ys,10); i=np.argmax(ys); amp0=ys[i]-base\n    idx=np.where(ys>=base+amp0/2)[0]\n    g0=max((xs[idx[-1]]-xs[idx[0]])/2,2.0)\n    p,_=curve_fit(model,xs,ys,p0=[amp0,g0,xs[i],base],maxfev=200000)\n    r=ys-model(xs,*p)\n    return p, np.sqrt(np.mean(r**2))\nfor lo in (1150,1180,1200,1220,1240):\n    for hi in (1440,1460,1470,1480,1500):\n        p,rms=fit(lo,hi)\n        print(f'D {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\nprint()\nfor lo in (1490,1510,1520,1540):\n    for hi in (1650,1670,1690,1720):\n        p,rms=fit(lo,hi)\n        print(f'G {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\nprint()\nfor lo in (2350,2400,2450,2500,2550):\n    for hi in (2850,2900,2950,3000):\n        p,rms=fit(lo,hi)\n        print(f'2D {lo}-{hi}: a={p[0]:9.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\nEOF\npython3 /app/scan.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/diag2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, a, x0, g):\n    return a*g*g/((x-x0)**2+g*g)\n\n# 1) smoothed D profile (moving average window 11 points ~ 5.5 cm-1)\nprint('--- smoothed profile around D (baseline ~845) ---')\nfor lo in range(1320,1396,5):\n    m=(x>=lo)&(x<lo+5)\n    print(f'{lo+2.5:7.1f} mean={y[m].mean():8.1f} n={m.sum()}')\n\n# 2) chi2 profile over gamma for D region, x0/amp/offset optimized (linear)\ndef chi2_profile(lo,hi,gammas,linear_baseline=False):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    out=[]\n    for g in gammas:\n        # grid over x0\n        best=None\n        for x0 in np.arange(1340,1368,0.5):\n            L=lor(xs,1,x0,g)\n            if linear_baseline:\n                A=np.vstack([L,np.ones_like(xs),xs-xs.mean()]).T\n            else:\n                A=np.vstack([L,np.ones_like(xs)]).T\n            c,res,rk,sv=np.linalg.lstsq(A,ys,rcond=None)\n            r=ys-A@c\n            s=float(np.sum(r*r))\n            if best is None or s<best[0]:\n                best=(s,x0,c)\n        out.append((g,best))\n    return out\n\nfor lb in (False,True):\n    print(f'--- D chi2 profile (linear_baseline={lb}) region 1150-1500 ---')\n    for g,b in chi2_profile(1150,1500,[6,8,10,12,13,14,16,18,20,25,30],lb):\n        print(f'  gamma={g:5.1f} chi2={b[0]:12.1f} x0={b[1]:7.2f} amp={b[2][0]:8.1f} off={b[2][1]:8.1f}')\n\n# 3) global fits with linear / quadratic background\ndef run_global(bg):\n    def model(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,*bgp):\n        m=(lor(x,a1,x1,g1)+lor(x,a2,x2,g2)+lor(x,a3,x3,g3))\n        if bg=='const': m=m+bgp[0]\n        elif bg=='lin': m=m+bgp[0]+bgp[1]*(x-2000)\n        else: m=m+bgp[0]+bgp[1]*(x-2000)+bgp[2]*(x-2000)**2/1e4\n        return m\n    if bg=='const': p0=[800,1354,13,6500,1579,9,9800,2689,26,800]\n    elif bg=='lin': p0=[800,1354,13,6500,1579,9,9800,2689,26,800,0.0]\n    else: p0=[800,1354,13,6500,1579,9,9800,2689,26,800,0.0,0.0]\n    p,_=curve_fit(model,x,y,p0=p0,maxfev=500000)\n    r=y-model(x,*p)\n    print(bg,'rms=%.2f'%float(np.sqrt(np.mean(r**2))),np.round(p,3))\nfor bg in ('const','lin','quad'):\n    run_global(bg)\nEOF\npython3 /app/diag2.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
