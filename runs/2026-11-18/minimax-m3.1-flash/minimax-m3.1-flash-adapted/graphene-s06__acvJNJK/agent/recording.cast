[66.501614, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np, csv\nfrom scipy.optimize import curve_fit\n\nd=np.genfromtxt('/app/spectrum.csv',delimiter=',',names=True)\nx=np.asarray(d['raman_shift_cm1'] if 'raman_shift_cm1' in d.dtype.names else d[d.dtype.names[0]],float)\ny=np.asarray(d['intensity'],float)\n\ndef lor(x,a,g,x0,c):\n    return a*g*g/((x-x0)**2+g*g)+c\n\ndef fit(lo,hi,label):\n    m=(x>=lo)&(x<=hi)\n    xs,ys=x[m],y[m]\n    # initial guesses\n    off=np.percentile(ys,10)\n    i=np.argmax(ys); a0=ys[i]-off; x00=xs[i]\n    half=off+a0/2\n    idx=np.where(ys>=half)[0]\n    g0=max((xs[idx[-1]]-xs[idx[0]])/2,1.0) if len(idx)>1 else 10.0\n    p0=[a0,g0,x00,off]\n    p,cov=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)\n    res=ys-lor(xs,*p)\n    rmse=np.sqrt(np.mean(res**2))\n    print(f'{label} win[{lo},{hi}] amp={p[0]:.3f} gam={abs(p[1]):.4f} x0={p[2]:.4f} off={p[3]:.3f} rmse={rmse:.2f} n={m.sum()}')\n    return p\n\nfor lo,hi in [(1200,1500),(1150,1500),(1250,1500),(1180,1470),(1200,1450)]:\n    fit(lo,hi,'D')\nprint()\nfor lo,hi in [(1450,"]
[66.501752, "i", "1750),(1450,1700),(1480,1720),(1500,1750),(1430,1730),(1450,1780)]:\n    fit(lo,hi,'G')\nprint()\nfor lo,hi in [(2400,2950),(2450,2900),(2500,2900),(2350,2950),(2500,2950),(2450,2950),(2500,2850)]:\n    fit(lo,hi,'2D')\nEOF\npython3 /app/fit_test.py\n"]
