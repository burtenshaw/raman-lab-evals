[112.841484, "i", "cat > /app/global_fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd=np.genfromtxt('/app/spectrum.csv',delimiter=',',names=True)\nx=np.asarray(d[d.dtype.names[0]],float); y=np.asarray(d['intensity'],float)\ndef L(x,a,g,x0): return a*g*g/((x-x0)**2+g*g)\ndef model(x,aD,gD,xD,aG,gG,xG,a2,g2,x2,c):\n    return L(x,aD,gD,xD)+L(x,aG,gG,xG)+L(x,a2,g2,x2)+c\np0=[4850,15,1347,8860,10,1580,18460,29,2693,900]\np,cov=curve_fit(model,x,y,p0=p0,maxfev=400000)\nres=y-model(x,*p)\nprint('global params:',np.round(p,4))\nprint('rmse',np.sqrt(np.mean(res**2)))\nprint('ID/IG =',p[0]/p[3])\nprint('param errors',np.round(np.sqrt(np.diag(cov)),4))\nEOF\npython3 /app/global_fit.py\n"]
