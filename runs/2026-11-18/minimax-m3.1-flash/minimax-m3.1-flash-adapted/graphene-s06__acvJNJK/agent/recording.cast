[153.781866, "i", "cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d[d.dtype.names[0]], float)\ny = np.asarray(d['intensity'], float)\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, lo, hi, name):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    # initial guesses from the data\n    off0 = float(np.percentile(ys, 10))\n    i = int(np.argmax(ys))\n    amp0 = float(ys[i] - off0)\n    x00 = float(xs[i])\n    # half-maximum width estimate\n    half = off0 + amp0 / 2.0\n    idx = np.where(ys >= half)[0]\n    gam0 = max(float(xs[idx[-1]] - xs[idx[0]]) / 2.0, 1.0) if len(idx) > 1 else 10.0\n    p0 = [amp0, gam0, x00, off0]\n    p, cov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\n    amplitude, gamma, x0, offset = p\n    gamma = abs(gamma)\n    resid = ys - lorentzian(xs, amplitude, gamma, x0, offset)\n    rmse "]
[153.781992, "i", "= float(np.sqrt(np.mean(resid**2)))\n    print(f'{name:2s} window=[{lo:.1f},{hi:.1f}] n={m.sum():4d}  amp={amplitude:10.3f}  gamma={gamma:8.4f}  '\n          f'x0={x0:10.4f}  offset={offset:9.3f}  rmse={rmse:6.2f}')\n    return dict(x0=float(x0), gamma=float(gamma), amplitude=float(amplitude), offset=float(offset))\n\n# symmetric windows (+/-100 cm-1) around each peak centre\nD  = fit_peak(x, y, 1246.7, 1446.7, 'D')\nG  = fit_peak(x, y, 1479.6, 1679.6, 'G')\nDD = fit_peak(x, y, 2593.4, 2793.4, '2D')\n\nID_IG = D['amplitude'] / G['amplitude']\nresults = {'D': D, 'G': G, '2D': DD, 'ID_IG': float(ID_IG)}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('\\nID_IG =', ID_IG)\nprint('wrote /app/results.json')\nEOF\npython3 /app/final_fit.py\n"]
[153.782032, "o", "cat > /app/final_fit.py << 'EOF'\r\n\u001b[?2004l\r= float(np.sqrt(np.mean(resid**2)))\r\n    print(f'{name:2s} window=[{lo:.1f},{hi:.1f}] n={m.sum():4d}  amp={amplitude:10.3f}  gamma={gamma:8.4f}  '\r\n          f'x0={x0:10.4f}  offset={offset:9."]
[153.782075, "o", "3f}  rmse={rmse:6.2f}')\r\n    return dict(x0=float(x0), gamma=float(gamma), amplitude=float(amplitude), offset=float(offset))\r\n\r\n# symmetric windows (+/-100 cm-1) around each peak centre\r\nD  = fit_peak(x, y, 1246.7, 1446.7, 'D')\r\nG  = fit_peak(x, y, 1479"]
[153.782115, "o", ".6, 1679.6, 'G')\r\nDD = fit_peak(x, y, 2593.4, 2793.4, '2D')\r\n\r\nID_IG = D['amplitude'] / G['amplitude']\r\nresults = {'D': D, 'G': G, '2D': DD, 'ID_IG': float(ID_IG)}\r\nwith open('/app/results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\nprint('\\nID_IG =', ID_IG)\r\nprint('wrote /app/results.json')\r\nEOF"]
