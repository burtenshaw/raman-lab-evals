[171.09837, "i", "python3 - << 'EOF'\nimport json, math\nr = json.load(open('/app/results.json'))\nassert set(r) == {'D','G','2D','ID_IG'}, r.keys()\nfor k in ['D','G','2D']:\n    assert set(r[k]) == {'x0','gamma','amplitude','offset'}, r[k]\n    for kk, vv in r[k].items():\n        assert isinstance(vv, float) and math.isfinite(vv), (k, kk, vv)\nassert isinstance(r['ID_IG'], float) and math.isfinite(r['ID_IG'])\nassert abs(r['ID_IG'] - r['D']['amplitude']/r['G']['amplitude']) < 1e-12\nprint('VALID results.json')\nfor k in ['D','G','2D']:\n    print(k, {kk: round(vv,4) for kk,vv in r[k].items()})\nprint('ID_IG =', round(r['ID_IG'],6))\nEOF\n"]
