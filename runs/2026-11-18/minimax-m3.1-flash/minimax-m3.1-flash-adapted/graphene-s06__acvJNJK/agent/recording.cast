[107.835155, "i", "cat > /app/baseline.py << 'EOF'\nimport numpy as np\nd=np.genfromtxt('/app/spectrum.csv',delimiter=',',names=True)\nx=np.asarray(d[d.dtype.names[0]],float); y=np.asarray(d['intensity'],float)\nprint('median per 50 cm-1 bin (baseline regions):')\nfor lo in range(1100,3000,50):\n    m=(x>=lo)&(x<lo+50)\n    print(lo, round(float(np.median(y[m])),1), round(float(np.mean(y[m])),1), round(float(np.std(y[m])),1))\nEOF\npython3 /app/baseline.py\n"]
