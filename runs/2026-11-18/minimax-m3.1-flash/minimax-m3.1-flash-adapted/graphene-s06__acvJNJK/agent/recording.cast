[56.306834, "i", "cat > /app/profile.py << 'EOF'\nimport csv\nrows=[]\nwith open('/app/spectrum.csv') as f:\n    r=csv.reader(f)\n    hdr=next(r)\n    for row in r:\n        rows.append((float(row[0]), float(row[1])))\nprint('header',hdr,'n',len(rows))\nxs=[a for a,b in rows]; ys=[b for a,b in rows]\nprint('x range',xs[0],xs[-1],'step',xs[1]-xs[0])\nprint('y range',min(ys),max(ys))\n# coarse ascii profile: bin by 25 cm-1\nimport math\nbins={}\nfor x,y in rows:\n    k=int(x//25)*25\n    bins.setdefault(k,[]).append(y)\nfor k in sorted(bins):\n    m=max(bins[k]); mn=min(bins[k])\n    print(f'{k:5d} max={m:9.1f} min={mn:9.1f} {\"#\"*int((m-800)/40)}')\nEOF\npython3 /app/profile.py\n"]
