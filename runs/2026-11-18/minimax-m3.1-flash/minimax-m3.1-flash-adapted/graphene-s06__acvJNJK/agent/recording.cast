[87.013278, "o", "def lor(x,a,g,x0,c): return a*g*g/((x-x0)**2+g*g)+c\r\n\u001b[?2004l\r"]
[87.013319, "o", "\u001b[?2004h> "]
[87.013351, "o", "def fit(lo,hi,label):\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.013392, "o", "> "]
[87.013424, "o", "    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.013491, "o", "    off=np.percentile(ys,10); i=np.argmax(ys); a0=ys[i]-off; x00=xs[i]\r\n\u001b[?2004l\r"]
[87.013525, "o", "\u001b[?2004h> "]
[87.013566, "o", "    p0=[a0,15.0,x00,off]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.013628, "o", "    p,_=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)\r\n\u001b[?2004l\r"]
[87.013659, "o", "\u001b[?2004h> "]
[87.013701, "o", "    rmse=np.sqrt(np.mean((ys-lor(xs,*p))**2))\r\n\u001b[?2004l\r"]
[87.013738, "o", "\u001b[?2004h> "]
[87.01387, "o", "    print(f'{label:3s} [{lo:7.1f},{hi:7.1f}] amp={p[0]:10.3f} gam={abs(p[1]):8.4f} x0={p[2]:10.4f} off={p[3]:9.3f} rmse={rmse:6.2f}')\r\n\u001b[?2004l\r"]
[87.013908, "o", "\u001b[?2004h> "]
[87.013948, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h> "]
