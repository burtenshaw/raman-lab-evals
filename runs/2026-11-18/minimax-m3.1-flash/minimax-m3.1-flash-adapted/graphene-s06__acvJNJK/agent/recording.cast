[87.012687, "i", "cat > /app/fit_scan.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd=np.genfromtxt('/app/spectrum.csv',delimiter=',',names=True)\nx=np.asarray(d[d.dtype.names[0]],float); y=np.asarray(d['intensity'],float)\ndef lor(x,a,g,x0,c): return a*g*g/((x-x0)**2+g*g)+c\ndef fit(lo,hi,label):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    off=np.percentile(ys,10); i=np.argmax(ys); a0=ys[i]-off; x00=xs[i]\n    p0=[a0,15.0,x00,off]\n    p,_=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)\n    rmse=np.sqrt(np.mean((ys-lor(xs,*p))**2))\n    print(f'{label:3s} [{lo:7.1f},{hi:7.1f}] amp={p[0]:10.3f} gam={abs(p[1]):8.4f} x0={p[2]:10.4f} off={p[3]:9.3f} rmse={rmse:6.2f}')\n    return p\ncent={'D':1346.7,'G':1579.6,'2D':2693.4}\nfor lab,c in cent.items():\n    print('---',lab)\n    for hw in [50,60,75,100,125,150,175,200]:\n        fit(c-hw,c+hw,lab)\nEOF\npython3 /app/fit_scan.py\n"]
[87.012836, "o", "cat > /app/fit_scan.py << 'EOF'\r\n\u001b[?2004l\r"]
