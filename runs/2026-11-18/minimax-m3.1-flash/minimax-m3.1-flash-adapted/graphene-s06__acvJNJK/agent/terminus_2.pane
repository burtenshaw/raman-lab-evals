[?2004l[?2004h> G  = fit_peak(x, y, 1479.6, 1679.6, 'G')
[?2004l[?2004h> DD = fit_peak(x, y, 2593.4, 2793.4, '2D')
[?2004l[?2004h> 
[?2004l[?2004h> ID_IG = D['amplitude'] / G['amplitude']
[?2004l[?2004h> results = {'D': D, 'G': G, '2D': DD, 'ID_IG': float(ID_IG)}
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
