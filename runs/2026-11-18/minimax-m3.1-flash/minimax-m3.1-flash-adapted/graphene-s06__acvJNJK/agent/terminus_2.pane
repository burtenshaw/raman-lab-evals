[?2004l[?2004h> import numpy as np, csv
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d=np.genfromtxt('/app/spectrum.csv',delimiter=',',names=True)
[?2004l[?2004h> x=np.asarray(d['raman_shift_cm1'] if 'raman_shift_cm1' in d.dtype.names else d[d.dtype.names[0]],float)
[?2004l[?2004h> y=np.asarray(d['intensity'],float)
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x,a,g,x0,c):
[?2004l[?2004h>     return a*g*g/((x-x0)**2+g*g)+c
[?2004l[?2004h> 
[?2004l[?2004h> def fit(lo,hi,label):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xs,ys=x[m],y[m]
[?2004l[?2004h>     # initial guesses
[?2004l[?2004h>     off=np.percentile(ys,10)
[?2004l[?2004h>     i=np.argmax(ys); a0=ys[i]-off; x00=xs[i]
[?2004l[?2004h>     half=off+a0/2
[?2004l[?2004h>     idx=np.where(ys>=half)[0]
[?2004l[?2004h>     g0=max((xs[idx[-1]]-xs[idx[0]])/2,1.0) if len(idx)>1 else 10.0
[?2004l[?2004h>     p0=[a0,g0,x00,off]
[?2004l[?2004h>     p,cov=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)
[?2004l[?2004h>     res=ys-lor(xs,*p)
[?2004l[?2004h>     rmse=np.sqrt(np.mean(res**2))
[?2004l[?2004h>     print(f'{label} win[{lo},{hi}] amp={p[0]:.3f} gam={abs(p[1]):.4f} x0={p[2]:.4f} off={p[3]:.3f} rmse={rmse:.2f} n={m.sum()}')
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> for lo,hi in [(1200,1500),(1150,1500),(1250,1500),(1180,1470),(1200,1450)]:
[?2004l[?2004h>     fit(lo,hi,'D')
[?2004l[?2004h> print()
[?2004l[?2004h> for lo,hi in [(1450,1750),(1450,1700),(1480,1720),(1500,1750),(1430,1730),(1450,1780)]:
