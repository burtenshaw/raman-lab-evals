python3 /app/final_fit.py
[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.asarray(d[d.dtype.names[0]], float)
[?2004l[?2004h> y = np.asarray(d['intensity'], float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, lo, hi, name):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     # initial guesses from the data
[?2004l[?2004h>     off0 = float(np.percentile(ys, 10))
[?2004l[?2004h>     i = int(np.argmax(ys))
[?2004l[?2004h>     amp0 = float(ys[i] - off0)
[?2004l[?2004h>     x00 = float(xs[i])
[?2004l[?2004h>     # half-maximum width estimate
[?2004l[?2004h>     half = off0 + amp0 / 2.0
[?2004l[?2004h>     idx = np.where(ys >= half)[0]
[?2004l[?2004h>     gam0 = max(float(xs[idx[-1]] - xs[idx[0]]) / 2.0, 1.0) if len(idx) > 1 else 10.0
[?2004l[?2004h>     p0 = [amp0, gam0, x00, off0]
[?2004l[?2004h>     p, cov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     amplitude, gamma, x0, offset = p
[?2004l[?2004h>     gamma = abs(gamma)
[?2004l[?2004h>     resid = ys - lorentzian(xs, amplitude, gamma, x0, offset)
[?2004l[?2004h>     rmse = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     print(f'{name:2s} window=[{lo:.1f},{hi:.1f}] n={m.sum():4d}  amp={amplitude:10.3f}  gamma={gamma:8.4f}  '
[?2004l[?2004h>           f'x0={x0:10.4f}  offset={offset:9.3f}  rmse={rmse:6.2f}')
[?2004l[?2004h>     return dict(x0=float(x0), gamma=float(gamma), amplitude=float(amplitude), offset=float(offset))
[?2004l[?2004h> 
[?2004l[?2004h> # symmetric windows (+/-100 cm-1) around each peak centre
