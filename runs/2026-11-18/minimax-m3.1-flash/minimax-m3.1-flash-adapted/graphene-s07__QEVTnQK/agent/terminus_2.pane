[?2004l[?2004h>         sel = (xc>=edges[j]) & (xc<edges[j+1])
[?2004l[?2004h>         if sel.sum():
[?2004l[?2004h>             print('   x %8.2f-%8.2f  n=%4d  mean_res=%9.2f  rms=%8.2f' % (edges[j], edges[j+1], sel.sum(), res[sel].mean(), res[sel].std()))
[?2004l[?2004h> 
