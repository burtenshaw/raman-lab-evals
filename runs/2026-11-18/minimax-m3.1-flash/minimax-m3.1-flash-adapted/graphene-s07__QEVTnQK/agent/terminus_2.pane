[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = d[:,0]; y = d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, hw=80.0):
[?2004l[?2004h>     m = (x >= center-hw) & (x <= center+hw)
[?2004l[?2004h>     xc, yc = x[m], y[m]
[?2004l[?2004h>     i = int(np.argmax(yc))
[?2004l[?2004h>     base = float(np.median(yc))
[?2004l[?2004h>     p0 = [yc[i]-base, xc[i], 20.0, base]
[?2004l[?2004h>     bounds = ([0.0, center-60.0, 1.0, -1e6], [1e7, center+60.0, 200.0, 1e6])
[?2004l[?2004h>     p, cov = curve_fit(lorentzian, xc, yc, p0=p0, bounds=bounds, maxfev=200000)
[?2004l[?2004h>     err = np.sqrt(np.diag(cov))
[?2004l[?2004h>     res = yc - lorentzian(xc, *p)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(res**2)))
[?2004l[?2004h>     r2 = 1.0 - np.sum(res**2)/np.sum((yc-np.mean(yc))**2)
[?2004l[?2004h>     print('  window [%.1f, %.1f]  n=%d  rms=%.2f  R2=%.5f' % (xc[0], xc[-1], len(xc), rms, r2))
[?2004l[?2004h>     print('  amplitude=%.2f +- %.2f   x0=%.3f +- %.3f   gamma=%.3f +- %.3f   offset=%.2f +- %.2f'
[?2004l[?2004h>           % (p[0],err[0],p[1],err[1],p[2],err[2],p[3],err[3]))
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {}
[?2004l[?2004h> for name, center in [('D',1348.0), ('G',1580.0), ('2D',2692.0)]:
[?2004l[?2004h>     print('===', name)
[?2004l[?2004h>     peaks[name] = fit_peak(center)
[?2004l[?2004h> 
[?2004l[?2004h> ID_IG = float(peaks['D'][0]/peaks['G'][0])
[?2004l[?2004h> print('ID_IG =', ID_IG)
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name in ['D','G','2D']:
[?2004l[?2004h>     a,x0,g,o = [float(v) for v in peaks[name]]
[?2004l[?2004h>     results[name] = {'x0': x0, 'gamma': g, 'amplitude': a, 'offset': o}
[?2004l[?2004h> results['ID_IG'] = ID_IG
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print(json.dumps(results, indent=2))
