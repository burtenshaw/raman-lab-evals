[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = d[:,0]; y = d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2)+off
[?2004l[?2004h> 
[?2004l[?2004h> def fit(xc, yc, p0):
[?2004l[?2004h>     p, cov = curve_fit(lor, xc, yc, p0=p0, maxfev=200000)
[?2004l[?2004h>     res = yc - lor(xc, *p)
[?2004l[?2004h>     ss = np.sum(res**2); sst = np.sum((yc-np.mean(yc))**2)
[?2004l[?2004h>     return p, np.sqrt(ss/len(yc)), 1-ss/sst
[?2004l[?2004h> 
[?2004l[?2004h> for name, c in [('D',1348),('G',1580),('2D',2690)]:
[?2004l[?2004h>     print('=== ', name)
