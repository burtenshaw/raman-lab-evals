[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = d[:,0]; y = d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, x0, gamma, off):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2)+off
[?2004l[?2004h> 
[?2004l[?2004h> def pos_gamma(c, hw):
[?2004l[?2004h>     m = (x > c-hw) & (x < c+hw)
[?2004l[?2004h>     xc, yc = x[m], y[m]
[?2004l[?2004h>     i = np.argmax(yc); base = np.median(yc)
[?2004l[?2004h>     bounds = ([0, c-60, 1, -1e6],[1e7, c+60, 200, 1e6])
[?2004l[?2004h>     p, _ = curve_fit(lor, xc, yc, p0=[yc[i]-base, xc[i], 20.0, base], bounds=bounds, maxfev=200000)
[?2004l[?2004h>     res = yc - lor(xc,*p)
[?2004l[?2004h>     return p, np.sqrt(np.mean(res**2))
[?2004l[?2004h> 
[?2004l[?2004h> print('--- individual fits, gamma>0 ---')
[?2004l[?2004h> for name, c in [('D',1348),('G',1580),('2D',2690)]:
[?2004l[?2004h>     for hw in [30,40,50,60,80,100,120,150]:
[?2004l[?2004h>         p, rms = pos_gamma(c, hw)
[?2004l[?2004h>         print('%3s hw=%3d amp=%9.2f x0=%9.3f gamma=%7.3f off=%9.2f rms=%7.2f' % (name,hw,p[0],p[1],p[2],p[3],rms))
[?2004l[?2004h> 
[?2004l[?2004h> print('--- background medians in peak-free windows ---')
[?2004l[?2004h> for lo,hi in [(1100,1200),(1200,1250),(1450,1500),(1650,1750),(1800,2000),(2100,2400),(2450,2600),(2800,3000),(1100,3000)]:
[?2004l[?2004h>     m=(x>=lo)&(x<hi)
[?2004l[?2004h>     print('  %5d-%5d  median=%8.2f  mean=%8.2f' % (lo,hi,np.median(y[m]),np.mean(y[m])))
[?2004l[?2004h> 
[?2004l[?2004h> print('--- simultaneous 3-Lorentzian + shared constant offset ---')
[?2004l[?2004h> def model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):
[?2004l[?2004h>     return (lor(x,a1,x1,g1,0)+lor(x,a2,x2,g2,0)+lor(x,a3,x3,g3,0)+off)
