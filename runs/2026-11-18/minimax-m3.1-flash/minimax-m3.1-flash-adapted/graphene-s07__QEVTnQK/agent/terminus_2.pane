[?2004l[?2004h>         m = (x > c-hw) & (x < c+hw)
[?2004l[?2004h>         xc, yc = x[m], y[m]
[?2004l[?2004h>         base = np.median(yc)
[?2004l[?2004h>         # initial guess
[?2004l[?2004h>         i = np.argmax(yc)
[?2004l[?2004h>         amp0 = yc[i]-base
[?2004l[?2004h>         p0 = [amp0, xc[i], 30.0, base]
[?2004l[?2004h>         try:
[?2004l[?2004h>             p, rms, r2 = fit(xc, yc, p0)
[?2004l[?2004h>             print(' hw=%3d  amp=%10.3f x0=%9.3f gamma=%8.3f off=%9.3f rms=%8.2f R2=%.5f' % (hw, p[0], p[1], p[2], p[3], rms, r2))
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(' hw=%3d FAILED %s' % (hw, e))
