[134.731955, "o", "\u001b[?2004hroot@j-openenv-6afd8d1f29e8b7ccfbbb838b-43zoa1ay-0cae1-55q2c:/app# "]
[138.012414, "i", "cat > /app/validate.py << 'EOF'\nimport json, numpy as np\nr = json.load(open('/app/results.json'))\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\nfor k in ['D','G','2D']:\n    p = r[k]\n    m = (x > p['x0']-60) & (x < p['x0']+60)\n    idx = np.argmax(y[m]); xs = x[m][idx]\n    model_max = p['amplitude'] + p['offset']\n    print('%3s: x0=%8.3f (data max at %8.3f) gamma=%6.3f amp=%9.2f model_peak=%9.2f data_peak=%9.2f off=%8.2f' %\n          (k, p['x0'], xs, p['gamma'], p['amplitude'], model_max, y[m][idx], p['offset']))\n    assert abs(xs - p['x0']) < 3\n    assert p['amplitude'] > 0 and p['gamma'] > 0\nprint('ID_IG =', r['ID_IG'], '= amp_D/amp_G =', r['D']['amplitude']/r['G']['amplitude'])\nassert abs(r['ID_IG'] - r['D']['amplitude']/r['G']['amplitude']) < 1e-12\nprint('OK: /app/results.json valid')\nEOF\npython3 /app/validate.py; ls -la /app/results.json\n"]
[138.012561, "o", "cat > /app/validate.py << 'EOF'\r\n\u001b[?2004l\r"]
[138.012641, "o", "\u001b[?2004h> import json, numpy as np\r\n\u001b[?2004l\r"]
[138.012681, "o", "\u001b[?2004h> "]
[138.012801, "o", "r = json.load(open('/app/results.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.012892, "o", "d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.012938, "o", "x, y = d[:,0], d[:,1]\r\n\u001b[?2004l\r"]
[138.01299, "o", "\u001b[?2004h"]
[138.013023, "o", "> for k in ['D','G','2D']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.013052, "o", "    p = r[k]\r\n\u001b[?2004l\r"]
[138.01308, "o", "\u001b[?2004h> "]
[138.013094, "o", "    m = (x > p['x0']-60) & (x < p['x0']+60)\r\n\u001b[?2004l\r"]
[138.013117, "o", "\u001b[?2004h> "]
[138.013178, "o", "    idx = np.argmax(y[m]); xs = x[m][idx]\r\n\u001b[?2004l\r"]
[138.013202, "o", "\u001b[?2004h"]
[138.013239, "o", "> "]
[138.01327, "o", "    model_max = p['amplitude'] + p['offset']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.013419, "o", "    print('%3s: x0=%8.3f (data max at %8.3f) gamma=%6.3f amp=%9.2f model_peak=%9.2f data_peak=%9.2f off=%8.2f' %\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.013448, "o", "> "]
[138.013553, "o", "          (k, p['x0'], xs, p['gamma'], p['amplitude'], model_max, y[m][idx], p['offset']))\r\n\u001b[?2004l\r"]
[138.013586, "o", "\u001b[?2004h> "]
[138.013617, "o", "    assert abs(xs - p['x0']) < 3\r\n\u001b[?2004l\r"]
[138.013633, "o", "\u001b[?2004h> "]
[138.01369, "o", "    assert p['amplitude'] > 0 and p['gamma'] > 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.013805, "o", "print('ID_IG =', r['ID_IG'], '= amp_D/amp_G =', r['D']['amplitude']/r['G']['amplitude'])\r\n\u001b[?2004l\r"]
[138.013848, "o", "\u001b[?2004h> "]
[138.013932, "o", "assert abs(r['ID_IG'] - r['D']['amplitude']/r['G']['amplitude']) < 1e-12\r\n\u001b[?2004l\r"]
[138.013958, "o", "\u001b[?2004h> "]
[138.014024, "o", "print('OK: /app/results.json valid')\r\n\u001b[?2004l\r"]
[138.014034, "o", "\u001b[?2004h> "]
[138.014062, "o", "EOF\r\n\u001b[?2004l\r"]
[138.015282, "o", "\u001b[?2004hroot@j-openenv-6afd8d1f29e8b7ccfbbb838b-43zoa1ay-0cae1-55q2c:/app# "]
[138.015346, "o", "python3 /app/validate.py; ls -la /app/results.json\r\n\u001b[?2004l\r"]
