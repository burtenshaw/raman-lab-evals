[47.035663, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lor(x, amp, x0, gamma, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef fit(xc, yc, p0):\n    p, cov = curve_fit(lor, xc, yc, p0=p0, maxfev=200000)\n    res = yc - lor(xc, *p)\n    ss = np.sum(res**2); sst = np.sum((yc-np.mean(yc))**2)\n    return p, np.sqrt(ss/len(yc)), 1-ss/sst\n\nfor name, c in [('D',1348),('G',1580),('2D',2690)]:\n    print('=== ', name)\n    for hw in [40,60,80,100,120,150,200]:\n        m = (x > c-hw) & (x < c+hw)\n        xc, yc = x[m], y[m]\n        base = np.median(yc)\n        # initial guess\n        i = np.argmax(yc)\n        amp0 = yc[i]-base\n        p0 = [amp0, xc[i], 30.0, base]\n        try:\n            p, rms, r2 = fit(xc, yc, p0)\n            print(' hw=%3d  amp=%10.3f x0=%9.3f gamma=%8.3f off=%9.3f rms=%8.2f R2=%.5f' % (hw, p[0], p[1], p[2], p[3], rms, r2))\n        except Exception as e:\n            pri"]
[47.035707, "i", "nt(' hw=%3d FAILED %s' % (hw, e))\nEOF\npython3 /app/fit_test.py\n"]
