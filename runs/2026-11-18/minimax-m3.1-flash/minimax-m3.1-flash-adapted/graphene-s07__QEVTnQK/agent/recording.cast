[119.71184, "o", "\u001b[?2004h> "]
[119.711879, "o", "    print('===', name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.711928, "o", "    peaks[name] = fit_peak(center)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.711971, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.712009, "o", "ID_IG = float(peaks['D'][0]/peaks['G'][0])\r\n\u001b[?2004l\r"]
[119.712036, "o", "\u001b[?2004h> "]
[119.712064, "o", "print('ID_IG =', ID_IG)\r\n\u001b[?2004l\r"]
[119.712099, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[119.712137, "o", "\u001b[?2004h> "]
[119.71215, "o", "results = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.712179, "o", "for name in ['D','G','2D']:\r\n\u001b[?2004l\r"]
[119.712241, "o", "\u001b[?2004h> "]
[119.712271, "o", "    a,x0,g,o = [float(v) for v in peaks[name]]\r\n\u001b[?2004l\r"]
[119.712296, "o", "\u001b[?2004h> "]
[119.712379, "o", "    results[name] = {'x0': x0, 'gamma': g, 'amplitude': a, 'offset': o}\r\n\u001b[?2004l\r"]
[119.712431, "o", "\u001b[?2004h> "]
[119.712451, "o", "results['ID_IG'] = ID_IG\r\n\u001b[?2004l\r"]
[119.712459, "o", "\u001b[?2004h> \r\n"]
[119.712488, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[119.712552, "o", "with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r"]
[119.712578, "o", "\u001b[?2004h> "]
[119.712626, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[119.712652, "o", "\u001b[?2004h> "]
[119.712692, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r"]
[119.712716, "o", "\u001b[?2004h> "]
[119.712744, "o", "EOF\r\n\u001b[?2004l\r"]
[119.714104, "o", "\u001b[?2004hroot@j-openenv-6afd8d1f29e8b7ccfbbb838b-43zoa1ay-0cae1-55q2c:/app# "]
[119.714169, "o", "python3 /app/final_fit.py\r\n\u001b[?2004l\r"]
