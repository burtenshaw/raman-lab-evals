[38.621112, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\nprint('n =', len(x), 'range', x.min(), x.max(), 'step', np.diff(x)[:3])\nprint('y min/max/median', y.min(), y.max(), np.median(y))\nfor name, c in [('D',1350),('G',1580),('2D',2690)]:\n    m = (x > c-60) & (x < c+60)\n    xs, ys = x[m], y[m]\n    # local maxima\n    idx = np.where((ys[1:-1] > ys[:-2]) & (ys[1:-1] > ys[2:]))[0] + 1\n    order = np.argsort(ys[idx])[::-1]\n    print(name, 'center', c, 'max in window', ys.max(), 'at x=', xs[ys.argmax()])\n    for i in order[:5]:\n        print('   peak x=%.2f y=%.1f' % (xs[i], ys[i]))\n    # baseline estimate: median of region edges\n    print('   edge median', np.median(y[(x>c-120)&(x<c-80)]), np.median(y[(x>c+80)&(x<c+120)]))\nEOF\npython3 /app/explore.py\n"]
