[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.signal import find_peaks, savgol_filter
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d['raman_shift_cm1']
[?2004l[?2004h> y = d['intensity']
[?2004l[?2004h> ys = savgol_filter(y, 41, 2)
[?2004l[?2004h> peaks, props = find_peaks(ys, prominence=200)
