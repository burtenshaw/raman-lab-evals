[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # ---- load data ----
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.asarray(data['raman_shift_cm1'], dtype=float)
[?2004l[?2004h> y = np.asarray(data['intensity'], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> # peak name -> (nominal x0, nominal gamma, nominal amplitude, nominal offset, window)
[?2004l[?2004h> config = {
[?2004l[?2004h>     'D':  (1352.5, 19.0, 350.0, 1290.0, (1250.0, 1450.0)),
[?2004l[?2004h>     'G':  (1581.0,  8.0, 6900.0, 1265.0, (1480.0, 1680.0)),
[?2004l[?2004h>     '2D': (2695.0, 27.0, 14100.0, 1200.0, (2595.0, 2795.0)),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (x0g, gg, ag, og, (lo, hi)) in config.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     p0 = [x0g, gg, ag, og]
[?2004l[?2004h>     bounds = ([x0g - 60.0, 0.5, 1.0, 0.0], [x0g + 60.0, 500.0, 1.0e6, 1.0e5])
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=bounds, maxfev=200000)
[?2004l[?2004h>     resid = ys - lorentzian(xs, *popt)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(popt[0]),
[?2004l[?2004h>         'gamma': float(popt[1]),
[?2004l[?2004h>         'amplitude': float(popt[2]),
[?2004l[?2004h>         'offset': float(popt[3]),
[?2004l[?2004h>     }
[?2004l[?2004h>     print(f"{name:3s} x0={popt[0]:9.4f}  gamma={popt[1]:8.4f}  amplitude={popt[2]:10.3f}  "
[?2004l[?2004h>           f"offset={popt[3]:9.3f}  rms={rms:6.2f}  stderr={np.sqrt(np.diag(pcov))}")
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> print(f"ID/IG = {results['ID_IG']:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> EOF
