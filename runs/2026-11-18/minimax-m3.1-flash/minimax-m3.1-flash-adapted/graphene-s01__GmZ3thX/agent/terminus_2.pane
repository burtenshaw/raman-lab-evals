[?2004lD', e); continue
        resid = ys - lor(xs, *p)
        rms = np.sqrt(np.mean(resid**2))
        print(f"   [{lo},{hi}] x0={p[0]:8.3f} gamma={p[1]:8.3f} amp={p[2]:10.2f} off={p[3]:9.2f} rms={rms:8.2f} perr={np.sqrt(np.diag(cov))}")

# global fit: three Lorentzians + one offset
def multi(x, x1,g1,a1, x2,g2,a2, x3,g3,a3, off):
    return (a1*g1**2/((x-x1)**2+g1**2) + a2*g2**2/((x-x2)**2+g2**2)
            + a3*g3**2/((x-x3)**2+g3**2) + off)

p0 = [1352,35,350, 1581,25,6400, 2695,35,13900, 1300]
bounds = ([1250,1,1, 1450,1,1, 2500,1,1, 0], [1450,500,1e6, 1700,500,1e6, 2900,500,1e6, 1e5])
p, cov = curve_fit(multi, x, y, p0=p0, bounds=bounds, maxfev=200000)
resid = y - multi(x, *p)
print('GLOBAL:', np.round(p, 4), 'rms', np.sqrt(np.mean(resid**2)))
