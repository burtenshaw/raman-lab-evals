[137.670403, "o", "\u001b[?2004hroot@j-openenv-6afd8bed29e8b7ccfbbb82d1-g7c3b8c9-1ba86-6r28w:/app# "]
[164.734717, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# ---- load data ----\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(data['raman_shift_cm1'], dtype=float)\ny = np.asarray(data['intensity'], dtype=float)\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# peak name -> (nominal x0, nominal gamma, nominal amplitude, nominal offset, window)\nconfig = {\n    'D':  (1352.5, 19.0, 350.0, 1290.0, (1250.0, 1450.0)),\n    'G':  (1581.0,  8.0, 6900.0, 1265.0, (1480.0, 1680.0)),\n    '2D': (2695.0, 27.0, 14100.0, 1200.0, (2595.0, 2795.0)),\n}\n\nresults = {}\nfor name, (x0g, gg, ag, og, (lo, hi)) in config.items():\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    p0 = [x0g, gg, ag, og]\n    bounds = ([x0g - 60.0, 0.5, 1.0, 0.0], [x0g + 60.0, 500.0, 1.0e6, 1.0e5])\n    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=bounds, maxfev=200000)\n    resid = ys - lorentzi"]
[164.734832, "i", "an(xs, *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    results[name] = {\n        'x0': float(popt[0]),\n        'gamma': float(popt[1]),\n        'amplitude': float(popt[2]),\n        'offset': float(popt[3]),\n    }\n    print(f\"{name:3s} x0={popt[0]:9.4f}  gamma={popt[1]:8.4f}  amplitude={popt[2]:10.3f}  \"\n          f\"offset={popt[3]:9.3f}  rms={rms:6.2f}  stderr={np.sqrt(np.diag(pcov))}\")\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint(f\"ID/IG = {results['ID_IG']:.6f}\")\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 /app/fit.py\n"]
[164.734885, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
