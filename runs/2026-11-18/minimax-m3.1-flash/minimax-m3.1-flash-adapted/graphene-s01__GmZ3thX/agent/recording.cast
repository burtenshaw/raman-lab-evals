[164.735708, "o", "\u001b[?2004h> "]
[164.735785, "o", "def lorentzian(x, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r"]
[164.735813, "o", "\u001b[?2004h> "]
[164.735951, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[164.735988, "o", "\u001b[?2004h"]
[164.736012, "o", "> \r\n\u001b[?2004l\r"]
[164.736049, "o", "\u001b[?2004h> "]
