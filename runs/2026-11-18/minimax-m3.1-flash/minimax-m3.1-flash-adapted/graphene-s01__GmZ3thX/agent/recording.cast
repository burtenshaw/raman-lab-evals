[164.736213, "o", "\u001b[?2004h> "]
[164.736248, "o", "config = {\r\n\u001b[?2004l\r"]
[164.736274, "o", "\u001b[?2004h> "]
[164.736372, "o", "    'D':  (1352.5, 19.0, 350.0, 1290.0, (1250.0, 1450.0)),\r\n\u001b[?2004l\r"]
[164.736409, "o", "\u001b[?2004h> "]
[164.736516, "o", "    'G':  (1581.0,  8.0, 6900.0, 1265.0, (1480.0, 1680.0)),\r\n\u001b[?2004l\r"]
[164.736553, "o", "\u001b[?2004h> "]
[164.736655, "o", "    '2D': (2695.0, 27.0, 14100.0, 1200.0, (2595.0, 2795.0)),\r\n\u001b[?2004l\r"]
[164.736682, "o", "\u001b[?2004h> }"]
[164.736713, "o", "\r\n\u001b[?2004l\r"]
[164.736741, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.736781, "o", "> "]
[164.736818, "o", "results = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.736926, "o", "for name, (x0g, gg, ag, og, (lo, hi)) in config.items():\r\n\u001b[?2004l\r"]
[164.736953, "o", "\u001b[?2004h> "]
[164.73701, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[164.737041, "o", "\u001b[?2004h"]
[164.737073, "o", "> "]
[164.73711, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r"]
[164.737152, "o", "\u001b[?2004h> "]
[164.73717, "o", "    p0 = [x0g, gg, ag, og]\r\n\u001b[?2004l\r"]
[164.737194, "o", "\u001b[?2004h> "]
[164.737336, "o", "    bounds = ([x0g - 60.0, 0.5, 1.0, 0.0], [x0g + 60.0, 500.0, 1.0e6, 1.0e5])\r\n\u001b[?2004l\r"]
[164.737379, "o", "\u001b[?2004h> "]
[164.737556, "o", "    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, bounds=bounds, maxfev=200000)\r\n\u001b[?2004l\r"]
