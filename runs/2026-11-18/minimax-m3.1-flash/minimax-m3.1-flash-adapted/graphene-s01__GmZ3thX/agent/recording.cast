[137.060063, "o", "> "]
[137.060302, "o", "    print(f\"{nm} lin  : x0={pl[0]:.4f} g={pl[1]:.4f} a={pl[2]:.3f} slope={pl[3]:.5f} int={pl[4]:.3f} rms={np.sqrt(np.mean(rl**2)):.2f}\")\r\n\u001b[?2004l\r"]
