[74.636518, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']\ny = d['intensity']\nprint('n =', x.size, 'x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\npeaks, props = find_peaks(y, prominence=20)\nfor p, pr in zip(peaks, props['prominences']):\n    print(f\"x={x[p]:8.2f}  y={y[p]:10.2f}  prom={pr:9.2f}\")\nEOF\npython3 /app/explore.py\n"]
