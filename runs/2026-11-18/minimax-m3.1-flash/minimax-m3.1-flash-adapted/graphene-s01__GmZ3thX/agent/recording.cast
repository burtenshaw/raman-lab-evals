[164.738208, "o", "> "]
[164.738263, "o", "        'offset': float(popt[3]),\r\n\u001b[?2004l\r"]
[164.738289, "o", "\u001b[?2004h> "]
[164.738317, "o", "    }\r\n\u001b[?2004l\r"]
[164.738335, "o", "\u001b[?2004h> "]
[164.738508, "o", "    print(f\"{name:3s} x0={popt[0]:9.4f}  gamma={popt[1]:8.4f}  amplitude={popt[2]:10.3f}  \"\r\n\u001b[?2004l\r"]
[164.73854, "o", "\u001b[?2004h"]
[164.738571, "o", "> "]
[164.738728, "o", "          f\"offset={popt[3]:9.3f}  rms={rms:6.2f}  stderr={np.sqrt(np.diag(pcov))}\")\r\n\u001b[?2004l\r"]
