[82.19803, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks, savgol_filter\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']\ny = d['intensity']\nys = savgol_filter(y, 41, 2)\npeaks, props = find_peaks(ys, prominence=200)\nfor p, pr in zip(peaks, props['prominences']):\n    print(f\"x={x[p]:8.2f}  y={ys[p]:10.2f}  prom={pr:9.2f}\")\nprint('---- coarse profile (every 25 cm-1) ----')\nfor xi in range(1100, 3001, 25):\n    m = (x >= xi) & (x < xi + 25)\n    if m.any():\n        print(f\"{xi:5d} {ys[m].max():10.1f}\")\nEOF\npython3 /app/explore2.py\n"]
