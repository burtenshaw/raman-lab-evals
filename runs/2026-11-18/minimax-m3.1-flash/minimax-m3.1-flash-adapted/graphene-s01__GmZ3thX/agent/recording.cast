[164.73541, "o", "\u001b[?2004h> "]
[164.735515, "o", "x = np.asarray(data['raman_shift_cm1'], dtype=float)\r\n\u001b[?2004l\r"]
[164.73555, "o", "\u001b[?2004h> "]
[164.735639, "o", "y = np.asarray(data['intensity'], dtype=float)\r\n\u001b[?2004l\r"]
