[164.737697, "o", "\u001b[?2004h"]
[164.737726, "o", "> "]
[164.737785, "o", "    rms = float(np.sqrt(np.mean(resid**2)))\r\n\u001b[?2004l\r"]
[164.737822, "o", "\u001b[?2004h> "]
[164.737871, "o", "    results[name] = {\r\n\u001b[?2004l\r"]
[164.737911, "o", "\u001b[?2004h> "]
[164.737975, "o", "        'x0': float(popt[0]),\r\n\u001b[?2004l\r"]
[164.737997, "o", "\u001b[?2004h> "]
