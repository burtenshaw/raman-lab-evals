[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)
[?2004l[?2004h> x=d[:,0]; y=d[:,1]
[?2004l[?2004h> def model(x,a,g,x0,off):
[?2004l[?2004h>     return a*g**2/((x-x0)**2+g**2)+off
[?2004l[?2004h> def fit(lo,hi):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]
[?2004l[?2004h>     base=np.percentile(ys,10); i=np.argmax(ys); amp0=ys[i]-base
[?2004l[?2004h>     idx=np.where(ys>=base+amp0/2)[0]
[?2004l[?2004h>     g0=max((xs[idx[-1]]-xs[idx[0]])/2,2.0)
[?2004l[?2004h>     p,_=curve_fit(model,xs,ys,p0=[amp0,g0,xs[i],base],maxfev=200000)
[?2004l[?2004h>     r=ys-model(xs,*p)
[?2004l[?2004h>     return p, np.sqrt(np.mean(r**2))
[?2004l[?2004h> for lo in (1150,1180,1200,1220,1240):
[?2004l[?2004h>     for hi in (1440,1460,1470,1480,1500):
[?2004l[?2004h>         p,rms=fit(lo,hi)
[?2004l[?2004h>         print(f'D {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')
[?2004l[?2004h> print()
