[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = d[:,0]; y = d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x,a,g,x0):
[?2004l[?2004h>     return a*g**2/((x-x0)**2+g**2)
[?2004l[?2004h> 
[?2004l[?2004h> def make(bgdeg):
[?2004l[?2004h>     def f(x,a1,g1,x1,a2,g2,x2,a3,g3,x3,*b):
[?2004l[?2004h>         out = lor(x,a1,g1,x1)+lor(x,a2,g2,x2)+lor(x,a3,g3,x3)
[?2004l[?2004h>         B = np.zeros_like(x)
[?2004l[?2004h>         for i,c in enumerate(b):
[?2004l[?2004h>             B = B + c*(x-2000.0)**i/1000.0**i
[?2004l[?2004h>         return out + B
[?2004l[?2004h>     return f
[?2004l[?2004h> 
[?2004l[?2004h> p0=[345,19,1352, 6929,8,1581, 14099,27,2695]
[?2004l[?2004h> for deg in (0,1,2):
[?2004l[?2004h>     f = make(deg)
[?2004l[?2004h>     pp = p0 + [1250,0.0,0.0][:deg+1]
[?2004l[?2004h>     try:
[?2004l[?2004h>         p,cov = curve_fit(f,x,y,p0=pp,maxfev=600000)
[?2004l[?2004h>         r=y-f(x,*p)
[?2004l[?2004h>         print(f'deg={deg} rms={np.sqrt(np.mean(r**2)):.2f} D a={p[0]:.2f} g={p[1]:.2f} x0={p[2]:.2f} | G a={p[3]:.2f} g={p[4]:.3f} x0={p[5]:.3f} | 2D a={p[6]:.2f} g={p[7]:.2f} x0={p[8]:.2f} bg={np.round(p[9:],3)}')
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print('deg',deg,'failed',e)
[?2004l[?2004h> 
[?2004l[?2004h> # D region with linear background, and D region with G tail included
[?2004l[?2004h> def m_d(x,a,g,x0,c0,c1):
[?2004l[?2004h>     return lor(x,a,g,x0)+c0+c1*(x-1300.0)/100.0
