[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = d[:,0]; y = d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def model(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit(lo, hi, guess_x0, label=''):
[?2004l[?2004h>     m = (x>=lo)&(x<=hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     base = np.percentile(ys, 10)
[?2004l[?2004h>     i = np.argmax(ys)
[?2004l[?2004h>     amp0 = ys[i]-base
[?2004l[?2004h>     # estimate gamma from half max width
[?2004l[?2004h>     half = base + amp0/2
[?2004l[?2004h>     idx = np.where(ys>=half)[0]
[?2004l[?2004h>     g0 = max((xs[idx[-1]]-xs[idx[0]])/2, 2.0) if len(idx)>1 else 15.0
[?2004l[?2004h>     p0 = [amp0, g0, xs[i], base]
[?2004l[?2004h>     p, cov = curve_fit(model, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     resid = ys - model(xs, *p)
[?2004l[?2004h>     rms = np.sqrt(np.mean(resid**2))
[?2004l[?2004h>     print(f'{label:22s} win=({lo},{hi}) amp={p[0]:9.2f} gamma={p[1]:7.3f} x0={p[2]:9.3f} off={p[3]:8.2f} rms={rms:7.2f} n={m.sum()}')
[?2004l[?2004h>     return p
[?2004l[?2004h> 
