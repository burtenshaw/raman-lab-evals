[?2004hroot@j-openenv-6afd8a8629e8b7ccfbbb81c2-vogpwnjh-de8be-tf6sm:/app# cat > /app/fit_peaks.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Fit single Lorentzians + constant offset to the D, G and 2D Raman peaks."""
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> DATA = '/app/spectrum.csv'
[?2004l[?2004h> OUT = '/app/results.json'
[?2004l[?2004h> 
[?2004l[?2004h> # fitting windows (cm^-1) chosen around each isolated peak
[?2004l[?2004h> WINDOWS = {'D': (1200.0, 1470.0),
[?2004l[?2004h>            'G': (1520.0, 1670.0),
[?2004l[?2004h>            '2D': (2450.0, 2950.0)}
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt(DATA, delimiter=',', skiprows=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi) in WINDOWS.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     base = float(np.percentile(ys, 10))
[?2004l[?2004h>     i = int(np.argmax(ys))
[?2004l[?2004h>     amp0 = float(ys[i] - base)
[?2004l[?2004h>     above = np.where(ys >= base + amp0 / 2.0)[0]
[?2004l[?2004h>     g0 = float(max((xs[above[-1]] - xs[above[0]]) / 2.0, 2.0)) if above.size > 1 else 15.0
[?2004l[?2004h>     p0 = [amp0, g0, float(xs[i]), base]
[?2004l[?2004h>     p, _ = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     amp, gamma, x0, off = (float(v) for v in p)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean((ys - lorentzian(xs, *p))**2)))
[?2004l[?2004h>     print(f'{name:3s} window=[{lo},{hi}] amplitude={amp:.3f} gamma={gamma:.3f} x0={x0:.3f} offset={off:.3f} rms={rms:.2f}')
[?2004l[?2004h>     results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amp, 'offset': off}
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> print('ID/IG = %.6f' % results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> with open(OUT, 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h>     f.write('\n')
[?2004l[?2004h> print('wrote', OUT)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@j-openenv-6afd8a8629e8b7ccfbbb81c2-vogpwnjh-de8be-tf6sm:/app# python3 /app/fit_peaks.py
