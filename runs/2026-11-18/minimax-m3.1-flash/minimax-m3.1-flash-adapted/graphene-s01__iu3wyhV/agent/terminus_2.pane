[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = d[:,0]; y = d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, a, g, x0):
[?2004l[?2004h>     return a*g**2/((x-x0)**2+g**2)
[?2004l[?2004h> 
[?2004l[?2004h> def model3(x, a1,g1,x1, a2,g2,x2, a3,g3,x3, B):
[?2004l[?2004h>     return lor(x,a1,g1,x1)+lor(x,a2,g2,x2)+lor(x,a3,g3,x3)+B
[?2004l[?2004h> 
[?2004l[?2004h> p0=[345,19,1352, 6929,8,1581, 14099,27,2695, 1250]
[?2004l[?2004h> p,cov = curve_fit(model3, x, y, p0=p0, maxfev=400000)
[?2004l[?2004h> print('GLOBAL: D a=%.2f g=%.3f x0=%.3f | G a=%.2f g=%.3f x0=%.3f | 2D a=%.2f g=%.3f x0=%.3f | B=%.2f' % (p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9]))
[?2004l[?2004h> resid = y - model3(x,*p)
[?2004l[?2004h> print('global rms', np.sqrt(np.mean(resid**2)))
[?2004l[?2004h> print('perr', np.sqrt(np.diag(cov)))
[?2004l[?2004h> 
[?2004l[?2004h> # local fits + binned residuals
[?2004l[?2004h> def model(x, a, g, x0, off):
[?2004l[?2004h>     return a*g**2/((x-x0)**2+g**2)+off
[?2004l[?2004h> 
[?2004l[?2004h> for (lo,hi,name) in [(1200,1470,'D'),(1500,1680,'G'),(2450,2950,'2D')]:
[?2004l[?2004h>     m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]
[?2004l[?2004h>     base=np.percentile(ys,10); i=np.argmax(ys); amp0=ys[i]-base
[?2004l[?2004h>     idx=np.where(ys>=base+amp0/2)[0]
[?2004l[?2004h>     g0=max((xs[idx[-1]]-xs[idx[0]])/2,2.0)
[?2004l[?2004h>     pp,_=curve_fit(model, xs, ys, p0=[amp0,g0,xs[i],base], maxfev=200000)
[?2004l[?2004h>     r=ys-model(xs,*pp)
[?2004l[?2004h>     print(f'--- {name} local: a={pp[0]:.2f} g={pp[1]:.3f} x0={pp[2]:.3f} off={pp[3]:.2f} rms={np.sqrt(np.mean(r**2)):.2f}')
[?2004l[?2004h>     # binned residuals (20 cm-1 bins)
[?2004l[?2004h>     bins=np.arange(lo,hi+1,20)
[?2004l[?2004h>     for b0 in bins:
[?2004l[?2004h>         mm=(xs>=b0)&(xs<b0+20)
[?2004l[?2004h>         if mm.sum()>0:
