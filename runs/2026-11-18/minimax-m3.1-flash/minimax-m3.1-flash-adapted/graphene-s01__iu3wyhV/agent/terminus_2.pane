[?2004l[?2004h>         print(f'G {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')
[?2004l[?2004h> print()
