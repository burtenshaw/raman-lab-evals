[?2004l[?2004h>     for hi in (2850,2900,2950,3000):
[?2004l[?2004h>         p,rms=fit(lo,hi)
[?2004l[?2004h>         print(f'2D {lo}-{hi}: a={p[0]:9.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')
