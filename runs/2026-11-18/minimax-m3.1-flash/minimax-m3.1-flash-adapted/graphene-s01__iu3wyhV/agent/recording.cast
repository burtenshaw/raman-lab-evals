[182.395216, "o", "    r=ys-model(xs,*pp)\r\n\u001b[?2004l\r"]
[182.395253, "o", "\u001b[?2004h> "]
[182.395483, "o", "    print(f'--- {name} local: a={pp[0]:.2f} g={pp[1]:.3f} x0={pp[2]:.3f} off={pp[3]:.2f} rms={np.sqrt(np.mean(r**2)):.2f}')\r\n\u001b[?2004l\r"]
[182.395528, "o", "\u001b[?2004h> "]
[182.395595, "o", "    # binned residuals (20 cm-1 bins)\r\n\u001b[?2004l\r"]
[182.395659, "o", "\u001b[?2004h> "]
[182.395701, "o", "    bins=np.arange(lo,hi+1,20)\r\n\u001b[?2004l\r"]
[182.395742, "o", "\u001b[?2004h> "]
[182.395781, "o", "    for b0 in bins:\r\n\u001b[?2004l\r"]
[182.395818, "o", "\u001b[?2004h> "]
[182.395858, "o", "        mm=(xs>=b0)&(xs<b0+20)\r\n\u001b[?2004l\r"]
[182.395903, "o", "\u001b[?2004h> "]
[182.395938, "o", "        if mm.sum()>0:\r\n\u001b[?2004l\r"]
[182.395977, "o", "\u001b[?2004h> "]
[182.396199, "o", "            print(f'   {b0:6.0f}-{b0+20:6.0f} n={mm.sum():4d} mean_resid={r[mm].mean():8.2f} std={r[mm].std():7.2f}')\r\n\u001b[?2004l\r"]
[182.396243, "o", "\u001b[?2004h> "]
[182.39628, "o", "EOF\r\n\u001b[?2004l\r"]
