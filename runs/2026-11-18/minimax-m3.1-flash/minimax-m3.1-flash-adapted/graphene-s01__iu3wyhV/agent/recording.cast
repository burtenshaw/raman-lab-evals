[55.061404, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\nprint('N points', len(x), 'range', x[0], x[-1])\nprint('min', y.min(), 'max', y.max())\ndef region(lo, hi, n=40):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    order = np.argsort(ys)[::-1][:n]\n    order = np.sort(order)\n    print(f'--- region {lo}-{hi}: top {n} points ---')\n    for i in order:\n        print(f'{xs[i]:9.2f} {ys[i]:10.3f}')\nregion(1150,1500)\nregion(1500,1750)\nregion(2550,2850)\nEOF\npython3 /app/explore.py\n"]
