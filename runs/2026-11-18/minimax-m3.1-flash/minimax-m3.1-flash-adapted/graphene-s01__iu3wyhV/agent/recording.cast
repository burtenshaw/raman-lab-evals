[328.14594, "i", "cat > /app/fit_peaks.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Fit single Lorentzians + constant offset to the D, G and 2D Raman peaks.\"\"\"\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nDATA = '/app/spectrum.csv'\nOUT = '/app/results.json'\n\n# fitting windows (cm^-1) chosen around each isolated peak\nWINDOWS = {'D': (1200.0, 1470.0),\n           'G': (1520.0, 1670.0),\n           '2D': (2450.0, 2950.0)}\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndata = np.loadtxt(DATA, delimiter=',', skiprows=1)\nx = data[:, 0]\ny = data[:, 1]\n\nresults = {}\nfor name, (lo, hi) in WINDOWS.items():\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    base = float(np.percentile(ys, 10))\n    i = int(np.argmax(ys))\n    amp0 = float(ys[i] - base)\n    above = np.where(ys >= base + amp0 / 2.0)[0]\n    g0 = float(max((xs[above[-1]] - xs[above[0]]) / 2.0, 2.0)) if above.size > 1 else 15.0\n    p0 = [amp0, g0, float(xs[i]), base]\n    p, _ = curve_fi"]
[328.146077, "i", "t(lorentzian, xs, ys, p0=p0, maxfev=200000)\n    amp, gamma, x0, off = (float(v) for v in p)\n    rms = float(np.sqrt(np.mean((ys - lorentzian(xs, *p))**2)))\n    print(f'{name:3s} window=[{lo},{hi}] amplitude={amp:.3f} gamma={gamma:.3f} x0={x0:.3f} offset={off:.3f} rms={rms:.2f}')\n    results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amp, 'offset': off}\n\nresults['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\nprint('ID/IG = %.6f' % results['ID_IG'])\n\nwith open(OUT, 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\nprint('wrote', OUT)\nEOF\npython3 /app/fit_peaks.py\n"]
[328.146209, "o", "cat > /app/fit_peaks.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.146392, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.146501, "o", "\"\"\"Fit single Lorentzians + constant offset to the D, G and 2D Raman peaks.\"\"\"\r\n\u001b[?2004l\r"]
[328.146604, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.146662, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[328.146727, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.146775, "o", "DATA = '/app/spectrum.csv'\r\n\u001b[?2004l\r"]
[328.146809, "o", "\u001b[?2004h> "]
[328.146856, "o", "OUT = '/app/results.json'\r\n\u001b[?2004l\r"]
[328.14687, "o", "\u001b[?2004h> "]
[328.14692, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.147023, "o", "# fitting windows (cm^-1) chosen around each isolated peak\r\n\u001b[?2004l\r"]
[328.147076, "o", "\u001b[?2004h> "]
[328.147117, "o", "WINDOWS = {'D': (1200.0, 1470.0),\r\n\u001b[?2004l\r"]
[328.147159, "o", "\u001b[?2004h> "]
[328.147254, "o", "           'G': (1520.0, 1670.0),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.147308, "o", "           '2D': (2450.0, 2950.0)}\r\n\u001b[?2004l\r"]
[328.147364, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.147462, "o", "def lorentzian(x, amplitude, gamma, x0, offset):\r\n\u001b[?2004l\r"]
[328.147479, "o", "\u001b[?2004h> "]
[328.147628, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[328.147661, "o", "\u001b[?2004h> "]
[328.147678, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.147733, "o", "> "]
[328.14779, "o", "data = np.loadtxt(DATA, delimiter=',', skiprows=1)\r\n\u001b[?2004l\r"]
[328.147807, "o", "\u001b[?2004h> "]
[328.147897, "o", "x = data[:, 0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.14793, "o", "y = data[:, 1]\r\n\u001b[?2004l\r"]
[328.147944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[328.14796, "o", "\u001b[?2004h> "]
[328.148027, "o", "results = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.148107, "o", "for name, (lo, hi) in WINDOWS.items():\r\n\u001b[?2004l\r"]
[328.148122, "o", "\u001b[?2004h> "]
[328.148189, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[328.148206, "o", "\u001b[?2004h"]
[328.148216, "o", "> "]
[328.148265, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r"]
[328.148339, "o", "\u001b[?2004h> "]
[328.148403, "o", "    base = float(np.percentile(ys, 10))\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.148443, "o", "> "]
[328.148459, "o", "    i = int(np.argmax(ys))\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.148474, "o", "> "]
[328.148545, "o", "    amp0 = float(ys[i] - base)\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.148559, "o", "> "]
[328.148656, "o", "    above = np.where(ys >= base + amp0 / 2.0)[0]\r\n\u001b[?2004l\r"]
[328.148677, "o", "\u001b[?2004h> "]
[328.148847, "o", "    g0 = float(max((xs[above[-1]] - xs[above[0]]) / 2.0, 2.0)) if above.size > 1 else 15.0\r\n\u001b[?2004l\r"]
[328.148898, "o", "\u001b[?2004h> "]
[328.148965, "o", "    p0 = [amp0, g0, float(xs[i]), base]\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.149031, "o", "> "]
[328.149104, "o", "    p, _ = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r"]
[328.149136, "o", "\u001b[?2004h> "]
[328.149231, "o", "    amp, gamma, x0, off = (float(v) for v in p)\r\n\u001b[?2004l\r"]
[328.149271, "o", "\u001b[?2004h> "]
[328.149382, "o", "    rms = float(np.sqrt(np.mean((ys - lorentzian(xs, *p))**2)))\r\n\u001b[?2004l\r"]
[328.149426, "o", "\u001b[?2004h> "]
[328.14964, "o", "    print(f'{name:3s} window=[{lo},{hi}] amplitude={amp:.3f} gamma={gamma:.3f} x0={x0:.3f} offset={off:.3f} rms={rms:.2f}')\r\n\u001b[?2004l\r"]
[328.149694, "o", "\u001b[?2004h> "]
[328.149815, "o", "    results[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amp, 'offset': off}\r\n\u001b[?2004l\r"]
[328.149868, "o", "\u001b[?2004h"]
[328.149883, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.150027, "o", "results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']\r\n\u001b[?2004l\r"]
[328.150038, "o", "\u001b[?2004h> "]
[328.150138, "o", "print('ID/IG = %.6f' % results['ID_IG'])\r\n\u001b[?2004l\r"]
[328.150177, "o", "\u001b[?2004h> "]
[328.150262, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.150299, "o", "> with open(OUT, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.150381, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[328.150423, "o", "\u001b[?2004h> "]
