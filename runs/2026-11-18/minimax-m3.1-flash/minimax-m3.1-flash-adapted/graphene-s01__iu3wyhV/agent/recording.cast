[257.551259, "i", "cat > /app/scan.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)\nx=d[:,0]; y=d[:,1]\ndef model(x,a,g,x0,off):\n    return a*g**2/((x-x0)**2+g**2)+off\ndef fit(lo,hi):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    base=np.percentile(ys,10); i=np.argmax(ys); amp0=ys[i]-base\n    idx=np.where(ys>=base+amp0/2)[0]\n    g0=max((xs[idx[-1]]-xs[idx[0]])/2,2.0)\n    p,_=curve_fit(model,xs,ys,p0=[amp0,g0,xs[i],base],maxfev=200000)\n    r=ys-model(xs,*p)\n    return p, np.sqrt(np.mean(r**2))\nfor lo in (1150,1180,1200,1220,1240):\n    for hi in (1440,1460,1470,1480,1500):\n        p,rms=fit(lo,hi)\n        print(f'D {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\nprint()\nfor lo in (1490,1510,1520,1540):\n    for hi in (1650,1670,1690,1720):\n        p,rms=fit(lo,hi)\n        print(f'G {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\nprint()\nfor lo in (2350,2400,2450,2500,2550):\n    for"]
[257.551374, "i", " hi in (2850,2900,2950,3000):\n        p,rms=fit(lo,hi)\n        print(f'2D {lo}-{hi}: a={p[0]:9.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\nEOF\npython3 /app/scan.py\n"]
[257.551441, "o", "cat > /app/scan.py << 'EOF'\r\n\u001b[?2004l\r"]
[257.551495, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.55153, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.551624, "o", "d=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)\r\n\u001b[?2004l\r"]
[257.551644, "o", "\u001b[?2004h> "]
[257.551664, "o", "x=d[:,0]; y=d[:,1]\r\n\u001b[?2004l\r"]
[257.551695, "o", "\u001b[?2004h> "]
[257.551728, "o", "def model(x,a,g,x0,off):\r\n"]
[257.551761, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[257.551803, "o", "    return a*g**2/((x-x0)**2+g**2)+off\r\n\u001b[?2004l\r"]
[257.551862, "o", "\u001b[?2004h> "]
[257.551901, "o", "def fit(lo,hi):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.551936, "o", "    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.551972, "o", "> "]
[257.552036, "o", "    base=np.percentile(ys,10); i=np.argmax(ys); amp0=ys[i]-base\r\n\u001b[?2004l\r"]
[257.552055, "o", "\u001b[?2004h> "]
[257.552101, "o", "    idx=np.where(ys>=base+amp0/2)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.552168, "o", "    g0=max((xs[idx[-1]]-xs[idx[0]])/2,2.0)\r\n\u001b[?2004l\r"]
[257.552186, "o", "\u001b[?2004h> "]
[257.552272, "o", "    p,_=curve_fit(model,xs,ys,p0=[amp0,g0,xs[i],base],maxfev=200000)\r\n\u001b[?2004l\r"]
[257.552291, "o", "\u001b[?2004h> "]
[257.552338, "o", "    r=ys-model(xs,*p)\r\n\u001b[?2004l\r"]
[257.552374, "o", "\u001b[?2004h> "]
[257.552405, "o", "    return p, np.sqrt(np.mean(r**2))\r\n\u001b[?2004l\r"]
[257.552423, "o", "\u001b[?2004h> "]
[257.552474, "o", "for lo in (1150,1180,1200,1220,1240):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.552536, "o", "    for hi in (1440,1460,1470,1480,1500):\r\n\u001b[?2004l\r"]
[257.552554, "o", "\u001b[?2004h> "]
[257.552581, "o", "        p,rms=fit(lo,hi)\r\n\u001b[?2004l\r"]
[257.552619, "o", "\u001b[?2004h> "]
[257.552726, "o", "        print(f'D {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\r\n\u001b[?2004l\r"]
[257.552761, "o", "\u001b[?2004h> "]
[257.552793, "o", "print()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.55283, "o", "for lo in (1490,1510,1520,1540):\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.552866, "o", "> "]
[257.552893, "o", "    for hi in (1650,1670,1690,1720):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.552929, "o", "        p,rms=fit(lo,hi)\r\n\u001b[?2004l\r"]
[257.552963, "o", "\u001b[?2004h> "]
[257.553054, "o", "        print(f'G {lo}-{hi}: a={p[0]:8.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\r\n\u001b[?2004l\r"]
[257.553086, "o", "\u001b[?2004h> print()"]
[257.553123, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.55315, "o", "for lo in (2350,2400,2450,2500,2550):\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.553181, "o", "> "]
[257.553212, "o", "    for hi in (2850,2900,2950,3000):\r\n\u001b[?2004l\r"]
[257.553244, "o", "\u001b[?2004h> "]
[257.553274, "o", "        p,rms=fit(lo,hi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.553311, "o", "> "]
[257.553407, "o", "        print(f'2D {lo}-{hi}: a={p[0]:9.2f} g={p[1]:6.3f} x0={p[2]:8.3f} off={p[3]:8.2f} rms={rms:6.2f}')\r\n\u001b[?2004l\r"]
[257.553426, "o", "\u001b[?2004h> EOF"]
[257.553442, "o", "\r\n\u001b[?2004l\r"]
