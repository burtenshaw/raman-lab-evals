[222.497167, "i", "cat > /app/diag2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lor(x,a,g,x0):\n    return a*g**2/((x-x0)**2+g**2)\n\ndef make(bgdeg):\n    def f(x,a1,g1,x1,a2,g2,x2,a3,g3,x3,*b):\n        out = lor(x,a1,g1,x1)+lor(x,a2,g2,x2)+lor(x,a3,g3,x3)\n        B = np.zeros_like(x)\n        for i,c in enumerate(b):\n            B = B + c*(x-2000.0)**i/1000.0**i\n        return out + B\n    return f\n\np0=[345,19,1352, 6929,8,1581, 14099,27,2695]\nfor deg in (0,1,2):\n    f = make(deg)\n    pp = p0 + [1250,0.0,0.0][:deg+1]\n    try:\n        p,cov = curve_fit(f,x,y,p0=pp,maxfev=600000)\n        r=y-f(x,*p)\n        print(f'deg={deg} rms={np.sqrt(np.mean(r**2)):.2f} D a={p[0]:.2f} g={p[1]:.2f} x0={p[2]:.2f} | G a={p[3]:.2f} g={p[4]:.3f} x0={p[5]:.3f} | 2D a={p[6]:.2f} g={p[7]:.2f} x0={p[8]:.2f} bg={np.round(p[9:],3)}')\n    except Exception as e:\n        print('deg',deg,'failed',e)\n\n# D region with linear background, and D region"]
[222.497309, "i", " with G tail included\ndef m_d(x,a,g,x0,c0,c1):\n    return lor(x,a,g,x0)+c0+c1*(x-1300.0)/100.0\nfor lo,hi in [(1150,1500),(1200,1480)]:\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,_=curve_fit(m_d,xs,ys,p0=[345,19,1352,1285,0],maxfev=200000)\n    print(f'D+linear ({lo},{hi}): a={p[0]:.2f} g={p[1]:.3f} x0={p[2]:.3f} c0={p[3]:.2f} c1={p[4]:.3f}')\nEOF\npython3 /app/diag2.py\n"]
