[?2004l[?2004h>     k = max(1, len(xx)//10)
[?2004l[?2004h>     base = np.median(np.concatenate([yy[:k], yy[-k:]]))
[?2004l[?2004h>     i = np.argmax(yy)
[?2004l[?2004h>     amp0 = max(yy[i]-base, 1.0)
[?2004l[?2004h>     x00 = xx[i]
[?2004l[?2004h>     half = base + amp0/2
[?2004l[?2004h>     idx = np.where(yy >= half)[0]
[?2004l[?2004h>     gamma0 = max((xx[idx[-1]]-xx[idx[0]])/2.0, 5.0)
[?2004l[?2004h>     p0 = [amp0, gamma0, x00, base] + list(extra)
[?2004l[?2004h>     if model is lor:
