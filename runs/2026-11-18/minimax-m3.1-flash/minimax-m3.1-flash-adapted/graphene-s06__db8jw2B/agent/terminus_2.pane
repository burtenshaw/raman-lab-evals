[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x, y = d[:,0], d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, gamma, x0, offset):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def do_fit(lo, hi, expect):
[?2004l[?2004h>     m = (x>=lo)&(x<=hi)
[?2004l[?2004h>     xx, yy = x[m], y[m]
[?2004l[?2004h>     # rough baseline from 10% edges
[?2004l[?2004h>     k = max(1, len(xx)//10)
[?2004l[?2004h>     base = np.median(np.concatenate([yy[:k], yy[-k:]]))
[?2004l[?2004h>     i = np.argmax(yy)
[?2004l[?2004h>     amp0 = max(yy[i]-base, 1.0)
[?2004l[?2004h>     x00 = xx[i]
[?2004l[?2004h>     half = base + amp0/2
[?2004l[?2004h>     idx = np.where(yy >= half)[0]
[?2004l[?2004h>     gamma0 = max((xx[idx[-1]]-xx[idx[0]])/2.0, 5.0) if len(idx) > 1 else 20.0
[?2004l[?2004h>     p0 = [amp0, gamma0, x00, base]
[?2004l[?2004h>     bounds = ([0, 0.5, lo-50, -np.inf],[np.inf, 400, hi+50, np.inf])
[?2004l[?2004h>     p, cov = curve_fit(lor, xx, yy, p0=p0, bounds=bounds, maxfev=200000)
[?2004l[?2004h>     amp, gamma, x0, off = p
[?2004l[?2004h>     resid = yy - lor(xx,*p)
[?2004l[?2004h>     rms = np.sqrt(np.mean(resid**2))
[?2004l[?2004h>     return dict(x0=x0, gamma=gamma, amplitude=amp, offset=off, rms=rms,
[?2004l[?2004h>                 p0=p0, perr=np.sqrt(np.diag(cov)), n=int(m.sum()))
[?2004l[?2004h> 
[?2004l[?2004h> windows = {
[?2004l[?2004h>  'D': [(1200,1500),(1230,1470),(1250,1450),(1200,1450),(1280,1420),(1250,1480)],
[?2004l[?2004h>  'G': [(1480,1700),(1450,1750),(1500,1680),(1500,1700),(1470,1720)],
[?2004l[?2004h>  '2D':[(2550,2850),(2500,2900),(2580,2820),(2600,2800),(2520,2880)],
[?2004l[?2004h> }
[?2004l[?2004h> res={}
[?2004l[?2004h> for peak, lst in windows.items():
[?2004l[?2004h>     print('===', peak)
[?2004l[?2004h>     for (lo,hi) in lst:
[?2004l[?2004h>         r = do_fit(lo,hi,None)
[?2004l[?2004h>         print(f"{lo}-{hi}: x0={r['x0']:.3f} gamma={r['gamma']:.3f} amp={r['amplitude']:.2f} off={r['offset']:.2f} rms={r['rms']:.2f} n={r['n']}")
