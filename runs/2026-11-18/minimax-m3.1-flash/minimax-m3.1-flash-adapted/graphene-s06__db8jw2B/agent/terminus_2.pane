[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, gamma, x0, offset):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def lorbg(x, amp, gamma, x0, offset, slope):
