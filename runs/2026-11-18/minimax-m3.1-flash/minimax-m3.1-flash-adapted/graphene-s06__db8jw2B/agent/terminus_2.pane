[?2004l[?2004h>     else:
[?2004l[?2004h>         bounds = ([0,0.5,lo-50,-np.inf,-np.inf],[np.inf,400,hi+50,np.inf,np.inf])
[?2004l[?2004h>     p, cov = curve_fit(model, xx, yy, p0=p0, bounds=bounds, maxfev=200000)
[?2004l[?2004h>     rms = np.sqrt(np.mean((yy - model(xx,*p))**2))
[?2004l[?2004h>     return p, rms, np.sqrt(np.diag(cov))
