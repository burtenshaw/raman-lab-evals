[82.798872, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, amp, gamma, x0, offset):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset\n\ndef fit(lo, hi, guess):\n    m = (x>=lo)&(x<=hi)\n    xx, yy = x[m], y[m]\n    p0 = [guess[1], guess[2], guess[0], guess[3]]  # amp,gamma,x0,offset\n    p, cov = curve_fit(lor, xx, yy, p0=p0, maxfev=200000)\n    amp, gamma, x0, off = p\n    resid = yy - lor(xx,*p)\n    rms = np.sqrt(np.mean(resid**2))\n    perr = np.sqrt(np.diag(cov))\n    return dict(x0=x0, gamma=gamma, amplitude=amp, offset=off, rms=rms, perr=perr, n=m.sum())\n\ncases = {\n 'D': [(1200,1500,1350), (1250,1450,1350), (1220,1520,1350), (1200,1450,1350), (1250,1500,1350), (1150,1550,1350)],\n 'G': [(1450,1750,1580), (1480,1700,1580), (1500,1700,1580), (1450,1700,1580), (1500,1750,1580), (1420,1780,1580)],\n '2D':[(2500,2900,2690), (2550,2850,2690), (2450,2950,2690), (2500,2850,2690), (2550,2900,2690)"]
[82.79891, "i", ", (2400,3000,2690)],\n}\nfor peak, lst in cases.items():\n    print('===', peak)\n    for (lo,hi,g) in lst:\n        amp0 = 5000 if peak=='D' else (10000 if peak=='G' else 20000)\n        r = fit(lo,hi,(g, 30.0, amp0, 900.0))\n        print(f\"{lo}-{hi}: x0={r['x0']:.3f} gamma={r['gamma']:.3f} amp={r['amplitude']:.2f} off={r['offset']:.2f} rms={r['rms']:.2f} n={r['n']} perr={np.round(r['perr'],3)}\")\nEOF\npython3 /app/fit.py\n"]
[82.79903, "o", "cat > /app/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
