[125.826252, "o", "G: x0=1579.5663 gamma=9.9592 amp=8864.090 off=900.741 rms=45.690 perr=[11.6426  0.0219  0.013   3.1897]\r\n"]
[125.828487, "o", "2D: x0=2693.4204 gamma=29.0384 amp=18462.282 off=1003.356 rms=49.456 perr=[8.4748 0.0288 0.0116 6.8042]\r\nID_IG = "]
[125.828528, "o", "0.5481097062678424\r\n--- with linear background (amplitude check) ---\r\n"]
[125.830948, "o", "D: x0=1346.6617 gamma=15.1583 amp=4859.949 off=881.282 slope=0.36345 rms=48.659\r\n"]
[125.833099, "o", "G: x0=1579.5716 gamma=9.9589 amp=8864.071 off=924.858 slope=-0.13388 rms=45.040\r\n"]
[125.83543, "o", "2D: x0=2693.4156 gamma=29.0367 amp=18461.834 off=951.782 slope=0.04035 rms=49.412\r\n"]
[125.835551, "o", "noise std (diff/1.414) flat region: "]
[125.835569, "o", "49.18235712990634"]
[125.83559, "o", "\r\n"]
[125.889285, "o", "\u001b[?2004hroot@j-openenv-6afd8cc529e8b7ccfbbb8354-0sfgre5f-e64d3-gchtg:/app# "]
[148.753739, "i", "cat > /app/run_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:, 0], data[:, 1]\n\ndef lorentzian(x, amplitude, gamma, x0, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xx, yy = x[m], y[m]\n    k = max(1, len(xx) // 10)\n    base = float(np.median(np.concatenate([yy[:k], yy[-k:]])))\n    i = int(np.argmax(yy))\n    amp0 = max(float(yy[i] - base), 1.0)\n    x00 = float(xx[i])\n    half = base + amp0 / 2.0\n    idx = np.where(yy >= half)[0]\n    gamma0 = max(float((xx[idx[-1]] - xx[idx[0]]) / 2.0), 5.0)\n    p0 = [amp0, gamma0, x00, base]\n    bounds = ([0.0, 0.5, lo - 50.0, -np.inf], [np.inf, 400.0, hi + 50.0, np.inf])\n    p, _ = curve_fit(lorentzian, xx, yy, p0=p0, bounds=bounds, maxfev=200000)\n    amp, gamma, x0, off = p\n    rms = float(np.sqrt(np.mean((yy - lorentzian(xx, *p))**2)))\n    print(f\"window {lo}-{hi}: x0={x0"]
[148.753852, "i", ":.4f} gamma={gamma:.4f} amp={amp:.3f} offset={off:.3f} rms={rms:.2f}\")\n    return {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amp), 'offset': float(off)}\n\nD = fit_peak(1250.0, 1450.0)\nG = fit_peak(1480.0, 1680.0)\nD2 = fit_peak(2590.0, 2790.0)\n\nresults = {\n    'D': D,\n    'G': G,\n    '2D': D2,\n    'ID_IG': D['amplitude'] / G['amplitude'],\n}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/run_fit.py\n"]
[148.753907, "o", "cat > /app/run_fit.py << 'EOF'\r\n\u001b[?2004l\r"]
[148.753954, "o", "\u001b[?2004h> "]
[148.753999, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.75403, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[148.754067, "o", "\u001b[?2004h> "]
[148.754104, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[148.75414, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.754205, "o", "data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r"]
[148.754231, "o", "\u001b[?2004h> "]
[148.754262, "o", "x, y = data[:, 0], data[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.754308, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.75435, "o", "def lorentzian(x, amplitude, gamma, x0, offset):\r\n\u001b[?2004l\r"]
[148.754362, "o", "\u001b[?2004h> "]
[148.754451, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[148.754476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.754506, "o", "\u001b[?2004h> "]
[148.754545, "o", "def fit_peak(lo, hi):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.754583, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[148.754615, "o", "\u001b[?2004h> "]
[148.754644, "o", "    xx, yy = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.754699, "o", "    k = max(1, len(xx) // 10)\r\n\u001b[?2004l\r"]
[148.754721, "o", "\u001b[?2004h> "]
[148.754786, "o", "    base = float(np.median(np.concatenate([yy[:k], yy[-k:]])))\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.754812, "o", "> "]
[148.754848, "o", "    i = int(np.argmax(yy))\r\n\u001b[?2004l\r"]
[148.75487, "o", "\u001b[?2004h> "]
[148.7549, "o", "    amp0 = max(float(yy[i] - base), 1.0)\r\n\u001b[?2004l\r"]
[148.754921, "o", "\u001b[?2004h> "]
[148.754952, "o", "    x00 = float(xx[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.754979, "o", "> "]
[148.755, "o", "    half = base + amp0 / 2.0\r\n\u001b[?2004l\r"]
[148.755024, "o", "\u001b[?2004h> "]
[148.755064, "o", "    idx = np.where(yy >= half)[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.755095, "o", "> "]
[148.755157, "o", "    gamma0 = max(float((xx[idx[-1]] - xx[idx[0]]) / 2.0), 5.0)\r\n\u001b[?2004l\r"]
[148.75518, "o", "\u001b[?2004h> "]
[148.755219, "o", "    p0 = [amp0, gamma0, x00, base]\r\n\u001b[?2004l\r"]
[148.755248, "o", "\u001b[?2004h> "]
[148.75533, "o", "    bounds = ([0.0, 0.5, lo - 50.0, -np.inf], [np.inf, 400.0, hi + 50.0, np.inf])\r\n\u001b[?2004l\r"]
[148.755353, "o", "\u001b[?2004h> "]
[148.755436, "o", "    p, _ = curve_fit(lorentzian, xx, yy, p0=p0, bounds=bounds, maxfev=200000)\r\n\u001b[?2004l\r"]
[148.755468, "o", "\u001b[?2004h> "]
[148.755501, "o", "    amp, gamma, x0, off = p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.755612, "o", "    rms = float(np.sqrt(np.mean((yy - lorentzian(xx, *p))**2)))\r\n\u001b[?2004l\r"]
[148.75564, "o", "\u001b[?2004h> "]
[148.755754, "o", "    print(f\"window {lo}-{hi}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} offset={off:.3f} rms={rms:.2f}\")\r\n\u001b[?2004l\r"]
[148.755779, "o", "\u001b[?2004h> "]
[148.755888, "o", "    return {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amp), 'offset': float(off)}\r\n\u001b[?2004l\r"]
[148.755912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.755935, "o", "\u001b[?2004h> "]
[148.755963, "o", "D = fit_peak(1250.0, 1450.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.755987, "o", "> "]
[148.75601, "o", "G = fit_peak(1480.0, 1680.0)\r\n\u001b[?2004l\r"]
[148.756027, "o", "\u001b[?2004h> "]
[148.756063, "o", "D2 = fit_peak(2590.0, 2790.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.756089, "o", "> \r\n\u001b[?2004l\r"]
[148.756118, "o", "\u001b[?2004h> results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.756148, "o", "    'D': D,\r\n\u001b[?2004l\r"]
[148.756177, "o", "\u001b[?2004h> "]
[148.756206, "o", "    'G': G,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.75623, "o", "    '2D': D2,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.756284, "o", "    'ID_IG': D['amplitude'] / G['amplitude'],\r\n\u001b[?2004l\r"]
[148.756324, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[148.756351, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.756386, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[148.756411, "o", "\u001b[?2004h> "]
[148.756448, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[148.756473, "o", "\u001b[?2004h> "]
