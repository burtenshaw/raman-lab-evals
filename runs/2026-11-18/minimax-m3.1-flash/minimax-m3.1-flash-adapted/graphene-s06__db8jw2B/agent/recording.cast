[82.801782, "o", "        print(f\"{lo}-{hi}: x0={r['x0']:.3f} gamma={r['gamma']:.3f} amp={r['amplitude']:.2f} off={r['offset']:.2f} rms={r['rms']:.2f} n={r['n']} perr={np.round(r['perr'],3)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.801808, "o", "> EOF\r\n\u001b[?2004l\r"]
