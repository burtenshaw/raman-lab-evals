[101.457759, "i", "cat > /app/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, amp, gamma, x0, offset):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset\n\ndef do_fit(lo, hi, expect):\n    m = (x>=lo)&(x<=hi)\n    xx, yy = x[m], y[m]\n    # rough baseline from 10% edges\n    k = max(1, len(xx)//10)\n    base = np.median(np.concatenate([yy[:k], yy[-k:]]))\n    i = np.argmax(yy)\n    amp0 = max(yy[i]-base, 1.0)\n    x00 = xx[i]\n    half = base + amp0/2\n    idx = np.where(yy >= half)[0]\n    gamma0 = max((xx[idx[-1]]-xx[idx[0]])/2.0, 5.0) if len(idx) > 1 else 20.0\n    p0 = [amp0, gamma0, x00, base]\n    bounds = ([0, 0.5, lo-50, -np.inf],[np.inf, 400, hi+50, np.inf])\n    p, cov = curve_fit(lor, xx, yy, p0=p0, bounds=bounds, maxfev=200000)\n    amp, gamma, x0, off = p\n    resid = yy - lor(xx,*p)\n    rms = np.sqrt(np.mean(resid**2))\n    return dict(x0=x0, gamma=gamma, amplitude=amp, offset=off, rms=rms,\n               "]
[101.457882, "i", " p0=p0, perr=np.sqrt(np.diag(cov)), n=int(m.sum()))\n\nwindows = {\n 'D': [(1200,1500),(1230,1470),(1250,1450),(1200,1450),(1280,1420),(1250,1480)],\n 'G': [(1480,1700),(1450,1750),(1500,1680),(1500,1700),(1470,1720)],\n '2D':[(2550,2850),(2500,2900),(2580,2820),(2600,2800),(2520,2880)],\n}\nres={}\nfor peak, lst in windows.items():\n    print('===', peak)\n    for (lo,hi) in lst:\n        r = do_fit(lo,hi,None)\n        print(f\"{lo}-{hi}: x0={r['x0']:.3f} gamma={r['gamma']:.3f} amp={r['amplitude']:.2f} off={r['offset']:.2f} rms={r['rms']:.2f} n={r['n']}\")\nEOF\npython3 /app/fit2.py\n"]
