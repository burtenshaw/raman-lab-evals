[125.201374, "i", "cat > /app/fit3.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, amp, gamma, x0, offset):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset\n\ndef lorbg(x, amp, gamma, x0, offset, slope):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset + slope*(x-1400)\n\ndef do_fit(lo, hi, model=lor, extra=()):\n    m = (x>=lo)&(x<=hi)\n    xx, yy = x[m], y[m]\n    k = max(1, len(xx)//10)\n    base = np.median(np.concatenate([yy[:k], yy[-k:]]))\n    i = np.argmax(yy)\n    amp0 = max(yy[i]-base, 1.0)\n    x00 = xx[i]\n    half = base + amp0/2\n    idx = np.where(yy >= half)[0]\n    gamma0 = max((xx[idx[-1]]-xx[idx[0]])/2.0, 5.0)\n    p0 = [amp0, gamma0, x00, base] + list(extra)\n    if model is lor:\n        bounds = ([0,0.5,lo-50,-np.inf],[np.inf,400,hi+50,np.inf])\n    else:\n        bounds = ([0,0.5,lo-50,-np.inf,-np.inf],[np.inf,400,hi+50,np.inf,np.inf])\n    p, cov = curve_fit(model, xx, yy, p0=p0, bounds=bounds"]
[125.201523, "i", ", maxfev=200000)\n    rms = np.sqrt(np.mean((yy - model(xx,*p))**2))\n    return p, rms, np.sqrt(np.diag(cov))\n\nwins = {'D':(1250,1450), 'G':(1480,1680), '2D':(2590,2790)}\nprint('--- constant offset model (final windows) ---')\nout={}\nfor k,(lo,hi) in wins.items():\n    p,rms,perr = do_fit(lo,hi)\n    amp,gamma,x0,off = p\n    out[k]=(x0,gamma,amp,off)\n    print(f\"{k}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} off={off:.3f} rms={rms:.3f} perr={np.round(perr,4)}\")\nprint('ID_IG =', out['D'][2]/out['G'][2])\n\nprint('--- with linear background (amplitude check) ---')\nfor k,(lo,hi) in wins.items():\n    p,rms,perr = do_fit(lo,hi,lorbg,(0.0,))\n    amp,gamma,x0,off,slope = p\n    print(f\"{k}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} off={off:.3f} slope={slope:.5f} rms={rms:.3f}\")\n\n# noise estimate from flat region\nm = (x>1800)&(x<2400)\nprint('noise std (diff/1.414) flat region:', np.std(np.diff(y[m]))/np.sqrt(2))\nEOF\npython3 /app/fit3.py\n"]
[125.201563, "o", "cat > /app/fit3.py << 'EOF'\r\n\u001b[?2004l\r"]
[125.201619, "o", "\u001b[?2004h> "]
[125.201657, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.201693, "o", "> "]
[125.201735, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.201777, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.201832, "o", "d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.201865, "o", "> "]
[125.201912, "o", "x, y = d[:,0], d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.201958, "o", "> "]
[125.201991, "o", "def lor(x, amp, gamma, x0, offset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.202049, "o", "    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.202087, "o", "> \r\n\u001b[?2004l\r"]
[125.20212, "o", "\u001b[?2004h> "]
[125.202161, "o", "def lorbg(x, amp, gamma, x0, offset, slope):\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.202207, "o", "> "]
[125.202239, "o", "    return amp*gamma**2/((x-x0)**2 + gamma**2) + offset + slope*(x-1400)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.202281, "o", "> \r\n\u001b[?2004l\r"]
[125.202322, "o", "\u001b[?2004h> "]
[125.202356, "o", "def do_fit(lo, hi, model=lor, extra=()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.202398, "o", "    m = (x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[125.202439, "o", "\u001b[?2004h> "]
[125.202476, "o", "    xx, yy = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.202522, "o", "    k = max(1, len(xx)//10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.202572, "o", "    base = np.median(np.concatenate([yy[:k], yy[-k:]]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.202607, "o", "    i = np.argmax(yy)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.202648, "o", "> "]
[125.202681, "o", "    amp0 = max(yy[i]-base, 1.0)\r\n\u001b[?2004l\r"]
[125.202718, "o", "\u001b[?2004h> "]
[125.202747, "o", "    x00 = xx[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.202781, "o", "    half = base + amp0/2\r\n\u001b[?2004l\r"]
[125.202822, "o", "\u001b[?2004h> "]
[125.202863, "o", "    idx = np.where(yy >= half)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.202908, "o", "    gamma0 = max((xx[idx[-1]]-xx[idx[0]])/2.0, 5.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.202953, "o", "> "]
[125.202982, "o", "    p0 = [amp0, gamma0, x00, base] + list(extra)\r\n\u001b[?2004l\r"]
[125.203024, "o", "\u001b[?2004h> "]
[125.203065, "o", "    if model is lor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.20313, "o", "        bounds = ([0,0.5,lo-50,-np.inf],[np.inf,400,hi+50,np.inf])\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.203171, "o", "> "]
[125.20321, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.20327, "o", "        bounds = ([0,0.5,lo-50,-np.inf,-np.inf],[np.inf,400,hi+50,np.inf,np.inf])\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.203309, "o", "> "]
[125.203377, "o", "    p, cov = curve_fit(model, xx, yy, p0=p0, bounds=bounds, maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.20341, "o", "> "]
[125.203457, "o", "    rms = np.sqrt(np.mean((yy - model(xx,*p))**2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.203497, "o", "> "]
[125.203537, "o", "    return p, rms, np.sqrt(np.diag(cov))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.203578, "o", "\u001b[?2004h> "]
[125.20363, "o", "wins = {'D':(1250,1450), 'G':(1480,1680), '2D':(2590,2790)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.203672, "o", "> "]
[125.203713, "o", "print('--- constant offset model (final windows) ---')\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.203755, "o", "> out={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.203799, "o", "for k,(lo,hi) in wins.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.203838, "o", "> "]
[125.20388, "o", "    p,rms,perr = do_fit(lo,hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.203921, "o", "    amp,gamma,x0,off = p"]
[125.20396, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.204005, "o", "    out[k]=(x0,gamma,amp,off)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.204113, "o", "    print(f\"{k}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} off={off:.3f} rms={rms:.3f} perr={np.round(perr,4)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.204145, "o", "> "]
[125.204182, "o", "print('ID_IG =', out['D'][2]/out['G'][2])\r\n\u001b[?2004l\r"]
[125.204214, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.204252, "o", "\u001b[?2004h> "]
[125.204295, "o", "print('--- with linear background (amplitude check) ---')\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.204327, "o", "> "]
[125.20436, "o", "for k,(lo,hi) in wins.items():\r\n\u001b[?2004l\r"]
[125.204391, "o", "\u001b[?2004h> "]
[125.204424, "o", "    p,rms,perr = do_fit(lo,hi,lorbg,(0.0,))\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.204465, "o", "> "]
[125.204488, "o", "    amp,gamma,x0,off,slope = p\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.20452, "o", "> "]
[125.204623, "o", "    print(f\"{k}: x0={x0:.4f} gamma={gamma:.4f} amp={amp:.3f} off={off:.3f} slope={slope:.5f} rms={rms:.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.204654, "o", "> \r\n\u001b[?2004l\r"]
[125.204687, "o", "\u001b[?2004h> "]
[125.20472, "o", "# noise estimate from flat region\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.204749, "o", "> m = (x>1800)&(x<2400)\r\n\u001b[?2004l\r"]
[125.204782, "o", "\u001b[?2004h> "]
[125.20486, "o", "print('noise std (diff/1.414) flat region:', np.std(np.diff(y[m]))/np.sqrt(2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.204892, "o", "> EOF\r\n\u001b[?2004l\r"]
[125.206079, "o", "\u001b[?2004hroot@j-openenv-6afd8cc529e8b7ccfbbb8354-0sfgre5f-e64d3-gchtg:/app# "]
[125.206117, "o", "python3 /app/fit3.py\r\n\u001b[?2004l\r"]
