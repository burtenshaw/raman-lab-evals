python3 /app/fit_compare.py
[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.array(data['raman_shift_cm1'])
[?2004l[?2004h> y = np.array(data['intensity'])
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, A, x0, g, off):
[?2004l[?2004h>     return A * g**2 / ((x - x0)**2 + g**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def multi(x, A1, x01, g1, A2, x02, g2, A3, x03, g3, off):
[?2004l[?2004h>     return (lor(x, A1, x01, g1, 0) + lor(x, A2, x02, g2, 0) + lor(x, A3, x03, g3, 0) + off)
[?2004l[?2004h> 
[?2004l[?2004h> p0 = [4800, 1347, 30, 8900, 1579, 20, 18500, 2694, 57, 1000]
[?2004l[?2004h> popt, pcov = curve_fit(multi, x, y, p0=p0, maxfev=200000)
