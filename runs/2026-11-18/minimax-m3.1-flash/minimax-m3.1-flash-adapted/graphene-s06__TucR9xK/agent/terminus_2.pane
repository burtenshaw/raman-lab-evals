# 2D region: two Lorentzians
def m2(x,A1,x1,g1,A2,x2,g2,c):
    return lor(x,A1,x1,g1)+lor(x,A2,x2,g2)+c
m=(x>=2400)&(x<=3000)
try:
    p2,_=curve_fit(m2,x[m],y[m],p0=[18450,2693,29,2000,2693,60,915],maxfev=400000)
    print('2D region two-lorentzian: A1=%.2f x1=%.3f g1=%.3f A2=%.2f x2=%.3f g2=%.3f c=%.2f'%tuple(p2))
except Exception as e:
    print('2D 2L fit failed',e)

# baseline regions far from peaks
for lo,hi in [(1100,1150),(1750,1850),(1900,2000),(2200,2300),(2950,3000)]:
    mm=(x>=lo)&(x<=hi)
    print('baseline %d-%d: mean=%.1f median=%.1f min=%.1f max=%.1f'%(lo,hi,y[mm].mean(),np.median(y[mm]),y[mm].min(),y[mm].max()))
