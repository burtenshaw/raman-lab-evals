[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.array(data['raman_shift_cm1'], dtype=float)
[?2004l[?2004h> y = np.array(data['intensity'], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian_plus_offset(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D':  ((1250.0, 1450.0), (4850.0, 1347.0, 15.0, 880.0)),
