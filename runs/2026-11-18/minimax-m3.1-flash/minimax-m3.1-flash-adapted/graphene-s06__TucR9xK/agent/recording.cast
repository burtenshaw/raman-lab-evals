[77.105907, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1'])\ny = np.array(data['intensity'])\nprint('n =', len(x), 'x range', x.min(), x.max(), 'dx', np.diff(x).mean())\nprint('y min/max/median', y.min(), y.max(), np.median(y))\npeaks, props = find_peaks(y, prominence=50, distance=5)\norder = np.argsort(props['prominences'])[::-1]\nfor i in order[:15]:\n    p = peaks[i]\n    print(f'peak at x={x[p]:.2f} y={y[p]:.1f} prominence={props[\"prominences\"][i]:.1f} width={props[\"widths\"][i]:.2f}')\nfor lo, hi in [(1100,1250),(1250,1450),(1450,1720),(1720,2500),(2500,2900),(2900,3000)]:\n    m = (x>=lo)&(x<=hi)\n    print(f'window {lo}-{hi}: ymin={y[m].min():.1f} ymax={y[m].max():.1f} at x={x[m][np.argmax(y[m])]:.2f}')\nEOF\npython3 /app/explore.py\n"]
