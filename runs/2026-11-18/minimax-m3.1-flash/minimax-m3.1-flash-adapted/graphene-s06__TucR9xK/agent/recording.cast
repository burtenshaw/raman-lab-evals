[437.841325, "i", "cat > /app/fit_final.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1'], dtype=float)\ny = np.array(data['intensity'], dtype=float)\n\ndef lorentzian_plus_offset(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\nwindows = {\n    'D':  ((1250.0, 1450.0), (4850.0, 1347.0, 15.0, 880.0)),\n    'G':  ((1470.0, 1700.0), (8860.0, 1579.6, 10.0, 900.0)),\n    '2D': ((2500.0, 2900.0), (18460.0, 2693.4, 29.0, 1000.0)),\n}\n\nresults = {}\nfor name, ((lo, hi), p0) in windows.items():\n    m = (x >= lo) & (x <= hi)\n    popt, pcov = curve_fit(lorentzian_plus_offset, x[m], y[m], p0=p0, maxfev=200000)\n    perr = np.sqrt(np.diag(pcov))\n    resid = y[m] - lorentzian_plus_offset(x[m], *popt)\n    rms = float(np.sqrt(np.mean(resid**2)))\n    A, x0, g, off = popt\n    results[name] = {'x0': float(x0), 'gamma': float(g), 'amplitude': float(A), 'offset': float"]
[437.841455, "i", "(off)}\n    print('%-3s window %.0f-%.0f  x0=%.4f+-%.4f  gamma=%.4f+-%.4f  A=%.3f+-%.3f  offset=%.3f+-%.3f  rms=%.2f'\n          % (name, lo, hi, x0, perr[1], g, perr[2], A, perr[0], off, perr[3], rms))\n\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\nprint('ID_IG = %.6f' % results['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\npython3 /app/fit_final.py\n"]
[437.841514, "o", "cat > /app/fit_final.py << 'EOF'\r\n\u001b[?2004l\r"]
[437.841602, "o", "(off)}\r\n    print('%-3s window %.0f-%.0f  x0=%.4f+-%.4f  gamma=%.4f+-%.4f  A=%.3f+-%.3f  offset=%.3f+-%.3f  rms=%.2f'\r\n          % (name, lo, hi, x0, perr[1], g, perr[2], A, perr[0], off, perr[3], rms))\r\n\r\nresults['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\r\nprint('ID_IG = %.6f' % results['ID_IG'])\r\n\r\nwith open('/app/results.json', 'w') as f:\r\n    json.dump(results, f, indent=2)\r\nEOF\r\npython3 /app/fit_final.py\r\n\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
