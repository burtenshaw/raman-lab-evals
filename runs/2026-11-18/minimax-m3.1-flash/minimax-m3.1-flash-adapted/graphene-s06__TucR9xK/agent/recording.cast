[369.698084, "o", "\u001b[?2004h> "]
[369.698169, "o", "for lo,hi in [(1450,1720),(1470,1700),(1460,1750),(1480,1700),(1450,1800),(1500,1680)]:\r\n\u001b[?2004l\r"]
[369.698227, "o", "\u001b[?2004h> "]
