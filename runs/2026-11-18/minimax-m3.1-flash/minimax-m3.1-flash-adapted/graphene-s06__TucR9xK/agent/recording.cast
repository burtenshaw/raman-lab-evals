[369.696327, "o", "\u001b[?2004h> "]
[369.696424, "o", "data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[369.696529, "o", "x = np.array(data['raman_shift_cm1']); y = np.array(data['intensity'])\r\n\u001b[?2004l\r"]
[369.696552, "o", "\u001b[?2004h> "]
[369.696637, "o", "def lor(x,A,x0,g,off): return A*g**2/((x-x0)**2+g**2)+off\r\n\u001b[?2004l\r"]
[369.696668, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[369.696697, "o", "\u001b[?2004h> "]
[369.696727, "o", "def fit(lbl, lo, hi, p0):\r\n\u001b[?2004l\r"]
[369.696748, "o", "\u001b[?2004h> "]
[369.696792, "o", "    m=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[369.696829, "o", "\u001b[?2004h> "]
[369.696902, "o", "    p,_=curve_fit(lor,x[m],y[m],p0=p0,maxfev=200000)\r\n\u001b[?2004l\r"]
[369.696943, "o", "\u001b[?2004h> "]
[369.696983, "o", "    r=y[m]-lor(x[m],*p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[369.697126, "o", "    print('  %-16s x0=%9.4f g=%8.4f A=%10.2f off=%8.2f rms=%6.2f' % ('%d-%d'%(lo,hi),p[1],p[2],p[0],p[3],np.sqrt((r**2).mean())))\r\n\u001b[?2004l\r\u001b[?2004h"]
[369.697159, "o", "> "]
[369.697187, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[369.697196, "o", "\u001b[?2004l\r\u001b[?2004h"]
[369.697233, "o", "> "]
