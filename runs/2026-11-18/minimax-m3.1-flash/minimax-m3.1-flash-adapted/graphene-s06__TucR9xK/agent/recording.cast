[283.823662, "o", "   D x0=1346.6744 g=15.1682 A=4863.10\r\n   G x0=1579.5679 g=9.9740 A=8867.53\r\n"]
[283.823786, "o", "   2D x0=2693.4066 g=29.0720 A=18466.78\r\n  broad: A=1078.67 x0=5096.63 g=5811.99  const=72.113\r\n  rms=49.298\r\n"]
[283.824019, "o", "  binned residuals: 1100:-0 1200:-1 1300:-1 1400:+3 1500:+1 1600:-1 1700:+3 1800:+1 1900:-5 2000:+1 2100:+3 2200:-5 2300:-2 2400:+0 2500:+4 2600:+3 2700:-3 2800:-1 2900:+1\r\n"]
[283.869925, "o", "\u001b[?2004hroot@j-openenv-6afd8b2929e8b7ccfbbb8230-uvdzg7h1-a215d-wtzfp:/app# "]
[369.695842, "i", "cat > /app/scan.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1']); y = np.array(data['intensity'])\ndef lor(x,A,x0,g,off): return A*g**2/((x-x0)**2+g**2)+off\n\ndef fit(lbl, lo, hi, p0):\n    m=(x>=lo)&(x<=hi)\n    p,_=curve_fit(lor,x[m],y[m],p0=p0,maxfev=200000)\n    r=y[m]-lor(x[m],*p)\n    print('  %-16s x0=%9.4f g=%8.4f A=%10.2f off=%8.2f rms=%6.2f' % ('%d-%d'%(lo,hi),p[1],p[2],p[0],p[3],np.sqrt((r**2).mean())))\n    return p\n\nprint('D symmetric windows (center 1346.7):')\nfor w in [60,80,100,120,150,170,200,220]:\n    fit('D',1346.7-w,1346.7+w,[4850,1346.7,15,880])\nprint('D asymmetric:')\nfor lo,hi in [(1250,1450),(1200,1460),(1150,1460),(1250,1460),(1250,1480),(1220,1460),(1200,1500)]:\n    fit('D',lo,hi,[4850,1346.7,15,880])\nprint('G symmetric windows (center 1579.6):')\nfor w in [60,80,100,120,150,170,200]:\n    fit('G',1579.6-w,1579.6+w,[8860,1579.6,10,900])\nprint('G asymmetric:')\nfor lo,hi"]
[369.695962, "i", " in [(1450,1720),(1470,1700),(1460,1750),(1480,1700),(1450,1800),(1500,1680)]:\n    fit('G',lo,hi,[8860,1579.6,10,900])\nprint('2D symmetric windows (center 2693.4):')\nfor w in [80,100,120,150,170,200,250,300]:\n    fit('2D',2693.4-w,2693.4+w,[18460,2693.4,29,1000])\nprint('2D asymmetric:')\nfor lo,hi in [(2500,2900),(2450,2950),(2500,3000),(2550,2900),(2400,3000),(2550,2850),(2600,2800)]:\n    fit('2D',lo,hi,[18460,2693.4,29,1000])\nEOF\npython3 /app/scan.py\n"]
[369.696028, "o", "cat > /app/scan.py << 'EOF'\r\n\u001b[?2004l\r"]
[369.696146, "o", "\u001b[?2004h> "]
