[126.507511, "i", "cat > /app/fit_compare.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1'])\ny = np.array(data['intensity'])\n\ndef lor(x, A, x0, g, off):\n    return A * g**2 / ((x - x0)**2 + g**2) + off\n\ndef multi(x, A1, x01, g1, A2, x02, g2, A3, x03, g3, off):\n    return (lor(x, A1, x01, g1, 0) + lor(x, A2, x02, g2, 0) + lor(x, A3, x03, g3, 0) + off)\n\np0 = [4800, 1347, 30, 8900, 1579, 20, 18500, 2694, 57, 1000]\npopt, pcov = curve_fit(multi, x, y, p0=p0, maxfev=200000)\nprint('GLOBAL 3-Lorentzian + offset:')\nfor i, lbl in enumerate(['D', 'G', '2D']):\n    A, x0, g = popt[3*i:3*i+3]\n    print(f'  {lbl}: x0={x0:.4f} gamma={g:.4f} A={A:.2f} offset={popt[9]:.3f}')\nres = y - multi(x, *popt)\nprint('  global residual: rms=%.3f max=%.2f' % (np.sqrt((res**2).mean()), np.abs(res).max()))\nprint('  global ID/IG = %.6f' % (popt[0]/popt[3]))\nprint()\n\nwindows = {\n  'D': [(1250,1450),(1200,1500),(1250,1500),(1200,1550),(127"]
[126.50767, "i", "0,1430)],\n  'G': [(1470,1700),(1450,1720),(1500,1700),(1450,1750),(1500,1680)],\n  '2D': [(2500,2900),(2450,2950),(2550,2900),(2500,3000),(2550,2950)],\n}\ninit = {'D': (4800,1347,30), 'G': (8900,1579,20), '2D': (18500,2694,57)}\nfor lbl, wins in windows.items():\n    print(lbl)\n    for (lo,hi) in wins:\n        m = (x>=lo)&(x<=hi)\n        A0,x00,g0 = init[lbl]\n        try:\n            p,_ = curve_fit(lor, x[m], y[m], p0=[A0,x00,g0,1000], maxfev=200000)\n            r = y[m]-lor(x[m],*p)\n            print(f'  win {lo}-{hi}: x0={p[1]:.3f} g={p[2]:.3f} A={p[0]:.2f} off={p[3]:.2f} rms={np.sqrt((r**2).mean()):.2f} maxres={np.abs(r).max():.1f}')\n        except Exception as e:\n            print('  fail', lo, hi, e)\nEOF\npython3 /app/fit_compare.py\n"]
