[283.187799, "i", "cat > /app/diag2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1']); y = np.array(data['intensity'])\n\ndef lor(x,A,x0,g): return A*g**2/((x-x0)**2+g**2)\ndef pv(x,A,x0,eta,w):\n    L = w/(2*np.pi)/((x-x0)**2+(w/2)**2)   # area-normalized lorentzian\n    G = np.exp(-4*np.log(2)*((x-x0)/w)**2)*np.sqrt(4*np.log(2)/np.pi)/w\n    return A*(eta*L+(1-eta)*G)               # A ~ area\n\nprint('noise in flat bins (std):')\nfor lo,hi in [(1800,1900),(1900,2000),(2000,2100),(2100,2200),(2200,2300),(2300,2400)]:\n    m=(x>=lo)&(x<hi); print('  %d-%d mean=%.1f std=%.1f'%(lo,hi,y[m].mean(),y[m].std()))\n\nprint('linear fit of peak-free region 1750-2400:')\nm=(x>=1750)&(x<=2400)\np=np.polyfit(x[m],y[m],1); print('  slope=%.5f intercept=%.3f'%(p[0],p[1]))\n\nprint('pseudo-Voigt fits (eta=1 pure Lorentzian):')\nfor lbl,(lo,hi),(A0,x00,g0) in [('D',(1250,1450),(4860,1347,15)),('G',(1470,1700),(8860,1579.6,10)),('2D',(25"]
[283.187954, "i", "00,2900),(18465,2693,29))]:\n    mm=(x>=lo)&(x<=hi)\n    def mod(x,A,x0,eta,w): return pv(x,A,x0,eta,w)+950\n    try:\n        pp,_=curve_fit(mod,x[mm],y[mm],p0=[A0*2*g0,x00,1.0,2*g0],maxfev=400000)\n        A,x0,eta,w=pp\n        print('  %s: x0=%.3f eta=%.4f FWHM=%.3f HWHM_L=%.3f area=%.1f height=%.1f'%(lbl,x0,eta,w,w/2,A,A*np.pi*eta/(2*w/2)))\n    except Exception as e:\n        print('  ',lbl,'fail',e)\n\nprint('3 lorentzians + const + broad background lorentzian:')\ndef model(x,A1,x1,g1,A2,x2,g2,A3,x3,g3,Ab,xb,gb,c):\n    return lor(x,A1,x1,g1)+lor(x,A2,x2,g2)+lor(x,A3,x3,g3)+lor(x,Ab,xb,gb)+c\ntry:\n    p0=[4860,1347,15,8860,1579.6,10,18465,2693,29,3000,2050,400,915]\n    pp,_=curve_fit(model,x,y,p0=p0,maxfev=800000)\n    for i,l in enumerate(['D','G','2D']): print('  ',l,'x0=%.4f g=%.4f A=%.2f'%(pp[3*i+1],pp[3*i+2],pp[3*i]))\n    print('  broad: A=%.2f x0=%.2f g=%.2f  const=%.3f'%(pp[9],pp[10],pp[11],pp[12]))\n    r=y-model(x,*pp); print('  rms=%.3f'%np.sqrt((r**2).mean()))\n    edges=np.arange(1100,3001,100)\n    print('"]
[283.188061, "o", "cat > /app/diag2.py << 'EOF'\r\n\u001b[?2004l\r00,2900),(18465,2693,29))]:\r\n    mm=(x>=lo)&(x<=hi)\r\n    def mod(x,A,x0,eta,w): return pv(x,A,x0,eta,w)+950\r\n    try:\r\n        pp,_=curve_fit(mod,x[mm],y[mm],p0=[A0*2*g0,x00,1.0,2*g0],maxfev=400000)\r\n        A,x0,eta,w=pp\r\n        "]
