[188.748085, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1'])\ny = np.array(data['intensity'])\n\ndef lor(x, A, x0, g):\n    return A*g**2/((x-x0)**2+g**2)\n\ndef m3(x,A1,x1,g1,A2,x2,g2,A3,x3,g3,c):\n    return lor(x,A1,x1,g1)+lor(x,A2,x2,g2)+lor(x,A3,x3,g3)+c\n\ndef m3lin(x,A1,x1,g1,A2,x2,g2,A3,x3,g3,c,s):\n    return m3(x,A1,x1,g1,A2,x2,g2,A3,x3,g3,c)+s*(x-2000)\n\np0=[4800,1347,15,8860,1579.5,10,18450,2693,29,915]\npopt,_=curve_fit(m3,x,y,p0=p0,maxfev=400000)\nprint('global const-only:')\nfor i,l in enumerate(['D','G','2D']):\n    print('  ',l,'x0=%.4f g=%.4f A=%.2f'%(popt[3*i+1],popt[3*i+2],popt[3*i]),'c=%.2f'%popt[9])\nres=y-m3(x,*popt)\n# binned residuals\nedges=np.arange(1100,3001,100)\nfor lo,hi in zip(edges[:-1],edges[1:]):\n    m=(x>=lo)&(x<hi)\n    if m.sum(): print('   bin %4d-%4d mean=%8.2f rms=%7.2f n=%d'%(lo,hi,res[m].mean(),np.sqrt((res[m]**2).mean()),m.sum()))\n\ntry:\n    pl,_=curve_fit(m"]
[188.748225, "i", "3lin,x,y,p0=list(popt)+[0.0],maxfev=400000)\n    print('global with linear bg:')\n    for i,l in enumerate(['D','G','2D']):\n        print('  ',l,'x0=%.4f g=%.4f A=%.2f'%(pl[3*i+1],pl[3*i+2],pl[3*i]),'c=%.2f slope=%.6f'%(pl[9],pl[10]))\n    rl=y-m3lin(x,*pl)\n    print('   rms=%.3f'%np.sqrt((rl**2).mean()))\nexcept Exception as e:\n    print('linear fit failed',e)\n\n# 2D region: two Lorentzians\ndef m2(x,A1,x1,g1,A2,x2,g2,c):\n    return lor(x,A1,x1,g1)+lor(x,A2,x2,g2)+c\nm=(x>=2400)&(x<=3000)\ntry:\n    p2,_=curve_fit(m2,x[m],y[m],p0=[18450,2693,29,2000,2693,60,915],maxfev=400000)\n    print('2D region two-lorentzian: A1=%.2f x1=%.3f g1=%.3f A2=%.2f x2=%.3f g2=%.3f c=%.2f'%tuple(p2))\nexcept Exception as e:\n    print('2D 2L fit failed',e)\n\n# baseline regions far from peaks\nfor lo,hi in [(1100,1150),(1750,1850),(1900,2000),(2200,2300),(2950,3000)]:\n    mm=(x>=lo)&(x<=hi)\n    print('baseline %d-%d: mean=%.1f median=%.1f min=%.1f max=%.1f'%(lo,hi,y[mm].mean(),np.median(y[mm]),y[mm].min(),y[mm].max()))\nEOF\npython3 /app/diag.py"]
