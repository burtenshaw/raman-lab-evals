[470.838628, "i", "cat > /app/verify.py << 'EOF'\nimport json, numpy as np\nd = json.load(open('/app/results.json'))\nassert set(d) == {'D','G','2D','ID_IG'}\nfor k in ['D','G','2D']:\n    assert set(d[k]) == {'x0','gamma','amplitude','offset'}\n    for kk,v in d[k].items(): assert isinstance(v,float) and np.isfinite(v)\nassert isinstance(d['ID_IG'], float)\ndata = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(data['raman_shift_cm1']); y = np.array(data['intensity'])\nfor name,(lo,hi) in [('D',(1250,1450)),('G',(1470,1700)),('2D',(2500,2900))]:\n    p = d[name]; m = (x>=lo)&(x<=hi)\n    mod = p['amplitude']*p['gamma']**2/((x[m]-p['x0'])**2+p['gamma']**2)+p['offset']\n    r = y[m]-mod\n    print('%-3s rms=%7.3f  max|res|=%7.2f  n=%d' % (name, np.sqrt((r**2).mean()), np.abs(r).max(), m.sum()))\nprint('ID_IG check:', d['D']['amplitude']/d['G']['amplitude'], '==', d['ID_IG'])\nprint('ALL CHECKS PASSED')\nEOF\npython3 /app/verify.py\n"]
