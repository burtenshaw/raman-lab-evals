[283.797997, "o", "  slope=0.26953 intercept=426.258\r\npseudo-Voigt fits (eta=1 pure Lorentzian):\r\n"]
[283.799313, "o", "  D: x0=1346.715 eta=0.8847 FWHM=30.210 HWHM_L=15.105 area=213310.4 height=19626.1\r\n"]
