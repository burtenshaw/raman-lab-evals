[369.697651, "o", "for lo,hi in [(1250,1450),(1200,1460),(1150,1460),(1250,1460),(1250,1480),(1220,1460),(1200,1500)]:\r\n\u001b[?2004l\r"]
[369.697686, "o", "\u001b[?2004h> "]
