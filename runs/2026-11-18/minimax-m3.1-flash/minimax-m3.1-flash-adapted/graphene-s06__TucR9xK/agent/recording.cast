[283.189115, "o", "    G = np.exp(-4*np.log(2)*((x-x0)/w)**2)*np.sqrt(4*np.log(2)/np.pi)/w\r\n\u001b[?2004l\r"]
[283.189148, "o", "\u001b[?2004h> "]
[283.189214, "o", "    return A*(eta*L+(1-eta)*G)               # A ~ area\r\n\u001b[?2004l\r"]
[283.189245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[283.189278, "o", "\u001b[?2004h> "]
[283.189309, "o", "print('noise in flat bins (std):')\r\n\u001b[?2004l\r\u001b[?2004h"]
[283.18934, "o", "> "]
[283.189439, "o", "for lo,hi in [(1800,1900),(1900,2000),(2000,2100),(2100,2200),(2200,2300),(2300,2400)]:\r\n\u001b[?2004l\r"]
[283.189463, "o", "\u001b[?2004h> "]
[283.189572, "o", "    m=(x>=lo)&(x<hi); print('  %d-%d mean=%.1f std=%.1f'%(lo,hi,y[m].mean(),y[m].std()))\r\n\u001b[?2004l\r"]
[283.189603, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[283.189636, "o", "\u001b[?2004h> "]
[283.189678, "o", "print('linear fit of peak-free region 1750-2400:')\r\n\u001b[?2004l\r"]
[283.1897, "o", "\u001b[?2004h> "]
[283.189745, "o", "m=(x>=1750)&(x<=2400)\r\n\u001b[?2004l\r"]
[283.189776, "o", "\u001b[?2004h> "]
[283.189852, "o", "p=np.polyfit(x[m],y[m],1); print('  slope=%.5f intercept=%.3f'%(p[0],p[1]))\r\n\u001b[?2004l\r"]
[283.18989, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[283.189919, "o", "\u001b[?2004h> "]
[283.189955, "o", "print('pseudo-Voigt fits (eta=1 pure Lorentzian):')\r\n\u001b[?2004l\r"]
[283.189985, "o", "\u001b[?2004h> "]
[283.190144, "o", "for lbl,(lo,hi),(A0,x00,g0) in [('D',(1250,1450),(4860,1347,15)),('G',(1470,1700),(8860,1579.6,10)),('2D',(2500,2900),(18465,2693,29))]:\r\n\u001b[?2004l\r"]
[283.190185, "o", "\u001b[?2004h> "]
[283.190215, "o", "    mm=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.19029, "o", "    def mod(x,A,x0,eta,w): return pv(x,A,x0,eta,w)+950\r\n\u001b[?2004l\r"]
[283.190331, "o", "\u001b[?2004h> "]
[283.190359, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.190443, "o", "        pp,_=curve_fit(mod,x[mm],y[mm],p0=[A0*2*g0,x00,1.0,2*g0],maxfev=400000)\r\n\u001b[?2004l\r"]
[283.190484, "o", "\u001b[?2004h> "]
[283.190523, "o", "        A,x0,eta,w=pp\r\n\u001b[?2004l\r\u001b[?2004h"]
[283.190553, "o", "> "]
[283.190673, "o", "        print('  %s: x0=%.3f eta=%.4f FWHM=%.3f HWHM_L=%.3f area=%.1f height=%.1f'%(lbl,x0,eta,w,w/2,A,A*np.pi*eta/(2*w/2)))\r\n\u001b[?2004l\r"]
[283.190705, "o", "\u001b[?2004h> "]
[283.190753, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.190793, "o", "        print('  ',lbl,'fail',e)\r\n\u001b[?2004l\r"]
[283.190821, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[283.190852, "o", "\u001b[?2004h> "]
[283.19092, "o", "print('3 lorentzians + const + broad background lorentzian:')\r\n\u001b[?2004l\r"]
[283.190951, "o", "\u001b[?2004h> "]
[283.191007, "o", "def model(x,A1,x1,g1,A2,x2,g2,A3,x3,g3,Ab,xb,gb,c):\r\n\u001b[?2004l\r"]
[283.191046, "o", "\u001b[?2004h> "]
[283.191124, "o", "    return lor(x,A1,x1,g1)+lor(x,A2,x2,g2)+lor(x,A3,x3,g3)+lor(x,Ab,xb,gb)+c\r\n\u001b[?2004l\r"]
[283.191144, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r"]
[283.191183, "o", "\u001b[?2004h> "]
[283.191258, "o", "    p0=[4860,1347,15,8860,1579.6,10,18465,2693,29,3000,2050,400,915]\r\n\u001b[?2004l\r"]
[283.19129, "o", "\u001b[?2004h> "]
[283.191344, "o", "    pp,_=curve_fit(model,x,y,p0=p0,maxfev=800000)\r\n\u001b[?2004l\r"]
[283.191382, "o", "\u001b[?2004h> "]
[283.191495, "o", "    for i,l in enumerate(['D','G','2D']): print('  ',l,'x0=%.4f g=%.4f A=%.2f'%(pp[3*i+1],pp[3*i+2],pp[3*i]))\r\n\u001b[?2004l\r"]
[283.19154, "o", "\u001b[?2004h> "]
[283.191627, "o", "    print('  broad: A=%.2f x0=%.2f g=%.2f  const=%.3f'%(pp[9],pp[10],pp[11],pp[12]))\r\n\u001b[?2004l\r"]
[283.191664, "o", "\u001b[?2004h> "]
[283.19173, "o", "    r=y-model(x,*pp); print('  rms=%.3f'%np.sqrt((r**2).mean()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[283.19177, "o", "> "]
[283.191811, "o", "    edges=np.arange(1100,3001,100)\r\n\u001b[?2004l\r"]
[283.19185, "o", "\u001b[?2004h> "]
[283.191969, "o", "    print('  binned residuals:', ' '.join('%d:%+.0f'%(lo,r[(x>=lo)&(x<hi)].mean()) for lo,hi in zip(edges[:-1],edges[1:])))\r\n\u001b[?2004l\r"]
[283.192, "o", "\u001b[?2004h> "]
[283.192037, "o", "except Exception as e:\r\n\u001b[?2004l\r"]
[283.192076, "o", "\u001b[?2004h> "]
[283.192115, "o", "    print('  fail',e)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[283.193498, "o", "\u001b[?2004hroot@j-openenv-6afd8b2929e8b7ccfbbb8230-uvdzg7h1-a215d-wtzfp:/app# "]
[283.193561, "o", "python3 /app/diag2.py\r\n\u001b[?2004l\r"]
[283.797227, "o", "noise in flat bins (std):\r\n"]
