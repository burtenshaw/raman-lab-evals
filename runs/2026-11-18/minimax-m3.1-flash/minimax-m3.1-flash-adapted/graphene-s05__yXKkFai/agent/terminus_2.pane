# global fit: 3 lorentzians + linear baseline
def model(xx, aD,xD,gD, aG,xG,gG, a2,x2,g2, c0, c1):
    return (lor(xx,aD,xD,gD,0)+lor(xx,aG,xG,gG,0)+lor(xx,a2,x2,g2,0)+c0+c1*(xx-2000))
p0=[636,1354,12.8, 6548,1579.4,9.06, 9810,2688.7,25.6, 900, -0.05]
p,_=curve_fit(model,x,y,p0=p0,maxfev=100000)
print('global fit params:', np.round(p,4))
res = y - model(x,*p)
print('global rms', np.sqrt(np.mean(res**2)))
print('global ID/IG =', p[0]/p[3])
