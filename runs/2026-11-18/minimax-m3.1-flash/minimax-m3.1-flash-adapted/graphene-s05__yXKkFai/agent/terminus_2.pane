[?2004l[?2004h> print('=== G candidate windows ===')
[?2004l[?2004h> for lo, hi in [(1500,1660),(1480,1680),(1520,1640),(1450,1700),(1550,1620),(1500,1700),(1460,1640)]:
[?2004l[?2004h>     fit(lo, hi, [6600,1580,15,850], f'G {lo}-{hi}')
[?2004l[?2004h> print('=== 2D candidate windows ===')
