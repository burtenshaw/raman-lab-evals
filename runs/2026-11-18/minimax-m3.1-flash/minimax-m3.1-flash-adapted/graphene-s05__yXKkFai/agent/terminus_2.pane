[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d['raman_shift_cm1']; y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit(lo, hi, p0, label):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     try:
[?2004l[?2004h>         p, pc = curve_fit(lor, xs, ys, p0=p0, maxfev=20000)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(label, 'FAILED', e); return
[?2004l[?2004h>     res = ys - lor(xs, *p)
[?2004l[?2004h>     rms = np.sqrt(np.mean(res**2))
[?2004l[?2004h>     amp, x0, g, off = p
[?2004l[?2004h>     print(f'{label:>22} amp={amp:9.2f} x0={x0:8.2f} gamma={g:7.2f} off={off:8.2f} rms={rms:8.2f}  I_D/I_G-check')
[?2004l[?2004h>     return p, rms
[?2004l[?2004h> 
[?2004l[?2004h> print('=== D candidate windows ===')
[?2004l[?2004h> for lo, hi in [(1200,1500),(1250,1450),(1280,1420),(1300,1400),(1230,1470),(1180,1450)]:
