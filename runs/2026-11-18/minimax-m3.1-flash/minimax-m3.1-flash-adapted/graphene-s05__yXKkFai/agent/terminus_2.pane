[?2004hroot@j-openenv-6afd8ddee5cad0e4dc3e6e0f-s96hrjq5-78cdd-gl89r:/app# cat > /app/fit_lorentzians.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Fit single Lorentzian peaks (D, G, 2D) + constant offset to a Raman spectrum."""
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> DATA = '/app/spectrum.csv'
[?2004l[?2004h> OUT = '/app/results.json'
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> raw = np.genfromtxt(DATA, delimiter=',', names=True)
[?2004l[?2004h> x = np.asarray(raw['raman_shift_cm1'], dtype=float)
[?2004l[?2004h> y = np.asarray(raw['intensity'], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> # (label, window (cm-1), initial guess [amplitude, x0, gamma, offset])
[?2004l[?2004h> PEAKS = [
[?2004l[?2004h>     ('D',  (1200.0, 1500.0), [600.0, 1354.0, 13.0, 840.0]),
[?2004l[?2004h>     ('G',  (1480.0, 1680.0), [6550.0, 1579.0, 9.0, 800.0]),
[?2004l[?2004h>     ('2D', (2550.0, 2850.0), [9800.0, 2689.0, 26.0, 730.0]),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi), p0 in PEAKS:
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=100000)
[?2004l[?2004h>     amplitude, x0, gamma, offset = popt
[?2004l[?2004h>     rms = float(np.sqrt(np.mean((ys - lorentzian(xs, *popt))**2)))
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(x0),
[?2004l[?2004h>         'gamma': float(gamma),
[?2004l[?2004h>         'amplitude': float(amplitude),
[?2004l[?2004h>         'offset': float(offset),
[?2004l[?2004h>     }
[?2004l[?2004h>     print(f'{name:>2}: amp={amplitude:10.3f}  x0={x0:9.3f}  gamma={gamma:8.3f}  '
[?2004l[?2004h>           f'offset={offset:9.3f}  rms_resid={rms:7.2f}  (window {lo}-{hi})')
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print(f"ID/IG = {results['ID_IG']:.5f}")
[?2004l[?2004h> 
[?2004l[?2004h> with open(OUT, 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print('wrote', OUT)
[?2004l[?2004h> EOF
