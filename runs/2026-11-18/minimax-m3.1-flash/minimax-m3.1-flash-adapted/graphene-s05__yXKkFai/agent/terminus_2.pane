[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fitwin(lo, hi, p0):
[?2004l[?2004h>     m = (x>=lo)&(x<=hi)
[?2004l[?2004h>     p,_ = curve_fit(lor, x[m], y[m], p0=p0, maxfev=40000)
