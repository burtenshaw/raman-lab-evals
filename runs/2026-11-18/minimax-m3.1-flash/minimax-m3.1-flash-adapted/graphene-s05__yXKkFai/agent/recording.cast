[83.689822, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']\ny = d['intensity']\nprint('n', len(x), 'xmin', x.min(), 'xmax', x.max())\nprint('y min/max/median', y.min(), y.max(), np.median(y))\n# coarse profile in 50 cm-1 bins\nbins = np.arange(1100, 3001, 50)\nfor i in range(len(bins)-1):\n    m = (x >= bins[i]) & (x < bins[i+1])\n    if m.sum():\n        j = np.argmax(y[m])\n        print(f'{bins[i]:.0f}-{bins[i+1]:.0f}: max {y[m].max():.1f} at {x[m][j]:.1f}, median {np.median(y[m]):.1f}, mean {y[m].mean():.1f}')\nEOF\npython3 /app/explore.py\n"]
