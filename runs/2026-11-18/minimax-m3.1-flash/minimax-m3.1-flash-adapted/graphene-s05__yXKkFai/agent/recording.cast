[169.386241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.386251, "o", "\u001b[?2004h"]
[169.386265, "o", "> \r\n"]
[169.386281, "o", "\u001b[?2004l\r\u001b[?2004h"]
[169.386292, "o", "> "]
[169.386391, "o", "def lorentzian(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[169.386563, "o", "\u001b[?2004h"]
[169.386578, "o", ">     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.386648, "o", "\u001b[?2004h> "]
[169.386686, "o", "raw = np.genfromtxt(DATA, delimiter=',', names=True)\r\n"]
[169.386721, "o", "\u001b[?2004l\r"]
[169.386763, "o", "\u001b[?2004h> "]
[169.386838, "o", "x = np.asarray(raw['raman_shift_cm1'], dtype=float)\r\n\u001b[?2004l\r"]
[169.386852, "o", "\u001b[?2004h> "]
