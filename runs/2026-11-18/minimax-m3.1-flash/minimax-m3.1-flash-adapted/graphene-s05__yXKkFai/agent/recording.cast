[190.942531, "o", "\u001b[?2004h> "]
[190.942573, "o", "x = d['raman_shift_cm1']; y = d['intensity']\r\n\u001b[?2004l\r"]
[190.942613, "o", "\u001b[?2004h> "]
[190.942658, "o", "def lor(x,a,x0,g,o): return a*g**2/((x-x0)**2+g**2)+o\r\n\u001b[?2004l\r"]
[190.942689, "o", "\u001b[?2004h> "]
[190.94273, "o", "def f(lo,hi,p0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.942845, "o", "    m=(x>=lo)&(x<=hi); p,_=curve_fit(lor,x[m],y[m],p0=p0,maxfev=100000); return p\r\n\u001b[?2004l\r"]
[190.942873, "o", "\u001b[?2004h> "]
[190.942947, "o", "for dw in [(1200,1500),(1250,1450),(1180,1450),(1230,1470)]:\r\n\u001b[?2004l\r"]
[190.942972, "o", "\u001b[?2004h> "]
[190.943048, "o", "    for gw in [(1480,1680),(1500,1660),(1500,1620),(1450,1700)]:\r\n\u001b[?2004l\r"]
[190.943085, "o", "\u001b[?2004h> "]
[190.943138, "o", "        for tw in [(2550,2850),(2600,2800),(2500,2900)]:\r\n\u001b[?2004l\r"]
[190.943166, "o", "\u001b[?2004h> "]
[190.943277, "o", "            pD=f(*dw,[600,1354,13,840]); pG=f(*gw,[6550,1579,9,800]); p2=f(*tw,[9800,2689,26,730])\r\n\u001b[?2004l\r"]
[190.943309, "o", "\u001b[?2004h> "]
