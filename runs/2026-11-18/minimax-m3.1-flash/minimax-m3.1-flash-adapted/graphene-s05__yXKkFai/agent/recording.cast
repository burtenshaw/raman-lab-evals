[97.494143, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\nfor center in (1350, 1580, 2690):\n    print('--- around', center)\n    for off in range(-150, 151, 10):\n        xx = center + off\n        i = int(np.argmin(np.abs(x - xx)))\n        print(f'  {x[i]:8.1f} {y[i]:10.2f}')\nEOF\npython3 /app/explore2.py\n"]
