[107.421843, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, amplitude, x0, gamma, offset):\n    return amplitude*gamma**2/((x-x0)**2+gamma**2) + offset\n\ndef fit(lo, hi, p0, label):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    try:\n        p, pc = curve_fit(lor, xs, ys, p0=p0, maxfev=20000)\n    except Exception as e:\n        print(label, 'FAILED', e); return\n    res = ys - lor(xs, *p)\n    rms = np.sqrt(np.mean(res**2))\n    amp, x0, g, off = p\n    print(f'{label:>22} amp={amp:9.2f} x0={x0:8.2f} gamma={g:7.2f} off={off:8.2f} rms={rms:8.2f}  I_D/I_G-check')\n    return p, rms\n\nprint('=== D candidate windows ===')\nfor lo, hi in [(1200,1500),(1250,1450),(1280,1420),(1300,1400),(1230,1470),(1180,1450)]:\n    fit(lo, hi, [500,1350,15,850], f'D {lo}-{hi}')\nprint('=== G candidate windows ===')\nfor lo, hi in [(1500,1660),(1480,1680),(1520,1640),(1450,1700),(155"]
[107.42199, "i", "0,1620),(1500,1700),(1460,1640)]:\n    fit(lo, hi, [6600,1580,15,850], f'G {lo}-{hi}')\nprint('=== 2D candidate windows ===')\nfor lo, hi in [(2550,2850),(2500,2900),(2600,2800),(2570,2830),(2500,2860),(2450,2950)]:\n    fit(lo, hi, [10000,2690,25,850], f'2D {lo}-{hi}')\nEOF\npython3 /app/fit_test.py\n"]
