[158.217659, "i", "cat > /app/base.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\nclean = ((x>1120)&(x<1230))|((x>1660)&(x<2500))|((x>2820)&(x<2980))\np = np.polyfit(x[clean], y[clean], 1)\nprint('linear baseline fit on clean regions: slope=%.4f per cm-1, intercept=%.2f' % (p[0], p[1]))\nprint('predicted baseline at 1354, 1579, 2689:', [round(np.polyval(p, v),1) for v in (1354,1579,2689)])\nfor lo,hi in [(1120,1230),(1800,2400),(2850,2980)]:\n    m=(x>lo)&(x<hi); print(f'  {lo}-{hi}: median {np.median(y[m]):.1f} mean {y[m].mean():.1f}')\nEOF\npython3 /app/base.py\n"]
