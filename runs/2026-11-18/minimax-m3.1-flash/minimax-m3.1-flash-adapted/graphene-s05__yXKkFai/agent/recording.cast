[169.387174, "o", "> PEAKS = [\r\n\u001b[?2004l\r"]
[169.387201, "o", "\u001b[?2004h> "]
[169.387306, "o", "    ('D',  (1200.0, 1500.0), [600.0, 1354.0, 13.0, 840.0]),\r\n"]
[169.387826, "o", "\u001b[?2004l\r\u001b[?2004h>     ('G',  (1480.0, 1680.0), [6550.0, 1579.0, 9.0, 800.0]),\r\n\u001b[?2004l\r\u001b[?2004h>     ('2D', (2550.0, 2850.0), [9800.0, 2689.0, 26.0, 730.0]),\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = {}\r\n\u001b[?2004l\r\u001b[?2004h> for name, (lo, hi), p0 in PEAKS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.38785, "o", "    m = (x >= lo) & (x <= hi)"]
[169.387865, "o", "\r\n\u001b[?2004l\r"]
[169.387908, "o", "\u001b[?2004h> "]
[169.387961, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r"]
[169.387974, "o", "\u001b[?2004h> "]
[169.388654, "o", "    popt, _ = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=100000)\r\n\u001b[?2004l\r\u001b[?2004h>     amplitude, x0, gamma, offset = popt\r\n\u001b[?2004l\r\u001b[?2004h>     rms = float(np.sqrt(np.mean((ys - lorentzian(xs, *popt))**2)))\r\n\u001b[?2004l\r\u001b[?2004h>     results[name] = {\r\n\u001b[?2004l\r\u001b[?2004h>         'x0': float(x0),\r\n\u001b[?2004l\r\u001b[?2004h>         'gamma': float(gamma),\r\n\u001b[?2004l\r\u001b[?2004h>         'amplitude': float(amplitude),\r\n\u001b[?2004l\r\u001b[?2004h>         'offset': float(offset),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.388717, "o", "    print(f'{name:>2}: amp={amplitude:10.3f}  x0={x0:9.3f}  gamma={gamma:8.3f}  '\r\n\u001b[?2004l\r"]
[169.388734, "o", "\u001b[?2004h"]
[169.388747, "o", "> "]
[169.388889, "o", "          f'offset={offset:9.3f}  rms_resid={rms:7.2f}  (window {lo}-{hi})')\r\n\u001b[?2004l\r"]
[169.388912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.388928, "o", "\u001b[?2004h"]
[169.388949, "o", "> "]
[169.389157, "o", "results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\r\n\u001b[?2004l\r"]
[169.389363, "o", "\u001b[?2004h> print(f\"ID/IG = {results['ID_IG']:.5f}\")\r\n\u001b[?2004l\r"]
[169.38946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open(OUT, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.389507, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('wrote', OUT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
