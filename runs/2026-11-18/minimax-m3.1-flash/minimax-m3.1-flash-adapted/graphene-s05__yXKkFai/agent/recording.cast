[190.942046, "i", "cat > /app/robust.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\ndef lor(x,a,x0,g,o): return a*g**2/((x-x0)**2+g**2)+o\ndef f(lo,hi,p0):\n    m=(x>=lo)&(x<=hi); p,_=curve_fit(lor,x[m],y[m],p0=p0,maxfev=100000); return p\nfor dw in [(1200,1500),(1250,1450),(1180,1450),(1230,1470)]:\n    for gw in [(1480,1680),(1500,1660),(1500,1620),(1450,1700)]:\n        for tw in [(2550,2850),(2600,2800),(2500,2900)]:\n            pD=f(*dw,[600,1354,13,840]); pG=f(*gw,[6550,1579,9,800]); p2=f(*tw,[9800,2689,26,730])\n            print(f'D{dw} G{gw} 2D{tw}: ID/IG={pD[0]/pG[0]:.5f}  x0D={pD[1]:.2f} x0G={pG[1]:.2f} x02D={p2[1]:.2f} gD={pD[2]:.2f} gG={pG[2]:.2f} g2D={p2[2]:.2f}')\nEOF\npython3 /app/robust.py | tail -12\n"]
[190.942221, "o", "cat > /app/robust.py << 'EOF'\r\n\u001b[?2004l\r"]
[190.942294, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.942357, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[190.942437, "o", "\u001b[?2004h> "]
