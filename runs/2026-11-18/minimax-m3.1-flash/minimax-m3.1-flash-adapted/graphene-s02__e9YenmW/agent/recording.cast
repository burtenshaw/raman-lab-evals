[64.553551, "i", "cd /app && python3 - << 'EOF'\nimport numpy as np\nd = np.genfromtxt('spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1'] if 'raman_shift_cm1' in d.dtype.names else d[d.dtype.names[0]]\ny = d['intensity']\nprint(d.dtype.names, x.min(), x.max(), len(x), np.diff(x)[:5])\nprint('baseline median', np.median(y), 'max', y.max())\n# coarse profile\nfor lo in range(1100, 3001, 25):\n    m = (x>=lo)&(x<lo+25)\n    if m.sum():\n        print(lo, 'max', y[m].max(), 'at', x[m][np.argmax(y[m])], 'min', y[m].min())\nEOF\n"]
