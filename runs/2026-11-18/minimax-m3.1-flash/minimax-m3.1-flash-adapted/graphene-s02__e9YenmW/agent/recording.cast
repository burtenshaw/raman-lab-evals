[122.750124, "o", "> import json\r\n\u001b[?2004l\r"]
[122.750161, "o", "\u001b[?2004h> "]
[122.750198, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[122.750226, "o", "\u001b[?2004h> "]
[122.750288, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[122.750396, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.750441, "o", "\u001b[?2004h> "]
[122.750507, "o", "data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r"]
[122.750535, "o", "\u001b[?2004h> "]
[122.750588, "o", "names = data.dtype.names\r\n\u001b[?2004l\r"]
[122.75062, "o", "\u001b[?2004h> "]
[122.750657, "o", "x = data[names[0]]\r\n\u001b[?2004l\r"]
[122.750691, "o", "\u001b[?2004h> "]
[122.750726, "o", "y = data[names[1]]\r\n\u001b[?2004l\r"]
[122.750754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.750786, "o", "\u001b[?2004h> "]
[122.75089, "o", "def lorentzian(xv, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r"]
[122.750919, "o", "\u001b[?2004h"]
[122.750948, "o", "> "]
[122.751064, "o", "    return amplitude * gamma**2 / ((xv - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[122.751094, "o", "\u001b[?2004h"]
[122.751122, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.751152, "o", "> "]
[122.75123, "o", "def fit_peak(lo, hi, x0_guess, gamma_guess=20.0):\r\n\u001b[?2004l\r"]
[122.751263, "o", "\u001b[?2004h> "]
[122.751328, "o", "    mask = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[122.751361, "o", "\u001b[?2004h> "]
[122.751417, "o", "    xs, ys = x[mask], y[mask]\r\n\u001b[?2004l\r"]
[122.751442, "o", "\u001b[?2004h> "]
[122.751514, "o", "    offset0 = float(np.median(ys))\r\n\u001b[?2004l\r"]
[122.75154, "o", "\u001b[?2004h> "]
[122.751613, "o", "    amp0 = float(ys.max() - offset0)\r\n\u001b[?2004l\r"]
[122.751638, "o", "\u001b[?2004h> "]
[122.751734, "o", "    p0 = [x0_guess, gamma_guess, amp0, offset0]\r\n\u001b[?2004l\r"]
[122.751759, "o", "\u001b[?2004h> "]
[122.751899, "o", "    popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r"]
[122.751935, "o", "\u001b[?2004h> "]
[122.752003, "o", "    resid = ys - lorentzian(xs, *popt)\r\n\u001b[?2004l\r"]
[122.752018, "o", "\u001b[?2004h"]
[122.752043, "o", "> "]
[122.752123, "o", "    rms = float(np.sqrt(np.mean(resid**2)))\r\n\u001b[?2004l\r"]
[122.752148, "o", "\u001b[?2004h> "]
[122.752224, "o", "    ss_res = float(np.sum(resid**2))\r\n\u001b[?2004l\r"]
[122.752248, "o", "\u001b[?2004h> "]
[122.752344, "o", "    ss_tot = float(np.sum((ys - ys.mean())**2))\r\n\u001b[?2004l\r"]
[122.752369, "o", "\u001b[?2004h> "]
[122.75243, "o", "    r2 = 1 - ss_res / ss_tot\r\n\u001b[?2004l\r"]
[122.752455, "o", "\u001b[?2004h> "]
[122.752526, "o", "    perr = np.sqrt(np.diag(pcov))\r\n\u001b[?2004l\r"]
[122.75256, "o", "\u001b[?2004h> "]
[122.752614, "o", "    return popt, rms, r2, perr\r\n\u001b[?2004l\r"]
[122.752648, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.752673, "o", "\u001b[?2004h> "]
[122.7527, "o", "peaks = {\r\n\u001b[?2004l\r"]
[122.752727, "o", "\u001b[?2004h> "]
[122.752806, "o", "    'D':  (1250.0, 1450.0, 1350.0, 18.0),\r\n\u001b[?2004l\r"]
[122.752831, "o", "\u001b[?2004h> "]
[122.752916, "o", "    'G':  (1500.0, 1660.0, 1580.0, 10.0),\r\n\u001b[?2004l\r"]
[122.752939, "o", "\u001b[?2004h> "]
[122.753027, "o", "    '2D': (2500.0, 2900.0, 2690.0, 25.0),\r\n\u001b[?2004l\r"]
[122.753067, "o", "\u001b[?2004h> }"]
[122.753104, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.753114, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.75314, "o", "> "]
[122.753182, "o", "results = {}\r\n\u001b[?2004l\r"]
[122.753197, "o", "\u001b[?2004h> "]
[122.753218, "o", "fits = {}\r\n\u001b[?2004l\r"]
[122.753236, "o", "\u001b[?2004h> "]
[122.753331, "o", "for name, (lo, hi, g, gg) in peaks.items():\r\n\u001b[?2004l\r"]
[122.753356, "o", "\u001b[?2004h> "]
[122.753455, "o", "    popt, rms, r2, perr = fit_peak(lo, hi, g, gg)\r\n\u001b[?2004l\r"]
[122.753477, "o", "\u001b[?2004h"]
[122.753514, "o", "> "]
[122.753547, "o", "    fits[name] = popt\r\n\u001b[?2004l\r"]
[122.753581, "o", "\u001b[?2004h> "]
[122.753617, "o", "    results[name] = {\r\n\u001b[?2004l\r"]
[122.753656, "o", "\u001b[?2004h> "]
[122.753705, "o", "        'x0': float(popt[0]),\r\n\u001b[?2004l\r"]
[122.75373, "o", "\u001b[?2004h> "]
[122.753797, "o", "        'gamma': float(popt[1]),\r\n\u001b[?2004l\r"]
[122.753822, "o", "\u001b[?2004h> "]
[122.753897, "o", "        'amplitude': float(popt[2]),\r\n\u001b[?2004l\r"]
[122.753937, "o", "\u001b[?2004h> "]
[122.753992, "o", "        'offset': float(popt[3]),\r\n\u001b[?2004l\r"]
[122.754027, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[122.75407, "o", "\u001b[?2004h> "]
[122.754305, "o", "    print(f'{name:>3}: window {lo}-{hi}  x0={popt[0]:.4f}+/-{perr[0]:.4f}  gamma={popt[1]:.4f}+/-{perr[1]:.4f}  '\r\n\u001b[?2004l\r"]
[122.754334, "o", "\u001b[?2004h> "]
[122.754541, "o", "          f'amp={popt[2]:.3f}+/-{perr[2]:.3f}  off={popt[3]:.3f}+/-{perr[3]:.3f}  rms={rms:.2f}  R2={r2:.6f}')\r\n\u001b[?2004l\r"]
[122.754573, "o", "\u001b[?2004h> "]
[122.754612, "o", "\r\n\u001b[?2004l\r"]
[122.754641, "o", "\u001b[?2004h> "]
[122.754706, "o", "results['ID_IG'] = float(fits['D'][2] / fits['G'][2])\r\n\u001b[?2004l\r"]
[122.75473, "o", "\u001b[?2004h> "]
[122.754806, "o", "print('I_D/I_G =', results['ID_IG'])\r\n\u001b[?2004l\r"]
[122.754841, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.75491, "o", "\u001b[?2004h> "]
[122.75495, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[122.754975, "o", "\u001b[?2004h> "]
[122.755052, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[122.755076, "o", "\u001b[?2004h> "]
[122.755154, "o", "print('written /app/results.json')\r\n\u001b[?2004l\r"]
[122.755177, "o", "\u001b[?2004h> "]
[122.755211, "o", "EOF\r\n\u001b[?2004l\r"]
[122.756683, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7e-ac3v6ckn-3b66f-jp2zw:/app# "]
[122.756777, "o", "python3 fit_spectrum.py\r\n\u001b[?2004l\r"]
[123.348143, "o", "  D: window 1250.0-1450.0  x0=1346.3918+/-0.0826  gamma=16.9506+/-0.1584  amp=2348.689+/-11.650  off=1016.840+/-5.235  rms=58.73  R2=0.991873\r\n"]
[123.348637, "o", "  G: window 1500.0-1660.0  x0=1582.1930+/-0.0201  gamma=8.9901+/-0.0346  amp=7870.896+/-17.697  off=1031.196+/-5.374  rms=65.81  R2=0.998861\r\n"]
[123.349189, "o", " 2D: window 2500.0-2900.0  x0=2692.7023+/-0.0148  gamma=24.1589+/-0.0258  amp=16035.461+/-9.860  off=1068.338+/-3.192  rms=60.26  R2=0.999780\r\nI_D/I_G ="]
[123.349236, "o", " 0.2984017342391647"]
[123.349277, "o", "\r\n"]
