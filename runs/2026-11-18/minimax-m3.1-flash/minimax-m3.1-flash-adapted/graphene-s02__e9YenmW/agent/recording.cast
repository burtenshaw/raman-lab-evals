[81.675019, "o", "import numpy as np"]
[81.675054, "o", "\r\n\u001b[?2004l\r"]
[81.675093, "o", "\u001b[?2004h> "]
[81.675125, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.675169, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.675266, "o", "d = np.genfromtxt('spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r"]
[81.675306, "o", "\u001b[?2004h> "]
[81.675346, "o", "x = d[d.dtype.names[0]]\r\n\u001b[?2004l\r"]
[81.675375, "o", "\u001b[?2004h> "]
[81.67542, "o", "y = d[d.dtype.names[1]]\r\n\u001b[?2004l\r"]
[81.675442, "o", "\u001b[?2004h"]
[81.675475, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.675545, "o", "def lor(x, x0, gamma, amp, off):\r\n\u001b[?2004l\r"]
[81.675567, "o", "\u001b[?2004h> "]
[81.675647, "o", "    return amp*gamma**2/((x-x0)**2+gamma**2)+off"]
[81.675742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.675794, "o", "def fit(lo, hi, guess):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.67585, "o", "    m = (x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[81.675889, "o", "\u001b[?2004h> "]
[81.67592, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r"]
[81.675955, "o", "\u001b[?2004h> "]
[81.676054, "o", "    p0 = [guess, 20.0, ys.max()-np.median(ys), np.median(ys)]\r\n\u001b[?2004l\r"]
[81.676094, "o", "\u001b[?2004h> "]
[81.67619, "o", "    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r"]
[81.676253, "o", "\u001b[?2004h> "]
[81.676286, "o", "    res = ys - lor(xs, *p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.676339, "o", "    rms = np.sqrt(np.mean(res**2))\r\n\u001b[?2004l\r"]
[81.676376, "o", "\u001b[?2004h> "]
[81.676424, "o", "    ss = np.sum((ys-np.mean(ys))**2)\r\n\u001b[?2004l\r"]
[81.676451, "o", "\u001b[?2004h> "]
[81.676498, "o", "    r2 = 1-np.sum(res**2)/ss\r\n\u001b[?2004l\r"]
[81.676532, "o", "\u001b[?2004h> "]
[81.676575, "o", "    return p, rms, r2, m.sum()\r\n\u001b[?2004l\r"]
[81.6766, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.676636, "o", "\u001b[?2004h> "]
