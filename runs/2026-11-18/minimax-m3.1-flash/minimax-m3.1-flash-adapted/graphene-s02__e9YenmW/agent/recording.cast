[64.773668, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7e-ac3v6ckn-3b66f-jp2zw:/app# "]
[81.674681, "i", "cd /app && cat > explore.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]\ny = d[d.dtype.names[1]]\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef fit(lo, hi, guess):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p0 = [guess, 20.0, ys.max()-np.median(ys), np.median(ys)]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    res = ys - lor(xs, *p)\n    rms = np.sqrt(np.mean(res**2))\n    ss = np.sum((ys-np.mean(ys))**2)\n    r2 = 1-np.sum(res**2)/ss\n    return p, rms, r2, m.sum()\n\nprint('=== D ===')\nfor lo,hi in [(1200,1500),(1250,1450),(1230,1480),(1280,1420),(1200,1520),(1150,1550)]:\n    p,rms,r2,n = fit(lo,hi,1350)\n    print(f'win {lo}-{hi} n={n} x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={rms:.2f} r2={r2:.5f}')\n\nprint('=== G ===')\nfor lo,hi in [(1450,1700),(1480,1680),(1500,1660),(1460,1720),(1400,1750),(1520,1640)]:\n    p,rms,r2,n ="]
[81.674798, "i", " fit(lo,hi,1580)\n    print(f'win {lo}-{hi} n={n} x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={rms:.2f} r2={r2:.5f}')\n\nprint('=== 2D ===')\nfor lo,hi in [(2400,3000),(2450,2950),(2500,2900),(2350,3000),(2550,2850),(2450,2900)]:\n    p,rms,r2,n = fit(lo,hi,2690)\n    print(f'win {lo}-{hi} n={n} x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={rms:.2f} r2={r2:.5f}')\nEOF\npython3 explore.py\n"]
[81.674854, "o", "cd /app && cat > explore.py << 'EOF'\r\n\u001b[?2004l\r"]
