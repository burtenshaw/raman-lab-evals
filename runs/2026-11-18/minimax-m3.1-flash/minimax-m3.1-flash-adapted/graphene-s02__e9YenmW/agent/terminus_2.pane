[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7e-ac3v6ckn-3b66f-jp2zw:/app# cd /app && cat > fit_spectrum.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> names = data.dtype.names
[?2004l[?2004h> x = data[names[0]]
[?2004l[?2004h> y = data[names[1]]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(xv, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((xv - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(lo, hi, x0_guess, gamma_guess=20.0):
[?2004l[?2004h>     mask = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[mask], y[mask]
[?2004l[?2004h>     offset0 = float(np.median(ys))
[?2004l[?2004h>     amp0 = float(ys.max() - offset0)
[?2004l[?2004h>     p0 = [x0_guess, gamma_guess, amp0, offset0]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     resid = ys - lorentzian(xs, *popt)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     ss_res = float(np.sum(resid**2))
[?2004l[?2004h>     ss_tot = float(np.sum((ys - ys.mean())**2))
[?2004l[?2004h>     r2 = 1 - ss_res / ss_tot
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     return popt, rms, r2, perr
