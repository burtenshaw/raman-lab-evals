[?2004hroot@j-openenv-6afd8d85e5cad0e4dc3e6deb-spkj44kl-b9be1-znwxg:/app# cat > /app/fit_spectrum.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.asarray(data['raman_shift_cm1'], dtype=float)
[?2004l[?2004h> y = np.asarray(data['intensity'], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, lo, hi, p0):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xi, yi = x[m], y[m]
[?2004l[?2004h>     p, cov = curve_fit(lorentzian, xi, yi, p0=p0, maxfev=200000)
[?2004l[?2004h>     x0, gamma, amp, off = p
[?2004l[?2004h>     gamma = abs(gamma)
[?2004l[?2004h>     amp = abs(amp)
[?2004l[?2004h>     model = lorentzian(xi, x0, gamma, amp, off)
[?2004l[?2004h>     res = yi - model
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(res**2)))
[?2004l[?2004h>     ss_res = float(np.sum(res**2)); ss_tot = float(np.sum((yi-np.mean(yi))**2))
[?2004l[?2004h>     r2 = 1.0 - ss_res/ss_tot
[?2004l[?2004h>     return {'x0': float(x0), 'gamma': float(gamma), 'amplitude': float(amp), 'offset': float(off)}, rms, r2, int(m.sum())
[?2004l[?2004h> 
[?2004l[?2004h> specs = {
[?2004l[?2004h>     'D':  dict(win=(1250.0, 1450.0), p0=(1346.4, 17.0, 2350.0, 1020.0)),
[?2004l[?2004h>     'G':  dict(win=(1500.0, 1700.0), p0=(1582.2,  9.0, 7870.0, 1030.0)),
[?2004l[?2004h>     '2D': dict(win=(2550.0, 2850.0), p0=(2692.7, 24.0, 16035.0, 1070.0)),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, s in specs.items():
[?2004l[?2004h>     p, rms, r2, n = fit_peak(x, y, s['win'][0], s['win'][1], s['p0'])
[?2004l[?2004h>     results[name] = p
[?2004l[?2004h>     print(f"{name:>2s} win={s['win']} n={n}: x0={p['x0']:.4f} gamma={p['gamma']:.4f} "
[?2004l[?2004h>           f"amplitude={p['amplitude']:.3f} offset={p['offset']:.3f} rms={rms:.2f} R2={r2:.5f}")
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> print('ID_IG =', results['ID_IG'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> EOF
