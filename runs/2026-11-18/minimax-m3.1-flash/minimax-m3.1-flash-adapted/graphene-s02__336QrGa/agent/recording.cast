[95.60916, "i", "cat > /app/globalfit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef model(x, x0d, gd, ad, x0g, gg, ag, x02, g2, a2, off):\n    return (ad*gd**2/((x-x0d)**2+gd**2) + ag*gg**2/((x-x0g)**2+gg**2)\n            + a2*g2**2/((x-x02)**2+g2**2) + off)\n\np0 = [1346.4, 17.0, 2350.0, 1582.2, 9.0, 7870.0, 2692.7, 24.1, 16035.0, 1030.0]\np, cov = curve_fit(model, x, y, p0=p0, maxfev=500000)\nprint('global params:')\nfor n,v in zip(['x0d','gd','ad','x0g','gg','ag','x02','g2','a2','off'], p):\n    print(' ', n, round(v,4))\nres = y - model(x,*p)\nprint('rms', np.sqrt(np.mean(res**2)), 'max', np.max(np.abs(res)))\nfor lo,hi in [(1100,1200),(1200,1500),(1500,1750),(1750,2500),(2500,2900),(2900,3000)]:\n    m=(x>=lo)&(x<=hi)\n    print(f'  region {lo}-{hi}: rms={np.sqrt(np.mean(res[m]**2)):.1f} max={np.max(np.abs(res[m])):.1f}')\n# check mean residual in fine bins around D' region\nm=(x>=1600)&(x<=1700)\npri"]
[95.609341, "i", "nt('Dprime region mean res', res[m].mean(), 'rms', np.sqrt(np.mean(res[m]**2)))\nEOF\npython3 /app/globalfit.py\n"]
[95.609407, "o", "cat > /app/globalfit.py << 'EOF'\r\n\u001b[?2004l\rnt('Dprime region mean res', res[m].mean(), 'rms', np.sqrt(np.mean(res[m]**2)))\r\nEOF\r\npython3 /app/globalfit.py\r\n\u001b[?2004h"]
