[73.009595, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']\ny = d['intensity']\nprint('N =', len(x), 'range', x.min(), x.max())\nfor lo, hi in [(1100,1200),(1200,1480),(1480,1750),(1750,2500),(2500,2900),(2900,3000)]:\n    m = (x>=lo)&(x<=hi)\n    xi, yi = x[m], y[m]\n    i = np.argmax(yi)\n    print(f'window {lo}-{hi}: max={yi[i]:.1f} at {xi[i]:.1f}, min={yi.min():.1f}, median={np.median(yi):.1f}, edge_median={np.median(np.r_[yi[:20],yi[-20:]]):.1f}')\nEOF\npython3 /app/explore.py\n"]
