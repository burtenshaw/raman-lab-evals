[81.934516, "i", "cat > /app/tryfit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef fit(lo, hi, p0):\n    m = (x>=lo)&(x<=hi)\n    xi, yi = x[m], y[m]\n    p, cov = curve_fit(lor, xi, yi, p0=p0, maxfev=200000)\n    r = yi-lor(xi,*p)\n    return p, np.sqrt(np.mean(r**2)), len(xi)\n\npeaks = {\n 'D': [(1200,1480),(1250,1450),(1280,1420),(1300,1400)],\n 'G': [(1480,1750),(1500,1700),(1530,1650),(1550,1620)],\n '2D':[(2500,2900),(2580,2800),(2600,2780),(2630,2760)],\n}\np0 = {'D':(1345,25,2400,1000),'G':(1582,30,7900,1000),'2D':(2693,30,16000,1100)}\nfor name, wins in peaks.items():\n    for w in wins:\n        try:\n            p, rms, n = fit(w[0], w[1], p0[name])\n            print(f'{name} win {w}: x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={rms:.2f} n={n}')\n        except Exception as e:\n            print("]
[81.934647, "i", "name, w, 'FAIL', e)\n    print()\nEOF\npython3 /app/tryfit.py\n"]
