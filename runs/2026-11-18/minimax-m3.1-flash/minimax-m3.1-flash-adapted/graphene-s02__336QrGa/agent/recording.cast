[121.866775, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']; y = d['intensity']\n\ndef model(x, x0d, gd, ad, x0g, gg, ag, x02, g2, a2, c0, c1):\n    return (ad*gd**2/((x-x0d)**2+gd**2) + ag*gg**2/((x-x0g)**2+gg**2)\n            + a2*g2**2/((x-x02)**2+g2**2) + c0 + c1*(x-2000.0))\n\np0 = [1346.4, 17.0, 2350.0, 1582.2, 9.0, 7870.0, 2692.7, 24.1, 16035.0, 1030.0, 0.0]\np, cov = curve_fit(model, x, y, p0=p0, maxfev=500000)\nnames = ['x0d','gd','ad','x0g','gg','ag','x02','g2','a2','c0','c1']\nfor n,v in zip(names,p): print(' ', n, round(v,4))\nres = y - model(x,*p)\nprint('rms', np.sqrt(np.mean(res**2)))\n# baseline-only region slope estimate (1750-2450, subtract tail contributions from global model)\nfor lo,hi in [(1750,2400),(1100,1200)]:\n    m=(x>=lo)&(x<=hi)\n    A=np.vstack([np.ones(m.sum()), (x[m]-2000.0)]).T\n    sol, *_ = np.linalg.lstsq(A, y[m], rcond=None)\n    print('baseline linear fit', lo, hi, 'c0', rou"]
[121.866907, "i", "nd(sol[0],1), 'slope', round(sol[1],5))\nEOF\npython3 /app/diag.py\n"]
