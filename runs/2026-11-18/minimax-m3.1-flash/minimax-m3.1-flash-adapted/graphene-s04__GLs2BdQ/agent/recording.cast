[84.994916, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1']); y = np.asarray(d['intensity'])\n\ndef lor(x, amp, gamma, x0, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\ndef fit(lo, hi, label):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    i = np.argmax(ys)\n    x0g = xs[i]\n    off0 = np.median(np.concatenate([ys[:15], ys[-15:]]))\n    amp0 = ys[i]-off0\n    # half max width estimate\n    half = off0 + amp0/2\n    idx = np.where(ys>=half)[0]\n    gam0 = max((xs[idx[-1]]-xs[idx[0]])/2, 3.0)\n    p, cov = curve_fit(lor, xs, ys, p0=[amp0, gam0, x0g, off0], maxfev=200000)\n    resid = ys - lor(xs,*p)\n    print(f'{label:4s} win[{lo},{hi}] amp={p[0]:9.3f} gamma={p[1]:8.3f} x0={p[2]:9.3f} off={p[3]:9.3f} rms={np.sqrt(np.mean(resid**2)):8.2f} maxres={np.max(np.abs(resid)):8.2f}')\n    return p\n\nfor lo,hi in [(1250,1450),(1230,1470),(1200,1500),(1280,1430),(1250,1420)]:\n    fit(lo,hi,'"]
[84.995062, "i", "D')\nprint()\nfor lo,hi in [(1500,1700),(1480,1720),(1520,1680),(1450,1750),(1500,1750)]:\n    fit(lo,hi,'G')\nprint()\nfor lo,hi in [(2550,2800),(2520,2830),(2580,2780),(2500,2900),(2600,2750)]:\n    fit(lo,hi,'2D')\nEOF\npython3 /app/fit_test.py\n"]
[84.995194, "o", "cat > /app/fit_test.py << 'EOF'\r\n\u001b[?2004l\r"]
[84.995275, "o", "D')\r\nprint()\r\nfor lo,hi in [(1500,1700),(1480,1720),(1520,1680),(1450,1750),(1500,1750)]:\r\n    fit(lo,hi,'G')\r\nprint()\r\nfor lo,hi in [(2550,2800),(2520,2830),(2580,2780),(2500,2900),(2600,2750)]:\r\n    fit(lo,hi,'2D')\r\nEOF\r\npython3 /app/fit_test.py\r\n\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
