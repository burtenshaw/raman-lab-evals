[112.800466, "o", "\u001b[?2004h> "]
[112.800616, "o", "    print(name,'refit',np.round(p,3),'delta',np.round(p-np.array([r[name]['amplitude'],r[name]['gamma'],r[name]['x0'],r[name]['offset']]),4))\r\n\u001b[?2004l\r"]
[112.800668, "o", "\u001b[?2004h> "]
