[74.750031, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']\ny = d['intensity']\nprint('n=', len(x), 'x range', x.min(), x.max(), 'step', x[1]-x[0])\nprint('y range', y.min(), y.max())\nfor name, lo, hi in [('D',1200,1500),('G',1450,1720),('2D',2500,2900)]:\n    m = (x>=lo)&(x<=hi)\n    i = np.argmax(y[m])\n    print(name, 'window', lo, hi, 'max y', y[m][i], 'at x', x[m][i])\n# coarse profile: print every 50th point\nfor xi, yi in zip(x[::50], y[::50]):\n    print(f'{xi:8.1f} {yi:12.2f}')\nEOF\npython3 /app/explore.py\n"]
