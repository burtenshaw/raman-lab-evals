[112.798812, "i", "cat > /app/validate.py << 'EOF'\nimport json, numpy as np\nfrom scipy.optimize import curve_fit\nr = json.load(open('/app/results.json'))\nassert set(r.keys()) == {'D','G','2D','ID_IG'}, r.keys()\nfor k in ['D','G','2D']:\n    assert set(r[k].keys()) == {'x0','gamma','amplitude','offset'}, r[k].keys()\n    for f,v in r[k].items():\n        assert isinstance(v,(int,float)) and np.isfinite(v), (k,f,v)\nassert isinstance(r['ID_IG'],(int,float)) and np.isfinite(r['ID_IG'])\nprint('ID_IG stored:', r['ID_IG'], ' recomputed:', r['D']['amplitude']/r['G']['amplitude'])\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'],float); y = np.asarray(d['intensity'],float)\nlor = lambda xv,a,g,x0,o: a*g**2/((xv-x0)**2+g**2)+o\nfor name,(lo,hi) in {'D':(1240,1460),'G':(1470,1690),'2D':(2560,2800)}.items():\n    m=(x>=lo)&(x<=hi)\n    p,_=curve_fit(lor,x[m],y[m],p0=[r[name]['amplitude'],r[name]['gamma'],r[name]['x0'],r[name]['offset']],maxfev=100000)\n    print(name,'refit',np.round(p,3),'delt"]
[112.798953, "i", "a',np.round(p-np.array([r[name]['amplitude'],r[name]['gamma'],r[name]['x0'],r[name]['offset']]),4))\nprint('VALIDATION OK')\nEOF\npython3 /app/validate.py; ls -la /app/results.json\n"]
[112.799033, "o", "cat > /app/validate.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.799088, "o", "import json, numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.799133, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.799184, "o", "r = json.load(open('/app/results.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.799223, "o", "assert set(r.keys()) == {'D','G','2D','ID_IG'}, r.keys()\r\n\u001b[?2004l\r"]
[112.799259, "o", "\u001b[?2004h> "]
[112.799294, "o", "for k in ['D','G','2D']:\r\n\u001b[?2004l\r"]
[112.799324, "o", "\u001b[?2004h> "]
[112.799401, "o", "    assert set(r[k].keys()) == {'x0','gamma','amplitude','offset'}, r[k].keys()\r\n\u001b[?2004l\r"]
[112.799448, "o", "\u001b[?2004h> "]
[112.799483, "o", "    for f,v in r[k].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.799558, "o", "        assert isinstance(v,(int,float)) and np.isfinite(v), (k,f,v)\r\n\u001b[?2004l\r"]
[112.799595, "o", "\u001b[?2004h> "]
[112.79965, "o", "assert isinstance(r['ID_IG'],(int,float)) and np.isfinite(r['ID_IG'])\r\n\u001b[?2004l\r"]
[112.799689, "o", "\u001b[?2004h> "]
[112.79978, "o", "print('ID_IG stored:', r['ID_IG'], ' recomputed:', r['D']['amplitude']/r['G']['amplitude'])\r\n\u001b[?2004l\r"]
[112.79981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[112.799821, "o", "> "]
[112.799891, "o", "d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r"]
[112.799927, "o", "\u001b[?2004h> "]
[112.800034, "o", "x = np.asarray(d['raman_shift_cm1'],float); y = np.asarray(d['intensity'],float)\r\n\u001b[?2004l\r"]
[112.800071, "o", "\u001b[?2004h> "]
[112.800119, "o", "lor = lambda xv,a,g,x0,o: a*g**2/((xv-x0)**2+g**2)+o\r\n\u001b[?2004l\r"]
[112.800159, "o", "\u001b[?2004h> "]
[112.80023, "o", "for name,(lo,hi) in {'D':(1240,1460),'G':(1470,1690),'2D':(2560,2800)}.items():\r\n\u001b[?2004l\r"]
[112.800269, "o", "\u001b[?2004h> "]
