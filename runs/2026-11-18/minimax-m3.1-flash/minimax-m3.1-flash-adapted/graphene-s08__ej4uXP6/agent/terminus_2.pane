[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d['raman_shift_cm1']; y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, x0, gamma, amp, offset):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit(lo, hi, p0):
[?2004l[?2004h>     m = (x>=lo)&(x<=hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     r = ys - lor(xs, *p)
[?2004l[?2004h>     rms = np.sqrt(np.mean(r**2))
[?2004l[?2004h>     return p, rms, len(xs)
[?2004l[?2004h> 
[?2004l[?2004h> print('D peak windows:')
[?2004l[?2004h> for (lo,hi) in [(1250,1450),(1270,1440),(1280,1430),(1290,1420),(1260,1460),(1300,1400)]:
[?2004l[?2004h>     p,rms,n = fit(lo,hi,[1350,10,1300,1000])
[?2004l[?2004h>     print('  %d-%d n=%d x0=%.3f gamma=%.3f amp=%.1f off=%.1f rms=%.1f' % (lo,hi,n,p[0],p[1],p[2],p[3],rms))
[?2004l[?2004h> 
[?2004l[?2004h> print('G peak windows:')
[?2004l[?2004h> for (lo,hi) in [(1500,1700),(1520,1680),(1530,1660),(1540,1640),(1550,1630),(1520,1700),(1500,1750)]:
[?2004l[?2004h>     p,rms,n = fit(lo,hi,[1581,12,6500,950])
[?2004l[?2004h>     print('  %d-%d n=%d x0=%.3f gamma=%.3f amp=%.1f off=%.1f rms=%.1f' % (lo,hi,n,p[0],p[1],p[2],p[3],rms))
[?2004l[?2004h> 
[?2004l[?2004h> print('2D peak windows:')
[?2004l[?2004h> for (lo,hi) in [(2500,2900),(2550,2850),(2580,2820),(2600,2800),(2620,2780),(2500,2950),(2450,2950)]:
[?2004l[?2004h>     p,rms,n = fit(lo,hi,[2685,20,12500,850])
[?2004l[?2004h>     print('  %d-%d n=%d x0=%.3f gamma=%.3f amp=%.1f off=%.1f rms=%.1f' % (lo,hi,n,p[0],p[1],p[2],p[3],rms))
