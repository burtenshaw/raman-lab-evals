[?2004hroot@j-openenv-6afd8b6829e8b7ccfbbb8250-lf8nrhnf-e7277-pts29:/app# cat > /app/resid.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d['raman_shift_cm1']; y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, x0, gamma, amp, offset):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def lorlin(x, x0, gamma, amp, c0, c1):
[?2004l[?2004h>     return lor(x,x0,gamma,amp,0)+c0+c1*x
[?2004l[?2004h> 
[?2004l[?2004h> def resid_profile(lo,hi,p0,label):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]
[?2004l[?2004h>     p,_=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)
[?2004l[?2004h>     r=ys-lor(xs,*p)
[?2004l[?2004h>     print('==',label,'const-offset fit params:',np.round(p,3))
[?2004l[?2004h>     # binned residual profile (10 cm-1 bins)
[?2004l[?2004h>     for lo2 in range(int(lo), int(hi), 10):
[?2004l[?2004h>         mm=(xs>=lo2)&(xs<lo2+10)
[?2004l[?2004h>         if mm.sum(): print('   %5d  mean resid %8.1f  (n=%d)' % (lo2, r[mm].mean(), mm.sum()))
[?2004l[?2004h>     # linear baseline variant
[?2004l[?2004h>     try:
[?2004l[?2004h>         p2,_=curve_fit(lorlin,xs,ys,p0=[p[0],p[1],p[2],p[3],0.0],maxfev=200000)
[?2004l[?2004h>         print('   linear-baseline variant:',np.round(p2,4))
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print('   linear fit failed',e)
[?2004l[?2004h> 
[?2004l[?2004h> resid_profile(1250,1450,[1350,10,1300,1000],'D 1250-1450')
[?2004l[?2004h> resid_profile(1500,1700,[1581,12,6500,950],'G 1500-1700')
[?2004l[?2004h> resid_profile(2500,2900,[2685,20,12500,850],'2D 2500-2900')
