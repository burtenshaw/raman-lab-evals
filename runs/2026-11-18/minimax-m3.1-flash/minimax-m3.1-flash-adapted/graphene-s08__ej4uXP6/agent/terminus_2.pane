[?2004hroot@j-openenv-6afd8b6829e8b7ccfbbb8250-lf8nrhnf-e7277-pts29:/app# cat > /app/global.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d['raman_shift_cm1']; y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def make_model(nlor, deg):
[?2004l[?2004h>     def f(xx, *p):
[?2004l[?2004h>         out = np.zeros_like(xx, dtype=float)
[?2004l[?2004h>         for i in range(nlor):
[?2004l[?2004h>             x0,g,a = p[3*i:3*i+3]
[?2004l[?2004h>             out = out + a*g**2/((xx-x0)**2+g**2)
[?2004l[?2004h>         rest = p[3*nlor:]
[?2004l[?2004h>         for k,c in enumerate(rest):
[?2004l[?2004h>             out = out + c*(xx/1000.0)**k
[?2004l[?2004h>         return out
[?2004l[?2004h>     return f
[?2004l[?2004h> 
[?2004l[?2004h> def run(nlor, deg, p0):
[?2004l[?2004h>     f = make_model(nlor, deg)
[?2004l[?2004h>     p,cov = curve_fit(f, x, y, p0=p0, maxfev=500000)
[?2004l[?2004h>     r = y - f(x,*p)
[?2004l[?2004h>     print('nlor=%d deg=%d rms=%.2f' % (nlor, deg, np.sqrt(np.mean(r**2))))
[?2004l[?2004h>     for i in range(nlor):
[?2004l[?2004h>         print('   L%d: x0=%.3f gamma=%.3f amp=%.2f' % (i+1, p[3*i], p[3*i+1], p[3*i+2]))
[?2004l[?2004h>     print('   bg:', np.round(p[3*nlor:],4))
[?2004l[?2004h>     return p
[?2004l[?2004h> 
