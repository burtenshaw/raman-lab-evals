[?2004hroot@j-openenv-6afd8b6829e8b7ccfbbb8250-lf8nrhnf-e7277-pts29:/app# cat > /app/final_fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.asarray(d['raman_shift_cm1'], dtype=float)
[?2004l[?2004h> y = np.asarray(d['intensity'], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(xx, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((xx - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(lo, hi, p0):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=500000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     resid = ys - lorentzian(xs, *popt)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     print('window %d-%d  n=%d  rms=%.2f' % (lo, hi, len(xs), rms))
[?2004l[?2004h>     print('   x0=%.4f +/- %.4f   gamma=%.4f +/- %.4f   amp=%.3f +/- %.3f   off=%.3f +/- %.3f'
[?2004l[?2004h>           % (popt[0], perr[0], popt[1], perr[1], popt[2], perr[2], popt[3], perr[3]))
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> P_D  = fit_peak(1250, 1450, [1349.2, 13.5, 1313.0, 970.0])
[?2004l[?2004h> P_G  = fit_peak(1500, 1700, [1581.1,  8.5, 6600.0, 935.0])
[?2004l[?2004h> P_2D = fit_peak(2500, 2900, [2684.7, 17.0, 13070.0, 805.0])
[?2004l[?2004h> 
[?2004l[?2004h> ID_IG = float(P_D[2] / P_G[2])
[?2004l[?2004h> print('\nI_D/I_G = %.6f' % ID_IG)
[?2004l[?2004h> 
[?2004l[?2004h> results = {
[?2004l[?2004h>     'D':  {'x0': float(P_D[0]),  'gamma': float(P_D[1]),  'amplitude': float(P_D[2]),  'offset': float(P_D[3])},
[?2004l[?2004h>     'G':  {'x0': float(P_G[0]),  'gamma': float(P_G[1]),  'amplitude': float(P_G[2]),  'offset': float(P_G[3])},
[?2004l[?2004h>     '2D': {'x0': float(P_2D[0]), 'gamma': float(P_2D[1]), 'amplitude': float(P_2D[2]), 'offset': float(P_2D[3])},
[?2004l[?2004h>     'ID_IG': ID_IG,
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
