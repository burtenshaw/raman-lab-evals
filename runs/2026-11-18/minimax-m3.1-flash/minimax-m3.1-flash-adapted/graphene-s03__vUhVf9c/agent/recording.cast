[125.459478, "o", "\u001b[?2004h> "]
[125.459525, "o", "p4,_ = curve_fit(model4,x,y,p0=p04,maxfev=500000)\r\n\u001b[?2004l\r"]
[125.45957, "o", "\u001b[?2004h> r4 = y-model4(x,*p4)\r\n\u001b[?2004l\r"]
[125.459617, "o", "\u001b[?2004h> "]
[125.459651, "o", "print('\\nwith broad bg:', np.array2string(p4,precision=4))\r\n\u001b[?2004l\r"]
[125.459697, "o", "\u001b[?2004h> "]
[125.459734, "o", "print('rms %.2f' % np.sqrt(np.mean(r4**2)))\r\n\u001b[?2004l\r"]
