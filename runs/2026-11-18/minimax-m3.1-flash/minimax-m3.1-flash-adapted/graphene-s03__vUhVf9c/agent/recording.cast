[79.919926, "o", "\u001b[?2004hroot@j-openenv-6afd8c5a29e8b7ccfbbb82fa-oid57frt-851a1-tbrrt:/app# "]
[101.860053, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\ndef lor(x, amp, gam, x0, off):\n    return amp*gam**2/((x-x0)**2+gam**2) + off\n\ndef fit_window(lo, hi, guess):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p0 = [guess[0], guess[1], guess[2], guess[3]]\n    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\n    resid = ys - lor(xs, *p)\n    rms = np.sqrt(np.mean(resid**2))\n    return p, rms, len(xs)\n\nprint('--- per-peak window fits ---')\nsets = {\n 'D_narrow': (1180, 1500, (6000, 20, 1352, 1000)),\n 'D_wide':   (1120, 1520, (6000, 20, 1352, 1000)),\n 'G_narrow': (1500, 1800, (7500, 22, 1582, 1000)),\n 'G_wide':   (1470, 1900, (7500, 22, 1582, 1000)),\n '2D_narrow':(2450, 2950, (9800, 30, 2676, 1000)),\n '2D_wide':  (2350, 3000, (9800, 30, 2676, 1000)),\n}\nfor k,(lo,hi,g) in sets.items():\n    p, rms, n = fit_window(lo,hi,g)\n    print('%-10s win=[%d,%d] n=%d  amp=%10.2f gam=%8.3f x0=%9.3f"]
[101.860206, "i", " off=%9.2f rms=%8.2f' % (k,lo,hi,n,p[0],p[1],p[2],p[3],rms))\n\nprint()\nprint('--- global simultaneous fit (3 Lorentzians + 1 offset) ---')\ndef model(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off):\n    return (a1*g1**2/((x-x1)**2+g1**2)+a2*g2**2/((x-x2)**2+g2**2)+a3*g3**2/((x-x3)**2+g3**2)+off)\np0 = [6000,20,1352, 7500,22,1582, 9800,30,2676, 1000]\np, cov = curve_fit(model, x, y, p0=p0, maxfev=500000)\nresid = y - model(x,*p)\nprint('params:', np.array2string(p, precision=4))\nprint('rms full = %.2f' % np.sqrt(np.mean(resid**2)))\nfor name,lo,hi in (('D',1150,1500),('G',1500,1800),('2D',2450,2950)):\n    m=(x>=lo)&(x<=hi)\n    print('  %s window rms = %.2f  bias(mean resid)= %.2f' % (name, np.sqrt(np.mean(resid[m]**2)), resid[m].mean()))\nEOF\npython3 /app/fit_test.py\n"]
[101.860289, "o", "cat > /app/fit_test.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.860345, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.860446, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[101.860471, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.860533, "o", "d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.860544, "o", "x = d[:,0]; y = d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.860587, "o", "> \r\n\u001b[?2004l\r"]
[101.860631, "o", "\u001b[?2004h> "]
[101.860666, "o", "def lor(x, amp, gam, x0, off):\r\n\u001b[?2004l\r"]
[101.860697, "o", "\u001b[?2004h> "]
[101.86075, "o", "    return amp*gam**2/((x-x0)**2+gam**2) + off\r\n\u001b[?2004l\r"]
[101.860779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.86081, "o", "\u001b[?2004h> "]
[101.86086, "o", "def fit_window(lo, hi, guess):\r\n\u001b[?2004l\r"]
[101.860879, "o", "\u001b[?2004h> "]
[101.860964, "o", "    m = (x>=lo)&(x<=hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.861005, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.861058, "o", "    p0 = [guess[0], guess[1], guess[2], guess[3]]\r\n\u001b[?2004l\r"]
[101.861086, "o", "\u001b[?2004h> "]
[101.861159, "o", "    p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r"]
[101.861189, "o", "\u001b[?2004h> "]
[101.861226, "o", "    resid = ys - lor(xs, *p)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.861257, "o", "> "]
[101.861295, "o", "    rms = np.sqrt(np.mean(resid**2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.86133, "o", "> "]
[101.861367, "o", "    return p, rms, len(xs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.861405, "o", "\r\n\u001b[?2004l\r"]
[101.861434, "o", "\u001b[?2004h> "]
[101.861465, "o", "print('--- per-peak window fits ---')\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.861506, "o", "> sets = {\r\n\u001b[?2004l\r"]
[101.861537, "o", "\u001b[?2004h> "]
[101.861577, "o", " 'D_narrow': (1180, 1500, (6000, 20, 1352, 1000)),\r\n\u001b[?2004l\r"]
[101.861587, "o", "\u001b[?2004h> "]
[101.861663, "o", " 'D_wide':   (1120, 1520, (6000, 20, 1352, 1000)),\r\n\u001b[?2004l\r"]
[101.861695, "o", "\u001b[?2004h> "]
[101.86175, "o", " 'G_narrow': (1500, 1800, (7500, 22, 1582, 1000)),\r\n\u001b[?2004l\r"]
[101.861785, "o", "\u001b[?2004h> "]
[101.861835, "o", " 'G_wide':   (1470, 1900, (7500, 22, 1582, 1000)),\r\n\u001b[?2004l\r"]
[101.861866, "o", "\u001b[?2004h> "]
[101.861922, "o", " '2D_narrow':(2450, 2950, (9800, 30, 2676, 1000)),\r\n\u001b[?2004l\r"]
[101.861957, "o", "\u001b[?2004h> "]
[101.862008, "o", " '2D_wide':  (2350, 3000, (9800, 30, 2676, 1000)),\r\n\u001b[?2004l\r"]
[101.862028, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[101.862065, "o", "\u001b[?2004h> "]
[101.862096, "o", "for k,(lo,hi,g) in sets.items():\r\n\u001b[?2004l\r"]
[101.862105, "o", "\u001b[?2004h> "]
[101.862165, "o", "    p, rms, n = fit_window(lo,hi,g)\r\n\u001b[?2004l\r"]
[101.862175, "o", "\u001b[?2004h> "]
[101.862371, "o", "    print('%-10s win=[%d,%d] n=%d  amp=%10.2f gam=%8.3f x0=%9.3f off=%9.2f rms=%8.2f' % (k,lo,hi,n,p[0],p[1],p[2],p[3],rms))\r\n\u001b[?2004l\r"]
[101.862412, "o", "\u001b[?2004h"]
[101.862451, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.862488, "o", "print()\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.862513, "o", "> "]
[101.862604, "o", "print('--- global simultaneous fit (3 Lorentzians + 1 offset) ---')\r\n\u001b[?2004l\r"]
[101.862654, "o", "\u001b[?2004h> "]
[101.862715, "o", "def model(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off):\r\n\u001b[?2004l\r"]
[101.862751, "o", "\u001b[?2004h> "]
[101.862927, "o", "    return (a1*g1**2/((x-x1)**2+g1**2)+a2*g2**2/((x-x2)**2+g2**2)+a3*g3**2/((x-x3)**2+g3**2)+off)\r\n\u001b[?2004l\r"]
[101.862967, "o", "\u001b[?2004h> "]
[101.863024, "o", "p0 = [6000,20,1352, 7500,22,1582, 9800,30,2676, 1000]\r\n\u001b[?2004l\r"]
[101.863054, "o", "\u001b[?2004h> "]
[101.863114, "o", "p, cov = curve_fit(model, x, y, p0=p0, maxfev=500000)\r\n\u001b[?2004l\r"]
[101.863159, "o", "\u001b[?2004h> "]
[101.863192, "o", "resid = y - model(x,*p)\r\n\u001b[?2004l\r"]
[101.863234, "o", "\u001b[?2004h> "]
[101.863272, "o", "print('params:', np.array2string(p, precision=4))\r\n\u001b[?2004l\r"]
[101.863308, "o", "\u001b[?2004h> "]
[101.863362, "o", "print('rms full = %.2f' % np.sqrt(np.mean(resid**2)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.86346, "o", "for name,lo,hi in (('D',1150,1500),('G',1500,1800),('2D',2450,2950)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.863507, "o", "    m=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[101.863548, "o", "\u001b[?2004h> "]
[101.863678, "o", "    print('  %s window rms = %.2f  bias(mean resid)= %.2f' % (name, np.sqrt(np.mean(resid[m]**2)), resid[m].mean()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.863718, "o", "EOF\r\n\u001b[?2004l\r"]
[101.864905, "o", "\u001b[?2004hroot@j-openenv-6afd8c5a29e8b7ccfbbb82fa-oid57frt-851a1-tbrrt:/app# "]
