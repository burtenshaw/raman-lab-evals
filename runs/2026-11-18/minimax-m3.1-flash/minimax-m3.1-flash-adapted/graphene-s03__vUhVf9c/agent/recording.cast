[148.095545, "i", "cat > /app/scan.py << 'EOF'\nimport numpy as np, itertools\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx=d[:,0]; y=d[:,1]\ndef lor(x,a,g,x0,o): return a*g**2/((x-x0)**2+g**2)+o\ndef fw(lo,hi,p0):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,c=curve_fit(lor,xs,ys,p0=p0,maxfev=200000)\n    e=np.sqrt(np.diag(c))\n    r=ys-lor(xs,*p)\n    return p,e,np.sqrt(np.mean(r**2)),m.sum()\n\ncases={\n 'D': [(1150,1500),(1180,1500),(1200,1500),(1150,1480),(1120,1500),(1200,1480)],\n 'G': [(1470,1800),(1500,1800),(1500,1750),(1520,1800),(1470,1850),(1500,1900)],\n '2D':[(2450,2950),(2500,2950),(2450,2900),(2500,2900),(2400,2950),(2500,3000)],\n}\ng0={'D':[6000,19,1355,900],'G':[7500,11,1583,900],'2D':[10000,28,2676,800]}\nres={}\nfor k,wl in cases.items():\n    print('==',k)\n    arr=[]\n    for lo,hi in wl:\n        p,e,rms,n=fw(lo,hi,g0[k])\n        arr.append(p)\n        print('  [%d,%d] amp=%9.3f(+-%.2f) gam=%7.4f(+-%.4f) x0=%9.4f(+-%.3f) off=%8.3f(+-%.2f) rms=%.2f n=%d'%(lo,hi,p[0],e["]
[148.095704, "i", "0],p[1],e[1],p[2],e[2],p[3],e[3],rms,n))\n    a=np.array(arr)\n    print('  mean:', np.array2string(a.mean(axis=0),precision=4), ' std:', np.array2string(a.std(axis=0),precision=4))\n    res[k]=a.mean(axis=0)\nprint('\\nID/IG using window means: %.5f'%(res['D'][0]/res['G'][0]))\nEOF\npython3 /app/scan.py\n"]
