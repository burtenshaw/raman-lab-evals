[79.70766, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\nprint('N=', len(x), 'x range', x[0], x[-1], 'dx', x[1]-x[0])\nprint('y min/max/median', y.min(), y.max(), np.median(y))\nfor target in (1350., 1580., 2690.):\n    m = np.abs(x-target) < 200\n    xs, ys = x[m], y[m]\n    # local maxima\n    idx = np.argsort(ys)[-5:]\n    print('\\ntarget', target)\n    for i in sorted(idx):\n        print('   candidate x=%.2f y=%.1f' % (xs[i], ys[i]))\n    # print binned profile\n    bins = np.arange(target-200, target+200.1, 20.0)\n    for b in bins[:-1]:\n        sel = (x>=b)&(x<b+20)\n        if sel.sum():\n            print('   %7.1f-%7.1f  mean=%9.1f max=%9.1f' % (b, b+20, y[sel].mean(), y[sel].max()))\nEOF\npython3 /app/explore.py\n"]
