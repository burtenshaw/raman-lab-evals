[125.457713, "o", "\u001b[?2004h> "]
[125.457751, "o", "    m=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[125.457789, "o", "\u001b[?2004h> "]
[125.457864, "o", "    print('noise region %d-%d: std=%.1f mean=%.1f' % (lo,hi,y[m].std(),y[m].mean()))\r\n\u001b[?2004l\r"]
[125.457893, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.457945, "o", "> "]
