[176.876388, "o", "> "]
[176.876573, "o", "    print('%-3s window=[%g,%g] n=%d  amp=%.4f+-%.4f  gamma=%.4f+-%.4f  x0=%.4f+-%.4f  offset=%.4f+-%.4f  rms=%.2f'\r\n\u001b[?2004l\r"]
[176.876668, "o", "\u001b[?2004h> "]
[176.87678, "o", "          % (name, lo, hi, m.sum(), amp, perr[0], gam, perr[1], x0, perr[2], off, perr[3], rms))\r\n\u001b[?2004l\r"]
[176.87683, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
