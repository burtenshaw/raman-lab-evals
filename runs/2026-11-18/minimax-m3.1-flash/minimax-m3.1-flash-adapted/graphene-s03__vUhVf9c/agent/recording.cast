[125.456995, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = d[:,0]; y = d[:,1]\n\n# noise estimate in flat regions\nfor lo,hi in ((1900,2300),(2300,2450),(2900,3000),(1100,1180)):\n    m=(x>=lo)&(x<=hi)\n    print('noise region %d-%d: std=%.1f mean=%.1f' % (lo,hi,y[m].std(),y[m].mean()))\n\ndef model3(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off):\n    return (a1*g1**2/((x-x1)**2+g1**2)+a2*g2**2/((x-x2)**2+g2**2)+a3*g3**2/((x-x3)**2+g3**2)+off)\n\np0 = [6000,19,1355, 7500,11,1583, 10000,28,2676, 900]\np,cov = curve_fit(model3,x,y,p0=p0,maxfev=500000)\nresid = y-model3(x,*p)\nprint('\\nglobal 3L+off params:', np.array2string(p,precision=4))\nprint('global rms %.2f' % np.sqrt(np.mean(resid**2)))\nprint('binned residuals (mean per 100 cm-1):')\nfor b in np.arange(1100,3000,100.0):\n    m=(x>=b)&(x<b+100)\n    print('  %6.0f  mean=%8.1f  rms=%7.1f  n=%d' % (b,resid[m].mean(),np.sqrt(np.mean(resid[m]**2)),m.sum()))\n\n# with broad background\ndef model4(x, "]
[125.457119, "i", "a1,g1,x1,a2,g2,x2,a3,g3,x3,off,a4,g4,x4):\n    return model3(x,a1,g1,x1,a2,g2,x2,a3,g3,x3,off) + a4*g4**2/((x-x4)**2+g4**2)\np04 = list(p)+[5000,300,2000]\np4,_ = curve_fit(model4,x,y,p0=p04,maxfev=500000)\nr4 = y-model4(x,*p4)\nprint('\\nwith broad bg:', np.array2string(p4,precision=4))\nprint('rms %.2f' % np.sqrt(np.mean(r4**2)))\nEOF\npython3 /app/diag.py\n"]
[125.457216, "o", "cat > /app/diag.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
