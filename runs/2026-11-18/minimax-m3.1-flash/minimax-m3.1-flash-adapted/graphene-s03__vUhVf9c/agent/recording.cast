[125.458904, "o", "\u001b[?2004h> "]
[125.459018, "o", "    print('  %6.0f  mean=%8.1f  rms=%7.1f  n=%d' % (b,resid[m].mean(),np.sqrt(np.mean(resid[m]**2)),m.sum()))\r\n\u001b[?2004l\r"]
[125.45906, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.459097, "o", "> "]
[125.459135, "o", "# with broad background\r\n\u001b[?2004l\r"]
[125.459174, "o", "\u001b[?2004h> "]
[125.459215, "o", "def model4(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off,a4,g4,x4):\r\n\u001b[?2004l\r"]
[125.459255, "o", "\u001b[?2004h> "]
[125.459341, "o", "    return model3(x,a1,g1,x1,a2,g2,x2,a3,g3,x3,off) + a4*g4**2/((x-x4)**2+g4**2)\r\n\u001b[?2004l\r"]
[125.459386, "o", "\u001b[?2004h> "]
