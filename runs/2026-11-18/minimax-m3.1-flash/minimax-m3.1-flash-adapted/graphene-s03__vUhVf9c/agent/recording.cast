[125.458143, "o", "    return (a1*g1**2/((x-x1)**2+g1**2)+a2*g2**2/((x-x2)**2+g2**2)+a3*g3**2/((x-x3)**2+g3**2)+off)\r\n\u001b[?2004l\r"]
