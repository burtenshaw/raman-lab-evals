[?2004hroot@j-openenv-6afd8c5a29e8b7ccfbbb82fa-oid57frt-851a1-tbrrt:/app# cat > /app/fit_test.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = d[:,0]; y = d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, gam, x0, off):
[?2004l[?2004h>     return amp*gam**2/((x-x0)**2+gam**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def fit_window(lo, hi, guess):
[?2004l[?2004h>     m = (x>=lo)&(x<=hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     p0 = [guess[0], guess[1], guess[2], guess[3]]
[?2004l[?2004h>     p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     resid = ys - lor(xs, *p)
[?2004l[?2004h>     rms = np.sqrt(np.mean(resid**2))
[?2004l[?2004h>     return p, rms, len(xs)
[?2004l[?2004h> 
[?2004l[?2004h> print('--- per-peak window fits ---')
[?2004l[?2004h> sets = {
[?2004l[?2004h>  'D_narrow': (1180, 1500, (6000, 20, 1352, 1000)),
[?2004l[?2004h>  'D_wide':   (1120, 1520, (6000, 20, 1352, 1000)),
[?2004l[?2004h>  'G_narrow': (1500, 1800, (7500, 22, 1582, 1000)),
[?2004l[?2004h>  'G_wide':   (1470, 1900, (7500, 22, 1582, 1000)),
[?2004l[?2004h>  '2D_narrow':(2450, 2950, (9800, 30, 2676, 1000)),
[?2004l[?2004h>  '2D_wide':  (2350, 3000, (9800, 30, 2676, 1000)),
[?2004l[?2004h> }
[?2004l[?2004h> for k,(lo,hi,g) in sets.items():
[?2004l[?2004h>     p, rms, n = fit_window(lo,hi,g)
[?2004l[?2004h>     print('%-10s win=[%d,%d] n=%d  amp=%10.2f gam=%8.3f x0=%9.3f off=%9.2f rms=%8.2f' % (k,lo,hi,n,p[0],p[1],p[2],p[3],rms))
[?2004l[?2004h> 
[?2004l[?2004h> print()
[?2004l[?2004h> print('--- global simultaneous fit (3 Lorentzians + 1 offset) ---')
[?2004l[?2004h> def model(x, a1,g1,x1,a2,g2,x2,a3,g3,x3,off):
[?2004l[?2004h>     return (a1*g1**2/((x-x1)**2+g1**2)+a2*g2**2/((x-x2)**2+g2**2)+a3*g3**2/((x-x3)**2+g3**2)+off)
[?2004l[?2004h> p0 = [6000,20,1352, 7500,22,1582, 9800,30,2676, 1000]
[?2004l[?2004h> p, cov = curve_fit(model, x, y, p0=p0, maxfev=500000)
[?2004l[?2004h> resid = y - model(x,*p)
[?2004l[?2004h> print('params:', np.array2string(p, precision=4))
[?2004l[?2004h> print('rms full = %.2f' % np.sqrt(np.mean(resid**2)))
[?2004l[?2004h> for name,lo,hi in (('D',1150,1500),('G',1500,1800),('2D',2450,2950)):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     print('  %s window rms = %.2f  bias(mean resid)= %.2f' % (name, np.sqrt(np.mean(resid[m]**2)), resid[m].mean()))
[?2004l[?2004h> EOF
