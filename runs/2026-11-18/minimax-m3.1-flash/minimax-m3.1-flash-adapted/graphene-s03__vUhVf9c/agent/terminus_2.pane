[?2004hroot@j-openenv-6afd8c5a29e8b7ccfbbb82fa-oid57frt-851a1-tbrrt:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> windows = {
[?2004l[?2004h>     'D':  (1150.0, 1500.0, [6000.0, 19.0, 1355.0, 900.0]),
[?2004l[?2004h>     'G':  (1500.0, 1800.0, [7500.0, 11.0, 1583.0, 900.0]),
[?2004l[?2004h>     '2D': (2450.0, 2950.0, [10000.0, 28.0, 2676.0, 800.0]),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, (lo, hi, p0) in windows.items():
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     resid = ys - lorentzian(xs, *popt)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     amp, gam, x0, off = (float(v) for v in popt)
[?2004l[?2004h>     results[name] = {'x0': x0, 'gamma': gam, 'amplitude': amp, 'offset': off}
[?2004l[?2004h>     print('%-3s window=[%g,%g] n=%d  amp=%.4f+-%.4f  gamma=%.4f+-%.4f  x0=%.4f+-%.4f  offset=%.4f+-%.4f  rms=%.2f'
[?2004l[?2004h>           % (name, lo, hi, m.sum(), amp, perr[0], gam, perr[1], x0, perr[2], off, perr[3], rms))
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = results['D']['amplitude'] / results['G']['amplitude']
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> print('\nID_IG = %.6f' % results['ID_IG'])
