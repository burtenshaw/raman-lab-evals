[113.307756, "i", "cat > /app/global_fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1']); y = np.asarray(d['intensity'])\n\ndef model(x, aD,gD,xD, aG,gG,xG, a2,g2,x2, c0, c1=0.0, c2=0.0):\n    L = lambda a,g,x0: a*g*g/((x-x0)**2+g*g)\n    return L(aD,gD,xD)+L(aG,gG,xG)+L(a2,g2,x2)+c0+c1*(x-2000)/1000+c2*((x-2000)/1000)**2\n\np0 = [6000,18.5,1355, 7500,11,1583.5, 10000,28.5,2676.5, 900,0,0]\nfor nbg,name in [(1,'const'),(2,'linear'),(3,'quad')]:\n    p,cov = curve_fit(model, x, y, p0=p0[:9+nbg], maxfev=200000)\n    r = y - model(x, *p)\n    print(name, 'rmse=%.2f'%np.sqrt(np.mean(r**2)))\n    labels = ['aD','gD','xD','aG','gG','xG','a2','g2','x2','c0','c1','c2'][:9+nbg]\n    for lab,val in zip(labels,p):\n        print('   %-4s %12.4f'%(lab,val))\n    if nbg==1:\n        # binned residual means to look for structure\n        bins = np.arange(1100,3010,50)\n        print('   residual means per 50 cm-1:')\n        for i in ran"]
[113.307915, "i", "ge(len(bins)-1):\n            m=(x>=bins[i])&(x<bins[i+1])\n            if m.sum(): print('     %6.0f  %8.1f (n=%d)'%(bins[i], r[m].mean(), m.sum()))\nEOF\npython3 /app/global_fit.py\n"]
