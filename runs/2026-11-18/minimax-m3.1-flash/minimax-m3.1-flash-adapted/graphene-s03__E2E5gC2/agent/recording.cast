[62.035428, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7f-2535sown-f64b4-8d2h8:/app# "]
[86.502279, "i", "cat > /app/fit_explore.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1']); y = np.asarray(d['intensity'])\n\ndef lor(x, amp, gamma, x0, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ndef guess(xw, yw):\n    off = np.percentile(yw, 10)\n    i = np.argmax(yw)\n    amp = yw[i]-off\n    half = off + amp/2\n    above = xw[yw>=half]\n    gamma = max((above.max()-above.min())/2, 5.0) if above.size>1 else 20.0\n    return amp, gamma, xw[i], off\n\ndef fit(xw, yw):\n    p0 = guess(xw, yw)\n    p, cov = curve_fit(lor, xw, yw, p0=p0, maxfev=100000)\n    r = yw - lor(xw, *p)\n    rmse = np.sqrt(np.mean(r**2))\n    perr = np.sqrt(np.diag(cov))\n    return p, perr, rmse\n\nwindows = {\n 'D':  [(1230,1470),(1250,1450),(1270,1440),(1200,1500),(1280,1420)],\n 'G':  [(1470,1700),(1500,1660),(1510,1650),(1450,1720),(1530,1640)],\n '2D': [(2530,2850),(2570,2810),(2580,2800),(2500,2900),(2600,2780)],\n}\ncenters = {'D':1350"]
[86.502436, "i", ",'G':1580,'2D':2690}\nfor name, wins in windows.items():\n    print('===', name)\n    for (lo,hi) in wins:\n        m = (x>=lo)&(x<=hi)\n        p, perr, rmse = fit(x[m], y[m])\n        print(f'win {lo}-{hi} n={m.sum():4d}  amp={p[0]:9.2f}+-{perr[0]:5.2f} gamma={p[1]:7.3f}+-{perr[1]:5.3f} x0={p[2]:8.3f}+-{perr[2]:5.3f} off={p[3]:8.2f}+-{perr[3]:5.2f} rmse={rmse:7.2f}')\nEOF\npython3 /app/fit_explore.py\n"]
[86.502514, "o", "cat > /app/fit_explore.py << 'EOF'\r\n\u001b[?2004l\r"]
[86.5026, "o", ",'G':1580,'2D':2690}\r\nfor name, wins in windows.items():\r\n    print('===', name)\r\n    for (lo,hi) in wins:\r\n        m = (x>=lo)&(x<=hi)\r\n        p, perr, rmse = fit(x[m], y[m])\r\n        print(f'win {lo}-{hi} n={m.sum():4d}  amp={p[0]:9.2f}+-{perr[0]:5.2f} gamma={p[1]:7.3f}+-{perr[1]:5.3f} x0={p[2]:8.3f}+-{perr[2]:5.3f} off={p[3]:8.2f}+-{perr[3]:5.2f} rmse={rmse:7.2f}')\r\nEOF\r\npython3 /app/fit_explore.py\r\n"]
