[61.768064, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1'] if 'raman_shift_cm1' in d.dtype.names else d[d.dtype.names[0]]\ny = d['intensity']\nprint(d.dtype.names, x.size, x.min(), x.max(), x[1]-x[0])\nprint('y stats', y.min(), y.max(), np.median(y))\nbins = np.arange(1100, 3010, 25)\nfor i in range(len(bins)-1):\n    m = (x>=bins[i]) & (x<bins[i+1])\n    if m.sum():\n        j = np.argmax(y[m])\n        print(f\"{bins[i]:6.0f}-{bins[i+1]:6.0f} max={y[m][j]:9.1f} at {x[m][j]:8.2f} med={np.median(y[m]):8.1f}\")\nEOF\npython3 /app/explore.py\n"]
