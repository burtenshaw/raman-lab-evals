[170.74335, "i", "python3 -c \"import json; r=json.load(open('/app/results.json')); assert set(r)=={'D','G','2D','ID_IG'}; [assertion for assertion in [all(set(r[k])=={'x0','gamma','amplitude','offset'} for k in ['D','G','2D'])] ]; assert abs(r['ID_IG']-r['D']['amplitude']/r['G']['amplitude'])<1e-12; print('JSON OK', r['ID_IG'])\"\n"]
[170.743834, "o", "python3 -c \"import json; r=json.load(open('/app/results.json')); assert set(r)=={'D','G','2D','ID_IG'}; [assertion for assertion in [all(set(r[k])=={'x0','gamma','amplitude','offset'} for k in ['D','G','2D'])] ]; assert abs(r['ID_IG']-r['D']['amplitude']/r['G']['amplitude'])<1e-12; print('JSON OK', r['ID_IG'])\"\r\n\u001b[?2004l\r"]
