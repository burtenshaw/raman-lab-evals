[152.48352, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[152.483566, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.483598, "o", "\u001b[?2004h> "]
[152.48368, "o", "d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r"]
[152.483724, "o", "\u001b[?2004h> "]
[152.483778, "o", "x = np.asarray(d['raman_shift_cm1'], dtype=float)\r\n\u001b[?2004l\r"]
[152.483926, "o", "\u001b[?2004h> "]
[152.483998, "o", "y = np.asarray(d['intensity'], dtype=float)\r\n\u001b[?2004l\r"]
[152.484081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[152.484117, "o", "> "]
[152.484153, "o", "def lorentzian(x, amplitude, gamma, x0, offset):\r\n\u001b[?2004l\r"]
[152.484187, "o", "\u001b[?2004h> "]
[152.484261, "o", "    return amplitude*gamma**2/((x-x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[152.484295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.484317, "o", "\u001b[?2004h> "]
[152.48437, "o", "def fit_peak(x, y, lo, hi, center):\r\n\u001b[?2004l\r"]
[152.484404, "o", "\u001b[?2004h> "]
[152.484447, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[152.484457, "o", "\u001b[?2004h> "]
[152.48452, "o", "    xw, yw = x[m], y[m]\r\n\u001b[?2004l\r"]
[152.484553, "o", "\u001b[?2004h> "]
[152.484609, "o", "    off0 = float(np.percentile(yw, 10))\r\n\u001b[?2004l\r"]
[152.484642, "o", "\u001b[?2004h> "]
[152.484699, "o", "    i = int(np.argmin(np.abs(xw - center)))\r\n\u001b[?2004l\r"]
[152.484732, "o", "\u001b[?2004h> "]
[152.484776, "o", "    amp0 = float(yw[i] - off0)\r\n\u001b[?2004l\r"]
[152.484786, "o", "\u001b[?2004h> "]
[152.484848, "o", "    half = off0 + amp0/2.0\r\n\u001b[?2004l\r"]
[152.48488, "o", "\u001b[?2004h> "]
[152.484913, "o", "    above = xw[yw >= half]\r\n\u001b[?2004l\r"]
[152.48495, "o", "\u001b[?2004h> "]
[152.485051, "o", "    g0 = float(max((above.max()-above.min())/2.0, 3.0)) if above.size > 1 else 15.0\r\n\u001b[?2004l\r"]
[152.485059, "o", "\u001b[?2004h> "]
[152.485137, "o", "    p0 = [amp0, g0, float(xw[i]), off0]\r\n\u001b[?2004l\r"]
[152.485195, "o", "\u001b[?2004h> "]
[152.485236, "o", "    p, cov = curve_fit(lorentzian, xw, yw, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r"]
[152.485276, "o", "\u001b[?2004h> "]
[152.4853, "o", "    resid = yw - lorentzian(xw, *p)\r\n\u001b[?2004l\r"]
[152.485327, "o", "\u001b[?2004h> "]
[152.48537, "o", "    err = np.sqrt(np.diag(cov))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.485636, "o", "    print(f'window {lo}-{hi} n={m.sum()}  amplitude={p[0]:.3f}+-{err[0]:.3f}  gamma={p[1]:.4f}+-{err[1]:.4f}  x0={p[2]:.4f}+-{err[2]:.4f}  offset={p[3]:.3f}+-{err[3]:.3f}  rmse={np.sqrt(np.mean(resid**2)):.2f}')\r\n\u001b[?2004l\r"]
[152.485677, "o", "\u001b[?2004h> "]
[152.485717, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.485761, "o", "peaks = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.485796, "o", "    'D':  ((1230.0, 1470.0), 1355.0),\r\n\u001b[?2004l\r"]
[152.485837, "o", "\u001b[?2004h> "]
[152.485873, "o", "    'G':  ((1470.0, 1700.0), 1583.0),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.485922, "o", "    '2D': ((2480.0, 2880.0), 2677.0),\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[152.485958, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.486004, "o", "\u001b[?2004h> "]
[152.486039, "o", "results = {}\r\n\u001b[?2004l\r\u001b[?2004h> params = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486074, "o", "for name, ((lo, hi), c) in peaks.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486135, "o", "    p = fit_peak(x, y, lo, hi, c)\r\n\u001b[?2004l\r"]
[152.486165, "o", "\u001b[?2004h> "]
[152.486175, "o", "    params[name] = p\r\n\u001b[?2004l\r"]
[152.486228, "o", "\u001b[?2004h>     results[name] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486273, "o", "        'x0': float(p[2]),\r\n\u001b[?2004l\r"]
[152.486302, "o", "\u001b[?2004h> "]
[152.486346, "o", "        'gamma': float(p[1]),\r\n\u001b[?2004l\r"]
[152.486377, "o", "\u001b[?2004h> "]
[152.486424, "o", "        'amplitude': float(p[0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486454, "o", "        'offset': float(p[3]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486495, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.486527, "o", "\u001b[?2004h> "]
[152.486572, "o", "results['ID_IG'] = float(params['D'][0] / params['G'][0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486604, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486636, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[152.486671, "o", "\u001b[?2004h> "]
[152.486706, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[152.486753, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486793, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.486807, "o", "EOF\r\n\u001b[?2004l\r"]
[152.488273, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7f-2535sown-f64b4-8d2h8:/app# "]
[152.48836, "o", "python3 /app/fit_final.py\r\n\u001b[?2004l\r"]
[153.133081, "o", "window 1230.0-1470.0 n=480  amplitude=5996.628+-14.732  gamma=18.5362+-0.0837  x0=1354.9117+-0.0450  offset=920.200+-6.022  rmse=78.14\r\n"]
[153.133726, "o", "window 1470.0-1700.0 n=460  amplitude=7484.094+-21.277  gamma=10.8917+-0.0513  x0=1583.3956+-0.0309  offset=936.931+-5.593  rmse=87.42\r\n"]
[153.134321, "o", "window 2480.0-2880.0 n=800  amplitude=9972.090+-12.464  gamma=28.5505+-0.0643  x0=2676.5320+-0.0353  offset=787.731+-4.717  rmse=82.45\r\n"]
[153.134599, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1354.9116964863022,\r\n    \"gamma\": 18.53624440202318,\r\n    \"amplitude\": 5996.628355767796,\r\n    \"offset\": 920.2003447998704\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1583.395620737137,\r\n    \"gamma\": 10.891703534529226,\r\n    \"amplitude\": 7484.0936263205795,\r\n    \"offset\": 936.9312543991475\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2676.5320093630057,\r\n    \"gamma\": 28.55049673924947,\r\n    \"amplitude\": 9972.089744236,\r\n    \"offset\": 787.7311551009635\r\n  },\r\n  \"ID_IG\": 0.8012497778860539\r\n}"]
[153.134652, "o", "\r\n"]
[153.192411, "o", "\u001b[?2004hroot@j-openenv-6afd8a86e5cad0e4dc3e6b7f-2535sown-f64b4-8d2h8:/app# "]
[170.543092, "i", "cat /app/results.json\n"]
[170.543258, "o", "cat /app/results.json\r\n\u001b[?2004l\r"]
