[86.503527, "o", "    half = off + amp/2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.503623, "o", "    above = xw[yw>=half]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.50366, "o", "    gamma = max((above.max()-above.min())/2, 5.0) if above.size>1 else 20.0\r\n\u001b[?2004l\r"]
[86.503691, "o", "\u001b[?2004h> "]
[86.503747, "o", "    return amp, gamma, xw[i], off\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.503796, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.503871, "o", "def fit(xw, yw):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.503918, "o", "    p0 = guess(xw, yw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.503932, "o", "> "]
[86.504051, "o", "    p, cov = curve_fit(lor, xw, yw, p0=p0, maxfev=100000)\r\n\u001b[?2004l\r"]
[86.504094, "o", "\u001b[?2004h> "]
[86.504122, "o", "    r = yw - lor(xw, *p)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.504149, "o", "> "]
[86.504183, "o", "    rmse = np.sqrt(np.mean(r**2))\r\n\u001b[?2004l\r"]
[86.504238, "o", "\u001b[?2004h> "]
[86.504301, "o", "    perr = np.sqrt(np.diag(cov))\r\n\u001b[?2004l\r"]
[86.504344, "o", "\u001b[?2004h> "]
[86.504386, "o", "    return p, perr, rmse\r\n\u001b[?2004l\r\u001b[?2004h> "]
