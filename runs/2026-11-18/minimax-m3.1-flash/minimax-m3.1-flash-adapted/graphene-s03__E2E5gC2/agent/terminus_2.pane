[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.asarray(d['raman_shift_cm1']); y = np.asarray(d['intensity'])
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, gamma, x0, off):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def guess(xw, yw):
[?2004l[?2004h>     off = np.percentile(yw, 10)
[?2004l[?2004h>     i = np.argmax(yw)
[?2004l[?2004h>     amp = yw[i]-off
[?2004l[?2004h>     half = off + amp/2
[?2004l[?2004h>     above = xw[yw>=half]
[?2004l[?2004h>     gamma = max((above.max()-above.min())/2, 5.0) if above.size>1 else 20.0
[?2004l[?2004h>     return amp, gamma, xw[i], off
[?2004l[?2004h> 
[?2004l[?2004h> def fit(xw, yw):
[?2004l[?2004h>     p0 = guess(xw, yw)
[?2004l[?2004h>     p, cov = curve_fit(lor, xw, yw, p0=p0, maxfev=100000)
[?2004l[?2004h>     r = yw - lor(xw, *p)
[?2004l[?2004h>     rmse = np.sqrt(np.mean(r**2))
[?2004l[?2004h>     perr = np.sqrt(np.diag(cov))
[?2004l[?2004h>     return p, perr, rmse
[?2004l[?2004h> 
