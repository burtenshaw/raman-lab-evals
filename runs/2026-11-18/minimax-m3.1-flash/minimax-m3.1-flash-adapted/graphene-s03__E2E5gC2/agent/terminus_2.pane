[?2004l[?2004h> y = np.asarray(d['intensity'], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, gamma, x0, offset):
[?2004l[?2004h>     return amplitude*gamma**2/((x-x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, lo, hi, center):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xw, yw = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.percentile(yw, 10))
[?2004l[?2004h>     i = int(np.argmin(np.abs(xw - center)))
[?2004l[?2004h>     amp0 = float(yw[i] - off0)
[?2004l[?2004h>     half = off0 + amp0/2.0
[?2004l[?2004h>     above = xw[yw >= half]
[?2004l[?2004h>     g0 = float(max((above.max()-above.min())/2.0, 3.0)) if above.size > 1 else 15.0
[?2004l[?2004h>     p0 = [amp0, g0, float(xw[i]), off0]
[?2004l[?2004h>     p, cov = curve_fit(lorentzian, xw, yw, p0=p0, maxfev=200000)
[?2004l[?2004h>     resid = yw - lorentzian(xw, *p)
[?2004l[?2004h>     err = np.sqrt(np.diag(cov))
[?2004l[?2004h>     print(f'window {lo}-{hi} n={m.sum()}  amplitude={p[0]:.3f}+-{err[0]:.3f}  gamma={p[1]:.4f}+-{err[1]:.4f}  x0={p[2]:.4f}+-{err[2]:.4f}  offset={p[3]:.3f}+-{err[3]:.3f}  rmse={np.sqrt(np.mean(resid**2)):.2f}')
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D':  ((1230.0, 1470.0), 1355.0),
[?2004l[?2004h>     'G':  ((1470.0, 1700.0), 1583.0),
[?2004l[?2004h>     '2D': ((2480.0, 2880.0), 2677.0),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> params = {}
[?2004l[?2004h> for name, ((lo, hi), c) in peaks.items():
[?2004l[?2004h>     p = fit_peak(x, y, lo, hi, c)
[?2004l[?2004h>     params[name] = p
[?2004l[?2004h>     results[name] = {
[?2004l[?2004h>         'x0': float(p[2]),
[?2004l[?2004h>         'gamma': float(p[1]),
[?2004l[?2004h>         'amplitude': float(p[0]),
[?2004l[?2004h>         'offset': float(p[3]),
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(params['D'][0] / params['G'][0])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
