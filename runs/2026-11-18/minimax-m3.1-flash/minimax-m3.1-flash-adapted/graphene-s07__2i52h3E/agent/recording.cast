[129.193384, "i", "cat > /tmp/fit_test2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + off\ndef fit(lo, hi):\n    m = (x>=lo)&(x<=hi); xx, yy = x[m], y[m]\n    base = np.percentile(yy, 10); i = np.argmax(yy)\n    p, pc = curve_fit(lor, xx, yy, p0=[xx[i], 15.0, yy[i]-base, base], maxfev=200000)\n    perr = np.sqrt(np.diag(pc))\n    resid = lor(xx,*p)-yy\n    # binned residual means to reveal systematic slope\n    bs = []\n    for lo2 in np.arange(lo, hi, 50):\n        mm = (xx>=lo2)&(xx<lo2+50)\n        if mm.sum(): bs.append((lo2, resid[mm].mean()))\n    print(f'{lo}-{hi}: x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.2f} off={p[3]:.2f} rms={np.sqrt(np.mean(resid**2)):.1f}')\n    print('   err:', np.round(perr,3), ' binned resid means:', [(round(a),round(b,1)) for a,b in bs])\nfit(1250,1450)\nfit(1280,1420)\nfit(1300,1400)\nfit(1530,1630)\nfit(1540,1620)\nfit(1550,1"]
[129.193617, "i", "610)\nfit(2640,2740)\nfit(2620,2760)\nEOF\npython3 /tmp/fit_test2.py\n"]
