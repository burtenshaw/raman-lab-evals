[73.48451, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\nprint('n=', len(x), 'range', x.min(), x.max(), 'step', np.diff(x).mean())\nprint('median intensity', np.median(y), 'min', y.min(), 'max', y.max())\nfor lo, hi in [(1100,1250),(1250,1450),(1450,1550),(1500,1700),(1700,2000),(2000,2400),(2400,2600),(2550,2850),(2850,3000)]:\n    m = (x>=lo)&(x<=hi)\n    i = np.argmax(y[m])\n    print(f'{lo}-{hi}: max={y[m][i]:.1f} at x={x[m][i]:.1f}, median={np.median(y[m]):.1f}')\nEOF\npython3 /tmp/explore.py\n"]
