[126.192533, "i", "cat > /tmp/explore2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n# binned medians\nfor lo in range(1100, 3000, 100):\n    m = (x>=lo)&(x<lo+100)\n    print(lo, f'{np.median(y[m]):8.1f}', f'{np.mean(y[m]):8.1f}')\nEOF\npython3 /tmp/explore2.py\n"]
