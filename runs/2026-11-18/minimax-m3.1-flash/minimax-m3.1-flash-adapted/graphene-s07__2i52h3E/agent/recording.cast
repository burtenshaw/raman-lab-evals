[95.732163, "i", "cat > /tmp/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2 + gamma**2) + off\n\ndef fit(lo, hi, p0=None):\n    m = (x>=lo)&(x<=hi)\n    xx, yy = x[m], y[m]\n    if p0 is None:\n        base = np.percentile(yy, 10)\n        i = np.argmax(yy)\n        p0 = [xx[i], 20.0, yy[i]-base, base]\n    p, _ = curve_fit(lor, xx, yy, p0=p0, maxfev=200000)\n    resid = lor(xx,*p)-yy\n    print(f'win {lo}-{hi}: x0={p[0]:.3f} gamma={p[1]:.3f} amp={p[2]:.3f} off={p[3]:.3f} rms={np.sqrt(np.mean(resid**2)):.2f} npts={m.sum()}')\n    return p\n\nfor lo,hi in [(1150,1500),(1200,1500),(1250,1500),(1100,1500),(1200,1480)]:\n    fit(lo,hi)\nprint()\nfor lo,hi in [(1500,1800),(1520,1800),(1500,1900),(1450,1750),(1550,1850)]:\n    fit(lo,hi)\nprint()\nfor lo,hi in [(2400,3000),(2450,2950),(2500,2900),(2300,3000),(2550,2850),(2000,3000)]:\n    fit(lo,hi)\nEOF\npython3 /tmp/fit_t"]
[95.732276, "i", "est.py\n"]
