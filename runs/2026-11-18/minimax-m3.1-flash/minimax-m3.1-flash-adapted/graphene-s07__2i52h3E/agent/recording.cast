[222.801248, "i", "cat > /tmp/sweep.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\ndef lor(x, x0, g, a, o):\n    return a*g**2/((x-x0)**2+g**2)+o\ndef fit(lo,hi):\n    m=(x>=lo)&(x<=hi); xx,yy=x[m],y[m]\n    base=np.percentile(yy,10); i=np.argmax(yy)\n    p,_=curve_fit(lor,xx,yy,p0=[xx[i],15.0,yy[i]-base,base],maxfev=200000)\n    return p\nprint('--- D windows ---')\nfor lo,hi in [(1150,1500),(1200,1500),(1250,1450),(1250,1500),(1200,1480),(1280,1420)]:\n    p=fit(lo,hi); print(f'{lo}-{hi} x0={p[0]:.3f} g={p[1]:.3f} a={p[2]:.1f} o={p[3]:.1f}')\nprint('--- G windows ---')\nfor lo,hi in [(1480,1700),(1500,1700),(1500,1800),(1520,1680),(1530,1630),(1450,1750)]:\n    p=fit(lo,hi); print(f'{lo}-{hi} x0={p[0]:.3f} g={p[1]:.3f} a={p[2]:.1f} o={p[3]:.1f}')\nprint('--- 2D windows ---')\nfor lo,hi in [(2450,2950),(2500,2900),(2550,2850),(2600,2800),(2550,2900),(2400,3000)]:\n    p=fit(lo,hi); print(f'{lo}-{hi} x0={p[0]:.3f} g={p[1]:.3f} a={p[2]:.1f"]
[222.801413, "i", "} o={p[3]:.1f}')\nprint('--- ID/IG for matched window widths ---')\nfor w in [(1200,1500,1450,1750,2450,2950),(1250,1450,1500,1700,2550,2850),(1150,1500,1480,1700,2400,3000)]:\n    pd_=fit(w[0],w[1]); pg=fit(w[2],w[3]); p2=fit(w[4],w[5])\n    print(f'D a={pd_[2]:.1f} G a={pg[2]:.1f} ID/IG={pd_[2]/pg[2]:.5f}')\nEOF\npython3 /tmp/sweep.py\n"]
