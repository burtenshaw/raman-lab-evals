[244.83778, "i", "cat > /app/fit_raman.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Fit Lorentzian + constant offset peaks (D, G, 2D) in a graphene Raman spectrum.\"\"\"\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nCSV = '/app/spectrum.csv'\nOUT = '/app/results.json'\n\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n\ndef fit_peak(x, y, lo, hi, guess_gamma=15.0):\n    m = (x >= lo) & (x <= hi)\n    xx, yy = x[m], y[m]\n    base = np.percentile(yy, 10)\n    i = int(np.argmax(yy))\n    p0 = [float(xx[i]), guess_gamma, float(yy[i] - base), float(base)]\n    popt, _ = curve_fit(lorentzian, xx, yy, p0=p0, maxfev=200000)\n    resid = lorentzian(xx, *popt) - yy\n    rms = float(np.sqrt(np.mean(resid**2)))\n    print(f'window {lo}-{hi}: x0={popt[0]:.4f} gamma={popt[1]:.4f} '\n          f'amp={popt[2]:.3f} off={popt[3]:.3f} resid_rms={rms:.2f} npts={m.sum()}')\n    return popt\n\n\ndef main():\n    data = np.loadtxt(CSV, delimiter=',', skiprows=1)\n    x, y = data[:, 0],"]
[244.837909, "i", " data[:, 1]\n\n    d = fit_peak(x, y, 1250.0, 1450.0)\n    g = fit_peak(x, y, 1500.0, 1700.0)\n    t = fit_peak(x, y, 2550.0, 2850.0)\n\n    results = {\n        \"D\":  {\"x0\": float(d[0]), \"gamma\": float(d[1]), \"amplitude\": float(d[2]), \"offset\": float(d[3])},\n        \"G\":  {\"x0\": float(g[0]), \"gamma\": float(g[1]), \"amplitude\": float(g[2]), \"offset\": float(g[3])},\n        \"2D\": {\"x0\": float(t[0]), \"gamma\": float(t[1]), \"amplitude\": float(t[2]), \"offset\": float(t[3])},\n        \"ID_IG\": float(d[2] / g[2]),\n    }\n    with open(OUT, 'w') as f:\n        json.dump(results, f, indent=2)\n    print(json.dumps(results, indent=2))\n\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 /app/fit_raman.py\n"]
[244.837966, "o", "cat > /app/fit_raman.py << 'EOF'\r\n\u001b[?2004l\r"]
[244.838017, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[244.838052, "o", "\u001b[?2004h> "]
[244.838155, "o", "\"\"\"Fit Lorentzian + constant offset peaks (D, G, 2D) in a graphene Raman spectrum.\"\"\"\r\n\u001b[?2004l\r"]
[244.838183, "o", "\u001b[?2004h> "]
[244.838214, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.838244, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[244.838276, "o", "\u001b[?2004h> "]
[244.838355, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.838392, "o", "CSV = '/app/spectrum.csv'\r\n\u001b[?2004l\r"]
[244.838421, "o", "\u001b[?2004h> "]
[244.838453, "o", "OUT = '/app/results.json'\r\n\u001b[?2004l\r"]
[244.83848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.838506, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.838537, "o", "\u001b[?2004h> "]
[244.8386, "o", "def lorentzian(x, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.83863, "o", "> "]
[244.838715, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.838741, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[244.838771, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.838837, "o", "def fit_peak(x, y, lo, hi, guess_gamma=15.0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.838866, "o", "> "]
[244.838905, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.838934, "o", "> "]
[244.838962, "o", "    xx, yy = x[m], y[m]\r\n"]
[244.838992, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[244.839033, "o", "    base = np.percentile(yy, 10)\r\n\u001b[?2004l\r"]
[244.839062, "o", "\u001b[?2004h> "]
[244.8391, "o", "    i = int(np.argmax(yy))\r\n\u001b[?2004l\r"]
[244.839129, "o", "\u001b[?2004h> "]
[244.839259, "o", "    p0 = [float(xx[i]), guess_gamma, float(yy[i] - base), float(base)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.839292, "o", "> "]
[244.839364, "o", "    popt, _ = curve_fit(lorentzian, xx, yy, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.839393, "o", "> "]
[244.83944, "o", "    resid = lorentzian(xx, *popt) - yy\r\n\u001b[?2004l\r"]
[244.839469, "o", "\u001b[?2004h> "]
[244.839529, "o", "    rms = float(np.sqrt(np.mean(resid**2)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.83956, "o", "> "]
[244.839643, "o", "    print(f'window {lo}-{hi}: x0={popt[0]:.4f} gamma={popt[1]:.4f} '\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.839674, "o", "> "]
[244.839771, "o", "          f'amp={popt[2]:.3f} off={popt[3]:.3f} resid_rms={rms:.2f} npts={m.sum()}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.839802, "o", "> "]
[244.839834, "o", "    return popt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[244.83986, "o", "\u001b[?2004l\r"]
[244.839889, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.839918, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[244.839947, "o", "\u001b[?2004h> "]
[244.840018, "o", "    data = np.loadtxt(CSV, delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.840048, "o", "> "]
[244.840086, "o", "    x, y = data[:, 0], data[:, 1]\r\n\u001b[?2004l\r"]
[244.840112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.840143, "o", "\u001b[?2004h> "]
[244.840193, "o", "    d = fit_peak(x, y, 1250.0, 1450.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.840223, "o", "> "]
[244.840266, "o", "    g = fit_peak(x, y, 1500.0, 1700.0)\r\n\u001b[?2004l\r"]
[244.840296, "o", "\u001b[?2004h> "]
[244.840348, "o", "    t = fit_peak(x, y, 2550.0, 2850.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.840378, "o", "> \r\n\u001b[?2004l\r"]
[244.840404, "o", "\u001b[?2004h> "]
[244.840437, "o", "    results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.840576, "o", "        \"D\":  {\"x0\": float(d[0]), \"gamma\": float(d[1]), \"amplitude\": float(d[2]), \"offset\": float(d[3])},\r\n\u001b[?2004l\r"]
[244.840606, "o", "\u001b[?2004h> "]
[244.840727, "o", "        \"G\":  {\"x0\": float(g[0]), \"gamma\": float(g[1]), \"amplitude\": float(g[2]), \"offset\": float(g[3])},\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.840791, "o", "> "]
[244.840878, "o", "        \"2D\": {\"x0\": float(t[0]), \"gamma\": float(t[1]), \"amplitude\": float(t[2]), \"offset\": float(t[3])},\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.840912, "o", "> "]
[244.840953, "o", "        \"ID_IG\": float(d[2] / g[2]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.840986, "o", ">     }"]
[244.84102, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.841049, "o", "    with open(OUT, 'w') as f:\r\n\u001b[?2004l\r"]
[244.841083, "o", "\u001b[?2004h> "]
[244.841134, "o", "        json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.841167, "o", "> "]
