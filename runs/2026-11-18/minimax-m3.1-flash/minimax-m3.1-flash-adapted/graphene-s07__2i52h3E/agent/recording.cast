[163.588161, "i", "cat > /tmp/global.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef L(x, x0, g, a):\n    return a*g**2/((x-x0)**2+g**2)\n\ndef model_lin(x, x0d, gd, ad, x0g, gg, ag, x02, g2, a2, c0, c1):\n    return L(x,x0d,gd,ad)+L(x,x0g,gg,ag)+L(x,x02,g2,a2)+c0+c1*(x-2000)\n\np0 = [1348,16.7,8210, 1580.4,13,7520, 2692.4,20.9,10370, 1350,0.0]\np,_ = curve_fit(model_lin, x, y, p0=p0, maxfev=400000)\nprint('linear bg fit:', np.round(p,4))\nr = y - model_lin(x,*p)\nfor lo in range(1100,3000,100):\n    m=(x>=lo)&(x<lo+100)\n    print(lo, f'resid mean={r[m].mean():8.2f} med={np.median(r[m]):8.2f}')\n\ndef model_quad(x, x0d, gd, ad, x0g, gg, ag, x02, g2, a2, c0, c1, c2):\n    return model_lin(x,x0d,gd,ad,x0g,gg,ag,x02,g2,a2,c0,c1)+c2*((x-2000)/1000.0)**2\np2,_ = curve_fit(model_quad, x, y, p0=list(p)+[0.0], maxfev=400000)\nprint('quad bg fit:', np.round(p2,4))\nr2 = y - model_quad(x,*p2)\nprint('quad resid rms', np.sqrt(np.mean(r2**2)), 'lin "]
[163.588266, "i", "resid rms', np.sqrt(np.mean(r**2)))\nfor lo in range(1100,3000,100):\n    m=(x>=lo)&(x<lo+100)\n    print(lo, f'quad resid mean={r2[m].mean():8.2f}')\nEOF\npython3 /tmp/global.py\n"]
