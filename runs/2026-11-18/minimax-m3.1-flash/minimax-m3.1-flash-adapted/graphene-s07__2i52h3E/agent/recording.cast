[163.588964, "o", "def model_lin(x, x0d, gd, ad, x0g, gg, ag, x02, g2, a2, c0, c1):\r\n\u001b[?2004l\r"]
[163.588989, "o", "\u001b[?2004h> "]
[163.589078, "o", "    return L(x,x0d,gd,ad)+L(x,x0g,gg,ag)+L(x,x02,g2,a2)+c0+c1*(x-2000)\r\n\u001b[?2004l\r"]
