[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x, y = d[:,0], d[:,1]
[?2004l[?2004h> def lor(x, x0, g, a, o):
[?2004l[?2004h>     return a*g**2/((x-x0)**2+g**2)+o
[?2004l[?2004h> def fit(lo,hi):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi); xx,yy=x[m],y[m]
[?2004l[?2004h>     base=np.percentile(yy,10); i=np.argmax(yy)
[?2004l[?2004h>     p,_=curve_fit(lor,xx,yy,p0=[xx[i],15.0,yy[i]-base,base],maxfev=200000)
[?2004l[?2004h>     return p
[?2004l[?2004h> print('--- D windows ---')
[?2004l[?2004h> for lo,hi in [(1150,1500),(1200,1500),(1250,1450),(1250,1500),(1200,1480),(1280,1420)]:
[?2004l[?2004h>     p=fit(lo,hi); print(f'{lo}-{hi} x0={p[0]:.3f} g={p[1]:.3f} a={p[2]:.1f} o={p[3]:.1f}')
[?2004l[?2004h> print('--- G windows ---')
[?2004l[?2004h> for lo,hi in [(1480,1700),(1500,1700),(1500,1800),(1520,1680),(1530,1630),(1450,1750)]:
[?2004l[?2004h>     p=fit(lo,hi); print(f'{lo}-{hi} x0={p[0]:.3f} g={p[1]:.3f} a={p[2]:.1f} o={p[3]:.1f}')
[?2004l[?2004h> print('--- 2D windows ---')
[?2004l[?2004h> for lo,hi in [(2450,2950),(2500,2900),(2550,2850),(2600,2800),(2550,2900),(2400,3000)]:
[?2004l[?2004h>     p=fit(lo,hi); print(f'{lo}-{hi} x0={p[0]:.3f} g={p[1]:.3f} a={p[2]:.1f} o={p[3]:.1f}')
[?2004l[?2004h> print('--- ID/IG for matched window widths ---')
[?2004l[?2004h> for w in [(1200,1500,1450,1750,2450,2950),(1250,1450,1500,1700,2550,2850),(1150,1500,1480,1700,2400,3000)]:
[?2004l[?2004h>     pd_=fit(w[0],w[1]); pg=fit(w[2],w[3]); p2=fit(w[4],w[5])
[?2004l[?2004h>     print(f'D a={pd_[2]:.1f} G a={pg[2]:.1f} ID/IG={pd_[2]/pg[2]:.5f}')
[?2004l[?2004h> EOF
