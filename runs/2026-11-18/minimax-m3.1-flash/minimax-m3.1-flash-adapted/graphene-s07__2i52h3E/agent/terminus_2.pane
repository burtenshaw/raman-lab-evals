[?2004hroot@j-openenv-6afd8b4329e8b7ccfbbb8245-ueqjyhmj-38df2-fjm74:/app# cat > /app/fit_raman.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Fit Lorentzian + constant offset peaks (D, G, 2D) in a graphene Raman spectrum."""
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> CSV = '/app/spectrum.csv'
[?2004l[?2004h> OUT = '/app/results.json'
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, lo, hi, guess_gamma=15.0):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xx, yy = x[m], y[m]
[?2004l[?2004h>     base = np.percentile(yy, 10)
[?2004l[?2004h>     i = int(np.argmax(yy))
[?2004l[?2004h>     p0 = [float(xx[i]), guess_gamma, float(yy[i] - base), float(base)]
[?2004l[?2004h>     popt, _ = curve_fit(lorentzian, xx, yy, p0=p0, maxfev=200000)
[?2004l[?2004h>     resid = lorentzian(xx, *popt) - yy
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>     print(f'window {lo}-{hi}: x0={popt[0]:.4f} gamma={popt[1]:.4f} '
[?2004l[?2004h>           f'amp={popt[2]:.3f} off={popt[3]:.3f} resid_rms={rms:.2f} npts={m.sum()}')
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     data = np.loadtxt(CSV, delimiter=',', skiprows=1)
[?2004l[?2004h>     x, y = data[:, 0], data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h>     d = fit_peak(x, y, 1250.0, 1450.0)
[?2004l[?2004h>     g = fit_peak(x, y, 1500.0, 1700.0)
[?2004l[?2004h>     t = fit_peak(x, y, 2550.0, 2850.0)
[?2004l[?2004h> 
[?2004l[?2004h>     results = {
[?2004l[?2004h>         "D":  {"x0": float(d[0]), "gamma": float(d[1]), "amplitude": float(d[2]), "offset": float(d[3])},
[?2004l[?2004h>         "G":  {"x0": float(g[0]), "gamma": float(g[1]), "amplitude": float(g[2]), "offset": float(g[3])},
[?2004l[?2004h>         "2D": {"x0": float(t[0]), "gamma": float(t[1]), "amplitude": float(t[2]), "offset": float(t[3])},
[?2004l[?2004h>         "ID_IG": float(d[2] / g[2]),
[?2004l[?2004h>     }
[?2004l[?2004h>     with open(OUT, 'w') as f:
[?2004l[?2004h>         json.dump(results, f, indent=2)
[?2004l[?2004h>     print(json.dumps(results, indent=2))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     main()
[?2004l[?2004h> EOF
