[129.368694, "o", "print('2D x0=%.3f gamma=%.3f amp=%.2f'%tuple(p[6:9]))\r\n\u001b[?2004l\r"]
[129.368737, "o", "\u001b[?2004h> "]
[129.36877, "o", "print('off=%.2f'%p[9])\r\n\u001b[?2004l\r"]
[129.368797, "o", "\u001b[?2004h> "]
[129.368812, "o", "r = y-lor3(x,*p)\r\n"]
[129.368857, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[129.368932, "o", "print('global rms=%.2f'%np.sqrt(np.mean(r**2)))\r\n\u001b[?2004l\r"]
[129.368958, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[129.369004, "o", "\u001b[?2004h> "]
[129.369039, "o", "def lor_lin(x,x0,gamma,amp,off,slope):\r\n\u001b[?2004l\r"]
[129.369085, "o", "\u001b[?2004h> "]
[129.369157, "o", "    return amp*gamma**2/((x-x0)**2+gamma**2)+off+slope*(x-x0)\r\n\u001b[?2004l\r"]
[129.369196, "o", "\u001b[?2004h> "]
[129.369256, "o", "print('--- per-peak fits with linear background')\r\n\u001b[?2004l\r"]
[129.369295, "o", "\u001b[?2004h> "]
[129.369458, "o", "for name,(lo,hi),g in [('D',(1250,1470),(1350,14,1400,950,0)),('G',(1480,1680),(1581,9,6600,950,0)),('2D',(2500,2900),(2685,17,13000,900,0))]:\r\n\u001b[?2004l\r"]
[129.3695, "o", "\u001b[?2004h> "]
[129.369549, "o", "    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\r\n\u001b[?2004l\r"]
[129.369587, "o", "\u001b[?2004h> "]
[129.369653, "o", "    pp,_=curve_fit(lor_lin,xs,ys,p0=g,maxfev=100000)\r\n\u001b[?2004l\r"]
[129.369697, "o", "\u001b[?2004h> "]
[129.369817, "o", "    print('%s lin: x0=%.3f gamma=%.3f amp=%.2f off=%.2f slope=%.5f'%(name,pp[0],pp[1],pp[2],pp[3],pp[4]))\r\n\u001b[?2004l\r"]
[129.369844, "o", "\u001b[?2004h> "]
[129.369889, "o", "EOF\r\n\u001b[?2004l\r"]
[129.371097, "o", "\u001b[?2004hroot@j-openenv-6afd8e59e5cad0e4dc3e6e5b-luwjxfkd-fb0a5-vmfcv:/app# "]
[129.371168, "o", "python3 /app/diag2.py\r\n\u001b[?2004l\r"]
