[108.385404, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d[d.dtype.names[0]])\ny = np.array(d['intensity'])\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ndef fitwin(lo, hi, g):\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    p, _ = curve_fit(lor, xs, ys, p0=g, maxfev=100000)\n    r = ys - lor(xs, *p)\n    return p, xs, r\n\nfor name, (lo,hi), g in [('D',(1250,1470),(1350,14,1400,950)),\n                          ('G',(1480,1680),(1581,9,6600,950)),\n                          ('2D',(2500,2900),(2685,17,13000,900))]:\n    p, xs, r = fitwin(lo,hi,g)\n    print('===',name,'x0=%.4f gamma=%.4f amp=%.3f off=%.3f rms=%.3f'%(p[0],p[1],p[2],p[3],np.sqrt(np.mean(r**2))))\n    # binned residuals\n    nb = 12\n    edges = np.linspace(xs.min(), xs.max(), nb+1)\n    for i in range(nb):\n        m = (xs>=edges[i])&(xs<edges[i+1] if i<nb-1 else xs<=edges[i+1])\n        if m.sum()>0:\n         "]
[108.385518, "i", "   print('  %7.1f-%7.1f  n=%4d  mean resid=%+8.2f  std=%7.2f'%(edges[i],edges[i+1],m.sum(),r[m].mean(),r[m].std()))\n\n# baseline regions away from peaks\nfor lo,hi in [(1100,1250),(1450,1500),(1700,2400),(2900,3000)]:\n    m=(x>=lo)&(x<=hi)\n    print('baseline %d-%d: mean=%.1f median=%.1f std=%.1f'%(lo,hi,y[m].mean(),np.median(y[m]),y[m].std()))\nEOF\npython3 /app/diag.py\n"]
