[76.012523, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d['raman_shift_cm1'] if 'raman_shift_cm1' in d.dtype.names else d[d.dtype.names[0]])\ny = np.array(d['intensity'])\nprint(d.dtype.names)\nprint('n=', x.size, 'x range', x.min(), x.max(), 'dx', np.diff(x)[:3], np.diff(x)[-3:])\nprint('y min/max/median', y.min(), y.max(), np.median(y))\nfor lo, hi in [(1100,1250),(1250,1450),(1450,1500),(1500,1660),(1660,1750),(2400,2550),(2550,2800),(2800,3000)]:\n    m = (x>=lo)&(x<=hi)\n    print(lo,hi,'min %.1f max %.1f at %.1f median %.1f' % (y[m].min(), y[m].max(), x[m][np.argmax(y[m])], np.median(y[m])))\n# local maxima\nidx = [i for i in range(1,len(y)-1) if y[i]>y[i-1] and y[i]>=y[i+1]]]\nfor i in idx:\n    if y[i] > 1000:\n        print('local max', x[i], y[i])\nEOF\npython3 /app/explore.py\n"]
