[156.491668, "o", "\u001b[?2004h> "]
[156.491716, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[156.491745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[156.491776, "o", "\u001b[?2004h> "]
[156.491862, "o", "d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r"]
[156.491892, "o", "\u001b[?2004h> "]
[156.491967, "o", "x = np.array(d[d.dtype.names[0]])\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.492008, "o", "> "]
[156.492039, "o", "y = np.array(d['intensity'])\r\n\u001b[?2004l\r"]
[156.492063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[156.492086, "o", "\u001b[?2004h"]
[156.49211, "o", "> "]
[156.492149, "o", "def lor(x, x0, gamma, amp, off):\r\n\u001b[?2004l\r"]
[156.492171, "o", "\u001b[?2004h> "]
[156.492262, "o", "    return amp*gamma**2/((x-x0)**2+gamma**2) + off\r\n\u001b[?2004l\r"]
[156.492294, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[156.492316, "o", "\u001b[?2004h> "]
[156.492338, "o", "cfg = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.492419, "o", "  'D':  dict(win=(1250.0, 1470.0), p0=(1350.0, 14.0, 1400.0, 950.0)),\r\n\u001b[?2004l\r"]
[156.49243, "o", "\u001b[?2004h> "]
[156.492521, "o", "  'G':  dict(win=(1480.0, 1680.0), p0=(1581.0,  9.0, 6600.0, 950.0)),\r\n\u001b[?2004l\r"]
[156.492532, "o", "\u001b[?2004h> "]
[156.492625, "o", "  '2D': dict(win=(2500.0, 2900.0), p0=(2685.0, 17.0, 13000.0, 900.0)),\r\n\u001b[?2004l\r"]
[156.492654, "o", "\u001b[?2004h> }"]
[156.492686, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
