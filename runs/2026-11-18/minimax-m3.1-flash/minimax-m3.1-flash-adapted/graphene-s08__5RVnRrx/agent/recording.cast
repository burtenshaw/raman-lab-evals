[129.366234, "i", "cat > /app/diag2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.array(d[d.dtype.names[0]])\ny = np.array(d['intensity'])\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2) + off\n\ndef lor3(x, x0d, gd, ad, x0g, gg, ag, x02, g2, a2, off):\n    return lor(x,x0d,gd,ad,0)+lor(x,x0g,gg,ag,0)+lor(x,x02,g2,a2,0)+off\n\n# binned medians over full range\nprint('--- binned medians (100 cm-1 bins)')\nfor lo in range(1100, 3000, 100):\n    m=(x>=lo)&(x<lo+100)\n    print('%5d-%5d med=%8.1f mean=%8.1f std=%6.1f'%(lo,lo+100,np.median(y[m]),y[m].mean(),y[m].std()))\n\np,c = curve_fit(lor3, x, y, p0=[1349,13.5,1312,1581,8.4,6596,2685,17,13000,900], maxfev=200000)\nprint('--- global 3-peak + constant fit')\nprint('D  x0=%.3f gamma=%.3f amp=%.2f'%tuple(p[0:3]))\nprint('G  x0=%.3f gamma=%.3f amp=%.2f'%tuple(p[3:6]))\nprint('2D x0=%.3f gamma=%.3f amp=%.2f'%tuple(p[6:9]))\nprint('off=%.2f'%p[9])\nr = y-lor3(x,*p)\nprint('global"]
[129.366357, "i", " rms=%.2f'%np.sqrt(np.mean(r**2)))\n\ndef lor_lin(x,x0,gamma,amp,off,slope):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off+slope*(x-x0)\nprint('--- per-peak fits with linear background')\nfor name,(lo,hi),g in [('D',(1250,1470),(1350,14,1400,950,0)),('G',(1480,1680),(1581,9,6600,950,0)),('2D',(2500,2900),(2685,17,13000,900,0))]:\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    pp,_=curve_fit(lor_lin,xs,ys,p0=g,maxfev=100000)\n    print('%s lin: x0=%.3f gamma=%.3f amp=%.2f off=%.2f slope=%.5f'%(name,pp[0],pp[1],pp[2],pp[3],pp[4]))\nEOF\npython3 /app/diag2.py\n"]
