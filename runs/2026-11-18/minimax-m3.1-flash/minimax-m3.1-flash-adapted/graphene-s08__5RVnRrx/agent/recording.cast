[156.492741, "o", "\u001b[?2004h> "]
[156.492767, "o", "for name, c in cfg.items():\r\n\u001b[?2004l\r"]
[156.492789, "o", "\u001b[?2004h> "]
[156.492819, "o", "    lo, hi = c['win']\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.492846, "o", "> "]
[156.49287, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.492902, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r"]
[156.492929, "o", "\u001b[?2004h> "]
[156.492998, "o", "    p, cov = curve_fit(lor, xs, ys, p0=c['p0'], maxfev=200000)\r\n\u001b[?2004l\r"]
[156.493028, "o", "\u001b[?2004h> "]
[156.493056, "o", "    err = np.sqrt(np.diag(cov))\r\n\u001b[?2004l\r"]
[156.493082, "o", "\u001b[?2004h> "]
[156.493102, "o", "    r = ys - lor(xs, *p)\r\n\u001b[?2004l\r"]
[156.493128, "o", "\u001b[?2004h> "]
[156.493252, "o", "    print('%-3s win[%.0f,%.0f] n=%d  x0=%.4f+-%.4f  gamma=%.4f+-%.4f  amp=%.3f+-%.3f  off=%.3f+-%.3f  rms=%.3f'\r\n\u001b[?2004l\r"]
[156.493281, "o", "\u001b[?2004h> "]
[156.493404, "o", "          % (name, lo, hi, xs.size, p[0], err[0], p[1], err[1], p[2], err[2], p[3], err[3], np.sqrt(np.mean(r**2))))\r\n\u001b[?2004l\r"]
[156.493432, "o", "\u001b[?2004h> "]
[156.493541, "o", "    res[name] = {'x0': float(p[0]), 'gamma': float(p[1]), 'amplitude': float(p[2]), 'offset': float(p[3])}\r\n\u001b[?2004l\r"]
[156.493578, "o", "\u001b[?2004h> \r\n"]
[156.493611, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[156.493651, "o", "res['ID_IG'] = res['D']['amplitude'] / res['G']['amplitude']\r\n\u001b[?2004l\r"]
[156.493684, "o", "\u001b[?2004h> "]
[156.493716, "o", "print('ID_IG = %.6f' % res['ID_IG'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.493747, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.493773, "o", "> "]
[156.493814, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.493855, "o", "    json.dump(res, f, indent=2)\r\n\u001b[?2004l\r"]
[156.493892, "o", "\u001b[?2004h> "]
[156.493924, "o", "    f.write('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.493961, "o", "EOF\r\n\u001b[?2004l\r"]
