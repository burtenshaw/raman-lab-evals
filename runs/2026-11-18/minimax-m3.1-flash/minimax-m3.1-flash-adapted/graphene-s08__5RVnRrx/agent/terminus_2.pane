def lor_lin(x,x0,gamma,amp,off,slope):
    return amp*gamma**2/((x-x0)**2+gamma**2)+off+slope*(x-x0)
print('--- per-peak fits with linear background')
for name,(lo,hi),g in [('D',(1250,1470),(1350,14,1400,950,0)),('G',(1480,1680),(1581,9,6600,950,0)),('2D',(2500,2900),(2685,17,13000,900,0))]:
    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]
    pp,_=curve_fit(lor_lin,xs,ys,p0=g,maxfev=100000)
    print('%s lin: x0=%.3f gamma=%.3f amp=%.2f off=%.2f slope=%.5f'%(name,pp[0],pp[1],pp[2],pp[3],pp[4]))
