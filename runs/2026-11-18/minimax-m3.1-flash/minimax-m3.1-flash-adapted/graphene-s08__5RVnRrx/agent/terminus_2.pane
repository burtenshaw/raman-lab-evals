[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = np.array(d[d.dtype.names[0]])
[?2004l[?2004h> y = np.array(d['intensity'])
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, x0, gamma, amp, off):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> cfg = {
[?2004l[?2004h>   'D':  dict(win=(1250.0, 1470.0), p0=(1350.0, 14.0, 1400.0, 950.0)),
[?2004l[?2004h>   'G':  dict(win=(1480.0, 1680.0), p0=(1581.0,  9.0, 6600.0, 950.0)),
[?2004l[?2004h>   '2D': dict(win=(2500.0, 2900.0), p0=(2685.0, 17.0, 13000.0, 900.0)),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> res = {}
[?2004l[?2004h> for name, c in cfg.items():
[?2004l[?2004h>     lo, hi = c['win']
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     p, cov = curve_fit(lor, xs, ys, p0=c['p0'], maxfev=200000)
[?2004l[?2004h>     err = np.sqrt(np.diag(cov))
[?2004l[?2004h>     r = ys - lor(xs, *p)
[?2004l[?2004h>     print('%-3s win[%.0f,%.0f] n=%d  x0=%.4f+-%.4f  gamma=%.4f+-%.4f  amp=%.3f+-%.3f  off=%.3f+-%.3f  rms=%.3f'
[?2004l[?2004h>           % (name, lo, hi, xs.size, p[0], err[0], p[1], err[1], p[2], err[2], p[3], err[3], np.sqrt(np.mean(r**2))))
