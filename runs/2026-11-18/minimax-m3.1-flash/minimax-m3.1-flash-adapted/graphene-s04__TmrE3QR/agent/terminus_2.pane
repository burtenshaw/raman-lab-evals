[?2004hroot@j-openenv-6afd8a8629e8b7ccfbbb81c3-pdvqfbfv-79919-l9jjr:/app# cat > /app/write_results.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x, y = data[:, 0], data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(xx, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((xx - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(center, halfwidth=100.0):
[?2004l[?2004h>     m = (x >= center - halfwidth) & (x <= center + halfwidth)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.percentile(ys, 10))
[?2004l[?2004h>     amp0 = float(ys.max() - off0)
[?2004l[?2004h>     p0 = [amp0, center, 20.0, off0]
[?2004l[?2004h>     p, pcov = curve_fit(lorentzian, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     amp, x0, gamma, off = [float(v) for v in p]
[?2004l[?2004h>     res = ys - lorentzian(xs, *p)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(res**2)))
[?2004l[?2004h>     err = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     print(f'{x0:8.3f} +/- {err[1]:.3f} | amp {amp:10.3f} +/- {err[0]:.3f} | gamma {gamma:7.3f} +/- {err[2]:.3f} | off {off:9.3f} +/- {err[3]:.3f} | rms {rms:.2f} | n {len(xs)}')
[?2004l[?2004h>     return {"x0": x0, "gamma": gamma, "amplitude": amp, "offset": off}
[?2004l[?2004h> 
[?2004l[?2004h> D = fit_peak(1346.0)
[?2004l[?2004h> G = fit_peak(1585.0)
[?2004l[?2004h> D2 = fit_peak(2678.0)
[?2004l[?2004h> 
[?2004l[?2004h> results = {
[?2004l[?2004h>     "D": D,
[?2004l[?2004h>     "G": G,
[?2004l[?2004h>     "2D": D2,
[?2004l[?2004h>     "ID_IG": D["amplitude"] / G["amplitude"],
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h>     f.write('\n')
[?2004l[?2004h> print('ID_IG =', results['ID_IG'])
[?2004l[?2004h> EOF
