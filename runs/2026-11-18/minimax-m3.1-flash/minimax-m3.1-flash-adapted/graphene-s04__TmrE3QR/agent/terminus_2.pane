[?2004l[?2004h>         mm=(xs>=lo)&(xs<lo+20)
[?2004l[?2004h>         if mm.any():
[?2004l[?2004h>             print(f'   {lo:7.1f} mean_resid {r[mm].mean():8.2f} std {r[mm].std():7.2f}')
