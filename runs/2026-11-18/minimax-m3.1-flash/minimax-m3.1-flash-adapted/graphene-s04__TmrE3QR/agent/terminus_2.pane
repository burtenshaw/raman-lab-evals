[?2004l[?2004h> x, y = d[:,0], d[:,1]
[?2004l[?2004h> def lor(xx,a,x0,g,o):
[?2004l[?2004h>     return a*g**2/((xx-x0)**2+g**2)+o
[?2004l[?2004h> for name,x0g in [('D',1346),('G',1585),('2D',2678)]:
[?2004l[?2004h>     m=(x>=x0g-100)&(x<=x0g+100); xs,ys=x[m],y[m]
[?2004l[?2004h>     off=np.percentile(ys,10); amp=ys.max()-off
[?2004l[?2004h>     p,_=curve_fit(lor,xs,ys,p0=[amp,x0g,20.,off],maxfev=200000)
