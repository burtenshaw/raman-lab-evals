[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(x, y, x0g, w):
[?2004l[?2004h>     m = (x >= x0g - w) & (x <= x0g + w)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     off0 = np.percentile(ys, 10)
[?2004l[?2004h>     amp0 = ys.max() - off0
[?2004l[?2004h>     p0 = [amp0, x0g, 20.0, off0]
[?2004l[?2004h>     p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=100000)
[?2004l[?2004h>     res = ys - lor(xs, *p)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean(res**2)))
[?2004l[?2004h>     ss_res = float(np.sum(res**2)); ss_tot = float(np.sum((ys-np.mean(ys))**2))
[?2004l[?2004h>     r2 = 1 - ss_res/ss_tot
[?2004l[?2004h>     return p, rms, r2, len(xs)
