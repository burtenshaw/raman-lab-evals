[162.857501, "i", "cat > /app/resid.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\ndef lor(xx,a,x0,g,o):\n    return a*g**2/((xx-x0)**2+g**2)+o\nfor name,x0g in [('D',1346),('G',1585),('2D',2678)]:\n    m=(x>=x0g-100)&(x<=x0g+100); xs,ys=x[m],y[m]\n    off=np.percentile(ys,10); amp=ys.max()-off\n    p,_=curve_fit(lor,xs,ys,p0=[amp,x0g,20.,off],maxfev=200000)\n    r=ys-lor(xs,*p)\n    print('==',name, np.array2string(p,precision=3))\n    edges=np.arange(xs.min(), xs.max()+10, 20)\n    for lo in edges:\n        mm=(xs>=lo)&(xs<lo+20)\n        if mm.any():\n            print(f'   {lo:7.1f} mean_resid {r[mm].mean():8.2f} std {r[mm].std():7.2f}')\nEOF\npython3 /app/resid.py\n"]
