[49.065653, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nfor lo, hi in [(1150,1500),(1450,1750),(2500,2900),(2800,3000)]:\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    i = np.argmax(ys)\n    print(f'window {lo}-{hi}: max at {xs[i]:.2f} val {ys[i]:.1f}, min {ys.min():.1f}, median {np.median(ys):.1f}')\nEOF\npython3 /app/explore.py\n"]
