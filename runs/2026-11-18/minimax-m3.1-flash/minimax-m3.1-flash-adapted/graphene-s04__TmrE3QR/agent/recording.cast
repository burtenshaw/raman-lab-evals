[143.344284, "o", "    off=np.percentile(ys,10); amp=ys.max()-off\r\n\u001b[?2004l\r"]
[143.344336, "o", "\u001b[?2004h> "]
[143.344399, "o", "    p,_=curve_fit(lor,xs,ys,p0=[amp,x0g,20.,off],maxfev=200000)\r\n\u001b[?2004l\r"]
[143.344445, "o", "\u001b[?2004h> "]
[143.344492, "o", "    r=ys-lor(xs,*p)\r\n\u001b[?2004l\r\u001b[?2004h"]
[143.344531, "o", "> "]
[143.344561, "o", "    return p, np.sqrt(np.mean(r**2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.34463, "o", "for name,x0g in [('D',1346),('G',1585),('2D',2678)]:\r\n\u001b[?2004l\r"]
