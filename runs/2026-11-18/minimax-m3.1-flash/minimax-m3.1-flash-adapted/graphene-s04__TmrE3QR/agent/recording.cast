[143.343449, "i", "cat > /app/scan.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\ndef lor(xx,a,x0,g,o):\n    return a*g**2/((xx-x0)**2+g**2)+o\ndef fit(lo,hi,x0g):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    off=np.percentile(ys,10); amp=ys.max()-off\n    p,_=curve_fit(lor,xs,ys,p0=[amp,x0g,20.,off],maxfev=200000)\n    r=ys-lor(xs,*p)\n    return p, np.sqrt(np.mean(r**2))\nfor name,x0g in [('D',1346),('G',1585),('2D',2678)]:\n    print('==',name)\n    for w in [60,80,100,120,140,160,180]:\n        p,rms=fit(x0g-w,x0g+w,x0g)\n        print(f'  +-{w}: amp={p[0]:9.3f} x0={p[1]:9.3f} gam={p[2]:7.3f} off={p[3]:9.3f} rms={rms:8.3f}')\nEOF\npython3 /app/scan.py\n"]
