[89.849029, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n# binned medians across full range\nbins = np.arange(1100, 3001, 50)\nfor lo in bins:\n    m = (x>=lo)&(x<lo+50)\n    if m.any():\n        print(f'{lo:6.0f}-{lo+50:6.0f} median {np.median(y[m]):9.1f}  min {y[m].min():9.1f} max {y[m].max():9.1f}')\nEOF\npython3 /app/explore2.py\n"]
