[186.963745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.963769, "o", "\u001b[?2004h> "]
[186.963802, "o", "D = fit_peak(1346.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.963826, "o", "> G = fit_peak(1585.0)\r\n\u001b[?2004l\r"]
[186.963853, "o", "\u001b[?2004h> "]
[186.963881, "o", "D2 = fit_peak(2678.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.96391, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.963942, "o", "results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.963969, "o", "    \"D\": D,\r\n\u001b[?2004l\r"]
[186.963998, "o", "\u001b[?2004h>     \"G\": G,\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.964027, "o", "> "]
[186.964056, "o", "    \"2D\": D2,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.964093, "o", "    \"ID_IG\": D[\"amplitude\"] / G[\"amplitude\"],\r\n\u001b[?2004l\r"]
[186.964118, "o", "\u001b[?2004h> }"]
[186.964142, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
