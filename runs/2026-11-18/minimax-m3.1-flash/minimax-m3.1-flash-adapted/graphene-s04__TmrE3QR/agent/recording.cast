[208.093996, "i", "cat > /app/validate.py << 'EOF'\nimport json\nimport numpy as np\nr = json.load(open('/app/results.json'))\nassert set(r.keys()) == {'D','G','2D','ID_IG'}, r.keys()\nfor k in ['D','G','2D']:\n    p = r[k]\n    assert set(p.keys()) == {'x0','gamma','amplitude','offset'}, p.keys()\n    for kk,v in p.items():\n        assert isinstance(v, float), (k,kk,type(v))\n    model_peak = p['amplitude'] + p['offset']\n    print(k, p, 'model peak height =', model_peak)\nassert abs(r['ID_IG'] - r['D']['amplitude']/r['G']['amplitude']) < 1e-12\nprint('ID_IG =', r['ID_IG'], '-> JSON valid and consistent')\nEOF\npython3 /app/validate.py\n"]
[208.094131, "o", "cat > /app/validate.py << 'EOF'\r\n"]
