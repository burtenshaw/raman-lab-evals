[93.823153, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'], dtype=float)\ny = np.asarray(d['intensity'], dtype=float)\n\ndef model(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(model, xs, ys, p0=p0, maxfev=100000)\n    resid = ys - model(xs, *p)\n    ssr = float(np.sum(resid**2))\n    return p, ssr, m.sum()\n\npeaks = {\n    'D':  (1345.0, 1180.0, 1480.0, [2300., 1345., 30., 1150.]),\n    'G':  (1582.0, 1460.0, 1850.0, [7800., 1582., 25., 1150.]),\n    '2D': (2693.0, 2350.0, 3000.0, [16000., 2693., 30., 1150.]),\n}\n\nfor name, (pk, lo, hi, p0) in peaks.items():\n    print('===', name, 'base window', lo, hi)\n    for half in [(lo, hi), (pk-200, pk+200), (pk-150, pk+150), (pk-120, pk+120), (pk-100,pk+100)]:\n        a, b = half"]
[93.823313, "i", "\n        if a < 1100 or b > 3000:\n            continue\n        try:\n            p, ssr, n = fit_peak(x, y, a, b, p0)\n            print(f'  win [{a},{b}] n={n} amp={p[0]:.3f} x0={p[1]:.3f} gamma={p[2]:.3f} off={p[3]:.3f} ssr={ssr:.1f}')\n        except Exception as e:\n            print('  fail', a, b, e)\nEOF\npython3 /app/fit.py\n"]
