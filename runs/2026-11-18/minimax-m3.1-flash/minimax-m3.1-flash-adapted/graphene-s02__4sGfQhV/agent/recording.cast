[116.121581, "i", "cat > /app/final_fit.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'], dtype=float)\ny = np.asarray(d['intensity'], dtype=float)\n\ndef model(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit(lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    xs, ys = x[m], y[m]\n    p, cov = curve_fit(model, xs, ys, p0=p0, maxfev=200000)\n    resid = ys - model(xs, *p)\n    r2 = 1.0 - np.sum(resid**2) / np.sum((ys - ys.mean())**2)\n    return p, r2, int(m.sum())\n\ncfg = {\n    'D':  (1200.0, 1500.0, [2350.0, 1346.0, 17.0, 1050.0]),\n    'G':  (1450.0, 1750.0, [7870.0, 1582.0, 9.0, 1050.0]),\n    '2D': (2450.0, 2950.0, [16035.0, 2693.0, 24.0, 1050.0]),\n}\n\nres = {}\nfor name, (lo, hi, p0) in cfg.items():\n    p, r2, n = fit(lo, hi, p0)\n    amp, x0, gam, off = p\n    res[name] = {'x0': float(x0), 'gamma': float(gam), 'amplitude': float(amp), 'offset': float(of"]
[116.121733, "i", "f)}\n    print(f'{name:>2}: window=({lo},{hi}) n={n} amp={amp:.4f} x0={x0:.4f} gamma={gam:.4f} offset={off:.4f} R2={r2:.6f}')\n\nres['ID_IG'] = float(res['D']['amplitude'] / res['G']['amplitude'])\nprint('ID_IG =', res['ID_IG'])\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nEOF\npython3 /app/final_fit.py\n"]
[116.121802, "o", "cat > /app/final_fit.py << 'EOF'\r\n\u001b[?2004l\r"]
[116.121827, "o", "f)}\r\n    print(f'{name:>2}: window=({lo},{hi}) n={n} amp={amp:.4f} x0={x0:.4f} gamma={gam:.4f} offset={off:.4f} R2={r2:.6f}')\r\n\r\nres['ID_IG'] = float(res['D']['amplitude'] / res['G']['amplitude'])\r\nprint('ID_IG"]
[116.121841, "o", " =',"]
