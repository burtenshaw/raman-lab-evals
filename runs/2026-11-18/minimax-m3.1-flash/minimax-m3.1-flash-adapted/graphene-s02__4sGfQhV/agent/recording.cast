[82.254797, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm1']\ny = d['intensity']\nprint(x.shape, x.min(), x.max(), x[1]-x[0])\nprint('y stats', y.min(), y.max(), np.median(y))\nfor lo, hi, name in [(1200,1500,'D'),(1450,1700,'G'),(2550,2850,'2D')]:\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    i = np.argmax(ys)\n    print(name, 'window', lo, hi, 'max at', xs[i], ys[i], 'median', np.median(ys), 'min', ys.min())\n# print coarse profile\nfor xv in range(1150, 3000, 50):\n    m = (x>=xv)&(x<xv+50)\n    if m.any():\n        print(xv, round(float(y[m].mean()),1), round(float(y[m].max()),1))\nEOF\npython3 /app/explore.py\n"]
