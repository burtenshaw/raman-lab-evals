[139.927683, "i", "cat > /app/check.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = np.asarray(d['raman_shift_cm1'], float); y = np.asarray(d['intensity'], float)\ndef model(x, a, x0, g, o): return a*g**2/((x-x0)**2+g**2)+o\nr = json.load(open('/app/results.json'))\nfor name, (lo, hi) in {'D':(1200,1500), 'G':(1450,1750), '2D':(2450,2950)}.items():\n    p = r[name]; m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    res = ys - model(xs, p['amplitude'], p['x0'], p['gamma'], p['offset'])\n    print(name, 'max|resid|=%.1f'%np.max(np.abs(res)), 'mean resid=%.2f'%res.mean())\n    # check for structure: residual autocorrelation-free check on 5-bin smoothed residual\n    k=20; sm=np.convolve(res, np.ones(k)/k, mode='valid')\n    print('   smoothed resid max=%.1f min=%.1f'%(sm.max(), sm.min()))\nprint('ID_IG', r['ID_IG'], 'check', r['D']['amplitude']/r['G']['amplitude'])\nEOF\npython3 /app/check.py\n"]
