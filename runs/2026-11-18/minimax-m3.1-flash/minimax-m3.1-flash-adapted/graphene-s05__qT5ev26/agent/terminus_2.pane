[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x, y = data[:, 0], data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(xv, amp, gamma, x0, off):
[?2004l[?2004h>     return amp * gamma**2 / ((xv - x0)**2 + gamma**2) + off
[?2004l[?2004h> 
[?2004l[?2004h> def fit_window(lo, hi):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xv, yv = x[m], y[m]
[?2004l[?2004h>     off0 = float(np.percentile(yv, 10))
[?2004l[?2004h>     amp0 = max(float(yv.max()) - off0, 1.0)
[?2004l[?2004h>     x00 = float(xv[np.argmax(yv)])
[?2004l[?2004h>     above = xv[yv >= off0 + amp0 / 2.0]
[?2004l[?2004h>     g0 = max(float((above.max() - above.min()) / 2.0), 3.0) if above.size > 1 else 20.0
[?2004l[?2004h>     p, cov = curve_fit(lorentz, xv, yv, p0=[amp0, g0, x00, off0],
[?2004l[?2004h>                        bounds=([0.0, 0.5, lo, -np.inf], [np.inf, 500.0, hi, np.inf]),
[?2004l[?2004h>                        maxfev=200000)
[?2004l[?2004h>     rms = float(np.sqrt(np.mean((yv - lorentz(xv, *p))**2)))
[?2004l[?2004h>     perr = np.sqrt(np.diag(cov))
[?2004l[?2004h>     return p, rms, perr
[?2004l[?2004h> 
