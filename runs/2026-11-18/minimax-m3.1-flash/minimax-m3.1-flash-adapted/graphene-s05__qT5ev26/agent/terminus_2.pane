[?2004l[?2004h> def f(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):
[?2004l[?2004h>     L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o
[?2004l[?2004h>     return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)-oD + L(a2,g2,x2,o2)-oD
[?2004l[?2004h> def g3(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):
[?2004l[?2004h>     L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o
[?2004l[?2004h>     return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)+L(a2,g2,x2,o2)-2*oD
