[182.222594, "i", "cat > /app/global_check.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\ndef f(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):\n    L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o\n    return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)-oD + L(a2,g2,x2,o2)-oD\ndef g3(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):\n    L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o\n    return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)+L(a2,g2,x2,o2)-2*oD\np0=[636,12.8,1354,839,6551,9.08,1579,799,9807,25.6,2689,736]\np,cov=curve_fit(g3,x,y,p0=p0,maxfev=200000)\nnames='aD gD xD oD aG gG xG oG a2 g2 x2 o2'.split()\nfor n,v in zip(names,p): print(f'{n}={v:.4f}')\nrms=np.sqrt(np.mean((y-g3(x,*p))**2)); print('global rms',round(rms,3))\nprint('global ID_IG',round(p[0]/p[4],6))\nEOF\npython3 /app/global_check.py\n"]
[182.222754, "o", "cat > /app/global_check.py << 'EOF'\r\n\u001b[?2004l\r"]
[182.222816, "o", "\u001b[?2004h> "]
[182.222847, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.222913, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.222999, "o", "> "]
[182.223046, "o", "d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.22308, "o", "x, y = d[:,0], d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.223175, "o", "def f(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.223221, "o", "    L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.223311, "o", "    return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)-oD + L(a2,g2,x2,o2)-oD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.223393, "o", "def g3(xv,aD,gD,xD,oD,aG,gG,xG,oG,a2,g2,x2,o2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.223455, "o", "    L = lambda a,g,xc,o: a*g*g/((xv-xc)**2+g*g)+o\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.223493, "o", "> "]
[182.22354, "o", "    return L(aD,gD,xD,oD)+L(aG,gG,xG,oG)+L(a2,g2,x2,o2)-2*oD\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.22358, "o", "> "]
[182.22364, "o", "p0=[636,12.8,1354,839,6551,9.08,1579,799,9807,25.6,2689,736]\r\n\u001b[?2004l\r"]
[182.22367, "o", "\u001b[?2004h> "]
[182.223731, "o", "p,cov=curve_fit(g3,x,y,p0=p0,maxfev=200000)\r\n\u001b[?2004l\r"]
[182.223761, "o", "\u001b[?2004h> "]
[182.223846, "o", "names='aD gD xD oD aG gG xG oG a2 g2 x2 o2'.split()\r\n\u001b[?2004l\r"]
[182.223878, "o", "\u001b[?2004h> "]
[182.223959, "o", "for n,v in zip(names,p): print(f'{n}={v:.4f}')\r\n\u001b[?2004l\r"]
[182.224016, "o", "\u001b[?2004h> "]
[182.224089, "o", "rms=np.sqrt(np.mean((y-g3(x,*p))**2)); print('global rms',round(rms,3))\r\n\u001b[?2004l\r"]
[182.224121, "o", "\u001b[?2004h> "]
[182.224161, "o", "print('global ID_IG',round(p[0]/p[4],6))\r\n\u001b[?2004l\r"]
