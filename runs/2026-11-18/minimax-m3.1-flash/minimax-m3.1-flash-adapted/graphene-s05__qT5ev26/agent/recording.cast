[175.322251, "o", "cat /app/results.json; python3 -c \"import json;d=json.load(open('/app/results.json'));print('keys:',sorted(d));print('types ok:', all(isinstance(v,float) for k in ['D','G','2D'] for v in d[k].values()), isinstance(d['ID_IG'],float))\"\r\n\u001b[?2004l\r"]
[175.323255, "o", "{\r\n  \"D\": {\r\n    \"x0\": 1353.973816386235,\r\n    \"gamma\": 12.782507928442012,\r\n    \"amplitude\": 635.9428474432194,\r\n    \"offset\": 838.7345234108885\r\n  },\r\n  \"G\": {\r\n    \"x0\": 1579.390949294582,\r\n    \"gamma\": 9.08329376780894,\r\n    \"amplitude\": 6550.646253862328,\r\n    \"offset\": 798.7673234549862\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2688.6976703724185,\r\n    \"gamma\": 25.572642114897345,\r\n    \"amplitude\": 9806.779098998828,\r\n    \"offset\": 735.6796162701386\r\n  },\r\n  \"ID_IG\": 0.09708093259779689\r\n}\r\n"]
