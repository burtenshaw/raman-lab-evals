[120.220204, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef model(xv, amp, gamma, x0, off):\n    return amp*gamma**2/((xv-x0)**2 + gamma**2) + off\n\ndef fit(lo, hi):\n    m = (x>=lo)&(x<=hi)\n    xv, yv = x[m], y[m]\n    off0 = np.percentile(yv, 10)\n    amp0 = max(yv.max()-off0, 1.0)\n    x00 = xv[np.argmax(yv)]\n    above = xv[yv >= off0+amp0/2]\n    g0 = max((above.max()-above.min())/2, 3.0) if above.size>1 else 20.0\n    p, cov = curve_fit(model, xv, yv, p0=[amp0, g0, x00, off0],\n                       bounds=([0, 0.5, lo, -np.inf],[np.inf, 500, hi, np.inf]), maxfev=200000)\n    rms = np.sqrt(np.mean((yv-model(xv,*p))**2))\n    return p, rms, m.sum()\n\ncases = {\n 'D':  [(1200,1500),(1250,1450),(1300,1420),(1280,1430),(1320,1390),(1250,1480)],\n 'G':  [(1450,1750),(1500,1700),(1520,1680),(1480,1720),(1540,1640)],\n '2D': [(2400,3000),(2450,2950),(2500,2900),(2350,3000),(2450,2900),(2550,2850)],\n}\nfor nam"]
[120.220311, "i", "e, wl in cases.items():\n    print('===',name)\n    for lo,hi in wl:\n        try:\n            p,rms,n = fit(lo,hi)\n            print(f'  {lo:5.0f}-{hi:5.0f} n={n:4d} amp={p[0]:9.2f} gamma={p[1]:8.3f} x0={p[2]:9.3f} off={p[3]:8.2f} rms={rms:7.2f}')\n        except Exception as e:\n            print('  ',lo,hi,'FAIL',repr(e))\nEOF\npython3 /app/fit_test.py\n"]
