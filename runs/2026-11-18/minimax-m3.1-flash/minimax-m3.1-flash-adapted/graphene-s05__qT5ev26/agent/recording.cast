[79.751092, "o", "\u001b[?2004hroot@j-openenv-6afd8ca629e8b7ccfbbb834e-9c0km5mq-ade54-mv7kv:/app# "]
[96.01699, "i", "cat > /app/fit_test.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef model(xv, amp, gamma, x0, off):\n    return amp*gamma**2/((xv-x0)**2 + gamma**2) + off\n\ndef fit(lo, hi, p0):\n    m = (x>=lo)&(x<=hi)\n    xv, yv = x[m], y[m]\n    p, cov = curve_fit(model, xv, yv, p0=p0, maxfev=200000)\n    resid = yv - model(xv, *p)\n    return p, np.sqrt(np.mean(resid**2)), m.sum()\n\npeaks = {'D': (1350, [1250,1275,1300,1320]), 'G': (1580, [1460,1490,1520,1550]), '2D': (2690, [2400,2450,2500,2550])}\nfor name,(ctr,wins) in peaks.items():\n    print('===',name)\n    for w in wins:\n        lo, hi = ctr-w, ctr+w\n        m = (x>=lo)&(x<=hi)\n        yv = y[m]; xv = x[m]\n        off0 = np.percentile(yv, 10)\n        amp0 = yv.max()-off0\n        i = np.argmax(yv)\n        x00 = xv[i]\n        # half width estimate at half max\n        above = xv[yv >= off0+amp0/2]\n        g0 = max((above.max()-above.min())/2, 3.0) if above.size>1 else"]
[96.017117, "i", " 20.0\n        try:\n            p, rms, n = fit(lo, hi, [amp0, g0, x00, off0])\n            print(f'  window {lo:.0f}-{hi:.0f} n={n:4d} amp={p[0]:9.2f} gamma={p[1]:7.3f} x0={p[2]:9.3f} off={p[3]:8.2f} rms={rms:7.2f}')\n        except Exception as e:\n            print('  window', lo, hi, 'FAIL', e)\nEOF\npython3 /app/fit_test.py\n"]
[96.017188, "o", "cat > /app/fit_test.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.0172, "o", "> "]
[96.017278, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.017326, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[96.017365, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.017445, "o", "\u001b[?2004h> "]
[96.017501, "o", "d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.017541, "o", "x, y = d[:,0], d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.017593, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.017656, "o", "def model(xv, amp, gamma, x0, off):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.017722, "o", "    return amp*gamma**2/((xv-x0)**2 + gamma**2) + off\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.017774, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.017816, "o", "def fit(lo, hi, p0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.017863, "o", "    m = (x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[96.017921, "o", "\u001b[?2004h>     xv, yv = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.017987, "o", "    p, cov = curve_fit(model, xv, yv, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.018029, "o", "> "]
[96.01809, "o", "    resid = yv - model(xv, *p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018135, "o", "    return p, np.sqrt(np.mean(resid**2)), m.sum()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018178, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018368, "o", "peaks = {'D': (1350, [1250,1275,1300,1320]), 'G': (1580, [1460,1490,1520,1550]), '2D': (2690, [2400,2450,2500,2550])}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018463, "o", "for name,(ctr,wins) in peaks.items():\r\n\u001b[?2004l\r\u001b[?2004h>     print('===',name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018504, "o", "    for w in wins:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018534, "o", "        lo, hi = ctr-w, ctr+w\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018578, "o", "        m = (x>=lo)&(x<=hi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.01862, "o", "> "]
[96.018638, "o", "        yv = y[m]; xv = x[m]\r\n\u001b[?2004l\r"]
[96.018683, "o", "\u001b[?2004h> "]
[96.018735, "o", "        off0 = np.percentile(yv, 10)\r\n\u001b[?2004l\r"]
[96.01878, "o", "\u001b[?2004h> "]
[96.018837, "o", "        amp0 = yv.max()-off0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018883, "o", "        i = np.argmax(yv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018922, "o", "        x00 = xv[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.018962, "o", "        # half width estimate at half max\r\n\u001b[?2004l\r"]
[96.019007, "o", "\u001b[?2004h> "]
[96.019043, "o", "        above = xv[yv >= off0+amp0/2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.019127, "o", "        g0 = max((above.max()-above.min())/2, 3.0) if above.size>1 else 20.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.019155, "o", ">         try:\r\n\u001b[?2004l\r"]
[96.01921, "o", "\u001b[?2004h> "]
[96.019253, "o", "            p, rms, n = fit(lo, hi, [amp0, g0, x00, off0])\r\n\u001b[?2004l\r"]
[96.019294, "o", "\u001b[?2004h> "]
[96.019435, "o", "            print(f'  window {lo:.0f}-{hi:.0f} n={n:4d} amp={p[0]:9.2f} gamma={p[1]:7.3f} x0={p[2]:9.3f} off={p[3]:8.2f} rms={rms:7.2f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.019495, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.019532, "o", "> "]
[96.019591, "o", "            print('  window', lo, hi, 'FAIL', e)\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.019643, "o", "> EOF\r\n\u001b[?2004l\r"]
