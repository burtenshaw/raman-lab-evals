[155.322796, "o", "    p, cov = curve_fit(lorentz, xv, yv, p0=[amp0, g0, x00, off0],\r\n\u001b[?2004l\r"]
[155.322827, "o", "\u001b[?2004h> "]
[155.322984, "o", "                       bounds=([0.0, 0.5, lo, -np.inf], [np.inf, 500.0, hi, np.inf]),\r\n\u001b[?2004l\r"]
[155.323018, "o", "\u001b[?2004h> "]
[155.323084, "o", "                       maxfev=200000)\r\n\u001b[?2004l\r"]
[155.323114, "o", "\u001b[?2004h> "]
[155.32323, "o", "    rms = float(np.sqrt(np.mean((yv - lorentz(xv, *p))**2)))\r\n\u001b[?2004l\r"]
[155.323276, "o", "\u001b[?2004h> "]
[155.323322, "o", "    perr = np.sqrt(np.diag(cov))\r\n\u001b[?2004l\r"]
[155.32336, "o", "\u001b[?2004h> "]
[155.323397, "o", "    return p, rms, perr\r\n\u001b[?2004l\r"]
[155.323435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[155.323479, "o", "\u001b[?2004h"]
[155.323511, "o", "> "]
[155.323606, "o", "windows = {'D': (1250.0, 1450.0), 'G': (1500.0, 1700.0), '2D': (2450.0, 2950.0)}\r\n\u001b[?2004l\r"]
[155.323643, "o", "\u001b[?2004h> "]
[155.323673, "o", "out = {}\r\n\u001b[?2004l\r"]
[155.323717, "o", "\u001b[?2004h> "]
[155.323759, "o", "for name, (lo, hi) in windows.items():\r\n\u001b[?2004l\r"]
[155.323796, "o", "\u001b[?2004h> "]
[155.323861, "o", "    p, rms, perr = fit_window(lo, hi)\r\n\u001b[?2004l\r"]
[155.323892, "o", "\u001b[?2004h> "]
[155.32398, "o", "    amp, gamma, x0, off = [float(v) for v in p]\r\n\u001b[?2004l\r"]
[155.324018, "o", "\u001b[?2004h> "]
[155.324148, "o", "    out[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amp, 'offset': off}\r\n\u001b[?2004l\r"]
[155.324185, "o", "\u001b[?2004h> "]
[155.324402, "o", "    print(f'{name:>2s} window=[{lo:.0f},{hi:.0f}] x0={x0:.4f}+-{perr[2]:.4f} gamma={gamma:.4f}+-{perr[1]:.4f} '\r\n\u001b[?2004l\r"]
[155.324438, "o", "\u001b[?2004h> "]
[155.324582, "o", "          f'amp={amp:.3f}+-{perr[0]:.3f} off={off:.3f} rms={rms:.3f}')\r\n\u001b[?2004l\r"]
[155.32462, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[155.324649, "o", "> "]
[155.324767, "o", "out['ID_IG'] = float(out['D']['amplitude'] / out['G']['amplitude'])\r\n\u001b[?2004l\r"]
[155.324804, "o", "\u001b[?2004h> "]
[155.324854, "o", "print('ID_IG =', out['ID_IG'])\r\n\u001b[?2004l\r"]
[155.324903, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[155.324936, "o", "\u001b[?2004h> "]
[155.324999, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[155.325036, "o", "\u001b[?2004h> "]
[155.325089, "o", "    json.dump(out, f, indent=2)\r\n\u001b[?2004l\r"]
[155.325126, "o", "\u001b[?2004h> "]
[155.325158, "o", "    f.write('\\n')\r\n\u001b[?2004l\r"]
[155.325196, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
