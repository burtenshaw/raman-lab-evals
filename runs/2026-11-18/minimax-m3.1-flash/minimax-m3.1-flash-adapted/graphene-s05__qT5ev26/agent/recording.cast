[155.320698, "i", "cat > /app/fit_spectrum.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = data[:, 0], data[:, 1]\n\ndef lorentz(xv, amp, gamma, x0, off):\n    return amp * gamma**2 / ((xv - x0)**2 + gamma**2) + off\n\ndef fit_window(lo, hi):\n    m = (x >= lo) & (x <= hi)\n    xv, yv = x[m], y[m]\n    off0 = float(np.percentile(yv, 10))\n    amp0 = max(float(yv.max()) - off0, 1.0)\n    x00 = float(xv[np.argmax(yv)])\n    above = xv[yv >= off0 + amp0 / 2.0]\n    g0 = max(float((above.max() - above.min()) / 2.0), 3.0) if above.size > 1 else 20.0\n    p, cov = curve_fit(lorentz, xv, yv, p0=[amp0, g0, x00, off0],\n                       bounds=([0.0, 0.5, lo, -np.inf], [np.inf, 500.0, hi, np.inf]),\n                       maxfev=200000)\n    rms = float(np.sqrt(np.mean((yv - lorentz(xv, *p))**2)))\n    perr = np.sqrt(np.diag(cov))\n    return p, rms, perr\n\nwindows = {'D': (1250.0, 1450.0), 'G': (1500.0, 1700.0), '2D': (2450.0, 2950.0)}\nout = {}"]
[155.320889, "i", "\nfor name, (lo, hi) in windows.items():\n    p, rms, perr = fit_window(lo, hi)\n    amp, gamma, x0, off = [float(v) for v in p]\n    out[name] = {'x0': x0, 'gamma': gamma, 'amplitude': amp, 'offset': off}\n    print(f'{name:>2s} window=[{lo:.0f},{hi:.0f}] x0={x0:.4f}+-{perr[2]:.4f} gamma={gamma:.4f}+-{perr[1]:.4f} '\n          f'amp={amp:.3f}+-{perr[0]:.3f} off={off:.3f} rms={rms:.3f}')\n\nout['ID_IG'] = float(out['D']['amplitude'] / out['G']['amplitude'])\nprint('ID_IG =', out['ID_IG'])\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(out, f, indent=2)\n    f.write('\\n')\nEOF\npython3 /app/fit_spectrum.py\n"]
[155.32092, "o", "cat > /app/fit_spectrum.py << 'EOF'\r\n\u001b[?2004l\r"]
