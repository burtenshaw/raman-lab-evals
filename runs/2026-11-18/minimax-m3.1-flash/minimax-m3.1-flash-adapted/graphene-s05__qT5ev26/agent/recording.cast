[79.564767, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\nprint('n=', len(x), 'range', x.min(), x.max(), 'dx', np.diff(x)[:5])\nfor lo in range(1100, 3000, 25):\n    m = (x>=lo)&(x<lo+25)\n    if m.any():\n        print(f\"{lo:5d}-{lo+25:5d}  max={y[m].max():9.1f}  mean={y[m].mean():9.1f}  argmax={x[m][np.argmax(y[m])]:8.2f}\")\nEOF\npython3 /app/explore.py\n"]
