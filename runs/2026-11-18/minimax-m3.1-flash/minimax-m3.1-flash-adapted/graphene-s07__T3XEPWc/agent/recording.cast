[151.980954, "i", "cat > /app/global.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)\nx,y=d[:,0],d[:,1]\n\ndef mod(x,*p):\n    return (p[0]*p[1]**2/((x-p[2])**2+p[1]**2) + p[3]*p[4]**2/((x-p[5])**2+p[4]**2)\n            + p[6]*p[7]**2/((x-p[8])**2+p[7]**2) + p[9] + p[10]*(x-2000.0))\n\np0=[8212,16.7,1348.25, 7521,13.0,1580.4, 10376,20.9,2692.4, 1300, 0.0]\np,cov=curve_fit(mod,x,y,p0=p0,maxfev=500000)\nerr=np.sqrt(np.diag(cov))\nr=y-mod(x,*p)\nprint('global linear-bg fit:')\nfor nm,i in [('D',0),('G',3),('2D',6)]:\n    print('  %-2s x0=%.3f g=%.3f a=%.1f (+-%.1f)'%(nm,p[i+2],p[i+1],p[i],err[i]))\nprint('  off=%.1f slope=%.4f  rms resid=%.2f  ID/IG=%.5f'%(p[9],p[10],np.sqrt(np.mean(r**2)),p[0]/p[3]))\nEOF\npython3 /app/global.py\n"]
[151.981098, "o", "cat > /app/global.py << 'EOF'\r\n\u001b[?2004l\r"]
