[45.490238, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx = data[:,0]; y = data[:,1]\nprint('n =', len(x), 'x range', x.min(), x.max())\nprint('y range', y.min(), y.max(), 'median', np.median(y))\nfor lo, hi in [(1150,1550),(1400,1750),(2400,2950)]:\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    idx = np.argsort(ys)[-6:]\n    print('window', lo, hi, sorted([(round(float(xs[i]),1), round(float(ys[i]),1)) for i in idx]))\nprint()\nfor x0 in range(1100, 3001, 25):\n    m = (x>=x0)&(x<x0+25)\n    print(x0, round(float(y[m].mean()),1), round(float(y[m].max()),1))\nEOF\npython3 /app/explore.py\n"]
