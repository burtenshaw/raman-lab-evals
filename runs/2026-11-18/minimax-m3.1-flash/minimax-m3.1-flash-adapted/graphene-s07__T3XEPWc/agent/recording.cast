[170.544301, "o", "> "]
[170.544312, "o", "y = data[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.544343, "o", "\u001b[?2004h> "]
[170.544395, "o", "def lorentzian(x, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r"]
[170.544426, "o", "\u001b[?2004h> "]
[170.544503, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
