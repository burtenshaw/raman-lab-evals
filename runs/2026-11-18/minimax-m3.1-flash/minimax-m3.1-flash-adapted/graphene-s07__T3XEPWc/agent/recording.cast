[180.550216, "o", "\u001b[?2004h"]
[180.550256, "o", "root@j-openenv-6afd8e44e5cad0e4dc3e6e4e-nj43g79q-9f543-69lqt:/app# "]
[180.789234, "i", "python3 -c \"import json; r=json.load(open('/app/results.json')); print(sorted(r)); print(r['ID_IG'], r['D']['amplitude']/r['G']['amplitude']); [print(k, {kk:type(vv).__name__ for kk,vv in v.items()}) for k,v in r.items() if k!='ID_IG']\"\n"]
[180.789579, "o", "python3 -c \"import json; r=json.load(open('/app/results.json')); print(sorted(r)); print(r['ID_IG'], r['D']['amplitude']/r['G']['amplitude']); [print(k, {kk:type(vv).__name__ for kk,vv in v.items()}) for k,v in r.items() if k!='ID_IG']\"\r\n\u001b[?2004l\r"]
