[126.386349, "i", "cat > /app/joint.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)\nx,y=d[:,0],d[:,1]\n\ndef model3(x,*p):\n    return (p[0]*p[1]**2/((x-p[2])**2+p[1]**2) + p[3]*p[4]**2/((x-p[5])**2+p[4]**2)\n            + p[6]*p[7]**2/((x-p[8])**2+p[7]**2) + p[9])\n\ndef model3sep(x,*p):\n    return (p[0]*p[1]**2/((x-p[2])**2+p[1]**2) + p[9]\n            + p[3]*p[4]**2/((x-p[5])**2+p[4]**2) + p[10]\n            + p[6]*p[7]**2/((x-p[8])**2+p[7]**2) + p[11])\n\np0=[8212,16.7,1348.25, 7521,13.0,1580.4, 10376,20.9,2692.4, 1400]\np,_=curve_fit(model3,x,y,p0=p0,maxfev=500000)\nprint('joint shared offset:')\nprint('  D  x0=%.3f g=%.3f a=%.1f'% (p[2],p[1],p[0]))\nprint('  G  x0=%.3f g=%.3f a=%.1f'% (p[5],p[4],p[3]))\nprint('  2D x0=%.3f g=%.3f a=%.1f'% (p[8],p[7],p[6]))\nprint('  off=%.1f  ID/IG=%.5f'%(p[9],p[0]/p[3]))\n\np0s=[8212,16.7,1348.25, 7521,13.0,1580.4, 10376,20.9,2692.4, 1300,1350,1420]\np2,_=curve_fit(model3sep,x,y,p0=p0s,maxfev=500000)\nprint('joint separate offset"]
[126.386507, "i", "s:')\nprint('  D  x0=%.3f g=%.3f a=%.1f off=%.1f'% (p2[2],p2[1],p2[0],p2[9]))\nprint('  G  x0=%.3f g=%.3f a=%.1f off=%.1f'% (p2[5],p2[4],p2[3],p2[10]))\nprint('  2D x0=%.3f g=%.3f a=%.1f off=%.1f'% (p2[8],p2[7],p2[6],p2[11]))\nprint('  ID/IG=%.5f'%(p2[0]/p2[3]))\nEOF\npython3 /app/joint.py\n"]
