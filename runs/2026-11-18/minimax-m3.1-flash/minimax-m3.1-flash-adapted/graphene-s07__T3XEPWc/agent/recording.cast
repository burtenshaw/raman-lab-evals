[102.467908, "i", "cat > /app/robust.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)\nx,y=d[:,0],d[:,1]\n\ndef L(x,x0,g,a,o): return a*g**2/((x-x0)**2+g**2)+o\n\ndef fitw(lo,hi,p0):\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,_=curve_fit(L,xs,ys,p0=p0,maxfev=200000); return p\n\nprint('--- window sensitivity ---')\nfor lo in [1200,1220,1240,1260,1280,1300]:\n    for hi in [1400,1420,1440,1460,1480,1500]:\n        if hi-lo<80: continue\n        p=fitw(lo,hi,[1348,16,8200,1250])\n        print('D [%d,%d] x0=%.3f g=%.3f a=%.1f o=%.1f'%(lo,hi,p[0],p[1],p[2],p[3]))\nprint()\nfor lo in [1450,1470,1490,1510,1530]:\n    for hi in [1650,1670,1690,1710,1730]:\n        p=fitw(lo,hi,[1580,13,7500,1300])\n        print('G [%d,%d] x0=%.3f g=%.3f a=%.1f o=%.1f'%(lo,hi,p[0],p[1],p[2],p[3]))\nprint()\nfor lo in [2540,2560,2580,2600,2620]:\n    for hi in [2760,2780,2800,2820,2840]:\n        p=fitw(lo,hi,[2692,21,10400,1420])\n        print('2D [%d,%d] x0=%.3f g=%.3f a=%.1f o=%.1f'%(lo,hi,"]
[102.468042, "i", "p[0],p[1],p[2],p[3]))\n\nprint()\nprint('--- joint fit, 3 peaks + 1 shared offset ---')\ndef model(x,*p):\n    return (p[0]*p[1]**2/((x-p[2])**2+p[1]**2) + p[3]*p[4]**2/((x-p[5])**2+p[4]**2)\n            + p[6]*p[7]**2/((x-p[8])**2+p[7]**2) + p[9])\np0=[16.7,8212,1348.25, 13.0,7521,1580.4, 20.9,10376,2692.4, 1400]\np,_=curve_fit(model,x,y,p0=p0,maxfev=500000)\nprint('x0s',np.round(p[[2,5,8]],3),'gammas',np.round(p[[1,4,7]],3),'amps',np.round(p[[0,3,6]],1),'off',round(p[9],1))\nprint('ID/IG joint = %.5f'%(p[0]/p[3]))\nEOF\npython3 /app/robust.py\n"]
[102.468089, "o", "cat > /app/robust.py << 'EOF'\r\n\u001b[?2004l\r"]
