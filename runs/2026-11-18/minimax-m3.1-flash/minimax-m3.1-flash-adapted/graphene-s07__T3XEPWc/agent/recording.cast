[55.652646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.652684, "o", "\u001b[?2004h> "]
[55.652725, "o", "# noise estimate in peak-free regions\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.652765, "o", "> "]
[55.652792, "o", "for lo,hi in [(1700,2400),(2800,3000),(1100,1200)]:\r\n\u001b[?2004l\r"]
[55.652831, "o", "\u001b[?2004h> "]
[55.652869, "o", "    m=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[55.65291, "o", "\u001b[?2004h> "]
[55.653017, "o", "    print('region',lo,hi,'median %.1f std %.1f min %.1f max %.1f'%(np.median(y[m]), np.std(y[m]), y[m].min(), y[m].max()))\r\n\u001b[?2004l\r"]
[55.653046, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.653085, "o", "\u001b[?2004h> "]
[55.653123, "o", "def fit(lo,hi,p0,name):\r\n\u001b[?2004l\r"]
[55.65317, "o", "\u001b[?2004h> "]
[55.653223, "o", "    m=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r\u001b[?2004h>     xs,ys=x[m],y[m]\r\n\u001b[?2004l\r"]
[55.653263, "o", "\u001b[?2004h> "]
[55.65331, "o", "    p,cov=curve_fit(lor,xs,ys,p0=p0,maxfev=100000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.653356, "o", "    res=ys-lor(xs,*p)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.653394, "o", "> "]
[55.653558, "o", "    print('%-4s win[%d,%d] x0=%.3f gamma=%.3f amp=%.2f off=%.2f  rms=%.2f maxres=%.1f'%(name,lo,hi,p[0],p[1],p[2],p[3],np.sqrt(np.mean(res**2)),np.max(np.abs(res))))\r\n\u001b[?2004l\r"]
[55.653601, "o", "\u001b[?2004h> "]
[55.653651, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.653692, "o", "\u001b[?2004h> "]
[55.653735, "o", "for lo,hi in [(1230,1470),(1250,1450),(1280,1420),(1200,1500)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.653802, "o", "    fit(lo,hi,[1348,15,8000,1400],'D')\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.653828, "o", "> print()\r\n\u001b[?2004l\r"]
