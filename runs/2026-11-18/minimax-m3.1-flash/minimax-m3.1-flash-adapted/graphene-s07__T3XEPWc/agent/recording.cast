[170.54411, "o", "> \r\n\u001b[?2004l\r"]
[170.544135, "o", "\u001b[?2004h> "]
[170.544201, "o", "data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\r\n\u001b[?2004l\r"]
[170.54421, "o", "\u001b[?2004h"]
[170.544242, "o", "> "]
