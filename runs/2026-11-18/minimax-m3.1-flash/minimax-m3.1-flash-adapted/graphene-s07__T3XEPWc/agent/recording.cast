[55.651945, "i", "cat > /app/analyze.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, x0, gamma, amp, off):\n    return amp*gamma**2/((x-x0)**2+gamma**2)+off\n\n# noise estimate in peak-free regions\nfor lo,hi in [(1700,2400),(2800,3000),(1100,1200)]:\n    m=(x>=lo)&(x<=hi)\n    print('region',lo,hi,'median %.1f std %.1f min %.1f max %.1f'%(np.median(y[m]), np.std(y[m]), y[m].min(), y[m].max()))\n\ndef fit(lo,hi,p0,name):\n    m=(x>=lo)&(x<=hi)\n    xs,ys=x[m],y[m]\n    p,cov=curve_fit(lor,xs,ys,p0=p0,maxfev=100000)\n    res=ys-lor(xs,*p)\n    print('%-4s win[%d,%d] x0=%.3f gamma=%.3f amp=%.2f off=%.2f  rms=%.2f maxres=%.1f'%(name,lo,hi,p[0],p[1],p[2],p[3],np.sqrt(np.mean(res**2)),np.max(np.abs(res))))\n    return p\n\nfor lo,hi in [(1230,1470),(1250,1450),(1280,1420),(1200,1500)]:\n    fit(lo,hi,[1348,15,8000,1400],'D')\nprint()\nfor lo,hi in [(1470,1700),(1500,1660),(1520,1640),(1450,1720)]:\n    fit(lo,hi,[1580,15,7300,1400],'G')"]
[55.651983, "i", "\nprint()\nfor lo,hi in [(2580,2800),(2600,2790),(2620,2770),(2550,2830),(2560,2850)]:\n    fit(lo,hi,[2690,20,10000,1450],'2D')\nEOF\npython3 /app/analyze.py\n"]
