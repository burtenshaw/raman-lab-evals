[126.952883, "o", "joint shared offset:\r\n  D  x0=1348.232 g=16.092 a=8198.8\r\n  G  x0=1580.409 g=12.554 a=7508.3\r\n  2D x0=2692.416 g=21.525 a=10389.0\r\n  off=1325.3  ID/IG=1.09196\r\n"]
[126.963537, "o", "joint separate offsets:\r\n  D  x0=1348.232 g=16.092 a=8198.8 off=-17391664.8\r\n  G  x0=1580.409 g=12.554 a=7508.3 off=-7125329.6\r\n  2D x0=2692.416 g=21.525 a=10389.0 off=24518319.8\r\n  ID/IG=1.09196\r\n"]
