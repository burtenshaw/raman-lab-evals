[152.54723, "o", "global linear-bg fit:\r\n  D  x0=1348.213 g=16.798 a=8221.5 (+-19.6)\r\n  G  x0=1580.401 g=12.959 a=7520.9 (+-22.3)\r\n  2D x0=2692.391 g=20.879 a=10376.2 (+-17.6)\r\n"]
[152.547364, "o", "  off=1314.1 slope=0.1449  rms resid=100.56  ID/IG=1.09315\r\n"]
