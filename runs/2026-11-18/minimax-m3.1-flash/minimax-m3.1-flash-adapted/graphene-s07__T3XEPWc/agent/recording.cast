[170.544602, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.544643, "o", "peaks = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.544729, "o", "    'D':  {'window': (1250.0, 1450.0), 'p0': [1348.0, 16.0, 8200.0, 1250.0]},\r\n\u001b[?2004l\r"]
[170.544757, "o", "\u001b[?2004h> "]
[170.544856, "o", "    'G':  {'window': (1500.0, 1660.0), 'p0': [1580.0, 13.0, 7500.0, 1300.0]},\r\n\u001b[?2004l\r"]
[170.544887, "o", "\u001b[?2004h> "]
[170.544982, "o", "    '2D': {'window': (2600.0, 2790.0), 'p0': [2692.0, 21.0, 10400.0, 1420.0]},\r\n\u001b[?2004l\r"]
[170.545009, "o", "\u001b[?2004h> "]
[170.545022, "o", "}\r\n\u001b[?2004l\r"]
[170.545072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.545111, "o", "\u001b[?2004h> "]
[170.545137, "o", "results = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.545189, "o", "for name, cfg in peaks.items():\r\n\u001b[?2004l\r"]
[170.545215, "o", "\u001b[?2004h> "]
[170.545251, "o", "    lo, hi = cfg['window']\r\n\u001b[?2004l\r"]
[170.545279, "o", "\u001b[?2004h> "]
[170.545324, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[170.545351, "o", "\u001b[?2004h> "]
[170.545391, "o", "    xs, ys = x[m], y[m]\r\n\u001b[?2004l\r"]
[170.5454, "o", "\u001b[?2004h> "]
[170.545508, "o", "    p, cov = curve_fit(lorentzian, xs, ys, p0=cfg['p0'], maxfev=200000)\r\n\u001b[?2004l\r"]
[170.545535, "o", "\u001b[?2004h> "]
[170.545594, "o", "    x0, gamma, amplitude, offset = p\r\n\u001b[?2004l\r"]
[170.545649, "o", "\u001b[?2004h> "]
[170.545686, "o", "    resid = ys - lorentzian(xs, *p)\r\n\u001b[?2004l\r"]
[170.545722, "o", "\u001b[?2004h> "]
[170.545797, "o", "    print('%3s win=[%g,%g] x0=%.4f gamma=%.4f amplitude=%.3f offset=%.3f rms=%.2f' %\r\n\u001b[?2004l\r"]
[170.545836, "o", "\u001b[?2004h> "]
[170.545933, "o", "          (name, lo, hi, x0, gamma, amplitude, offset, np.sqrt(np.mean(resid**2))))\r\n\u001b[?2004l\r"]
[170.545967, "o", "\u001b[?2004h"]
[170.546002, "o", "> "]
[170.546025, "o", "    results[name] = {'x0': float(x0), 'gamma': float(gamma),\r\n\u001b[?2004l\r"]
[170.546034, "o", "\u001b[?2004h> "]
[170.546141, "o", "                      'amplitude': float(amplitude), 'offset': float(offset)}\r\n\u001b[?2004l\r"]
[170.546167, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.546196, "o", "\u001b[?2004h> "]
[170.54629, "o", "results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])\r\n\u001b[?2004l\r"]
[170.546314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.546326, "o", "\u001b[?2004h> "]
[170.546381, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[170.54641, "o", "\u001b[?2004h> "]
[170.546452, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[170.546476, "o", "\u001b[?2004h> "]
[170.546503, "o", "    f.write('\\n')\r\n\u001b[?2004l\r"]
[170.546531, "o", "\u001b[?2004h> "]
[170.546561, "o", "print('ID_IG =', results['ID_IG'])\r\n\u001b[?2004l\r"]
[170.546582, "o", "\u001b[?2004h> "]
[170.546606, "o", "EOF\r\n\u001b[?2004l\r"]
[170.54781, "o", "\u001b[?2004h"]
[170.54786, "o", "root@j-openenv-6afd8e44e5cad0e4dc3e6e4e-nj43g79q-9f543-69lqt:/app# "]
[170.547886, "o", "python3 /app/final_fit.py\r\n\u001b[?2004l\r"]
[171.149865, "o", "  D win=[1250,1450] x0=1348.2520 gamma=16.7335 amplitude=8212.085 offset=1260.803 rms=104.33\r\n"]
[171.150231, "o", "  G win=[1500,1660] x0=1580.3857 gamma=12.9925 amplitude=7520.763 offset=1295.288 rms=98.61\r\n"]
[171.150565, "o", " 2D win=[2600,2790] x0=2692.4094 gamma=20.8934 amplitude=10375.538 offset=1415.471 rms=101.17\r\n"]
[171.150784, "o", "ID_IG = 1.0919217885367034"]
[171.150819, "o", "\r\n"]
[171.196708, "o", "\u001b[?2004hroot@j-openenv-6afd8e44e5cad0e4dc3e6e4e-nj43g79q-9f543-69lqt:/app# "]
[180.549013, "i", "cat /app/results.json\n"]
