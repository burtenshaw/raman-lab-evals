[151.981484, "o", "\u001b[?2004h> "]
[151.981516, "o", "def mod(x,*p):\r\n\u001b[?2004l\r"]
[151.981545, "o", "\u001b[?2004h> "]
[151.981651, "o", "    return (p[0]*p[1]**2/((x-p[2])**2+p[1]**2) + p[3]*p[4]**2/((x-p[5])**2+p[4]**2)\r\n\u001b[?2004l\r"]
[151.981683, "o", "\u001b[?2004h> "]
[151.981778, "o", "            + p[6]*p[7]**2/((x-p[8])**2+p[7]**2) + p[9] + p[10]*(x-2000.0))\r\n\u001b[?2004l\r"]
[151.981807, "o", "\u001b[?2004h> \r\n"]
[151.981838, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[151.98194, "o", "p0=[8212,16.7,1348.25, 7521,13.0,1580.4, 10376,20.9,2692.4, 1300, 0.0]\r\n\u001b[?2004l\r"]
[151.98197, "o", "\u001b[?2004h> "]
[151.982029, "o", "p,cov=curve_fit(mod,x,y,p0=p0,maxfev=500000)\r\n\u001b[?2004l\r"]
