[?2004hroot@j-openenv-6afd8e44e5cad0e4dc3e6e4e-nj43g79q-9f543-69lqt:/app# cat > /app/final_fit.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x = data[:, 0]
[?2004l[?2004h> y = data[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {
[?2004l[?2004h>     'D':  {'window': (1250.0, 1450.0), 'p0': [1348.0, 16.0, 8200.0, 1250.0]},
[?2004l[?2004h>     'G':  {'window': (1500.0, 1660.0), 'p0': [1580.0, 13.0, 7500.0, 1300.0]},
[?2004l[?2004h>     '2D': {'window': (2600.0, 2790.0), 'p0': [2692.0, 21.0, 10400.0, 1420.0]},
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = {}
[?2004l[?2004h> for name, cfg in peaks.items():
[?2004l[?2004h>     lo, hi = cfg['window']
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     p, cov = curve_fit(lorentzian, xs, ys, p0=cfg['p0'], maxfev=200000)
[?2004l[?2004h>     x0, gamma, amplitude, offset = p
[?2004l[?2004h>     resid = ys - lorentzian(xs, *p)
[?2004l[?2004h>     print('%3s win=[%g,%g] x0=%.4f gamma=%.4f amplitude=%.3f offset=%.3f rms=%.2f' %
[?2004l[?2004h>           (name, lo, hi, x0, gamma, amplitude, offset, np.sqrt(np.mean(resid**2))))
[?2004l[?2004h>     results[name] = {'x0': float(x0), 'gamma': float(gamma),
[?2004l[?2004h>                       'amplitude': float(amplitude), 'offset': float(offset)}
[?2004l[?2004h> 
[?2004l[?2004h> results['ID_IG'] = float(results['D']['amplitude'] / results['G']['amplitude'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h>     f.write('\n')
