[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d = np.loadtxt('/app/spectrum.csv', delimiter=',', skiprows=1)
[?2004l[?2004h> x, y = d[:,0], d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, x0, gamma, amp, off):
[?2004l[?2004h>     return amp*gamma**2/((x-x0)**2+gamma**2)+off
[?2004l[?2004h> 
[?2004l[?2004h> # noise estimate in peak-free regions
[?2004l[?2004h> for lo,hi in [(1700,2400),(2800,3000),(1100,1200)]:
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     print('region',lo,hi,'median %.1f std %.1f min %.1f max %.1f'%(np.median(y[m]), np.std(y[m]), y[m].min(), y[m].max()))
[?2004l[?2004h> 
[?2004l[?2004h> def fit(lo,hi,p0,name):
[?2004l[?2004h>     m=(x>=lo)&(x<=hi)
[?2004l[?2004h>     xs,ys=x[m],y[m]
[?2004l[?2004h>     p,cov=curve_fit(lor,xs,ys,p0=p0,maxfev=100000)
[?2004l[?2004h>     res=ys-lor(xs,*p)
[?2004l[?2004h>     print('%-4s win[%d,%d] x0=%.3f gamma=%.3f amp=%.2f off=%.2f  rms=%.2f maxres=%.1f'%(name,lo,hi,p[0],p[1],p[2],p[3],np.sqrt(np.mean(res**2)),np.max(np.abs(res))))
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> for lo,hi in [(1230,1470),(1250,1450),(1280,1420),(1200,1500)]:
