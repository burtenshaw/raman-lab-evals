[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> d=np.loadtxt('/app/spectrum.csv',delimiter=',',skiprows=1)
[?2004l[?2004h> x,y=d[:,0],d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def mod(x,*p):
[?2004l[?2004h>     return (p[0]*p[1]**2/((x-p[2])**2+p[1]**2) + p[3]*p[4]**2/((x-p[5])**2+p[4]**2)
[?2004l[?2004h>             + p[6]*p[7]**2/((x-p[8])**2+p[7]**2) + p[9] + p[10]*(x-2000.0))
[?2004l[?2004h> 
[?2004l[?2004h> p0=[8212,16.7,1348.25, 7521,13.0,1580.4, 10376,20.9,2692.4, 1300, 0.0]
[?2004l[?2004h> p,cov=curve_fit(mod,x,y,p0=p0,maxfev=500000)
[?2004l[?2004h> err=np.sqrt(np.diag(cov))
[?2004l[?2004h> r=y-mod(x,*p)
[?2004l[?2004h> print('global linear-bg fit:')
[?2004l[?2004h> for nm,i in [('D',0),('G',3),('2D',6)]:
[?2004l[?2004h>     print('  %-2s x0=%.3f g=%.3f a=%.1f (+-%.1f)'%(nm,p[i+2],p[i+1],p[i],err[i]))
[?2004l[?2004h> print('  off=%.1f slope=%.4f  rms resid=%.2f  ID/IG=%.5f'%(p[9],p[10],np.sqrt(np.mean(r**2)),p[0]/p[3]))
[?2004l[?2004h> EOF
