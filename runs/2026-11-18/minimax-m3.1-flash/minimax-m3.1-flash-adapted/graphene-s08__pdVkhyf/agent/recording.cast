[157.374621, "i", "python3 - << 'EOF'\nimport json, numpy as np\nr = json.load(open('/app/results.json'))\nassert set(r) == {'D','G','2D','ID_IG'}, r.keys()\nfor k in ('D','G','2D'):\n    assert set(r[k]) == {'x0','gamma','amplitude','offset'}\n    assert all(isinstance(v,float) for v in r[k].values())\nassert isinstance(r['ID_IG'], float)\nprint('JSON OK')\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx,y = d[:,0], d[:,1]\nfor k in ('D','G','2D'):\n    p = r[k]\n    i = np.argmin(abs(x-p['x0']))\n    print(k, 'model peak', p['amplitude']+p['offset'], 'observed', y[i], 'at', x[i])\nprint('ID/IG =', r['ID_IG'])\nEOF\n"]
