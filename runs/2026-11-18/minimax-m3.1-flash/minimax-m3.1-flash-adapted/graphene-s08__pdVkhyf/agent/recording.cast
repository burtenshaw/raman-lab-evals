[93.011766, "i", "cat > /app/stability.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = d[:,0], d[:,1]\n\n# noise estimate from 2nd differences (away from peaks)\nm = ((x<1250)|((x>1700)&(x<2450))|(x>2820))\ny2 = y[m]\nd2 = np.diff(y2, 2)\nprint('noise est (2nd diff):', np.std(d2)/np.sqrt(6))\n\ndef lor(xx, x0, g, a, c):\n    return a*g*g/((xx-x0)**2 + g*g) + c\n\ndef fit(xx, yy, x0g, gg, ag, c0):\n    p, pc = curve_fit(lor, xx, yy, p0=[x0g, gg, ag, c0], maxfev=100000)\n    return p, np.std(yy-lor(xx,*p))\n\npeaks = {'D':(1350,15,1300), 'G':(1580,10,6600), '2D':(2685,17,13000)}\nfor name,(xg,gg,ag) in peaks.items():\n    print('==',name)\n    for half in [25,30,40,50,60,75,100,125]:\n        m = np.abs(x-xg) <= half\n        if m.sum() < 10: continue\n        p, rs = fit(x[m], y[m], xg, gg, ag, np.median(y[m]))\n        print(f'  +-{half:3d} n={m.sum():4d} x0={p[0]:9.3f} gamma={p[1]:7.3f} amp={p[2]:10.2f} off={p[3]:8.2f} residstd={rs:7.2f}')\nEOF\npython3 "]
[93.011922, "i", "/app/stability.py\n"]
