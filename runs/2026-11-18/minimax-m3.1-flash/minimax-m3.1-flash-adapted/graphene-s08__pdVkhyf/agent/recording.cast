[134.623925, "i", "cat > /app/final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(xx, x0, g, a, c):\n    return a*g*g/((xx-x0)**2 + g*g) + c\n\ndef do_fit(lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    p, _ = curve_fit(lor, x[m], y[m], p0=p0, maxfev=200000)\n    return p, m.sum()\n\nnominal = {'D': (1350.0, 13.5, 1300.0, 970.0),\n           'G': (1581.0, 8.5, 6600.0, 940.0),\n           '2D': (2685.0, 17.0, 13000.0, 810.0)}\n\nprint('--- window sensitivity ---')\nwindows = {\n  'D':  [(1249,1449),(1250,1450),(1290,1410),(1240,1460),(1270,1430)],\n  'G':  [(1531,1631),(1500,1650),(1520,1640),(1490,1670),(1540,1620)],\n  '2D': [(2585,2785),(2550,2800),(2600,2770),(2570,2800),(2620,2750)],\n}\nfor name, wins in windows.items():\n    for (lo,hi) in wins:\n        p, n = do_fit(lo, hi, list(nominal[name]))\n        print(f'{name:3s} [{lo},{hi}] n={n:4d} x0={p[0]:9.3f} gamma={p[1]:7.3f} amp={p[2]:10.2f} off={p[3]:8."]
[134.624066, "i", "2f}')\n\nprint('\\n--- final fit (+/-100 cm-1) ---')\nres = {}\nfor name, xg in (('D',1349.2),('G',1581.1),('2D',2684.7)):\n    lo, hi = xg-100.0, xg+100.0\n    p, n = do_fit(lo, hi, list(nominal[name]))\n    print(f'{name}: x0={p[0]:.4f} gamma={p[1]:.4f} amplitude={p[2]:.3f} offset={p[3]:.3f} (n={n})')\n    res[name] = {'x0': float(p[0]), 'gamma': float(p[1]), 'amplitude': float(p[2]), 'offset': float(p[3])}\n\nres['ID_IG'] = float(res['D']['amplitude'] / res['G']['amplitude'])\nwith open('/app/results.json','w') as f:\n    json.dump(res, f, indent=2)\nprint('\\nID_IG =', res['ID_IG'])\nEOF\npython3 /app/final_fit.py\n"]
[134.624135, "o", "cat > /app/final_fit.py << 'EOF'\r\n\u001b[?2004l\r2f}')\r\n\r\nprint('\\n--- final fit (+/-100 cm-1) ---')\r\nres = {}\r\nfor name, xg in (('D',1349.2),('G',1581.1),('2D',2684.7)):\r\n    lo, hi = xg-100.0, xg+100.0\r\n    p, n = do_fit(lo, hi, list(nominal[name]"]
[134.624159, "o", "))\r\n    print(f'{name}: x0={p[0]:.4f} gamma={p[1]"]
[134.624226, "o", ":.4f} amplitude={p[2]:.3f} offset={p[3]:.3f} (n={n})')\r\n    res[name] = {'x0': float(p[0]), 'gamma': float(p[1]), 'amplitude': float(p[2]), 'offset': f"]
[134.624262, "o", "loat(p[3])}\r\n\r\nres['ID_IG'] = float(res['D']['amplitude'] / res['G']['amplitude'])\r\nwith open('/app/results.json','w') as f:\r\n    json.dump(res, f, indent=2)\r\nprint('\\nID_IG =', res['ID_IG'])\r\nEOF\r\npython3 /app/final_fit.py\r\n"]
