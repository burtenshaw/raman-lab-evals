[77.345758, "i", "cat > /app/analyze.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = d[:,0], d[:,1]\n\ndef lor(x, x0, g, a, c):\n    return a*g*g/((x-x0)**2 + g*g) + c\n\n# baseline regions (away from peaks)\nregions = [(1100,1250),(1700,2450),(2800,3000)]\nm = np.zeros_like(x, bool)\nfor lo,hi in regions:\n    m |= (x>=lo)&(x<=hi)\ncoef = np.polyfit(x[m], y[m], 1)\nprint('off-peak linear fit slope,intercept:', coef)\nprint('mean off-peak:', y[m].mean(), 'std:', y[m].std())\n\n# global fit: 3 lorentzians + constant\ndef model(xx, x1,g1,a1, x2,g2,a2, x3,g3,a3, c):\n    return (lor(xx,x1,g1,a1,0)+lor(xx,x2,g2,a2,0)+lor(xx,x3,g3,a3,0)+c)\np0=[1350,15,1300,1580,15,6600,2690,25,13000,900]\npopt,_=curve_fit(model,x,y,p0=p0,maxfev=200000)\nprint('global popt:', popt)\nres = y-model(x,*popt)\nprint('global resid std:', res.std())\nfor lo in range(1100,3000,100):\n    mm=(x>=lo)&(x<lo+100)\n    print(f'{lo}: resid mean {res[mm].mean():9.2f} std {res[mm].std():8.2f"]
[77.345808, "i", "}')\nEOF\npython3 /app/analyze.py\n"]
[77.345924, "o", "cat > /app/analyze.py << 'EOF'\r\n"]
