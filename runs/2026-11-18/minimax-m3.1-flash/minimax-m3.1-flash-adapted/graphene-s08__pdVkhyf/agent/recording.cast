[68.724738, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)\nx, y = d[:,0], d[:,1]\nprint('n=', len(x), 'range', x.min(), x.max(), 'dx', np.diff(x).mean())\nfor lo in range(1100, 3000, 25):\n    m = (x >= lo) & (x < lo+25)\n    if m.any():\n        i = np.argmax(y[m])\n        print(f'{lo:5d} max={y[m][i]:9.1f} at {x[m][i]:8.2f}  mean={y[m].mean():8.1f}')\nEOF\npython3 /app/explore.py\n"]
