[114.065928, "o", "    pc,_ = curve_fit(lor, x[m], y[m], p0=[xg,gg,ag,cg], maxfev=100000)\r\n\u001b[?2004l\r"]
[114.065956, "o", "\u001b[?2004h> "]
[114.066, "o", "    rc = y[m]-lor(x[m],*pc)\r\n\u001b[?2004l\r"]
[114.066028, "o", "\u001b[?2004h> "]
