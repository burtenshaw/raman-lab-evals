[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = d[:,0], d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, x0, g, a, c):
[?2004l[?2004h>     return a*g*g/((x-x0)**2 + g*g) + c
[?2004l[?2004h> 
[?2004l[?2004h> # baseline regions (away from peaks)
[?2004l[?2004h> regions = [(1100,1250),(1700,2450),(2800,3000)]
[?2004l[?2004h> m = np.zeros_like(x, bool)
[?2004l[?2004h> for lo,hi in regions:
[?2004l[?2004h>     m |= (x>=lo)&(x<=hi)
[?2004l[?2004h> coef = np.polyfit(x[m], y[m], 1)
[?2004l[?2004h> print('off-peak linear fit slope,intercept:', coef)
[?2004l[?2004h> print('mean off-peak:', y[m].mean(), 'std:', y[m].std())
[?2004l[?2004h> 
[?2004l[?2004h> # global fit: 3 lorentzians + constant
[?2004l[?2004h> def model(xx, x1,g1,a1, x2,g2,a2, x3,g3,a3, c):
[?2004l[?2004h>     return (lor(xx,x1,g1,a1,0)+lor(xx,x2,g2,a2,0)+lor(xx,x3,g3,a3,0)+c)
[?2004l[?2004h> p0=[1350,15,1300,1580,15,6600,2690,25,13000,900]
[?2004l[?2004h> popt,_=curve_fit(model,x,y,p0=p0,maxfev=200000)
[?2004l[?2004h> print('global popt:', popt)
[?2004l[?2004h> res = y-model(x,*popt)
[?2004l[?2004h> print('global resid std:', res.std())
[?2004l[?2004h> for lo in range(1100,3000,100):
[?2004l[?2004h>     mm=(x>=lo)&(x<lo+100)
[?2004l[?2004h>     print(f'{lo}: resid mean {res[mm].mean():9.2f} std {res[mm].std():8.2f}')
[?2004l[?2004h> EOF
