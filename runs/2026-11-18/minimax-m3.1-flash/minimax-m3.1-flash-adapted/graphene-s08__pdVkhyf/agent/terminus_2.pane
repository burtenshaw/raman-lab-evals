[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', skip_header=1)
[?2004l[?2004h> x, y = d[:,0], d[:,1]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(xx, x0, g, a, c):
[?2004l[?2004h>     return a*g*g/((xx-x0)**2 + g*g) + c
[?2004l[?2004h> 
[?2004l[?2004h> def lor_lin(xx, x0, g, a, c, s):
[?2004l[?2004h>     return a*g*g/((xx-x0)**2 + g*g) + c + s*(xx-x0)
[?2004l[?2004h> 
[?2004l[?2004h> peaks = {'D':(1350,13.5,1314,970), 'G':(1580,8.4,6600,940), '2D':(2685,17,13060,807)}
[?2004l[?2004h> for name,(xg,gg,ag,cg) in peaks.items():
[?2004l[?2004h>     for half in [50, 80, 100]:
[?2004l[?2004h>         m = np.abs(x-xg) <= half
[?2004l[?2004h>         pc,_ = curve_fit(lor, x[m], y[m], p0=[xg,gg,ag,cg], maxfev=100000)
[?2004l[?2004h>         pl,_ = curve_fit(lor_lin, x[m], y[m], p0=[xg,gg,ag,cg,0.0], maxfev=100000)
[?2004l[?2004h>         rc = y[m]-lor(x[m],*pc)
[?2004l[?2004h>         rl = y[m]-lor_lin(x[m],*pl)
[?2004l[?2004h>         print(f'{name} +-{half}: const x0={pc[0]:.3f} g={pc[1]:.3f} a={pc[2]:.2f} c={pc[3]:.2f} std={rc.std():.2f} | linear x0={pl[0]:.3f} g={pl[1]:.3f} a={pl[2]:.2f} c={pl[3]:.2f} slope={pl[4]:.4f} std={rl.std():.2f}')
[?2004l[?2004h>     # binned residuals of constant model, +-100
[?2004l[?2004h>     m = np.abs(x-xg) <= 100
[?2004l[?2004h>     pc,_ = curve_fit(lor, x[m], y[m], p0=[xg,gg,ag,cg], maxfev=100000)
[?2004l[?2004h>     rc = y[m]-lor(x[m],*pc)
[?2004l[?2004h>     xm = x[m]
[?2004l[?2004h>     print(f'  {name} binned resid means (10cm bins):')
[?2004l[?2004h>     for lo in range(1100,3000,20):
[?2004l[?2004h>         mm=(xm>=lo)&(xm<lo+20)
[?2004l[?2004h>         if mm.any() and abs(xg-lo)<=140:
