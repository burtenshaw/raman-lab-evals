[177.714624, "i", "cat > /app/final_check.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d['intensity']\ndef lor(x,a,x0,g,o): return a*g*g/((x-x0)**2+g*g)+o\ndef two(x,a1,x1,g1,a2,x2,g2,o):\n    return a1*g1*g1/((x-x1)**2+g1*g1)+a2*g2*g2/((x-x2)**2+g2*g2)+o\nm=(x>=1200)&(x<=1700); xs,ys=x[m],y[m]\np,cov=curve_fit(two,xs,ys,p0=[6000,1355,18.5,7500,1583,11,900],maxfev=400000)\nprint('joint D+G window (1200-1700) shared offset: rms=%.1f'%np.sqrt(((two(xs,*p)-ys)**2).mean()))\nprint('  D  x0=%.3f g=%.3f A=%.2f'%(p[1],p[2],p[0]))\nprint('  G  x0=%.3f g=%.3f A=%.2f'%(p[4],p[5],p[3]))\nprint('  off=%.2f  ID/IG=%.5f'%(p[6],p[0]/p[3]))\nfor nm,(lo,hi,g0,x0g,a0) in {'D':(1200,1500,18.5,1355,6000),'G':(1450,1700,11.0,1583,7500),'2D':(2400,2950,28.5,2677,9970)}.items():\n    mm=(x>=lo)&(x<=hi)\n    pp,cc=curve_fit(lor,x[mm],y[mm],p0=[a0,x0g,g0,900],maxfev=200000)\n    e=np.sqrt(np.diag(cc))\n    print(f'{nm} win({lo},{hi}): x0={pp[1]:.3f}+"]
[177.714754, "i", "-{e[1]:.3f} g={pp[2]:.3f}+-{e[2]:.3f} A={pp[0]:.2f}+-{e[0]:.2f} off={pp[3]:.2f}+-{e[3]:.2f}')\nEOF\npython3 /app/final_check.py\n"]
[177.71483, "o", "cat > /app/final_check.py << 'EOF'\r\n\u001b[?2004l\r-{e[1]:.3f} g={pp[2]:.3f}+-{e[2]:.3f} A={pp[0]:.2f}+-{e[0]:.2f} off={pp[3]:.2f}+-{e[3]:.2f}')\r\nEOF\r\npython3 /app/final_check.py\r\n\u001b[?2004h> "]
