[145.622977, "i", "cat > /app/check.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d['intensity']\n\ndef lor(x,a,x0,g,o): return a*g*g/((x-x0)**2+g*g)+o\ndef lorlin(x,a,x0,g,b,c): return a*g*g/((x-x0)**2+g*g)+b+c*(x-1500)\n\nregions = {'D':(1150,1520,1355,18.5),'G':(1400,1780,1583,11.0),'2D':(2300,3000,2677,28.5)}\nfor name,(lo,hi,x0g,gg) in regions.items():\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p,_=curve_fit(lor,xs,ys,p0=[6000,x0g,gg,900],maxfev=200000)\n    pl,_=curve_fit(lorlin,xs,ys,p0=[6000,x0g,gg,900,0.0],maxfev=200000)\n    r1=lor(xs,*p)-ys; r2=lorlin(xs,*pl)-ys\n    print(f'{name}: const-off  x0={p[1]:.3f} g={p[2]:.3f} A={p[0]:.2f} off={p[3]:.2f} rms={np.sqrt((r1**2).mean()):.1f}')\n    print(f'{name}: lin-off    x0={pl[1]:.3f} g={pl[2]:.3f} A={pl[0]:.2f} b={pl[3]:.2f} c={pl[4]:.5f} rms={np.sqrt((r2**2).mean()):.1f}')\n\n# global: 3 sharp Lorentzians + constant + broad Lorentzian background\ndef mdl(x,a1,x1,g1,a2,"]
[145.623109, "i", "x2,g2,a3,x3,g3,bg,xb,gb):\n    return (a1*g1*g1/((x-x1)**2+g1*g1)+a2*g2*g2/((x-x2)**2+g2*g2)+a3*g3*g3/((x-x3)**2+g3*g3)\n            + bg*gb*gb/((x-xb)**2+gb*gb))\np0=[6000,1355,18.5,7500,1583,11,9970,2677,28.5,300,1900,600]\ntry:\n    p,cov=curve_fit(mdl,x,y,p0=p0,maxfev=600000)\n    r=mdl(x,*p)-y\n    print('global 3L+const+broad rms',np.sqrt((r**2).mean()))\n    print('  D amp=%.2f x0=%.3f g=%.3f'%(p[0],p[1],p[2]))\n    print('  G amp=%.2f x0=%.3f g=%.3f'%(p[3],p[4],p[5]))\n    print('  2D amp=%.2f x0=%.3f g=%.3f'%(p[6],p[7],p[8]))\n    print('  bg=%.2f xb=%.1f gb=%.1f'%(p[9],p[10],p[11]))\nexcept Exception as e:\n    print('broad bg fit failed', e)\nEOF\npython3 /app/check.py\n"]
