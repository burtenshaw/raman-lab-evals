[177.715799, "o", "\u001b[?2004h> "]
[177.715858, "o", "print('  D  x0=%.3f g=%.3f A=%.2f'%(p[1],p[2],p[0]))\r\n\u001b[?2004l\r"]
[177.715885, "o", "\u001b[?2004h> "]
