[177.71651, "o", "> "]
[177.716656, "o", "    print(f'{nm} win({lo},{hi}): x0={pp[1]:.3f}+-{e[1]:.3f} g={pp[2]:.3f}+-{e[2]:.3f} A={pp[0]:.2f}+-{e[0]:.2f} off={pp[3]:.2f}+-{e[3]:.2f}')\r\n\u001b[?2004l\r"]
[177.716699, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[177.717872, "o", "\u001b[?2004hroot@j-openenv-6afd8d8e29e8b7ccfbbb83b2-jsrk5as7-5142c-dvf74:/app# "]
