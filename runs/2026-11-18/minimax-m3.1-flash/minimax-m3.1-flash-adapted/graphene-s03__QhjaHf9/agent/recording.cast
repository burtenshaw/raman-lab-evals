[109.932196, "o", "  File \u001b[35m\"/app/resid.py\"\u001b[0m, line \u001b[35m19\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n    p2,cov2=\u001b[31mcurve_fit\u001b[0m\u001b[1;31m(model3lin,x,y,p0=p0+[0,0],maxfev=400000)\u001b[0m\r\n            \u001b[31m~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n  File \u001b[35m\"/usr/local/lib/python3.13/site-packages/scipy/optimize/_minpack_py.py\"\u001b[0m, line \u001b[35m1024\u001b[0m, in \u001b[35mcurve_fit\u001b[0m\r\n    res = leastsq(func, p0, Dfun=jac, full_output=True, **kwargs)\r\n"]
[109.932248, "o", "  File \u001b[35m\"/usr/local/lib/python3.13/site-packages/scipy/optimize/_minpack_py.py\"\u001b[0m, line \u001b[35m426\u001b[0m, in \u001b[35mleastsq\u001b[0m\r\n    shape, dtype = \u001b[31m_check_func\u001b[0m\u001b[1;31m('leastsq', 'func', func, x0, args, n)\u001b[0m\r\n                   \u001b[31m~~~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n  File \u001b[35m\"/usr/local/lib/python3.13/site-packages/scipy/optimize/_minpack_py.py\"\u001b[0m, line \u001b[35m24\u001b[0m, in \u001b[35m_check_func\u001b[0m\r\n    res = atleast_1d(\u001b[31mthefunc\u001b[0m\u001b[1;31m(*((x0[:numinputs],) + args))\u001b[0m)\r\n                     \u001b[31m~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n"]
