[109.3563, "i", "cat > /app/resid.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d['intensity']\ndef lor(x,a,x0,g,o): return a*g*g/((x-x0)**2+g*g)+o\ndef model3(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,o):\n    return (a1*g1*g1/((x-x1)**2+g1*g1)+a2*g2*g2/((x-x2)**2+g2*g2)+a3*g3*g3/((x-x3)**2+g3*g3)+o)\np0=[6000,1355,19,7500,1583,11,9970,2677,28,900]\np,cov=curve_fit(model3,x,y,p0=p0,maxfev=400000)\nres=model3(x,*p)-y\nprint('global params', np.round(p,3))\nprint('binned residual means (100 cm-1 bins):')\nfor lo in range(1100,3000,100):\n    m=(x>=lo)&(x<lo+100)\n    print(f'  {lo}-{lo+100}: mean resid {res[m].mean():8.2f}  rms {np.sqrt((res[m]**2).mean()):7.2f}  n={m.sum()}')\n# global fit with linear background\ndef model3lin(x,a1,x1,g1,a2,x2,g2,a3,x3,g3,b,c):\n    return (a1*g1*g1/((x-x1)**2+g1*g1)+a2*g2*g2/((x-x2)**2+g2*g2)+a3*g3*g3/((x-x3)**2+g3*g3)+b+c*x)\np2,cov2=curve_fit(model3lin,x,y,p0=p0+[0,0],maxfev=400000)\nres2=model3lin(x,*p"]
[109.356454, "i", "2)-y\nprint('global+linear rms', np.sqrt((res2**2).mean()))\nprint('  D : amp=%.3f x0=%.3f gamma=%.3f'%(p2[0],p2[1],p2[2]))\nprint('  G : amp=%.3f x0=%.3f gamma=%.3f'%(p2[3],p2[4],p2[5]))\nprint('  2D: amp=%.3f x0=%.3f gamma=%.3f'%(p2[6],p2[7],p2[8]))\nprint('  b=%.3f c=%.6f  -> baseline at 1355: %.1f, 1583: %.1f, 2677: %.1f'%(p2[9],p2[10],p2[9]+p2[10]*1355,p2[9]+p2[10]*1583,p2[9]+p2[10]*2677))\nEOF\npython3 /app/resid.py\n"]
