[48.012158, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d['intensity']\n# coarse profile: every 20 points -> 10 cm-1 bins, print max in bin\nfor i in range(0, len(x), 20):\n    sl = slice(i, i+20)\n    print(f\"{x[sl][0]:7.1f} {y[sl].max():9.1f} {y[sl].min():8.1f}\")\nEOF\npython3 /app/explore2.py | head -100\n"]
