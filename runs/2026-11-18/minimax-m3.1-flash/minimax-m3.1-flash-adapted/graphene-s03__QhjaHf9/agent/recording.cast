[66.764983, "i", "cat > /app/explore5.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d['intensity']\nfor lo,hi in [(1100,1250),(1700,2100),(2100,2500),(2800,3000),(2450,2550)]:\n    m=(x>=lo)&(x<=hi)\n    print(lo,hi,'mean',round(y[m].mean(),1),'median',round(np.median(y[m]),1),'std',round(y[m].std(),1),'min',round(y[m].min(),1))\nEOF\npython3 /app/explore5.py\n"]
