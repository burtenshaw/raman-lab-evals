[40.5271, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d['raman_shift_cm_1'] if 'raman_shift_cm_1' in d.dtype.names else d[d.dtype.names[0]]\ny = d['intensity']\nprint(d.dtype.names, len(x), x.min(), x.max(), x[1]-x[0])\nprint('y stats', y.min(), y.max(), np.median(y))\nfor name, lo, hi in [('D',1200,1500),('G',1450,1700),('2D',2500,2900)]:\n    m = (x>=lo)&(x<=hi)\n    xs, ys = x[m], y[m]\n    # local maxima\n    idx = np.where((ys[1:-1]>ys[:-2]) & (ys[1:-1]>ys[2:]))[0]+1\n    order = np.argsort(ys[idx])[::-1][:5]\n    print(name, 'window', lo, hi, 'min/max', ys.min(), ys.max())\n    for i in order:\n        print('   peak at', round(xs[idx[i]],2), 'I=', round(ys[idx[i]],1))\nEOF\npython3 /app/explore.py\n"]
