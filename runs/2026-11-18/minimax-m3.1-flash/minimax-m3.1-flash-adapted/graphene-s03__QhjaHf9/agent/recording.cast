[145.623322, "o", "+const+broad rms',np.sqrt((r**2).mean()))\r\n    print('  D amp=%.2f x0=%.3f g=%.3f'%(p[0],p[1],p[2]))\r\n    print('  G amp=%.2f x0=%.3f g=%.3f'%(p[3],p[4],p[5]))\r\n    print('  2D amp=%.2f x0=%.3f g=%.3f'%(p[6],p[7],p[8]))\r\n    print('  bg=%.2f xb=%.1f gb=%.1f'%(p[9],p[10],p[11]))\r\nexcept Exception as e:\r\n    print('broad bg fit f"]
