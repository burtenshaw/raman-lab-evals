[177.716068, "o", "\u001b[?2004h> "]
[177.716218, "o", "for nm,(lo,hi,g0,x0g,a0) in {'D':(1200,1500,18.5,1355,6000),'G':(1450,1700,11.0,1583,7500),'2D':(2400,2950,28.5,2677,9970)}.items():\r\n\u001b[?2004l\r"]
[177.716245, "o", "\u001b[?2004h> "]
[177.71628, "o", "    mm=(x>=lo)&(x<=hi)\r\n\u001b[?2004l\r"]
[177.716317, "o", "\u001b[?2004h> "]
