[63.762694, "i", "cat > /app/explore4.py << 'EOF'\nimport numpy as np\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]; y = d['intensity']\nfor i in range(0, len(x), 20):\n    xi = x[i]\n    if xi < 2100: continue\n    sl = slice(i, i+20)\n    print(f\"{xi:7.1f} {y[sl].max():9.1f} {y[sl].min():8.1f} {y[sl].mean():8.1f}\")\nEOF\npython3 /app/explore4.py\n"]
