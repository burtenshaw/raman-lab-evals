[201.934401, "i", "cat > /app/write_results.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\nx = d[d.dtype.names[0]]\ny = d['intensity']\n\ndef lorentzian(x, amplitude, x0, gamma, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(lo, hi, p0):\n    m = (x >= lo) & (x <= hi)\n    p, cov = curve_fit(lorentzian, x[m], y[m], p0=p0, maxfev=200000)\n    res = lorentzian(x[m], *p) - y[m]\n    print(f'fit window ({lo}, {hi}) n={m.sum()} rms={np.sqrt((res**2).mean()):.2f}')\n    print('   x0=%.4f gamma=%.4f amplitude=%.3f offset=%.3f' % tuple(p))\n    return p\n\npD = fit_peak(1200, 1500, [6000, 1355, 18.5, 900])\npG = fit_peak(1450, 1700, [7500, 1583, 11.0, 900])\np2D = fit_peak(2400, 2950, [9970, 2677, 28.5, 900])\n\nID_IG = pD[0] / pG[0]\n\nresults = {\n    \"D\":  {\"x0\": float(pD[1]),  \"gamma\": float(pD[2]),  \"amplitude\": float(pD[0]), \"offset\": float(pD[3])},\n    \"G\":  {\"x0\": float(pG[1]),  \"gamma\": float(pG[2]),  \""]
[201.934536, "i", "amplitude\": float(pG[0]), \"offset\": float(pG[3])},\n    \"2D\": {\"x0\": float(p2D[1]), \"gamma\": float(p2D[2]), \"amplitude\": float(p2D[0]), \"offset\": float(p2D[3])},\n    \"ID_IG\": float(ID_IG),\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/write_results.py\n"]
[201.934601, "o", "cat > /app/write_results.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[201.934656, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[201.934695, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[201.934733, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[201.934761, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[201.934792, "o", "\u001b[?2004h> "]
[201.934868, "o", "d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[201.934908, "o", "x = d[d.dtype.names[0]]\r\n\u001b[?2004l\r"]
[201.934935, "o", "\u001b[?2004h> "]
[201.934958, "o", "y = d['intensity']\r\n\u001b[?2004l\r"]
[201.934988, "o", "\u001b[?2004h> \r\n"]
[201.935018, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[201.935082, "o", "def lorentzian(x, amplitude, x0, gamma, offset):\r\n\u001b[?2004l\r"]
[201.93511, "o", "\u001b[?2004h> "]
[201.935189, "o", "    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\r\n\u001b[?2004l\r"]
[201.935219, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[201.935257, "o", "> "]
[201.935281, "o", "def fit_peak(lo, hi, p0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[201.935311, "o", "    m = (x >= lo) & (x <= hi)\r\n\u001b[?2004l\r"]
[201.935341, "o", "\u001b[?2004h> "]
[201.935416, "o", "    p, cov = curve_fit(lorentzian, x[m], y[m], p0=p0, maxfev=200000)\r\n\u001b[?2004l\r"]
[201.935446, "o", "\u001b[?2004h> "]
[201.935492, "o", "    res = lorentzian(x[m], *p) - y[m]\r\n\u001b[?2004l\r"]
[201.935506, "o", "\u001b[?2004h> "]
[201.935611, "o", "    print(f'fit window ({lo}, {hi}) n={m.sum()} rms={np.sqrt((res**2).mean()):.2f}')\r\n\u001b[?2004l\r"]
[201.935628, "o", "\u001b[?2004h> "]
[201.935713, "o", "    print('   x0=%.4f gamma=%.4f amplitude=%.3f offset=%.3f' % tuple(p))\r\n\u001b[?2004l\r"]
[201.935727, "o", "\u001b[?2004h> "]
[201.935797, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[201.935831, "o", "\u001b[?2004h> "]
[201.935867, "o", "pD = fit_peak(1200, 1500, [6000, 1355, 18.5, 900])\r\n\u001b[?2004l\r"]
[201.935901, "o", "\u001b[?2004h> "]
[201.935955, "o", "pG = fit_peak(1450, 1700, [7500, 1583, 11.0, 900])\r\n\u001b[?2004l\r\u001b[?2004h"]
[201.935978, "o", "> "]
[201.936043, "o", "p2D = fit_peak(2400, 2950, [9970, 2677, 28.5, 900])\r\n\u001b[?2004l\r"]
[201.936082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[201.936114, "o", "\u001b[?2004h> "]
[201.936159, "o", "ID_IG = pD[0] / pG[0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[201.936193, "o", "\u001b[?2004h> results = {\r\n\u001b[?2004l\r"]
[201.936226, "o", "\u001b[?2004h> "]
[201.936336, "o", "    \"D\":  {\"x0\": float(pD[1]),  \"gamma\": float(pD[2]),  \"amplitude\": float(pD[0]), \"offset\": float(pD[3])},\r\n\u001b[?2004l\r"]
[201.936367, "o", "\u001b[?2004h> "]
[201.936486, "o", "    \"G\":  {\"x0\": float(pG[1]),  \"gamma\": float(pG[2]),  \"amplitude\": float(pG[0]), \"offset\": float(pG[3])},\r\n\u001b[?2004l\r"]
[201.93651, "o", "\u001b[?2004h> "]
[201.936635, "o", "    \"2D\": {\"x0\": float(p2D[1]), \"gamma\": float(p2D[2]), \"amplitude\": float(p2D[0]), \"offset\": float(p2D[3])},\r\n\u001b[?2004l\r"]
[201.936661, "o", "\u001b[?2004h> "]
[201.936701, "o", "    \"ID_IG\": float(ID_IG),\r\n\u001b[?2004l\r\u001b[?2004h"]
[201.93674, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[201.936798, "o", "with open('/app/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[201.936822, "o", "\u001b[?2004h> "]
[201.936867, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[201.936891, "o", "\u001b[?2004h> "]
[201.936922, "o", "    f.write('\\n')\r\n\u001b[?2004l\r"]
[201.936955, "o", "\u001b[?2004h> "]
[201.936994, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r"]
[201.937016, "o", "\u001b[?2004h> "]
[201.937046, "o", "EOF\r\n\u001b[?2004l\r"]
