[?2004l[?2004h> x = d[d.dtype.names[0]]; y = d['intensity']
[?2004l[?2004h> def lor(x,a,x0,g,o): return a*g*g/((x-x0)**2+g*g)+o
[?2004l[?2004h> def two(x,a1,x1,g1,a2,x2,g2,o):
[?2004l[?2004h>     return a1*g1*g1/((x-x1)**2+g1*g1)+a2*g2*g2/((x-x2)**2+g2*g2)+o
[?2004l[?2004h> m=(x>=1200)&(x<=1700); xs,ys=x[m],y[m]
