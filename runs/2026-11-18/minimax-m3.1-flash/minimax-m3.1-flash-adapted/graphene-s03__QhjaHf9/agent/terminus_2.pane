[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d[d.dtype.names[0]]
[?2004l[?2004h> y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lorentzian(x, amplitude, x0, gamma, offset):
[?2004l[?2004h>     return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset
[?2004l[?2004h> 
[?2004l[?2004h> def fit_peak(lo, hi, p0):
[?2004l[?2004h>     m = (x >= lo) & (x <= hi)
[?2004l[?2004h>     p, cov = curve_fit(lorentzian, x[m], y[m], p0=p0, maxfev=200000)
[?2004l[?2004h>     res = lorentzian(x[m], *p) - y[m]
[?2004l[?2004h>     print(f'fit window ({lo}, {hi}) n={m.sum()} rms={np.sqrt((res**2).mean()):.2f}')
[?2004l[?2004h>     print('   x0=%.4f gamma=%.4f amplitude=%.3f offset=%.3f' % tuple(p))
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> pD = fit_peak(1200, 1500, [6000, 1355, 18.5, 900])
[?2004l[?2004h> pG = fit_peak(1450, 1700, [7500, 1583, 11.0, 900])
[?2004l[?2004h> p2D = fit_peak(2400, 2950, [9970, 2677, 28.5, 900])
[?2004l[?2004h> 
[?2004l[?2004h> ID_IG = pD[0] / pG[0]
[?2004l[?2004h> 
[?2004l[?2004h> results = {
[?2004l[?2004h>     "D":  {"x0": float(pD[1]),  "gamma": float(pD[2]),  "amplitude": float(pD[0]), "offset": float(pD[3])},
[?2004l[?2004h>     "G":  {"x0": float(pG[1]),  "gamma": float(pG[2]),  "amplitude": float(pG[0]), "offset": float(pG[3])},
[?2004l[?2004h>     "2D": {"x0": float(p2D[1]), "gamma": float(p2D[2]), "amplitude": float(p2D[0]), "offset": float(p2D[3])},
[?2004l[?2004h>     "ID_IG": float(ID_IG),
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/results.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h>     f.write('\n')
[?2004l[?2004h> print(json.dumps(results, indent=2))
