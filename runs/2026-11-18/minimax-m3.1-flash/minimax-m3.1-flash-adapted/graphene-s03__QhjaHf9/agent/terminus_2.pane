[?2004hroot@j-openenv-6afd8d8e29e8b7ccfbbb83b2-jsrk5as7-5142c-dvf74:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import numpy as np, itertools
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> d = np.genfromtxt('/app/spectrum.csv', delimiter=',', names=True)
[?2004l[?2004h> x = d[d.dtype.names[0]]; y = d['intensity']
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x, amp, x0, gam, off):
[?2004l[?2004h>     return amp*gam*gam/((x-x0)**2+gam*gam) + off
[?2004l[?2004h> 
[?2004l[?2004h> def fitwin(lo, hi, p0=None):
[?2004l[?2004h>     m = (x>=lo)&(x<=hi)
[?2004l[?2004h>     xs, ys = x[m], y[m]
[?2004l[?2004h>     if p0 is None:
[?2004l[?2004h>         off0 = np.percentile(ys, 10)
[?2004l[?2004h>         i = np.argmax(ys)
[?2004l[?2004h>         amp0 = ys[i]-off0
[?2004l[?2004h>         p0 = [amp0, xs[i], 20.0, off0]
[?2004l[?2004h>     p, cov = curve_fit(lor, xs, ys, p0=p0, maxfev=200000)
[?2004l[?2004h>     res = lor(xs, *p)-ys
[?2004l[?2004h>     return p, np.sqrt(np.mean(res**2)), len(xs)
[?2004l[?2004h> 
[?2004l[?2004h> cands = {
[?2004l[?2004h>  'D':  [(1200,1500),(1250,1450),(1280,1420),(1300,1420),(1200,1450),(1250,1480)],
[?2004l[?2004h>  'G':  [(1450,1700),(1500,1660),(1520,1650),(1480,1680),(1520,1700),(1450,1750)],
[?2004l[?2004h>  '2D': [(2400,2950),(2450,2900),(2500,2850),(2550,2800),(2400,2850),(2500,2950)],
[?2004l[?2004h> }
[?2004l[?2004h> for name, wins in cands.items():
[?2004l[?2004h>     print('===', name)
[?2004l[?2004h>     for lo,hi in wins:
[?2004l[?2004h>         p, rms, n = fitwin(lo,hi)
[?2004l[?2004h>         print(f"  win=({lo},{hi}) n={n} x0={p[1]:.3f} gamma={p[2]:.3f} amp={p[0]:.2f} off={p[3]:.2f} rms={rms:.1f}")
[?2004l[?2004h> 
[?2004l[?2004h> # global fit: 3 Lorentzians + shared constant offset
[?2004l[?2004h> def model3(x, a1,x1,g1, a2,x2,g2, a3,x3,g3, off):
[?2004l[?2004h>     return (a1*g1*g1/((x-x1)**2+g1*g1) + a2*g2*g2/((x-x2)**2+g2*g2)
[?2004l[?2004h>             + a3*g3*g3/((x-x3)**2+g3*g3) + off)
[?2004l[?2004h> p0 = [6000,1353,20, 7500,1582,20, 9800,2672,40, 900]
[?2004l[?2004h> lo_b = [0,1300,5, 0,1530,5, 0,2600,5, 0]
[?2004l[?2004h> hi_b = [20000,1400,100, 20000,1650,100, 20000,2750,200, 3000]
[?2004l[?2004h> p, cov = curve_fit(model3, x, y, p0=p0, bounds=(lo_b,hi_b), maxfev=400000)
[?2004l[?2004h> res = model3(x,*p)-y
[?2004l[?2004h> print('=== GLOBAL 3L+offset: rms', np.sqrt(np.mean(res**2)))
[?2004l[?2004h> print('  D : amp=%.3f x0=%.3f gamma=%.3f'%(p[0],p[1],p[2]))
[?2004l[?2004h> print('  G : amp=%.3f x0=%.3f gamma=%.3f'%(p[3],p[4],p[5]))
[?2004l[?2004h> print('  2D: amp=%.3f x0=%.3f gamma=%.3f'%(p[6],p[7],p[8]))
[?2004l[?2004h> print('  offset=%.3f'%p[9])
[?2004l[?2004h> print('  ID/IG(global)=%.5f'%(p[0]/p[3]))
[?2004l[?2004h> EOF
