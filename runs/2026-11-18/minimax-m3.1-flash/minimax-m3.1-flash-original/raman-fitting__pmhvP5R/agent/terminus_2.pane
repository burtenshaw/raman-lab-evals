[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> d = np.load('/app/data.npy')
[?2004l[?2004h> x, y = d[:,0], d[:,1]
[?2004l[?2004h> n=len(x); i=np.arange(n)
[?2004l[?2004h> print('1/x linear fit:')
[?2004l[?2004h> A=np.vstack([i,np.ones(n)]).T
[?2004l[?2004h> c,*_=np.linalg.lstsq(A,1.0/x,rcond=None)
[?2004l[?2004h> p=A@c
[?2004l[?2004h> print('  coef',c,'max rel resid %.3e'%np.max(np.abs(p-1/x)/(1/x)))
[?2004l[?2004h> print('1e7/x linear fit:')
[?2004l[?2004h> c2,*_=np.linalg.lstsq(A,1e7/x,rcond=None)
[?2004l[?2004h> p2=A@c2
[?2004l[?2004h> print('  coef',c2,'max rel resid %.3e'%np.max(np.abs(p2-1e7/x)/(1e7/x)))
[?2004l[?2004h> peaks=[3745.053,6329.372,10289.940,16245.584,19139.544,33244.969]
[?2004l[?2004h> print('\ncandidate Raman shifts (cm^-1) under hypotheses:')
[?2004l[?2004h> print('%-12s %10s %10s %10s %10s'%('peakx','x-?','x-10000','1e7/x','1e7/x-10000'))
[?2004l[?2004h> for xp in peaks:
[?2004l[?2004h>     print('%-12.3f %10.3f %10.3f %10.3f %10.3f'%(xp, xp-0, xp-10000, 1e7/xp, 1e7/xp-10000))
[?2004l[?2004h> EOF
