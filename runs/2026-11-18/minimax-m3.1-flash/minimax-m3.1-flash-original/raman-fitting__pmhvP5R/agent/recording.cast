[288.182955, "i", "cat > /app/explore3.py << 'EOF'\nimport numpy as np\nd = np.load('/app/data.npy')\nx, y = d[:,0], d[:,1]\nn = len(x)\ni = np.arange(n)\nu = 1e7/x\n# du/di at intervals\nfor k in range(0, n, max(1,n//25)):\n    j = min(k+1, n-1)\n    print('i=%5d x=%10.3f y=%10.3f du/di=%8.4f dx/di=%8.4f' % (k, x[k], y[k], (u[j]-u[k])/(j-k), (x[j]-x[k])/(j-k)))\n# power law fit log x = a + b log i\nA = np.vstack([np.log(i+1), np.ones(n)]).T\ncoef, *_ = np.linalg.lstsq(A, np.log(x), rcond=None)\npred = A@coef\nprint('powerlaw log x = %.4f log(i+1) + %.4f ; max rel resid %.4f' % (coef[0], coef[1], np.abs(np.exp(pred)-x).max()/x.max()))\nEOF\npython3 /app/explore3.py\n"]
