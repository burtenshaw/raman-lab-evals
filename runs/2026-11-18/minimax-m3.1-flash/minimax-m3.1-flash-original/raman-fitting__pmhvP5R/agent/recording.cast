[651.054775, "i", "cat > /app/explore5.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nd = np.load('/app/data.npy')\nx, y = d[:,0], d[:,1]\nn=len(x); i=np.arange(n)\nprint('1/x linear fit:')\nA=np.vstack([i,np.ones(n)]).T\nc,*_=np.linalg.lstsq(A,1.0/x,rcond=None)\np=A@c\nprint('  coef',c,'max rel resid %.3e'%np.max(np.abs(p-1/x)/(1/x)))\nprint('1e7/x linear fit:')\nc2,*_=np.linalg.lstsq(A,1e7/x,rcond=None)\np2=A@c2\nprint('  coef',c2,'max rel resid %.3e'%np.max(np.abs(p2-1e7/x)/(1e7/x)))\npeaks=[3745.053,6329.372,10289.940,16245.584,19139.544,33244.969]\nprint('\\ncandidate Raman shifts (cm^-1) under hypotheses:')\nprint('%-12s %10s %10s %10s %10s'%('peakx','x-?','x-10000','1e7/x','1e7/x-10000'))\nfor xp in peaks:\n    print('%-12.3f %10.3f %10.3f %10.3f %10.3f'%(xp, xp-0, xp-10000, 1e7/xp, 1e7/xp-10000))\nEOF\npython3 /app/explore5.py\n"]
