[207.946129, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nd = np.load('/app/data.npy')\nx, y = d[:,0], d[:,1]\nlam = 1e7/x\nprint('lambda range', lam.min(), lam.max())\n# linearity check of lambda vs index\ni = np.arange(len(lam))\nA = np.vstack([i, np.ones_like(i)]).T\ncoef, res, *_ = np.linalg.lstsq(A, lam, rcond=None)\npred = A@coef\nprint('lambda linear fit slope/intercept', coef)\nprint('max abs resid', np.abs(pred-lam).max(), 'rel', np.abs(pred-lam).max()/lam.max())\n# dx stats\ndx = np.diff(x)\nfor lo, hi in [(1600,3000),(3000,6000),(6000,12000),(12000,25000),(25000,48000)]:\n    m = (x[:-1]>=lo)&(x[:-1]<hi)\n    if m.sum():\n        print(lo,hi,'n=%d dx med=%.4f min=%.4f max=%.4f'%(m.sum(), np.median(dx[m]), dx[m].min(), dx[m].max()))\nEOF\npython3 /app/explore2.py\n"]
