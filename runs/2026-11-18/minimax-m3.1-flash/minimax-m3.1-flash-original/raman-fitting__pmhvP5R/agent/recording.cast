[636.761383, "i", "cat > /app/explore4.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nd = np.load('/app/data.npy')\nx, y = d[:,0], d[:,1]\nn = len(x)\ni = np.arange(n)\npk, props = find_peaks(y, prominence=(y.max()-y.min())*0.02)\nprint('peak idx / x / y:')\nfor p, pr in zip(pk, props['prominences']):\n    print('  idx=%4d x=%12.3f y=%10.3f prom=%10.3f' % (p, x[p], y[p], pr))\nprint()\nprint('binned profile (index bin: xmin..xmax  ymin..ymax  ymean):')\nb = 30\nfor k in range(0, n, b):\n    seg = y[k:k+b]\n    print('  %4d-%4d  x %10.1f..%10.1f  y %8.1f..%9.1f  mean %9.1f' % (k, min(k+b,n), x[k], x[min(k+b,n)-1], seg.min(), seg.max(), seg.mean()))\nEOF\npython3 /app/explore4.py\n"]
[636.761564, "o", "cat > /app/explore4.py << 'EOF'\r\n\u001b[?2004l\r"]
