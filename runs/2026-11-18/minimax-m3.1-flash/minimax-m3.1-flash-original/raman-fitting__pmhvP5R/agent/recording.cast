[106.469927, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nraw = open('/app/graphene.dat').read().replace(',', '.')\narr = np.array([[float(v) for v in line.split()] for line in raw.strip().splitlines()])\nd = arr\nx = d[:,0]; y = d[:,1]\nprint('shape', d.shape)\nidx = np.argsort(x)\nx = x[idx]; y = y[idx]\nprint('sorted x range', x[0], x[-1], 'n', len(x))\ndx = np.diff(x)\nprint('dx min/med/max', dx.min(), np.median(dx), dx.max())\nprint('y min/max', y.min(), y.max())\npk, props = find_peaks(y, prominence=(y.max()-y.min())*0.02)\nprint('num peaks', len(pk))\nfor p, pr in zip(pk, props['prominences']):\n    print('x=%.3f y=%.3f prom=%.3f' % (x[p], y[p], pr))\nnp.save('/app/data.npy', np.column_stack([x,y]))\nEOF\npython3 /app/explore.py\n"]
