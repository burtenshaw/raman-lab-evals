[709.848964, "o", "\u001b[?2004h> "]
[709.849005, "o", "    if C<=x.max()+1: continue\r\n\u001b[?2004l\r"]
[709.849049, "o", "\u001b[?2004h> "]
[709.849087, "o", "    r2c,_=r2lin(1.0/(C-x))"]
[709.849132, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.849175, "o", "> "]
[709.849211, "o", "    if best is None or r2c>best[1]: best=(C,r2c)\r\n\u001b[?2004l\r"]
[709.849251, "o", "\u001b[?2004h> "]
[709.849295, "o", "print('  best C=',best)\r\n\u001b[?2004l\r"]
[709.849339, "o", "\u001b[?2004h> "]
[709.849403, "o", "for C in [x.max()+100, 20000, 30000, 50000, 100000, 18797, 1e6]:\r\n\u001b[?2004l\r"]
[709.849446, "o", "\u001b[?2004h> "]
[709.849489, "o", "    if C<=x.max(): continue"]
[709.849531, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.849573, "o", "    r2c,_=r2lin(1.0/(C-x))\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.849616, "o", "> "]
[709.849664, "o", "    print(f'   C={C:12.1f} R2={r2c:.8f}')\r\n\u001b[?2004l\r"]
[709.849704, "o", "\u001b[?2004h> "]
[709.849747, "o", "print()\r\n\u001b[?2004l\r"]
[709.849788, "o", "\u001b[?2004h> "]
[709.849827, "o", "# fit x = A/(i+d)+B\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.849877, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[709.84992, "o", "\u001b[?2004h> "]
[709.84997, "o", "def m(i,A,B,d): return A/(i+d)+B\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.850006, "o", "> "]
[709.850069, "o", "popt,pcov=curve_fit(m,i,x,p0=[1e6,0,1],maxfev=200000)\r\n\u001b[?2004l\r"]
[709.850105, "o", "\u001b[?2004h> "]
[709.850139, "o", "pred=m(i,*popt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.850171, "o", "> "]
[709.850238, "o", "ss=np.sum((x-pred)**2); st=np.sum((x-x.mean())**2)\r\n\u001b[?2004l\r"]
[709.850255, "o", "\u001b[?2004h> "]
[709.850377, "o", "print('x=A/(i+d)+B:',popt,'R2=%.10f'%(1-ss/st), 'max abs resid=%.4f'%np.max(np.abs(x-pred)))\r\n\u001b[?2004l\r"]
[709.850413, "o", "\u001b[?2004h> "]
[709.850452, "o", "EOF\r\n\u001b[?2004l\r"]
[709.851542, "o", "\u001b[?2004hroot@j-openenv-6afd86e84643bac7ac634d4d-d9akcrr4-77ff9-xg7kt:/app# "]
[709.851593, "o", "python3 /app/explore6.py\r\n\u001b[?2004l\r"]
