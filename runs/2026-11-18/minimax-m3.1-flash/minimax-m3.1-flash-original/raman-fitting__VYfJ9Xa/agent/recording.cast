[584.704994, "i", "cat > /app/explore5.py << 'EOF'\nimport numpy as np\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(rows); x=d[:,0]; y=d[:,1]; i=np.arange(len(x),dtype=float)\n\ndef lin(t):\n    A=np.vstack([i,np.ones_like(i)]).T\n    coef,*_=np.linalg.lstsq(A,t,rcond=None)\n    pred=A@coef\n    ss=np.sum((t-pred)**2); st=np.sum((t-t.mean())**2)\n    return 1-ss/st, coef\n\nfor name,t in [('x',x),('1/x',1/x),('1/sqrt x',1/np.sqrt(x)),('log x',np.log(x)),('x^2',x**2),('sqrt x',np.sqrt(x)),('x**0.25',x**0.25),('x**0.3',x**0.3)]:\n    r2,coef=lin(t)\n    print(f'{name:10s} R2 = {r2:.10f}  slope={coef[0]:.6g} inter={coef[1]:.6g}')\nEOF\npython3 /app/explore5.py\n"]
