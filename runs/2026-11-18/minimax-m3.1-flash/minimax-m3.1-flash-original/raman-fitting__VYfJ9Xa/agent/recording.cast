[101.1641, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(rows)\nx=d[:,0]; y=d[:,1]\nprint('top 20 y:')\nidx=np.argsort(y)[-20:][::-1]\nfor i in sorted(idx):\n    print(f'  i={i} x={x[i]:.4f} y={y[i]:.3f}')\nprint('local maxima (y>500):')\nfor i in range(1,len(y)-1):\n    if y[i]>=y[i-1] and y[i]>=y[i+1] and y[i]>500:\n        print(f'  i={i} x={x[i]:.4f} y={y[i]:.3f}')\nEOF\npython3 /app/explore2.py\n"]
