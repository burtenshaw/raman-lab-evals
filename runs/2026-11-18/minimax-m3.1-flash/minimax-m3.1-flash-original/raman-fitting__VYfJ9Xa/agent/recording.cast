[429.334415, "i", "cat > /app/explore4.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(rows); x=d[:,0]; y=d[:,1]; i=np.arange(len(x))\nprint('dx samples:')\nfor k in [0,10,50,100,200,400,800,1200,1600,2000,2400,2800,3200,3500,3563]:\n    print(f'  i={k:5d} x={x[k]:12.4f} dx={x[k]-x[k+1]:12.5f}')\n\ndef linfit(t):\n    A=np.vstack([t,np.ones_like(t)]).T\n    coef,res,rank,sv=np.linalg.lstsq(A,t*0+i,rcond=None)\n    pred=A@coef\n    ss=np.sum((t-pred)**2); st=np.sum((t-t.mean())**2)\n    return 1-ss/st, coef\ntransforms={'x':lambda z:z,'1/x':lambda z:1/z,'log x':lambda z:np.log(z),'sqrt x':lambda z:np.sqrt(z),\n '1/sqrt x':lambda z:1/np.sqrt(z),'x^2':lambda z:z**2,'1/x^2':lambda z:1/z**2,'log10 x':lambda z:np.log10(z),\n 'x^0.5 + const?':lambda z: z**0.5}\nfor name,f in transforms.items():\n    t=f(x)\n    r2,coef=linfit(t)\n    print(f'{name:12s} R"]
[429.334558, "i", "2(linear in i) = {r2:.8f}  slope={coef[0]:.6g} intercept={coef[1]:.6g}')\nEOF\npython3 /app/explore4.py\n"]
