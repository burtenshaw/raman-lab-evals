[84.747535, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    a=float(p[0].replace(',','.'))\n    b=float(p[1].replace(',','.'))\n    rows.append((a,b))\nd=np.array(rows)\nprint(d.shape)\nprint('x range', d[:,0].min(), d[:,0].max())\nprint('y range', d[:,1].min(), d[:,1].max())\nx=d[:,0]; y=d[:,1]\nprint('monotonic decreasing:', np.all(np.diff(x)<0))\ndx=-np.diff(x)\nprint('dx first 10', dx[:10])\nprint('dx last 10', dx[-10:])\nprint('argmax y', x[np.argmax(y)], y.max())\n# print every 100th point\nfor i in range(0,len(x),100):\n    print(i, x[i], y[i])\nEOF\npython3 /app/explore.py\n"]
