[710.646447, "o", "\u001b[?2004hroot@j-openenv-6afd86e84643bac7ac634d4d-d9akcrr4-77ff9-xg7kt:/app# "]
[843.047426, "i", "cat > /app/explore7.py << 'EOF'\nimport numpy as np\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(rows); x=d[:,0]; y=d[:,1]; i=np.arange(len(x),dtype=float)\nA,B,dd = 3.58413592e+06, 653.428455, 76.9826220\npred=A/(i+dd)+B\nprint('residual x - model (sampled):')\nfor k in range(0,3565,200):\n    print(f'  i={k:5d} x={x[k]:12.4f} res={x[k]-pred[k]:12.5f}  rel={(x[k]-pred[k])/x[k]:.3e}')\np = A/(x-B)-dd\nprint('recovered p: first/last few, and fraction within 0.05 of integer:')\nprint('  p[:5]',p[:5],' p[-5:]',p[-5:])\nfrac=np.abs(p-np.round(p))<0.05\nprint('  frac near integer:',frac.mean())\nprint('  max |p-round(p)|=',np.abs(p-np.round(p)).max())\nEOF\npython3 /app/explore7.py\n"]
[843.048196, "o", "cat > /app/explore7.py << 'EOF'\r\n\u001b[?2004l\r"]
[843.050355, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in open('/app/graphene.dat'):\r\n\u001b[?2004l\r\u001b[?2004h>     p=line.split()\r\n\u001b[?2004l\r\u001b[?2004h>     if len(p)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>     rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\r\n\u001b[?2004l\r\u001b[?2004h> d=np.array(rows); x=d[:,0]; y=d[:,1]; i=np.arange(len(x),dtype=float)\r\n\u001b[?2004l\r\u001b[?2004h> A,B,dd = 3.58413592e+06, 653.428455, 76.9826220\r\n\u001b[?2004l\r\u001b[?2004h> pred=A/(i+dd)+B\r\n\u001b[?2004l\r\u001b[?2004h> print('residual x - model (sampled):')\r\n\u001b[?2004l\r\u001b[?2004h> for k in range(0,3565,200):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'  i={k:5d} x={x[k]:12.4f} res={x[k]-pred[k]:12.5f}  rel={(x[k]-pred[k])/x[k]:.3e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[843.050472, "o", "> p = A/(x-B)-dd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[843.0506, "o", "print('recovered p: first/last few, and fraction within 0.05 of integer:')\r\n\u001b[?2004l\r\u001b[?2004h"]
[843.050658, "o", "> "]
[843.050713, "o", "print('  p[:5]',p[:5],' p[-5:]',p[-5:])\r\n\u001b[?2004l\r\u001b[?2004h"]
[843.050778, "o", "> "]
[843.050846, "o", "frac=np.abs(p-np.round(p))<0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[843.05091, "o", "print('  frac near integer:',frac.mean())\r\n\u001b[?2004l\r\u001b[?2004h"]
[843.050961, "o", "> "]
[843.051036, "o", "print('  max |p-round(p)|=',np.abs(p-np.round(p)).max())\r\n\u001b[?2004l\r"]
[843.05109, "o", "\u001b[?2004h> "]
[843.051138, "o", "EOF\r\n\u001b[?2004l\r"]
