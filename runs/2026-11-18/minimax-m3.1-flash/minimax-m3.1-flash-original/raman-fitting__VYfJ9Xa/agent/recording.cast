[211.901537, "i", "cat > /app/explore3.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks, savgol_filter\nrows=[]\ncols=set()\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    cols.add(len(p))\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nprint('columns per line:', cols)\nd=np.array(rows)\nx=d[:,0]; y=d[:,1]\nsm=savgol_filter(y, 21, 2)\nprint('--- smoothed peaks (prominence) ---')\npeaks,props=find_peaks(sm, prominence=100)\nfor p,pr in zip(peaks, props['prominences']):\n    print(f'  i={p:5d} x={x[p]:12.4f} sm={sm[p]:10.2f} prom={pr:10.2f}')\nprint('--- ASCII plot of smoothed vs index (cols=110) ---')\nH=25\nlo,hi=sm.min(),sm.max()\nfor r in range(H,0,-1):\n    line=''\n    for c in range(110):\n        i0=len(sm)*c//110; i1=len(sm)*(c+1)//110\n        seg=sm[i0:i1]\n        v=seg.max() if len(seg) else 0\n        yl=H*(v-lo)/(hi-lo)\n        line += '*' if yl>=r-0.5 else ' '\n    print(f'{r:2d} |{line}|')\nprint('   '+''.join([str((c*len(sm)//110)//100%10) for c "]
[211.901664, "i", "in range(110)]))\nEOF\npython3 /app/explore3.py\n"]
