[709.846874, "i", "cat > /app/explore6.py << 'EOF'\nimport numpy as np\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(rows); x=d[:,0]; y=d[:,1]; i=np.arange(len(x),dtype=float)\n\ndef r2lin(t):\n    A=np.vstack([i,np.ones_like(i)]).T\n    coef,*_=np.linalg.lstsq(A,t,rcond=None)\n    pred=A@coef\n    ss=np.sum((t-pred)**2); st=np.sum((t-t.mean())**2)\n    return 1-ss/st, coef\n\nr2,coef=r2lin(1/x)\nprint('1/x vs i: R2=%.8f'%r2)\nres=(1/x)-(coef[0]*i+coef[1])\nprint('resid samples (1/x):')\nfor k in range(0,3565,300):\n    print(f'   i={k:5d} res={res[k]: .4e}  rel={res[k]/(1/x[k]): .4e}')\nprint()\nprint('scan C for 1/(C-x) linear in i:')\nbest=None\nfor C in np.arange(2000,200000,500):\n    if C<=x.max()+1: continue\n    r2c,_=r2lin(1.0/(C-x))\n    if best is None or r2c>best[1]: best=(C,r2c)\nprint('  best C=',best)\nfor C in [x.max()+100, 20000, 30000, 50000, 100000, 18797, 1e6]:\n    if C<=x.max(): continue\n    r2c,_="]
[709.847, "i", "r2lin(1.0/(C-x))\n    print(f'   C={C:12.1f} R2={r2c:.8f}')\nprint()\n# fit x = A/(i+d)+B\nfrom scipy.optimize import curve_fit\ndef m(i,A,B,d): return A/(i+d)+B\npopt,pcov=curve_fit(m,i,x,p0=[1e6,0,1],maxfev=200000)\npred=m(i,*popt)\nss=np.sum((x-pred)**2); st=np.sum((x-x.mean())**2)\nprint('x=A/(i+d)+B:',popt,'R2=%.10f'%(1-ss/st), 'max abs resid=%.4f'%np.max(np.abs(x-pred)))\nEOF\npython3 /app/explore6.py\n"]
