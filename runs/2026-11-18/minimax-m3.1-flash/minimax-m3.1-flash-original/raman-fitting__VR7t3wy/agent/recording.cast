[672.943569, "i", "cat > /tmp/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef load():\n    rows=[]\n    for line in open('/app/graphene.dat'):\n        p=line.split()\n        if len(p)<2: continue\n        rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\n    d=np.array(rows)\n    nu=1e7/d[:,0]; y=d[:,1]\n    i=np.argsort(nu)\n    return nu[i], y[i]\n\ndef lor(x,x0,g,a,off):\n    return off + a*g**2/((x-x0)**2+g**2)\n\ndef lor_lin(x,x0,g,a,off,slope):\n    return off + slope*(x-x0) + a*g**2/((x-x0)**2+g**2)\n\nnu,y=load()\nwindows={'G':[(1400,1750),(1450,1700),(1500,1660),(1470,1700),(1520,1650)],\n         '2D':[(2400,2950),(2450,2900),(2500,2850),(2550,2800),(2580,2760)]}\ninits={'G':1580.,'2D':2670.}\nfor name,ws in windows.items():\n    print('===',name)\n    for (lo,hi) in ws:\n        m=(nu>=lo)&(nu<=hi)\n        x=nu[m]; yy=y[m]\n        off0=np.percentile(yy,20); amp0=yy.max()-off0\n        try:\n            p,c=curve_fit(lor,x,yy,p0=[inits[name],20.,amp0,off0],maxfev=50000)\n            resid="]
[672.943686, "i", "yy-lor(x,*p)\n            rms=np.sqrt(np.mean(resid**2))\n            print('  const  [%d,%d] n=%3d x0=%9.4f gamma=%8.4f amp=%10.2f off=%10.2f rms=%8.2f' % (lo,hi,m.sum(),p[0],p[1],p[2],p[3],rms))\n        except Exception as e:\n            print('  const fail',e)\n        try:\n            p2,_=curve_fit(lor_lin,x,yy,p0=[inits[name],20.,amp0,off0,0.],maxfev=50000)\n            rms2=np.sqrt(np.mean((yy-lor_lin(x,*p2))**2))\n            print('  linear [%d,%d] n=%3d x0=%9.4f gamma=%8.4f amp=%10.2f off=%10.2f slope=%8.3f rms=%8.2f' % (lo,hi,m.sum(),p2[0],p2[1],p2[2],p2[3],p2[4],rms2))\n        except Exception as e:\n            print('  lin fail',e)\nEOF\npython3 /tmp/fit.py\n"]
[672.943746, "o", "cat > /tmp/fit.py << 'EOF'\r\n\u001b[?2004l\r"]
[672.943808, "o", "\u001b[?2004h> "]
[672.946922, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def load():\r\n\u001b[?2004l\r\u001b[?2004h>     rows=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for line in open('/app/graphene.dat'):\r\n\u001b[?2004l\r\u001b[?2004h>         p=line.split()\r\n\u001b[?2004l\r\u001b[?2004h>         if len(p)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\r\n\u001b[?2004l\r\u001b[?2004h>     d=np.array(rows)\r\n\u001b[?2004l\r\u001b[?2004h>     nu=1e7/d[:,0]; y=d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h>     i=np.argsort(nu)\r\n\u001b[?2004l\r\u001b[?2004h>     return nu[i], y[i]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lor(x,x0,g,a,off):\r\n\u001b[?2004l\r\u001b[?2004h>     return off + a*g**2/((x-x0)**2+g**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lor_lin(x,x0,g,a,off,slope):\r\n\u001b[?2004l\r\u001b[?2004h>     return off + slope*(x-x0) + a*g**2/((x-x0)**2+g**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> nu,y=load()\r\n\u001b[?2004l\r\u001b[?2004h> windows={'G':[(1400,1750),(1450,1700),(1500,1660),(1470,1700),(1520,1650)],\r\n\u001b[?2004"]
[672.947041, "o", "l\r\u001b[?2004h>          '2D':[(2400,2950),(2450,2900),(2500,2850),(2550,2800),(2580,2760)]}\r\n\u001b[?2004l\r\u001b[?2004h> inits={'G':1580.,'2D':2670.}\r\n\u001b[?2004l\r\u001b[?2004h> for name,ws in windows.items():\r\n\u001b[?2004l\r\u001b[?2004h>     print('===',name)\r\n\u001b[?2004l\r\u001b[?2004h>     for (lo,hi) in ws:\r\n\u001b[?2004l\r\u001b[?2004h>         m=(nu>=lo)&(nu<=hi)\r\n\u001b[?2004l\r\u001b[?2004h>         x=nu[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h>         off0=np.percentile(yy,20); amp0=yy.max()-off0\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             p,c=curve_fit(lor,x,yy,p0=[inits[name],20.,amp0,off0],maxfev=50000)\r\n\u001b[?2004l\r\u001b[?2004h>             resid=yy-lor(x,*p)\r\n\u001b[?2004l\r\u001b[?2004h>             rms=np.sqrt(np.mean(resid**2))\r\n\u001b[?2004l\r\u001b[?2004h>             print('  const  [%d,%d] n=%3d x0=%9.4f gamma=%8.4f amp=%10.2f off=%10.2f rms=%8.2f' % (lo,hi,m.sum(),p[0],p[1],p[2],p[3],rms))\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             print('  const fail',e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[672.947081, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[672.947176, "o", "            p2,_=curve_fit(lor_lin,x,yy,p0=[inits[name],20.,amp0,off0,0.],maxfev=50000)\r\n\u001b[?2004l\r"]
[672.947225, "o", "\u001b[?2004h> "]
[672.947312, "o", "            rms2=np.sqrt(np.mean((yy-lor_lin(x,*p2))**2))\r\n\u001b[?2004l\r"]
[672.947345, "o", "\u001b[?2004h> "]
[672.947648, "o", "            print('  linear [%d,%d] n=%3d x0=%9.4f gamma=%8.4f amp=%10.2f off=%10.2f slope=%8.3f rms=%8.2f' % (lo,hi,m.sum(),p2[0],p2[1],p2[2],p2[3],p2[4],rms2))\r\n\u001b[?2004l\r"]
