[533.203763, "i", "cat > /tmp/explore4.py << 'EOF'\nimport numpy as np\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(rows)\nnu=1e7/d[:,0]; y=d[:,1]\nidx=np.argsort(nu)\nnu=nu[idx]; ys=y[idx]\nfor lo,hi in [(1400,1750),(2400,2950)]:\n    print('=== window %d-%d ===' % (lo,hi))\n    for n,v in zip(nu,ys):\n        if lo<=n<=hi:\n            print('%9.3f %10.2f' % (n,v))\nEOF\npython3 /tmp/explore4.py > /tmp/win.txt; wc -l /tmp/win.txt; head -60 /tmp/win.txt\n"]
