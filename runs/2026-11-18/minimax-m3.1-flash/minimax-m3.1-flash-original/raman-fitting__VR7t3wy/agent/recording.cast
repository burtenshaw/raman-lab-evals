[423.743193, "o", "\u001b[?2004h"]
[423.743242, "o", "root@j-openenv-6afd86e8884144d2f44fd3c0-9vypbaix-6f646-t5vv9:/app# "]
[424.196458, "i", "cat > /tmp/explore3.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(rows)\nc=d[:,0]; y=d[:,1]\nnu=1e7/c\nidx=np.argsort(nu)\nnu=nu[idx]; ys=y[idx]\nprint('nu range', nu.min(), nu.max())\npeaks,props=find_peaks(ys, prominence=100)\norder=np.argsort(props['prominences'])[::-1]\nfor i in order[:20]:\n    p=peaks[i]\n    print('peak nu=%9.3f  y=%9.1f  prom=%9.1f  width=%s' % (nu[p], ys[p], props['prominences'][i], props['widths'][i]))\nprint()\n# coarse binned profile\nbins=np.arange(200,3600,100)\nfor lo in bins:\n    m=(nu>=lo)&(nu<lo+100)\n    if m.sum():\n        print('%5d-%5d n=%4d  ymin=%8.1f ymax=%8.1f ymean=%8.1f  y@maxat nu=%.2f' % (lo,lo+100,m.sum(),ys[m].min(),ys[m].max(),ys[m].mean(), nu[m][np.argmax(ys[m])]))\nEOF\npython3 /tmp/explore3.py\n"]
