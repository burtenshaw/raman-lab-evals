[883.948869, "i", "cat > /tmp/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef load():\n    rows=[]\n    for line in open('/app/graphene.dat'):\n        p=line.split()\n        if len(p)<2: continue\n        rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\n    d=np.array(rows)\n    nu=1e7/d[:,0]; y=d[:,1]\n    i=np.argsort(nu)\n    return nu[i], y[i]\n\ndef lor(x,x0,g,a,off):\n    return off + a*g**2/((x-x0)**2+g**2)\n\nnu,y=load()\nprint('--- background shape (peak-free windows) ---')\nfor lo,hi in [(1000,1500),(1700,2400),(2800,3200),(3400,4000)]:\n    m=(nu>=lo)&(nu<=hi)\n    x=nu[m]; yy=y[m]\n    p=np.polyfit(x,yy,1)\n    resid=yy-np.polyval(p,x)\n    print('  [%d,%d] n=%d  slope=%8.3f  value@lo=%8.1f value@hi=%8.1f  resid_std=%6.1f' % (lo,hi,m.sum(),p[0],np.polyval(p,lo),np.polyval(p,hi),resid.std()))\n\nprint()\nprint('--- G peak: const-offset fits over windows ---')\nfor lo,hi in [(1450,1700),(1475,1680),(1500,1660),(1520,1650),(1400,1750),(1490,1690)]:\n    m=(nu>=lo)&(nu<=hi); x=nu[m]; yy=y"]
[883.94902, "i", "[m]\n    p,_=curve_fit(lor,x,yy,p0=[1580.,8.,yy.max()-np.median(yy),np.median(yy)],maxfev=100000)\n    r=yy-lor(x,*p)\n    ss=1-np.sum(r**2)/np.sum((yy-yy.mean())**2)\n    print('  [%4d,%4d] n=%3d x0=%9.4f gam=%7.4f amp=%9.2f off=%9.2f  R2=%.5f rms=%6.1f' % (lo,hi,m.sum(),p[0],p[1],p[2],p[3],ss,np.sqrt((r**2).mean())))\n\nprint()\nprint('--- 2D peak: const-offset fits over windows ---')\nfor lo,hi in [(2400,2950),(2450,2900),(2500,2850),(2520,2820),(2550,2800),(2580,2770)]:\n    m=(nu>=lo)&(nu<=hi); x=nu[m]; yy=y[m]\n    p,_=curve_fit(lor,x,yy,p0=[2670.,16.,yy.max()-np.median(yy),np.median(yy)],maxfev=100000)\n    r=yy-lor(x,*p)\n    ss=1-np.sum(r**2)/np.sum((yy-yy.mean())**2)\n    print('  [%4d,%4d] n=%3d x0=%9.4f gam=%7.4f amp=%9.2f off=%9.2f  R2=%.5f rms=%6.1f' % (lo,hi,m.sum(),p[0],p[1],p[2],p[3],ss,np.sqrt((r**2).mean())))\nEOF\npython3 /tmp/fit2.py\n"]
