[71.118585, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nrows=[]\nfor line in open('/app/graphene.dat'):\n    p=line.split()\n    if len(p)<2: continue\n    rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(rows)\nx=data[:,0]; y=data[:,1]\nprint('n=',len(x),'x range',x.min(),x.max(),'y range',y.min(),y.max())\nprint('sorted desc?', np.all(np.diff(x)<0))\n# local maxima on the x-ordered array\nidx=np.argsort(x)\nxs=x[idx]; ys=y[idx]\npeaks,props=find_peaks(ys, prominence=50)\norder=np.argsort(props['prominences'])[::-1]\nfor i in order[:15]:\n    p=peaks[i]\n    print('peak x=%.3f y=%.1f prom=%.1f' % (xs[p], ys[p], props['prominences'][i]))\nEOF\npython3 /tmp/explore.py\n"]
