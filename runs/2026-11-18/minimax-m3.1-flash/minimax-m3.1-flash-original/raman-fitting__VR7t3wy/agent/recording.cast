[883.949224, "o", "d] n=%3d x0=%9.4f gam=%7.4f amp=%9.2f off=%9.2f  R2=%.5f rms=%6.1f' % (lo,hi,m.sum(),p["]
[883.949259, "o", "0],p[1],p[2],p[3],ss,np.sqrt((r**2).mean())))\r\nEOF\r\npython3 /tmp/fit2.py\r\n"]
