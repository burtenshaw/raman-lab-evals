    p,_=curve_fit(lor,x,yy,p0=[2670.,16.,yy.max()-np.median(yy),np.median(yy)],maxfev=100000)
    r=yy-lor(x,*p)
    ss=1-np.sum(r**2)/np.sum((yy-yy.mean())**2)
    print('  [%4d,%4d] n=%3d x0=%9.4f gam=%7.4f amp=%9.2f off=%9.2f  R2=%.5f rms=%6.1f' % (lo,hi,m.sum(),p[0],p[1],p[2],p[3],ss,np.sqrt((r**2).mean())))
