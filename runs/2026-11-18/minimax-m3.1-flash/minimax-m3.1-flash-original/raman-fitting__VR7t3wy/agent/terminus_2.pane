    p,_=curve_fit(lor,x,yy,p0=[1580.,8.,yy.max()-np.median(yy),np.median(yy)],maxfev=100000)
    r=yy-lor(x,*p)
    ss=1-np.sum(r**2)/np.sum((yy-yy.mean())**2)
