[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def load():
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for line in open('/app/graphene.dat'):
[?2004l[?2004h>         p=line.split()
[?2004l[?2004h>         if len(p)<2: continue
[?2004l[?2004h>         rows.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))
[?2004l[?2004h>     d=np.array(rows)
[?2004l[?2004h>     nu=1e7/d[:,0]; y=d[:,1]
[?2004l[?2004h>     i=np.argsort(nu)
[?2004l[?2004h>     return nu[i], y[i]
[?2004l[?2004h> 
[?2004l[?2004h> def lor(x,x0,g,a,off):
[?2004l[?2004h>     return off + a*g**2/((x-x0)**2+g**2)
[?2004l[?2004h> 
[?2004l[?2004h> def lor_lin(x,x0,g,a,off,slope):
[?2004l[?2004h>     return off + slope*(x-x0) + a*g**2/((x-x0)**2+g**2)
[?2004l[?2004h> 
[?2004l[?2004h> nu,y=load()
[?2004l[?2004h> windows={'G':[(1400,1750),(1450,1700),(1500,1660),(1470,1700),(1520,1650)],
[?2004l[?2004h>          '2D':[(2400,2950),(2450,2900),(2500,2850),(2550,2800),(2580,2760)]}
[?2004l[?2004h> inits={'G':1580.,'2D':2670.}
[?2004l[?2004h> for name,ws in windows.items():
[?2004l[?2004h>     print('===',name)
[?2004l[?2004h>     for (lo,hi) in ws:
[?2004l[?2004h>         m=(nu>=lo)&(nu<=hi)
[?2004l[?2004h>         x=nu[m]; yy=y[m]
[?2004l[?2004h>         off0=np.percentile(yy,20); amp0=yy.max()-off0
[?2004l[?2004h>         try:
[?2004l[?2004h>             p,c=curve_fit(lor,x,yy,p0=[inits[name],20.,amp0,off0],maxfev=50000)
[?2004l[?2004h>             resid=yy-lor(x,*p)
[?2004l[?2004h>             rms=np.sqrt(np.mean(resid**2))
[?2004l[?2004h>             print('  const  [%d,%d] n=%3d x0=%9.4f gamma=%8.4f amp=%10.2f off=%10.2f rms=%8.2f' % (lo,hi,m.sum(),p[0],p[1],p[2],p[3],rms))
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print('  const fail',e)
[?2004l[?2004h>         try:
[?2004l[?2004h>             p2,_=curve_fit(lor_lin,x,yy,p0=[inits[name],20.,amp0,off0,0.],maxfev=50000)
[?2004l[?2004h>             rms2=np.sqrt(np.mean((yy-lor_lin(x,*p2))**2))
[?2004l[?2004h>             print('  linear [%d,%d] n=%3d x0=%9.4f gamma=%8.4f amp=%10.2f off=%10.2f slope=%8.3f rms=%8.2f' % (lo,hi,m.sum(),p2[0],p2[1],p2[2],p2[3],p2[4],rms2))
